#!/usr/bin/env python3
"""adversarial-review CLI. See ../SPEC.md.

  adversarial-review review --name NAME --change FILE --evidence FILE --out DIR [--reviewer MODEL]
  adversarial-review validate FILE
"""
import argparse, json, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import adversarial_review as A


def main(argv=None):
    ap = argparse.ArgumentParser(prog="adversarial-review", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("review"); r.add_argument("--name", required=True); r.add_argument("--change", required=True)
    r.add_argument("--evidence", required=True); r.add_argument("--out", required=True)
    r.add_argument("--reviewer", default="luna", help="a model alias or host:model@effort from another family than the change's author (default luna: codex gpt-5.6-luna, xhigh)"); r.add_argument("--max", type=int, default=8)
    v = sub.add_parser("validate"); v.add_argument("file")
    args = ap.parse_args(argv)
    if args.cmd == "review":
        doc = A.review(args.name, Path(args.change).read_text(), Path(args.evidence).read_text(), args.reviewer, max_findings=args.max)
        out = Path(args.out); out.mkdir(parents=True, exist_ok=True)
        (out / "findings.json").write_text(json.dumps(doc, indent=1) + "\n")
        (out / "findings.md").write_text(A.to_markdown(doc))
        print(A.to_markdown(doc))
    else:
        errs = A.validate(json.loads(Path(args.file).read_text()))
        print("\n".join(errs) if errs else "valid"); sys.exit(1 if errs else 0)


if __name__ == "__main__":
    main()
