#!/usr/bin/env bash
# Marketplace-safe DevLoop runtime shim: resolve a preinstalled engine and exec.
# Operator provisioning is deliberately outside this distributed skill package.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
card_root="$(cd "$here/.." && pwd -P)"
# Keep the logical path separate: skill-dir installs are symlinks, and the
# physical checkout must not hide Grok/Claude/Codex/Cursor host affinity.
here_logical="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
card_root_logical="$(cd "$here_logical/.." && pwd)"
invoke_logical="${BASH_SOURCE[0]}"

usage() {
  cat <<'EOF'
Usage: devloop-run [flags] [--] [devloop_cli args...]

Resolve an already provisioned DevLoop engine and run scripts/devloop_cli.py.
This distributed runtime never downloads, installs, or executes setup overrides.

Flags:
  --probe              Print the resolved engine; do not exec
  --strict             If DEVLOOP_HOME is invalid, exit 2 instead of falling back
  --host NAME          grok|hermes|claude|codex|cursor|auto (default: auto)
  --allow-hermes-seed  Permit resolving an already installed Hermes engine

Put devloop_cli options (--repo, --lang, ...) after --. Any other option
before -- is refused with exit 64.

Environment:
  DEVLOOP_HOME              Preferred preinstalled engine root
  DEVLOOP_DATA_HOME         Host-local parent (default: XDG data / ~/.local/share)
  DEVLOOP_HOST              Host affinity; exported to the engine
  DEVLOOP_TRANSPORT         Explicit external grok|hermes transport where required
  DEVLOOP_ALLOW_HERMES_SEED Permit resolving an installed Hermes engine
  DEVLOOP_DEPTH / DEVLOOP_NESTING  Nonzero invokes fail closed (anti-reentry)
  GROK_BIN                  Grok CLI for Grok transport
  HERMES_HOME               Installed Hermes engine location

Interpreter: use ENGINE/.venv/bin/python3 when executable; otherwise use
python3 on PATH. The operator setup script validates the same selection before
activating a host-local engine; this runtime never installs dependencies.

Resolution order:
  1. DEVLOOP_HOME (if valid)
  2. Host-local DATA_HOME/devloop
  3. Installed Hermes engine only for host=hermes or explicit allow flag

If no engine is resolved, exit 2. Have an operator provision a verified engine
outside this package with a trusted skill-craft checkout's
scripts/devloop-setup.sh, then set DEVLOOP_HOME or use the host-local location.
EOF
}

strict=0
probe=0
host_flag=""
allow_hermes_seed="${DEVLOOP_ALLOW_HERMES_SEED:-0}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --strict) strict=1; shift ;;
    --probe) probe=1; shift ;;
    --host)
      host_flag="${2:-}"
      [[ -n "$host_flag" ]] || { printf 'devloop-run: --host requires NAME\n' >&2; exit 64; }
      shift 2
      ;;
    --allow-hermes-seed) allow_hermes_seed=1; shift ;;
    --) shift; break ;;
    -?*)
      printf 'devloop-run: unknown option: %s\n' "$1" >&2
      printf '  Put devloop_cli options after --. See devloop-run --help.\n' >&2
      exit 64
      ;;
    *) break ;;
  esac
done

trace_before() { printf '[devloop-run] BEFORE %s\n' "$1" >&2; }
trace_after() { printf '[devloop-run] AFTER  %s\n' "$*" >&2; }
trace_state() { printf '[devloop-run] STATE  life=%s\n' "$1" >&2; }
emit_identity() {
  printf 'DevLoop — mode=engine host=%s engine=%s\n' "${DEVLOOP_HOST:-pending}" "${1:-pending}" >&2
}
fail_closed() {
  trace_state fail-closed
  exit 2
}

args_have_repo_flag() {
  local arg
  for arg in "$@"; do
    case "$arg" in --repo|--repo=*) return 0 ;; esac
  done
  return 1
}

args_have_lang_flag() {
  local arg
  for arg in "$@"; do
    case "$arg" in --lang|--lang=*) return 0 ;; esac
  done
  return 1
}

extract_lang_value() {
  local previous="" arg
  for arg in "$@"; do
    if [[ "$previous" == "--lang" ]]; then
      printf '%s\n' "$arg"
      return 0
    fi
    case "$arg" in --lang=*) printf '%s\n' "${arg#--lang=}"; return 0 ;; esac
    previous="$arg"
  done
  printf 'none\n'
}

trace_repo_target() { printf '[devloop-run] STATE target=%s reason=%s\n' "$1" "$2" >&2; }
trace_lang_state() { printf '[devloop-run] STATE lang=%s reason=%s\n' "$1" "$2" >&2; }

detect_host() {
  if [[ -n "$host_flag" && "$host_flag" != "auto" ]]; then
    printf '%s\n' "$host_flag"
    return 0
  fi
  if [[ -n "${DEVLOOP_HOST:-}" ]]; then
    printf '%s\n' "$DEVLOOP_HOST"
    return 0
  fi
  local path
  for path in "$card_root_logical" "$here_logical" "$invoke_logical" "$card_root"; do
    case "$path" in
      */.grok/skills/*|*/.grok/skills|*/.grok/plugins/*) printf 'grok\n'; return 0 ;;
      */.claude/skills/*|*/.claude/skills|*/.claude/plugins/*) printf 'claude\n'; return 0 ;;
      */.codex/skills/*|*/.codex/skills|*/.codex/plugins/*|*/.codex/plugins) printf 'codex\n'; return 0 ;;
      */.cursor/skills/*|*/.cursor/skills) printf 'cursor\n'; return 0 ;;
      */.hermes/*|/opt/data/*|/opt/hermes/*) printf 'hermes\n'; return 0 ;;
    esac
  done
  printf 'auto\n'
}

trace_before detect_host
DEVLOOP_HOST="$(detect_host)"
export DEVLOOP_HOST
case "$DEVLOOP_HOST" in
  grok|hermes|claude|codex|cursor|auto) ;;
  *) printf 'devloop-run: unsupported host: %s\n' "$DEVLOOP_HOST" >&2; fail_closed ;;
esac
allow_hermes_seed_effective=0
if [[ "$allow_hermes_seed" == "1" || "${DEVLOOP_ALLOW_HERMES_SEED:-0}" == "1" || "$DEVLOOP_HOST" == "hermes" ]]; then
  allow_hermes_seed_effective=1
fi
trace_after detect_host "host=$DEVLOOP_HOST hermes_seed=$allow_hermes_seed_effective"
trace_state detect
emit_identity pending

is_engine_root() {
  local dir="$1"
  [[ -n "$dir" && -d "$dir" && -f "$dir/scripts/devloop_cli.py" ]]
}

host_local_root() {
  local data="${DEVLOOP_DATA_HOME:-${XDG_DATA_HOME:-${HOME}/.local/share}}"
  printf '%s/devloop\n' "$data"
}

is_full_engine() {
  local dir="$1"
  [[ -f "$dir/dispatch.py" || -f "$dir/devloop_bridge.py" || -f "$dir/devloop_core/dispatch_transport.py" ]]
}

engine_declares_transport() {
  local engine="$1"
  local wanted="$2"
  local capability="$engine/engine-capabilities.json"
  [[ -f "$capability" ]] || return 1
  "$engine_python" - "$capability" "$wanted" <<'PY'
import json, sys
try:
    data = json.load(open(sys.argv[1], encoding="utf-8"))
except Exception:
    raise SystemExit(1)
transports = data.get("transports")
if not isinstance(transports, list):
    raise SystemExit(1)
raise SystemExit(0 if sys.argv[2] in transports else 2)
PY
}

resolve_engine() {
  local candidate
  local -a candidates=()
  local local_root
  local_root="$(host_local_root)"
  printf 'probe: DEVLOOP_HOST=%s hermes_seed_allowed=%s\n' "$DEVLOOP_HOST" "$allow_hermes_seed_effective" >&2

  if [[ -n "${DEVLOOP_HOME:-}" ]]; then
    candidate="$DEVLOOP_HOME"
    if is_engine_root "$candidate"; then
      printf 'probe: DEVLOOP_HOME=%s -> selected\n' "$candidate" >&2
      printf '%s\n' "$(cd "$candidate" && pwd -P)"
      return 0
    fi
    printf 'probe: DEVLOOP_HOME=%s -> invalid\n' "$candidate" >&2
    if [[ "$strict" -eq 1 ]]; then
      printf 'devloop-run: DEVLOOP_HOME invalid (strict). Fix path or unset DEVLOOP_HOME.\n' >&2
      return 1
    fi
  fi

  candidates+=("$local_root")
  if [[ "$allow_hermes_seed_effective" -eq 1 ]]; then
    [[ -n "${HERMES_HOME:-}" ]] && candidates+=("$HERMES_HOME/skills/software-development/devloop")
    candidates+=("${HOME}/.hermes/skills/software-development/devloop" "/opt/data/skills/software-development/devloop")
  else
    printf 'probe: skipping Hermes engine candidates (host=%s; explicit allow required)\n' "$DEVLOOP_HOST" >&2
  fi

  for candidate in "${candidates[@]}"; do
    if is_engine_root "$candidate"; then
      printf 'probe: %s -> selected\n' "$candidate" >&2
      printf '%s\n' "$(cd "$candidate" && pwd -P)"
      return 0
    fi
    printf 'probe: %s -> missing\n' "$candidate" >&2
  done
  return 1
}

select_engine_python() {
  local engine_root="$1"
  if [[ -x "$engine_root/.venv/bin/python3" ]]; then
    printf '%s\n' "$engine_root/.venv/bin/python3"
    return 0
  fi
  command -v python3
}

require_engine_python() {
  local engine_root="$1"
  if ! engine_python="$(select_engine_python "$engine_root")"; then
    printf 'devloop-run: no usable interpreter for preinstalled engine at %s.\n' "$engine_root" >&2
    printf '  Have the operator provision Python and engine dependencies before retrying.\n' >&2
    fail_closed
  fi
}

require_grok_bin() {
  local binary="${GROK_BIN:-}"
  if [[ -z "$binary" || ! -x "$binary" ]]; then
    binary="$(command -v grok 2>/dev/null || true)"
  fi
  if [[ -z "$binary" || ! -x "$binary" ]]; then
    printf 'devloop-run: DEVLOOP_TRANSPORT=grok but GROK_BIN/grok is unavailable.\n' >&2
    printf '  Install and authenticate the Grok CLI, or set GROK_BIN to its executable.\n' >&2
    fail_closed
  fi
  export GROK_BIN="$binary"
}

require_explicit_external_transport() {
  local current_host="$1"
  case "${DEVLOOP_TRANSPORT:-}" in
    grok) require_grok_bin ;;
    hermes) ;;
    *)
      printf 'devloop-run: host=%s has no DevLoop transport native to this package.\n' "$current_host" >&2
      printf '  Use an explicit external DEVLOOP_TRANSPORT=grok|hermes, or run from Grok/Hermes.\n' >&2
      printf '  Do not use evidence-gates as DevLoop.\n' >&2
      fail_closed
      ;;
  esac
}

preflight_invoke() {
  local engine="$1"
  local depth="${DEVLOOP_DEPTH:-${DEVLOOP_NESTING:-0}}"
  if [[ "$depth" != "0" && "$depth" != "" ]]; then
    printf 'devloop-run: nested invoke refused (DEVLOOP_DEPTH/NESTING=%s).\n' "$depth" >&2
    printf '  DevLoop must not re-enter via a child agent. Do not use evidence-gates as a fallback.\n' >&2
    fail_closed
  fi
  export DEVLOOP_DEPTH=0 DEVLOOP_NESTING=0

  case "$DEVLOOP_HOST" in
    grok)
      export DEVLOOP_TRANSPORT="${DEVLOOP_TRANSPORT:-grok}"
      require_grok_bin
      ;;
    hermes)
      export DEVLOOP_TRANSPORT="${DEVLOOP_TRANSPORT:-hermes}"
      ;;
    claude|codex|cursor)
      require_explicit_external_transport "$DEVLOOP_HOST"
      ;;
    auto) require_explicit_external_transport auto ;;
  esac

  if [[ "$DEVLOOP_HOST" != "grok" ]] || ! is_full_engine "$engine"; then
    return 0
  fi
  local capability_status=0
  set +e
  engine_declares_transport "$engine" grok
  capability_status=$?
  set -e
  if [[ "$capability_status" -eq 2 ]]; then
    printf 'devloop-run: engine at %s does not declare a Grok transport.\n' "$engine" >&2
    printf '  Use a Grok-capable preinstalled engine. Do not use evidence-gates as DevLoop.\n' >&2
    fail_closed
  fi
  if [[ "$capability_status" -eq 1 ]]; then
    printf 'devloop-run: full engine lacks a transports[] capability declaration for Grok (engine-capabilities.json).\n' >&2
    printf "%s\n" "  Have an operator provision a current Grok-capable engine with a trusted checkout's scripts/devloop-setup.sh." >&2
    fail_closed
  fi
}

trace_before resolve_engine
engine_root=""
if engine_root="$(resolve_engine)"; then
  trace_after resolve_engine "selected=$engine_root"
  trace_state resolve
else
  trace_after resolve_engine FAILED
  printf 'devloop-run: no preinstalled engine resolved.\n' >&2
  printf "%s\n" "  Have an operator use a trusted skill-craft checkout's scripts/devloop-setup.sh." >&2
  printf '  Or set DEVLOOP_HOME to a verified engine. Host-local default: %s\n' "$(host_local_root)" >&2
  emit_identity pending
  fail_closed
fi

emit_identity "$engine_root"
if [[ "$probe" -eq 1 ]]; then
  printf 'devloop-run: engine=%s host=%s\n' "$engine_root" "$DEVLOOP_HOST"
  exit 0
fi

engine_python=""
require_engine_python "$engine_root"
trace_before preflight_invoke
preflight_invoke "$engine_root"
trace_after preflight_invoke "transport=${DEVLOOP_TRANSPORT:-unset} grok_bin=${GROK_BIN:-}"
trace_state exec

repo_target=scratch
repo_reason=default
if args_have_repo_flag "$@"; then
  repo_target=explicit
  repo_reason=repo_flag
fi
trace_repo_target "$repo_target" "$repo_reason"
if args_have_lang_flag "$@"; then
  trace_lang_state "$(extract_lang_value "$@")" explicit
else
  trace_lang_state none none
fi

export DEVLOOP_DEPTH=1 DEVLOOP_NESTING=1
if [[ -z "${DEVLOOP_PROGRESS:-}" ]]; then
  export DEVLOOP_PROGRESS=verbose
fi

cli="$engine_root/scripts/devloop_cli.py"
trace_before exec
set +e
"$engine_python" "$cli" "$@"
exit_code=$?
set -e
if [[ "$exit_code" -eq 0 ]]; then
  trace_after exec 'exit=0'
  trace_state complete
else
  trace_after exec "exit=$exit_code FAILED"
  trace_state fail-closed
fi
exit "$exit_code"
