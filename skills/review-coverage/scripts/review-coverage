#!/usr/bin/env python3
"""review-coverage CLI — template, goal-body, validate (host-neutral helpers)."""
from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple

SKILL_ROOT = Path(__file__).resolve().parents[1]
REF_DIR = SKILL_ROOT / "references"
FULL_TEMPLATE = REF_DIR / "review_coverage.md"
SHORT_TEMPLATE = REF_DIR / "review_coverage.short.md"
STATIC_GOAL_LOGIC = (
    "quality review changes and consider improvements, "
    "anchoring each spec item in code changes and verify use cases/corner cases, "
    "complete when only trivial changes remain for 2 consecutive cycles"
)

HEADING_RE = re.compile(
    r"(?im)^[ \t]{0,3}#{1,6}[ \t]+Review\s+Coverage\b"
)
# Legacy heading still recognized as present (validate only)
LEGACY_HEAD_RE = re.compile(
    r"(?im)^[ \t]{0,3}#{1,6}[ \t]+(?:Post[- ]?Implementation\s+)?Residual\s+Loop\b"
    r"|^[ \t]{0,3}#{1,6}[ \t]+Residual\s+Loop\b"
)
# Capture reason; placeholder reasons (e.g. <reason>) are not real waivers.
WAIVER_RE = re.compile(
    r"(?im)^[ \t]*None\s*[—–-]\s*residual\s+loop\s+waived\s*:\s*(?P<reason>\S.+?)\s*$"
)
PLACEHOLDER_RE = re.compile(
    r"(?i)^(tbd|todo|\.\.\.|…|from plan|list concrete|<[^>]+>)$"
)
FENCE_RE = re.compile(r"^[ \t]{0,3}(```|~~~)")


def _strip_fences(text: str) -> str:
    """Remove fenced code regions (``` / ~~~, including indented openers)."""
    out: List[str] = []
    in_fence = False
    for raw in text.splitlines():
        if FENCE_RE.match(raw):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        out.append(raw)
    return "\n".join(out)


def _section_body(text: str) -> Optional[str]:
    """Return body under a level-2 ``## Review Coverage`` (or legacy residual) heading.

    Only **H2** headings are accepted (SKILL.md durable H2 contract). H1/H3+ are ignored
    so they surface as a missing section. Fences are skipped when *locating* the heading
    so a fenced ``## Review Coverage`` example does not open a section.
    """
    lines = text.splitlines()
    in_fence = False
    start: Optional[int] = None
    start_level = 2
    for i, line in enumerate(lines):
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = re.match(r"^[ \t]{0,3}(#{1,6})[ \t]+(.*)$", line)
        if not m:
            continue
        level, title = len(m.group(1)), m.group(2).strip()
        if start is None:
            if level != 2:
                continue
            if re.search(r"(?i)^Review\s+Coverage\b", title) or re.search(
                r"(?i)^(?:Post[- ]?Implementation\s+)?Residual\s+Loop\b", title
            ):
                start = i + 1
                start_level = level
            continue
        if level <= start_level:
            return "\n".join(lines[start:i])
    if start is not None:
        return "\n".join(lines[start:])
    return None


# Keys accepted from Field|Value tables and sparse labeled lines (not glossary tables).
KNOWN_FIELD_KEYS = frozenset(
    {
        "base ref",
        "base",
        "target paths",
        "target path",
        "test command",
        "driver",
        "materiality bar",
        "repo",
        "plan contract",
        "specs",
        "max review-converge rounds",
        "max rounds",
    }
)


def _fields(body: str) -> Dict[str, str]:
    """Parse residual Field|Value tables; skip fenced Objective paste examples.

    Only rows under a ``| Field | Value |`` table populate fields (so glossary
    two-column tables do not pollute). Labeled ``Key: value`` lines outside
    fences fill *missing* known keys only — they never overwrite table values.
    """
    fields: Dict[str, str] = {}
    labeled: Dict[str, str] = {}
    in_fence = False
    in_field_table = False
    for raw in body.splitlines():
        if FENCE_RE.match(raw):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        line = raw.strip()
        if not line:
            in_field_table = False
            continue
        if line.startswith("|") and line.count("|") >= 2:
            cells = [c.strip().strip("`*") for c in line.strip("|").split("|")]
            if len(cells) == 2 and not all(
                re.fullmatch(r":?-{3,}:?", c) for c in cells
            ):
                key = re.sub(r"\s+", " ", cells[0]).lower()
                if key in {"field", "key"} and cells[1].lower() in {
                    "value",
                    "val",
                }:
                    in_field_table = True
                    continue
                if key in {"field", "key"}:
                    continue
                if in_field_table and key in KNOWN_FIELD_KEYS:
                    fields[key] = cells[1]
            continue
        # left a table
        in_field_table = False
        labeled_line = re.sub(r"^[-*+]\s+", "", line).replace("**", "")
        m = re.match(
            r"(?i)^(?P<key>[A-Za-z][A-Za-z ]*?)\s*:\s*(?P<value>.+?)\s*$",
            labeled_line,
        )
        if m:
            key = re.sub(r"\s+", " ", m.group("key")).lower()
            if key in KNOWN_FIELD_KEYS and key not in labeled:
                labeled[key] = m.group("value")
    for key, value in labeled.items():
        fields.setdefault(key, value)
    return fields


def _is_placeholder(value: str) -> bool:
    v = re.sub(r"\s+", " ", (value or "").strip().strip("`*")).lower()
    if not v or PLACEHOLDER_RE.fullmatch(v):
        return True
    if re.fullmatch(r"<[^<>]+>", v):
        return True
    # Angle-bracket tokens with trailing punctuation: <BASE_REF>.  <CMD>.
    if re.fullmatch(r"<[^<>]+>[\s.:,;!?)/\]'\"…]*", v):
        return True
    # Only placeholder tokens + punctuation/spaces (e.g. "<BASE_REF>. Repo: <REPO>.")
    if "<" in v and re.fullmatch(
        r"(?:<[^<>]+>|[\s.:,;!?)/\]'\"…—–-]*)+", v
    ):
        return True
    return False


def _waiver_reason(text: str) -> Optional[str]:
    """Real unfenced in-section waiver reason, or None.

    Honored only when a ``## Review Coverage`` section exists and the waiver line
    is unfenced inside that section. No whole-file fallback. Placeholders like
    ``<reason>`` are not real waivers.
    """
    body = _section_body(text)
    if body is None:
        return None
    scan = _strip_fences(body)
    for m in WAIVER_RE.finditer(scan):
        reason = (m.group("reason") or "").strip()
        if reason and not _is_placeholder(reason):
            return reason
    return None


def _positive_label(body: str, label: str) -> bool:
    label_re = re.compile(rf"\b{re.escape(label)}\b", re.I)
    neg = re.compile(rf"\b(?:do\s+not|never|no)\s+{re.escape(label)}\b", re.I)
    for line in body.splitlines():
        if label_re.search(line) and not neg.search(line):
            return True
    return False


def _placeholder_waiver_present(text: str) -> bool:
    """True when an unfenced in-section waiver line exists with only placeholder reason."""
    body = _section_body(text)
    if body is None:
        return False
    scan = _strip_fences(body)
    saw = False
    for m in WAIVER_RE.finditer(scan):
        saw = True
        reason = (m.group("reason") or "").strip()
        if reason and not _is_placeholder(reason):
            return False
    return saw


def _core_fields_filled(fields: Dict[str, str]) -> bool:
    """True when Base ref, Target paths, and Test command are non-placeholder."""

    def present(*keys: str) -> bool:
        for k in keys:
            if k in fields and not _is_placeholder(fields[k]):
                return True
        return False

    return (
        present("base ref", "base")
        and present("target paths", "target path")
        and present("test command")
    )


def validate(text: str) -> Tuple[bool, List[str]]:
    """Shared validation path for ``validate`` and ``goal-body``."""
    body = _section_body(text)
    if body is None:
        return False, ["missing ## Review Coverage section"]

    fields = _fields(body)
    waiver = _waiver_reason(text)
    filled = _core_fields_filled(fields)

    if waiver is not None and filled:
        return False, [
            "conflict: unfenced residual waiver and filled coverage fields both present "
            "(use only the waiver line, or remove the waiver and keep the fields)"
        ]
    if waiver is not None:
        return True, []

    gaps: List[str] = []
    if _placeholder_waiver_present(text):
        gaps.append(
            "placeholder waiver reason is not a real waiver "
            "(replace <reason> with a concrete reason, or fill residual fields)"
        )

    def require(label: str, *aliases: str) -> Optional[str]:
        value = next(
            (fields[k] for k in (label.lower(), *aliases) if k in fields),
            None,
        )
        if value is None:
            gaps.append(f"missing {label} field")
            return None
        if _is_placeholder(value):
            gaps.append(f"{label} field has placeholder value")
            return None
        return value

    require("Base ref", "base")
    require("Target paths", "target path")
    require("Test command")
    driver = require("Driver")
    if driver and not re.search(r"review-converge|improve|/goal", driver, re.I):
        gaps.append("Driver must mention review-converge, improve, or /goal")

    clean = bool(
        re.search(
            r"residual\s*[×x]\s*2|2\s+consecutive|two\s+consecutive", body, re.I
        )
    )
    if "materiality bar" in fields:
        if _is_placeholder(fields["materiality bar"]):
            gaps.append("Materiality bar field has placeholder value")
    elif not (clean and re.search(r"\bmaterial\b", body, re.I)):
        gaps.append("missing Materiality bar field")

    if not _positive_label(body, "forward"):
        gaps.append("missing positive Forward cycle instruction")
    if not _positive_label(body, "reverse"):
        gaps.append("missing positive Reverse cycle instruction")
    if not clean:
        gaps.append("missing two consecutive clean residual rounds")

    return (len(gaps) == 0, gaps)


def goal_body(text: str, plan_path: str = "") -> Tuple[Optional[str], str]:
    """Return (body, err). err is empty on success.

    Runs the same ``validate()`` path first so validate and goal-body never disagree.
    """
    ok, gaps = validate(text)
    if not ok:
        return None, "plan missing filled Review Coverage: " + "; ".join(gaps)
    if _waiver_reason(text) is not None:
        return None, "residual waived — no /goal body (intentional)"
    body = _section_body(text) or ""
    fields = _fields(body)
    trailer: List[str] = []

    def add(label: str, value: str) -> None:
        if value and not _is_placeholder(value):
            trailer.append(f"{label}: {value}")

    if plan_path:
        trailer.append(f"Plan: {plan_path}")
    add("Base ref", fields.get("base ref") or fields.get("base") or "")
    add("Repo", fields.get("repo") or "")
    add("Paths", fields.get("target paths") or fields.get("target path") or "")
    add("Test", fields.get("test command") or "")

    max_rounds = fields.get("max review-converge rounds") or fields.get("max rounds") or ""
    max_token = re.search(r"\d+", str(max_rounds))
    max_n = max_token.group(0) if max_token else "12"
    if trailer:
        trailer.extend(
            [
                "Driver: one /review-converge per turn",
                f"Max rounds: {max_n}",
            ]
        )

    if not trailer:
        return STATIC_GOAL_LOGIC, ""
    return f"{STATIC_GOAL_LOGIC}. {'. '.join(trailer)}.", ""


def _read_plan_path(path: str) -> Tuple[Optional[str], Optional[str]]:
    """Load plan text. Returns (text, None) or (None, error_message) for exit 2."""
    p = Path(path)
    try:
        if p.is_dir():
            return None, f"error: cannot read {path}: Is a directory"
        return p.read_text(encoding="utf-8"), None
    except OSError as e:
        reason = e.strerror or str(e)
        return None, f"error: cannot read {path}: {reason}"


def cmd_template(short: bool) -> int:
    path = SHORT_TEMPLATE if short else FULL_TEMPLATE
    if not path.is_file():
        print(f"error: missing {path}", file=sys.stderr)
        return 2
    sys.stdout.write(path.read_text(encoding="utf-8"))
    if not path.read_text(encoding="utf-8").endswith("\n"):
        sys.stdout.write("\n")
    return 0


def cmd_validate(path: Optional[str]) -> int:
    """Exit 0 = ok; 1 = invalid plan; 2 = input unreadable."""
    if path and path != "-":
        text, err = _read_plan_path(path)
        if err is not None:
            print(err, file=sys.stderr)
            return 2
    else:
        text = sys.stdin.read()
    assert text is not None
    ok, gaps = validate(text)
    if ok:
        print("ok")
        return 0
    for g in gaps:
        print(f"Review Coverage: {g}", file=sys.stderr)
    return 1


def cmd_goal_body(plan: str, slash: bool = False) -> int:
    """Exit 0 = body printed; 1 = invalid/waived plan; 2 = input unreadable."""
    text, err = _read_plan_path(plan)
    if err is not None:
        print(err, file=sys.stderr)
        return 2
    assert text is not None
    body, gerr = goal_body(text, plan_path=plan)
    if body is None:
        print(f"error: {gerr}", file=sys.stderr)
        return 1
    print(f"/goal {body}" if slash else body)
    return 0


def cmd_check_install() -> int:
    print(f"SKILL_ROOT={SKILL_ROOT}")
    print(f"FULL_TEMPLATE={FULL_TEMPLATE} exists={FULL_TEMPLATE.is_file()}")
    print(f"SHORT_TEMPLATE={SHORT_TEMPLATE} exists={SHORT_TEMPLATE.is_file()}")
    return 0 if FULL_TEMPLATE.is_file() else 2


def main(argv: Optional[List[str]] = None) -> int:
    p = argparse.ArgumentParser(prog="review-coverage")
    sub = p.add_subparsers(dest="cmd", required=True)

    t = sub.add_parser("template", help="print section template")
    t.add_argument("--short", action="store_true")

    v = sub.add_parser("validate", help="lint plan for Review Coverage section")
    v.add_argument("plan", nargs="?", default="-", help="plan.md or - for stdin")

    g = sub.add_parser("goal-body", help="emit /goal paste body from plan")
    g.add_argument("--plan", required=True, help="path to plan.md")
    g.add_argument("--slash", action="store_true", help="prefix the body with '/goal '")

    sub.add_parser("check-install", help="print package paths")

    args = p.parse_args(argv)
    if args.cmd == "template":
        return cmd_template(args.short)
    if args.cmd == "validate":
        return cmd_validate(args.plan)
    if args.cmd == "goal-body":
        return cmd_goal_body(args.plan, args.slash)
    if args.cmd == "check-install":
        return cmd_check_install()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
