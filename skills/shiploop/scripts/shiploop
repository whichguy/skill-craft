#!/usr/bin/env python3
"""shiploop — session harness."""

from __future__ import annotations

import errno
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import uuid
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, Iterator, List, Optional, Set, Tuple

sys.path.insert(0, str(Path(__file__).resolve().parent))
import shiploop_store as store
import shiploop_contracts as contracts
import shiploop_until as until
import shiploop_discovery as discovery
from shiploop_privacy import sensitive_text

EXIT_OK = 0
EXIT_BLOCKED = 2
EXIT_USAGE = 64

PACKAGE_ROOT = Path(__file__).resolve().parents[1]
VERSION = "0.9.0"
REF_DIR = PACKAGE_ROOT / "references"
WT_DIRNAME = ".worktrees"
IMPROVE_CLEAN_STREAK = 2
IMPROVE_SCOPE_STEP = "Scope: this step's produces and the mechanics rows it touched."
IMPROVE_SCOPE_PRODUCT = "Scope: the whole product at the composed user entrypoint."
STEP_ID_RE = re.compile(r"^[SD][0-9]+$")
CONTROL_RE = re.compile(r"[\x00-\x08\x0a-\x1f\x7f]")
# Prompts may carry newlines (multi-line inner-loop text); every other
# control character is still refused. Foreign slash skills are refused
# without naming them in this file.
PROMPT_CONTROL_RE = re.compile(r"[\x00-\x09\x0b-\x1f\x7f]")
# Concatenated so a grep for the foreign slash skill name does not hit this file.
_FOREIGN_SLASH = "/" + "dev" + "loop"
UNTIL_HEAD = "Do this activity until these conditions are met:"
ENV_RECOVERY = "before execution: use action-bound revisit --to survey; after execution: preserve frozen contracts and seek user direction"
LINT_ORACLE_LINE = (
    "Lint oracle: Exclusive writer's lint/validate tool (if it has one) "
    "is dest-syntax SoT for file-local syntax; for dest identity "
    "(order/position/name/presence) the live dest list/status/push-preflight "
    "is the oracle and a local-walk finding is advisory; generic "
    "linters must not rewrite dest-mandated syntax. Run every available "
    "linter on the changed paths (writer, repo-configured, generic syntax "
    "already present — do not install); dest-mandated syntax wins."
)
HANDLE_RESOLVE = ("list", "inspect", "ask", "create")
_TOKEN_FORBIDDEN_RE = re.compile(r"[;\n\r]")
_TOOLS_LINE_RE = re.compile(r"^[ \t]*Tools:")
_DONT_USE_LINE_RE = re.compile(
    r"^[ \t]*(?:Don't use|Do not use|Don\u2019t use)[ \t]*:(.*)$",
    re.I,
)
_DONT_WRITE_LINE_RE = re.compile(
    r"^[ \t]*(?:Don't write|Do not write|Don\u2019t write)[ \t]*:(.*)$",
    re.I,
)
_USE_LINE_RE = re.compile(r"^[ \t]*Use[ \t]*:(.*)$", re.I)

STATUS_RE = re.compile(
    r"(?im)\bStatus\b[^\n]*(?P<state>stopped\s*\([^\n)]*\)|complete\b|active\b)"
)
PLAN_CONTRACT_RE = re.compile(
    r"(?im)^\*\*Plan contract:\*\*\s*`?(?P<path>[^`\n]+?)`?\s*$"
)
PLAN_HASH_RE = re.compile(r"(?im)^\*\*Plan hash:\*\*\s*`?(?P<hash>[0-9a-fA-F]{64})`?")
COMMITTED_YES_RE = re.compile(r"(?im)^\*\*Committed:\*\*\s*yes\b")
COMMITTED_NO_RE = re.compile(r"(?im)^\*\*Committed:\*\*\s*no\b")
ROUND_HEAD_RE = re.compile(r"(?im)^###\s+Round\s+(?P<n>\d+)\b")
REVIEW_CONVERGE_ROUND_RE = re.compile(
    r"(?im)(?:review-converge|grok-review-converge):\s*round\s+\d+\s*—"
)
WAIVER_RE = re.compile(
    r"(?im)^[ \t]*None\s*[—–-]\s*residual\s+loop\s+waived\s*:\s*(?P<reason>\S.+?)\s*$"
)
PLACEHOLDER_RE = re.compile(
    r"(?i)^(tbd|todo|\.\.\.|…|from plan|list concrete|<[^>]+>)$"
)
H2_RE = re.compile(r"(?m)^##\s+(.+?)\s*$")
FENCE_RE = re.compile(r"^[ \t]{0,3}(```|~~~)")

HOST_SKILL_HOMES = (
    Path.home() / ".cursor" / "skills",
    Path.home() / ".claude" / "skills",
    Path.home() / ".grok" / "skills",
    Path.home() / ".codex" / "skills",
)


_GIT_RAN: List[str] = []


def _record_git(argv: List[str], proc: subprocess.CompletedProcess[str]) -> None:
    parts = [f"$ {' '.join(argv)}", f"exit {proc.returncode}"]
    out = (proc.stdout or "").rstrip("\n")
    err = (proc.stderr or "").rstrip("\n")
    if out:
        parts.append(out)
    if err:
        parts.append(err)
    _GIT_RAN.append("\n".join(parts))


def print_git_ran(*, file: Optional[Any] = None) -> None:
    if not _GIT_RAN:
        return
    dest = sys.stdout if file is None else file
    print("Git ran:", file=dest)
    for i, block in enumerate(_GIT_RAN):
        if i:
            print(file=dest)
        print(block, file=dest)


def die(code: int, msg: str) -> None:
    print_git_ran(file=sys.stderr)
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def spec_sha256_of(run_dir: Path) -> str:
    return sha256_file(run_dir / "spec.md")


def environment_sha256_of(run_dir: Path) -> str:
    return sha256_file(run_dir / "environment.md")


def refuse_package_path(path: Path) -> None:
    try:
        path.resolve().relative_to(PACKAGE_ROOT)
    except ValueError:
        return
    die(EXIT_BLOCKED, f"refusing path inside skill package: {path}")


def inside_run_dir(run_dir: Path, path: Path) -> None:
    try:
        path.resolve().relative_to(run_dir.resolve())
    except ValueError:
        die(EXIT_BLOCKED, f"path escapes run-dir: {path}")


def skill_dir_ok(root: Path) -> bool:
    return (root / "SKILL.md").is_file()


def has_disallowed_slash(text: str) -> bool:
    return _FOREIGN_SLASH in text


def prompt_until_gaps(sid: str, prompt: str, texts: List[str]) -> List[str]:
    """Plan-time /goal until produces. Printer still prints prompt bytes verbatim."""
    gaps: List[str] = []
    if not any(re.match(r"^[ \t]*/goal\b", line) for line in prompt.splitlines()):
        gaps.append(
            f"{sid} prompt must have a line starting with /goal "
            f"(until-loop A label, not a slash to invoke); {ENV_RECOVERY}"
        )
    if UNTIL_HEAD not in prompt:
        gaps.append(f"{sid} prompt must contain {UNTIL_HEAD!r}")
    for t in texts:
        if t not in prompt:
            gaps.append(f"{sid} prompt until-clause must name produces {t!r}")
    return gaps


def find_skill(name: str) -> Optional[Path]:
    env_key = {
        "review-coverage": "SHIPLOOP_REVIEW_COVERAGE_ROOT",
        "shiploop": "SHIPLOOP_ROOT",
        "backchain": "SHIPLOOP_BACKCHAIN_ROOT",
    }.get(name, "")
    if env_key:
        raw = os.environ.get(env_key, "").strip()
        if raw:
            p = Path(raw).expanduser()
            if skill_dir_ok(p):
                return p.resolve()
    sibling = PACKAGE_ROOT.parent / name
    if sibling.is_dir() and skill_dir_ok(sibling) and name != "shiploop":
        return sibling.resolve()
    if name == "shiploop" and skill_dir_ok(PACKAGE_ROOT):
        return PACKAGE_ROOT
    for home in HOST_SKILL_HOMES:
        cand = home / name
        if skill_dir_ok(cand):
            return cand.resolve()
    return None


def resolve_dep_roots() -> Dict[str, Optional[str]]:
    return {
        "shiploop": str(PACKAGE_ROOT),
        "review-coverage": str(p) if (p := find_skill("review-coverage")) else None,
        "backchain": str(p) if (p := find_skill("backchain")) else None,
    }


def default_state(
    run_dir: Path,
    *,
    prompt: str,
    implementer: str,
    bound_plan: str,
    repo: str,
) -> Dict[str, Any]:
    bound_hash = ""
    if bound_plan:
        bp = Path(bound_plan)
        if bp.is_file():
            bound_hash = sha256_file(bp)
    return {
        "version": 3,
        "revision": 0,
        "stage": "preflight",
        "completed_actions": {},
        "phase": "intake",
        "run_id": f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{uuid.uuid4().hex[:8]}",
        "attempt": 1,
        "prompt": prompt,
        "implementer": implementer,
        "bound_plan": bound_plan,
        "bound_plan_hash": bound_hash,
        "environment_sha256": "",
        "spec_sha256": "",
        "plan_sha256": "",
        "repo_root": repo,
        "dep_roots": resolve_dep_roots(),
        "artifacts": {
            "prompt": str(run_dir / "prompt.md"),
            "environment_md": str(run_dir / "environment.md"),
            "spec_md": str(run_dir / "spec.md"),
            "plan_md": str(run_dir / "plan.md"),
            "backchain": str(run_dir / "backchain" / "plan.md"),
            "handoff_md": str(run_dir / "handoff.md"),
            "journal_md": str(run_dir / "shiploop-improvements.md"),
        },
        "blocked_reason": None,
        "blocked_from": None,
        "resume_to": None,
        "ask_user": None,
        "terminal": None,
    }


def run_dir_from_arg(raw: Optional[str], *, walk: bool) -> Path:
    if raw:
        p = Path(raw).expanduser()
        if p.name != ".shiploop" and (
            (p / ".shiploop" / "state.md").is_file()
            or (p / ".shiploop" / "state.json").is_file()
        ):
            p = p / ".shiploop"
        return p
    if not walk:
        return Path.cwd() / ".shiploop"
    cur = Path.cwd().resolve()
    for parent in [cur, *cur.parents]:
        cand = parent / ".shiploop"
        if (cand / "state.md").is_file() or (cand / "state.json").is_file():
            return cand
    return Path.cwd() / ".shiploop"


def load_state(run_dir: Path) -> Dict[str, Any]:
    refuse_package_path(run_dir)
    state_path = run_dir / "state.md"
    if not state_path.is_file():
        if (run_dir / "state.json").is_file():
            die(
                EXIT_BLOCKED,
                f"legacy JSON run; run shiploop migrate --run-dir {run_dir}",
            )
        die(EXIT_BLOCKED, f"no authoritative state.md in {run_dir}")
    if state_path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {state_path}")
    try:
        data = store.read_record(state_path)
    except store.StorageError as exc:
        die(EXIT_BLOCKED, f"cannot parse authoritative state.md: {exc}")
    if not isinstance(data, dict):
        die(EXIT_BLOCKED, "state.md is not an object")
    return data


@contextmanager
def run_lock(run_dir: Path) -> Iterator[None]:
    refuse_package_path(run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)
    lock = run_dir / ".lock"
    if lock.is_symlink():
        die(EXIT_BLOCKED, f"symlink lock refused: {lock}")
    flags = os.O_CREAT | os.O_RDWR | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(str(lock), flags, 0o600)
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.EMLINK) or lock.is_symlink():
            die(EXIT_BLOCKED, f"symlink lock refused: {lock}")
        die(EXIT_BLOCKED, f"cannot open run lock {lock}: {exc}")
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        store.recover(run_dir)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def read_text(path: Path) -> Optional[str]:
    if not path.is_file():
        return None
    if path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {path}")
    return path.read_text(encoding="utf-8")


def scan_labels(text: str, labels: Tuple[str, ...]) -> Dict[str, List[str]]:
    """Line-start labeled values, outside fences and blockquotes."""
    out: Dict[str, List[str]] = {label: [] for label in labels}
    in_fence = False
    for line in text.splitlines():
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        if line.lstrip().startswith(">"):
            continue
        for label in labels:
            m = re.match(rf"(?i)^{re.escape(label)}\s*:\s*(.*)$", line)
            if m:
                out[label].append(m.group(1).strip())
                break
    return out


def load_spec(run_dir: Path) -> Tuple[Optional[Dict[str, Any]], List[str]]:
    """spec.md is the sole SoT: labeled done_sentence: / checkable: (each once)."""
    md_path = run_dir / "spec.md"
    if not md_path.is_file():
        return None, [f"missing {md_path}"]
    text = read_text(md_path) or ""
    if not text.strip():
        return None, ["spec.md is empty"]
    labels = scan_labels(
        text, ("done_sentence", "checkable", "ask_user", "verify_hint")
    )
    gaps: List[str] = []
    for req in ("done_sentence", "checkable"):
        if len(labels[req]) == 0:
            gaps.append(f"spec.md missing labeled {req}:")
        elif len(labels[req]) > 1:
            gaps.append(f"spec.md labeled {req}: must appear exactly once")
    for opt in ("ask_user", "verify_hint"):
        if len(labels[opt]) > 1:
            gaps.append(f"spec.md labeled {opt}: must appear at most once")
    if gaps:
        return None, gaps
    ds = labels["done_sentence"][0]
    if not ds:
        return None, ["spec.md done_sentence is empty"]
    chk_raw = labels["checkable"][0].strip().lower()
    if chk_raw not in ("true", "false"):
        return None, ["spec.md checkable must be true or false"]
    checkable = chk_raw == "true"
    ask_user = labels["ask_user"][0] if labels["ask_user"] else None
    verify_hint = labels["verify_hint"][0] if labels["verify_hint"] else None
    if not checkable and not (isinstance(ask_user, str) and ask_user.strip()):
        return None, ["ask_user required when checkable is false"]
    return {
        "done_sentence": ds,
        "checkable": checkable,
        "ask_user": ask_user,
        "verify_hint": verify_hint,
    }, []


def validate_machine(m: Dict[str, Any], *, required: bool = False) -> List[str]:
    gaps: List[str] = []
    _machine_privacy_gaps(m, gaps)
    kind = m.get("kind")
    if kind not in ("greenfield", "brownfield"):
        gaps.append("machine.kind must be greenfield or brownfield")
    augment = m.get("augment")
    if not isinstance(augment, bool):
        gaps.append("machine.augment must be a bool")
    elif kind == "greenfield" and augment is not False:
        gaps.append("machine.augment must be false when kind is greenfield")
    elif kind == "brownfield" and augment is not True:
        gaps.append("machine.augment must be true when kind is brownfield")
    refs = m.get("references")
    if not isinstance(refs, list):
        gaps.append("machine.references must be a list")
    else:
        if kind == "brownfield" and not refs:
            gaps.append("machine.references must be nonempty when kind is brownfield")
        for i, r in enumerate(refs):
            ok = (
                isinstance(r, dict)
                and isinstance(r.get("path"), str)
                and r["path"].strip()
                and isinstance(r.get("why"), str)
                and r["why"].strip()
            )
            if not ok:
                gaps.append(
                    f"machine.references[{i}] must be {{path, why}} nonempty strings"
                )
    for key in ("tools", "mcp"):
        arr = m.get(key)
        if not isinstance(arr, list):
            gaps.append(f"machine.{key} must be a list")
        else:
            for i, v in enumerate(arr):
                if not isinstance(v, str) or not v.strip():
                    gaps.append(f"machine.{key}[{i}] must be a nonempty string")
    mc = m.get("mcp_considered")
    if not isinstance(mc, str) or not re.match(r"^\S+\(.*\)$", mc.strip()):
        gaps.append("machine.mcp_considered must be 'server(tool)' or 'none(reason)'")
    handles = m.get("handles")
    create_count = 0
    if not isinstance(handles, list):
        gaps.append("machine.handles must be a list")
        handles = []
    for i, h in enumerate(handles):
        if not isinstance(h, dict):
            gaps.append(f"machine.handles[{i}] must be an object")
            continue
        source = h.get("source")
        need = h.get("need")
        resolve = h.get("resolve")
        value = h.get("value")
        if not isinstance(source, str) or not source.strip():
            gaps.append(f"machine.handles[{i}].source must be nonempty")
        if not isinstance(need, str) or not need.strip():
            gaps.append(f"machine.handles[{i}].need must be nonempty")
        if resolve not in HANDLE_RESOLVE:
            gaps.append(f"machine.handles[{i}].resolve must be list|inspect|ask|create")
        if not isinstance(value, str):
            gaps.append(f"machine.handles[{i}].value must be a string")
            value = ""
        if resolve == "create":
            create_count += 1
        if resolve == "inspect" and need != "credential":
            if not value.strip():
                gaps.append(
                    f"machine.handles[{i}].value required (inspect, non-credential)"
                )
        elif resolve in ("ask", "list", "create") and value.strip():
            gaps.append(
                f"machine.handles[{i}].value must be empty for resolve={resolve}"
            )
        elif resolve == "inspect" and need == "credential" and value.strip():
            gaps.append(f"machine.handles[{i}].value must be empty for a credential")
    initiation = m.get("initiation")
    if initiation not in ("none", "needed", "done"):
        gaps.append("machine.initiation must be none|needed|done")
    else:
        if initiation == "needed" and create_count < 1:
            gaps.append(
                "machine.initiation needed requires >=1 handle with resolve=create"
            )
        if initiation in ("none", "done") and create_count > 0:
            gaps.append("machine.initiation none/done forbids resolve=create handles")
    ui = m.get("ui")
    if not isinstance(ui, bool):
        gaps.append("machine.ui must be a bool")
    ui_craft = m.get("ui_craft")
    if not isinstance(ui_craft, str) or not ui_craft.strip():
        gaps.append("machine.ui_craft must be a nonempty string")
    elif isinstance(ui, bool):
        is_none = bool(re.match(r"(?i)^none\(.*\)$", ui_craft.strip()))
        if ui and is_none:
            gaps.append("machine.ui_craft must not be none(...) when ui is true")
        if not ui and not is_none:
            gaps.append("machine.ui_craft must be none(...) when ui is false")
    inventoried: Set[str] = set()
    for key in ("tools", "mcp"):
        arr = m.get(key)
        if isinstance(arr, list):
            for v in arr:
                if isinstance(v, str) and v.strip():
                    inventoried.add(v.strip())
    exclusive = m.get("exclusive")
    if exclusive is None:
        gaps.extend(discovery.validate_machine(m, required=required))
        return gaps
    if not isinstance(exclusive, list):
        gaps.append("machine.exclusive must be a list")
        gaps.extend(discovery.validate_machine(m, required=required))
        return gaps
    for i, row in enumerate(exclusive):
        if not isinstance(row, dict):
            gaps.append(f"machine.exclusive[{i}] must be an object")
            continue
        artifact = row.get("artifact")
        use = row.get("use")
        dont_use = row.get("dont_use")
        if not isinstance(artifact, str) or not artifact.strip():
            gaps.append(f"machine.exclusive[{i}].artifact must be a nonempty string")
        if not isinstance(use, str) or not use.strip():
            gaps.append(f"machine.exclusive[{i}].use must be a nonempty string")
        elif _TOKEN_FORBIDDEN_RE.search(use):
            gaps.append(
                f"machine.exclusive[{i}].use must not contain a semicolon or newline"
            )
        elif use.strip() not in inventoried:
            gaps.append(
                f"machine.exclusive[{i}].use must be an inventoried tools or mcp name"
            )
        if not isinstance(dont_use, list):
            gaps.append(f"machine.exclusive[{i}].dont_use must be a list")
        else:
            for j, tok in enumerate(dont_use):
                if not isinstance(tok, str) or not tok.strip():
                    gaps.append(
                        f"machine.exclusive[{i}].dont_use[{j}] must be a nonempty string"
                    )
                elif _TOKEN_FORBIDDEN_RE.search(tok):
                    gaps.append(
                        f"machine.exclusive[{i}].dont_use[{j}] must not contain a "
                        "semicolon or newline"
                    )
                elif isinstance(use, str) and tok.strip() == use.strip():
                    gaps.append(f"machine.exclusive[{i}].dont_use must not contain use")
    gaps.extend(discovery.validate_machine(m, required=required))
    return gaps


def _machine_privacy_gaps(machine: Dict[str, Any], gaps: List[str]) -> None:
    """Reject credential material from strings projected from environment.md.

    This names only schema paths, never the submitted value, so a validation
    error cannot copy a credential into a packet or terminal diagnostic.
    """

    def text(value: Any, label: str) -> None:
        if isinstance(value, str) and sensitive_text(value):
            gaps.append(f"{label} must not contain sensitive credential material")

    def strings(value: Any, label: str) -> None:
        if isinstance(value, list):
            for index, item in enumerate(value):
                text(item, f"{label}[{index}]")

    text(machine.get("kind"), "machine.kind")
    text(machine.get("mcp_considered"), "machine.mcp_considered")
    text(machine.get("ui_craft"), "machine.ui_craft")
    for key in ("tools", "mcp"):
        strings(machine.get(key), f"machine.{key}")

    references = machine.get("references")
    if isinstance(references, list):
        for index, row in enumerate(references):
            if isinstance(row, dict):
                for key in ("path", "why"):
                    text(row.get(key), f"machine.references[{index}].{key}")

    handles = machine.get("handles")
    if isinstance(handles, list):
        for index, row in enumerate(handles):
            if isinstance(row, dict):
                for key in ("source", "need", "resolve", "value"):
                    text(row.get(key), f"machine.handles[{index}].{key}")

    exclusive = machine.get("exclusive")
    if isinstance(exclusive, list):
        for index, row in enumerate(exclusive):
            if isinstance(row, dict):
                for key in ("artifact", "use"):
                    text(row.get(key), f"machine.exclusive[{index}].{key}")
                strings(row.get("dont_use"), f"machine.exclusive[{index}].dont_use")

    layout = machine.get("layout")
    if isinstance(layout, dict):
        for key in ("reserved", "product"):
            strings(layout.get(key), f"machine.layout.{key}")

    routing = machine.get("routing")
    if isinstance(routing, dict):
        for key in ("user_entrypoint", "confirmation", "source"):
            text(routing.get(key), f"machine.routing.{key}")
        strings(routing.get("reserved_routes"), "machine.routing.reserved_routes")


def handles_block_plan(machine: Dict[str, Any]) -> List[str]:
    gaps: List[str] = []
    for index, h in enumerate(machine.get("handles") or []):
        if isinstance(h, dict) and h.get("resolve") in ("list", "ask"):
            gaps.append(
                f"handle[{index}] resolve={h.get('resolve')} blocks dest plan"
            )
    return gaps


def _exclusive_rows(env: Optional[Dict[str, Any]]) -> List[Dict[str, Any]]:
    if not isinstance(env, dict):
        return []
    exclusive = env.get("exclusive")
    if not isinstance(exclusive, list):
        return []
    return [row for row in exclusive if isinstance(row, dict)]


def _dont_use_tokens(env: Optional[Dict[str, Any]]) -> List[str]:
    tokens: List[str] = []
    seen: Set[str] = set()
    for row in _exclusive_rows(env):
        dont_use = row.get("dont_use")
        if not isinstance(dont_use, list):
            continue
        for tok in dont_use:
            if isinstance(tok, str) and tok.strip() and tok.strip() not in seen:
                seen.add(tok.strip())
                tokens.append(tok.strip())
    return tokens


def _use_token(env: Optional[Dict[str, Any]]) -> Optional[str]:
    uses: List[str] = []
    seen: Set[str] = set()
    for row in _exclusive_rows(env):
        use = row.get("use")
        if isinstance(use, str) and use.strip() and use.strip() not in seen:
            seen.add(use.strip())
            uses.append(use.strip())
    if len(uses) == 1:
        return uses[0]
    return None


def _nonempty_references(env: Dict[str, Any]) -> List[Dict[str, Any]]:
    refs = env.get("references") or []
    out: List[Dict[str, Any]] = []
    if not isinstance(refs, list):
        return out
    for r in refs:
        if (
            isinstance(r, dict)
            and isinstance(r.get("path"), str)
            and r["path"].strip()
            and isinstance(r.get("why"), str)
            and r["why"].strip()
        ):
            out.append(r)
    return out


def _layout_routing_gaps(env: Dict[str, Any], *, required: bool) -> List[str]:
    """Shape-check frozen destination layout/routing at dest plan only."""
    gaps: List[str] = []
    refs = {str(r["path"]).strip() for r in _nonempty_references(env)}

    if "layout" not in env:
        if required:
            gaps.append(
                f"machine.layout required when exclusive is nonempty; {ENV_RECOVERY}"
            )
    else:
        layout = env.get("layout")
        if not isinstance(layout, dict):
            gaps.append("machine.layout must be an object")
        else:
            for key in ("reserved", "product"):
                values = layout.get(key)
                if not isinstance(values, list) or not values:
                    gaps.append(f"machine.layout.{key} must be a nonempty list")
                    continue
                for i, value in enumerate(values):
                    if not isinstance(value, str) or not value.strip():
                        gaps.append(
                            f"machine.layout.{key}[{i}] must be a nonempty string"
                        )

    if "routing" not in env:
        if required:
            gaps.append(
                f"machine.routing required when exclusive is nonempty; {ENV_RECOVERY}"
            )
    else:
        routing = env.get("routing")
        if not isinstance(routing, dict):
            gaps.append("machine.routing must be an object")
        else:
            for key in ("user_entrypoint", "confirmation", "source"):
                value = routing.get(key)
                if not isinstance(value, str) or not value.strip():
                    gaps.append(f"machine.routing.{key} must be a nonempty string")
            routes = routing.get("reserved_routes")
            if not isinstance(routes, list) or not routes:
                gaps.append("machine.routing.reserved_routes must be a nonempty list")
            else:
                for i, value in enumerate(routes):
                    if not isinstance(value, str) or not value.strip():
                        gaps.append(
                            "machine.routing.reserved_routes[{}] must be a nonempty "
                            "string".format(i)
                        )
            source = routing.get("source")
            if (
                isinstance(source, str)
                and source.strip()
                and source.strip() not in refs
            ):
                gaps.append("machine.routing.source must name a references[].path")
    return gaps


def _reserved_paths(env: Optional[Dict[str, Any]]) -> List[str]:
    if not isinstance(env, dict):
        return []
    layout = env.get("layout")
    if not isinstance(layout, dict):
        return []
    values = layout.get("reserved")
    if not isinstance(values, list):
        return []
    return [
        value.strip() for value in values if isinstance(value, str) and value.strip()
    ]


def exclusive_gaps(env: Optional[Dict[str, Any]]) -> List[str]:
    """dest plan: exclusive key present; nonempty rows need nonempty references."""
    if not env:
        return []
    gaps: List[str] = []
    if "exclusive" not in env:
        gaps.append(
            "machine.exclusive must be a list (use [] when this increment "
            f"writes no destination artifact); {ENV_RECOVERY}"
        )
        return gaps
    exclusive = env.get("exclusive")
    if not isinstance(exclusive, list):
        return gaps
    rows = _exclusive_rows(env)
    if rows and not _nonempty_references(env):
        gaps.append(
            "machine.references must be nonempty when exclusive is nonempty; "
            f"{ENV_RECOVERY}"
        )
    gaps.extend(_layout_routing_gaps(env, required=bool(rows)))
    uses: List[Tuple[int, str]] = []
    donts: List[Tuple[int, List[str]]] = []
    for i, row in enumerate(rows):
        use = row.get("use")
        if isinstance(use, str) and use.strip():
            uses.append((i, use.strip()))
        raw = row.get("dont_use")
        toks: List[str] = []
        if isinstance(raw, list):
            toks = [t.strip() for t in raw if isinstance(t, str) and t.strip()]
        donts.append((i, toks))
    if len({u for _, u in uses}) > 1:
        gaps.append(f"must designate a single exclusive writer; {ENV_RECOVERY}")
    for i, use in uses:
        for j, toks in donts:
            if i != j and use in toks:
                gaps.append(
                    "session cannot express opposing writers — split the session; "
                    f"{ENV_RECOVERY}"
                )
                return gaps
    return gaps


def ui_craft_gaps(env: Optional[Dict[str, Any]]) -> List[str]:
    """dest plan: a UI craft reference must cite the frozen skill token."""
    if not isinstance(env, dict) or env.get("ui") is not True:
        return []
    token = env.get("ui_craft")
    if (
        not isinstance(token, str)
        or not token.strip()
        or re.match(r"(?i)^none\(.*\)$", token.strip())
    ):
        return []
    if any(token in ref["path"] for ref in _nonempty_references(env)):
        return []
    return ["ui_craft must appear in a references[].path when ui is true"]


def _last_tools_block(prompt: str) -> Optional[str]:
    lines = prompt.splitlines()
    last_i: Optional[int] = None
    for i, line in enumerate(lines):
        if _TOOLS_LINE_RE.match(line):
            last_i = i
    if last_i is None:
        return None
    return "\n".join(lines[last_i:])


def _last_tools_line(prompt: str, line_re: re.Pattern[str]) -> Optional[str]:
    block = _last_tools_block(prompt)
    if block is None:
        return None
    last_rest: Optional[str] = None
    for line in block.splitlines():
        m = line_re.match(line)
        if m:
            last_rest = m.group(1).strip()
    return last_rest


def parse_tools_dont_use(prompt: str) -> Optional[List[str]]:
    """Last Don't use: / Do not use: line in the last Tools: block.

    None = no Don't use line. [] = explicit none. Otherwise semicolon-separated
    exact entries. A token under Use: does not count.
    """
    last_rest = _last_tools_line(prompt, _DONT_USE_LINE_RE)
    if last_rest is None:
        return None
    if last_rest.lower() == "none":
        return []
    return [p.strip() for p in last_rest.split(";") if p.strip()]


def parse_tools_dont_write(prompt: str) -> Optional[List[str]]:
    """Last Don't write: / Do not write: line in the last Tools: block."""
    last_rest = _last_tools_line(prompt, _DONT_WRITE_LINE_RE)
    if last_rest is None:
        return None
    if last_rest.lower() == "none":
        return []
    return [p.strip() for p in last_rest.split(";") if p.strip()]


def parse_tools_use(prompt: str) -> Optional[List[str]]:
    """Last Use: line in the last Tools: block.

    None = no Use line. [] = explicit none. Otherwise semicolon-separated
    exact entries.
    """
    last_rest = _last_tools_line(prompt, _USE_LINE_RE)
    if last_rest is None:
        return None
    if last_rest.lower() == "none":
        return []
    return [p.strip() for p in last_rest.split(";") if p.strip()]


def writer_prompt_gaps(
    sid: str,
    prompt: str,
    tokens: List[str],
    use_token: Optional[str] = None,
) -> List[str]:
    gaps: List[str] = []
    if _last_tools_block(prompt) is None:
        gaps.append(
            f"{sid} prompt must have a line starting with Tools:; {ENV_RECOVERY}"
        )
        return gaps
    entries = parse_tools_dont_use(prompt)
    if entries is None:
        gaps.append(f"{sid} prompt must have a Don't use: line; {ENV_RECOVERY}")
        return gaps
    have = set(entries)
    for tok in tokens:
        if tok not in have:
            gaps.append(
                f"{sid} prompt must list exclusive dont_use {tok} as a Don't use: "
                f"entry; {ENV_RECOVERY}"
            )
    use_entries = parse_tools_use(prompt)
    if use_entries is None:
        gaps.append(f"{sid} prompt must have a Use: line; {ENV_RECOVERY}")
        return gaps
    use_have = set(use_entries)
    if use_token and use_token not in use_have:
        gaps.append(
            f"{sid} prompt must list exclusive use {use_token} as a Use: "
            f"entry; {ENV_RECOVERY}"
        )
    for tok in sorted(use_have & have):
        gaps.append(
            f"{sid} prompt Use: and Don't use: overlap on {tok}; {ENV_RECOVERY}"
        )
    return gaps


def reserved_prompt_gaps(sid: str, prompt: str, reserved: List[str]) -> List[str]:
    """Seed-only reserved-tree guard; discovered in-flight work is exempt."""
    if not reserved or reserved == ["none"]:
        return []
    entries = parse_tools_dont_write(prompt)
    if entries is None:
        return [f"{sid} prompt must have a Don't write: line; {ENV_RECOVERY}"]
    have = set(entries)
    gaps: List[str] = []
    for path in reserved:
        if path not in have:
            gaps.append(
                f"{sid} prompt must list reserved path {path} as a Don't write: "
                f"entry; {ENV_RECOVERY}"
            )
    return gaps


def load_environment(run_dir: Path) -> Tuple[Optional[Dict[str, Any]], List[str]]:
    """environment.md: prose brief, then one '## machine' H2 with a fenced JSON object."""
    path = run_dir / "environment.md"
    if not path.is_file():
        return None, [f"missing {path}"]
    text = read_text(path) or ""
    if not text.strip():
        return None, ["environment.md is empty"]
    lines = text.splitlines()
    heading_idxs: List[int] = []
    in_fence = False
    for i, line in enumerate(lines):
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = re.match(r"^[ \t]{0,3}(#{1,6})\s+(.*)$", line)
        if m and len(m.group(1)) == 2 and m.group(2).strip().lower() == "machine":
            heading_idxs.append(i)
    if not heading_idxs:
        return None, ["environment.md missing a '## machine' section"]
    if len(heading_idxs) > 1:
        return None, ["environment.md must have exactly one '## machine' section"]
    h = heading_idxs[0]
    brief = "\n".join(lines[:h]).strip()
    if not brief:
        return None, ["environment.md brief (before '## machine') is empty"]
    j = h + 1
    while j < len(lines) and not lines[j].strip():
        j += 1
    if j >= len(lines) or not FENCE_RE.match(lines[j]):
        return None, [
            "environment.md '## machine' must be followed by a fenced JSON block"
        ]
    fence_marker = lines[j].strip()[:3]
    k = j + 1
    body: List[str] = []
    closed = False
    while k < len(lines):
        if lines[k].strip().startswith(fence_marker):
            closed = True
            break
        body.append(lines[k])
        k += 1
    if not closed:
        return None, ["environment.md machine fence is not closed"]
    try:
        machine = json.loads("\n".join(body))
    except Exception as exc:
        return None, [f"environment.md machine fence is not valid JSON: {exc}"]
    if not isinstance(machine, dict):
        return None, ["environment.md machine fence must be a JSON object"]
    gaps = validate_machine(machine)
    if gaps:
        return None, gaps
    return machine, []


def canonical_backchain(run_dir: Path) -> Path:
    return run_dir / "backchain" / "plan.md"


def wrapper_pair(run_dir: Path, spec: Optional[Dict[str, Any]]) -> List[str]:
    """plan.md labeled done_sentence must equal spec.md at dest implement.

    Same scan_labels rules as spec.md (line-start, outside fences/blockquotes).
    The Markdown wrapper is authoritative for this human-readable plan.
    """
    md_path = run_dir / "plan.md"
    if not md_path.is_file():
        return [f"missing {md_path}"]
    md = read_text(md_path) or ""
    if not md.strip():
        return ["plan.md empty"]
    labels = scan_labels(md, ("done_sentence",))
    spec_ds = (spec or {}).get("done_sentence")
    found = labels["done_sentence"]
    if len(found) == 0 or not found[0]:
        return ["plan.md labeled done_sentence missing"]
    if len(found) > 1:
        return ["plan.md labeled done_sentence must appear exactly once"]
    if spec_ds is not None and found[0] != spec_ds:
        return ["plan.md labeled done_sentence must equal spec.md"]
    return []


def _section_h2(text: str, title: str) -> Optional[str]:
    lines = text.splitlines()
    start = None
    in_fence = False
    for i, line in enumerate(lines):
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = re.match(r"^[ \t]{0,3}(#{1,6})\s+(.*)$", line)
        if not m:
            continue
        if start is None:
            if len(m.group(1)) == 2 and re.search(
                rf"(?i)^{re.escape(title)}\b", m.group(2).strip()
            ):
                start = i + 1
            continue
        if len(m.group(1)) <= 2:
            return "\n".join(lines[start:i])
    if start is not None:
        return "\n".join(lines[start:])
    return None


def plan_waiver(state: Dict[str, Any]) -> Optional[str]:
    bound_plan = str(state.get("bound_plan") or "")
    if not bound_plan:
        return None
    path = Path(bound_plan)
    if not path.is_file():
        return None
    bound_hash = str(state.get("bound_plan_hash") or "")
    if bound_hash and sha256_file(path) != bound_hash:
        return None
    text = path.read_text(encoding="utf-8")
    body = _section_h2(text, "Review Coverage")
    if body is None:
        return None
    scan_lines = []
    in_fence = False
    for line in body.splitlines():
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if not in_fence:
            scan_lines.append(line)
    scan = "\n".join(scan_lines)
    m = WAIVER_RE.search(scan)
    if not m:
        return None
    reason = (m.group("reason") or "").strip()
    if (
        not reason
        or PLACEHOLDER_RE.fullmatch(reason)
        or re.fullmatch(r"<[^<>]+>", reason)
    ):
        return None
    return reason


def latest_round_body(text: str) -> Tuple[str, Optional[str]]:
    matches = list(ROUND_HEAD_RE.finditer(text))
    if not matches:
        return "", None
    last = matches[-1]
    start = last.start()
    end = len(text)
    for m in matches:
        if m.start() > start:
            end = m.start()
            break
    return text[start:end], last.group("n")


def committed_review_round(
    repo_root: Path, n: str, *, expected_blob: str = ""
) -> Optional[str]:
    """Return a matching round commit only when it changed the current ledger.

    A ledger's own prose cannot certify that a Git commit touched it.  Search
    reachable history for the declared round, require that commit to change
    ``REVIEW_CONVERGE.md``, and, when supplied, require its blob to be the
    same blob currently visible at ``HEAD`` and in the working ledger.
    """
    subject_re = re.compile(
        rf"^(?:review-converge|grok-review-converge):\s*round\s+{re.escape(n)}\s+—"
    )
    got = git_run(repo_root, "log", "--format=%H%x00%s", "HEAD")
    if got.returncode != 0:
        return None
    for line in (got.stdout or "").splitlines():
        sha, sep, subject = line.partition("\x00")
        if not sep or not subject_re.match(subject):
            continue
        changed = git_run(
            repo_root,
            "diff-tree",
            "--no-commit-id",
            "--name-only",
            "-r",
            sha,
            "--",
            "REVIEW_CONVERGE.md",
        )
        if (
            changed.returncode != 0
            or "REVIEW_CONVERGE.md" not in (changed.stdout or "").splitlines()
        ):
            continue
        if expected_blob:
            blob = git_run(repo_root, "rev-parse", f"{sha}:REVIEW_CONVERGE.md")
            if blob.returncode != 0 or blob.stdout.strip() != expected_blob:
                continue
        return sha
    return None


def ledger_report(repo_root: Path, state: Dict[str, Any]) -> Dict[str, Any]:
    ledger = repo_root / "REVIEW_CONVERGE.md"
    out: Dict[str, Any] = {
        "present": ledger.is_file(),
        "status": None,
        "bound": False,
        "landed": False,
        "foreign": False,
        "head_blob_matches": False,
        "index_clean": False,
        "ledger_change_commit": None,
        "path": str(ledger),
    }
    if not ledger.is_file() or ledger.is_symlink():
        return out
    text = ledger.read_text(encoding="utf-8")
    sm = STATUS_RE.search(text)
    if sm:
        out["status"] = sm.group("state")
    cm = PLAN_CONTRACT_RE.search(text)
    hm = PLAN_HASH_RE.search(text)
    contract = cm.group("path").strip() if cm else ""
    phash = hm.group("hash").strip().lower() if hm else ""
    bound_plan = str(state.get("bound_plan") or "")
    bound_hash = str(state.get("bound_plan_hash") or "").lower()
    if bound_plan and contract:
        try:
            same_path = Path(contract).resolve() == Path(bound_plan).resolve()
        except OSError:
            same_path = os.path.normpath(contract) == os.path.normpath(bound_plan)
        same_hash = (not bound_hash) or (phash == bound_hash)
        out["bound"] = bool(same_path and same_hash)
        out["foreign"] = not same_path or (bound_hash and phash and phash != bound_hash)
    elif bound_plan:
        out["foreign"] = True
    round_body, n = latest_round_body(text)
    last_c = None
    for line in round_body.splitlines():
        if re.search(r"(?i)^(?:\*\*Committed:\*\*|Committed:)\s*", line):
            last_c = line
    committed_yes = bool(
        last_c
        and re.search(r"(?i)yes\b", last_c)
        and not re.search(r"(?i)no\b", last_c)
    )
    head_blob = git_run(repo_root, "rev-parse", "HEAD:REVIEW_CONVERGE.md")
    working_blob = git_run(repo_root, "hash-object", "REVIEW_CONVERGE.md")
    if head_blob.returncode == 0 and working_blob.returncode == 0:
        out["head_blob_matches"] = (
            head_blob.stdout.strip() == working_blob.stdout.strip()
        )
    index = git_run(
        repo_root, "diff", "--cached", "--quiet", "--", "REVIEW_CONVERGE.md"
    )
    out["index_clean"] = index.returncode == 0
    if n is not None:
        out["ledger_change_commit"] = committed_review_round(
            repo_root,
            n,
            expected_blob=working_blob.stdout.strip()
            if out["head_blob_matches"]
            else "",
        )
    out["landed"] = bool(
        committed_yes
        and out["head_blob_matches"]
        and out["index_clean"]
        and out["ledger_change_commit"]
    )
    return out


def residual_gaps(state: Dict[str, Any], dest: str) -> List[str]:
    waiver = plan_waiver(state)
    repo = Path(str(state.get("repo_root") or "")).expanduser()
    if dest == "done" and waiver:
        return []
    if not repo.is_dir():
        return ["repo_root is not a directory"]
    rep = ledger_report(repo, state)
    if not rep["present"]:
        return [f"missing ledger {rep['path']}"]
    if rep["foreign"] or not rep["bound"]:
        return ["foreign or unbound REVIEW_CONVERGE.md"]
    status = rep["status"] or ""
    if dest == "done":
        if status != "complete":
            return [f"ledger status {status!r} is not complete"]
        if not rep["landed"]:
            return ["ledger complete but not landed"]
        return []
    if dest == "halted":
        if not str(status).startswith("stopped"):
            return [f"ledger status {status!r} is not stopped"]
        return []
    return ["residual not terminal"]


def load_dag(run_dir: Path) -> Optional[Dict[str, Any]]:
    path = canonical_backchain(run_dir)
    if not path.is_file():
        return None
    if path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {path}")
    inside_run_dir(run_dir, path)
    try:
        data = store.read_record(path)
    except store.StorageError as exc:
        die(EXIT_BLOCKED, f"cannot parse authoritative backchain/plan.md: {exc}")
    if not isinstance(data, dict):
        die(EXIT_BLOCKED, "backchain plan.md is not an object")
    return data


def dag_gaps(run_dir: Path, spec: Optional[Dict[str, Any]]) -> List[str]:
    gaps: List[str] = []
    path = canonical_backchain(run_dir)
    if not path.is_file():
        return [f"missing {path}"]
    data = load_dag(run_dir)
    if data is None:
        return [f"missing {path}"]
    for key in ("goal", "initial_state", "steps", "unresolved"):
        if key not in data:
            gaps.append(f"backchain missing key {key}")
    steps = data.get("steps")
    if not isinstance(steps, list) or not steps:
        gaps.append("backchain steps must be a nonempty list")
        return gaps
    unresolved = data.get("unresolved")
    if unresolved is None:
        gaps.append("backchain missing key unresolved")
    elif not isinstance(unresolved, list):
        gaps.append("backchain unresolved must be a list")
    elif unresolved:
        gaps.append("unresolved must be empty to enter implement")
    goal = data.get("goal")
    spec_ds = (spec or {}).get("done_sentence")
    if not isinstance(goal, str) or not goal.strip():
        gaps.append(
            "backchain.goal must be a nonempty string equal to spec.done_sentence"
        )
    elif spec_ds is not None and goal != spec_ds:
        gaps.append("backchain.goal must equal spec.done_sentence")
    initial = data.get("initial_state")
    if not isinstance(initial, list):
        gaps.append("initial_state must be a list")
        initial = []
    initial_set = {x for x in initial if isinstance(x, str)}
    ref_paths: List[str] = []
    env, _ = load_environment(run_dir)
    mcp_considered = ""
    dont_use_tokens = _dont_use_tokens(env if isinstance(env, dict) else None)
    use_token = _use_token(env if isinstance(env, dict) else None)
    reserved_paths = _reserved_paths(env if isinstance(env, dict) else None)
    if isinstance(env, dict):
        mc = env.get("mcp_considered")
        if isinstance(mc, str) and mc.strip():
            mcp_considered = mc.strip()
        for r in env.get("references") or []:
            if isinstance(r, dict):
                rp = r.get("path")
                if isinstance(rp, str) and rp.strip():
                    ref_paths.append(rp.strip())
    ids: List[str] = []
    seen: Set[str] = set()
    graph: Dict[str, List[str]] = {}
    for i, step in enumerate(steps):
        if not isinstance(step, dict):
            gaps.append(f"steps[{i}] is not an object")
            continue
        sid = step.get("id")
        if not isinstance(sid, str) or not STEP_ID_RE.fullmatch(sid):
            gaps.append(f"unsafe or missing step id {sid!r}")
            continue
        if ".." in sid or "/" in sid:
            gaps.append(f"unsafe step id {sid}")
            continue
        if sid in seen:
            gaps.append(f"duplicate step id {sid}")
        seen.add(sid)
        ids.append(sid)
        statement = step.get("statement")
        if not isinstance(statement, str) or not statement.strip():
            gaps.append(f"{sid} statement must be a nonempty string")
        elif CONTROL_RE.search(statement) or has_disallowed_slash(statement):
            gaps.append(
                f"{sid} statement contains a newline, control, or disallowed slash skill"
            )
        prompt = step.get("prompt")
        if not isinstance(prompt, str) or not prompt.strip():
            gaps.append(f"{sid} prompt must be a nonempty string")
        elif PROMPT_CONTROL_RE.search(prompt) or has_disallowed_slash(prompt):
            gaps.append(
                f"{sid} prompt contains a disallowed control character or slash skill"
            )
        elif step.get("origin") == "seed":
            # Citation stays behind nonempty ref_paths. Tools:/token is a
            # sibling seed-only gate — greenfield references: [] still
            # requires it. inject-step (origin discovered) is exempt.
            if ref_paths:
                for rp in ref_paths:
                    if rp not in prompt:
                        gaps.append(
                            f"{sid} prompt must cite environment reference {rp}"
                        )
            if not any(
                re.match(r"^[ \t]*Tools:", line) for line in prompt.splitlines()
            ):
                gaps.append(
                    f"{sid} prompt must have a line starting with Tools:; "
                    f"{ENV_RECOVERY}"
                )
            if mcp_considered and mcp_considered not in prompt:
                gaps.append(
                    f"{sid} prompt must cite mcp_considered {mcp_considered}; "
                    f"{ENV_RECOVERY}"
                )
        produces = step.get("produces")
        texts = produces_texts(produces)
        if texts is None:
            gaps.append(f"{sid} produces must be a nonempty string or string list")
        else:
            for t in texts:
                if CONTROL_RE.search(t) or has_disallowed_slash(t):
                    gaps.append(
                        f"{sid} produces contains a newline, control, or disallowed slash skill"
                    )
            if isinstance(prompt, str) and prompt.strip():
                gaps.extend(prompt_until_gaps(sid, prompt, texts))
        origin = step.get("origin")
        if origin not in ("seed", "discovered"):
            gaps.append(f"{sid} origin must be seed or discovered")
        elif (
            _exclusive_rows(env if isinstance(env, dict) else None)
            and isinstance(prompt, str)
            and prompt.strip()
        ):
            gaps.extend(writer_prompt_gaps(sid, prompt, dont_use_tokens, use_token))
        if origin == "seed" and isinstance(prompt, str) and prompt.strip():
            gaps.extend(reserved_prompt_gaps(sid, prompt, reserved_paths))
        inputs = step.get("inputs")
        if not isinstance(inputs, list):
            gaps.append(f"{sid} inputs must be a list")
            inputs = []
        graph.setdefault(sid, [])
        for inp in inputs:
            if not isinstance(inp, dict):
                gaps.append(f"{sid} input is not an object")
                continue
            need = inp.get("need")
            if not isinstance(need, str) or not need.strip():
                gaps.append(f"{sid} inputs[].need must be nonempty")
            fr = inp.get("from")
            if fr is None:
                if isinstance(need, str) and need not in initial_set:
                    gaps.append(f"{sid} from:null need not in initial_state")
            elif not isinstance(fr, str):
                gaps.append(f"{sid} inputs[].from must be null or an id")
            else:
                graph[sid].append(fr)
    for sid, deps in graph.items():
        for fr in deps:
            if fr not in seen:
                gaps.append(f"{sid} inputs.from {fr} is not an existing id")
    if isinstance(env, dict) and env.get("ui") is True:
        design_seed_ids: Set[str] = set()
        seed_inputs: Dict[str, Set[str]] = {}
        for step in steps:
            if not isinstance(step, dict) or step.get("origin") != "seed":
                continue
            sid = step.get("id")
            if not isinstance(sid, str):
                continue
            texts = produces_texts(step.get("produces"))
            if texts and any(
                re.search(r"(?i)\b(design|visual identity|interaction model)\b", text)
                for text in texts
            ):
                design_seed_ids.add(sid)
            raw_inputs = step.get("inputs")
            if isinstance(raw_inputs, list):
                seed_inputs[sid] = {
                    inp["from"]
                    for inp in raw_inputs
                    if isinstance(inp, dict) and isinstance(inp.get("from"), str)
                }
        if not design_seed_ids:
            gaps.append("ui requires a design-producing seed")
        elif not any(
            design_id in deps
            for seed_id, deps in seed_inputs.items()
            for design_id in design_seed_ids
            if seed_id != design_id
        ):
            gaps.append("ui design seed must feed another seed")
    # cycle
    WHITE, GREY, BLACK = 0, 1, 2
    color = {sid: WHITE for sid in seen}

    def visit(node: str) -> bool:
        color[node] = GREY
        for nxt in graph.get(node, []):
            if nxt not in color:
                continue
            if color[nxt] == GREY:
                return True
            if color[nxt] == WHITE and visit(nxt):
                return True
        color[node] = BLACK
        return False

    for sid in seen:
        if color[sid] == WHITE and visit(sid):
            gaps.append("committed cycle")
            break
    # Versionless plans retain their documented compatibility path.  A DAG that
    # explicitly opts into step contracts, however, must validate every
    # criterion before it can become a candidate.  Protocol state decides when
    # an old run is explicitly upgraded; this core validator never fabricates a
    # contract for it.
    gaps.extend(f"backchain {gap}" for gap in contracts.dag_gaps(data))
    return gaps


def steps_dir(run_dir: Path) -> Path:
    return run_dir / "steps"


def receipt_path(run_dir: Path, sid: str) -> Path:
    if not STEP_ID_RE.fullmatch(sid):
        die(EXIT_BLOCKED, f"unsafe step id {sid}")
    path = steps_dir(run_dir) / f"{sid}.md"
    inside_run_dir(run_dir, path)
    return path


def load_receipt(run_dir: Path, sid: str) -> Optional[Dict[str, Any]]:
    """Load a Markdown-authoritative step receipt; JSON twins are ignored."""
    path = receipt_path(run_dir, sid)
    if not path.is_file():
        return None
    if path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {path}")
    try:
        data = store.read_record(path)
    except store.StorageError as exc:
        die(EXIT_BLOCKED, f"cannot parse authoritative receipt {path.name}: {exc}")
    return data if isinstance(data, dict) else None


def receipt_matches(rec: Optional[Dict[str, Any]], plan_hash: str, status: str) -> bool:
    return bool(
        rec and rec.get("status") == status and rec.get("plan_sha256") == plan_hash
    )


def repo_of(state: Dict[str, Any]) -> Path:
    return Path(str(state.get("repo_root") or "")).expanduser()


def git_run(
    repo: Path, *args: str, timeout: int = 30, record: bool = False
) -> subprocess.CompletedProcess[str]:
    """Run Git without raising; callers choose whether a failure is fatal."""
    argv = ["git", "-C", str(repo), *args]
    try:
        proc = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        proc = subprocess.CompletedProcess(argv, 127, "", "git not found")
    except subprocess.TimeoutExpired:
        proc = subprocess.CompletedProcess(argv, 124, "", "git timeout")
    if record:
        _record_git(argv, proc)
    return proc


def git_repo_ready(repo: Path) -> bool:
    if not repo.is_dir():
        return False
    inside = git_run(repo, "rev-parse", "--is-inside-work-tree")
    if inside.returncode != 0 or inside.stdout.strip() != "true":
        return False
    head = git_run(repo, "rev-parse", "--verify", "HEAD")
    return head.returncode == 0 and bool(head.stdout.strip())


def worktree_branch(run_id: str, sid: str) -> str:
    return f"shiploop/{run_id}/{sid}"


def worktree_path(repo: Path, run_id: str, sid: str) -> Path:
    return (repo / WT_DIRNAME / "shiploop" / run_id / sid).resolve()


def ensure_worktrees_excluded(repo: Path) -> None:
    """Keep harness worktrees out of the product's tracked tree."""
    probe = git_run(repo, "check-ignore", "-q", "--", f"{WT_DIRNAME}/probe")
    if probe.returncode == 0:
        return
    excl = git_run(repo, "rev-parse", "--git-path", "info/exclude")
    if excl.returncode != 0 or not excl.stdout.strip():
        die(EXIT_BLOCKED, "cannot resolve .git/info/exclude for worktree ignore")
    raw = excl.stdout.strip()
    path = Path(raw) if Path(raw).is_absolute() else repo / raw
    path.parent.mkdir(parents=True, exist_ok=True)
    existing = path.read_text(encoding="utf-8") if path.is_file() else ""
    if f"{WT_DIRNAME}/" not in existing:
        path.write_text(existing.rstrip() + f"\n{WT_DIRNAME}/\n", encoding="utf-8")


def steps_by_id(run_dir: Path) -> Dict[str, Dict[str, Any]]:
    data = load_dag(run_dir) or {}
    return {
        step["id"]: step
        for step in data.get("steps") or []
        if isinstance(step, dict) and isinstance(step.get("id"), str)
    }


def suppliers_complete(step: Dict[str, Any], run_dir: Path, plan_hash: str) -> bool:
    for inp in step.get("inputs") or []:
        if not isinstance(inp, dict):
            return False
        supplier = inp.get("from")
        if supplier is not None and not receipt_matches(
            load_receipt(run_dir, str(supplier)), plan_hash, "complete"
        ):
            return False
    return True


def classify_steps(run_dir: Path, state: Dict[str, Any]) -> Dict[str, str]:
    plan_hash = str(state.get("plan_sha256") or "")
    out: Dict[str, str] = {}
    for sid, step in steps_by_id(run_dir).items():
        receipt = load_receipt(run_dir, sid)
        if receipt_matches(receipt, plan_hash, "complete"):
            out[sid] = "done"
        elif receipt_matches(receipt, plan_hash, "running"):
            out[sid] = "running"
        elif suppliers_complete(step, run_dir, plan_hash):
            out[sid] = "ready"
        else:
            out[sid] = "todo"
    return out


def recomputed_step_ids(run_dir: Path) -> List[str]:
    return sorted(steps_by_id(run_dir))


def check_frozen_hashes(
    state: Dict[str, Any], run_dir: Path, dest: Optional[str]
) -> None:
    """Fail closed on drift of Markdown-authoritative frozen artifacts."""
    if dest == "blocked":
        return
    if dest in ("plan", "validate-spec"):
        return
    checks = (
        (
            "environment_sha256",
            run_dir / "environment.md",
            "environment hash drift; restore frozen content or use revisit --to survey before execution",
        ),
        (
            "spec_sha256",
            run_dir / "spec.md",
            "spec hash drift; restore frozen content or use revisit --to spec before execution",
        ),
        (
            "plan_sha256",
            canonical_backchain(run_dir),
            "plan hash drift; restore frozen content and submit a validated pending-only plan revision",
        ),
    )
    for key, path, message in checks:
        expected = str(state.get(key) or "")
        if not expected:
            continue
        if not path.is_file():
            die(EXIT_BLOCKED, message)
        actual = sha256_file(path)
        if actual != expected:
            die(EXIT_BLOCKED, message)


def improve_cycles_of(rec: Optional[Dict[str, Any]]) -> List[Dict[str, Any]]:
    raw = rec.get("improve_cycles") if isinstance(rec, dict) else None
    return (
        [row for row in raw if isinstance(row, dict)] if isinstance(raw, list) else []
    )


def improve_until_passes(rec: Optional[Dict[str, Any]]) -> Optional[List[Dict[str, Any]]]:
    """Project only audited, verified primary cycles into the shared policy.

    Repair checkpoints are durable material boundaries but not completed primary
    passes, so they reset the current epoch.  A malformed cycle fails closed
    rather than being silently skipped past an earlier pair of trivial passes.
    """
    if not isinstance(rec, dict):
        return []
    raw = rec.get("improve_cycles")
    if raw is None:
        return []
    if not isinstance(raw, list):
        return None
    passes: List[Dict[str, Any]] = []
    for row in raw:
        if not isinstance(row, dict):
            return None
        primary = row.get("primary_commit")
        if primary is None:
            if row.get("outcome") == "material":
                passes = []
                continue
            return None
        iteration_id = row.get("id")
        commit = row.get("commit")
        if not (
            isinstance(iteration_id, str)
            and isinstance(primary, str)
            and isinstance(commit, dict)
            and commit.get("sha") == primary
            and commit.get("action") == iteration_id
            and isinstance(row.get("check_action"), str)
            and row["check_action"].strip()
            and isinstance(row.get("review"), dict)
            and isinstance(row.get("applied"), dict)
            and isinstance(row.get("carry_forward"), dict)
        ):
            return None
        passes.append(
            {
                "id": iteration_id,
                "outcome": row.get("outcome"),
                # The protocol reaches this append only after verified() and
                # evidence.validate_commit(); do not accept a host flag here.
                "verified": True,
                "commit": primary,
            }
        )
    return passes


def improve_until_decision(rec: Optional[Dict[str, Any]]) -> Dict[str, Any]:
    """Return the shared continuation decision, fail-closed on stale receipts."""
    passes = improve_until_passes(rec)
    if passes is None:
        return {"phase": "active", "trivial_streak": 0}
    try:
        # review/plan/apply/carry-forward gates are all present on every
        # projected pass, so no unresolved finding is eligible to be omitted.
        return until.decide(passes, open_findings=[])
    except until.UntilError:
        return {"phase": "active", "trivial_streak": 0}


def improve_consecutive_trivial(rec: Optional[Dict[str, Any]]) -> int:
    return int(improve_until_decision(rec)["trivial_streak"])


def improve_two_clean(rec: Optional[Dict[str, Any]]) -> bool:
    return improve_until_decision(rec)["phase"] == "ready"


def improve_packet_closer(rec: Optional[Dict[str, Any]]) -> bool:
    """Close only after two verified, audited consecutive trivial passes."""
    return improve_two_clean(rec)


def improve_ready_to_merge(
    rec: Optional[Dict[str, Any]], improve: Optional[str] = None
) -> bool:
    """Successful completion has no cycle-cap or unverified-receipt override."""
    del improve
    return improve_two_clean(rec)


def produces_texts(produces: Any) -> Optional[List[str]]:
    if isinstance(produces, str) and produces.strip():
        return [produces.strip()]
    if isinstance(produces, list) and produces:
        out: List[str] = []
        for item in produces:
            if not isinstance(item, str) or not item.strip():
                return None
            out.append(item.strip())
        return out
    return None


def main(argv: Optional[List[str]] = None) -> int:
    """The extensionless entrypoint delegates all CLI protocol work."""
    import shiploop_protocol

    return shiploop_protocol.main(sys.modules[__name__], argv)


if __name__ == "__main__":
    sys.exit(main())
