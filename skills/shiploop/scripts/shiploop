#!/usr/bin/env python3
"""shiploop — session harness entrypoint.

This module is the ``core`` object the CLI modules receive: package locators,
exit codes, and the run-directory, state and lock helpers.  All CLI protocol
work lives in shiploop_protocol.
"""

from __future__ import annotations

import errno
import fcntl
import os
import stat
import sys
from contextlib import contextmanager
from pathlib import Path
from typing import Any, Dict, Iterator, List, Optional

sys.path.insert(0, str(Path(__file__).resolve().parent))
import shiploop_store as store

EXIT_OK = 0
EXIT_BLOCKED = 2
EXIT_USAGE = 64

PACKAGE_ROOT = Path(__file__).resolve().parents[1]
REF_DIR = PACKAGE_ROOT / "references"


def die(code: int, msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def refuse_package_path(path: Path) -> None:
    try:
        path.resolve().relative_to(PACKAGE_ROOT)
    except ValueError:
        return
    die(EXIT_BLOCKED, f"refusing path inside skill package: {path}")


def run_dir_from_arg(raw: Optional[str], *, walk: bool) -> Path:
    if raw:
        p = Path(raw).expanduser()
        if p.name != ".shiploop" and (
            (p / ".shiploop" / "state.md").is_file()
            or (p / ".shiploop" / "state.json").is_file()
        ):
            p = p / ".shiploop"
        return p
    if not walk:
        return Path.cwd() / ".shiploop"
    cur = Path.cwd().resolve()
    for parent in [cur, *cur.parents]:
        cand = parent / ".shiploop"
        if (cand / "state.md").is_file() or (cand / "state.json").is_file():
            return cand
    return Path.cwd() / ".shiploop"


def load_state(run_dir: Path) -> Dict[str, Any]:
    refuse_package_path(run_dir)
    state_path = run_dir / "state.md"
    if not state_path.is_file():
        if (run_dir / "state.json").is_file():
            import shiploop_navigator as navigator

            die(EXIT_BLOCKED, navigator.retired_json_run_reason(run_dir))
        die(EXIT_BLOCKED, f"no authoritative state.md in {run_dir}")
    if state_path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {state_path}")
    try:
        data = store.read_record(state_path)
    except store.StorageError as exc:
        die(EXIT_BLOCKED, f"cannot parse authoritative state.md: {exc}")
    if not isinstance(data, dict):
        die(EXIT_BLOCKED, "state.md is not an object")
    return data


@contextmanager
def run_lock(run_dir: Path) -> Iterator[None]:
    refuse_package_path(run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)
    lock = run_dir / ".lock"
    if lock.is_symlink():
        die(EXIT_BLOCKED, f"symlink lock refused: {lock}")
    flags = os.O_CREAT | os.O_RDWR | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0)
    try:
        fd = os.open(str(lock), flags, 0o600)
    except OSError as exc:
        if exc.errno in (errno.ELOOP, errno.EMLINK) or lock.is_symlink():
            die(EXIT_BLOCKED, f"symlink lock refused: {lock}")
        die(EXIT_BLOCKED, f"cannot open run lock {lock}: {exc}")
    acquired = False
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise store.StorageError(f"run lock must be a regular single-link file: {lock}")
        fcntl.flock(fd, fcntl.LOCK_EX)
        acquired = True
        store.recover(run_dir)
        yield
    finally:
        try:
            if acquired:
                fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


@contextmanager
def read_run_lock(run_dir: Path) -> Iterator[None]:
    """Read a settled snapshot without creating files, waiting, or recovering.

    Observers must not expose a cursor while a writer is applying its journal.
    The shared lock excludes writers; a pending journal requires explicit
    recovery by the normal command path before an observer can answer.
    """
    refuse_package_path(run_dir)
    lock = run_dir / ".lock"
    flags = os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_NOFOLLOW", 0)
    fd = None
    acquired = False
    try:
        if lock.is_symlink():
            raise store.StorageError(f"symlink lock refused: {lock}")
        fd = os.open(str(lock), flags)
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise store.StorageError(f"run lock must be a regular single-link file: {lock}")
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except OSError as exc:
            if exc.errno in (errno.EACCES, errno.EAGAIN):
                raise store.StorageError("run is busy; retry after the current command finishes") from exc
            raise
        acquired = True
        if os.path.lexists(run_dir / store.JOURNAL_NAME):
            raise store.StorageError("run has a pending transaction; use next to recover before reading status")
        yield
    finally:
        if fd is not None:
            try:
                if acquired:
                    fcntl.flock(fd, fcntl.LOCK_UN)
            finally:
                os.close(fd)


def main(argv: Optional[List[str]] = None) -> int:
    """The extensionless entrypoint delegates all CLI protocol work."""
    import shiploop_protocol

    return shiploop_protocol.main(sys.modules[__name__], argv)


if __name__ == "__main__":
    sys.exit(main())
