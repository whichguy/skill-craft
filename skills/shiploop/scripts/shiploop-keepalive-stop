#!/usr/bin/env python3
"""Plugin hook entry: ShipLoop keepalive stop (host detected from the payload).

Generated host hook files may only run an argument-free script from scripts/,
so this is `shiploop-hook stop --host auto` in that shape.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import shiploop_keepalive  # noqa: E402

if __name__ == "__main__":
    sys.exit(shiploop_keepalive.hook_main(["stop", "--host", "auto"]))
