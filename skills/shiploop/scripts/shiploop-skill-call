#!/usr/bin/env python3
"""Plugin hook entry: record a Skill-tool call of a bound Claude Code session in its run.

Generated host hook files may only run an argument-free script from scripts/,
so this is `shiploop-hook skill --host claude` in that shape.  It never blocks
the Skill call; see references/keepalive.md.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import shiploop_keepalive  # noqa: E402

if __name__ == "__main__":
    sys.exit(shiploop_keepalive.hook_main(["skill", "--host", "claude"]))
