#!/bin/sh
# Claude Code PostToolUse hook: show ShipLoop's own progress to the user.
# Cheap exit for every Bash call that printed no ShipLoop packet (its header line)
# and no `shiploop status` block; never fails the tool call. See references/status-display.md.
input=$(cat) || exit 0
case $input in
  *'ShipLoop navigator | '*|*'=== ShipLoop status ==='*) ;;
  *) exit 0 ;;
esac
dir=$(dirname "$0") || exit 0
printf '%s' "$input" | python3 "$dir/shiploop_status_hook.py" 2>/dev/null
exit 0
