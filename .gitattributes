# Some Backchain Markdown depends on trailing spaces (hard line breaks). Never
# convert line endings or flag whitespace in its source or its generated
# plugin view.
skills/backchain/** -text -whitespace
plugins/backchain/** -text -whitespace

# Learning records are append-only rows with unique ids; two branches that append merge by keeping both.
test/shiploop_e2e/learning-records.jsonl merge=union

# Results returned from a live run are kept byte for byte, a trailing blank line included.
docs/experiments/closed-loop-pilot-20261101/run-*/** -text -whitespace
docs/experiments/closed-loop-restore-20261101/run-*/** -text -whitespace
docs/experiments/closed-loop-cycle-20261101/run-*-results/** -text -whitespace
