#!/usr/bin/env bash
# One CLI family for prompt-on-change. Resolves SKILL_ROOT from this script
# (physical path) so Grok/Claude skill-dir symlinks still find the engine.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SKILL_ROOT="${SKILL_ROOT:-$(cd "$here/.." && pwd -P)}"
poc_state_default="${XDG_STATE_HOME:-$HOME/.local/state}/prompt-on-change"
POC_STATE_DIR="${POC_STATE_DIR:-$poc_state_default}"
DETECT_ENGINE_ESCALATION_DIR="${DETECT_ENGINE_ESCALATION_DIR:-$POC_STATE_DIR/escalations}"
DETECT_ENGINE_HEALTH_DIR="${DETECT_ENGINE_HEALTH_DIR:-$POC_STATE_DIR}"
DETECT_ENGINE_LOG_FILE="${DETECT_ENGINE_LOG_FILE:-$POC_STATE_DIR/detect-engine.log}"
VENV_DIR="${POC_VENV_DIR:-$POC_STATE_DIR/.venv}"
ENGINE="${ENGINE:-$SKILL_ROOT/scripts/detect_engine.py}"
DELIVERY_HELPER="${DELIVERY_HELPER:-$SKILL_ROOT/scripts/poc_delivery.py}"
ESCALATION_PROMPT="${ESCALATION_PROMPT:-$SKILL_ROOT/prompts/escalation.prompt.md}"
EVENT_PROMPT="${EVENT_PROMPT:-$SKILL_ROOT/prompts/event.prompt.md}"

export SKILL_ROOT POC_STATE_DIR
export DETECT_ENGINE_ESCALATION_DIR DETECT_ENGINE_HEALTH_DIR DETECT_ENGINE_LOG_FILE

usage() {
  printf 'Usage: %s <bootstrap|validate|run|explain|status|claim|issue|self-check> [flags]\n' "${0##*/}" >&2
  printf '  bootstrap\n' >&2
  printf '  validate --config PATH\n' >&2
  printf '  run --config PATH [--dry-run] [--no-issue] [--exec]\n' >&2
  printf '      [--to grok:<uuid>] [--force-new] [--assume-idle] [--cwd PATH]\n' >&2
  printf '      # match issues the escalation prompt (PROMPT_ISSUED); --exec runs it\n' >&2
  printf '      # --to grok:<uuid> resumes or starts that session (refuse if live)\n' >&2
  printf '  explain --config PATH\n' >&2
  printf '  status\n' >&2
  printf '  claim\n' >&2
  printf '  issue [--evidence PATH ...] [--last] [--exec]\n' >&2
  printf '        [--to grok:<uuid>] [--force-new] [--assume-idle] [--cwd PATH]\n' >&2
  printf '  self-check\n' >&2
}

resolve_python() {
  if [[ -n "${PYTHON:-}" ]]; then
    printf '%s\n' "$PYTHON"
    return
  fi
  if [[ -x "$VENV_DIR/bin/python" ]]; then
    printf '%s\n' "$VENV_DIR/bin/python"
    return
  fi
  printf '%s\n' "python3"
}

resolve_grok() {
  if [[ -n "${GROK_BIN:-}" ]]; then
    printf '%s\n' "$GROK_BIN"
    return
  fi
  if command -v grok >/dev/null 2>&1; then
    command -v grok
    return
  fi
  if [[ -x "${HOME}/.local/bin/grok" ]]; then
    printf '%s\n' "${HOME}/.local/bin/grok"
    return
  fi
  printf '%s\n' "grok"
}

refuse_venv_inside_skill() {
  local state_real skill_real
  mkdir -p "$POC_STATE_DIR"
  state_real="$(cd "$POC_STATE_DIR" && pwd -P)"
  skill_real="$SKILL_ROOT"
  case "$state_real" in
    "$skill_real"|"$skill_real"/*)
      printf 'bootstrap: refuse venv inside skill package (%s)\n' "$state_real" >&2
      exit 1
      ;;
  esac
}

cmd_bootstrap() {
  refuse_venv_inside_skill
  local pyproject="$SKILL_ROOT/pyproject.toml"
  [[ -f "$pyproject" ]] || { printf 'bootstrap: missing %s\n' "$pyproject" >&2; exit 1; }
  python3 -m venv "$VENV_DIR"
  # Runtime deps from pyproject.toml (no editable install — no build-system).
  local deps
  deps="$(python3 -c "
import pathlib, sys
try:
    import tomllib
except ImportError:
    import tomli as tomllib
p = tomllib.loads(pathlib.Path(sys.argv[1]).read_text())
print('\\n'.join(p['project']['dependencies']))
" "$pyproject")" || { printf 'bootstrap: could not read pyproject.toml deps\n' >&2; exit 1; }
  printf '%s\n' "$deps" | "$VENV_DIR/bin/pip" install -q -r /dev/stdin
  printf 'bootstrap: venv at %s\n' "$VENV_DIR"
}

new_stamp() {
  python3 -c 'import uuid; from datetime import datetime, timezone; print(datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S") + "-" + str(uuid.uuid4()))'
}

new_uuid() {
  uuidgen | tr '[:upper:]' '[:lower:]'
}

# Sets to_spec / force_new / assume_idle / issue_cwd / do_exec.
# Returns consume-count (1 or 2). Callers must use `|| consumed=$?`
# so `set -e` does not treat a consume-count of 1 as a script failure.
parse_delivery_flag() {
  case "$1" in
    --to)
      [[ $# -ge 2 ]] || { printf 'missing --to grok:<uuid>\n' >&2; exit 64; }
      to_spec="$2"
      return 2
      ;;
    --force-new)
      force_new=1
      return 1
      ;;
    --assume-idle)
      assume_idle=1
      return 1
      ;;
    --cwd)
      [[ $# -ge 2 ]] || { printf 'missing --cwd PATH\n' >&2; exit 64; }
      issue_cwd="$2"
      return 2
      ;;
    --exec)
      do_exec=1
      return 1
      ;;
  esac
  return 0
}

parse_config_args() {
  config=""
  dry_run=0
  no_issue=0
  do_exec=0
  to_spec=""
  force_new=0
  assume_idle=0
  issue_cwd=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config)
        [[ $# -ge 2 ]] || { printf 'missing --config PATH\n' >&2; exit 64; }
        config="$2"
        shift 2
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      --no-issue)
        no_issue=1
        shift
        ;;
      --to|--force-new|--assume-idle|--exec|--cwd)
        local consumed=0
        parse_delivery_flag "$@" || consumed=$?
        if [[ "$consumed" -eq 2 ]]; then
          shift 2
        elif [[ "$consumed" -eq 1 ]]; then
          shift
        else
          printf 'unknown flag: %s\n' "$1" >&2
          usage
          exit 64
        fi
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        printf 'unknown flag: %s\n' "$1" >&2
        usage
        exit 64
        ;;
    esac
  done
  [[ -n "$config" ]] || { printf 'validate/run/explain require --config PATH\n' >&2; usage; exit 64; }
}

run_engine() {
  local python_bin
  python_bin="$(resolve_python)"
  [[ -f "$ENGINE" ]] || { printf 'engine missing: %s\n' "$ENGINE" >&2; exit 1; }
  if [[ "$dry_run" -eq 1 ]]; then
    exec "$python_bin" "$ENGINE" --config "$config" --dry-run
  fi
  exec "$python_bin" "$ENGINE" --config "$config" "$@"
}

cmd_validate() {
  parse_config_args "$@"
  local python_bin
  python_bin="$(resolve_python)"
  [[ -f "$ENGINE" ]] || { printf 'engine missing: %s\n' "$ENGINE" >&2; exit 1; }
  exec "$python_bin" "$ENGINE" --config "$config" --validate
}

collect_escalation_paths() {
  local line path
  while IFS= read -r line; do
    case "$line" in
      LLM_ESCALATION:*)
        path="${line#LLM_ESCALATION:}"
        path="${path# }"
        [[ -n "$path" ]] && printf '%s\n' "$path"
        ;;
    esac
  done
}

cmd_run() {
  parse_config_args "$@"
  local python_bin
  python_bin="$(resolve_python)"
  [[ -f "$ENGINE" ]] || { printf 'engine missing: %s\n' "$ENGINE" >&2; exit 1; }
  local -a eng=("$python_bin" "$ENGINE" --config "$config")
  if [[ "$dry_run" -eq 1 ]]; then
    eng+=(--dry-run)
  fi
  local out rc
  set +e
  out="$("${eng[@]}")"
  rc=$?
  set -e
  if [[ -n "$out" ]]; then
    printf '%s\n' "$out"
  fi
  if [[ "$rc" -ne 0 ]]; then
    return "$rc"
  fi
  if [[ "$no_issue" -eq 1 || "$dry_run" -eq 1 ]]; then
    return 0
  fi
  local -a esc_paths=()
  local p
  while IFS= read -r p; do
    [[ -n "$p" ]] && esc_paths+=("$p")
  done < <(printf '%s\n' "$out" | collect_escalation_paths)
  if [[ "${#esc_paths[@]}" -eq 0 ]]; then
    return 0
  fi
  local -a issue_args=()
  for p in "${esc_paths[@]}"; do
    issue_args+=(--evidence "$p")
  done
  if [[ -n "$to_spec" ]]; then
    issue_args+=(--to "$to_spec")
    [[ "$force_new" -eq 1 ]] && issue_args+=(--force-new)
    [[ "$assume_idle" -eq 1 ]] && issue_args+=(--assume-idle)
    [[ -n "$issue_cwd" ]] && issue_args+=(--cwd "$issue_cwd")
    issue_args+=(--exec)
    cmd_issue "${issue_args[@]}"
    return
  fi
  if [[ "$do_exec" -eq 1 ]]; then
    issue_args+=(--exec)
  fi
  cmd_issue "${issue_args[@]}"
}

cmd_explain() {
  parse_config_args "$@"
  local python_bin
  python_bin="$(resolve_python)"
  [[ -f "$ENGINE" ]] || { printf 'engine missing: %s\n' "$ENGINE" >&2; exit 1; }
  exec "$python_bin" "$ENGINE" --config "$config" --explain
}

pending_evidence() {
  local esc="$DETECT_ENGINE_ESCALATION_DIR"
  local f
  shopt -s nullglob
  for f in "$esc"/*.json; do
    [[ -f "$f" ]] || continue
    [[ "$(basename "$f")" == *.tmp ]] && continue
    printf '%s\n' "$f"
  done
  shopt -u nullglob
}

newest_file() {
  local newest="" newest_m=0 m f
  for f in "$@"; do
    [[ -f "$f" ]] || continue
    m="$(stat -f %m "$f" 2>/dev/null || stat -c %Y "$f" 2>/dev/null || echo 0)"
    if [[ "$m" -ge "$newest_m" ]]; then
      newest_m="$m"
      newest="$f"
    fi
  done
  printf '%s\n' "$newest"
}

cmd_status() {
  local esc="$DETECT_ENGINE_ESCALATION_DIR"
  mkdir -p "$esc/processed"
  local -a pending=()
  local f
  while IFS= read -r f; do
    [[ -n "$f" ]] && pending+=("$f")
  done < <(pending_evidence)
  local -a processed=()
  shopt -s nullglob
  for f in "$esc/processed"/*.json; do
    [[ -f "$f" ]] && processed+=("$f")
  done
  shopt -u nullglob

  printf 'status:\n'
  printf '  pending: %s\n' "${#pending[@]}"
  if [[ "${#pending[@]}" -eq 0 ]]; then
    printf '  CLAIM_EMPTY: no pending evidence under %s\n' "$esc"
  else
    for f in "${pending[@]}"; do
      printf '  pending_path: %s\n' "$f"
    done
  fi
  printf '  processed: %s\n' "${#processed[@]}"
  for f in "${processed[@]}"; do
    printf '  processed_path: %s\n' "$f"
  done

  local health
  shopt -s nullglob
  for health in "$DETECT_ENGINE_HEALTH_DIR"/*-health.json "$DETECT_ENGINE_HEALTH_DIR"/*_health.json; do
    [[ -f "$health" ]] || continue
    printf '  health: %s\n' "$health"
    python3 -c '
import json,sys
p=sys.argv[1]
try:
    d=json.loads(open(p,encoding="utf-8").read())
except Exception as e:
    print("    parse_error:", e)
    raise SystemExit(0)
print("    config:", d.get("config",""))
print("    status:", d.get("status",""))
print("    timestamp:", d.get("timestamp",""))
print("    detail:", d.get("detail",""))
' "$health" || true
  done
  shopt -u nullglob
}

cmd_claim() {
  local esc="$DETECT_ENGINE_ESCALATION_DIR"
  mkdir -p "$esc/processed"
  local found=0
  local f base dest
  shopt -s nullglob
  for f in "$esc"/*.json; do
    [[ -f "$f" ]] || continue
    [[ "$(basename "$f")" == *.tmp ]] && continue
    found=1
    base="$(basename "$f")"
    dest="$esc/processed/$base"
    if ! mv "$f" "$dest" 2>/dev/null; then
      printf 'CLAIM_SKIP: already claimed or gone: %s\n' "$f"
      continue
    fi
    printf 'CLAIMED: %s\n' "$dest"
    printf '%s\n' '---'
    cat "$dest"
    printf '\n%s\n' '---'
  done
  shopt -u nullglob
  if [[ "$found" -eq 0 ]]; then
    printf 'CLAIM_EMPTY: no pending evidence under %s\n' "$esc"
    printf '[SILENT]\n'
  fi
}

fill_issued_prompt() {
  local prompt_path="$1"
  local dest="$2"
  local replay="$3"
  shift 3
  local -a evidence_paths=("$@")
  local python_bin
  python_bin="$(resolve_python)"
  local list_file
  list_file="$(mktemp)"
  printf '%s\n' "${evidence_paths[@]}" >"$list_file"
  "$python_bin" - "$prompt_path" "$dest" "$DETECT_ENGINE_ESCALATION_DIR" "$replay" "$list_file" <<'PY'
import json, pathlib, sys
prompt_path, dest, esc_dir, replay, list_file = sys.argv[1:6]
paths = [p for p in pathlib.Path(list_file).read_text(encoding="utf-8").splitlines() if p]
text = pathlib.Path(prompt_path).read_text(encoding="utf-8")
text = text.replace("{{ESCALATION_DIR}}", esc_dir)
text = text.replace("{{EVIDENCE_FILES}}", "\n".join(paths))
matches = []
chunks = []
for evidence_path in paths:
    body = pathlib.Path(evidence_path).read_text(encoding="utf-8")
    try:
        data = json.loads(body)
    except Exception:
        data = {}
    matches.append({
        "evidence_path": evidence_path,
        "escalation_type": data.get("escalation_type"),
        "config_name": data.get("config_name"),
        "condition_id": data.get("condition_id"),
        "field": data.get("field"),
        "previous_value": data.get("previous_value"),
        "new_value": data.get("new_value"),
        "changed_fields": data.get("changed_fields"),
        "match_reason": data.get("match_reason"),
    })
    mode = "replay (already in processed/; do not claim again)" if replay == "1" else "reserved (do not scan or move)"
    chunks.append(
        f"Evidence path: {evidence_path}\nMode: {mode}\n\n```json\n{body.rstrip()}\n```\n"
    )
text = text.replace("{{MATCHES_JSON}}", json.dumps(matches, indent=2, default=str))
filled = text + "\n\n## Spliced evidence\n\n" + "\n".join(chunks)
pathlib.Path(dest).parent.mkdir(parents=True, exist_ok=True)
pathlib.Path(dest).write_text(filled, encoding="utf-8")
PY
  rm -f "$list_file"
}

parse_outcome_and_log() {
  local prompt_path="$1"
  local evidence_path="$2"
  local stdout_path="$3"
  local stderr_path="$4"
  local grok_exit="$5"
  local duration_ms="$6"
  local log_path="$7"
  local python_bin
  python_bin="$(resolve_python)"
  "$python_bin" - "$prompt_path" "$evidence_path" "$stdout_path" "$stderr_path" \
    "$grok_exit" "$duration_ms" "$log_path" <<'PY'
import json, pathlib, re, sys
prompt_path, evidence_path, stdout_path, stderr_path, grok_exit, duration_ms, log_path = sys.argv[1:8]
text = pathlib.Path(stdout_path).read_text(encoding="utf-8", errors="replace")
outcome = None
parse_error = None
m = re.search(r"```(?:json)?[ \t]*outcome[ \t]*\n(.*?)```", text, re.S | re.I)
if not m:
    m = re.search(r"```json[ \t]*\n(\s*\{.*?\})\s*```", text, re.S)
if m:
    try:
        outcome = json.loads(m.group(1))
    except Exception as exc:
        parse_error = str(exc)
else:
    parse_error = "no outcome fence"
silent = False
if isinstance(outcome, dict) and "silent" in outcome:
    silent = bool(outcome.get("silent"))
elif "[SILENT]" in text:
    silent = True
log = {
    "prompt_path": prompt_path,
    "evidence_path": evidence_path,
    "grok_exit": int(grok_exit),
    "duration_ms": int(duration_ms),
    "stdout_path": stdout_path,
    "stderr_path": stderr_path,
    "outcome": outcome,
    "parse_error": parse_error,
    "silent": silent,
}
pathlib.Path(log_path).parent.mkdir(parents=True, exist_ok=True)
pathlib.Path(log_path).write_text(json.dumps(log, indent=2) + "\n", encoding="utf-8")
print(json.dumps({"silent": silent, "parse_error": parse_error}, default=str))
PY
}

write_delivery_record() {
  local host="$1" id="$2" cwd="$3" rung="$4" config_name="$5"
  local dest_dir="$POC_STATE_DIR/delivery"
  mkdir -p "$dest_dir"
  local dest="$dest_dir/${config_name:-unknown}.json"
  python3 - "$dest" "$host" "$id" "$cwd" "$rung" "$config_name" <<'PY'
import json, pathlib, sys
from datetime import datetime, timezone
dest, host, ident, cwd, rung, config_name = sys.argv[1:7]
path = pathlib.Path(dest)
tmp = path.with_suffix(path.suffix + ".tmp")
tmp.write_text(json.dumps({
    "host": host,
    "id": ident,
    "cwd": cwd,
    "config_name": config_name,
    "last_rung": rung,
    "updated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
}, indent=2) + "\n", encoding="utf-8")
tmp.replace(path)
PY
}

exec_issued_prompt() {
  local prompt_path="$1"
  local evidence_path="$2"
  local mode="${3:-legacy}"   # legacy | resume | new
  local session_id="${4:-}"
  local grok
  grok="$(resolve_grok)"
  if [[ ! -x "$grok" ]] && ! command -v "$grok" >/dev/null 2>&1; then
    printf 'issue --exec: grok binary missing (%s). Set GROK_BIN.\n' "$grok" >&2
    exit 1
  fi
  local stamp
  stamp="$(new_stamp)"
  local run_dir="$POC_STATE_DIR/prompt-runs"
  mkdir -p "$run_dir"
  local stdout_path="$run_dir/${stamp}.stdout"
  local stderr_path="$run_dir/${stamp}.stderr"
  local log_path="$run_dir/${stamp}.json"
  local start end duration
  start="$(python3 -c 'import time; print(int(time.time()*1000))')"
  local cwd="${POC_ISSUE_CWD:-}"
  if [[ "$mode" == "legacy" && -z "$cwd" ]]; then
    cwd="$SKILL_ROOT"
  elif [[ -z "$cwd" ]]; then
    cwd="$PWD"
  fi
  local -a grok_args=(
    --prompt-file "$prompt_path"
    --cwd "$cwd"
    --output-format plain
    --no-subagents --no-memory --disable-web-search --no-auto-update
    --disallowed-tools "web_search,web_fetch,Agent"
    --max-turns "${POC_GROK_MAX_TURNS:-24}"
  )
  if [[ "$mode" == "legacy" ]]; then
    grok_args+=(--yolo --permission-mode bypassPermissions)
  else
    grok_args+=(--permission-mode dontAsk)
  fi
  if [[ "$mode" == "resume" ]]; then
    grok_args+=(--resume "$session_id")
  elif [[ "$mode" == "new" ]]; then
    grok_args+=(--session-id "$session_id" --sandbox read-only)
  fi
  if [[ -n "$session_id" && "$mode" != "legacy" ]]; then
    stdout_path="$run_dir/${stamp}-${session_id}.stdout"
    stderr_path="$run_dir/${stamp}-${session_id}.stderr"
    log_path="$run_dir/${stamp}-${session_id}.json"
  fi
  set +e
  "$grok" "${grok_args[@]}" >"$stdout_path" 2>"$stderr_path"
  local rc=$?
  set -e
  end="$(python3 -c 'import time; print(int(time.time()*1000))')"
  duration=$((end - start))
  parse_outcome_and_log "$prompt_path" "$evidence_path" "$stdout_path" "$stderr_path" \
    "$rc" "$duration" "$log_path" >/dev/null
  if [[ "$mode" == "resume" ]]; then
    printf 'PROMPT_RESUME: %s\n' "$log_path"
  else
    printf 'PROMPT_RUN: %s\n' "$log_path"
  fi
  if [[ "$rc" -ne 0 ]]; then
    printf 'issue --exec: grok exit %s (see %s)\n' "$rc" "$stderr_path" >&2
    return "$rc"
  fi
}

cmd_issue() {
  local -a evidence_paths=()
  local use_last=0
  local do_exec=0
  local to_spec=""
  local force_new=0
  local assume_idle=0
  local issue_cwd="${POC_ISSUE_CWD:-}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --evidence)
        [[ $# -ge 2 ]] || { printf 'missing --evidence PATH\n' >&2; exit 64; }
        evidence_paths+=("$2")
        shift 2
        ;;
      --last)
        use_last=1
        shift
        ;;
      --to|--force-new|--assume-idle|--exec|--cwd)
        local consumed=0
        parse_delivery_flag "$@" || consumed=$?
        if [[ "$consumed" -eq 2 ]]; then
          shift 2
        elif [[ "$consumed" -eq 1 ]]; then
          shift
        else
          printf 'unknown flag: %s\n' "$1" >&2
          usage
          exit 64
        fi
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        printf 'unknown flag: %s\n' "$1" >&2
        usage
        exit 64
        ;;
    esac
  done
  if [[ "${POC_ASSUME_IDLE:-}" == "1" ]]; then
    assume_idle=1
  fi
  if [[ -n "$issue_cwd" ]]; then
    export POC_ISSUE_CWD="$issue_cwd"
  fi

  local esc="$DETECT_ENGINE_ESCALATION_DIR"
  mkdir -p "$esc/processed" "$POC_STATE_DIR/issued"
  local replay=0
  local evidence=""
  if [[ "${#evidence_paths[@]}" -gt 0 ]]; then
    local ep
    for ep in "${evidence_paths[@]}"; do
      [[ -f "$ep" ]] || { printf 'issue: evidence not found: %s\n' "$ep" >&2; exit 1; }
    done
    evidence="${evidence_paths[0]}"
    case "$evidence" in
      */processed/*) replay=1 ;;
    esac
  elif [[ -n "$to_spec" && "$use_last" -eq 0 ]]; then
    printf 'issue --to requires --evidence PATH (this-poll files) or --last\n' >&2
    exit 64
  elif [[ "$use_last" -eq 1 ]]; then
    local -a processed=()
    local f
    shopt -s nullglob
    processed=("$esc/processed"/*.json)
    shopt -u nullglob
    evidence="$(newest_file "${processed[@]:-}")"
    if [[ -z "$evidence" ]]; then
      printf 'CLAIM_EMPTY: no processed evidence under %s/processed\n' "$esc"
      printf '[SILENT]\n'
      return 0
    fi
    evidence_paths=("$evidence")
    replay=1
  else
    local -a pending=()
    local f
    while IFS= read -r f; do
      [[ -n "$f" ]] && pending+=("$f")
    done < <(pending_evidence)
    evidence="$(newest_file "${pending[@]:-}")"
    if [[ -z "$evidence" ]]; then
      printf 'CLAIM_EMPTY: no pending evidence under %s\n' "$esc"
      printf '[SILENT]\n'
      return 0
    fi
    evidence_paths=("$evidence")
  fi

  local python_bin
  python_bin="$(resolve_python)"
  local typed
  typed="$("$python_bin" "$DELIVERY_HELPER" escalation-types "${evidence_paths[@]}")"
  local -a matched_paths=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && matched_paths+=("$f")
  done < <("$python_bin" -c 'import json,sys; d=json.loads(sys.argv[1]); print("\n".join(d.get("condition_matched") or []))' "$typed")
  if [[ -n "$to_spec" ]]; then
    if [[ "${#matched_paths[@]}" -eq 0 ]]; then
      to_spec=""
    else
      evidence_paths=("${matched_paths[@]}")
      evidence="${evidence_paths[0]}"
      filter_evidence_to_config "$python_bin" "${evidence_paths[@]}"
    fi
  fi

  if [[ -n "$to_spec" ]]; then
    deliver_to_grok "$to_spec" "$force_new" "$assume_idle" "$do_exec" "$replay" "${evidence_paths[@]}"
    return
  fi

  local prompt_src="$ESCALATION_PROMPT"
  [[ -f "$prompt_src" ]] || { printf 'issue: missing %s\n' "$prompt_src" >&2; exit 1; }
  local stamp dest
  stamp="$(new_stamp)"
  dest="$POC_STATE_DIR/issued/${stamp}.prompt.md"
  fill_issued_prompt "$prompt_src" "$dest" "$replay" "${evidence_paths[@]}"
  printf 'PROMPT_ISSUED: %s\n' "$dest"
  if [[ "$do_exec" -eq 1 ]]; then
    exec_issued_prompt "$dest" "$evidence" legacy
  fi
}

filter_evidence_to_config() {
  local python_bin="$1"
  shift
  local kept
  kept="$("$python_bin" - "$@" <<'PY'
import json, pathlib, re, sys
paths = sys.argv[1:]
kept = []
slug = None
for raw in paths:
    p = pathlib.Path(raw)
    try:
        data = json.loads(p.read_text(encoding="utf-8"))
    except Exception:
        continue
    name = str(data.get("config_name") or "")
    this = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:80].rstrip("-") or "unnamed"
    if slug is None:
        slug = this
    if this != slug:
        continue
    if not (p.name.startswith(slug + "_") or p.name.startswith(slug + "-")):
        continue
    kept.append(str(p))
print("\n".join(kept))
PY
)"
  evidence_paths=()
  local f
  while IFS= read -r f; do
    [[ -n "$f" ]] && evidence_paths+=("$f")
  done < <(printf '%s\n' "$kept")
  if [[ "${#evidence_paths[@]}" -eq 0 ]]; then
    printf 'issue --to: no reserved evidence matched this config_name slug\n' >&2
    exit 1
  fi
  evidence="${evidence_paths[0]}"
}

deliver_to_grok() {
  local to_spec="$1" force_new="$2" assume_idle="$3" do_exec="$4" replay="$5"
  shift 5
  local -a evidence_paths=("$@")
  local python_bin
  python_bin="$(resolve_python)"
  [[ -f "$DELIVERY_HELPER" ]] || { printf 'issue: missing %s\n' "$DELIVERY_HELPER" >&2; exit 1; }
  local parsed
  parsed="$("$python_bin" "$DELIVERY_HELPER" parse-to --to "$to_spec")" || return 64
  local host ident
  host="$("$python_bin" -c 'import json,sys; print(json.loads(sys.argv[1])["host"])' "$parsed")"
  ident="$("$python_bin" -c 'import json,sys; print(json.loads(sys.argv[1])["id"])' "$parsed")"
  local lock="$POC_STATE_DIR/locks/${host}-${ident}.lock"
  mkdir -p "$POC_STATE_DIR/locks"
  "$python_bin" "$DELIVERY_HELPER" with-lock --lock "$lock" -- \
    "$0" _locked-deliver "$to_spec" "$force_new" "$assume_idle" "$do_exec" "$replay" -- "${evidence_paths[@]}"
}

cmd_locked_deliver() {
  local to_spec="$1" force_new="$2" assume_idle="$3" do_exec="$4" replay="$5"
  shift 5
  if [[ "${1:-}" == "--" ]]; then
    shift
  fi
  local -a evidence_paths=("$@")
  local evidence="${evidence_paths[0]:-}"
  local python_bin
  python_bin="$(resolve_python)"
  local -a decide_flags=()
  [[ "$force_new" -eq 1 ]] && decide_flags+=(--force-new)
  [[ "$assume_idle" -eq 1 ]] && decide_flags+=(--assume-idle)
  [[ -n "${POC_ISSUE_CWD:-}" ]] && decide_flags+=(--cwd "$POC_ISSUE_CWD")
  local decision
  set +u
  decision="$("$python_bin" "$DELIVERY_HELPER" decide --to "$to_spec" "${decide_flags[@]}")"
  set -u
  local dec reason session_cwd ident cwd
  dec="$("$python_bin" -c 'import json,sys; print(json.loads(sys.argv[1]).get("decision",""))' "$decision")"
  reason="$("$python_bin" -c 'import json,sys; print(json.loads(sys.argv[1]).get("reason",""))' "$decision")"
  session_cwd="$("$python_bin" -c 'import json,sys; print(json.loads(sys.argv[1]).get("session_cwd") or "")' "$decision")"
  ident="$("$python_bin" -c 'import json,sys; print(json.loads(sys.argv[1]).get("id",""))' "$decision")"
  if [[ -n "${POC_ISSUE_CWD:-}" ]]; then
    cwd="$POC_ISSUE_CWD"
  elif [[ -n "$session_cwd" ]]; then
    cwd="$session_cwd"
  else
    cwd="$PWD"
  fi
  export POC_ISSUE_CWD="$cwd"

  local prompt_src="$ESCALATION_PROMPT"
  if [[ "$dec" == "resume" && -f "$EVENT_PROMPT" ]]; then
    prompt_src="$EVENT_PROMPT"
  fi
  [[ -f "$prompt_src" ]] || { printf 'issue: missing %s\n' "$prompt_src" >&2; exit 1; }
  local stamp dest
  stamp="$(new_stamp)"
  dest="$POC_STATE_DIR/issued/${stamp}-${ident}.prompt.md"
  fill_issued_prompt "$prompt_src" "$dest" "$replay" "${evidence_paths[@]}"
  printf 'PROMPT_ISSUED: %s\n' "$dest"

  if [[ "$dec" == "refuse" ]]; then
    printf 'delivery refuse: %s\n' "$reason" >&2
    printf 'replay: %s issue --exec --to %s --assume-idle --evidence %s\n' \
      "$0" "$to_spec" "$evidence" >&2
    return 1
  fi
  if [[ "$do_exec" -ne 1 ]]; then
    return 0
  fi
  local mode="new" sid="$ident"
  if [[ "$dec" == "force-new" ]]; then
    sid="$(new_uuid)"
    mode="new"
  elif [[ "$dec" == "resume" ]]; then
    mode="resume"
  else
    mode="new"
  fi
  set +e
  exec_issued_prompt "$dest" "$evidence" "$mode" "$sid"
  local rc=$?
  set -e
  if [[ "$rc" -eq 0 ]]; then
    local cfg_name host
    host="$("$python_bin" -c 'import json,sys; print(json.loads(sys.argv[1]).get("host","grok"))' "$decision")"
    cfg_name="$("$python_bin" -c 'import json,sys; print(json.load(open(sys.argv[1])).get("config_name","unknown"))' "$evidence" 2>/dev/null || echo unknown)"
    write_delivery_record "$host" "$sid" "$cwd" "$mode" "$cfg_name"
  fi
  return "$rc"
}

cmd_exec_deliver() {
  [[ $# -ge 4 ]] || { printf '_exec-deliver usage: dest evidence mode sid\n' >&2; exit 64; }
  exec_issued_prompt "$@"
}

cmd_self_check() {
  local python_bin
  python_bin="$(resolve_python)"
  printf 'prompt-on-change self-check:\n'
  printf '  SKILL_ROOT: %s\n' "$SKILL_ROOT"
  printf '  ENGINE: %s\n' "$ENGINE"
  [[ -f "$SKILL_ROOT/SKILL.md" ]] || { printf '  missing SKILL.md\n' >&2; exit 1; }
  [[ -f "$ENGINE" ]] || { printf '  engine missing\n' >&2; exit 1; }
  if ! "$python_bin" -c "import sys; sys.path.insert(0, r'''$here'''); import detect_engine" 2>/dev/null; then
    printf '  engine import failed (run bootstrap)\n' >&2
    exit 1
  fi
  printf '  engine import: ok\n'
  local example="$SKILL_ROOT/configs/examples/price-range-delta.yaml"
  [[ -f "$example" ]] || { printf '  missing example config\n' >&2; exit 1; }
  "$python_bin" "$ENGINE" --config "$example" --validate \
    || { printf '  example validate failed\n' >&2; exit 1; }
  printf '  example validate: ok\n'
}

if [[ $# -lt 1 ]]; then
  usage
  exit 64
fi

cmd="$1"
shift
case "$cmd" in
  bootstrap) cmd_bootstrap "$@" ;;
  validate) cmd_validate "$@" ;;
  run) cmd_run "$@" ;;
  explain) cmd_explain "$@" ;;
  status) cmd_status "$@" ;;
  claim) cmd_claim "$@" ;;
  issue) cmd_issue "$@" ;;
  _locked-deliver) cmd_locked_deliver "$@" ;;
  _exec-deliver) cmd_exec_deliver "$@" ;;
  self-check) cmd_self_check "$@" ;;
  -h|--help) usage; exit 0 ;;
  *)
    printf 'unknown command: %s\n' "$cmd" >&2
    usage
    exit 64
    ;;
esac
