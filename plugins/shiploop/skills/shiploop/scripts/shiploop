#!/usr/bin/env python3
"""shiploop — session harness."""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import html
import json
import os
import re
import shutil
import subprocess
import sys
import uuid
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, Iterator, List, Optional, Set, Tuple

EXIT_OK = 0
EXIT_BLOCKED = 2
EXIT_USAGE = 64

PACKAGE_ROOT = Path(__file__).resolve().parents[1]
VERSION = "0.8.6"
REF_DIR = PACKAGE_ROOT / "references"
WT_DIRNAME = ".worktrees"
# Printed in ## Progress and the implement Next envelope. Do not splice into
# stored implement prompts. Same wording lives in SKILL.md + turn-packet.md.
HOST_WORKTREE_FLAG = (
    "HOST FLAG — extra folder (do not re-root):",
    "ShipLoop creates another folder: a per-step worktree under "
    "<repo>/.worktrees/shiploop/<run_id>/<id> on branch shiploop/<run_id>/<id>.",
    "Implementation work happens IN that worktree, not in the session checkout.",
    "Do not move_agent_to_root / re-root the host chat into that folder or the "
    "product repo unless the user asked.",
    "The session checkout stays the merge dest; do not edit it during implement.",
    "After /shiploop complete, the host merges the kept branch into session HEAD; "
    "the next packet names the next worktree.",
)
TRANSITIONS_PATH = REF_DIR / "transitions.json"
ACTIVITIES_DIR = REF_DIR / "activities"

PHASES = (
    "intake",
    "validate-spec",
    "plan",
    "implement",
    "residual",
    "done",
    "halted",
    "blocked",
)
MAP_PHASES = (
    "intake",
    "validate-spec",
    "plan",
    "implement",
    "residual",
    "done",
)
RESUME_PHASES = ("validate-spec", "plan", "implement", "residual")
STEP_ID_RE = re.compile(r"^[SD][0-9]+$")
CONTROL_RE = re.compile(r"[\x00-\x08\x0a-\x1f\x7f]")
# Prompts may carry newlines (multi-line inner-loop text); every other
# control character is still refused. Foreign slash skills are refused
# without naming them in this file.
PROMPT_CONTROL_RE = re.compile(r"[\x00-\x09\x0b-\x1f\x7f]")
_FOREIGN_SLASH = "/" + "dev" + "loop"
HANDLE_RESOLVE = ("list", "inspect", "ask", "create")

STATUS_RE = re.compile(
    r"(?im)\bStatus\b[^\n]*(?P<state>stopped\s*\([^\n)]*\)|complete\b|active\b)"
)
PLAN_CONTRACT_RE = re.compile(
    r"(?im)^\*\*Plan contract:\*\*\s*`?(?P<path>[^`\n]+?)`?\s*$"
)
PLAN_HASH_RE = re.compile(
    r"(?im)^\*\*Plan hash:\*\*\s*`?(?P<hash>[0-9a-fA-F]{64})`?"
)
COMMITTED_YES_RE = re.compile(r"(?im)^\*\*Committed:\*\*\s*yes\b")
COMMITTED_NO_RE = re.compile(r"(?im)^\*\*Committed:\*\*\s*no\b")
ROUND_HEAD_RE = re.compile(r"(?im)^###\s+Round\s+(?P<n>\d+)\b")
WAIVER_RE = re.compile(
    r"(?im)^[ \t]*None\s*[—–-]\s*residual\s+loop\s+waived\s*:\s*(?P<reason>\S.+?)\s*$"
)
PLACEHOLDER_RE = re.compile(
    r"(?i)^(tbd|todo|\.\.\.|…|from plan|list concrete|<[^>]+>)$"
)
H2_RE = re.compile(r"(?m)^##\s+(.+?)\s*$")
FENCE_RE = re.compile(r"^[ \t]{0,3}(```|~~~)")

HOST_SKILL_HOMES = (
    Path.home() / ".cursor" / "skills",
    Path.home() / ".claude" / "skills",
    Path.home() / ".grok" / "skills",
    Path.home() / ".codex" / "skills",
)


def die(code: int, msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def spec_sha256_of(run_dir: Path) -> str:
    return sha256_file(run_dir / "spec.md")


def environment_sha256_of(run_dir: Path) -> str:
    return sha256_file(run_dir / "environment.md")


def legacy_spec_pair_sha256(run_dir: Path) -> str:
    """Pre-0.7 hash: sha256(spec.md + \\0 + spec.json). Grandfather-only."""
    md = (run_dir / "spec.md").read_bytes()
    js = (run_dir / "spec.json").read_bytes()
    return sha256_bytes(md + b"\0" + js)


def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        die(EXIT_BLOCKED, f"cannot parse JSON: {path}: {exc}")


def write_json_atomic(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def refuse_package_path(path: Path) -> None:
    try:
        path.resolve().relative_to(PACKAGE_ROOT)
    except ValueError:
        return
    die(EXIT_BLOCKED, f"refusing path inside skill package: {path}")


def inside_run_dir(run_dir: Path, path: Path) -> None:
    try:
        path.resolve().relative_to(run_dir.resolve())
    except ValueError:
        die(EXIT_BLOCKED, f"path escapes run-dir: {path}")


def load_transitions() -> Dict[str, Any]:
    data = load_json(TRANSITIONS_PATH)
    if not isinstance(data, dict) or "edges" not in data:
        die(EXIT_BLOCKED, "transitions.json missing edges")
    return data


def legal_edge(src: str, dest: str) -> Optional[str]:
    for edge in load_transitions()["edges"]:
        if edge.get("from") == src and edge.get("to") == dest:
            return str(edge.get("need") or "")
    return None


def skill_dir_ok(root: Path) -> bool:
    return (root / "SKILL.md").is_file()


def has_disallowed_slash(text: str) -> bool:
    return _FOREIGN_SLASH in text


def find_skill(name: str) -> Optional[Path]:
    env_key = {
        "review-coverage": "SHIPLOOP_REVIEW_COVERAGE_ROOT",
        "shiploop": "SHIPLOOP_ROOT",
        "backchain": "SHIPLOOP_BACKCHAIN_ROOT",
    }.get(name, "")
    if env_key:
        raw = os.environ.get(env_key, "").strip()
        if raw:
            p = Path(raw).expanduser()
            if skill_dir_ok(p):
                return p.resolve()
    sibling = PACKAGE_ROOT.parent / name
    if sibling.is_dir() and skill_dir_ok(sibling) and name != "shiploop":
        return sibling.resolve()
    if name == "shiploop" and skill_dir_ok(PACKAGE_ROOT):
        return PACKAGE_ROOT
    for home in HOST_SKILL_HOMES:
        cand = home / name
        if skill_dir_ok(cand):
            return cand.resolve()
    return None


def resolve_dep_roots() -> Dict[str, Optional[str]]:
    return {
        "shiploop": str(PACKAGE_ROOT),
        "review-coverage": str(p) if (p := find_skill("review-coverage")) else None,
        "backchain": str(p) if (p := find_skill("backchain")) else None,
    }


def default_state(
    run_dir: Path,
    *,
    prompt: str,
    implementer: str,
    bound_plan: str,
    repo: str,
) -> Dict[str, Any]:
    bound_hash = ""
    if bound_plan:
        bp = Path(bound_plan)
        if bp.is_file():
            bound_hash = sha256_file(bp)
    return {
        "version": 2,
        "phase": "intake",
        "run_id": f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{uuid.uuid4().hex[:8]}",
        "attempt": 1,
        "prompt": prompt,
        "implementer": implementer,
        "bound_plan": bound_plan,
        "bound_plan_hash": bound_hash,
        "environment_sha256": "",
        "spec_sha256": "",
        "plan_sha256": "",
        "repo_root": repo,
        "dep_roots": resolve_dep_roots(),
        "artifacts": {
            "prompt": str(run_dir / "prompt.md"),
            "environment_md": str(run_dir / "environment.md"),
            "spec_md": str(run_dir / "spec.md"),
            "plan_md": str(run_dir / "plan.md"),
            "backchain": str(run_dir / "backchain" / "plan.json"),
            "recap_html": str(run_dir / "recap.html"),
        },
        "blocked_reason": None,
        "blocked_from": None,
        "resume_to": None,
        "ask_user": None,
        "terminal": None,
    }


def run_dir_from_arg(raw: Optional[str], *, walk: bool) -> Path:
    if raw:
        p = Path(raw).expanduser()
        if p.name != ".shiploop" and (p / ".shiploop").is_dir() and (p / ".shiploop" / "state.json").is_file():
            p = p / ".shiploop"
        return p
    if not walk:
        return Path.cwd() / ".shiploop"
    cur = Path.cwd().resolve()
    for parent in [cur, *cur.parents]:
        cand = parent / ".shiploop"
        if (cand / "state.json").is_file():
            return cand
    return Path.cwd() / ".shiploop"


def load_state(run_dir: Path) -> Dict[str, Any]:
    refuse_package_path(run_dir)
    state_path = run_dir / "state.json"
    if not state_path.is_file():
        die(EXIT_BLOCKED, f"no state.json in {run_dir}")
    if state_path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {state_path}")
    data = load_json(state_path)
    if not isinstance(data, dict):
        die(EXIT_BLOCKED, "state.json is not an object")
    return data


@contextmanager
def run_lock(run_dir: Path) -> Iterator[None]:
    refuse_package_path(run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)
    lock = run_dir / ".lock"
    fd = os.open(str(lock), os.O_CREAT | os.O_RDWR)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def save_state(run_dir: Path, state: Dict[str, Any], *, event: str) -> None:
    refuse_package_path(run_dir)
    write_json_atomic(run_dir / "state.json", state)
    hist = run_dir / "history.jsonl"
    rec = {"ts": now_iso(), "event": event, "phase": state.get("phase")}
    with hist.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(rec, sort_keys=True) + "\n")


def read_text(path: Path) -> Optional[str]:
    if not path.is_file():
        return None
    if path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {path}")
    return path.read_text(encoding="utf-8")


def scan_labels(text: str, labels: Tuple[str, ...]) -> Dict[str, List[str]]:
    """Line-start labeled values, outside fences and blockquotes."""
    out: Dict[str, List[str]] = {l: [] for l in labels}
    in_fence = False
    for line in text.splitlines():
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        if line.lstrip().startswith(">"):
            continue
        for l in labels:
            m = re.match(rf"(?i)^{re.escape(l)}\s*:\s*(.*)$", line)
            if m:
                out[l].append(m.group(1).strip())
                break
    return out


def load_spec(run_dir: Path) -> Tuple[Optional[Dict[str, Any]], List[str]]:
    """spec.md is the sole SoT: labeled done_sentence: / checkable: (each once)."""
    md_path = run_dir / "spec.md"
    if not md_path.is_file():
        return None, [f"missing {md_path}"]
    text = read_text(md_path) or ""
    if not text.strip():
        return None, ["spec.md is empty"]
    labels = scan_labels(text, ("done_sentence", "checkable", "ask_user", "verify_hint"))
    gaps: List[str] = []
    for req in ("done_sentence", "checkable"):
        if len(labels[req]) == 0:
            gaps.append(f"spec.md missing labeled {req}:")
        elif len(labels[req]) > 1:
            gaps.append(f"spec.md labeled {req}: must appear exactly once")
    for opt in ("ask_user", "verify_hint"):
        if len(labels[opt]) > 1:
            gaps.append(f"spec.md labeled {opt}: must appear at most once")
    if gaps:
        return None, gaps
    ds = labels["done_sentence"][0]
    if not ds:
        return None, ["spec.md done_sentence is empty"]
    chk_raw = labels["checkable"][0].strip().lower()
    if chk_raw not in ("true", "false"):
        return None, ["spec.md checkable must be true or false"]
    checkable = chk_raw == "true"
    ask_user = labels["ask_user"][0] if labels["ask_user"] else None
    verify_hint = labels["verify_hint"][0] if labels["verify_hint"] else None
    if not checkable and not (isinstance(ask_user, str) and ask_user.strip()):
        return None, ["ask_user required when checkable is false"]
    return {
        "done_sentence": ds,
        "checkable": checkable,
        "ask_user": ask_user,
        "verify_hint": verify_hint,
    }, []


def validate_machine(m: Dict[str, Any]) -> List[str]:
    gaps: List[str] = []
    kind = m.get("kind")
    if kind not in ("greenfield", "brownfield"):
        gaps.append("machine.kind must be greenfield or brownfield")
    augment = m.get("augment")
    if not isinstance(augment, bool):
        gaps.append("machine.augment must be a bool")
    elif kind == "greenfield" and augment is not False:
        gaps.append("machine.augment must be false when kind is greenfield")
    elif kind == "brownfield" and augment is not True:
        gaps.append("machine.augment must be true when kind is brownfield")
    refs = m.get("references")
    if not isinstance(refs, list):
        gaps.append("machine.references must be a list")
    else:
        if kind == "brownfield" and not refs:
            gaps.append("machine.references must be nonempty when kind is brownfield")
        for i, r in enumerate(refs):
            ok = (
                isinstance(r, dict)
                and isinstance(r.get("path"), str)
                and r["path"].strip()
                and isinstance(r.get("why"), str)
                and r["why"].strip()
            )
            if not ok:
                gaps.append(f"machine.references[{i}] must be {{path, why}} nonempty strings")
    for key in ("tools", "mcp"):
        arr = m.get(key)
        if not isinstance(arr, list):
            gaps.append(f"machine.{key} must be a list")
        else:
            for i, v in enumerate(arr):
                if not isinstance(v, str) or not v.strip():
                    gaps.append(f"machine.{key}[{i}] must be a nonempty string")
    mc = m.get("mcp_considered")
    if not isinstance(mc, str) or not re.match(r"^\S+\(.*\)$", mc.strip()):
        gaps.append("machine.mcp_considered must be 'server(tool)' or 'none(reason)'")
    handles = m.get("handles")
    create_count = 0
    if not isinstance(handles, list):
        gaps.append("machine.handles must be a list")
        handles = []
    for i, h in enumerate(handles):
        if not isinstance(h, dict):
            gaps.append(f"machine.handles[{i}] must be an object")
            continue
        source = h.get("source")
        need = h.get("need")
        resolve = h.get("resolve")
        value = h.get("value")
        if not isinstance(source, str) or not source.strip():
            gaps.append(f"machine.handles[{i}].source must be nonempty")
        if not isinstance(need, str) or not need.strip():
            gaps.append(f"machine.handles[{i}].need must be nonempty")
        if resolve not in HANDLE_RESOLVE:
            gaps.append(f"machine.handles[{i}].resolve must be list|inspect|ask|create")
        if not isinstance(value, str):
            gaps.append(f"machine.handles[{i}].value must be a string")
            value = ""
        if resolve == "create":
            create_count += 1
        if resolve == "inspect" and need != "credential":
            if not value.strip():
                gaps.append(f"machine.handles[{i}].value required (inspect, non-credential)")
        elif resolve in ("ask", "list", "create") and value.strip():
            gaps.append(f"machine.handles[{i}].value must be empty for resolve={resolve}")
        elif resolve == "inspect" and need == "credential" and value.strip():
            gaps.append(f"machine.handles[{i}].value must be empty for a credential")
    initiation = m.get("initiation")
    if initiation not in ("none", "needed", "done"):
        gaps.append("machine.initiation must be none|needed|done")
    else:
        if initiation == "needed" and create_count < 1:
            gaps.append("machine.initiation needed requires >=1 handle with resolve=create")
        if initiation in ("none", "done") and create_count > 0:
            gaps.append("machine.initiation none/done forbids resolve=create handles")
    ui = m.get("ui")
    if not isinstance(ui, bool):
        gaps.append("machine.ui must be a bool")
    ui_craft = m.get("ui_craft")
    if not isinstance(ui_craft, str) or not ui_craft.strip():
        gaps.append("machine.ui_craft must be a nonempty string")
    elif isinstance(ui, bool):
        is_none = bool(re.match(r"(?i)^none\(.*\)$", ui_craft.strip()))
        if ui and is_none:
            gaps.append("machine.ui_craft must not be none(...) when ui is true")
        if not ui and not is_none:
            gaps.append("machine.ui_craft must be none(...) when ui is false")
    return gaps


def handles_block_plan(machine: Dict[str, Any]) -> List[str]:
    gaps: List[str] = []
    for h in machine.get("handles") or []:
        if isinstance(h, dict) and h.get("resolve") in ("list", "ask"):
            gaps.append(f"handle {h.get('source')} resolve={h.get('resolve')} blocks dest plan")
    return gaps


def load_environment(run_dir: Path) -> Tuple[Optional[Dict[str, Any]], List[str]]:
    """environment.md: prose brief, then one '## machine' H2 with a fenced JSON object."""
    path = run_dir / "environment.md"
    if not path.is_file():
        return None, [f"missing {path}"]
    text = read_text(path) or ""
    if not text.strip():
        return None, ["environment.md is empty"]
    lines = text.splitlines()
    heading_idxs: List[int] = []
    in_fence = False
    for i, line in enumerate(lines):
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = re.match(r"^[ \t]{0,3}(#{1,6})\s+(.*)$", line)
        if m and len(m.group(1)) == 2 and m.group(2).strip().lower() == "machine":
            heading_idxs.append(i)
    if not heading_idxs:
        return None, ["environment.md missing a '## machine' section"]
    if len(heading_idxs) > 1:
        return None, ["environment.md must have exactly one '## machine' section"]
    h = heading_idxs[0]
    brief = "\n".join(lines[:h]).strip()
    if not brief:
        return None, ["environment.md brief (before '## machine') is empty"]
    j = h + 1
    while j < len(lines) and not lines[j].strip():
        j += 1
    if j >= len(lines) or not FENCE_RE.match(lines[j]):
        return None, ["environment.md '## machine' must be followed by a fenced JSON block"]
    fence_marker = lines[j].strip()[:3]
    k = j + 1
    body: List[str] = []
    closed = False
    while k < len(lines):
        if lines[k].strip().startswith(fence_marker):
            closed = True
            break
        body.append(lines[k])
        k += 1
    if not closed:
        return None, ["environment.md machine fence is not closed"]
    try:
        machine = json.loads("\n".join(body))
    except Exception as exc:
        return None, [f"environment.md machine fence is not valid JSON: {exc}"]
    if not isinstance(machine, dict):
        return None, ["environment.md machine fence must be a JSON object"]
    gaps = validate_machine(machine)
    if gaps:
        return None, gaps
    return machine, []


def bind_or_verify_hash(state: Dict[str, Any], key: str, current: str) -> None:
    stored = str(state.get(key) or "")
    if not stored:
        state[key] = current
        return
    if stored != current:
        die(EXIT_BLOCKED, f"{key} drift; rebind via blocked -> validate-spec")


def canonical_backchain(run_dir: Path) -> Path:
    return run_dir / "backchain" / "plan.json"


def wrapper_pair(run_dir: Path, spec: Optional[Dict[str, Any]]) -> List[str]:
    """plan.md labeled done_sentence must equal spec.md at dest implement.

    Same scan_labels rules as spec.md (line-start, outside fences/blockquotes).
    plan.json is not SoT. plan.md is not hashed; this check does not re-run
    on next after dest implement.
    """
    md_path = run_dir / "plan.md"
    if not md_path.is_file():
        return [f"missing {md_path}"]
    md = read_text(md_path) or ""
    if not md.strip():
        return ["plan.md empty"]
    labels = scan_labels(md, ("done_sentence",))
    spec_ds = (spec or {}).get("done_sentence")
    found = labels["done_sentence"]
    if len(found) == 0 or not found[0]:
        return ["plan.md labeled done_sentence missing"]
    if len(found) > 1:
        return ["plan.md labeled done_sentence must appear exactly once"]
    if spec_ds is not None and found[0] != spec_ds:
        return ["plan.md labeled done_sentence must equal spec.md"]
    return []


def _section_h2(text: str, title: str) -> Optional[str]:
    lines = text.splitlines()
    start = None
    in_fence = False
    for i, line in enumerate(lines):
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = re.match(r"^[ \t]{0,3}(#{1,6})\s+(.*)$", line)
        if not m:
            continue
        if start is None:
            if len(m.group(1)) == 2 and re.search(rf"(?i)^{re.escape(title)}\b", m.group(2).strip()):
                start = i + 1
            continue
        if len(m.group(1)) <= 2:
            return "\n".join(lines[start:i])
    if start is not None:
        return "\n".join(lines[start:])
    return None


def plan_waiver(state: Dict[str, Any]) -> Optional[str]:
    bound_plan = str(state.get("bound_plan") or "")
    if not bound_plan:
        return None
    path = Path(bound_plan)
    if not path.is_file():
        return None
    bound_hash = str(state.get("bound_plan_hash") or "")
    if bound_hash and sha256_file(path) != bound_hash:
        return None
    text = path.read_text(encoding="utf-8")
    body = _section_h2(text, "Review Coverage")
    if body is None:
        return None
    scan_lines = []
    in_fence = False
    for line in body.splitlines():
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if not in_fence:
            scan_lines.append(line)
    scan = "\n".join(scan_lines)
    m = WAIVER_RE.search(scan)
    if not m:
        return None
    reason = (m.group("reason") or "").strip()
    if not reason or PLACEHOLDER_RE.fullmatch(reason) or re.fullmatch(r"<[^<>]+>", reason):
        return None
    return reason


def residual_coverage_candidates(state: Dict[str, Any], run_dir: Path) -> List[Path]:
    """Plans that already have ## Review Coverage (read-only; no state writes)."""
    found: List[Path] = []
    candidates = [run_dir / "plan.md"]
    repo = repo_of(state)
    if repo:
        candidates.append(Path(repo) / "PLAN.md")
    seen: Set[str] = set()
    for path in candidates:
        try:
            resolved = path.resolve()
        except OSError:
            continue
        key = str(resolved)
        if key in seen or not resolved.is_file():
            continue
        seen.add(key)
        try:
            text = resolved.read_text(encoding="utf-8")
        except OSError:
            continue
        if _section_h2(text, "Review Coverage") is None:
            continue
        found.append(resolved)
    return found


def residual_plan_bindable(state: Dict[str, Any], run_dir: Path) -> bool:
    if str(state.get("bound_plan") or "").strip():
        return True
    return bool(residual_coverage_candidates(state, run_dir))


def maybe_bind_residual_plan(state: Dict[str, Any], run_dir: Path) -> Optional[Path]:
    """Bind empty bound_plan to a local plan that already has Review Coverage."""
    if str(state.get("bound_plan") or "").strip():
        return None
    found = residual_coverage_candidates(state, run_dir)
    if not found:
        return None
    resolved = found[0]
    state["bound_plan"] = str(resolved)
    state["bound_plan_hash"] = sha256_file(resolved)
    return resolved


def latest_round_body(text: str) -> Tuple[str, Optional[str]]:
    matches = list(ROUND_HEAD_RE.finditer(text))
    if not matches:
        return "", None
    last = matches[-1]
    start = last.start()
    nxt = matches[-1].end()
    end = len(text)
    for m in matches:
        if m.start() > start:
            end = m.start()
            break
    return text[start:end], last.group("n")


def ledger_report(repo_root: Path, state: Dict[str, Any]) -> Dict[str, Any]:
    ledger = repo_root / "REVIEW_CONVERGE.md"
    out: Dict[str, Any] = {
        "present": ledger.is_file(),
        "status": None,
        "bound": False,
        "landed": False,
        "foreign": False,
        "path": str(ledger),
    }
    if not ledger.is_file():
        return out
    text = ledger.read_text(encoding="utf-8")
    sm = STATUS_RE.search(text)
    if sm:
        out["status"] = sm.group("state")
    cm = PLAN_CONTRACT_RE.search(text)
    hm = PLAN_HASH_RE.search(text)
    contract = (cm.group("path").strip() if cm else "")
    phash = (hm.group("hash").strip().lower() if hm else "")
    bound_plan = str(state.get("bound_plan") or "")
    bound_hash = str(state.get("bound_plan_hash") or "").lower()
    if bound_plan and contract:
        try:
            same_path = Path(contract).resolve() == Path(bound_plan).resolve()
        except OSError:
            same_path = os.path.normpath(contract) == os.path.normpath(bound_plan)
        same_hash = (not bound_hash) or (phash == bound_hash)
        out["bound"] = bool(same_path and same_hash)
        out["foreign"] = not same_path or (bound_hash and phash and phash != bound_hash)
    elif bound_plan:
        out["foreign"] = True
    round_body, n = latest_round_body(text)
    last_c = None
    for line in round_body.splitlines():
        if re.search(r"(?i)^\*\*Committed:\*\*", line):
            last_c = line
    committed_yes = bool(last_c and re.search(r"(?i)yes\b", last_c) and not re.search(r"(?i)no\b", last_c))
    subj = False
    if n is not None:
        subj = bool(
            re.search(
                rf"(?im)(?:review-converge|grok-review-converge):\s*round\s+{re.escape(n)}\s*—",
                round_body,
            )
        )
    out["landed"] = bool(committed_yes and subj)
    return out


def residual_gaps(state: Dict[str, Any], dest: str) -> List[str]:
    waiver = plan_waiver(state)
    repo = Path(str(state.get("repo_root") or "")).expanduser()
    if dest == "done" and waiver:
        return []
    if not repo.is_dir():
        return ["repo_root is not a directory"]
    rep = ledger_report(repo, state)
    if not rep["present"]:
        return [f"missing ledger {rep['path']}"]
    if rep["foreign"] or not rep["bound"]:
        return ["foreign or unbound REVIEW_CONVERGE.md"]
    status = rep["status"] or ""
    if dest == "done":
        if status != "complete":
            return [f"ledger status {status!r} is not complete"]
        if not rep["landed"]:
            return ["ledger complete but not landed"]
        return []
    if dest == "halted":
        if not str(status).startswith("stopped"):
            return [f"ledger status {status!r} is not stopped"]
        return []
    return ["residual not terminal"]


def recap_gaps(run_dir: Path) -> List[str]:
    path = run_dir / "recap.html"
    if not path.is_file():
        return ["missing recap.html"]
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return [f"cannot read recap.html: {exc}"]
    if not text.strip():
        return ["recap.html is empty"]
    low = text.lower()
    if "<html" not in low and "<!doctype html" not in low:
        return ["recap.html is not HTML"]
    needed = (
        "intent",
        "accomplish",
        "changed",
        "outcome",
        "verif",
        "original spec",
        "end result",
    )
    missing = [word for word in needed if word not in low]
    if missing:
        return [f"recap.html missing briefing: {', '.join(missing)}"]
    return []


def _html_text(value: Any) -> str:
    return html.escape(diag_text(value))


def _html_pre(text: str) -> str:
    raw = (text or "").rstrip()
    if not raw:
        return '<p class="empty">(not written)</p>'
    return f"<pre>{html.escape(raw)}</pre>"


def _environment_brief(run_dir: Path) -> str:
    text = read_text(run_dir / "environment.md") or ""
    if "## machine" in text:
        text = text.split("## machine", 1)[0]
    return text.strip()


RECAP_QUALITY_HOST_OWNED = (
    "Quality /goal and outer-loop publish are host-owned. "
    "This recap does not witness them and does not treat the frozen "
    "done_sentence as harness-verified."
)


def _recap_coverage_line(waiver: Optional[str], ledger: Dict[str, Any], dest: str) -> str:
    if dest == "halted":
        return "review-coverage stopped before a landed complete"
    if waiver:
        return f"review-coverage waived: {waiver}"
    status = diag_text(ledger.get("status")) if ledger else "(none)"
    landed = bool(ledger.get("landed"))
    bound = bool(ledger.get("bound"))
    if status == "complete" and landed and bound:
        return "review-coverage complete and landed"
    return (
        f"review-coverage ledger {status}; "
        f"bound={'yes' if bound else 'no'}; "
        f"landed={'yes' if landed else 'no'}"
    )


def _history_events(run_dir: Path) -> List[str]:
    path = run_dir / "history.jsonl"
    if not path.is_file():
        return []
    rows: List[str] = []
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    for line in lines[-24:]:
        if not line.strip():
            continue
        try:
            rec = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(rec, dict):
            continue
        event = diag_text(rec.get("event"))
        ts = diag_text(rec.get("ts"))
        phase = diag_text(rec.get("phase"))
        rows.append(f"{ts}  {event}  ({phase})")
    return rows


def _step_suppliers(step: Dict[str, Any]) -> List[str]:
    out: List[str] = []
    for inp in step.get("inputs") or []:
        if isinstance(inp, dict) and inp.get("from") is not None:
            out.append(str(inp["from"]))
    return out


def _walk_layers(ids: List[str], by_id: Dict[str, Dict[str, Any]]) -> List[List[str]]:
    known = set(ids)
    remaining = set(ids)
    placed: Set[str] = set()
    layers: List[List[str]] = []
    while remaining:
        ready = [
            sid
            for sid in ids
            if sid in remaining
            and all(dep in placed for dep in _step_suppliers(by_id.get(sid) or {}) if dep in known)
        ]
        if not ready:
            layers.append([sid for sid in ids if sid in remaining])
            break
        layers.append(ready)
        for sid in ready:
            remaining.discard(sid)
            placed.add(sid)
    return layers


def _recap_chip(text: str, *, kind: str = "chip") -> str:
    return f'<span class="{kind}">{_html_text(text)}</span>'


def _recap_river_html(
    ids: List[str],
    by_id: Dict[str, Dict[str, Any]],
    classes: Dict[str, str],
    initial_state: List[str],
    done_sentence: str,
) -> str:
    if not ids and not initial_state and not done_sentence:
        return '<p class="empty">(no sequence plan)</p>'
    parts: List[str] = ['<div class="river" role="img" aria-label="Implementation outcomes">']
    sources = [diag_text(item) for item in initial_state if diag_text(item) != "(none)"]
    if sources:
        parts.append('<div class="layer sources">')
        parts.append('<p class="layer-label">Started from</p>')
        parts.append('<div class="row">')
        parts.extend(_recap_chip(item, kind="chip source") for item in sources)
        parts.append("</div></div>")
        parts.append('<div class="flow-arrow" aria-hidden="true"></div>')
    for layer in _walk_layers(ids, by_id):
        parts.append('<div class="layer">')
        parts.append('<p class="layer-label">Made true</p>')
        parts.append('<div class="row">')
        for sid in layer:
            step = by_id.get(sid) or {}
            klass = classes.get(sid, "todo")
            stmt = diag_text(step.get("statement"))
            texts = produces_texts(step.get("produces")) or []
            produces = "".join(_recap_chip(t, kind="chip out") for t in texts) or (
                '<span class="chip out">—</span>'
            )
            parts.append(
                f'<article class="node {html.escape(klass)}">'
                f'<span class="nid">{_html_text(sid)}</span>'
                f"<h3>{_html_text(stmt)}</h3>"
                f'<p class="made">Implementation outcome</p>'
                f'<div class="outs">{produces}</div>'
                "</article>"
            )
        parts.append("</div></div>")
        parts.append('<div class="flow-arrow" aria-hidden="true"></div>')
    if done_sentence:
        parts.append('<div class="layer sink">')
        parts.append('<p class="layer-label">Contracted end result</p>')
        parts.append(f'<p class="sink-line">{_html_text(done_sentence)}</p>')
        parts.append("</div>")
    elif parts and parts[-1] == '<div class="flow-arrow" aria-hidden="true"></div>':
        parts.pop()
    parts.append("</div>")
    return "".join(parts)


def _recap_accomplishment_cards(
    ids: List[str],
    by_id: Dict[str, Dict[str, Any]],
    classes: Dict[str, str],
) -> str:
    cards: List[str] = []
    for sid in ids:
        step = by_id.get(sid) or {}
        klass = classes.get(sid, "todo")
        stmt = diag_text(step.get("statement"))
        texts = produces_texts(step.get("produces")) or []
        produces = "; ".join(diag_text(t) for t in texts) if texts else "—"
        mark = "landed" if klass == "done" else klass
        cards.append(
            "<li>"
            f'<span class="nid">{_html_text(sid)}</span>'
            f"<strong>{_html_text(stmt)}</strong>"
            f'<span class="made">Made true: {_html_text(produces)}</span>'
            f'<span class="mark">{_html_text(mark)}</span>'
            "</li>"
        )
    if not cards:
        return '<p class="empty">(no sequence plan)</p>'
    return '<ol class="accomplishments">' + "".join(cards) + "</ol>"


def render_recap_html(run_dir: Path, state: Dict[str, Any], *, dest: str) -> str:
    spec, _ = load_spec(run_dir)
    prompt = (read_text(run_dir / "prompt.md") or str(state.get("prompt") or "")).strip()
    spec_md = (read_text(run_dir / "spec.md") or "").strip()
    plan_md = (read_text(run_dir / "plan.md") or "").strip()
    env_brief = _environment_brief(run_dir)
    done_sentence = (spec or {}).get("done_sentence") if spec else ""
    checkable = (spec or {}).get("checkable") if spec else None
    waiver = plan_waiver(state)
    repo = repo_of(state)
    ledger = ledger_report(repo, state) if repo.exists() else {}
    ids = recomputed_step_ids(run_dir)
    by_id = steps_by_id(run_dir)
    classes = classify_steps(run_dir, state) if ids else {}
    n_done = sum(1 for sid in ids if classes.get(sid) == "done")
    drained = bool(ids) and n_done == len(ids)
    if dest == "halted":
        stamp = "HALTED"
        outcome = (
            "Session halted. Residual stopped before a landed complete. "
            + RECAP_QUALITY_HOST_OWNED
        )
    elif waiver:
        stamp = "CLOSED"
        outcome = (
            f"Session closed. Review-coverage was waived: {waiver} "
            + RECAP_QUALITY_HOST_OWNED
        )
    else:
        stamp = "CLOSED"
        outcome = (
            "Session closed. Review-coverage is complete and landed. "
            + RECAP_QUALITY_HOST_OWNED
        )
    if dest == "halted":
        rail = (
            "● intake  ● validate-spec  ● plan  ● implement  ● residual  ○ done  ✗ halted"
        )
    else:
        rail = "● intake  ● validate-spec  ● plan  ● implement  ● residual  ▶ done"
    dag = load_dag(run_dir) or {}
    initial_state = [
        str(item).strip()
        for item in (dag.get("initial_state") or [])
        if isinstance(item, str) and item.strip()
    ]
    river_html = _recap_river_html(ids, by_id, classes, initial_state, str(done_sentence or ""))
    accomplishments_html = _recap_accomplishment_cards(ids, by_id, classes)
    hist = _history_events(run_dir)
    if hist:
        hist_html = "<ol class=\"log\">" + "".join(
            f"<li><code>{_html_text(row)}</code></li>" for row in hist
        ) + "</ol>"
    else:
        hist_html = "<p class=\"empty\">(no history.jsonl)</p>"
    ledger_status = diag_text(ledger.get("status")) if ledger else "(none)"
    landed = "yes" if ledger.get("landed") else "no"
    bound = "yes" if ledger.get("bound") else "no"
    coverage = _recap_coverage_line(waiver, ledger, dest)
    end_result = done_sentence or "(no frozen done_sentence)"
    if dest == "halted":
        end_bits = (
            f"The walk ended in residual without a landed complete. "
            f"The frozen done_sentence stays the contracted end result, "
            f"not a harness-verified claim."
        )
    elif drained:
        end_bits = (
            f"All {len(ids)} sequence steps completed. "
            f"The frozen done_sentence is the contracted end result, "
            f"not a harness-verified claim."
        )
    else:
        end_bits = (
            f"{n_done}/{len(ids) or 0} sequence steps completed. "
            f"The frozen done_sentence is still the contracted end result, "
            f"not a harness-verified claim."
        )
    checkable_s = "true" if checkable is True else "false" if checkable is False else "(unset)"
    run_id = diag_text(state.get("run_id"))
    repo_s = diag_text(str(repo.resolve()) if repo.exists() else repo)
    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ShipLoop recap — { _html_text(stamp) }</title>
<style>
:root {{
  --stock: #c9dbe4;
  --ink: #16202b;
  --rule: #5d7d8c;
  --stamp: #b42318;
  --closed: #245c4a;
  --paper: #f4f8fa;
  --muted: #4d6270;
  --node: #e8f1f5;
  --node-done: #d7ebe3;
}}
html, body {{ margin: 0; padding: 0; background: var(--stock); color: var(--ink); }}
body {{
  font-family: "IBM Plex Sans", "Avenir Next Condensed", "Arial Narrow", sans-serif;
  line-height: 1.45;
}}
.jacket {{
  max-width: 58rem;
  margin: 1.5rem auto 3rem;
  background: var(--paper);
  border: 1px solid var(--rule);
  box-shadow: 6px 8px 0 rgba(22, 32, 43, 0.08);
  position: relative;
  padding: 1.25rem 1.5rem 2rem;
}}
.routing {{
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem 0.7rem;
  border-bottom: 2px dashed var(--rule);
  padding: 0 0 0.85rem;
  margin: 0 0 1.1rem;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.02em;
}}
.stamp {{
  position: absolute;
  top: 1.1rem;
  right: 1.2rem;
  border: 4px solid var(--stamp);
  color: var(--stamp);
  font-weight: 800;
  letter-spacing: 0.18em;
  padding: 0.2rem 0.55rem;
  transform: rotate(-8deg);
  background: rgba(244, 248, 250, 0.92);
}}
.stamp.closed, .stamp.waived {{ border-color: var(--closed); color: var(--closed); }}
h1 {{
  font-family: "Iowan Old Style", Palatino, "Palatino Linotype", serif;
  font-size: 1.8rem;
  margin: 0.2rem 0 0.35rem;
}}
.meta, .empty, caption, th, .layer-label, .made, .mark {{ color: var(--muted); }}
.meta {{ margin: 0 0 1rem; font-size: 0.92rem; }}
h2 {{
  font-size: 0.82rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  border-top: 1px solid var(--rule);
  padding-top: 0.85rem;
  margin: 1.4rem 0 0.55rem;
}}
.reveal h2:first-child {{ border-top: 0; padding-top: 0; }}
