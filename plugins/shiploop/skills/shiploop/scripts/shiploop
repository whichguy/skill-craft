<p class="done-sentence">{_html_text(done_sentence or "(no done_sentence)")}</p>
<p>checkable={_html_text(checkable_s)}. Frozen spec.md is the contracted original spec.</p>
{_html_pre(spec_md)}

<h2>Survey brief</h2>
{_html_pre(env_brief)}

<h2>Sequence plan</h2>
{_html_pre(plan_md)}

<h2>Materially changed</h2>
<p>Harness events that moved the session (file order, last 24).</p>
{hist_html}

<h2>Verified</h2>
<p>{_html_text(coverage)}.</p>
<p>{_html_text(RECAP_QUALITY_HOST_OWNED)}</p>
<p>Ledger status {_html_text(ledger_status)}; bound={_html_text(bound)}; landed={_html_text(landed)}.
Spec frozen={"yes" if state.get("spec_sha256") else "no"}.
Walk drained={"yes" if drained else "no"}.</p>
</article>
</body>
</html>
"""


def write_recap_html(run_dir: Path, state: Dict[str, Any], *, dest: str) -> Path:
    path = run_dir / "recap.html"
    try:
        path.write_text(render_recap_html(run_dir, state, dest=dest), encoding="utf-8")
    except OSError as exc:
        die(EXIT_BLOCKED, f"cannot write recap.html: {exc}")
    return path


def load_dag(run_dir: Path) -> Optional[Dict[str, Any]]:
    path = canonical_backchain(run_dir)
    if not path.is_file():
        return None
    if path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {path}")
    inside_run_dir(run_dir, path)
    data = load_json(path)
    if not isinstance(data, dict):
        die(EXIT_BLOCKED, "backchain plan.json is not an object")
    return data


def dag_gaps(run_dir: Path, spec: Optional[Dict[str, Any]]) -> List[str]:
    gaps: List[str] = []
    path = canonical_backchain(run_dir)
    if not path.is_file():
        return [f"missing {path}"]
    data = load_dag(run_dir)
    if data is None:
        return [f"missing {path}"]
    for key in ("goal", "initial_state", "steps", "unresolved"):
        if key not in data:
            gaps.append(f"backchain missing key {key}")
    steps = data.get("steps")
    if not isinstance(steps, list) or not steps:
        gaps.append("backchain steps must be a nonempty list")
        return gaps
    unresolved = data.get("unresolved")
    if unresolved is None:
        gaps.append("backchain missing key unresolved")
    elif not isinstance(unresolved, list):
        gaps.append("backchain unresolved must be a list")
    elif unresolved:
        gaps.append("unresolved must be empty to enter implement")
    goal = data.get("goal")
    spec_ds = (spec or {}).get("done_sentence")
    if not isinstance(goal, str) or not goal.strip():
        gaps.append("backchain.goal must be a nonempty string equal to spec.done_sentence")
    elif spec_ds is not None and goal != spec_ds:
        gaps.append("backchain.goal must equal spec.done_sentence")
    initial = data.get("initial_state")
    if not isinstance(initial, list):
        gaps.append("initial_state must be a list")
        initial = []
    initial_set = {x for x in initial if isinstance(x, str)}
    ref_paths: List[str] = []
    env, _ = load_environment(run_dir)
    mcp_considered = ""
    if isinstance(env, dict):
        mc = env.get("mcp_considered")
        if isinstance(mc, str) and mc.strip():
            mcp_considered = mc.strip()
        for r in env.get("references") or []:
            if isinstance(r, dict):
                rp = r.get("path")
                if isinstance(rp, str) and rp.strip():
                    ref_paths.append(rp.strip())
    ids: List[str] = []
    seen: Set[str] = set()
    graph: Dict[str, List[str]] = {}
    for i, step in enumerate(steps):
        if not isinstance(step, dict):
            gaps.append(f"steps[{i}] is not an object")
            continue
        sid = step.get("id")
        if not isinstance(sid, str) or not STEP_ID_RE.fullmatch(sid):
            gaps.append(f"unsafe or missing step id {sid!r}")
            continue
        if ".." in sid or "/" in sid:
            gaps.append(f"unsafe step id {sid}")
            continue
        if sid in seen:
            gaps.append(f"duplicate step id {sid}")
        seen.add(sid)
        ids.append(sid)
        statement = step.get("statement")
        if not isinstance(statement, str) or not statement.strip():
            gaps.append(f"{sid} statement must be a nonempty string")
        elif CONTROL_RE.search(statement) or has_disallowed_slash(statement):
            gaps.append(f"{sid} statement contains a newline, control, or disallowed slash skill")
        prompt = step.get("prompt")
        if not isinstance(prompt, str) or not prompt.strip():
            gaps.append(f"{sid} prompt must be a nonempty string")
        elif PROMPT_CONTROL_RE.search(prompt) or has_disallowed_slash(prompt):
            gaps.append(f"{sid} prompt contains a disallowed control character or slash skill")
        elif step.get("origin") == "seed":
            # Citation stays behind nonempty ref_paths. Tools:/token is a
            # sibling seed-only gate — greenfield references: [] still
            # requires it. inject-step (origin discovered) is exempt.
            if ref_paths:
                for rp in ref_paths:
                    if rp not in prompt:
                        gaps.append(f"{sid} prompt must cite environment reference {rp}")
            if not any(re.match(r"^[ \t]*Tools:", line) for line in prompt.splitlines()):
                gaps.append(
                    f"{sid} prompt must have a line starting with Tools:; "
                    "in-flight pre-0.8.4 runs: dest blocked then dest plan, "
                    "rewrite seed prompts (do not hand-edit backchain/plan.json)"
                )
            if mcp_considered and mcp_considered not in prompt:
                gaps.append(
                    f"{sid} prompt must cite mcp_considered {mcp_considered}; "
                    "in-flight pre-0.8.4 runs: dest blocked then dest plan, "
                    "rewrite seed prompts (do not hand-edit backchain/plan.json)"
                )
        produces = step.get("produces")
        texts = produces_texts(produces)
        if texts is None:
            gaps.append(f"{sid} produces must be a nonempty string or string list")
        else:
            for t in texts:
                if CONTROL_RE.search(t) or has_disallowed_slash(t):
                    gaps.append(f"{sid} produces contains a newline, control, or disallowed slash skill")
        origin = step.get("origin")
        if origin not in ("seed", "discovered"):
            gaps.append(f"{sid} origin must be seed or discovered")
        inputs = step.get("inputs")
        if not isinstance(inputs, list):
            gaps.append(f"{sid} inputs must be a list")
            inputs = []
        graph.setdefault(sid, [])
        for inp in inputs:
            if not isinstance(inp, dict):
                gaps.append(f"{sid} input is not an object")
                continue
            need = inp.get("need")
            if not isinstance(need, str) or not need.strip():
                gaps.append(f"{sid} inputs[].need must be nonempty")
            fr = inp.get("from")
            if fr is None:
                if isinstance(need, str) and need not in initial_set:
                    gaps.append(f"{sid} from:null need not in initial_state")
            elif not isinstance(fr, str):
                gaps.append(f"{sid} inputs[].from must be null or an id")
            else:
                graph[sid].append(fr)
    for sid, deps in graph.items():
        for fr in deps:
            if fr not in seen:
                gaps.append(f"{sid} inputs.from {fr} is not an existing id")
    # cycle
    WHITE, GREY, BLACK = 0, 1, 2
    color = {sid: WHITE for sid in seen}

    def visit(node: str) -> bool:
        color[node] = GREY
        for nxt in graph.get(node, []):
            if nxt not in color:
                continue
            if color[nxt] == GREY:
                return True
            if color[nxt] == WHITE and visit(nxt):
                return True
        color[node] = BLACK
        return False

    for sid in seen:
        if color[sid] == WHITE and visit(sid):
            gaps.append("committed cycle")
            break
    return gaps


def recomputed_step_ids(run_dir: Path) -> List[str]:
    data = load_dag(run_dir)
    if not data:
        return []
    ids = []
    for step in data.get("steps") or []:
        if isinstance(step, dict) and isinstance(step.get("id"), str):
            ids.append(step["id"])
    return sorted(ids)


def steps_dir(run_dir: Path) -> Path:
    return run_dir / "steps"


def receipt_path(run_dir: Path, sid: str) -> Path:
    if not STEP_ID_RE.fullmatch(sid) or ".." in sid or "/" in sid:
        die(EXIT_BLOCKED, f"unsafe step id {sid}")
    path = steps_dir(run_dir) / f"{sid}.json"
    inside_run_dir(run_dir, path)
    return path


def load_receipt(run_dir: Path, sid: str) -> Optional[Dict[str, Any]]:
    path = receipt_path(run_dir, sid)
    if not path.is_file():
        return None
    if path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {path}")
    data = load_json(path)
    return data if isinstance(data, dict) else None


def receipt_matches(rec: Optional[Dict[str, Any]], plan_hash: str, status: str) -> bool:
    if not rec:
        return False
    return rec.get("status") == status and rec.get("plan_sha256") == plan_hash


def plan_hash_of(run_dir: Path) -> str:
    path = canonical_backchain(run_dir)
    if not path.is_file():
        return ""
    return sha256_file(path)


def repo_of(state: Dict[str, Any]) -> Path:
    return Path(str(state.get("repo_root") or "")).expanduser()


def git_run(repo: Path, *args: str, timeout: int = 30) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            ["git", "-C", str(repo), *args],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except FileNotFoundError:
        return subprocess.CompletedProcess(["git"], 127, "", "git not found")
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(["git"], 124, "", "git timeout")


def git_repo_ready(repo: Path) -> bool:
    if not repo.is_dir():
        return False
    inside = git_run(repo, "rev-parse", "--is-inside-work-tree")
    if inside.returncode != 0 or inside.stdout.strip() != "true":
        return False
    head = git_run(repo, "rev-parse", "--verify", "HEAD")
    return head.returncode == 0 and bool(head.stdout.strip())


def worktree_branch(run_id: str, sid: str) -> str:
    return f"shiploop/{run_id}/{sid}"


def branch_ahead_of_head(repo: Path, branch: str) -> bool:
    return branch_commits_since(repo, branch, "")


def head_sha(repo: Path) -> str:
    got = git_run(repo, "rev-parse", "HEAD")
    if got.returncode != 0:
        return ""
    return (got.stdout or "").strip()


def branch_commits_since(repo: Path, branch: str, base_sha: str) -> bool:
    if not branch:
        return False
    spec = f"{base_sha}..{branch}" if base_sha else f"HEAD..{branch}"
    counted = git_run(repo, "rev-list", "--count", spec)
    if counted.returncode != 0:
        return False
    try:
        return int((counted.stdout or "0").strip()) > 0
    except ValueError:
        return False


def branch_is_ancestor_of_head(repo: Path, branch: str) -> bool:
    if not branch:
        return False
    got = git_run(repo, "merge-base", "--is-ancestor", branch, "HEAD")
    return got.returncode == 0


def worktree_path(repo: Path, run_id: str, sid: str) -> Path:
    return (repo / WT_DIRNAME / "shiploop" / run_id / sid).resolve()


def ensure_worktrees_excluded(repo: Path) -> None:
    probe = git_run(repo, "check-ignore", "-q", "--", f"{WT_DIRNAME}/probe")
    if probe.returncode == 0:
        return
    excl = git_run(repo, "rev-parse", "--git-path", "info/exclude")
    if excl.returncode != 0 or not excl.stdout.strip():
        die(EXIT_BLOCKED, "cannot resolve .git/info/exclude for worktree ignore")
    raw = excl.stdout.strip()
    path = Path(raw) if Path(raw).is_absolute() else repo / raw
    path.parent.mkdir(parents=True, exist_ok=True)
    existing = path.read_text(encoding="utf-8") if path.is_file() else ""
    if f"{WT_DIRNAME}/" not in existing:
        path.write_text(existing.rstrip() + f"\n{WT_DIRNAME}/\n", encoding="utf-8")


def remove_step_worktree(repo: Path, wt: str, branch: str, *, delete_branch: bool) -> None:
    if wt:
        git_run(repo, "worktree", "remove", "--force", wt)
        leftover = Path(wt)
        if leftover.exists() or leftover.is_symlink():
            shutil.rmtree(leftover, ignore_errors=True)
    if delete_branch and branch:
        git_run(repo, "branch", "-D", branch)


def wipe_run_worktrees(repo: Path, run_id: str) -> None:
    if not run_id or not repo.is_dir() or not git_repo_ready(repo):
        return
    marker = f"/{WT_DIRNAME}/shiploop/{run_id}/"
    listed = git_run(repo, "worktree", "list", "--porcelain")
    if listed.returncode == 0:
        for line in listed.stdout.splitlines():
            if not line.startswith("worktree "):
                continue
            path = line[len("worktree ") :]
            if marker in path.replace("\\", "/"):
                git_run(repo, "worktree", "remove", "--force", path)
    root = repo / WT_DIRNAME / "shiploop" / run_id
    if root.exists():
        shutil.rmtree(root, ignore_errors=True)
    refs = git_run(repo, "for-each-ref", "--format=%(refname:short)", f"refs/heads/shiploop/{run_id}")
    if refs.returncode == 0:
        for branch in refs.stdout.splitlines():
            if branch.strip():
                git_run(repo, "branch", "-D", branch.strip())


def create_step_worktree(state: Dict[str, Any], sid: str) -> Tuple[str, str]:
    repo = repo_of(state)
    run_id = str(state.get("run_id") or "")
    if not git_repo_ready(repo):
        die(EXIT_BLOCKED, "repo_root is not a git repository with HEAD (worktree isolation)")
    if not run_id or not STEP_ID_RE.fullmatch(sid):
        die(EXIT_BLOCKED, f"cannot allocate worktree for {sid}")
    ensure_worktrees_excluded(repo)
    path = worktree_path(repo, run_id, sid)
    branch = worktree_branch(run_id, sid)
    if path.exists() or path.is_symlink():
        die(EXIT_BLOCKED, f"refusing to reuse worktree path {path}")
    path.parent.mkdir(parents=True, exist_ok=True)
    existed = git_run(repo, "show-ref", "--verify", "--quiet", f"refs/heads/{branch}")
    branch_existed = existed.returncode == 0
    added = git_run(repo, "worktree", "add", "-b", branch, str(path), "HEAD")
    if added.returncode != 0:
        remove_step_worktree(repo, str(path), branch, delete_branch=not branch_existed)
        die(EXIT_BLOCKED, f"git worktree add failed: {(added.stderr or added.stdout).strip()}")
    return str(path), branch


def release_receipt_worktree(
    state: Dict[str, Any], rec: Optional[Dict[str, Any]], *, delete_branch: bool
) -> None:
    if not rec:
        return
    wt = rec.get("worktree")
    br = rec.get("branch")
    if isinstance(wt, str) and wt.strip():
        remove_step_worktree(repo_of(state), wt.strip(), str(br or ""), delete_branch=delete_branch)
    elif delete_branch and isinstance(br, str) and br.strip():
        git_run(repo_of(state), "branch", "-D", br.strip())
    sid = rec.get("id")
    run_id = str(state.get("run_id") or "")
    if isinstance(sid, str) and STEP_ID_RE.fullmatch(sid) and run_id:
        planned = worktree_path(repo_of(state), run_id, sid)
        if planned.exists() or planned.is_symlink():
            remove_step_worktree(repo_of(state), str(planned), "", delete_branch=False)


def isolation_for(
    state: Dict[str, Any], sid: str, rec: Optional[Dict[str, Any]] = None
) -> Tuple[str, str]:
    if rec and isinstance(rec.get("worktree"), str) and rec["worktree"].strip():
        br = rec.get("branch")
        return rec["worktree"].strip(), br.strip() if isinstance(br, str) else ""
    run_id = str(state.get("run_id") or "")
    if not run_id or not STEP_ID_RE.fullmatch(sid):
        return "", ""
    return str(worktree_path(repo_of(state), run_id, sid)), worktree_branch(run_id, sid)


def clear_steps(run_dir: Path, state: Dict[str, Any], *, running_only: bool = False) -> None:
    d = steps_dir(run_dir)
    if d.is_dir():
        plan_hash = str(state.get("plan_sha256") or "")
        for path in list(d.glob("*.json")):
            rec = load_json(path) if path.is_file() and not path.is_symlink() else None
            if running_only:
                if not isinstance(rec, dict) or rec.get("status") != "running":
                    continue
                if plan_hash and rec.get("plan_sha256") != plan_hash:
                    continue
            if isinstance(rec, dict):
                release_receipt_worktree(state, rec, delete_branch=True)
            if path.is_file() or path.is_symlink():
                path.unlink()


def steps_by_id(run_dir: Path) -> Dict[str, Dict[str, Any]]:
    data = load_dag(run_dir) or {}
    out: Dict[str, Dict[str, Any]] = {}
    for step in data.get("steps") or []:
        if isinstance(step, dict) and isinstance(step.get("id"), str):
            out[step["id"]] = step
    return out


def suppliers_complete(step: Dict[str, Any], run_dir: Path, plan_hash: str) -> bool:
    for inp in step.get("inputs") or []:
        if not isinstance(inp, dict):
            return False
        fr = inp.get("from")
        if fr is None:
            continue
        if not receipt_matches(load_receipt(run_dir, str(fr)), plan_hash, "complete"):
            return False
    return True


def classify_steps(run_dir: Path, state: Dict[str, Any]) -> Dict[str, str]:
    plan_hash = str(state.get("plan_sha256") or "")
    by_id = steps_by_id(run_dir)
    out: Dict[str, str] = {}
    for sid, step in by_id.items():
        rec = load_receipt(run_dir, sid)
        if receipt_matches(rec, plan_hash, "complete"):
            out[sid] = "done"
        elif receipt_matches(rec, plan_hash, "running"):
            out[sid] = "running"
        elif suppliers_complete(step, run_dir, plan_hash):
            out[sid] = "ready"
        else:
            out[sid] = "todo"
    return out


def steps_drained(run_dir: Path, state: Dict[str, Any]) -> bool:
    ids = recomputed_step_ids(run_dir)
    if not ids:
        return False
    plan_hash = str(state.get("plan_sha256") or "")
    if not plan_hash:
        return False
    return all(receipt_matches(load_receipt(run_dir, sid), plan_hash, "complete") for sid in ids)


def check_frozen_hashes(state: Dict[str, Any], run_dir: Path, dest: Optional[str]) -> None:
    # --to blocked is the halt hatch: must work even when files drifted.
    if dest == "blocked":
        return
    env_h = str(state.get("environment_sha256") or "")
    # Empty environment_sha256 is grandfathered (pre-0.7 run, or never bound).
    if env_h and dest not in ("plan", "validate-spec"):
        p = run_dir / "environment.md"
        if not p.is_file() or environment_sha256_of(run_dir) != env_h:
            die(EXIT_BLOCKED, "environment hash drift; rebind via blocked -> validate-spec")
    spec_h = str(state.get("spec_sha256") or "")
    # dest plan / validate-spec rebind the spec (write or clear the hash).
    if spec_h and dest not in ("plan", "validate-spec"):
        md = run_dir / "spec.md"
        if not md.is_file():
            die(EXIT_BLOCKED, "spec hash bound but spec.md missing; rebind via blocked -> validate-spec")
        if spec_sha256_of(run_dir) != spec_h:
            legacy_ok = False
            js = run_dir / "spec.json"
            if js.is_file():
                try:
                    legacy_ok = legacy_spec_pair_sha256(run_dir) == spec_h
                except Exception:
                    legacy_ok = False
            if not legacy_ok:
                die(EXIT_BLOCKED, "spec hash drift; rebind via blocked -> validate-spec")
    plan_h = str(state.get("plan_sha256") or "")
    # dest plan rebinds the DAG. dest validate-spec also rebinds (clears
    # plan_sha256) so a drifted DAG must not wedge blocked → validate-spec.
    if plan_h and dest not in ("plan", "validate-spec"):
        path = canonical_backchain(run_dir)
        if not path.is_file():
            die(EXIT_BLOCKED, "plan hash bound but backchain/plan.json missing; rebind via blocked → plan")
        if sha256_file(path) != plan_h:
            die(EXIT_BLOCKED, "plan hash drift; rebind via blocked → plan")


def refuse_if_blocked_step_cmd(state: Dict[str, Any]) -> None:
    if state.get("phase") == "blocked":
        die(EXIT_BLOCKED, "start-step/complete-step/clear-step illegal while blocked")
    if state.get("phase") != "implement":
        die(EXIT_BLOCKED, "step commands require phase implement")


def write_running_receipt(run_dir: Path, state: Dict[str, Any], sid: str) -> None:
    plan_hash = str(state.get("plan_sha256") or "")
    wt, branch = create_step_worktree(state, sid)
    rec = {
        "writer": "shiploop.start-step",
        "run_id": state.get("run_id"),
        "id": sid,
        "status": "running",
        "plan_sha256": plan_hash,
        "worktree": wt,
        "branch": branch,
        "base_sha": head_sha(repo_of(state)),
    }
    try:
        write_json_atomic(receipt_path(run_dir, sid), rec)
    except OSError:
        remove_step_worktree(repo_of(state), wt, branch, delete_branch=True)
        die(EXIT_BLOCKED, f"could not write running receipt for {sid}")


def claim_ready(run_dir: Path, state: Dict[str, Any]) -> List[str]:
    if str(state.get("phase")) != "implement":
        return []
    claimed: List[str] = []
    classes = classify_steps(run_dir, state)
    ready = [sid for sid, kind in classes.items() if kind == "ready"]
    if ready and not git_repo_ready(repo_of(state)):
        die(EXIT_BLOCKED, "repo_root is not a git repository with HEAD (worktree isolation)")
    for sid in ready:
        write_running_receipt(run_dir, state, sid)
        claimed.append(sid)
    return claimed


def running_ids(run_dir: Path, state: Dict[str, Any]) -> List[str]:
    classes = classify_steps(run_dir, state)
    return [sid for sid in recomputed_step_ids(run_dir) if classes.get(sid) == "running"]


def cwd_running_id(run_dir: Path, state: Dict[str, Any]) -> Optional[str]:
    try:
        cwd = Path.cwd().resolve()
    except OSError:
        return None
    for sid in running_ids(run_dir, state):
        rec = load_receipt(run_dir, sid)
        wt = ""
        if rec and isinstance(rec.get("worktree"), str):
            wt = rec["worktree"].strip()
        if not wt:
            wt, _br = isolation_for(state, sid, rec)
        if not wt:
            continue
        try:
            root = Path(wt).resolve()
        except OSError:
            continue
        if cwd == root or root in cwd.parents:
            return sid
    return None


def resolve_step_id(run_dir: Path, state: Dict[str, Any], explicit: Optional[str]) -> str:
    if explicit and str(explicit).strip():
        return str(explicit).strip()
    via_cwd = cwd_running_id(run_dir, state)
    if via_cwd:
        return via_cwd
    running = running_ids(run_dir, state)
    if len(running) == 1:
        return running[0]
    if not running:
        die(EXIT_BLOCKED, "no running step to complete or clear")
    die(
        EXIT_BLOCKED,
        "multiple running steps require --id or cwd in a step worktree: " + ", ".join(running),
    )
    return ""


def apply_complete_receipt(run_dir: Path, state: Dict[str, Any], sid: str) -> str:
    refuse_if_blocked_step_cmd(state)
    check_frozen_hashes(state, run_dir, None)
    if sid not in steps_by_id(run_dir):
        die(EXIT_BLOCKED, f"unknown step id {sid}")
    plan_hash = str(state.get("plan_sha256") or "")
    rec = load_receipt(run_dir, sid)
    if receipt_matches(rec, plan_hash, "complete"):
        die(EXIT_BLOCKED, f"{sid} already complete")
    if not receipt_matches(rec, plan_hash, "running"):
        die(EXIT_BLOCKED, f"{sid} is not running")
    step = steps_by_id(run_dir)[sid]
    if not suppliers_complete(step, run_dir, plan_hash):
        die(EXIT_BLOCKED, f"{sid} suppliers not complete")
    wt = rec.get("worktree") if rec else ""
    br = rec.get("branch") if rec else ""
    branch = br.strip() if isinstance(br, str) else ""
    repo = repo_of(state)
    base = ""
    if rec and isinstance(rec.get("base_sha"), str):
        base = rec["base_sha"].strip()
    if not branch_commits_since(repo, branch, base):
        die(
            EXIT_BLOCKED,
            f"{sid} branch has no commits beyond session HEAD; commit in the worktree first",
        )
    if not branch_is_ancestor_of_head(repo, branch):
        repo_s = str(repo.resolve()) if repo.exists() else str(repo)
        die(
            EXIT_BLOCKED,
            f"{sid} branch is not in session HEAD; merge first: "
            f"git -C {repo_s} merge --no-ff --no-edit {branch}",
        )
    if isinstance(wt, str) and wt.strip():
        remove_step_worktree(repo, wt.strip(), branch, delete_branch=False)
        leftover = Path(wt.strip())
        if leftover.exists() or leftover.is_symlink():
            die(EXIT_BLOCKED, f"could not remove worktree {wt.strip()}")
    write_json_atomic(
        receipt_path(run_dir, sid),
        {
            "writer": "shiploop.complete-step",
            "run_id": state.get("run_id"),
            "id": sid,
            "status": "complete",
            "plan_sha256": plan_hash,
            "worktree": "",
            "branch": branch,
            "base_sha": base,
        },
    )
    save_state(run_dir, state, event=f"complete-step:{sid}")
    return sid


def descendant_ids(run_dir: Path, sid: str) -> List[str]:
    children: Dict[str, List[str]] = {}
    for tid, step in steps_by_id(run_dir).items():
        for inp in step.get("inputs") or []:
            if isinstance(inp, dict) and isinstance(inp.get("from"), str):
                children.setdefault(str(inp["from"]), []).append(tid)
    out: List[str] = []
    stack = list(children.get(sid, []))
    seen: Set[str] = set()
    while stack:
        cur = stack.pop()
        if cur in seen:
            continue
        seen.add(cur)
        out.append(cur)
        stack.extend(children.get(cur, []))
    return out


def apply_clear_receipt(run_dir: Path, state: Dict[str, Any], sid: str) -> str:
    refuse_if_blocked_step_cmd(state)
    check_frozen_hashes(state, run_dir, None)
    rec = load_receipt(run_dir, sid)
    plan_hash = str(state.get("plan_sha256") or "")
    if not rec or rec.get("plan_sha256") != plan_hash:
        die(EXIT_BLOCKED, f"no hash-matching receipt for {sid}")
    to_clear = [sid] + descendant_ids(run_dir, sid)
    for tid in to_clear:
        path = receipt_path(run_dir, tid)
        rec_t = load_receipt(run_dir, tid)
        if rec_t:
            release_receipt_worktree(state, rec_t, delete_branch=True)
        if path.is_file() or path.is_symlink():
            path.unlink()
    save_state(run_dir, state, event=f"clear-step:{sid}")
    return sid


def produces_texts(produces: Any) -> Optional[List[str]]:
    if isinstance(produces, str) and produces.strip():
        return [produces.strip()]
    if isinstance(produces, list) and produces:
        out: List[str] = []
        for item in produces:
            if not isinstance(item, str) or not item.strip():
                return None
            out.append(item.strip())
        return out
    return None


def missing_for(state: Dict[str, Any], run_dir: Path, dest: Optional[str]) -> List[str]:
    gaps: List[str] = []
    deps = resolve_dep_roots()
    state["dep_roots"] = deps
    phase = str(state.get("phase"))
    if dest in ("plan", "implement") or phase in ("plan", "implement"):
        if dest == "implement" or (phase == "implement" and dest is None):
            if not deps.get("backchain"):
                gaps.append("missing dep_roots.backchain")
        if dest == "implement":
            if not git_repo_ready(repo_of(state)):
                repo = repo_of(state)
                inside = git_run(repo, "rev-parse", "--is-inside-work-tree")
                if repo.is_dir() and inside.returncode == 0 and inside.stdout.strip() == "true":
                    gaps.append(
                        "repo has no HEAD commit; create an initial commit so "
                        "implement can isolate worktrees"
                    )
                else:
                    gaps.append(
                        "repo_root is not a git repository with HEAD (worktree isolation)"
                    )
    if dest is None:
        if phase == "plan" and not deps.get("backchain"):
            gaps.append("missing dep_roots.backchain")
        return gaps
    need = legal_edge(str(state.get("phase")), dest)
    if need is None:
        return [f"illegal transition {state.get('phase')} -> {dest}"]
    if need == "prompt":
        prompt = (read_text(run_dir / "prompt.md") or state.get("prompt") or "").strip()
        if not prompt:
            gaps.append("prompt empty")
    elif need == "spec_checkable":
        spec, sg = load_spec(run_dir)
        gaps.extend(sg)
        if spec and spec.get("checkable") is not True:
            gaps.append("spec.md checkable is not true")
        env, eg = load_environment(run_dir)
        gaps.extend(eg)
        if env:
            gaps.extend(handles_block_plan(env))
    elif need == "spec_uncheckable":
        spec, sg = load_spec(run_dir)
        gaps.extend(sg)
        if spec and spec.get("checkable") is not False:
            gaps.append("spec.md checkable is not false")
        ask = (spec or {}).get("ask_user") if spec else None
        if not (isinstance(ask, str) and ask.strip()):
            gaps.append("ask_user required when checkable is false")
    elif need == "plan":
        spec, sg = load_spec(run_dir)
        gaps.extend(sg)
        if spec and spec.get("checkable") is not True:
            gaps.append("spec.md checkable is not true")
        gaps.extend(wrapper_pair(run_dir, spec))
        gaps.extend(dag_gaps(run_dir, spec))
        if not deps.get("backchain"):
            if "missing dep_roots.backchain" not in gaps:
                gaps.append("missing dep_roots.backchain")
    elif need == "steps_drained":
        if not steps_drained(run_dir, state):
            gaps.append("steps not drained")
        if not residual_plan_bindable(state, run_dir):
            gaps.append(
                "bound_plan empty: add ## Review Coverage to .shiploop/plan.md "
                "or pass --bound-plan"
            )
    elif need == "residual_success":
        gaps.extend(residual_gaps(state, "done"))
    elif need == "residual_stopped":
        gaps.extend(residual_gaps(state, "halted"))
    elif need == "reason":
        pass
    return gaps


def forward_dest(state: Dict[str, Any], run_dir: Path) -> Optional[str]:
    phase = str(state.get("phase"))
    if phase == "intake":
        return "validate-spec"
    if phase == "validate-spec":
        spec, gaps = load_spec(run_dir)
        if spec and spec.get("checkable") is False and not any("missing" in g for g in gaps):
            return "blocked"
        return "plan"
    if phase == "plan":
        spec, _ = load_spec(run_dir)
        # A missing DAG is the normal start of plan — dest implement and
        # list the files in Missing. dest blocked only when a written DAG
        # is illegal (otherwise When done invoke tells the host --blocked).
        if not canonical_backchain(run_dir).is_file():
            return "implement"
        if dag_gaps(run_dir, spec):
            return "blocked"
        return "implement"
    if phase == "implement":
        if steps_drained(run_dir, state):
            return "residual"
        return None
    if phase == "residual":
        repo = Path(str(state.get("repo_root") or ""))
        if repo.is_dir():
            rep = ledger_report(repo, state)
            if (rep.get("status") or "").startswith("stopped") and rep.get("bound"):
                return "halted"
        return "done"
    if phase == "blocked":
        return str(state.get("resume_to") or "") or None
    return None


def _checkable_token(spec: Optional[Dict[str, Any]]) -> str:
    if not spec or "checkable" not in spec:
        return ""
    flag = spec.get("checkable")
    if flag is True:
        return "true"
    if flag is False:
        return "false"
    return diag_text(flag)


def activity_title(phase: str, state: Optional[Dict[str, Any]] = None) -> str:
    if phase == "residual" and state and plan_waiver(state):
        return "residual waived — quality/publish then dest done"
    if phase == "done" and state and plan_waiver(state):
        return (
            "session closed — residual waived; quality/publish were host-owned — stop"
        )
    titles = {
        "intake": "record the original ask",
        "validate-spec": "survey, then write a machine-checkable spec",
        "plan": "write the sequence plan via backchain",
        "implement": "walk ready steps via /goal",
        "residual": "run bound review-coverage Phase B",
        "blocked": "stop and ask the user",
        "done": (
            "session closed — review-coverage complete; "
            "quality/publish were host-owned — stop"
        ),
        "halted": "session halted — stop",
    }
    return titles.get(phase, phase)


def phase_begin_text(phase: str, state: Optional[Dict[str, Any]] = None) -> str:
    if phase == "residual" and state and plan_waiver(state):
        return (
            "Review-coverage is waived on the bound plan. Do the spec's quality "
            "/goal and outer-loop publish if named, then dest done."
        )
    return PHASE_BEGIN.get(phase, activity_title(phase, state))


def phase_finish_text(phase: str, state: Optional[Dict[str, Any]] = None) -> str:
    if phase == "residual" and state and plan_waiver(state):
        return (
            "After the spec's quality /goal and outer-loop publish (if named), "
            "invoke /shiploop complete — dest done writes recap.html."
        )
    return PHASE_FINISH.get(phase, "invoke /shiploop complete")


# Verbosity for ## Progress (session phases). Implement uses per-step text.
PHASE_BEGIN = {
    "intake": "Write the original ask to prompt.md. Do not invent a done sentence.",
    "validate-spec": (
        "Survey the bound repo and this session's tools, write environment.md "
        "(survey then practices), then write spec.md."
    ),
    "plan": (
        "Call backchain once, persist backchain/plan.json, then write plan.md "
        "with a labeled done_sentence equal to the spec. Do not rewrite the frozen spec."
    ),
    "implement": "Walk ready DAG steps via /goal in per-step worktrees.",
    "residual": (
        "Run review-coverage Phase B for the bound plan, or dest blocked if "
        "there is no Test command / bound plan."
    ),
    "blocked": "Stop. Ask the user. No product edits until they answer.",
    "done": (
        "Session closed. Stop. Do not dest further. Recap reports walk "
        "outcomes and review-coverage; it does not witness host-owned "
        "quality/publish."
    ),
    "halted": "Session halted. Stop. Do not dest further.",
}
PHASE_FINISH = {
    "intake": "Invoke /shiploop complete. The harness dests validate-spec.",
    "validate-spec": "Invoke /shiploop complete. The harness dests plan (or blocked).",
    "plan": "Invoke /shiploop complete. The harness dests implement and claims ready ids.",
    "implement": (
        "After each /goal: commit on that step's worktree, merge the branch "
        "into the session checkout, invoke /shiploop complete."
    ),
    "residual": "When the ledger is complete+landed (or waived), do the spec's quality /goal and outer-loop publish if named, then invoke /shiploop complete — dest done writes recap.html.",
    "blocked": "When they answer: invoke /shiploop complete --reason <answer> (resumes to resume_to).",
    "done": "stop — no update",
    "halted": "stop — no update",
}


def diag_text(value: Any) -> str:
    text = " ".join(str(value or "").split())
    if not text:
        return "(none)"
    if CONTROL_RE.search(text) or has_disallowed_slash(text):
        return "(omitted)"
    return text


def _diag_supplier_suffix(step: Dict[str, Any]) -> str:
    bits: List[str] = []
    for inp in step.get("inputs") or []:
        if not isinstance(inp, dict):
            continue
        need = diag_text(inp.get("need"))
        fr = inp.get("from")
        if fr is None:
            bits.append(f"{need} from initial_state")
        else:
            bits.append(f"{need} from {diag_text(fr)}")
    if not bits:
        return ""
    return "needs " + "; ".join(bits)


def journal_mark(klass: str) -> str:
    return "[x]" if klass == "done" else "[ ]"


def _print_diag_step(
    sid: str,
    step: Dict[str, Any],
    *,
    status: str = "",
    need: str = "",
    isolate: str = "",
    mark: str = "",
) -> None:
    stmt = diag_text(step.get("statement"))
    texts = produces_texts(step.get("produces")) or []
    produces = diag_text("; ".join(texts)) if texts else ""
    if mark:
        print(f"    {mark} {sid}  {stmt}")
    else:
        print(f"    {sid}  {stmt}")
    if produces and produces != "(none)":
        print(f"        produces  {produces}")
    extra = "  ".join(p for p in (status, need) if p)
    if extra:
        print(f"        {extra}")
    if isolate:
        print(f"        {isolate}")


def print_diagnosis(run_dir: Path, state: Dict[str, Any]) -> None:
    phase = str(state.get("phase"))
    spec, _ = load_spec(run_dir)
    raw_ds = (spec or {}).get("done_sentence") if spec else None
    spec_line = diag_text(raw_ds) if raw_ds else "(not written)"
    if spec_line == "(none)":
        spec_line = "(not written)"
    frozen = "yes" if state.get("spec_sha256") and phase != "validate-spec" else "no"
    chk = ""
    if spec is not None and "checkable" in spec:
        flag = spec.get("checkable")
        if flag is True:
            chk = "  checkable=true"
        elif flag is False:
            chk = "  checkable=false"
        else:
            chk = f"  checkable={diag_text(flag)}"
    print("Diagnosis")
    print(f"  spec       {spec_line}")
    print(f"  frozen     {frozen}{chk}")
    if phase == "implement":
        classes = classify_steps(run_dir, state)
        by_id = steps_by_id(run_dir)
        ids = recomputed_step_ids(run_dir)
        done = [sid for sid in ids if classes.get(sid) == "done"]
        running = [sid for sid in ids if classes.get(sid) == "running"]
        ready = [sid for sid in ids if classes.get(sid) == "ready"]
        waiting = [sid for sid in ids if classes.get(sid) == "todo"]
        stand = (
            f"implement — {len(done)}/{len(ids) or 0} steps done, "
            f"{len(running)} running, {len(ready)} ready, {len(waiting)} waiting"
        )
        if ids and steps_drained(run_dir, state):
            stand += "; drained — next residual"
        elif frozen == "yes":
            stand += "; serving frozen spec"
        print(f"  stand      {stand}")
        print("  completed")
        if done:
            for sid in done:
                _print_diag_step(
                    sid,
                    by_id.get(sid) or {"statement": ""},
                    mark=journal_mark("done"),
                )
        else:
            print("    (none)")
        print("  now")
        now_ids = running + ready
        if now_ids:
            for sid in now_ids:
                kind = classes.get(sid, "")
                extra = "(running)" if kind == "running" else "(ready)"
                need = _diag_supplier_suffix(by_id.get(sid) or {})
                rec = load_receipt(run_dir, sid)
                wt, br = isolation_for(state, sid, rec)
                isolate = ""
                if kind == "running" and wt and br:
                    isolate = f"cwd {wt} on branch {br}"
                _print_diag_step(
                    sid,
                    by_id.get(sid) or {"statement": ""},
                    status=extra,
                    need=need,
                    isolate=isolate,
                    mark=journal_mark(kind),
                )
        else:
            print("    (none)")
        print("  pending")
        if waiting:
            for sid in waiting:
                need = _diag_supplier_suffix(by_id.get(sid) or {})
                _print_diag_step(
                    sid,
                    by_id.get(sid) or {"statement": ""},
                    need=need,
                    mark=journal_mark("todo"),
                )
        else:
            print("    (none)")
        return
    print(f"  stand      {phase} — {activity_title(phase, state)}")
    completed: List[str] = []
    pending: List[str] = []
    for p in MAP_PHASES:
        line = map_line(p, state, run_dir)
        if p == phase or (phase == "blocked" and p == "blocked"):
            continue
        if ": done" in line:
            completed.append(p)
        elif ": todo" in line or ": skipped" in line:
            pending.append(p)
    print("  completed")
    if completed:
        for p in completed:
            print(f"    {p}  {activity_title(p, state)}")
    else:
        print("    (none)")
    print("  now")
    print(f"    {phase}  {activity_title(phase, state)}")
    print("  pending")
    if pending:
        print("    " + " → ".join(pending))
    else:
        print("    (none)")


def print_host_worktree_flag() -> None:
    for line in HOST_WORKTREE_FLAG:
        print(line)


def _join_env_list(values: Any) -> str:
    if not isinstance(values, list) or not values:
        return "(none)"
    parts = [str(v) for v in values if str(v).strip()]
    return ", ".join(parts) if parts else "(none)"


def print_frozen_session_env(run_dir: Path) -> None:
    """Reprint frozen tools/MCP above the stored prompt. Do not compose it."""
    print(
        "Frozen session environment (do not re-survey; "
        "do not implement the product through MCP):"
    )
    env, gaps = load_environment(run_dir)
    if gaps or not isinstance(env, dict):
        for g in gaps or ["environment.md missing or invalid"]:
            print(g)
        return
    mc = env.get("mcp_considered")
    print(f"mcp-considered: {mc if isinstance(mc, str) and mc.strip() else '(none)'}")
    print(f"tools: {_join_env_list(env.get('tools'))}")
    print(f"mcp: {_join_env_list(env.get('mcp'))}")
    print(f"See: {(run_dir / 'environment.md').resolve()}")


def print_progress(
    run_dir: Path, state: Dict[str, Any], *, prior_running: Optional[Set[str]] = None
) -> None:
    """Verbose begin / finish / worktree progression. Not a new SM phase."""
    phase = str(state.get("phase"))
    print("## Progress")
    print_host_worktree_flag()
    print(f"Session phase: {phase} — {activity_title(phase, state)}.")
    repo = repo_of(state)
    repo_s = str(repo.resolve()) if repo.exists() else str(repo)
    if phase != "implement":
        print(f"Beginning this phase: {phase_begin_text(phase, state)}")
        print(f"Finish this phase: {phase_finish_text(phase, state)}")
        if phase not in ("done", "halted", "blocked"):
            dest = forward_dest(state, run_dir)
            if dest:
                print(f"After it finishes: dest {dest} — {activity_title(dest, state)}.")
        if phase in ("intake", "validate-spec", "plan", "residual"):
            print(f"Work in the session checkout (no per-step worktree yet): {repo_s}")
            print(f"Run dir: {run_dir.resolve()}")
        if phase == "blocked":
            print(f"blocked_from: {diag_text(state.get('blocked_from'))}")
            print(f"resume_to: {diag_text(state.get('resume_to'))}")
            print(f"ask_user: {diag_text(state.get('ask_user') or state.get('blocked_reason'))}")
        return
    if steps_drained(run_dir, state):
        print("Beginning this phase: all DAG steps are done (drained).")
        print("Finish this phase: invoke /shiploop complete (does not auto-dest residual).")
        print(f"After it finishes: dest residual — {activity_title('residual', state)}.")
        print(f"Session checkout: {repo_s}")
        print(f"Run dir: {run_dir.resolve()}")
        return
    classes = classify_steps(run_dir, state)
    by_id = steps_by_id(run_dir)
    ids = recomputed_step_ids(run_dir)
    done = [sid for sid in ids if classes.get(sid) == "done"]
    running = [sid for sid in ids if classes.get(sid) == "running"]
    ready = [sid for sid in ids if classes.get(sid) == "ready"]
    waiting = [sid for sid in ids if classes.get(sid) == "todo"]
    total = len(ids) or 0
    print(
        f"Walk: {len(done)}/{total} steps done, {len(running)} running, "
        f"{len(ready)} ready, {len(waiting)} waiting."
    )
    print(f"Session checkout (merge target — do not edit during a /goal): {repo_s}")
    print(f"Run dir: {run_dir.resolve()}")
    already = prior_running or set()
    for sid in ids:
        if classes.get(sid) != "running":
            continue
        step = by_id.get(sid) or {}
        stmt = diag_text(step.get("statement"))
        texts = produces_texts(step.get("produces")) or []
        produces = diag_text("; ".join(texts)) if texts else "(none)"
        rec = load_receipt(run_dir, sid)
        wt, br = isolation_for(state, sid, rec)
        kind = "Continuing" if sid in already else "Beginning"
        print(f"{kind} step {sid} of {total} — {stmt}.")
        print(f"  This step does: make true: {produces}.")
        need = _diag_supplier_suffix(step)
        if need:
            print(f"  {need}.")
        if wt:
            print(f"  Work in this worktree folder (cwd for /goal): {wt}")
        if br:
            print(f"  Branch: {br}")
        print(
            f"  Finish {_finish_label(run_dir, sid)} — when the /goal is done, commit on that worktree, "
            f"merge the branch into the session checkout "
            f"(git -C {repo_s} merge --no-ff --no-edit {br or '<branch>'}), "
            f"then invoke /shiploop complete."
        )
        print(
            f"  After {sid} finishes: the closer marks it done and claims newly "
            f"ready ids (or dest residual when the walk is drained)."
        )
    if ready:
        print("Ready next (not claimed yet):")
        for sid in ready:
            stmt = diag_text((by_id.get(sid) or {}).get("statement"))
            print(f"  {sid} — {stmt}")
    if waiting:
        print("Waiting on suppliers:")
        for sid in waiting:
            stmt = diag_text((by_id.get(sid) or {}).get("statement"))
            need = _diag_supplier_suffix(by_id.get(sid) or {})
            extra = f" ({need})" if need else ""
            print(f"  {sid} — {stmt}{extra}")


def interpolate(template: str, mapping: Dict[str, str]) -> str:
    out = template
    for key, val in mapping.items():
        out = out.replace("{{" + key + "}}", val)
    return out


def activity_body(phase: str, run_dir: Path, state: Dict[str, Any]) -> str:
    path = ACTIVITIES_DIR / f"{phase}.md"
    if phase == "implement" and steps_drained(run_dir, state):
        drain = ACTIVITIES_DIR / "implement-drained.md"
        if drain.is_file():
            path = drain
    elif phase == "residual" and plan_waiver(state):
        waived = ACTIVITIES_DIR / "residual-waived.md"
        if waived.is_file():
            path = waived
    if not path.is_file():
        return f"(no activity file for {phase})"
    mapping = {
        "RUN_DIR": str(run_dir.resolve()),
        "PROMPT_PATH": str(run_dir / "prompt.md"),
        "ENV_MD": str(run_dir / "environment.md"),
        "SPEC_MD": str(run_dir / "spec.md"),
        "PLAN_MD": str(run_dir / "plan.md"),
        "BACKCHAIN_JSON": str(canonical_backchain(run_dir)),
        "SHIPLOOP_BIN": str(PACKAGE_ROOT / "scripts" / "shiploop"),
        "DONE_SENTENCE": str((load_spec(run_dir)[0] or {}).get("done_sentence") or ""),
        "BOUND_PLAN": str(state.get("bound_plan") or ""),
        "LEDGER_PATH": str(Path(str(state.get("repo_root") or run_dir.parent)) / "REVIEW_CONVERGE.md"),
        "ASK_USER": str(state.get("ask_user") or ""),
        "BLOCKED_FROM": str(state.get("blocked_from") or ""),
        "BLOCKED_REASON": str(state.get("blocked_reason") or ""),
        "RESUME_TO": str(state.get("resume_to") or "validate-spec"),
        "REPO_ROOT": str(state.get("repo_root") or ""),
        "SURVEY_GUIDE": str(REF_DIR / "survey.md"),
        "STATE_FILES": str(REF_DIR / "state-files.md"),
        "IMPLEMENT_ACTIVITY": str(ACTIVITIES_DIR / "implement.md"),
        "RECAP_HTML": str(run_dir / "recap.html"),
    }
    return interpolate(path.read_text(encoding="utf-8"), mapping).rstrip()


def map_line(phase: str, state: Dict[str, Any], run_dir: Path) -> str:
    cur = str(state.get("phase"))
    if cur == "blocked" and phase == "blocked":
        return f"{phase}: current — {state.get('blocked_reason') or 'blocked'}"
    if cur == "halted" and phase == "done":
        return "done: skipped — session halted"
    if cur == "blocked":
        if phase == str(state.get("blocked_from")):
            return f"{phase}: blocked"
        order = {p: i for i, p in enumerate(MAP_PHASES)}
        bf = str(state.get("blocked_from") or "intake")
        if phase in order and bf in order and order[phase] < order[bf]:
            extra = " — frozen" if phase == "validate-spec" and state.get("spec_sha256") else ""
            return f"{phase}: done{extra}"
        if phase in order and bf in order and order[phase] > order[bf]:
            return f"{phase}: todo"
    if phase == cur:
        extra = ""
        if phase == "validate-spec" and (run_dir / "spec.md").is_file():
            spec, _ = load_spec(run_dir)
            extra = f" — checkable={_checkable_token(spec)}" if spec else ""
        return f"{phase}: current{extra}"
    order = {p: i for i, p in enumerate(MAP_PHASES)}
    if cur in ("done", "halted") and phase in order:
        if cur == "done":
            return f"{phase}: done" if phase != "done" else "done: current — success"
        return f"{phase}: done" if phase != "done" else "done: skipped"
    if cur in order and phase in order:
        if order[phase] < order[cur]:
            extra = ""
            if phase == "intake" and (run_dir / "prompt.md").is_file():
                extra = " — prompt recorded"
            if phase == "validate-spec" and (run_dir / "spec.md").is_file():
                spec, _ = load_spec(run_dir)
                extra = f" — checkable={_checkable_token(spec)}" if spec else ""
                if state.get("spec_sha256"):
                    extra = (extra + " — frozen") if extra else " — frozen"
            if phase == "plan" and (run_dir / "plan.md").is_file():
                extra = " — sequence plan written"
            return f"{phase}: done{extra}"
        return f"{phase}: todo"
    return f"{phase}: todo"


def _phase_status_word(line: str) -> str:
    if ": current" in line:
        return "current"
    if ": done" in line or ": skipped" in line:
        return "done"
    if ": blocked" in line:
        return "blocked"
    return "todo"


def _step_statement(run_dir: Path, sid: str) -> str:
    step = steps_by_id(run_dir).get(sid) or {}
    return (step.get("statement") or "").strip()


def _finish_label(run_dir: Path, sid: str) -> str:
    stmt = _step_statement(run_dir, sid)
    return f"{sid}: {stmt}" if stmt else f"{sid}:"


def _walk_waiting_on(
    step: Dict[str, Any], by_id: Dict[str, Dict[str, Any]], classes: Dict[str, str]
) -> str:
    waiting: List[str] = []
    for inp in step.get("inputs") or []:
        if not isinstance(inp, dict):
            continue
        fr = inp.get("from")
        if fr is None:
            continue
        dep = str(fr)
        if classes.get(dep) == "done":
            continue
        dep_step = by_id.get(dep) or {}
        stmt = (dep_step.get("statement") or "").strip()
        waiting.append(f"{dep} {stmt}".rstrip())
    return ", ".join(waiting)


def print_session_rail(run_dir: Path, state: Dict[str, Any]) -> None:
    marks = []
    for phase in MAP_PHASES:
        word = _phase_status_word(map_line(phase, state, run_dir))
        if word == "done":
            mark = "●"
        elif word == "current":
            mark = "▶"
        elif word == "blocked":
            mark = "✗"
        else:
            mark = "○"
        marks.append(f"{mark} {phase}")
    print("Session  " + "  ".join(marks))


def print_walk_rail(run_dir: Path, state: Dict[str, Any]) -> None:
    ids = recomputed_step_ids(run_dir)
    if not ids:
        return
    by_id = steps_by_id(run_dir)
    classes = classify_steps(run_dir, state)
    n_done = sum(1 for sid in ids if classes.get(sid) == "done")
    n_run = sum(1 for sid in ids if classes.get(sid) == "running")
    n_ready = sum(1 for sid in ids if classes.get(sid) == "ready")
    n_wait = sum(1 for sid in ids if classes.get(sid) == "todo")
    print(
        f"Walk  {n_done}/{len(ids)} done · {n_run} running · "
        f"{n_ready} ready · {n_wait} waiting"
    )
    for sid in ids:
        klass = classes.get(sid, "todo")
        step = by_id.get(sid) or {}
        mark = journal_mark(klass)
        stmt = (step.get("statement") or "").strip()
        line = f"  {mark} {sid}  {stmt}  {sid}: {klass}".rstrip()
        if klass == "todo":
            waiting = _walk_waiting_on(step, by_id, classes)
            if waiting:
                line += f"  waiting on {waiting}"
        print(line)


def look_here_lines(run_dir: Path, state: Dict[str, Any], phase: str) -> List[str]:
    lines: List[str] = []

    def add(
        kind: str,
        path: Path,
        why: str,
        *,
        missing_ok: bool = False,
        why_missing: Optional[str] = None,
    ) -> None:
        if path.is_file():
            lines.append(f"{kind}  {path.resolve()}     {why}")
        elif missing_ok:
            extra = why_missing or "not written yet — create at this path"
            lines.append(f"{kind}  {path.resolve()}     {extra}")
        else:
            lines.append(f"{kind}  {path.resolve()}     {why} (missing)")

    deps = state.get("dep_roots") or {}
    act = ACTIVITIES_DIR / f"{phase}.md"
    if phase == "implement" and steps_drained(run_dir, state):
        drain = ACTIVITIES_DIR / "implement-drained.md"
        if drain.is_file():
            act = drain
    elif phase == "residual" and plan_waiver(state):
        waived = ACTIVITIES_DIR / "residual-waived.md"
        if waived.is_file():
            act = waived

    if phase == "intake":
        add("required", run_dir / "state.json", "session state")
        add("required", run_dir / "prompt.md", "original ask", missing_ok=True)
        add("required", act, "current activity")
    elif phase == "validate-spec":
        add("required", run_dir / "prompt.md", "original ask", missing_ok=True)
        env_p = run_dir / "environment.md"
        _env, env_gaps = load_environment(run_dir)
        if not env_p.is_file():
            add(
                "required",
                env_p,
                "1. survey — write this first (create)",
                missing_ok=True,
                why_missing="1. survey — write this first (create)",
            )
        elif env_gaps:
            add("required", env_p, "1. survey — " + "; ".join(env_gaps))
        else:
            add("required", env_p, "1. survey — written")
        add("required", REF_DIR / "survey.md", "survey guide")
        spec_p = run_dir / "spec.md"
        _spec, spec_gaps = load_spec(run_dir)
        if not spec_p.is_file():
            add(
                "required",
                spec_p,
                "2. spec — write after environment.md (create)",
                missing_ok=True,
                why_missing="2. spec — write after environment.md (create)",
            )
        elif spec_gaps:
            add("required", spec_p, "2. spec — " + "; ".join(spec_gaps))
        else:
            add("required", spec_p, "2. spec — written")
        add("required", run_dir / "state.json", "session state")
    elif phase == "plan":
        add("required", run_dir / "spec.md", "frozen spec — do not rewrite")
        add("required", run_dir / "environment.md", "frozen survey")
        add("required", canonical_backchain(run_dir), "canonical backchain DAG (create)", missing_ok=True)
        spec, _ = load_spec(run_dir)
        plan_p = run_dir / "plan.md"
        if not plan_p.is_file():
            add(
                "required",
                plan_p,
                "sequence plan pointer",
                missing_ok=True,
                why_missing="write labeled done_sentence equal to spec (create)",
            )
        else:
            pg = wrapper_pair(run_dir, spec)
            if pg:
                add("required", plan_p, "; ".join(pg))
            else:
                add("required", plan_p, "sequence plan pointer")
        if deps.get("backchain"):
            add("required", Path(deps["backchain"]) / "SKILL.md", "backchain sequence plan")
    elif phase == "implement":
        add("required", run_dir / "spec.md", "frozen spec — do not rewrite")
        add("required", canonical_backchain(run_dir), "canonical backchain DAG")
        add("required", run_dir / "environment.md", "frozen survey")
        add("if-needed", run_dir / "plan.md", "sequence plan pointer")
        for sid in recomputed_step_ids(run_dir):
            if classify_steps(run_dir, state).get(sid) == "running":
                rec = load_receipt(run_dir, sid)
                add("required", receipt_path(run_dir, sid), f"{sid} running receipt")
                wt, _br = isolation_for(state, sid, rec)
                if wt:
                    stmt = _step_statement(run_dir, sid)
                    extra = f" — {stmt}" if stmt else ""
                    lines.append(f"required  {wt}     {sid} worktree — cwd here{extra}")
        drained = steps_drained(run_dir, state)
        add(
            "required",
            act,
            "current activity" if drained else "inject-step sidecar (not the stored prompt)",
        )
        add("if-needed", PACKAGE_ROOT / "scripts" / "shiploop", "harness CLI for inject-step")
        add(
            "if-needed",
            PACKAGE_ROOT / "commands" / "shiploop-inject.md",
            "inject-step card",
        )
    elif phase == "residual":
        waived = bool(plan_waiver(state))
        repo = repo_of(state)
        ledger = repo / "REVIEW_CONVERGE.md" if str(repo) else None
        if ledger:
            add(
                "if-needed" if waived else "required",
                ledger,
                "residual ledger (waived)" if waived else "residual ledger",
            )
        bound = str(state.get("bound_plan") or "")
        if bound:
            add("required", Path(bound), "bound plan (residual contract)")
        add("required", run_dir / "spec.md", "frozen spec")
        add("required", act, "current activity")
        if deps.get("review-coverage") and not waived:
            add("required", Path(deps["review-coverage"]) / "SKILL.md", "review-coverage Phase B")
        add(
            "required",
            run_dir / "recap.html",
            "end-of-run walk-back (harness writes at dest done — do not hand-author)",
            missing_ok=True,
            why_missing=(
                "harness writes this at dest done — do not hand-author"
            ),
        )
    elif phase == "done":
        add("required", run_dir / "recap.html", "end-of-run walk-back")
        add("required", run_dir / "spec.md", "frozen spec")
    elif phase == "halted":
        add("required", run_dir / "recap.html", "end-of-run walk-back")
        add("required", run_dir / "spec.md", "frozen spec")
        repo = repo_of(state)
        if str(repo):
            add("if-needed", repo / "REVIEW_CONVERGE.md", "why this halted")
    elif phase == "blocked":
        add("required", run_dir / "state.json", "ask_user / reason / resume_to")
        add("required", act, "current activity")
    return lines


def print_packet(run_dir: Path, state: Dict[str, Any], *, prior_running: Optional[Set[str]] = None) -> None:
    phase = str(state.get("phase"))
    dest = forward_dest(state, run_dir)
    missing = missing_for(state, run_dir, dest)
    if dest == "blocked" and phase == "plan":
        spec, _ = load_spec(run_dir)
        for g in dag_gaps(run_dir, spec):
            if g not in missing:
                missing.append(g)
    if dest == "blocked" and phase == "validate-spec":
        pass
    elif dest and legal_edge(phase, dest) == "reason" and dest == "blocked":
        if not (state.get("ask_user") or state.get("blocked_reason")):
            missing = list(missing) + ["--reason required"]
    prompt_txt = (read_text(run_dir / "prompt.md") or str(state.get("prompt") or "")).strip()
    ask_line = prompt_txt.splitlines()[0] if prompt_txt else "(no prompt yet)"
    spec, _ = load_spec(run_dir)
    print("shiploop — session harness")
    print("## You are here")
    print_session_rail(run_dir, state)
    for p in MAP_PHASES:
        print(map_line(p, state, run_dir))
    if phase == "blocked":
        print(map_line("blocked", state, run_dir))
    if phase == "halted":
        print("halted: current — residual stopped")
    if phase == "implement":
        print_walk_rail(run_dir, state)
    print()
    print_diagnosis(run_dir, state)
    print()
    print_progress(run_dir, state, prior_running=prior_running)
    print()
    print("## Reminder")
    print(f"Ask: {ask_line}")
    if spec and spec.get("done_sentence"):
        print(f"done_sentence: {spec['done_sentence']}")
        token = _checkable_token(spec)
        if token:
            print(f"checkable={token}")
        if state.get("spec_sha256") and phase != "validate-spec":
            print("spec: frozen")
    doing = activity_title(phase, state)
    if phase == "implement" and steps_drained(run_dir, state):
        doing = "steps drained — enter residual"
    print(f"You are doing {phase}: {doing}.")
    print()
    print("## Look here")
    print("Reference only — not the next action.")
    for line in look_here_lines(run_dir, state, phase):
        print(line)
    print()
    print("## Next prompt")
    print("Use this prompt as much as possible.")
    drained = phase == "implement" and steps_drained(run_dir, state)
    if phase == "implement" and not drained:
        classes = classify_steps(run_dir, state)
        by_id = steps_by_id(run_dir)
        already = prior_running or set()
        for sid in recomputed_step_ids(run_dir):
            if classes.get(sid) != "running":
                continue
            step = by_id.get(sid) or {"id": sid, "statement": "", "prompt": ""}
            prefix = "In flight — do not open a second /goal. " if sid in already else ""
            rec = load_receipt(run_dir, sid)
            wt, br = isolation_for(state, sid, rec)
            print(f"{prefix}Step `{sid}` — `{step.get('statement') or ''}`.")
            if wt:
                print(f"Work in this worktree folder: {wt}")
            if br:
                print(f"Branch: {br}")
            print("Do not edit the session checkout during this /goal.")
            print_host_worktree_flag()
            print_frozen_session_env(run_dir)
            print(str(step.get("prompt") or "").rstrip())
    else:
        print(activity_body(phase, run_dir, state))
    print()
    print("## When done invoke")
    if phase in ("done", "halted"):
        print("stop — no update")
    elif phase == "implement" and not drained:
        classes = classify_steps(run_dir, state)
        running = [sid for sid, k in classes.items() if k == "running"]
        repo = repo_of(state)
        repo_s = str(repo.resolve()) if repo.exists() else str(repo)
        for sid in running:
            rec = load_receipt(run_dir, sid)
            _wt, br = isolation_for(state, sid, rec)
            print(f"Finish {_finish_label(run_dir, sid)} — after /goal succeeds, commit on the worktree")
            if br:
                print(
                    f"then merge that branch into the session checkout: "
                    f"git -C {repo_s} merge --no-ff --no-edit {br}"
                )
            print("then invoke /shiploop complete (marks this step done and claims the next)")
        print("on /goal failure: invoke /shiploop complete --clear")
        print("hard stop: invoke /shiploop complete --blocked --reason <text>")
    elif dest:
        if phase == "blocked":
            resume = str(state.get("resume_to") or "").strip()
            print("invoke /shiploop complete --reason <answer>")
            if resume:
                print(f"(resumes to {resume})")
        elif dest == "blocked":
            print("invoke /shiploop complete --blocked --reason <text>")
        else:
            print("invoke /shiploop complete")
    else:
        print("stop — no update")
    print()
    print("## Missing")
    if missing:
        for g in missing:
            print(g)
    else:
        print("(none)")


def force_wipe(run_dir: Path) -> None:
    for name in (
        "environment.md",
        "environment.json",
        "spec.md",
        "spec.json",
        "plan.md",
        "plan.json",
        "implement.json",
        "recap.html",
    ):
        p = run_dir / name
        if p.is_file() or p.is_symlink():
            p.unlink()
    for dname in ("backchain", "steps"):
        d = run_dir / dname
        if d.is_dir():
            shutil.rmtree(d)


def init_run_dir(args: argparse.Namespace) -> Path:
    if args.run_dir:
        return run_dir_from_arg(args.run_dir, walk=False)
    repo = (args.repo or "").strip()
    if repo:
        return Path(repo).expanduser().resolve() / ".shiploop"
    return Path.cwd() / ".shiploop"


def cmd_init(args: argparse.Namespace) -> int:
    if args.implementer != "host":
        die(EXIT_BLOCKED, "--implementer must be host")
    if args.force and not (args.prompt or "").strip():
        die(EXIT_BLOCKED, "--force requires a nonempty --prompt")
    run_dir = init_run_dir(args)
    refuse_package_path(run_dir)
    state_path = run_dir / "state.json"
    if state_path.is_file() and not args.force:
        print(f"reused {state_path}")
        print_packet(run_dir, load_state(run_dir))
        return EXIT_OK
    prompt = args.prompt or ""
    bound = str(Path(args.bound_plan).expanduser().resolve()) if args.bound_plan else ""
    repo = str(Path(args.repo).expanduser().resolve()) if args.repo else str(Path.cwd().resolve())
    with run_lock(run_dir):
        if args.force:
            if state_path.is_file() and not state_path.is_symlink():
                old = load_json(state_path)
                if isinstance(old, dict):
                    wipe_run_worktrees(repo_of(old), str(old.get("run_id") or ""))
            force_wipe(run_dir)
        run_dir.mkdir(parents=True, exist_ok=True)
        if prompt:
            (run_dir / "prompt.md").write_text(prompt.rstrip() + "\n", encoding="utf-8")
        state = default_state(
            run_dir, prompt=prompt, implementer="host", bound_plan=bound, repo=repo
        )
        save_state(run_dir, state, event="init")
    print(f"initialized {run_dir / 'state.json'}")
    print_packet(run_dir, state)
    return EXIT_OK


def cmd_next(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=True)
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        check_frozen_hashes(state, run_dir, None)
        prior = set()
        if str(state.get("phase")) == "implement":
            prior = {sid for sid, k in classify_steps(run_dir, state).items() if k == "running"}
            claimed = claim_ready(run_dir, state)
            if claimed:
                save_state(run_dir, state, event="next:claim")
            else:
                save_state(run_dir, state, event="next")
        else:
            save_state(run_dir, state, event="next")
        print_packet(run_dir, state, prior_running=prior)
    return EXIT_OK


def cmd_status(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=True)
    state = load_state(run_dir)
    state["dep_roots"] = resolve_dep_roots()
    dest = forward_dest(state, run_dir)
    allowed = [
        e["to"]
        for e in load_transitions()["edges"]
        if e.get("from") == state.get("phase")
    ]
    if getattr(args, "human", False):
        print("shiploop — session harness")
        print("## You are here")
        print_session_rail(run_dir, state)
        for p in MAP_PHASES:
            print(map_line(p, state, run_dir))
        if str(state.get("phase")) == "implement":
            print_walk_rail(run_dir, state)
        print()
        print_diagnosis(run_dir, state)
        return EXIT_OK
    print(
        json.dumps(
            {
                "phase": state.get("phase"),
                "implementer": state.get("implementer"),
                "run_id": state.get("run_id"),
                "attempt": state.get("attempt"),
                "terminal": state.get("terminal"),
                "allowed": allowed,
                "forward": dest,
                "dep_roots": state.get("dep_roots"),
                "artifacts": state.get("artifacts"),
            },
            indent=2,
            sort_keys=True,
        )
    )
    return EXIT_OK


def apply_update(
    run_dir: Path,
    state: Dict[str, Any],
    dest: str,
    *,
    reason: str = "",
    resume_to: str = "",
) -> str:
    if dest not in PHASES:
        die(EXIT_USAGE, f"unknown --to {dest}")
    src = str(state.get("phase"))
    need = legal_edge(src, dest)
    if need is None:
        die(EXIT_BLOCKED, f"illegal transition {src} -> {dest}")
    if src == "blocked" and dest != state.get("resume_to"):
        die(EXIT_BLOCKED, f"blocked may only resume to {state.get('resume_to')}")
    if dest == "residual":
        maybe_bind_residual_plan(state, run_dir)
    check_frozen_hashes(state, run_dir, dest)
    if dest in ("done", "halted") and not residual_gaps(state, dest):
        write_recap_html(run_dir, state, dest=dest)
    gaps = missing_for(state, run_dir, dest)
    if dest in ("done", "halted"):
        for g in recap_gaps(run_dir):
            if g not in gaps:
                gaps.append(g)
    if dest == "blocked":
        resume = (resume_to or "").strip()
        if not resume:
            resume = "validate-spec" if src == "validate-spec" else ""
        if resume not in RESUME_PHASES:
            gaps.append("--resume-to required (validate-spec|plan|implement|residual)")
        spec, _ = load_spec(run_dir)
        why = (reason or "").strip() or (spec or {}).get("ask_user")
        if not (isinstance(why, str) and why.strip()):
            gaps.append("--reason or ask_user required")
    elif need == "reason":
        if not (reason or "").strip():
            gaps.append("--reason required")
    if gaps:
        die(EXIT_BLOCKED, "; ".join(gaps))
    if dest == "validate-spec":
        text = (read_text(run_dir / "prompt.md") or "").strip()
        state["prompt"] = text
        if src == "blocked":
            state["environment_sha256"] = ""
            state["spec_sha256"] = ""
            state["plan_sha256"] = ""
            clear_steps(run_dir, state)
    if dest == "plan":
        spec, sg = load_spec(run_dir)
        if sg:
            die(EXIT_BLOCKED, "; ".join(sg))
        env, eg = load_environment(run_dir)
        if eg:
            die(EXIT_BLOCKED, "; ".join(eg))
        if spec.get("checkable") is not True:
            die(EXIT_BLOCKED, "spec.md checkable is not true")
        hgaps = handles_block_plan(env)
        if hgaps:
            die(EXIT_BLOCKED, "; ".join(hgaps))
        bind_or_verify_hash(state, "spec_sha256", spec_sha256_of(run_dir))
        bind_or_verify_hash(state, "environment_sha256", environment_sha256_of(run_dir))
        state["plan_sha256"] = ""
        clear_steps(run_dir, state)
    if dest == "implement":
        spec, _ = load_spec(run_dir)
        more = wrapper_pair(run_dir, spec)
        more.extend(dag_gaps(run_dir, spec))
        if more:
            die(EXIT_BLOCKED, "; ".join(more))
        state["plan_sha256"] = plan_hash_of(run_dir)
        if src == "blocked":
            clear_steps(run_dir, state, running_only=True)
    if dest == "blocked":
        spec, _ = load_spec(run_dir)
        state["blocked_from"] = src
        state["blocked_reason"] = (reason or "").strip() or (spec or {}).get("ask_user")
        state["ask_user"] = (spec or {}).get("ask_user") or reason
        state["resume_to"] = (resume_to or "").strip() or (
            "validate-spec" if src == "validate-spec" else src
        )
        state["terminal"] = None
    elif src == "blocked":
        state["blocked_reason"] = reason
        state["blocked_from"] = None
        state["ask_user"] = None
        state["resume_to"] = None
    if dest == "done":
        state["terminal"] = "waived" if plan_waiver(state) else "success"
    if dest == "halted":
        state["terminal"] = "halted"
    state["phase"] = dest
    save_state(run_dir, state, event=f"update:{src}->{dest}")
    if dest in ("done", "halted"):
        write_recap_html(run_dir, state, dest=dest)
    return dest


def claim_and_print(run_dir: Path, state: Dict[str, Any], *, prior: Optional[Set[str]] = None) -> None:
    shown = prior
    if str(state.get("phase")) == "implement":
        if shown is None:
            shown = {sid for sid, k in classify_steps(run_dir, state).items() if k == "running"}
        claimed = claim_ready(run_dir, state)
        if claimed:
            save_state(run_dir, state, event="next:claim")
    print_packet(run_dir, state, prior_running=shown)


def cmd_update(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=True)
    refuse_package_path(run_dir)
    dest = args.to
    if dest not in PHASES:
        die(EXIT_USAGE, f"unknown --to {dest}")
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        src = str(state.get("phase"))
        apply_update(
            run_dir,
            state,
            dest,
            reason=args.reason or "",
            resume_to=args.resume_to or "",
        )
        print(f"updated {src} -> {dest}")
        claim_and_print(run_dir, state, prior=set())
    return EXIT_OK


def cmd_start_step(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=True)
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        refuse_if_blocked_step_cmd(state)
        check_frozen_hashes(state, run_dir, None)
        sid = args.id
        if sid not in steps_by_id(run_dir):
            die(EXIT_BLOCKED, f"unknown step id {sid}")
        plan_hash = str(state.get("plan_sha256") or "")
        rec = load_receipt(run_dir, sid)
        if receipt_matches(rec, plan_hash, "running"):
            die(EXIT_BLOCKED, f"{sid} already running")
        if receipt_matches(rec, plan_hash, "complete"):
            die(EXIT_BLOCKED, f"{sid} already complete")
        step = steps_by_id(run_dir)[sid]
        if not suppliers_complete(step, run_dir, plan_hash):
            die(EXIT_BLOCKED, f"{sid} suppliers not complete")
        write_running_receipt(run_dir, state, sid)
        save_state(run_dir, state, event=f"start-step:{sid}")
    print(f"started {args.id}")
    return EXIT_OK


def cmd_complete_step(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=True)
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        sid = resolve_step_id(run_dir, state, getattr(args, "id", None))
        apply_complete_receipt(run_dir, state, sid)
    print(f"completed {sid}")
    return EXIT_OK


def cmd_complete(args: argparse.Namespace) -> int:
    if args.clear and args.blocked:
        die(EXIT_USAGE, "complete: use only one of --clear or --blocked")
    run_dir = run_dir_from_arg(args.run_dir, walk=True)
    refuse_package_path(run_dir)
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        explicit = getattr(args, "id", None)
        prior: Set[str] = set()
        if str(state.get("phase")) == "implement":
            prior = {
                sid for sid, k in classify_steps(run_dir, state).items() if k == "running"
            }
        if args.blocked:
            src = str(state.get("phase"))
            if src == "blocked":
                die(
                    EXIT_BLOCKED,
                    "already blocked; resume with /shiploop complete --reason <answer>",
                )
            resume = (args.resume_to or "").strip()
            if not resume:
                if src in RESUME_PHASES:
                    resume = src
            apply_update(
                run_dir,
                state,
                "blocked",
                reason=args.reason or "",
                resume_to=resume,
            )
            print("updated -> blocked")
            print_packet(run_dir, state)
            return EXIT_OK
        if args.clear:
            sid = resolve_step_id(run_dir, state, explicit)
            apply_clear_receipt(run_dir, state, sid)
            print(f"cleared {sid}")
            claim_and_print(run_dir, state, prior=prior - {sid})
            return EXIT_OK
        phase = str(state.get("phase"))
        if phase == "implement":
            can_complete = bool(explicit) or bool(running_ids(run_dir, state)) or bool(
                cwd_running_id(run_dir, state)
            )
            if can_complete:
                sid = resolve_step_id(run_dir, state, explicit)
                apply_complete_receipt(run_dir, state, sid)
                print(f"completed {sid}")
                claim_and_print(run_dir, state, prior=prior - {sid})
                return EXIT_OK
            if steps_drained(run_dir, state):
                apply_update(run_dir, state, "residual")
                print("updated implement -> residual")
                print_packet(run_dir, state)
                return EXIT_OK
            die(EXIT_BLOCKED, "no running step to complete")
        dest = forward_dest(state, run_dir)
        if not dest:
            die(EXIT_BLOCKED, "no forward transition")
        apply_update(
            run_dir,
            state,
            dest,
            reason=args.reason or "",
            resume_to=args.resume_to or "",
        )
        print(f"updated -> {dest}")
        claim_and_print(run_dir, state, prior=set())
    return EXIT_OK


def cmd_clear_step(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=True)
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        sid = resolve_step_id(run_dir, state, getattr(args, "id", None))
        apply_clear_receipt(run_dir, state, sid)
    print(f"cleared {sid}")
    return EXIT_OK


def cmd_capture(args: argparse.Namespace) -> int:
    die(EXIT_BLOCKED, "capture is not a host-session gate")
    return EXIT_BLOCKED


def cmd_inject_step(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=True)
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        phase = str(state.get("phase"))
        if phase != "implement":
            die(EXIT_BLOCKED, "inject-step requires phase implement")
        dag_path = canonical_backchain(run_dir)
        stored_hash = str(state.get("plan_sha256") or "")
        cur_hash = plan_hash_of(run_dir)
        if not stored_hash or cur_hash != stored_hash:
            die(EXIT_BLOCKED, "plan hash drift; inject-step refused (hand-edit is not an inject)")
        data = load_dag(run_dir)
        if data is None:
            die(EXIT_BLOCKED, "missing backchain/plan.json")
        steps = data.get("steps")
        if not isinstance(steps, list):
            die(EXIT_BLOCKED, "backchain steps must be a list")
        existing_ids = {s.get("id") for s in steps if isinstance(s, dict)}

        statement = (args.statement or "").strip()
        if not statement:
            die(EXIT_BLOCKED, "--statement required")
        if CONTROL_RE.search(statement) or has_disallowed_slash(statement):
            die(EXIT_BLOCKED, "--statement contains a newline, control, or disallowed slash skill")
        prompt = args.prompt or ""
        if not prompt.strip():
            die(EXIT_BLOCKED, "--prompt required")
        if PROMPT_CONTROL_RE.search(prompt) or has_disallowed_slash(prompt):
            die(EXIT_BLOCKED, "--prompt contains a disallowed control character or slash skill")
        produces = (args.produces or "").strip()
        if not produces:
            die(EXIT_BLOCKED, "--produces required")
        if CONTROL_RE.search(produces) or has_disallowed_slash(produces):
            die(EXIT_BLOCKED, "--produces contains a newline, control, or disallowed slash skill")

        sid = (args.id or "").strip()
        if not sid:
            nums = []
            for s in steps:
                if isinstance(s, dict):
                    m = re.match(r"^S([0-9]+)$", str(s.get("id") or ""))
                    if m:
                        nums.append(int(m.group(1)))
            sid = f"S{(max(nums) + 1) if nums else 1}"
        if not STEP_ID_RE.fullmatch(sid) or ".." in sid or "/" in sid:
            die(EXIT_BLOCKED, f"unsafe step id {sid}")
        if sid in existing_ids:
            die(EXIT_BLOCKED, f"step id {sid} already exists")

        need = (args.need or "").strip()
        frm = (args.from_id or "").strip()
        inputs: List[Dict[str, Any]] = []
        if need:
            initial = data.get("initial_state") or []
            if frm:
                if frm not in existing_ids:
                    die(EXIT_BLOCKED, f"--from {frm} is not an existing step id")
                inputs = [{"need": need, "from": frm}]
            else:
                if need not in initial:
                    die(EXIT_BLOCKED, f"--need {need} not in initial_state; supply --from")
                inputs = [{"need": need, "from": None}]

        classes_before = classify_steps(run_dir, state)
        befores = list(args.before or [])
        for bid in befores:
            if bid not in existing_ids:
                die(EXIT_BLOCKED, f"--before {bid} is not an existing step id")
            status = classes_before.get(bid)
            if status not in ("todo", "ready"):
                die(EXIT_BLOCKED, f"--before {bid} must be todo or ready (is {status})")

        new_step = {
            "id": sid,
            "statement": statement,
            "prompt": prompt,
            "produces": produces,
            "origin": "discovered",
            "inputs": inputs,
        }
        new_steps = [dict(s) if isinstance(s, dict) else s for s in steps] + [new_step]
        for bid in befores:
            for s in new_steps:
                if isinstance(s, dict) and s.get("id") == bid:
                    s_inputs = list(s.get("inputs") or [])
                    s_inputs.append({"need": produces, "from": sid})
                    s["inputs"] = s_inputs

        new_data = dict(data)
        new_data["steps"] = new_steps
        write_json_atomic(dag_path, new_data)
        spec, _ = load_spec(run_dir)
        gaps = dag_gaps(run_dir, spec)
        if gaps:
            write_json_atomic(dag_path, data)
            die(EXIT_BLOCKED, "; ".join(gaps))

        new_hash = plan_hash_of(run_dir)
        d = steps_dir(run_dir)
        if d.is_dir():
            for path in sorted(d.glob("*.json")):
                if path.is_symlink():
                    continue
                rec = load_json(path)
                if isinstance(rec, dict) and rec.get("plan_sha256") == stored_hash:
                    rec["plan_sha256"] = new_hash
                    write_json_atomic(path, rec)
        state["plan_sha256"] = new_hash
        save_state(run_dir, state, event=f"inject-step:{sid}")
    print(f"injected {sid}")
    return EXIT_OK


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="shiploop", description="Session harness")
    sub = p.add_subparsers(dest="cmd", required=True)
    ini = sub.add_parser("init")
    ini.add_argument("--prompt", default="")
    ini.add_argument("--run-dir")
    ini.add_argument("--implementer", default="host")
    ini.add_argument("--force", action="store_true")
    ini.add_argument("--bound-plan", default="")
    ini.add_argument("--repo", default="")
    nxt = sub.add_parser("next")
    nxt.add_argument("--run-dir")
    st = sub.add_parser("status")
    st.add_argument("--run-dir")
    st.add_argument("--human", action="store_true")
    up = sub.add_parser("update")
    up.add_argument("--run-dir")
    up.add_argument("--to", required=True)
    up.add_argument("--reason", default="")
    up.add_argument("--resume-to", default="")
    ss = sub.add_parser("start-step")
    ss.add_argument("--run-dir")
    ss.add_argument("--id", required=True)
    for name in ("complete-step", "clear-step"):
        sp = sub.add_parser(name)
        sp.add_argument("--run-dir")
        sp.add_argument("--id")
    comp = sub.add_parser("complete")
    comp.add_argument("--run-dir")
    comp.add_argument("--id")
    comp.add_argument("--clear", action="store_true")
    comp.add_argument("--blocked", action="store_true")
    comp.add_argument("--reason", default="")
    comp.add_argument("--resume-to", default="")
    cap = sub.add_parser("capture")
    cap.add_argument("--run-dir", required=True)
    cap.add_argument("argv", nargs=argparse.REMAINDER)
    inj = sub.add_parser("inject-step")
    inj.add_argument("--run-dir")
    inj.add_argument("--statement", required=True)
    inj.add_argument("--prompt", required=True)
    inj.add_argument("--produces", required=True)
    inj.add_argument("--id", default="")
    inj.add_argument("--need", default="")
    inj.add_argument("--from", dest="from_id", default="")
    inj.add_argument("--before", action="append", default=[])
    return p


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    p = build_parser()
    try:
        args = p.parse_args(argv)
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else EXIT_USAGE
        return code if code else EXIT_OK
    try:
        if args.cmd == "init":
            return cmd_init(args)
        if args.cmd == "next":
            return cmd_next(args)
        if args.cmd == "status":
            return cmd_status(args)
        if args.cmd == "update":
            return cmd_update(args)
        if args.cmd == "start-step":
            return cmd_start_step(args)
        if args.cmd == "complete-step":
            return cmd_complete_step(args)
        if args.cmd == "complete":
            return cmd_complete(args)
        if args.cmd == "clear-step":
            return cmd_clear_step(args)
        if args.cmd == "capture":
            return cmd_capture(args)
        if args.cmd == "inject-step":
            return cmd_inject_step(args)
    except BrokenPipeError:
        return EXIT_OK
    return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main())
