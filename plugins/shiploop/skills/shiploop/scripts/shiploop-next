#!/usr/bin/env python3
"""shiploop-next — reprint the packet via same-leaf shiploop next."""
from __future__ import annotations

import os
import sys
from pathlib import Path
from typing import List, Optional

EXIT_BLOCKED = 2
EXIT_USAGE = 64
PACKAGE_ROOT = Path(__file__).resolve().parents[1]
REFUSED = {
    "update",
    "complete",
    "complete-step",
    "start-step",
    "clear-step",
    "init",
}


def die(code: int, msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in REFUSED:
        die(EXIT_BLOCKED, f"shiploop next refuses {argv[0]}")
    if argv and argv[0] == "next":
        argv = argv[1:]
    harness = PACKAGE_ROOT / "scripts" / "shiploop"
    if not harness.is_file():
        die(EXIT_BLOCKED, "missing same-leaf scripts/shiploop")
    print("shiploop next — reprint the packet", flush=True)
    os.execv(sys.executable, [sys.executable, str(harness), "next", *argv])
    return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main())
