#!/usr/bin/env python3
"""DevLoop native gates — freeze / prove / stop / doctor / self-check.

Exit codes:
  0  success / green
  1  verifiers ran and failed
  2  blocked (drift, missing exec, never_red, redefine, unavailable)
  64 usage / malformed input

No model calls. No peer harness transport. Package-root writes refused.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

EXIT_OK = 0
EXIT_FAIL = 1
EXIT_BLOCKED = 2
EXIT_USAGE = 64

PACKAGE_ROOT = Path(__file__).resolve().parents[1]
VERSION = "0.1.0"


def die(code: int, msg: str, *, reason: str | None = None, extra: dict | None = None) -> None:
    payload: dict[str, Any] = {"ok": False, "error": msg}
    if reason:
        payload["reason"] = reason
    if extra:
        payload.update(extra)
    print(json.dumps(payload, indent=2), file=sys.stderr)
    raise SystemExit(code)


def out_json(obj: dict) -> None:
    print(json.dumps(obj, indent=2, sort_keys=True))


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def canonical_json(obj: Any) -> str:
    return json.dumps(obj, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        die(EXIT_USAGE, f"cannot parse JSON: {path}: {exc}")


def resolve_repo(repo: Path) -> Path:
    try:
        r = repo.resolve()
    except Exception as exc:
        die(EXIT_USAGE, f"invalid --repo: {exc}")
    if not r.is_dir():
        die(EXIT_USAGE, f"--repo is not a directory: {r}")
    # Refuse writing into the skill package
    try:
        r.relative_to(PACKAGE_ROOT)
        die(EXIT_BLOCKED, "refusing to use skill package root as --repo", reason="package_root_write")
    except ValueError:
        pass
    return r


def ensure_not_package_path(path: Path) -> None:
    try:
        path.resolve().relative_to(PACKAGE_ROOT)
        die(EXIT_BLOCKED, f"refusing path inside skill package: {path}", reason="package_root_write")
    except ValueError:
        return


def validate_charter(raw: dict) -> dict:
    if not isinstance(raw, dict):
        die(EXIT_USAGE, "charter must be a JSON object")
    criteria = raw.get("criteria")
    if not isinstance(criteria, list) or not criteria:
        die(EXIT_USAGE, "charter.criteria must be a non-empty list")
    seen: set[str] = set()
    out_crit = []
    for i, c in enumerate(criteria):
        if not isinstance(c, dict):
            die(EXIT_USAGE, f"criteria[{i}] must be an object")
        cid = c.get("id")
        if not isinstance(cid, str) or not cid.strip():
            die(EXIT_USAGE, f"criteria[{i}].id required")
        if cid in seen:
            die(EXIT_USAGE, f"duplicate criterion id: {cid}")
        seen.add(cid)
        role = c.get("role", "change")
        if role not in ("change", "regression"):
            die(EXIT_USAGE, f"criteria[{i}].role must be change|regression")
        outcome = c.get("outcome")
        if not isinstance(outcome, str) or not outcome.strip():
            die(EXIT_USAGE, f"criteria[{i}].outcome required")
        ver = c.get("verifier")
        if not isinstance(ver, dict):
            die(EXIT_USAGE, f"criteria[{i}].verifier required object")
        argv = ver.get("argv")
        if not isinstance(argv, list) or not argv or not all(isinstance(x, str) for x in argv):
            die(EXIT_USAGE, f"criteria[{i}].verifier.argv must be non-empty string array")
        # Reject shell -c / -lc wrappers (basename so /bin/bash is caught too)
        shell_names = {"bash", "sh", "zsh", "dash", "ksh"}
        argv0_base = Path(argv[0]).name
        if argv0_base in shell_names and len(argv) >= 2:
            for a in argv[1:]:
                if a in ("-c", "-lc", "-cl"):
                    die(
                        EXIT_USAGE,
                        f"criteria[{i}]: shell -c/-lc forbidden; use repo script + guard_paths",
                    )
                # combined short flags that include c (e.g. -ec) — treat as -c
                if a.startswith("-") and not a.startswith("--") and "c" in a[1:]:
                    die(
                        EXIT_USAGE,
                        f"criteria[{i}]: shell -c/-lc forbidden; use repo script + guard_paths",
                    )
        cwd = ver.get("cwd", ".")
        if not isinstance(cwd, str):
            die(EXIT_USAGE, f"criteria[{i}].verifier.cwd must be string")
        expected = ver.get("expected_exit", 0)
        if not isinstance(expected, int):
            die(EXIT_USAGE, f"criteria[{i}].verifier.expected_exit must be int")
        timeout = ver.get("timeout_seconds", 60)
        if not isinstance(timeout, (int, float)) or timeout <= 0:
            die(EXIT_USAGE, f"criteria[{i}].verifier.timeout_seconds must be positive")
        guards = ver.get("guard_paths") or []
        if not isinstance(guards, list) or not all(isinstance(g, str) for g in guards):
            die(EXIT_USAGE, f"criteria[{i}].verifier.guard_paths must be string list")
        out_crit.append(
            {
                "id": cid,
                "role": role,
                "outcome": outcome,
                "verifier": {
                    "argv": list(argv),
                    "cwd": cwd,
                    "expected_exit": expected,
                    "timeout_seconds": int(timeout),
                    "guard_paths": list(guards),
                },
            }
        )
    goal = raw.get("goal", "")
    if not isinstance(goal, str):
        die(EXIT_USAGE, "goal must be string")
    return {
        "schema": "devloop-native/charter@1",
        "goal": goal,
        "criteria": out_crit,
    }


def digest_guards(repo: Path, criteria: list[dict]) -> dict[str, str]:
    digests: dict[str, str] = {}
    for c in criteria:
        for rel in c["verifier"]["guard_paths"]:
            p = (repo / rel).resolve()
            ensure_not_package_path(p)
            try:
                p.relative_to(repo.resolve())
            except ValueError:
                die(EXIT_USAGE, f"guard_path escapes repo: {rel}")
            if not p.is_file():
                die(EXIT_BLOCKED, f"guard_path missing: {rel}", reason="missing_guard")
            digests[rel] = sha256_file(p)
    return digests


def check_argv0(criteria: list[dict]) -> None:
    for c in criteria:
        exe = c["verifier"]["argv"][0]
        if os.path.isabs(exe) or "/" in exe or exe.startswith("./"):
            # path form — must exist relative to repo checked at run time
            continue
        if shutil.which(exe) is None:
            die(
                EXIT_BLOCKED,
                f"argv[0] not found on PATH at freeze: {exe} (criterion {c['id']})",
                reason="missing_executable",
            )


def cmd_self_check(_args: argparse.Namespace) -> None:
    out_json(
        {
            "ok": True,
            "package_root": str(PACKAGE_ROOT),
            "version": VERSION,
            "python": sys.version.split()[0],
            "mode": "native",
        }
    )


def cmd_freeze(args: argparse.Namespace) -> None:
    repo = resolve_repo(Path(args.repo))
    charter_in = Path(args.charter)
    if not charter_in.is_file():
        die(EXIT_USAGE, f"charter not found: {charter_in}")
    raw = load_json(charter_in)
    charter = validate_charter(raw)
    check_argv0(charter["criteria"])
    guards = digest_guards(repo, charter["criteria"])
    run_dir = Path(args.run_dir) if args.run_dir else repo / ".devloop-native" / "run"
    ensure_not_package_path(run_dir)
    try:
        run_dir.resolve().relative_to(repo.resolve())
    except ValueError:
        die(EXIT_USAGE, "--run-dir must be under --repo")
    run_dir.mkdir(parents=True, exist_ok=True)
    (run_dir / "logs").mkdir(exist_ok=True)

    frozen = {
        "schema": charter["schema"],
        "goal": charter["goal"],
        "repo": str(repo),
        "criteria": charter["criteria"],
        "guard_digests": guards,
        "frozen_at": now_iso(),
        "skill_version": VERSION,
        "mode": "native",
    }
    blob = canonical_json(frozen)
    digest = sha256_bytes(blob.encode("utf-8"))
    (run_dir / "charter.json").write_text(json.dumps(frozen, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    (run_dir / "charter.sha256").write_text(digest + "\n", encoding="utf-8")
    # reset prove state
    for name in ("prove.json", "stop.json", "receipt.json"):
        p = run_dir / name
        if p.exists():
            p.unlink()
    out_json({"ok": True, "run_dir": str(run_dir), "charter_sha256": digest, "mode": "native"})


def load_frozen(run_dir: Path) -> tuple[dict, str]:
    cpath = run_dir / "charter.json"
    hpath = run_dir / "charter.sha256"
    if not cpath.is_file() or not hpath.is_file():
        die(EXIT_BLOCKED, "missing frozen charter; run freeze first", reason="not_frozen")
    frozen = load_json(cpath)
    expected = hpath.read_text(encoding="utf-8").strip()
    actual = sha256_bytes(canonical_json(frozen).encode("utf-8"))
    if actual != expected:
        die(EXIT_BLOCKED, "charter.sha256 mismatch", reason="charter_drift")
    return frozen, expected


def verify_guards(repo: Path, frozen: dict) -> None:
    expected = frozen.get("guard_digests") or {}
    for rel, digest in expected.items():
        p = (repo / rel).resolve()
        if not p.is_file():
            die(EXIT_BLOCKED, f"guard missing after freeze: {rel}", reason="guard_drift")
        if sha256_file(p) != digest:
            die(EXIT_BLOCKED, f"guard content changed: {rel}", reason="guard_drift")


def run_one(repo: Path, criterion: dict, log_path: Path) -> dict:
    ver = criterion["verifier"]
    argv = ver["argv"]
    cwd = (repo / ver["cwd"]).resolve()
    try:
        cwd.relative_to(repo.resolve())
    except ValueError:
        die(EXIT_USAGE, f"cwd escapes repo: {ver['cwd']}")
    if not cwd.is_dir():
        die(EXIT_BLOCKED, f"cwd missing: {ver['cwd']}", reason="missing_cwd")
    # path-like argv0 relative to repo
    run_argv = list(argv)
    if run_argv[0].startswith("./") or (not os.path.isabs(run_argv[0]) and "/" in run_argv[0]):
        cand = (repo / run_argv[0]).resolve()
        if not cand.exists():
            die(EXIT_BLOCKED, f"executable missing: {run_argv[0]}", reason="missing_executable")
        run_argv[0] = str(cand)
    elif not os.path.isabs(run_argv[0]) and shutil.which(run_argv[0]) is None:
        die(EXIT_BLOCKED, f"argv[0] not on PATH: {run_argv[0]}", reason="missing_executable")

    t0 = time.monotonic()
    try:
        proc = subprocess.run(
            run_argv,
            cwd=str(cwd),
            capture_output=True,
            text=True,
            timeout=float(ver["timeout_seconds"]),
            check=False,
        )
        duration = time.monotonic() - t0
        log_path.write_text(
            f"argv={run_argv!r}\nexit={proc.returncode}\n--- stdout ---\n{proc.stdout}\n--- stderr ---\n{proc.stderr}\n",
            encoding="utf-8",
        )
        ok = proc.returncode == ver["expected_exit"]
        return {
            "id": criterion["id"],
            "exit": proc.returncode,
            "expected_exit": ver["expected_exit"],
            "ok": ok,
            "duration_s": round(duration, 3),
            "log": str(log_path),
            "role": criterion["role"],
        }
    except subprocess.TimeoutExpired as exc:
        duration = time.monotonic() - t0
        log_path.write_text(f"TIMEOUT after {ver['timeout_seconds']}s\nargv={run_argv!r}\n", encoding="utf-8")
        die(
            EXIT_BLOCKED,
            f"timeout criterion {criterion['id']}",
            reason="timeout",
            extra={"duration_s": duration, "log": str(log_path)},
        )


def cmd_prove(args: argparse.Namespace) -> None:
    run_dir = Path(args.run_dir).resolve()
    ensure_not_package_path(run_dir)
    frozen, digest = load_frozen(run_dir)
    repo = Path(frozen["repo"]).resolve()
    if not repo.is_dir():
        die(EXIT_BLOCKED, f"repo missing: {repo}", reason="missing_repo")
    verify_guards(repo, frozen)
    results = []
    logs = run_dir / "logs" / "prove"
    logs.mkdir(parents=True, exist_ok=True)
    for c in frozen["criteria"]:
        results.append(run_one(repo, c, logs / f"{c['id']}.log"))
    # Sticky red: once a change criterion has been observed failing in any
    # prove pass, keep True so a later all-green re-prove (after BUILD) does
    # not erase the red baseline and falsely trip never_red at stop.
    prior_red: dict[str, bool] = {}
    prior_path = run_dir / "prove.json"
    if prior_path.is_file():
        try:
            prior = json.loads(prior_path.read_text(encoding="utf-8"))
            if isinstance(prior, dict) and prior.get("charter_sha256") == digest:
                prev = prior.get("change_observed_red") or {}
                if isinstance(prev, dict):
                    prior_red = {str(k): bool(v) for k, v in prev.items()}
        except Exception:
            prior_red = {}
    red_change: dict[str, bool] = {}
    for r in results:
        if r["role"] != "change":
            continue
        this_red = not r["ok"]
        red_change[r["id"]] = bool(prior_red.get(r["id"])) or this_red
    prove = {
        "phase": "prove",
        "charter_sha256": digest,
        "at": now_iso(),
        "results": results,
        "change_observed_red": red_change,
        "any_fail": any(not r["ok"] for r in results),
    }
    (run_dir / "prove.json").write_text(json.dumps(prove, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    # PROVE allows red — exit 0 if all ran; exit 1 if any failed (still recorded)
    # Blocked conditions already exited
    if prove["any_fail"]:
        out_json({"ok": True, "phase": "prove", "any_fail": True, "results": results})
        raise SystemExit(EXIT_FAIL)
    out_json({"ok": True, "phase": "prove", "any_fail": False, "results": results})


def cmd_stop(args: argparse.Namespace) -> None:
    run_dir = Path(args.run_dir).resolve()
    ensure_not_package_path(run_dir)
    frozen, digest = load_frozen(run_dir)
    repo = Path(frozen["repo"]).resolve()
    verify_guards(repo, frozen)
    prove_path = run_dir / "prove.json"
    if not prove_path.is_file():
        die(EXIT_BLOCKED, "prove.json missing; run prove first", reason="no_prove")
    prove = load_json(prove_path)
    if prove.get("charter_sha256") != digest:
        die(EXIT_BLOCKED, "prove charter digest mismatch", reason="charter_drift")

    # never_red / already_green for change criteria
    change_ids = [c["id"] for c in frozen["criteria"] if c["role"] == "change"]
    observed = prove.get("change_observed_red") or {}
    if change_ids:
        never_red = [cid for cid in change_ids if not observed.get(cid)]
        if never_red:
            # if ALL change were green at prove and never red
            die(
                EXIT_BLOCKED,
                f"change criteria never observed red at PROVE: {never_red}",
                reason="never_red",
                extra={"ids": never_red},
            )

    results = []
    logs = run_dir / "logs" / "stop"
    logs.mkdir(parents=True, exist_ok=True)
    for c in frozen["criteria"]:
        results.append(run_one(repo, c, logs / f"{c['id']}.log"))
    any_fail = any(not r["ok"] for r in results)
    stop = {
        "phase": "stop",
        "charter_sha256": digest,
        "at": now_iso(),
        "results": results,
        "any_fail": any_fail,
    }
    (run_dir / "stop.json").write_text(json.dumps(stop, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    if any_fail:
        receipt = {
            "mode": "native",
            "status": "FAIL",
            "charter_sha256": digest,
            "at": now_iso(),
            "skill_version": VERSION,
            "results": results,
        }
        (run_dir / "receipt.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        out_json(receipt)
        raise SystemExit(EXIT_FAIL)

    receipt = {
        "mode": "native",
        "status": "PASS",
        "charter_sha256": digest,
        "at": now_iso(),
        "skill_version": VERSION,
        "results": results,
        "goal": frozen.get("goal"),
    }
    (run_dir / "receipt.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    out_json(receipt)


def cmd_doctor(args: argparse.Namespace) -> None:
    issues = []
    if args.repo:
        repo = resolve_repo(Path(args.repo))
    else:
        repo = None
    out_json(
        {
            "ok": True,
            "package_root": str(PACKAGE_ROOT),
            "version": VERSION,
            "mode": "native",
            "repo": str(repo) if repo else None,
            "issues": issues,
            "note": "On Hermes, bare /devloop is the engine skill; use this package leaf or say DevLoop native.",
        }
    )


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(prog="devloop-native", description="DevLoop native evidence gates")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_self = sub.add_parser("self-check", help="print package root and version")
    p_self.set_defaults(func=cmd_self_check)

    p_fr = sub.add_parser("freeze", help="freeze charter into run dir")
    p_fr.add_argument("--charter", required=True)
    p_fr.add_argument("--repo", required=True)
    p_fr.add_argument("--run-dir", default=None)
    p_fr.set_defaults(func=cmd_freeze)

    p_pr = sub.add_parser("prove", help="run baseline verifiers")
    p_pr.add_argument("--run-dir", required=True)
    p_pr.set_defaults(func=cmd_prove)

    p_st = sub.add_parser("stop", help="re-run all verifiers and write receipt")
    p_st.add_argument("--run-dir", required=True)
    p_st.set_defaults(func=cmd_stop)

    p_doc = sub.add_parser("doctor", help="preflight / honesty notes")
    p_doc.add_argument("--repo", default=None)
    p_doc.set_defaults(func=cmd_doctor)

    args = parser.parse_args(argv)
    try:
        args.func(args)
    except SystemExit:
        raise
    except Exception as exc:
        die(EXIT_BLOCKED, f"unexpected: {type(exc).__name__}: {exc}", reason="internal")


if __name__ == "__main__":
    main()
