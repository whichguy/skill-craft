{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "devloop-native/charter-v1",
  "title": "DevLoop native charter",
  "type": "object",
  "required": ["criteria"],
  "properties": {
    "goal": { "type": "string" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "outcome", "verifier"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "enum": ["change", "regression"] },
          "outcome": { "type": "string", "minLength": 1 },
          "verifier": {
            "type": "object",
            "required": ["argv"],
            "properties": {
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "cwd": { "type": "string" },
              "expected_exit": { "type": "integer" },
              "timeout_seconds": { "type": "integer", "minimum": 1 },
              "guard_paths": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
