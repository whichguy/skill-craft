{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/skills/shiploop/scripts/shiploop-status-hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/skills/shiploop/scripts/shiploop-keepalive-observe",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/skills/shiploop/scripts/shiploop-keepalive-stop",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$PLUGIN_ROOT/skills/shiploop/scripts/shiploop-keepalive-session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
