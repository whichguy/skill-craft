#!/usr/bin/env python3
"""shiploop-hook — host hook entry point for ShipLoop keepalive.

  shiploop-hook observe|stop --host HOST      (host hook events; payload on stdin)
  shiploop-hook install|uninstall|status --host HOST [--host HOST ...] [--dry-run]
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import shiploop_pyfloor  # noqa: E402

# A host event does nothing below the floor; install, uninstall and status say why they cannot run.
shiploop_pyfloor.require(hook_event=sys.argv[1:2] in (["observe"], ["stop"], ["skill"], ["session-end"]))
import shiploop_keepalive  # noqa: E402

if __name__ == "__main__":
    sys.exit(shiploop_keepalive.hook_main())
