#!/usr/bin/env python3
"""steer-next — thin wrapper that execs steer next."""
from __future__ import annotations

import os
import sys
from pathlib import Path
from typing import List, Optional

EXIT_BLOCKED = 2
EXIT_USAGE = 64
PACKAGE_ROOT = Path(__file__).resolve().parents[1]
HOST_SKILL_HOMES = (
    Path.home() / ".cursor" / "skills",
    Path.home() / ".claude" / "skills",
    Path.home() / ".grok" / "skills",
    Path.home() / ".codex" / "skills",
)
REFUSED = {"update", "complete-step", "start-step", "clear-step", "capture", "init"}


def die(code: int, msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def skill_dir_ok(root: Path) -> bool:
    return (root / "SKILL.md").is_file() and (root / "scripts" / "steer").is_file()


def find_steer() -> Path:
    raw = os.environ.get("STEER_ROOT", "").strip()
    if raw:
        p = Path(raw).expanduser()
        if skill_dir_ok(p):
            return p.resolve()
        die(EXIT_BLOCKED, f"STEER_ROOT is not a steer leaf: {raw}")
    sibling = PACKAGE_ROOT.parent / "steer"
    if skill_dir_ok(sibling):
        return sibling.resolve()
    for home in HOST_SKILL_HOMES:
        cand = home / "steer"
        if skill_dir_ok(cand):
            return cand.resolve()
    die(EXIT_BLOCKED, "missing dep_roots.steer")
    raise SystemExit(EXIT_BLOCKED)


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in REFUSED:
        die(EXIT_BLOCKED, f"steer-next refuses {argv[0]}")
    if argv and argv[0] == "next":
        argv = argv[1:]
    print("steer-next — reprint the steer packet", flush=True)
    steer = find_steer() / "scripts" / "steer"
    os.execv(sys.executable, [sys.executable, str(steer), "next", *argv])
    return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main())
