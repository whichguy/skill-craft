#!/usr/bin/env python3
"""steer — session harness (not DevLoop)."""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import shutil
import sys
import uuid
from contextlib import contextmanager
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, Iterator, List, Optional, Set, Tuple

EXIT_OK = 0
EXIT_BLOCKED = 2
EXIT_USAGE = 64

PACKAGE_ROOT = Path(__file__).resolve().parents[1]
VERSION = "0.2.0"
REF_DIR = PACKAGE_ROOT / "references"
TRANSITIONS_PATH = REF_DIR / "transitions.json"
ACTIVITIES_DIR = REF_DIR / "activities"

PHASES = (
    "intake",
    "validate-spec",
    "plan",
    "implement",
    "residual",
    "done",
    "halted",
    "blocked",
)
MAP_PHASES = (
    "intake",
    "validate-spec",
    "plan",
    "implement",
    "residual",
    "done",
)
RESUME_PHASES = ("validate-spec", "plan", "implement", "residual")
STEP_ID_RE = re.compile(r"^[SD][0-9]+$")
CONTROL_RE = re.compile(r"[\x00-\x08\x0a-\x1f\x7f]")

STATUS_RE = re.compile(
    r"(?im)\bStatus\b[^\n]*(?P<state>stopped\s*\([^\n)]*\)|complete\b|active\b)"
)
PLAN_CONTRACT_RE = re.compile(
    r"(?im)^\*\*Plan contract:\*\*\s*`?(?P<path>[^`\n]+?)`?\s*$"
)
PLAN_HASH_RE = re.compile(
    r"(?im)^\*\*Plan hash:\*\*\s*`?(?P<hash>[0-9a-fA-F]{64})`?"
)
COMMITTED_YES_RE = re.compile(r"(?im)^\*\*Committed:\*\*\s*yes\b")
COMMITTED_NO_RE = re.compile(r"(?im)^\*\*Committed:\*\*\s*no\b")
ROUND_HEAD_RE = re.compile(r"(?im)^###\s+Round\s+(?P<n>\d+)\b")
WAIVER_RE = re.compile(
    r"(?im)^[ \t]*None\s*[—–-]\s*residual\s+loop\s+waived\s*:\s*(?P<reason>\S.+?)\s*$"
)
PLACEHOLDER_RE = re.compile(
    r"(?i)^(tbd|todo|\.\.\.|…|from plan|list concrete|<[^>]+>)$"
)
DONE_LINE_RE = re.compile(r"(?im)^(?:done_sentence|done sentence)\s*:\s*(.+?)\s*$")
H2_RE = re.compile(r"(?m)^##\s+(.+?)\s*$")
FENCE_RE = re.compile(r"^[ \t]{0,3}(```|~~~)")

HOST_SKILL_HOMES = (
    Path.home() / ".cursor" / "skills",
    Path.home() / ".claude" / "skills",
    Path.home() / ".grok" / "skills",
    Path.home() / ".codex" / "skills",
)


def die(code: int, msg: str) -> None:
    print(f"error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    return sha256_bytes(path.read_bytes())


def spec_pair_sha256(run_dir: Path) -> str:
    md = (run_dir / "spec.md").read_bytes()
    js = (run_dir / "spec.json").read_bytes()
    return sha256_bytes(md + b"\0" + js)


def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        die(EXIT_BLOCKED, f"cannot parse JSON: {path}: {exc}")


def write_json_atomic(path: Path, obj: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def refuse_package_path(path: Path) -> None:
    try:
        path.resolve().relative_to(PACKAGE_ROOT)
    except ValueError:
        return
    die(EXIT_BLOCKED, f"refusing path inside skill package: {path}")


def inside_run_dir(run_dir: Path, path: Path) -> None:
    try:
        path.resolve().relative_to(run_dir.resolve())
    except ValueError:
        die(EXIT_BLOCKED, f"path escapes run-dir: {path}")


def load_transitions() -> Dict[str, Any]:
    data = load_json(TRANSITIONS_PATH)
    if not isinstance(data, dict) or "edges" not in data:
        die(EXIT_BLOCKED, "transitions.json missing edges")
    return data


def legal_edge(src: str, dest: str) -> Optional[str]:
    for edge in load_transitions()["edges"]:
        if edge.get("from") == src and edge.get("to") == dest:
            return str(edge.get("need") or "")
    return None


def skill_dir_ok(root: Path) -> bool:
    return (root / "SKILL.md").is_file()


def find_skill(name: str) -> Optional[Path]:
    env_key = {
        "devloop": "STEER_DEVLOOP_ROOT",
        "review-coverage": "STEER_REVIEW_COVERAGE_ROOT",
        "steer": "STEER_ROOT",
        "backchain": "STEER_BACKCHAIN_ROOT",
    }.get(name, "")
    if env_key:
        raw = os.environ.get(env_key, "").strip()
        if raw:
            p = Path(raw).expanduser()
            if skill_dir_ok(p):
                return p.resolve()
    sibling = PACKAGE_ROOT.parent / name
    if sibling.is_dir() and skill_dir_ok(sibling) and name != "steer":
        return sibling.resolve()
    if name == "steer" and skill_dir_ok(PACKAGE_ROOT):
        return PACKAGE_ROOT
    for home in HOST_SKILL_HOMES:
        cand = home / name
        if skill_dir_ok(cand):
            return cand.resolve()
    return None


def resolve_dep_roots() -> Dict[str, Optional[str]]:
    return {
        "steer": str(PACKAGE_ROOT),
        "devloop": str(p) if (p := find_skill("devloop")) else None,
        "review-coverage": str(p) if (p := find_skill("review-coverage")) else None,
        "backchain": str(p) if (p := find_skill("backchain")) else None,
    }


def default_state(
    run_dir: Path,
    *,
    prompt: str,
    implementer: str,
    bound_plan: str,
    repo: str,
) -> Dict[str, Any]:
    bound_hash = ""
    if bound_plan:
        bp = Path(bound_plan)
        if bp.is_file():
            bound_hash = sha256_file(bp)
    return {
        "version": 2,
        "phase": "intake",
        "run_id": f"{datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')}-{uuid.uuid4().hex[:8]}",
        "attempt": 1,
        "prompt": prompt,
        "implementer": implementer,
        "bound_plan": bound_plan,
        "bound_plan_hash": bound_hash,
        "spec_sha256": "",
        "plan_sha256": "",
        "repo_root": repo,
        "dep_roots": resolve_dep_roots(),
        "artifacts": {
            "prompt": str(run_dir / "prompt.md"),
            "spec_md": str(run_dir / "spec.md"),
            "spec_json": str(run_dir / "spec.json"),
            "plan_md": str(run_dir / "plan.md"),
            "plan_json": str(run_dir / "plan.json"),
            "backchain": str(run_dir / "backchain" / "plan.json"),
            "implement": str(run_dir / "implement.json"),
        },
        "blocked_reason": None,
        "blocked_from": None,
        "resume_to": None,
        "ask_user": None,
        "terminal": None,
    }


def run_dir_from_arg(raw: Optional[str], *, walk: bool) -> Path:
    if raw:
        p = Path(raw).expanduser()
        if p.name != ".steer" and (p / ".steer").is_dir() and (p / ".steer" / "state.json").is_file():
            p = p / ".steer"
        return p
    if not walk:
        return Path.cwd() / ".steer"
    cur = Path.cwd().resolve()
    for parent in [cur, *cur.parents]:
        cand = parent / ".steer"
        if (cand / "state.json").is_file():
            return cand
    return Path.cwd() / ".steer"


def load_state(run_dir: Path) -> Dict[str, Any]:
    refuse_package_path(run_dir)
    state_path = run_dir / "state.json"
    if not state_path.is_file():
        die(EXIT_BLOCKED, f"no state.json in {run_dir}")
    if state_path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {state_path}")
    data = load_json(state_path)
    if not isinstance(data, dict):
        die(EXIT_BLOCKED, "state.json is not an object")
    return data


@contextmanager
def run_lock(run_dir: Path) -> Iterator[None]:
    refuse_package_path(run_dir)
    run_dir.mkdir(parents=True, exist_ok=True)
    lock = run_dir / ".lock"
    fd = os.open(str(lock), os.O_CREAT | os.O_RDWR)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


def save_state(run_dir: Path, state: Dict[str, Any], *, event: str) -> None:
    refuse_package_path(run_dir)
    write_json_atomic(run_dir / "state.json", state)
    hist = run_dir / "history.jsonl"
    rec = {"ts": now_iso(), "event": event, "phase": state.get("phase")}
    with hist.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(rec, sort_keys=True) + "\n")


def read_text(path: Path) -> Optional[str]:
    if not path.is_file():
        return None
    if path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {path}")
    return path.read_text(encoding="utf-8")


def spec_pair(run_dir: Path) -> Tuple[Optional[Dict[str, Any]], List[str]]:
    gaps: List[str] = []
    md_path = run_dir / "spec.md"
    js_path = run_dir / "spec.json"
    if not md_path.is_file():
        gaps.append(f"missing {md_path}")
    if not js_path.is_file():
        gaps.append(f"missing {js_path}")
        return None, gaps
    data = load_json(js_path)
    if not isinstance(data, dict):
        return None, ["spec.json is not an object"]
    ds = data.get("done_sentence")
    ch = data.get("checkable")
    if not isinstance(ds, str) or not ds.strip():
        gaps.append("spec.json.done_sentence missing")
    if not isinstance(ch, bool):
        gaps.append("spec.json.checkable must be a bool")
    md = read_text(md_path) or ""
    if not md.strip():
        gaps.append("spec.md empty")
    elif isinstance(ds, str) and ds.strip():
        labeled = DONE_LINE_RE.search(md)
        if not labeled or labeled.group(1).strip() != ds.strip():
            gaps.append("spec.md labeled done_sentence must equal spec.json")
    return data, gaps


def canonical_backchain(run_dir: Path) -> Path:
    return run_dir / "backchain" / "plan.json"


def wrapper_pair(run_dir: Path, spec: Optional[Dict[str, Any]]) -> List[str]:
    gaps: List[str] = []
    md_path = run_dir / "plan.md"
    js_path = run_dir / "plan.json"
    if not md_path.is_file():
        gaps.append(f"missing {md_path}")
    if not js_path.is_file():
        gaps.append(f"missing {js_path}")
        return gaps
    data = load_json(js_path)
    if not isinstance(data, dict):
        return ["plan.json is not an object"]
    ds = data.get("done_sentence")
    if not isinstance(ds, str) or not ds.strip():
        gaps.append("plan.json.done_sentence missing")
    spec_ds = (spec or {}).get("done_sentence")
    if isinstance(ds, str) and spec_ds is not None and ds != spec_ds:
        gaps.append("plan.json.done_sentence must equal spec.json")
    md = read_text(md_path) or ""
    if not md.strip():
        gaps.append("plan.md empty")
    elif isinstance(ds, str) and ds.strip():
        labeled = DONE_LINE_RE.search(md)
        if not labeled or labeled.group(1).strip() != ds.strip():
            gaps.append("plan.md labeled done_sentence must equal plan.json")
    return gaps


def _section_h2(text: str, title: str) -> Optional[str]:
    lines = text.splitlines()
    start = None
    in_fence = False
    for i, line in enumerate(lines):
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        m = re.match(r"^[ \t]{0,3}(#{1,6})\s+(.*)$", line)
        if not m:
            continue
        if start is None:
            if len(m.group(1)) == 2 and re.search(rf"(?i)^{re.escape(title)}\b", m.group(2).strip()):
                start = i + 1
            continue
        if len(m.group(1)) <= 2:
            return "\n".join(lines[start:i])
    if start is not None:
        return "\n".join(lines[start:])
    return None


def plan_waiver(state: Dict[str, Any]) -> Optional[str]:
    bound_plan = str(state.get("bound_plan") or "")
    if not bound_plan:
        return None
    path = Path(bound_plan)
    if not path.is_file():
        return None
    bound_hash = str(state.get("bound_plan_hash") or "")
    if bound_hash and sha256_file(path) != bound_hash:
        return None
    text = path.read_text(encoding="utf-8")
    body = _section_h2(text, "Review Coverage")
    if body is None:
        return None
    scan_lines = []
    in_fence = False
    for line in body.splitlines():
        if FENCE_RE.match(line):
            in_fence = not in_fence
            continue
        if not in_fence:
            scan_lines.append(line)
    scan = "\n".join(scan_lines)
    m = WAIVER_RE.search(scan)
    if not m:
        return None
    reason = (m.group("reason") or "").strip()
    if not reason or PLACEHOLDER_RE.fullmatch(reason) or re.fullmatch(r"<[^<>]+>", reason):
        return None
    return reason


def latest_round_body(text: str) -> Tuple[str, Optional[str]]:
    matches = list(ROUND_HEAD_RE.finditer(text))
    if not matches:
        return "", None
    last = matches[-1]
    start = last.start()
    nxt = matches[-1].end()
    end = len(text)
    for m in matches:
        if m.start() > start:
            end = m.start()
            break
    return text[start:end], last.group("n")


def ledger_report(repo_root: Path, state: Dict[str, Any]) -> Dict[str, Any]:
    ledger = repo_root / "REVIEW_CONVERGE.md"
    out: Dict[str, Any] = {
        "present": ledger.is_file(),
        "status": None,
        "bound": False,
        "landed": False,
        "foreign": False,
        "path": str(ledger),
    }
    if not ledger.is_file():
        return out
    text = ledger.read_text(encoding="utf-8")
    sm = STATUS_RE.search(text)
    if sm:
        out["status"] = sm.group("state")
    cm = PLAN_CONTRACT_RE.search(text)
    hm = PLAN_HASH_RE.search(text)
    contract = (cm.group("path").strip() if cm else "")
    phash = (hm.group("hash").strip().lower() if hm else "")
    bound_plan = str(state.get("bound_plan") or "")
    bound_hash = str(state.get("bound_plan_hash") or "").lower()
    if bound_plan and contract:
        try:
            same_path = Path(contract).resolve() == Path(bound_plan).resolve()
        except OSError:
            same_path = os.path.normpath(contract) == os.path.normpath(bound_plan)
        same_hash = (not bound_hash) or (phash == bound_hash)
        out["bound"] = bool(same_path and same_hash)
        out["foreign"] = not same_path or (bound_hash and phash and phash != bound_hash)
    elif bound_plan:
        out["foreign"] = True
    round_body, n = latest_round_body(text)
    last_c = None
    for line in round_body.splitlines():
        if re.search(r"(?i)^\*\*Committed:\*\*", line):
            last_c = line
    committed_yes = bool(last_c and re.search(r"(?i)yes\b", last_c) and not re.search(r"(?i)no\b", last_c))
    subj = False
    if n is not None:
        subj = bool(
            re.search(
                rf"(?im)(?:review-converge|grok-review-converge):\s*round\s+{re.escape(n)}\s*—",
                round_body,
            )
        )
    out["landed"] = bool(committed_yes and subj)
    return out


def residual_gaps(state: Dict[str, Any], dest: str) -> List[str]:
    waiver = plan_waiver(state)
    repo = Path(str(state.get("repo_root") or "")).expanduser()
    if dest == "done" and waiver:
        return []
    if not repo.is_dir():
        return ["repo_root is not a directory"]
    rep = ledger_report(repo, state)
    if not rep["present"]:
        return [f"missing ledger {rep['path']}"]
    if rep["foreign"] or not rep["bound"]:
        return ["foreign or unbound REVIEW_CONVERGE.md"]
    status = rep["status"] or ""
    if dest == "done":
        if status != "complete":
            return [f"ledger status {status!r} is not complete"]
        if not rep["landed"]:
            return ["ledger complete but not landed"]
        return []
    if dest == "halted":
        if not str(status).startswith("stopped"):
            return [f"ledger status {status!r} is not stopped"]
        return []
    return ["residual not terminal"]


def load_dag(run_dir: Path) -> Optional[Dict[str, Any]]:
    path = canonical_backchain(run_dir)
    if not path.is_file():
        return None
    if path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {path}")
    inside_run_dir(run_dir, path)
    data = load_json(path)
    if not isinstance(data, dict):
        die(EXIT_BLOCKED, "backchain plan.json is not an object")
    return data


def dag_gaps(run_dir: Path, spec: Optional[Dict[str, Any]]) -> List[str]:
    gaps: List[str] = []
    path = canonical_backchain(run_dir)
    if not path.is_file():
        return [f"missing {path}"]
    data = load_dag(run_dir)
    if data is None:
        return [f"missing {path}"]
    for key in ("goal", "initial_state", "steps", "unresolved"):
        if key not in data:
            gaps.append(f"backchain missing key {key}")
    steps = data.get("steps")
    if not isinstance(steps, list) or not steps:
        gaps.append("backchain steps must be a nonempty list")
        return gaps
    unresolved = data.get("unresolved")
    if unresolved is None:
        gaps.append("backchain missing key unresolved")
    elif not isinstance(unresolved, list):
        gaps.append("backchain unresolved must be a list")
    elif unresolved:
        gaps.append("unresolved must be empty to enter implement")
    goal = data.get("goal")
    spec_ds = (spec or {}).get("done_sentence")
    if isinstance(goal, str) and spec_ds is not None and goal != spec_ds:
        gaps.append("backchain.goal must equal spec.done_sentence")
    initial = data.get("initial_state")
    if not isinstance(initial, list):
        gaps.append("initial_state must be a list")
        initial = []
    initial_set = {x for x in initial if isinstance(x, str)}
    ids: List[str] = []
    seen: Set[str] = set()
    graph: Dict[str, List[str]] = {}
    for i, step in enumerate(steps):
        if not isinstance(step, dict):
            gaps.append(f"steps[{i}] is not an object")
            continue
        sid = step.get("id")
        if not isinstance(sid, str) or not STEP_ID_RE.fullmatch(sid):
            gaps.append(f"unsafe or missing step id {sid!r}")
            continue
        if ".." in sid or "/" in sid:
            gaps.append(f"unsafe step id {sid}")
            continue
        if sid in seen:
            gaps.append(f"duplicate step id {sid}")
        seen.add(sid)
        ids.append(sid)
        produces = step.get("produces")
        texts = produces_texts(produces)
        if texts is None:
            gaps.append(f"{sid} produces must be a nonempty string or string list")
        else:
            for t in texts:
                if CONTROL_RE.search(t) or "/devloop" in t:
                    gaps.append(f"{sid} produces contains a newline, control, or /devloop")
        origin = step.get("origin")
        if origin not in ("seed", "discovered"):
            gaps.append(f"{sid} origin must be seed or discovered")
        inputs = step.get("inputs")
        if not isinstance(inputs, list):
            gaps.append(f"{sid} inputs must be a list")
            inputs = []
        graph.setdefault(sid, [])
        for inp in inputs:
            if not isinstance(inp, dict):
                gaps.append(f"{sid} input is not an object")
                continue
            need = inp.get("need")
            if not isinstance(need, str) or not need.strip():
                gaps.append(f"{sid} inputs[].need must be nonempty")
            fr = inp.get("from")
            if fr is None:
                if isinstance(need, str) and need not in initial_set:
                    gaps.append(f"{sid} from:null need not in initial_state")
            elif not isinstance(fr, str):
                gaps.append(f"{sid} inputs[].from must be null or an id")
            else:
                graph[sid].append(fr)
    for sid, deps in graph.items():
        for fr in deps:
            if fr not in seen:
                gaps.append(f"{sid} inputs.from {fr} is not an existing id")
    # cycle
    WHITE, GREY, BLACK = 0, 1, 2
    color = {sid: WHITE for sid in seen}

    def visit(node: str) -> bool:
        color[node] = GREY
        for nxt in graph.get(node, []):
            if nxt not in color:
                continue
            if color[nxt] == GREY:
                return True
            if color[nxt] == WHITE and visit(nxt):
                return True
        color[node] = BLACK
        return False

    for sid in seen:
        if color[sid] == WHITE and visit(sid):
            gaps.append("committed cycle")
            break
    return gaps


def recomputed_step_ids(run_dir: Path) -> List[str]:
    data = load_dag(run_dir)
    if not data:
        return []
    ids = []
    for step in data.get("steps") or []:
        if isinstance(step, dict) and isinstance(step.get("id"), str):
            ids.append(step["id"])
    return sorted(ids)


def steps_dir(run_dir: Path) -> Path:
    return run_dir / "steps"


def receipt_path(run_dir: Path, sid: str) -> Path:
    if not STEP_ID_RE.fullmatch(sid) or ".." in sid or "/" in sid:
        die(EXIT_BLOCKED, f"unsafe step id {sid}")
    path = steps_dir(run_dir) / f"{sid}.json"
    inside_run_dir(run_dir, path)
    return path


def load_receipt(run_dir: Path, sid: str) -> Optional[Dict[str, Any]]:
    path = receipt_path(run_dir, sid)
    if not path.is_file():
        return None
    if path.is_symlink():
        die(EXIT_BLOCKED, f"symlink escape refused: {path}")
    data = load_json(path)
    return data if isinstance(data, dict) else None


def receipt_matches(rec: Optional[Dict[str, Any]], plan_hash: str, status: str) -> bool:
    if not rec:
        return False
    return rec.get("status") == status and rec.get("plan_sha256") == plan_hash


def plan_hash_of(run_dir: Path) -> str:
    path = canonical_backchain(run_dir)
    if not path.is_file():
        return ""
    return sha256_file(path)


def rebuild_implement_summary(run_dir: Path, state: Dict[str, Any]) -> None:
    plan_hash = str(state.get("plan_sha256") or "")
    complete: List[str] = []
    running: List[str] = []
    d = steps_dir(run_dir)
    if d.is_dir():
        for path in sorted(d.glob("*.json")):
            if path.is_symlink():
                die(EXIT_BLOCKED, f"symlink escape refused: {path}")
            rec = load_json(path)
            if not isinstance(rec, dict):
                continue
            if rec.get("plan_sha256") != plan_hash:
                continue
            sid = rec.get("id")
            if rec.get("status") == "complete" and isinstance(sid, str):
                complete.append(sid)
            elif rec.get("status") == "running" and isinstance(sid, str):
                running.append(sid)
    write_json_atomic(
        run_dir / "implement.json",
        {
            "writer": "steer.steps",
            "run_id": state.get("run_id"),
            "complete": sorted(set(complete)),
            "running": sorted(set(running)),
        },
    )


def clear_steps(run_dir: Path, state: Dict[str, Any], *, running_only: bool = False) -> None:
    d = steps_dir(run_dir)
    if d.is_dir():
        plan_hash = str(state.get("plan_sha256") or "")
        for path in list(d.glob("*.json")):
            if running_only:
                rec = load_json(path) if path.is_file() and not path.is_symlink() else None
                if not isinstance(rec, dict) or rec.get("status") != "running":
                    continue
                if plan_hash and rec.get("plan_sha256") != plan_hash:
                    continue
            if path.is_file() or path.is_symlink():
                path.unlink()
    rebuild_implement_summary(run_dir, state)


def steps_by_id(run_dir: Path) -> Dict[str, Dict[str, Any]]:
    data = load_dag(run_dir) or {}
    out: Dict[str, Dict[str, Any]] = {}
    for step in data.get("steps") or []:
        if isinstance(step, dict) and isinstance(step.get("id"), str):
            out[step["id"]] = step
    return out


def suppliers_complete(step: Dict[str, Any], run_dir: Path, plan_hash: str) -> bool:
    for inp in step.get("inputs") or []:
        if not isinstance(inp, dict):
            return False
        fr = inp.get("from")
        if fr is None:
            continue
        if not receipt_matches(load_receipt(run_dir, str(fr)), plan_hash, "complete"):
            return False
    return True


def classify_steps(run_dir: Path, state: Dict[str, Any]) -> Dict[str, str]:
    plan_hash = str(state.get("plan_sha256") or "")
    by_id = steps_by_id(run_dir)
    out: Dict[str, str] = {}
    for sid, step in by_id.items():
        rec = load_receipt(run_dir, sid)
        if receipt_matches(rec, plan_hash, "complete"):
            out[sid] = "done"
        elif receipt_matches(rec, plan_hash, "running"):
            out[sid] = "running"
        elif suppliers_complete(step, run_dir, plan_hash):
            out[sid] = "ready"
        else:
            out[sid] = "todo"
    return out


def steps_drained(run_dir: Path, state: Dict[str, Any]) -> bool:
    ids = recomputed_step_ids(run_dir)
    if not ids:
        return False
    plan_hash = str(state.get("plan_sha256") or "")
    if not plan_hash:
        return False
    return all(receipt_matches(load_receipt(run_dir, sid), plan_hash, "complete") for sid in ids)


def check_frozen_hashes(state: Dict[str, Any], run_dir: Path, dest: Optional[str]) -> None:
    # --to blocked is the halt hatch: must work even when files drifted.
    if dest == "blocked":
        return
    spec_h = str(state.get("spec_sha256") or "")
    if spec_h and dest not in ("plan", "validate-spec"):
        if (run_dir / "spec.md").is_file() and (run_dir / "spec.json").is_file():
            if spec_pair_sha256(run_dir) != spec_h:
                die(EXIT_BLOCKED, "spec hash drift; rebind via blocked → validate-spec")
    plan_h = str(state.get("plan_sha256") or "")
    # dest plan rebinds the DAG (writes a new hash later). dest implement
    # compares when a hash is already stored so a mutated DAG cannot sneak in.
    if plan_h and dest != "plan":
        path = canonical_backchain(run_dir)
        if path.is_file() and sha256_file(path) != plan_h:
            die(EXIT_BLOCKED, "plan hash drift; rebind via blocked → plan")


def refuse_if_blocked_step_cmd(state: Dict[str, Any]) -> None:
    if state.get("phase") == "blocked":
        die(EXIT_BLOCKED, "start-step/complete-step/clear-step illegal while blocked")
    if state.get("phase") != "implement":
        die(EXIT_BLOCKED, "step commands require phase implement")


def write_running_receipt(run_dir: Path, state: Dict[str, Any], sid: str) -> None:
    plan_hash = str(state.get("plan_sha256") or "")
    rec = {
        "writer": "steer.start-step",
        "run_id": state.get("run_id"),
        "id": sid,
        "status": "running",
        "plan_sha256": plan_hash,
    }
    write_json_atomic(receipt_path(run_dir, sid), rec)


def claim_ready(run_dir: Path, state: Dict[str, Any]) -> List[str]:
    if str(state.get("phase")) != "implement":
        return []
    claimed: List[str] = []
    classes = classify_steps(run_dir, state)
    for sid, kind in classes.items():
        if kind == "ready":
            write_running_receipt(run_dir, state, sid)
            claimed.append(sid)
    if claimed:
        rebuild_implement_summary(run_dir, state)
    return claimed


def produces_texts(produces: Any) -> Optional[List[str]]:
    if isinstance(produces, str) and produces.strip():
        return [produces.strip()]
    if isinstance(produces, list) and produces:
        out: List[str] = []
        for item in produces:
            if not isinstance(item, str) or not item.strip():
                return None
            out.append(item.strip())
        return out
    return None


def goal_field(label: str, value: str) -> str:
    if CONTROL_RE.search(value) or "\n" in value or "\r" in value:
        die(EXIT_BLOCKED, f"{label} contains a newline or control character")
    if "/devloop" in value:
        die(EXIT_BLOCKED, f"{label} contains /devloop")
    return value


def goal_line(step: Dict[str, Any], done_sentence: str) -> str:
    sid = goal_field("id", str(step.get("id") or ""))
    statement = goal_field("statement", str(step.get("statement") or ""))
    texts = produces_texts(step.get("produces")) or []
    produces = goal_field("produces", "; ".join(texts))
    inputs = step.get("inputs") or []
    suppliers = []
    for inp in inputs:
        if isinstance(inp, dict):
            suppliers.append(f"{inp.get('need')} from {inp.get('from')}")
    supplier_txt = goal_field("inputs", "; ".join(suppliers) if suppliers else "initial_state")
    # Complete-when is this step only. Frozen done_sentence stays in Reminder.
    _ = done_sentence
    objective = (
        f"step {sid}: {statement}; produces {produces}; "
        f"suppliers {supplier_txt}; write the failing or characterization tests "
        f"for this postcondition, run them, fix until they pass; if this step is "
        f"prep, deploy, or cleanup, do that work and only add tests that make "
        f"that postcondition checkable"
    )
    if CONTROL_RE.search(objective) or "\n" in objective:
        die(EXIT_BLOCKED, "interpolated /goal is not one line")
    if objective.lstrip().startswith("/devloop"):
        die(EXIT_BLOCKED, "interpolated /goal begins with /devloop")
    line = f"/goal {objective}"
    if "\n" in line:
        die(EXIT_BLOCKED, "interpolated /goal is not one line")
    return line


def missing_for(state: Dict[str, Any], run_dir: Path, dest: Optional[str]) -> List[str]:
    gaps: List[str] = []
    deps = resolve_dep_roots()
    state["dep_roots"] = deps
    phase = str(state.get("phase"))
    if dest in ("plan", "implement") or phase in ("plan", "implement"):
        if dest == "implement" or (phase == "implement" and dest is None):
            if not deps.get("backchain"):
                gaps.append("missing dep_roots.backchain")
        if dest == "implement":
            if not deps.get("backchain"):
                if "missing dep_roots.backchain" not in gaps:
                    gaps.append("missing dep_roots.backchain")
    if dest is None:
        if phase == "plan" and not deps.get("backchain"):
            gaps.append("missing dep_roots.backchain")
        return gaps
    need = legal_edge(str(state.get("phase")), dest)
    if need is None:
        return [f"illegal transition {state.get('phase')} -> {dest}"]
    if need == "prompt":
        prompt = (read_text(run_dir / "prompt.md") or state.get("prompt") or "").strip()
        if not prompt:
            gaps.append("prompt empty")
    elif need == "spec_checkable":
        spec, sg = spec_pair(run_dir)
        gaps.extend(sg)
        if spec and spec.get("checkable") is not True:
            gaps.append("spec.json.checkable is not true")
    elif need == "spec_uncheckable":
        spec, sg = spec_pair(run_dir)
        gaps.extend(sg)
        if spec and spec.get("checkable") is not False:
            gaps.append("spec.json.checkable is not false")
        ask = (spec or {}).get("ask_user") if spec else None
        if not (isinstance(ask, str) and ask.strip()):
            gaps.append("ask_user required when checkable is false")
    elif need == "plan":
        spec, sg = spec_pair(run_dir)
        gaps.extend(sg)
        gaps.extend(wrapper_pair(run_dir, spec))
        gaps.extend(dag_gaps(run_dir, spec))
        if not deps.get("backchain"):
            if "missing dep_roots.backchain" not in gaps:
                gaps.append("missing dep_roots.backchain")
    elif need == "steps_drained":
        if not steps_drained(run_dir, state):
            gaps.append("steps not drained")
    elif need == "residual_success":
        gaps.extend(residual_gaps(state, "done"))
    elif need == "residual_stopped":
        gaps.extend(residual_gaps(state, "halted"))
    elif need == "reason":
        pass
    return gaps


def forward_dest(state: Dict[str, Any], run_dir: Path) -> Optional[str]:
    phase = str(state.get("phase"))
    if phase == "intake":
        return "validate-spec"
    if phase == "validate-spec":
        spec, gaps = spec_pair(run_dir)
        if spec and spec.get("checkable") is False and not any("missing" in g for g in gaps):
            return "blocked"
        return "plan"
    if phase == "plan":
        spec, _ = spec_pair(run_dir)
        if dag_gaps(run_dir, spec):
            return "blocked"
        return "implement"
    if phase == "implement":
        if steps_drained(run_dir, state):
            return "residual"
        return None
    if phase == "residual":
        repo = Path(str(state.get("repo_root") or ""))
        if repo.is_dir():
            rep = ledger_report(repo, state)
            if (rep.get("status") or "").startswith("stopped") and rep.get("bound"):
                return "halted"
        if plan_waiver(state):
            return "done"
        return "done"
    if phase == "blocked":
        return str(state.get("resume_to") or "") or None
    return None


def activity_title(phase: str) -> str:
    titles = {
        "intake": "record the original ask",
        "validate-spec": "write a machine-checkable spec",
        "plan": "write the sequence plan via backchain",
        "implement": "walk ready steps via /goal",
        "residual": "run bound review-coverage Phase B",
        "blocked": "stop and ask the user",
        "done": "session success — stop",
        "halted": "session halted — stop",
    }
    return titles.get(phase, phase)


def interpolate(template: str, mapping: Dict[str, str]) -> str:
    out = template
    for key, val in mapping.items():
        out = out.replace("{{" + key + "}}", val)
    return out


def activity_body(phase: str, run_dir: Path, state: Dict[str, Any]) -> str:
    path = ACTIVITIES_DIR / f"{phase}.md"
    if not path.is_file():
        return f"(no activity file for {phase})"
    mapping = {
        "RUN_DIR": str(run_dir.resolve()),
        "PROMPT_PATH": str(run_dir / "prompt.md"),
        "SPEC_MD": str(run_dir / "spec.md"),
        "SPEC_JSON": str(run_dir / "spec.json"),
        "PLAN_MD": str(run_dir / "plan.md"),
        "PLAN_JSON": str(run_dir / "plan.json"),
        "BACKCHAIN_JSON": str(canonical_backchain(run_dir)),
        "IMPLEMENT_JSON": str(run_dir / "implement.json"),
        "STEER_BIN": str(PACKAGE_ROOT / "scripts" / "steer"),
        "DONE_SENTENCE": str((spec_pair(run_dir)[0] or {}).get("done_sentence") or ""),
        "BOUND_PLAN": str(state.get("bound_plan") or ""),
        "LEDGER_PATH": str(Path(str(state.get("repo_root") or run_dir.parent)) / "REVIEW_CONVERGE.md"),
        "ASK_USER": str(state.get("ask_user") or ""),
        "BLOCKED_FROM": str(state.get("blocked_from") or ""),
        "BLOCKED_REASON": str(state.get("blocked_reason") or ""),
        "RESUME_TO": str(state.get("resume_to") or "validate-spec"),
    }
    return interpolate(path.read_text(encoding="utf-8"), mapping).rstrip()


def map_line(phase: str, state: Dict[str, Any], run_dir: Path) -> str:
    cur = str(state.get("phase"))
    if cur == "blocked" and phase == "blocked":
        return f"{phase}: current — {state.get('blocked_reason') or 'blocked'}"
    if cur == "halted" and phase == "done":
        return "done: skipped — session halted"
    if cur == "blocked":
        if phase == str(state.get("blocked_from")):
            return f"{phase}: blocked"
        order = {p: i for i, p in enumerate(MAP_PHASES)}
        bf = str(state.get("blocked_from") or "intake")
        if phase in order and bf in order and order[phase] < order[bf]:
            extra = " — frozen" if phase == "validate-spec" and state.get("spec_sha256") else ""
            return f"{phase}: done{extra}"
        if phase in order and bf in order and order[phase] > order[bf]:
            return f"{phase}: todo"
    if phase == cur:
        extra = ""
        if phase == "validate-spec" and (run_dir / "spec.json").is_file():
            spec, _ = spec_pair(run_dir)
            extra = f" — checkable={spec.get('checkable')}" if spec else ""
        return f"{phase}: current{extra}"
    order = {p: i for i, p in enumerate(MAP_PHASES)}
    if cur in ("done", "halted") and phase in order:
        if cur == "done":
            return f"{phase}: done" if phase != "done" else "done: current — success"
        return f"{phase}: done" if phase != "done" else "done: skipped"
    if cur in order and phase in order:
        if order[phase] < order[cur]:
            extra = ""
            if phase == "intake" and (run_dir / "prompt.md").is_file():
                extra = " — prompt recorded"
            if phase == "validate-spec" and (run_dir / "spec.json").is_file():
                spec, _ = spec_pair(run_dir)
                extra = f" — checkable={spec.get('checkable')}" if spec else ""
                if state.get("spec_sha256"):
                    extra = (extra + " — frozen") if extra else " — frozen"
            if phase == "plan" and (run_dir / "plan.md").is_file():
                extra = " — sequence plan written"
            return f"{phase}: done{extra}"
        return f"{phase}: todo"
    return f"{phase}: todo"


def look_here_lines(run_dir: Path, state: Dict[str, Any], phase: str) -> List[str]:
    lines: List[str] = []

    def add(kind: str, path: Path, why: str, *, missing_ok: bool = False) -> None:
        if path.is_file():
            lines.append(f"{kind}  {path.resolve()}     {why}")
        elif missing_ok:
            lines.append(f"{kind}  {path}     not written yet — create at this path")
        else:
            lines.append(f"{kind}  {path}     {why} (missing)")

    add("required", run_dir / "prompt.md", "original ask", missing_ok=True)
    frozen = "frozen — do not rewrite" if state.get("spec_sha256") and phase != "validate-spec" else "session spec (details)"
    add("required", run_dir / "spec.md", frozen, missing_ok=True)
    add("required", run_dir / "plan.md", "sequence plan pointer", missing_ok=True)
    add("required", canonical_backchain(run_dir), "canonical backchain DAG", missing_ok=True)
    act = ACTIVITIES_DIR / f"{phase}.md"
    add("required", act, "current activity")
    deps = state.get("dep_roots") or {}
    if deps.get("backchain"):
        add(
            "required" if phase in ("plan", "implement") else "if-needed",
            Path(deps["backchain"]) / "SKILL.md",
            "backchain sequence plan",
        )
    if deps.get("review-coverage"):
        add(
            "required" if phase == "residual" else "if-needed",
            Path(deps["review-coverage"]) / "SKILL.md",
            "review-coverage Phase B",
        )
    return lines


def print_packet(run_dir: Path, state: Dict[str, Any], *, prior_running: Optional[Set[str]] = None) -> None:
    phase = str(state.get("phase"))
    dest = forward_dest(state, run_dir)
    missing = missing_for(state, run_dir, dest)
    if dest == "blocked" and phase == "validate-spec":
        pass
    elif dest and legal_edge(phase, dest) == "reason" and dest == "blocked":
        if not (state.get("ask_user") or state.get("blocked_reason")):
            missing = list(missing) + ["--reason required"]
    prompt_txt = (read_text(run_dir / "prompt.md") or str(state.get("prompt") or "")).strip()
    ask_line = prompt_txt.splitlines()[0] if prompt_txt else "(no prompt yet)"
    spec, _ = spec_pair(run_dir)
    print("## You are here")
    for p in MAP_PHASES:
        print(map_line(p, state, run_dir))
    if phase == "blocked":
        print(map_line("blocked", state, run_dir))
    if phase == "halted":
        print("halted: current — residual stopped")
    if phase == "implement":
        classes = classify_steps(run_dir, state)
        for sid in recomputed_step_ids(run_dir):
            print(f"{sid}: {classes.get(sid, 'todo')}")
    print()
    print("## Reminder")
    print(f"Ask: {ask_line}")
    if spec and spec.get("done_sentence"):
        print(f"done_sentence: {spec['done_sentence']}")
        print(f"checkable: {spec.get('checkable')}")
        if state.get("spec_sha256") and phase != "validate-spec":
            print("spec: frozen")
    print(f"You are doing {phase}: {activity_title(phase)}.")
    print()
    print("## Look here")
    print("\n".join(look_here_lines(run_dir, state, phase)))
    print()
    print("## Next prompt")
    print(activity_body(phase, run_dir, state))
    if phase == "implement":
        classes = classify_steps(run_dir, state)
        by_id = steps_by_id(run_dir)
        ds = str((spec or {}).get("done_sentence") or "")
        already = prior_running or set()
        for sid in recomputed_step_ids(run_dir):
            if classes.get(sid) != "running":
                continue
            step = by_id.get(sid) or {"id": sid, "statement": "", "produces": "", "inputs": []}
            prefix = "In flight — do not open a second /goal. " if sid in already else ""
            print(f"{prefix}Next step: `{sid}` — `{step.get('statement') or ''}`.")
            print("Please use `/goal`.")
            print(goal_line(step, ds))
    print()
    print("## When done invoke")
    abs_run = str(run_dir.resolve())
    if phase in ("done", "halted"):
        print("stop — no update")
    elif phase == "implement":
        classes = classify_steps(run_dir, state)
        running = [sid for sid, k in classes.items() if k == "running"]
        for sid in running:
            print(f"After /goal for {sid} succeeds: steer complete-step --run-dir {abs_run} --id {sid}")
            print(f"then invoke steer-next (do not complete-step {sid} before that /goal finishes)")
        print(
            f"on /goal failure for one id: steer clear-step --run-dir {abs_run} --id <id> "
            f"or steer update --run-dir {abs_run} --to blocked --resume-to implement --reason <text>"
        )
        if steps_drained(run_dir, state):
            print(f"steer update --run-dir {abs_run} --to residual")
            print("then invoke steer-next")
    elif dest:
        extra = ""
        if dest == "blocked" or phase == "blocked":
            extra = " --reason <text>"
            if dest == "blocked":
                extra += " --resume-to plan" if phase == "plan" else " --resume-to validate-spec"
        print(f"steer update --run-dir {abs_run} --to {dest}{extra}")
        print("then invoke steer-next")
    else:
        print("stop — no update")
    print()
    print("## Missing")
    if missing:
        for g in missing:
            print(g)
    else:
        print("(none)")


def force_wipe(run_dir: Path) -> None:
    for name in ("spec.md", "spec.json", "plan.md", "plan.json", "implement.json"):
        p = run_dir / name
        if p.is_file() or p.is_symlink():
            p.unlink()
    for dname in ("backchain", "steps"):
        d = run_dir / dname
        if d.is_dir():
            shutil.rmtree(d)


def cmd_init(args: argparse.Namespace) -> int:
    if args.implementer == "devloop":
        die(EXIT_BLOCKED, "--implementer devloop is refused")
    if args.implementer != "host":
        die(EXIT_USAGE, "--implementer must be host")
    run_dir = run_dir_from_arg(args.run_dir, walk=False)
    refuse_package_path(run_dir)
    state_path = run_dir / "state.json"
    if state_path.is_file() and not args.force:
        print(f"reused {state_path}")
        print_packet(run_dir, load_state(run_dir))
        return EXIT_OK
    prompt = args.prompt or ""
    bound = str(Path(args.bound_plan).expanduser().resolve()) if args.bound_plan else ""
    repo = str(Path(args.repo).expanduser().resolve()) if args.repo else str(Path.cwd().resolve())
    with run_lock(run_dir):
        if args.force:
            force_wipe(run_dir)
        run_dir.mkdir(parents=True, exist_ok=True)
        (run_dir / "receipts").mkdir(exist_ok=True)
        if prompt:
            (run_dir / "prompt.md").write_text(prompt.rstrip() + "\n", encoding="utf-8")
        state = default_state(
            run_dir, prompt=prompt, implementer="host", bound_plan=bound, repo=repo
        )
        save_state(run_dir, state, event="init")
    print(f"initialized {run_dir / 'state.json'}")
    print_packet(run_dir, state)
    return EXIT_OK


def cmd_next(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=True)
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        check_frozen_hashes(state, run_dir, None)
        prior = set()
        if str(state.get("phase")) == "implement":
            prior = {sid for sid, k in classify_steps(run_dir, state).items() if k == "running"}
            claimed = claim_ready(run_dir, state)
            if claimed:
                save_state(run_dir, state, event="next:claim")
            else:
                save_state(run_dir, state, event="next")
        else:
            save_state(run_dir, state, event="next")
        print_packet(run_dir, state, prior_running=prior)
    return EXIT_OK


def cmd_status(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=True)
    state = load_state(run_dir)
    state["dep_roots"] = resolve_dep_roots()
    dest = forward_dest(state, run_dir)
    allowed = [
        e["to"]
        for e in load_transitions()["edges"]
        if e.get("from") == state.get("phase")
    ]
    print(
        json.dumps(
            {
                "phase": state.get("phase"),
                "implementer": state.get("implementer"),
                "run_id": state.get("run_id"),
                "attempt": state.get("attempt"),
                "terminal": state.get("terminal"),
                "allowed": allowed,
                "forward": dest,
                "dep_roots": state.get("dep_roots"),
                "artifacts": state.get("artifacts"),
            },
            indent=2,
            sort_keys=True,
        )
    )
    return EXIT_OK


def cmd_update(args: argparse.Namespace) -> int:
    if not args.run_dir:
        die(EXIT_USAGE, "update requires --run-dir")
    run_dir = run_dir_from_arg(args.run_dir, walk=False)
    refuse_package_path(run_dir)
    dest = args.to
    if dest not in PHASES:
        die(EXIT_USAGE, f"unknown --to {dest}")
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        src = str(state.get("phase"))
        need = legal_edge(src, dest)
        if need is None:
            die(EXIT_BLOCKED, f"illegal transition {src} -> {dest}")
        if src == "blocked" and dest != state.get("resume_to"):
            die(EXIT_BLOCKED, f"blocked may only resume to {state.get('resume_to')}")
        check_frozen_hashes(state, run_dir, dest)
        gaps = missing_for(state, run_dir, dest)
        if dest == "blocked":
            resume = (args.resume_to or "").strip()
            if not resume:
                resume = "validate-spec" if src == "validate-spec" else ""
            if resume not in RESUME_PHASES:
                gaps.append("--resume-to required (validate-spec|plan|implement|residual)")
            spec, _ = spec_pair(run_dir)
            reason = (args.reason or "").strip() or (spec or {}).get("ask_user")
            if not (isinstance(reason, str) and reason.strip()):
                gaps.append("--reason or ask_user required")
        elif need == "reason":
            if not (args.reason or "").strip():
                gaps.append("--reason required")
        if gaps:
            die(EXIT_BLOCKED, "; ".join(gaps))
        if dest == "validate-spec":
            text = (read_text(run_dir / "prompt.md") or "").strip()
            state["prompt"] = text
            if src == "blocked":
                state["spec_sha256"] = ""
                state["plan_sha256"] = ""
                clear_steps(run_dir, state)
        if dest == "plan":
            spec, sg = spec_pair(run_dir)
            if sg:
                die(EXIT_BLOCKED, "; ".join(sg))
            state["spec_sha256"] = spec_pair_sha256(run_dir)
            state["plan_sha256"] = ""
            clear_steps(run_dir, state)
        if dest == "implement":
            spec, _ = spec_pair(run_dir)
            more = dag_gaps(run_dir, spec)
            if more:
                die(EXIT_BLOCKED, "; ".join(more))
            state["plan_sha256"] = plan_hash_of(run_dir)
            wrapper = run_dir / "plan.json"
            if wrapper.is_file():
                data = load_json(wrapper)
                if isinstance(data, dict):
                    data["step_ids"] = recomputed_step_ids(run_dir)
                    data["plan_sha256"] = state["plan_sha256"]
                    data["backchain"] = str(canonical_backchain(run_dir))
                    write_json_atomic(wrapper, data)
            if src == "blocked":
                clear_steps(run_dir, state, running_only=True)
            rebuild_implement_summary(run_dir, state)
        if dest == "blocked":
            spec, _ = spec_pair(run_dir)
            state["blocked_from"] = src
            state["blocked_reason"] = (args.reason or "").strip() or (spec or {}).get("ask_user")
            state["ask_user"] = (spec or {}).get("ask_user") or args.reason
            state["resume_to"] = (args.resume_to or "").strip() or (
                "validate-spec" if src == "validate-spec" else src
            )
            state["terminal"] = None
        elif src == "blocked":
            state["blocked_reason"] = args.reason
            state["blocked_from"] = None
            state["ask_user"] = None
            state["resume_to"] = None
        if dest == "done":
            state["terminal"] = "waived" if plan_waiver(state) else "success"
        if dest == "halted":
            state["terminal"] = "halted"
        state["phase"] = dest
        save_state(run_dir, state, event=f"update:{src}->{dest}")
    print(f"updated {src} -> {dest}")
    return EXIT_OK


def cmd_start_step(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=False)
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        refuse_if_blocked_step_cmd(state)
        check_frozen_hashes(state, run_dir, None)
        sid = args.id
        if sid not in steps_by_id(run_dir):
            die(EXIT_BLOCKED, f"unknown step id {sid}")
        plan_hash = str(state.get("plan_sha256") or "")
        rec = load_receipt(run_dir, sid)
        if receipt_matches(rec, plan_hash, "running"):
            die(EXIT_BLOCKED, f"{sid} already running")
        if receipt_matches(rec, plan_hash, "complete"):
            die(EXIT_BLOCKED, f"{sid} already complete")
        step = steps_by_id(run_dir)[sid]
        if not suppliers_complete(step, run_dir, plan_hash):
            die(EXIT_BLOCKED, f"{sid} suppliers not complete")
        write_running_receipt(run_dir, state, sid)
        rebuild_implement_summary(run_dir, state)
        save_state(run_dir, state, event=f"start-step:{sid}")
    print(f"started {args.id}")
    return EXIT_OK


def cmd_complete_step(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=False)
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        refuse_if_blocked_step_cmd(state)
        check_frozen_hashes(state, run_dir, None)
        sid = args.id
        if sid not in steps_by_id(run_dir):
            die(EXIT_BLOCKED, f"unknown step id {sid}")
        plan_hash = str(state.get("plan_sha256") or "")
        rec = load_receipt(run_dir, sid)
        if receipt_matches(rec, plan_hash, "complete"):
            die(EXIT_BLOCKED, f"{sid} already complete")
        if not receipt_matches(rec, plan_hash, "running"):
            die(EXIT_BLOCKED, f"{sid} is not running")
        step = steps_by_id(run_dir)[sid]
        if not suppliers_complete(step, run_dir, plan_hash):
            die(EXIT_BLOCKED, f"{sid} suppliers not complete")
        write_json_atomic(
            receipt_path(run_dir, sid),
            {
                "writer": "steer.complete-step",
                "run_id": state.get("run_id"),
                "id": sid,
                "status": "complete",
                "plan_sha256": plan_hash,
            },
        )
        rebuild_implement_summary(run_dir, state)
        save_state(run_dir, state, event=f"complete-step:{sid}")
    print(f"completed {args.id}")
    return EXIT_OK


def descendant_ids(run_dir: Path, sid: str) -> List[str]:
    children: Dict[str, List[str]] = {}
    for tid, step in steps_by_id(run_dir).items():
        for inp in step.get("inputs") or []:
            if isinstance(inp, dict) and isinstance(inp.get("from"), str):
                children.setdefault(str(inp["from"]), []).append(tid)
    out: List[str] = []
    stack = list(children.get(sid, []))
    seen: Set[str] = set()
    while stack:
        cur = stack.pop()
        if cur in seen:
            continue
        seen.add(cur)
        out.append(cur)
        stack.extend(children.get(cur, []))
    return out


def cmd_clear_step(args: argparse.Namespace) -> int:
    run_dir = run_dir_from_arg(args.run_dir, walk=False)
    with run_lock(run_dir):
        state = load_state(run_dir)
        state["dep_roots"] = resolve_dep_roots()
        refuse_if_blocked_step_cmd(state)
        check_frozen_hashes(state, run_dir, None)
        sid = args.id
        rec = load_receipt(run_dir, sid)
        plan_hash = str(state.get("plan_sha256") or "")
        if not rec or rec.get("plan_sha256") != plan_hash:
            die(EXIT_BLOCKED, f"no hash-matching receipt for {sid}")
        to_clear = [sid] + descendant_ids(run_dir, sid)
        for tid in to_clear:
            path = receipt_path(run_dir, tid)
            if path.is_file() or path.is_symlink():
                path.unlink()
        rebuild_implement_summary(run_dir, state)
        save_state(run_dir, state, event=f"clear-step:{sid}")
    print(f"cleared {args.id}")
    return EXIT_OK


def cmd_capture(args: argparse.Namespace) -> int:
    die(
        EXIT_BLOCKED,
        "capture is not a host-session gate and must not write implement.json",
    )
    return EXIT_BLOCKED


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="steer", description="Session harness (not DevLoop)")
    sub = p.add_subparsers(dest="cmd", required=True)
    ini = sub.add_parser("init")
    ini.add_argument("--prompt", default="")
    ini.add_argument("--run-dir")
    ini.add_argument("--implementer", default="host")
    ini.add_argument("--force", action="store_true")
    ini.add_argument("--bound-plan", default="")
    ini.add_argument("--repo", default="")
    nxt = sub.add_parser("next")
    nxt.add_argument("--run-dir")
    st = sub.add_parser("status")
    st.add_argument("--run-dir")
    up = sub.add_parser("update")
    up.add_argument("--run-dir", required=True)
    up.add_argument("--to", required=True)
    up.add_argument("--reason", default="")
    up.add_argument("--resume-to", default="")
    for name in ("start-step", "complete-step", "clear-step"):
        sp = sub.add_parser(name)
        sp.add_argument("--run-dir", required=True)
        sp.add_argument("--id", required=True)
    cap = sub.add_parser("capture")
    cap.add_argument("--run-dir", required=True)
    cap.add_argument("argv", nargs=argparse.REMAINDER)
    return p


def main(argv: Optional[List[str]] = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    p = build_parser()
    try:
        args = p.parse_args(argv)
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else EXIT_USAGE
        return code if code else EXIT_OK
    try:
        if args.cmd == "init":
            return cmd_init(args)
        if args.cmd == "next":
            return cmd_next(args)
        if args.cmd == "status":
            return cmd_status(args)
        if args.cmd == "update":
            return cmd_update(args)
        if args.cmd == "start-step":
            return cmd_start_step(args)
        if args.cmd == "complete-step":
            return cmd_complete_step(args)
        if args.cmd == "clear-step":
            return cmd_clear_step(args)
        if args.cmd == "capture":
            return cmd_capture(args)
    except BrokenPipeError:
        return EXIT_OK
    return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main())
