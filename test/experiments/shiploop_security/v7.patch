+#!/usr/bin/env python3
+"""Build a private masked review from verified V7 grades and scope receipts."""
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+import re
+import shlex
+import sys
+
+sys.dont_write_bytecode = True
+ROOT = Path(__file__).resolve().parents[1]
+sys.path[:0] = [str(ROOT), str(ROOT / "coordination")]
+from dispatch import cohort_evidence, frozen_inputs
+from v7 import registration as protocol
+from v7.report_context import json_bytes, public_counts, scope_context, write_tree
+
+DIMENSIONS = ("functionality", "security", "preservation")
+VOTES = ("native_complete", *DIMENSIONS, "scope_ok", "usage_complete")
+# Literal labels from the sealed private probe source can be useful to reviewers.
+# Dynamic subject-provided labels and all unstructured details stay in the grade.
+LABEL = re.compile(r"""\b(?:check|call)\(\s*['"](?:functionality|security|preservation)['"]\s*,\s*['"]([^'"\n]{1,100})['"]""")
+
+
+def checked_bool(value):
+    if type(value) is not bool:
+        raise ValueError("check evidence lacks a boolean result")
+    return value
+
+
+def masked_case(evidence, sample, detail):
+    case_dir = evidence / "corpus" / sample["case"]
+    case = protocol.read(case_dir / "case.json")
+    allowed = {label for path in (case_dir / "oracle").glob("*.cjs")
+               for label in LABEL.findall(path.read_text())}
+    row = detail["observation"]
+    if row["valid"] is not True or row["git_context_status"] != "restored_and_verified":
+        raise ValueError("masked review requires a valid context-bound observation")
+    oracle = detail["oracle"]
+    if oracle.get("case_id") != sample["case"] or oracle.get("status") not in ("pass", "fail", "candidate_error"):
+        raise ValueError("masked review lacks complete oracle evidence")
+    public = detail["public"]
+    if len(public) != len(case["public_checks"]):
+        raise ValueError("masked review lacks complete public-check inventory")
+    checks = {"public": [], "oracle": {}}
+    for index, (run, registered) in enumerate(zip(public, case["public_checks"]), 1):
+        command = shlex.split(registered) if isinstance(registered, str) else registered
+        if run["command"] != command:
+            raise ValueError("public check differs from registered command")
+        exit_code, timeout = run["exit"], checked_bool(run["timeout"])
+        if exit_code is not None and type(exit_code) is not int:
+            raise ValueError("invalid public command exit")
+        ok = checked_bool(run["pass"])
+        if ok != (exit_code == 0 and not timeout):
+            raise ValueError("public check status disagrees with exit")
+        checks["public"].append({"index": index, "pass": ok, "exit": exit_code, "timeout": timeout,
+                                 "structure": public_counts(run["stdout"], exit_code, timeout)})
+    for dimension in DIMENSIONS:
+        group = oracle[dimension]
+        results = [{"index": i, "pass": checked_bool(item["pass"]),
+                    **({"name": item["name"]} if item["name"] in allowed else {})}
+                   for i, item in enumerate(group["checks"], 1)]
+        checks["oracle"][dimension] = {"pass": checked_bool(group["pass"]), "checks": results}
+    scope = scope_context(detail["scope"])
+    expected = {"functionality": checks["oracle"]["functionality"]["pass"] and
+                all(check["pass"] for check in checks["public"]),
+                "security": checks["oracle"]["security"]["pass"],
+                "preservation": checks["oracle"]["preservation"]["pass"], "scope_ok": scope["pass"]}
+    if any(row[key] is not value for key, value in expected.items()):
+        raise ValueError("masked check evidence disagrees with observation")
+    return {"masked_id": sample["masked_id"], "case": sample["case"],
+            "observations": {key: checked_bool(row[key]) for key in VOTES},
+            "scope": scope, "checks": checks,
+            "execution_context": {"public_git": "restored_and_verified", "private_runtime_git": False,
+                                  "history": "unmeasured_no_subject_era_canary"}}
+
+
+def build(evidence, grades, output):
+    registration = protocol.read(evidence / "registration.json")
+    protocol.validate_protocol(registration)
+    registration, samples, digest = frozen_inputs(evidence, Path(registration["harness_root"]),
+                                                   registration["harness_head"])
+    cohort = cohort_evidence(evidence, samples, digest)
+    if not cohort["verified"]:
+        raise ValueError("masked review needs healthy source-bound dispatch")
+    _, details = protocol.grade_records(grades, samples, cohort)
+    cases = [masked_case(evidence, sample, detail) for sample, detail in zip(samples, details)]
+    # A comparison keeps the arm grouping blind, and keeps the reverse map private.
+    by_mask = sorted(zip(samples, cases), key=lambda pair: pair[0]["masked_id"])
+    labels = {}
+    for sample, _ in by_mask:
+        labels.setdefault(sample["arm"], f"group-{len(labels) + 1}")
+    for sample, case in by_mask:
+        if registration["comparative"]:
+            case["group"] = labels[sample["arm"]]
+    files = {f"masked/{case['masked_id']}.json": json_bytes(case) for case in cases}
+    files["masked/index.json"] = json_bytes({
+        "schema": "shiploop-security-masked-context/v1", "comparative": registration["comparative"],
+        "samples": sorted(case["masked_id"] for case in cases),
+        "history": "unmeasured_no_subject_era_canary",
+    })
+    files["private/provenance.json"] = json_bytes({
+        "registration_sha256": digest, "grade_manifest_sha256": protocol.digest(
+            (grades / "grade-manifest.json").read_bytes()),
+        "samples": {s["masked_id"]: s["sample_id"] for s in samples}, "groups": labels,
+        "masked_files_sha256": {name: protocol.digest(data) for name, data in sorted(files.items())},
+    })
+    return write_tree(output, files, inputs=(evidence, grades, registration["harness_root"]))
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--evidence", required=True, type=Path)
+    p.add_argument("--grades", required=True, type=Path)
+    p.add_argument("--output", required=True, type=Path)
+    args = p.parse_args()
+    try:
+        result = build(args.evidence.resolve(), args.grades.resolve(), args.output)
+    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as error:
+        p.exit(2, f"Refusing masked review: {error}\n")
+    print(f"Wrote {len(result)} owner-only masked review and provenance files")
+
+
+if __name__ == "__main__":
+    main()
