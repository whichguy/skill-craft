+def runtime_identity(env=None):
+    """Resolve the actual bare commands in the same absolute PATH used by public checks."""
+    env = os.environ if env is None else env
+    path = env.get("PATH", "")
+    if not path or not all(Path(part).is_absolute() for part in path.split(os.pathsep)):
+        raise ValueError("runtime PATH must contain only absolute entries")
+    def binary(command):
+        found = shutil.which(command, path=path)
+        if not found:
+            raise ValueError(f"{command} is not resolvable on runtime PATH")
+        return Path(found).resolve(strict=True)
+    node, python3, git = binary("node"), binary("python3"), binary("git")
+    python = Path(sys.executable).resolve(strict=True)
+    if python3 != python:
+        raise ValueError("runtime PATH python3 differs from the executing Python interpreter")
+    # Keep only selected execution controls; hashes avoid retaining their contents.
+    controls = {key: hashlib.sha256(env[key].encode()).hexdigest()
+                for key in ("NODE_OPTIONS", "NODE_PATH", "PYTHONHOME", "PYTHONPATH", "SHELL",
+                            "TMPDIR", "LANG", "LC_ALL") if key in env}
+    return {"path": path, "git": {"exe": str(git), "sha256": sha(git)}, "node": {"exe": str(node), "sha256": sha(node)},
+            "python": {"exe": str(python), "version": sys.version, "sha256": sha(python)},
+            "environment_sha256": controls}
+
