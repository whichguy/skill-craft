{
  "case": "grok-chat-outcome",
  "run_kind": "create",
  "product_cwd": "/absolute/attempt-output/work",
  "target": {
    "org_id": "<canonical 18-character org ID>",
    "user_id": "<canonical 18-character user ID>",
    "selector": "example-operator-alias",
    "username": "operator@example.test"
  },
  "namespace": "NewAppExample",
  "legacy_prefixes": ["RetiredAppExample"],
  "provider": {"reference": "ExampleNamedCredential", "endpoint": "https://api.x.ai", "model": "<current authorized grok model>"},
  "synthetic_label": "ShipLoop E2E synthetic example",
  "sf_bin": "/absolute/tools/sf",
  "tool_dirs": ["/absolute/tools"],
  "prompt_sha256": "<current BUILDER_PROMPT.md SHA256>",
  "source_readiness_sha256": "<current READINESS.json SHA256>",
  "receipts": {
    "authority": {"path": "/absolute/operator/authority-binding.json", "sha256": "<receipt SHA256>"},
    "retirement": {"path": "/absolute/operator/retirement-binding.json", "sha256": "<receipt SHA256>"},
    "observer": {"path": "/absolute/operator/observer-binding.json", "sha256": "<receipt SHA256>"}
  }
}
