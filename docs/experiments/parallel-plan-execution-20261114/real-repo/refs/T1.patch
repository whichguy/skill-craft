new file mode 100644
index 0000000..261eb86
--- /dev/null
+++ b/test/assignment-system.test.js
@@ -0,0 +1,69 @@
+'use strict';
+
+// System coverage for assignment, notifications, persisted state and the operator CLI (R-1 through R-4).
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { spawn, execFileSync } = require('node:child_process');
+const { client, ticketBody } = require('./helpers');
+
+async function start(dataFile, notifyFile) {
+  const child = spawn('npm', ['start'], {
+    cwd: path.join(__dirname, '..'), detached: true,
+    env: { ...process.env, PORT: '0', DATA_FILE: dataFile, NOTIFY_FILE: notifyFile, WORKER_INTERVAL_MS: '10' },
+    stdio: ['ignore', 'pipe', 'pipe'],
+  });
+  let stderr = '';
+  child.stderr.on('data', (chunk) => { stderr += chunk.toString(); });
+  const end = Date.now() + 5000;
+  while (Date.now() < end) {
+    const match = stderr.match(/tickets listening on (\d+)/);
+    if (match) return { child, port: Number(match[1]) };
+    if (child.exitCode !== null) throw new Error(`service exited ${child.exitCode}: ${stderr}`);
+    await new Promise((resolve) => setTimeout(resolve, 10));
+  }
+  try { process.kill(-child.pid, 'SIGTERM'); } catch (error) { if (error.code !== 'ESRCH') throw error; }
+  throw new Error(`service did not start: ${stderr}`);
+}
+
+async function stop(child) {
+  if (child.exitCode !== null || child.signalCode !== null) return;
+  const exited = new Promise((resolve) => child.once('exit', resolve));
+  try { process.kill(-child.pid, 'SIGTERM'); } catch (error) { if (error.code !== 'ESRCH') throw error; }
+  await exited;
+}
+
+test('ST_1 npm start delivers assignment and restores it for API and CLI', async (t) => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'ticket-system-'));
+  const data = path.join(dir, 'tickets.json');
+  const notifications = path.join(dir, 'notifications.jsonl');
+  let server;
+  t.after(async () => { if (server) await stop(server.child); fs.rmSync(dir, { recursive: true, force: true }); });
+  server = await start(data, notifications);
+  let api = client(`http://127.0.0.1:${server.port}`);
+  const ticket = (await api.post('/tickets', ticketBody())).body;
+  assert.equal((await api.put(`/tickets/${ticket.id}/assignee`, { assignee: 'Dana' })).body.assignee, 'Dana');
+  const end = Date.now() + 3000;
+  let delivered = [];
+  while (Date.now() < end) {
+    if (fs.existsSync(notifications)) delivered = fs.readFileSync(notifications, 'utf8').trim().split('\n').filter(Boolean).map(JSON.parse);
+    if (delivered.some((item) => item.type === 'ticket.assigned' && item.to === 'Dana')) break;
+    await new Promise((resolve) => setTimeout(resolve, 10));
+  }
+  assert.ok(delivered.some((item) => item.type === 'ticket.assigned' && item.to === 'Dana' && /assigned to you/i.test(item.body)));
+  api.close();
+  await stop(server.child);
+  server = await start(data, notifications);
+  api = client(`http://127.0.0.1:${server.port}`);
+  try {
+    assert.equal((await api.get(`/tickets/${ticket.id}`)).body.assignee, 'Dana');
+    assert.deepEqual((await api.get('/tickets?assignee=Dana&status=open')).body.items.map((item) => item.id), [ticket.id]);
+    const raw = execFileSync(process.execPath, ['bin/tickets.js', '--data', data, 'list', '--raw'], { cwd: path.join(__dirname, '..'), encoding: 'utf8' });
+    assert.equal(raw.trimEnd().split('\t')[4], 'Dana');
+    const report = JSON.parse(execFileSync(process.execPath, ['scripts/weekly-report.js', '--data', data, '--json'], { cwd: path.join(__dirname, '..'), encoding: 'utf8' }));
+    assert.equal(report.total, 1);
+    assert.equal(report.byStatus.open, 1);
+  } finally { api.close(); }
+});
