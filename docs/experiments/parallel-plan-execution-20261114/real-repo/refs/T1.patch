+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { TicketStore } = require('../src/store');
+const { manualClock } = require('../src/clock');
+const { render } = require('../src/templates');
+
+test('TC_1 assignment changes are audited and notify each newly assigned agent', () => {
+  const store = new TicketStore({ clock: manualClock() });
+  const ticket = store.create({ title: 'Printer', priority: 'normal', requester: 'requester' }, 'operator');
+  assert.equal(ticket.assignee, null);
+  assert.throws(() => store.assign(ticket.id, 'x'.repeat(65), 'operator'), { code: 'invalid' });
+  assert.equal(store.assign(ticket.id, 'x'.repeat(64), 'operator').assignee.length, 64);
+  store.assign(ticket.id, null, 'operator');
+  const previousNotices = store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned').length;
+  const previousChanges = store.history(ticket.id).filter((entry) => entry.action === 'ticket.assigned').length;
+  assert.equal(store.assign(ticket.id, 'Joe', 'operator').assignee, 'Joe');
+  const assigned = () => store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned').slice(previousNotices);
+  assert.deepEqual(assigned().map((event) => event.to), ['Joe']);
+  assert.match(render(assigned()[0]).body, /assigned to you/i);
+  const snapshot = store.snapshot();
+  store.assign(ticket.id, 'Joe', 'operator');
+  assert.deepEqual(store.snapshot(), snapshot);
+  store.assign(ticket.id, 'Ann', 'operator');
+  store.assign(ticket.id, 'Joe', 'operator');
+  assert.deepEqual(assigned().map((event) => event.to), ['Joe', 'Ann', 'Joe']);
+  assert.equal(store.history(ticket.id).filter((entry) => entry.action === 'ticket.assigned').length, previousChanges + 3);
+  store.assign(ticket.id, null, 'operator');
+  assert.equal(store.get(ticket.id).assignee, null);
+  assert.equal(assigned().length, 3);
+  store.transition(ticket.id, 'in_progress', 'operator');
+  store.assign(ticket.id, 'Ann', 'operator');
+  store.transition(ticket.id, 'resolved', 'operator');
+  for (const status of ['resolved', 'closed']) {
+    if (status === 'closed') store.transition(ticket.id, 'closed', 'operator');
+    const before = store.snapshot();
+    for (const value of ['Joe', null]) {
+      assert.throws(() => store.assign(ticket.id, value, 'operator'), { code: 'conflict' });
+      assert.deepEqual(store.snapshot(), before);
+    }
+  }
+});
+
