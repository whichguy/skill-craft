+    assert.equal((await api.put('/tickets/T-9999/assignee', { assignee: 'Joe' })).status, 404);
+    const first = await api.put(url, { assignee: 'x'.repeat(64) }, { 'X-Actor': 'Dana' });
+    assert.equal(first.status, 200);
+    assert.equal(first.body.assignee, 'x'.repeat(64));
+    assert.equal(service.store.history(id).at(-1).actor, 'Dana');
+    const before = service.store.snapshot();
+    assert.equal((await api.put(url, { assignee: 'x'.repeat(64) })).status, 200);
+    assert.deepEqual(service.store.snapshot(), before);
+    assert.equal((await api.put(url, { assignee: null })).body.assignee, null);
+    await api.post(`/tickets/${id}/transition`, { to: 'in_progress' });
+    assert.equal((await api.put(url, { assignee: 'Joe' })).body.assignee, 'Joe');
+    service.worker.tick();
+    const message = service.notifier.delivered.find((event) => event.type === 'ticket.assigned' && event.to === 'Joe');
+    assert.ok(message);
+    assert.match(message.body, /assigned to you/i);
+    await api.post(`/tickets/${id}/transition`, { to: 'resolved' });
+    for (const state of ['resolved', 'closed']) {
+      if (state === 'closed') await api.post(`/tickets/${id}/transition`, { to: 'closed' });
+      for (const value of ['Ann', null]) {
+        const snapshot = service.store.snapshot();
+        const response = await api.put(url, { assignee: value });
+        assert.equal(response.status, 409);
+        assert.equal(response.body.error.code, 'conflict');
+        assert.deepEqual(service.store.snapshot(), snapshot);
+      }
+    }
+  });
+});
