+test('TC_4 listing intersects all filters and CLI displays assignees', async (t) => {
+  const fs = require('node:fs');
+  const os = require('node:os');
+  const path = require('node:path');
+  const { withService, ticketBody } = require('./helpers');
+  const { main } = require('../bin/tickets');
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'assignment-list-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const file = path.join(dir, 'data.json');
+  await withService({ dataFile: file }, async (api) => {
+    const tickets = [];
+    for (const priority of ['high', 'high', 'low', 'high', 'high']) {
+      tickets.push((await api.post('/tickets', ticketBody({ priority }))).body);
+    }
+    for (const index of [0, 1, 2, 3]) {
+      await api.put(`/tickets/${tickets[index].id}/assignee`, { assignee: index === 3 ? 'Ann' : 'Joe' });
+    }
+    await api.post(`/tickets/${tickets[1].id}/transition`, { to: 'in_progress' });
+    const query = '/tickets?status=open&priority=high&assignee=Joe&limit=1';
+    const page = (await api.get(query)).body;
+    assert.deepEqual(page.items.map((ticket) => ticket.id), [tickets[0].id]);
+    assert.equal(page.next, null);
+    const unassigned = (await api.get('/tickets?assignee=')).body.items;
+    assert.deepEqual(unassigned.map((ticket) => ticket.id), [tickets[4].id]);
+    const assigned = (await api.get('/tickets?assignee=Joe&limit=1')).body;
+    assert.equal(assigned.items[0].id, tickets[0].id);
+    assert.ok(assigned.next);
+    const next = (await api.get(`/tickets?assignee=Joe&limit=1&cursor=${encodeURIComponent(assigned.next)}`)).body;
+    assert.equal(next.items[0].id, tickets[1].id);
+    let output = '';
+    const out = { write: (text) => { output += text; } };
+    const err = { write: (text) => { throw new Error(text); } };
+    assert.equal(main(['--data', file, 'list'], { env: {}, out, err }), 0);
+    assert.match(output, /ASSIGNEE/);
+    assert.match(output, /Joe/);
+    assert.match(output, /Ann/);
+    output = '';
+    assert.equal(main(['--data', file, 'list', '--raw'], { env: {}, out, err }), 0);
+    const rows = output.trimEnd().split('\n').map((line) => line.split('\t'));
+    assert.deepEqual(rows[0], [tickets[0].id, 'open', 'high', tickets[0].title, 'Joe']);
+    assert.deepEqual(rows[4].slice(0, 4), [tickets[4].id, 'open', 'high', tickets[4].title]);
+    assert.equal(rows[4][4] ?? '', '');
+  });
+});
+
+test('TC_4 (a) repeated filters all constrain the listing', async () => {
+  const { withService, ticketBody } = require('./helpers');
+  await withService({}, async (api) => {
+    const ticket = (await api.post('/tickets', ticketBody({ priority: 'high' }))).body;
+    await api.put(`/tickets/${ticket.id}/assignee`, { assignee: 'Joe' });
+    assert.equal((await api.get('/tickets?assignee=Joe&assignee=Joe')).body.items.length, 1);
+    assert.deepEqual((await api.get('/tickets?assignee=Joe&assignee=Ann')).body.items, []);
+    assert.deepEqual((await api.get('/tickets?status=open&status=in_progress')).body.items, []);
+    assert.equal((await api.get('/tickets?priority=high&priority=invalid')).status, 400);
+  });
