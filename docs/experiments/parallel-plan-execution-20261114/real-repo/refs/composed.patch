+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { systemClock } = require('../src/clock');
+const { ticketBody, withService } = require('./helpers');
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'ticket-import-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+test('TC_1 imports empty and ordered tickets with single-create normalization', async () => {
+  await withService({}, async (api) => {
+    assert.deepEqual(await api.post('/tickets/import', { tickets: [] }).then(({ status, body }) => ({ status, body })),
+      { status: 201, body: { created: 0, ids: [] } });
+    const tickets = [ticketBody({ title: ' First ', requester: ' Alice ', priority: undefined }),
+      ticketBody({ title: 'Second', requester: 'Bob', priority: 'urgent' })];
+    const response = await api.post('/tickets/import', { tickets });
+    assert.equal(response.status, 201);
+    assert.deepEqual(response.body, { created: 2, ids: ['T-0001', 'T-0002'] });
+    const first = (await api.get('/tickets/T-0001')).body;
+    const second = (await api.get('/tickets/T-0002')).body;
+    assert.deepEqual([first.title, first.requester, first.priority, first.status], ['First', 'Alice', 'normal', 'open']);
+    assert.deepEqual([second.title, second.requester, second.priority], ['Second', 'Bob', 'urgent']);
+  });
+});
+
+test('TC_2 invalid imports identify first invalid item and leave all state and IDs unchanged', async () => {
+  await withService({}, async (api, service) => {
+    assert.equal((await api.post('/tickets', ticketBody())).status, 201);
+    const before = service.store.snapshot();
+    const cases = [
+      [{}, null], [{ tickets: null }, null], [{ tickets: {} }, null],
+      [{ tickets: Array.from({ length: 5001 }, () => ticketBody()) }, null],
+      [{ tickets: [null, ticketBody()] }, 0], [{ tickets: ['bad'] }, 0],
+      [{ tickets: [ticketBody(), {}, null] }, 1],
+      [{ tickets: [ticketBody(), ticketBody(), ticketBody({ priority: 'bad' })] }, 2],
+    ];
+    for (const [body, index] of cases) {
+      const response = await api.post('/tickets/import', body);
+      assert.equal(response.status, 400);
+      assert.equal(response.body.error.code, 'invalid');
+      if (index !== null) assert.match(response.body.error.message, new RegExp(`index ${index}\\b`));
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+    // The import body is bounded even when the JSON itself is a valid empty batch.
+    const oversized = '{\"tickets\":[]}' + ' '.repeat(10 * 1024 * 1024);
+    assert.equal((await api.post('/tickets/import', oversized)).status, 400);
+    assert.deepEqual(service.store.snapshot(), before);
+    const invalidActor = await api.post('/tickets/import', { tickets: [ticketBody()] }, { 'X-Actor': 'x'.repeat(65) });
+    assert.equal(invalidActor.status, 400);
+    assert.deepEqual(service.store.snapshot(), before);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+  });
+});
+
+test('TC_3 imported audit and notification events survive restart and are delivered', async (t) => {
+  const dir = folder(t);
+  const dataFile = path.join(dir, 'tickets.json');
+  const notifyFile = path.join(dir, 'notifications.jsonl');
+  await withService({ dataFile }, async (api) => {
+    const res = await api.post('/tickets/import', { tickets: [ticketBody({ requester: 'a@example.com' }),
+      ticketBody({ requester: 'b@example.com' })] }, { 'X-Actor': 'operator' });
+    assert.equal(res.status, 201);
+    for (const id of res.body.ids) {
+      const audit = (await api.get(`/tickets/${id}/audit`)).body.items;
+      assert.equal(audit.length, 1);
+      assert.equal(audit[0].action, 'ticket.created');
+      assert.equal(audit[0].actor, 'operator');
+      assert.equal(audit[0].changes.status.to, 'open');
+    }
+    const pending = (await api.get('/admin/outbox')).body.pending;
+    assert.deepEqual(pending.map((event) => [event.type, event.to, event.ticket]), [
+      ['ticket.created', 'a@example.com', 'T-0001'], ['ticket.created', 'b@example.com', 'T-0002'],
+    ]);
+  });
+  await withService({ dataFile, notifyFile, workerIntervalMs: 10, clock: systemClock }, async (api) => {
+    assert.equal((await api.get('/tickets/T-0001/audit')).body.items[0].actor, 'operator');
+    const end = Date.now() + 3000;
+    let sent = [];
+    while (Date.now() < end) {
+      sent = (await api.get('/admin/outbox')).body.sent;
+      if (sent.length === 2) break;
+      await new Promise((resolve) => setTimeout(resolve, 10));
+    }
+    assert.equal(sent.length, 2);
+    const delivered = fs.readFileSync(notifyFile, 'utf8').trim().split('\n').map((line) => JSON.parse(line));
+    assert.deepEqual(delivered.map(({ to, ticket }) => [to, ticket]), [
+      ['a@example.com', 'T-0001'], ['b@example.com', 'T-0002'],
+    ]);
+  });
+});
+
+test('TC_4 imports 5000 tickets with a data file within ten seconds', async (t) => {
+  const dataFile = path.join(folder(t), 'tickets.json');
+  await withService({ dataFile }, async (api) => {
+    const tickets = Array.from({ length: 5000 }, (_, i) => ticketBody({ title: `Ticket ${i}` }));
+    const start = performance.now();
+    const response = await api.post('/tickets/import', { tickets });
+    const elapsed = performance.now() - start;
+    assert.equal(response.status, 201);
+    assert.equal(response.body.created, 5000);
+    assert.deepEqual(response.body.ids, tickets.map((_, i) => `T-${String(i + 1).padStart(4, '0')}`));
+    assert.ok(elapsed < 10000, `import took ${elapsed.toFixed(0)}ms`);
+    const saved = JSON.parse(fs.readFileSync(dataFile, 'utf8'));
+    assert.equal(saved.tickets.length, 5000);
+    assert.equal(saved.audit.length, 5000);
+    assert.equal(saved.outbox.events.length, 5000);
+  });
+});
