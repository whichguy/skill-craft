+
+test('TC_1 assignment changes are audited and notify each newly assigned agent', () => {
+  const store = new TicketStore({ clock: manualClock() });
+  const ticket = store.create({ title: 'Printer', priority: 'normal', requester: 'requester' }, 'operator');
+  assert.equal(ticket.assignee, null);
+  assert.throws(() => store.assign(ticket.id, 'x'.repeat(65), 'operator'), { code: 'invalid' });
+  assert.equal(store.assign(ticket.id, 'x'.repeat(64), 'operator').assignee.length, 64);
