+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { TicketStore } = require('../src/store');
+const validate = require('../src/tickets/validate');
+const { ticketBody, withService } = require('./helpers');
+
+const batch = (count, make = (i) => ticketBody({ title: `Imported ticket ${i}`, requester: `user${i}@example.com` })) =>
+  ({ tickets: Array.from({ length: count }, (_, i) => make(i)) });
+
+const envelope = (response, status, code) => {
+  assert.equal(response.status, status, JSON.stringify(response.body));
+  assert.equal(response.body.error.code, code);
+};
+
+describe('POST /tickets/import', () => {
+  test('creates the tickets in order and answers 201 with the count and the ids', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody({ title: 'Existing' }));
+      const response = await api.post('/tickets/import', {
+        tickets: [ticketBody({ title: 'First', priority: 'low' }), { title: 'Second', requester: 'b@example.com' }, ticketBody({ title: 'Third', priority: 'urgent' })],
+      });
+      assert.equal(response.status, 201);
+      assert.deepEqual(response.body, { created: 3, ids: ['T-0002', 'T-0003', 'T-0004'] });
+      const listed = (await api.get('/tickets?limit=100')).body.items;
+      assert.deepEqual(listed.map((ticket) => ticket.title), ['Existing', 'First', 'Second', 'Third']);
+      assert.deepEqual(listed.slice(1).map((ticket) => [ticket.status, ticket.priority]), [['open', 'low'], ['open', 'normal'], ['open', 'urgent']]);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0005');
+    });
+  });
+
+  test('records each ticket in the audit log with the actor, and notifies its requester', async () => {
+    await withService({}, async (api, service) => {
+      await api.post('/tickets/import', batch(3), { 'X-Actor': 'migration' });
+      for (const id of ['T-0001', 'T-0002', 'T-0003']) {
+        const history = (await api.get(`/tickets/${id}/audit`)).body.items;
+        assert.equal(history.length, 1);
+        assert.equal(history[0].action, 'ticket.created');
+        assert.equal(history[0].actor, 'migration');
+      }
+      const { pending } = (await api.get('/admin/outbox')).body;
+      assert.deepEqual(pending.map((event) => [event.type, event.to, event.ticket]), [
+        ['ticket.created', 'user0@example.com', 'T-0001'],
+        ['ticket.created', 'user1@example.com', 'T-0002'],
+        ['ticket.created', 'user2@example.com', 'T-0003'],
+      ]);
+      assert.equal(service.store.dueNotifications().length, 3);
+    });
+  });
+
+  test('creates nothing and names the first invalid item by its index', async () => {
+    await withService({}, async (api) => {
+      const bad = batch(5);
+      bad.tickets[3] = ticketBody({ title: '' });
+      bad.tickets[4] = ticketBody({ priority: 'asap' });
+      const response = await api.post('/tickets/import', bad);
+      envelope(response, 400, 'invalid');
+      assert.match(response.body.error.message, /tickets\[3\]/);
+      assert.match(response.body.error.message, /title/);
+      assert.deepEqual((await api.get('/tickets')).body.items, []);
+      assert.deepEqual((await api.get('/admin/outbox')).body.pending, []);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0001');
+    });
+  });
+
+  test('names index 0 for the first item', async () => {
+    await withService({}, async (api) => {
+      const response = await api.post('/tickets/import', { tickets: [ticketBody({ owner: 'dana' }), ticketBody()] });
+      envelope(response, 400, 'invalid');
+      assert.match(response.body.error.message, /tickets\[0\]/);
+      assert.match(response.body.error.message, /owner/);
+    });
+  });
+
+  test('refuses items that are not objects', async () => {
+    await withService({}, async (api) => {
+      for (const item of [null, 'a ticket', 7, [], true]) {
+        const response = await api.post('/tickets/import', { tickets: [ticketBody(), item] });
+        envelope(response, 400, 'invalid');
+        assert.match(response.body.error.message, /tickets\[1\]/);
+      }
+      assert.deepEqual((await api.get('/tickets')).body.items, []);
+    });
+  });
+
+  test('refuses a body without a list of tickets, or with other fields', async () => {
+    await withService({}, async (api) => {
+      envelope(await api.post('/tickets/import', {}), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: 'many' }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: {} }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [], extra: 1 }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', []), 400, 'invalid');
+      envelope(await api.post('/tickets/import', '{"tickets":'), 400, 'invalid');
+    });
+  });
+
+  test('takes at most 5000 tickets', async () => {
+    assert.equal(validate.MAX_IMPORT, 5000);
+    await withService({}, async (api) => {
+      envelope(await api.post('/tickets/import', batch(5001, () => ({ title: 't', requester: 'r' }))), 400, 'invalid');
+      assert.deepEqual((await api.get('/tickets')).body.items, []);
+    });
+  });
+
+  test('an empty list creates nothing', async () => {
+    await withService({}, async (api) => {
+      const response = await api.post('/tickets/import', { tickets: [] });
+      assert.equal(response.status, 201);
+      assert.deepEqual(response.body, { created: 0, ids: [] });
+    });
+  });
+
+  test('is not taken for a ticket id, and only answers POST', async () => {
+    await withService({}, async (api) => {
+      envelope(await api.get('/tickets/import'), 404, 'not_found');
+    });
+  });
+
+  test('5000 tickets are imported with a data file within 10 seconds, whatever MAX_BODY_BYTES says', async () => {
+    const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'import-test-'));
+    const dataFile = path.join(directory, 'tickets.json');
+    try {
+      await withService({ dataFile, maxBodyBytes: 1024 }, async (api, service) => {
+        const body = batch(5000, (i) => ticketBody({ title: `Ticket from the old tracker, number ${i}`, requester: `user${i}@example.com` }));
+        const started = Date.now();
+        const response = await api.post('/tickets/import', body);
+        const elapsed = Date.now() - started;
+        assert.equal(response.status, 201, JSON.stringify(response.body).slice(0, 300));
+        assert.equal(response.body.created, 5000);
+        assert.equal(response.body.ids.length, 5000);
+        assert.equal(response.body.ids[0], 'T-0001');
+        assert.equal(response.body.ids[4999], 'T-5000');
+        assert.ok(elapsed < 10000, `the import took ${elapsed} ms`);
+        assert.equal(service.store.dueNotifications().length, 5000);
+        assert.equal(service.store.audit.size, 5000);
+      });
+      const saved = JSON.parse(fs.readFileSync(dataFile, 'utf8'));
+      assert.equal(saved.tickets.length, 5000);
+      assert.equal(saved.outbox.events.length, 5000);
+      assert.equal(saved.nextNumber, 5001);
+    } finally {
+      fs.rmSync(directory, { recursive: true, force: true });
+    }
+  });
+});
+
+describe('TicketStore.importTickets', () => {
+  const input = (overrides = {}) => ({ title: 'Laptop will not boot', requester: 'li@example.com', priority: 'normal', ...overrides });
+
+  test('saves once for the whole import', () => {
+    const saves = [];
+    const store = new TicketStore({ clock: manualClock(), persistence: { save: (state) => saves.push(state) } });
+    store.importTickets([input(), input(), input()], 'dana');
+    assert.equal(saves.length, 1);
+    assert.equal(saves[0].tickets.length, 3);
+  });
+
+  test('takes everything back when the save fails', () => {
+    const store = new TicketStore({ clock: manualClock(), persistence: { save() { throw new Error('disk full'); } } });
+    assert.throws(() => store.importTickets([input(), input()], 'dana'), /disk full/);
+    assert.equal(store.tickets.size, 0);
+    assert.equal(store.audit.size, 0);
+    assert.deepEqual(store.outbox.toJSON(), { nextId: 1, events: [] });
+    assert.equal(store.nextNumber, 1);
+  });
+});
