+  test('takes an agent name, trimmed, or null', () => {
+    assert.equal(assignment({ assignee: ' sam ' }), 'sam');
+    assert.equal(assignment({ assignee: 'x'.repeat(64) }), 'x'.repeat(64));
+    assert.equal(assignment({ assignee: null }), null);
+  });
+
+  test('refuses anything else', () => {
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 7 }, { assignee: 'x'.repeat(65) },
+      { assignee: 'a\tb' }, { assignee: 'sam', extra: 1 }]) {
+      assert.throws(() => assignment(body), InvalidError, JSON.stringify(body));
+    }
+  });
+});
+
+describe('TicketStore.assign', () => {
+  test('a new ticket is unassigned', () => {
+    const { store } = newStore();
+    assert.equal(store.create(input(), 'dana').assignee, null);
+  });
+
+  test('assigns, reassigns and unassigns, with an audit entry for each change', () => {
+    const { clock, store } = newStore();
+    store.create(input(), 'dana');
+    clock.advance?.(1000);
+    assert.equal(store.assign('T-0001', 'sam', 'dana').assignee, 'sam');
+    assert.equal(store.assign('T-0001', 'kim', 'dana').assignee, 'kim');
+    assert.equal(store.assign('T-0001', null, 'dana').assignee, null);
+    const entries = store.history('T-0001').slice(1);
+    assert.deepEqual(entries.map((entry) => [entry.action, entry.changes]), [
+      ['ticket.assigned', { assignee: { from: null, to: 'sam' } }],
+      ['ticket.assigned', { assignee: { from: 'sam', to: 'kim' } }],
+      ['ticket.assigned', { assignee: { from: 'kim', to: null } }],
+    ]);
+  });
+
+  test('assigning to the current agent changes nothing', () => {
+    const { clock, store } = newStore();
+    store.create(input(), 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    const before = store.get('T-0001');
+    const audit = store.history('T-0001').length;
+    const pending = store.outboxReport().pending.length;
+    clock.advance?.(60000);
+    assert.deepEqual(store.assign('T-0001', 'sam', 'dana'), before);
+    assert.equal(store.history('T-0001').length, audit);
+    assert.equal(store.outboxReport().pending.length, pending);
