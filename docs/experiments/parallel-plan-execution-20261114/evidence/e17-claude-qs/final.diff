+      await api.post('/tickets', ticketBody());
+      assert.equal((await api.patch('/tickets/T-0001', { due: START })).status, 400);
+    });
+  });
+
+  test('?overdue=true lists only the open and in-progress tickets that are past due', async () => {
+    const clock = manualClock(START);
+    await withService({ clock, dueTimes: true }, async (api) => {
+      await seeded(api, clock); // 30 hours on: urgent (4 h) and high (24 h) are past due, normal and low are not
+      const ids = async (query) => (await api.get(`/tickets${query}`)).body.items.map((item) => item.id);
+      assert.deepEqual(await ids('?overdue=true'), ['T-0001', 'T-0002']);
+      assert.deepEqual(await ids('?overdue=false'), ['T-0003', 'T-0004']);
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.deepEqual(await ids('?overdue=true'), ['T-0001', 'T-0002'], 'in progress still counts');
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+      assert.deepEqual(await ids('?overdue=true'), ['T-0002'], 'a resolved ticket is not overdue');
+      await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+      await api.post('/tickets/T-0002/transition', { to: 'resolved' });
+      await api.post('/tickets/T-0002/transition', { to: 'closed' });
+      assert.deepEqual(await ids('?overdue=true'), [], 'nor is a closed one');
+      clock.advance(50 * HOUR); // 80 hours on: the normal ticket is now past due too
+      assert.deepEqual(await ids('?overdue=true'), ['T-0003']);
+      assert.deepEqual(await ids('?overdue=true&priority=low'), []);
+      assert.deepEqual(await ids('?overdue=true&status=resolved'), []);
+    });
+  });
+
+  test('a ticket becomes overdue only once its due time has passed', async () => {
+    const clock = manualClock(START);
+    await withService({ clock, dueTimes: true }, async (api) => {
+      await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      const overdue = async () => (await api.get('/tickets?overdue=true')).body.items.length;
+      clock.advance(4 * HOUR - 1);
+      assert.equal(await overdue(), 0);
+      clock.advance(2);
+      assert.equal(await overdue(), 1);
+    });
+  });
+
+  test('the overdue listing pages with cursors', async () => {
+    const clock = manualClock(START);
+    await withService({ clock, dueTimes: true }, async (api) => {
+      for (let n = 0; n < 5; n += 1) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      await api.post('/tickets', ticketBody({ priority: 'low' }));
+      clock.advance(5 * HOUR);
+      const first = (await api.get('/tickets?overdue=true&limit=3')).body;
+      assert.deepEqual(first.items.map((item) => item.id), ['T-0001', 'T-0002', 'T-0003']);
+      const second = (await api.get(`/tickets?overdue=true&limit=3&cursor=${first.next}`)).body;
+      assert.deepEqual(second.items.map((item) => item.id), ['T-0004', 'T-0005']);
+      assert.equal(second.next, null);
+    });
+  });
+
+  test('a value other than true or false is refused', async () => {
+    await withService({ dueTimes: true }, async (api) => {
+      const response = await api.get('/tickets?overdue=soon');
+      assert.equal(response.status, 400);
+      assert.equal(response.body.error.code, 'invalid');
+    });
+  });
+
+  test('uses the hours it is configured with', async () => {
+    const clock = manualClock(START);
+    const config = loadConfig({ DUE_TIMES: 'on', RESPONSE_HOURS_URGENT: '1', RESPONSE_HOURS_NORMAL: '10' });
+    await withService({ clock, dueTimes: config.dueTimes, responseHours: config.responseHours }, async (api) => {
+      assert.equal((await api.post('/tickets', ticketBody({ priority: 'urgent' }))).body.due, plus(START, 1));
+      assert.equal((await api.post('/tickets', ticketBody({ priority: 'normal' }))).body.due, plus(START, 10));
+      assert.equal((await api.post('/tickets', ticketBody({ priority: 'high' }))).body.due, plus(START, 24));
+    });
+  });
+});
+
+describe('the data file', () => {
+  test('holds every ticket\'s due time, and is still version 1', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const store = openStore(file);
+    store.create({ title: 'VPN', requester: 'a@example.com', priority: 'high' }, 'dana');
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(document.version, 1, 'release 1.4.0 refuses any other version');
+    assert.equal(document.tickets[0].due, plus(START, 24));
+  });
+
+  test('gives the tickets of an older file their due time from their creation time and priority, and saves it', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    const store = openStore(file, { showDue: true });
+    assert.deepEqual(store.list().items.map((ticket) => ticket.due), [
+      '2025-08-01T14:00:00.000Z', // urgent, +4 h
+      '2025-08-03T11:30:00.000Z', // high, +24 h
+      '2025-08-06T12:00:00.000Z', // normal, +72 h
+      '2025-08-11T13:15:00.000Z', // low, +168 h
+    ]);
+    const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.deepEqual(saved.tickets.map((ticket) => ticket.due), store.list().items.map((ticket) => ticket.due));
+    assert.deepEqual(saved.tickets.map((ticket) => ticket.updated), saved.tickets.map((ticket) => ticket.created), 'nothing else moved');
+    assert.deepEqual(saved.audit, []);
+  });
+
+  test('backfills the file whether or not due times are on, and shows nothing while they are off', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    const store = openStore(file);
+    assert.equal('due' in store.get('T-0001'), false);
+    assert.equal(JSON.parse(fs.readFileSync(file, 'utf8')).tickets[0].due, '2025-08-01T14:00:00.000Z');
+  });
+
+  test('the due times it gave are kept: other hours, a changed priority and a restart do not move them', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    const first = openStore(file, { showDue: true });
+    first.update('T-0004', { priority: 'urgent' }, 'sam');
+    const again = openStore(file, { showDue: true, responseHours: { urgent: 1, high: 1, normal: 1, low: 1 } });
+    assert.deepEqual(again.list().items.map((ticket) => ticket.due), first.list().items.map((ticket) => ticket.due));
+    assert.equal(again.get('T-0004').due, '2025-08-11T13:15:00.000Z');
+    assert.equal(again.backfilled, 0);
+  });
+
+  test('a file that holds a due time that is not a time is refused', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const document = oldFile(file);
+    document.tickets[2].due = 'soon';
+    fs.writeFileSync(file, JSON.stringify(document));
+    assert.throws(() => createPersistence(file).load(), (error) => error instanceof DataFileError && /tickets\[2\]\.due is not a time/.test(error.message));
+  });
+
+  test('can be read by release 1.4.0: the format and every field it reads are as they were', (t) => {
+    // 1.4.0 reads version 1 and the ticket fields below, and ignores a field it does not know (decision 8), as the
+    // data file's loader here ignores a field it does not know. So the file must stay version 1, keep those fields
+    // valid, and add nothing that changes what the old fields mean.
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    openStore(file);
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(document.version, 1);
+    assert.deepEqual(Object.keys(document).sort(), ['audit', 'nextNumber', 'outbox', 'savedAt', 'tickets', 'version']);
+    for (const ticket of document.tickets) {
+      assert.deepEqual(Object.keys(ticket).sort(), ['assignee', 'created', 'due', 'id', 'priority', 'requester', 'status', 'title', 'updated']);
+      for (const field of ['id', 'title', 'requester', 'priority', 'status', 'created', 'updated']) assert.equal(typeof ticket[field], 'string', field);
+    }
+    // And release 1.4.0's own file, which has no due times, loads here (the backfill test above).
+  });
+
+  test('the command line shows the same columns as before, due times or not', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    const before = [];
+    main(['--data', file, 'list', '--raw'], { out: { write: (text) => before.push(text) }, err: { write: () => {} } });
+    openStore(file); // writes the due times
+    const after = [];
+    main(['--data', file, 'list', '--raw'], { out: { write: (text) => after.push(text) }, err: { write: () => {} } });
+    assert.deepEqual(after, before);
+    assert.equal(after[0].split('\t').length, 5);
+  });
+});
