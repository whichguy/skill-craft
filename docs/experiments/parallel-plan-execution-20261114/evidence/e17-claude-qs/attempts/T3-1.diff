+    main(['--data', file, 'list', '--raw'], { out: { write: (text) => before.push(text) }, err: { write: () => {} } });
+    openStore(file); // writes the due times
+    const after = [];
+    main(['--data', file, 'list', '--raw'], { out: { write: (text) => after.push(text) }, err: { write: () => {} } });
+    assert.deepEqual(after, before);
+    assert.equal(after[0].split('\t').length, 5);
+  });
