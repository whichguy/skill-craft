+describe('the data file', () => {
+  test('holds every ticket\'s due time, and is still version 1', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const store = openStore(file);
+    store.create({ title: 'VPN', requester: 'a@example.com', priority: 'high' }, 'dana');
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(document.version, 1, 'release 1.4.0 refuses any other version');
+    assert.equal(document.tickets[0].due, plus(START, 24));
+  });
+
+  test('gives the tickets of an older file their due time from their creation time and priority, and saves it', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    const store = openStore(file, { showDue: true });
+    assert.deepEqual(store.list().items.map((ticket) => ticket.due), [
+      '2025-08-01T14:00:00.000Z', // urgent, +4 h
+      '2025-08-03T11:30:00.000Z', // high, +24 h
+      '2025-08-06T12:00:00.000Z', // normal, +72 h
+      '2025-08-11T13:15:00.000Z', // low, +168 h
+    ]);
+    const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.deepEqual(saved.tickets.map((ticket) => ticket.due), store.list().items.map((ticket) => ticket.due));
+    assert.deepEqual(saved.tickets.map((ticket) => ticket.updated), saved.tickets.map((ticket) => ticket.created), 'nothing else moved');
+    assert.deepEqual(saved.audit, []);
+  });
+
+  test('backfills the file whether or not due times are on, and shows nothing while they are off', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    const store = openStore(file);
+    assert.equal('due' in store.get('T-0001'), false);
+    assert.equal(JSON.parse(fs.readFileSync(file, 'utf8')).tickets[0].due, '2025-08-01T14:00:00.000Z');
+  });
+
+  test('the due times it gave are kept: other hours, a changed priority and a restart do not move them', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    const first = openStore(file, { showDue: true });
+    first.update('T-0004', { priority: 'urgent' }, 'sam');
+    const again = openStore(file, { showDue: true, responseHours: { urgent: 1, high: 1, normal: 1, low: 1 } });
+    assert.deepEqual(again.list().items.map((ticket) => ticket.due), first.list().items.map((ticket) => ticket.due));
+    assert.equal(again.get('T-0004').due, '2025-08-11T13:15:00.000Z');
+    assert.equal(again.backfilled, 0);
+  });
+
+  test('a file that holds a due time that is not a time is refused', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const document = oldFile(file);
+    document.tickets[2].due = 'soon';
+    fs.writeFileSync(file, JSON.stringify(document));
+    assert.throws(() => createPersistence(file).load(), (error) => error instanceof DataFileError && /tickets\[2\]\.due is not a time/.test(error.message));
+  });
+
+  test('can be read by release 1.4.0: the format and every field it reads are as they were', (t) => {
+    // 1.4.0 reads version 1 and the ticket fields below, and ignores a field it does not know (decision 8), as the
+    // data file's loader here ignores a field it does not know. So the file must stay version 1, keep those fields
+    // valid, and add nothing that changes what the old fields mean.
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    openStore(file);
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(document.version, 1);
