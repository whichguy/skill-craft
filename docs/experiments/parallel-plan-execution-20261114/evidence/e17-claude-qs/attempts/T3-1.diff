diff --git a/src/tickets/due.js b/src/tickets/due.js
new file mode 100644
index 0000000..bc43cb6
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,26 @@
+'use strict';
+
+const { isActive } = require('./states');
+
+/**
+ * Due times (docs/decisions/0009-due-times.md): a ticket is due its creation time plus the response time of its priority.
+ * The due time is worked out once, when the ticket is created (or, for a ticket of an older data file, when the file is
+ * first loaded), and stored with the ticket: a later change of the hours or of the priority never moves it.
+ */
+
+/** The response time in hours of each priority, unless a RESPONSE_HOURS_* setting changes it (src/config.js). */
+const DEFAULT_RESPONSE_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+const HOUR_MS = 60 * 60 * 1000;
+
+/** The due time, as an ISO string, of a ticket created at `created` (an ISO string) with `priority`. */
+function dueTime(created, priority, hours = DEFAULT_RESPONSE_HOURS) {
+  return new Date(Date.parse(created) + hours[priority] * HOUR_MS).toISOString();
+}
+
+/** Whether `ticket` is overdue at `now` (a Date): someone still has to work on it and its due time has passed. */
+function isOverdue(ticket, now) {
+  return isActive(ticket.status) && typeof ticket.due === 'string' && Date.parse(ticket.due) < now.getTime();
+}
+
+module.exports = { DEFAULT_RESPONSE_HOURS, dueTime, isOverdue };
