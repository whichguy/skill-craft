+describe('overdue', () => {
+  const ticket = (status, due) => ({ id: 'T-0001', status, due });
+  const now = new Date(START);
+
+  test('is an open or in-progress ticket whose due time has passed', () => {
+    assert.equal(isOverdue(ticket('open', plus(START, -1)), now), true);
+    assert.equal(isOverdue(ticket('in_progress', plus(START, -1)), now), true);
+    assert.equal(isOverdue(ticket('open', plus(START, 1)), now), false);
+    assert.equal(isOverdue(ticket('open', START), now), false, 'not before its due time has passed');
+    assert.equal(isOverdue(ticket('resolved', plus(START, -1)), now), false);
+    assert.equal(isOverdue(ticket('closed', plus(START, -1)), now), false);
+  });
+
+  test('the filter is read only when due times are on', () => {
+    assert.deepEqual(parseListQuery(new URLSearchParams('overdue=true')).filters, {}, 'off: an unknown parameter');
+    assert.deepEqual(parseListQuery(new URLSearchParams('overdue=nonsense')).filters, {});
+    assert.deepEqual(parseListQuery(new URLSearchParams('overdue=true'), { dueTimes: true }).filters, { overdue: true });
+    assert.deepEqual(parseListQuery(new URLSearchParams('overdue=false'), { dueTimes: true }).filters, { overdue: false });
+    assert.throws(() => parseListQuery(new URLSearchParams('overdue=yes'), { dueTimes: true }), InvalidError);
+    assert.throws(() => parseListQuery(new URLSearchParams('overdue='), { dueTimes: true }), InvalidError);
+  });
+
+  test('combines with the other filters', () => {
+    const late = { ...ticket('open', plus(START, -1)), priority: 'high' };
+    assert.equal(matchesFilters(late, { overdue: true, priority: 'high' }, now), true);
+    assert.equal(matchesFilters(late, { overdue: true, priority: 'low' }, now), false);
+  });
+});
