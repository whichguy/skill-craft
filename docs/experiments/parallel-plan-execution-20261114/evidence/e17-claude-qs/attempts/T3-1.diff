+    for (const ticket of document.tickets) {
+      assert.deepEqual(Object.keys(ticket).sort(), ['assignee', 'created', 'due', 'id', 'priority', 'requester', 'status', 'title', 'updated']);
+      for (const field of ['id', 'title', 'requester', 'priority', 'status', 'created', 'updated']) assert.equal(typeof ticket[field], 'string', field);
+    }
