+    savedAt: '2025-09-10T00:00:00.000Z',
+    nextNumber: 5,
+    tickets: [
+      ticket(1, 'urgent', '2025-08-01T10:00:00.000Z'),
+      ticket(2, 'high', '2025-08-02T11:30:00.000Z', 'in_progress'),
+      ticket(3, 'normal', '2025-08-03T12:00:00.000Z', 'resolved'),
+      ticket(4, 'low', '2025-08-04T13:15:00.000Z'),
+    ],
+    audit: [],
+    outbox: { nextId: 1, events: [] },
+  };
+  fs.writeFileSync(file, JSON.stringify(document, null, 2));
+  return document;
+}
+
+const openStore = (file, options = {}) => {
+  const clock = options.clock || manualClock(START);
+  return TicketStore.open({ clock, persistence: createPersistence(file, { clock }), ...options });
+};
+
+describe('the due time of a ticket', () => {
+  test('is its creation time plus 4, 24, 72 or 168 hours by priority', () => {
+    assert.deepEqual(DEFAULT_RESPONSE_HOURS, { urgent: 4, high: 24, normal: 72, low: 168 });
+    for (const [priority, hours] of [['urgent', 4], ['high', 24], ['normal', 72], ['low', 168]]) {
+      assert.equal(dueTime(START, priority), plus(START, hours), priority);
+    }
+  });
+
+  test('is set when the ticket is created, and kept through the ticket\'s whole life', () => {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock, showDue: true });
+    const created = store.create({ title: 'VPN', requester: 'a@example.com', priority: 'high' }, 'dana');
+    assert.equal(created.due, plus(START, 24));
+    clock.advance(5 * HOUR);
+    const changed = store.update('T-0001', { priority: 'urgent' }, 'sam');
+    assert.equal(changed.priority, 'urgent');
+    assert.equal(changed.due, plus(START, 24), 'a later change of the priority does not move it');
+    store.transition('T-0001', 'in_progress', 'sam');
+    store.assign('T-0001', 'kim', 'sam');
+    assert.equal(store.get('T-0001').due, plus(START, 24));
+  });
+
+  test('is not an audit change: the history lists what it did before', () => {
+    const store = new TicketStore({ clock: manualClock(START), showDue: true });
+    store.create({ title: 'VPN', requester: 'a@example.com', priority: 'high' }, 'dana');
+    assert.deepEqual(Object.keys(store.history('T-0001')[0].changes), ['title', 'priority', 'requester', 'status']);
+  });
+
+  test('comes from the hours the store is given, and tickets created before a change of hours keep theirs', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const hours = { urgent: 1, high: 2, normal: 3, low: 4 };
+    const first = openStore(file, { responseHours: hours, showDue: true });
+    first.create({ title: 'VPN', requester: 'a@example.com', priority: 'urgent' }, 'dana');
+    assert.equal(first.get('T-0001').due, plus(START, 1));
+    const again = openStore(file, { responseHours: { urgent: 10, high: 20, normal: 30, low: 40 }, showDue: true });
+    assert.equal(again.get('T-0001').due, plus(START, 1), 'the new hours do not move it');
+    assert.equal(again.create({ title: 'Next', requester: 'a@example.com', priority: 'urgent' }, 'dana').due, plus(START, 10));
+  });
+
+  test('is not shown by a store that has due times off, though it is kept', () => {
+    const store = new TicketStore({ clock: manualClock(START) });
+    const created = store.create({ title: 'VPN', requester: 'a@example.com', priority: 'high' }, 'dana');
+    assert.equal('due' in created, false);
+    assert.equal('due' in store.get('T-0001'), false);
+    assert.equal('due' in store.list().items[0], false);
+    assert.equal(store.snapshot().tickets[0].due, plus(START, 24));
+  });
+});
+
+describe('the settings', () => {
+  test('default to due times off and the 4, 24, 72 and 168 hours', () => {
+    const config = loadConfig({});
+    assert.equal(config.dueTimes, false);
+    assert.deepEqual({ ...config.responseHours }, { urgent: 4, high: 24, normal: 72, low: 168 });
+  });
+
+  test('DUE_TIMES=on switches them on; off or empty leaves them off', () => {
+    assert.equal(loadConfig({ DUE_TIMES: 'on' }).dueTimes, true);
+    assert.equal(loadConfig({ DUE_TIMES: 'off' }).dueTimes, false);
+    assert.equal(loadConfig({ DUE_TIMES: '' }).dueTimes, false);
+  });
+
+  test('the hours of each priority come from RESPONSE_HOURS_*, no code change needed', () => {
+    const config = loadConfig({ RESPONSE_HOURS_URGENT: '2', RESPONSE_HOURS_HIGH: '12', RESPONSE_HOURS_NORMAL: '48', RESPONSE_HOURS_LOW: '' });
+    assert.deepEqual({ ...config.responseHours }, { urgent: 2, high: 12, normal: 48, low: 168 });
+  });
+
+  test('a value the service cannot use names its variable', () => {
+    for (const [env, message] of [
+      [{ DUE_TIMES: 'yes' }, /DUE_TIMES must be on or off/],
+      [{ RESPONSE_HOURS_URGENT: 'soon' }, /RESPONSE_HOURS_URGENT must be a whole number/],
+      [{ RESPONSE_HOURS_LOW: '0' }, /RESPONSE_HOURS_LOW must be from 1/],
+    ]) {
+      assert.throws(() => loadConfig(env), (error) => error instanceof ConfigError && message.test(error.message));
+    }
+  });
+});
