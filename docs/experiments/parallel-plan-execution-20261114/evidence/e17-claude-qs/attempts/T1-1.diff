+describe('PUT /tickets/:id/assignee', () => {
+  test('assigns and unassigns, and every ticket shows its assignee', async () => {
+    await withService({}, async (api) => {
+      const created = await api.post('/tickets', ticketBody());
+      assert.equal(created.body.assignee, null);
+      const assigned = await api.put('/tickets/T-0001/assignee', { assignee: 'sam' }, { 'X-Actor': 'dana' });
+      assert.equal(assigned.status, 200);
+      assert.equal(assigned.body.assignee, 'sam');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'sam');
+      assert.equal((await api.get('/tickets')).body.items[0].assignee, 'sam');
+      const unassigned = await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.equal(unassigned.status, 200);
+      assert.equal(unassigned.body.assignee, null);
+      const audit = (await api.get('/tickets/T-0001/audit')).body.items;
+      assert.deepEqual(audit.slice(1).map((entry) => [entry.action, entry.actor, entry.changes]), [
+        ['ticket.assigned', 'dana', { assignee: { from: null, to: 'sam' } }],
+        ['ticket.assigned', 'system', { assignee: { from: 'sam', to: null } }],
+      ]);
+    });
+  });
+
+  test('assigning to the same agent again changes nothing', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const first = await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      const again = await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      assert.equal(again.status, 200);
+      assert.deepEqual(again.body, first.body);
+      assert.equal((await api.get('/tickets/T-0001/audit')).body.items.length, 2);
+      assert.equal((await api.get('/admin/outbox')).body.pending.filter((event) => event.type === 'ticket.assigned').length, 1);
+    });
+  });
+
+  test('refuses a bad body with 400', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      for (const body of [{}, { assignee: '' }, { assignee: 5 }, { assignee: 'x'.repeat(65) }, { assignee: 'sam', note: 'x' }, []]) {
+        const response = await api.put('/tickets/T-0001/assignee', body);
+        assert.equal(response.status, 400, JSON.stringify(body));
+        assert.equal(response.body.error.code, 'invalid');
+      }
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, null);
+    });
+  });
+
+  test('answers 404 for an unknown ticket', async () => {
+    await withService({}, async (api) => {
+      const response = await api.put('/tickets/T-0042/assignee', { assignee: 'sam' });
+      assert.equal(response.status, 404);
+      assert.equal(response.body.error.code, 'not_found');
+    });
+  });
+
+  test('answers 409 for a resolved or closed ticket, assigning or unassigning', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'kim' })).status, 200);
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+      for (const assignee of ['kim', 'sam', null]) {
+        const response = await api.put('/tickets/T-0001/assignee', { assignee });
+        assert.equal(response.status, 409, String(assignee));
+        assert.equal(response.body.error.code, 'conflict');
+      }
+      await api.post('/tickets/T-0001/transition', { to: 'closed' });
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: null })).status, 409);
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'kim');
+    });
+  });
+
+  test('the agent is notified, through the outbox', async () => {
+    await withService({}, async (api, service) => {
+      await api.post('/tickets', ticketBody());
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      const pending = (await api.get('/admin/outbox')).body.pending;
+      assert.deepEqual(pending.filter((event) => event.type === 'ticket.assigned').map((event) => [event.to, event.ticket]), [['sam', 'T-0001']]);
+      assert.equal(service.notifier.delivered.length, 0, 'the request itself sends nothing');
+    });
+  });
+});
+
+describe('GET /tickets?assignee=', () => {
+  async function seed(api) {
+    for (let i = 0; i < 4; i += 1) await api.post('/tickets', ticketBody({ priority: i < 2 ? 'urgent' : 'low' }));
+    await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+    await api.put('/tickets/T-0002/assignee', { assignee: 'kim' });
+    await api.put('/tickets/T-0003/assignee', { assignee: 'sam' });
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+  }
+  const ids = (response) => response.body.items.map((ticket) => ticket.id);
+
+  test('keeps one agent\'s tickets', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=sam')), ['T-0001', 'T-0003']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=kim')), ['T-0002']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=nobody')), []);
+    });
+  });
+
+  test('an empty assignee keeps the unassigned tickets', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=')), ['T-0004']);
+      await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.deepEqual(ids(await api.get('/tickets?assignee=')), ['T-0001', 'T-0004']);
+    });
+  });
+
+  test('a ticket must match every filter given', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=sam&status=open')), ['T-0001']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=sam&status=in_progress')), ['T-0003']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=sam&priority=low')), ['T-0003']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=kim&priority=low')), []);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=&priority=low')), ['T-0004']);
+      assert.deepEqual(ids(await api.get('/tickets?status=open&priority=urgent')), ['T-0001', 'T-0002']);
+      assert.deepEqual(ids(await api.get('/tickets?status=open&priority=low')), ['T-0004']);
+    });
+  });
+
+  test('pages keep the filter', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      const first = await api.get('/tickets?assignee=sam&limit=1');
+      assert.deepEqual(ids(first), ['T-0001']);
+      const second = await api.get(`/tickets?assignee=sam&limit=1&cursor=${first.body.next}`);
+      assert.deepEqual(ids(second), ['T-0003']);
+      assert.equal(second.body.next, null);
+    });
+  });
+});
+
+describe('the data file', () => {
+  function folder(t) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    return dir;
+  }
+
+  test('keeps the assignee across a restart', async (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    await withService({ dataFile }, async (api) => {
+      await api.post('/tickets', ticketBody());
+      await api.post('/tickets', ticketBody());
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+    });
+    await withService({ dataFile }, async (api) => {
+      assert.deepEqual((await api.get('/tickets')).body.items.map((ticket) => ticket.assignee), ['sam', null]);
+    });
+  });
+
+  test('a file written before assignment existed loads with every ticket unassigned', (t) => {
+    const file = path.join(folder(t), 'old.json');
+    const store = new TicketStore({ clock: manualClock('2025-09-01T08:00:00.000Z') });
+    store.create(input(), 'dana');
+    const document = { version: 1, savedAt: '2025-09-01T08:00:00.000Z', ...store.snapshot() };
+    for (const ticket of document.tickets) delete ticket.assignee;
+    fs.writeFileSync(file, JSON.stringify(document));
+    const loaded = TicketStore.open({ clock: manualClock(), persistence: createPersistence(file) });
+    assert.equal(loaded.get('T-0001').assignee, null);
+    assert.deepEqual(loaded.list({ filters: { assignee: null } }).items.map((ticket) => ticket.id), ['T-0001']);
+  });
+});
+
+describe('the command line', () => {
+  function dataFile(t) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-cli-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    const file = path.join(dir, 'tickets.json');
+    const store = new TicketStore({ clock: manualClock('2025-09-01T08:00:00.000Z'), persistence: createPersistence(file) });
+    store.create(input({ title: 'First' }), 'dana');
+    store.create(input({ title: 'Second' }), 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    return file;
+  }
+
+  function run(args) {
+    let out = '';
+    let err = '';
+    const code = main(args, { env: {}, out: { write: (text) => { out += text; } }, err: { write: (text) => { err += text; } } });
+    return { code, out, err };
+  }
+
+  test('list shows each ticket\'s assignee', (t) => {
+    const file = dataFile(t);
+    const { code, out } = run(['--data', file, 'list']);
+    assert.equal(code, 0);
+    const [header, first, second] = out.trimEnd().split('\n');
+    assert.match(header, /ASSIGNEE/);
+    const column = header.indexOf('ASSIGNEE');
+    assert.equal(first.slice(column, column + 3), 'sam');
+    assert.equal(second.slice(column, column + 1), '-');
+  });
+
+  test('list --raw keeps its first four columns and adds the assignee after them', (t) => {
+    const file = dataFile(t);
+    const { out } = run(['--data', file, 'list', '--raw']);
+    assert.deepEqual(out.split('\n').filter((line) => line !== '').map((line) => line.split('\t')), [
+      ['T-0001', 'open', 'normal', 'First', 'sam'],
+      ['T-0002', 'open', 'normal', 'Second', ''],
+    ]);
+  });
+
+  test('list --assignee filters, and an empty one lists the unassigned', (t) => {
+    const file = dataFile(t);
+    assert.equal(run(['--data', file, 'list', '--assignee', 'sam', '--raw']).out.trimEnd().split('\n').length, 1);
+    assert.match(run(['--data', file, 'list', '--assignee', '', '--raw']).out, /^T-0002\t/);
+    assert.equal(run(['--data', file, 'list', '--assignee', 'kim']).out, 'no tickets\n');
+    assert.match(run(['--data', file, 'show', 'T-0001']).out, /assignee\s+sam/);
+  });
+
+  test('format helpers print an unassigned ticket without "null"', () => {
+    const ticket = { id: 'T-0001', status: 'open', priority: 'low', title: 'x', requester: 'a', updated: '2025-09-01T08:00:00.000Z', assignee: null };
+    assert.equal(rawLine(ticket), 'T-0001\topen\tlow\tx\t');
+    assert.doesNotMatch(table([ticket]), /null/);
+  });
+});
