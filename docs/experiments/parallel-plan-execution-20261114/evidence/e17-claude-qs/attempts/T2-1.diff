+/** The most tickets one POST /tickets/import takes. */
+const MAX_IMPORT = 5000;
+
+/**
+ * POST /tickets/import: { tickets: [<what POST /tickets takes>, ...] }, at most MAX_IMPORT. Checks the items in order and
+ * names the first bad one by its index in the array (0 is the first).
+ */
+function importBatch(body) {
+  onlyFields(body, ['tickets']);
+  if (!Array.isArray(body.tickets)) throw new InvalidError('tickets must be a list of tickets');
+  if (body.tickets.length > MAX_IMPORT) {
+    throw new InvalidError(`tickets must hold at most ${MAX_IMPORT} tickets, not ${body.tickets.length}`);
+  }
+  return body.tickets.map((item, index) => {
+    try {
+      if (item === null || typeof item !== 'object' || Array.isArray(item)) throw new InvalidError('must be a JSON object');
+      return newTicket(item);
+    } catch (error) {
+      if (error instanceof InvalidError) throw new InvalidError(`tickets[${index}] (item ${index}): ${error.message}`);
+      throw error;
+    }
+  });
+}
+
