+++ b/test/assignment.test.js
@@ -0,0 +1,85 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { withService, ticketBody } = require('./helpers');
+const { manualClock } = require('../src/clock');
+const { TicketStore } = require('../src/store');
+const { toDocument, fromDocument } = require('../src/persistence');
+const { rawLine, table } = require('../src/format');
+
+test('assignment is audited, delivered, idempotent, and can be removed', async () => {
+  await withService({}, async (api, service) => {
+    const { body: ticket } = await api.post('/tickets', ticketBody());
+    assert.equal(ticket.assignee, null);
+    const path = `/tickets/${ticket.id}/assignee`;
+    const assigned = await api.put(path, { assignee: 'Sam' }, { 'x-actor': 'Dana' });
+    assert.equal(assigned.status, 200);
+    assert.equal(assigned.body.assignee, 'Sam');
+    const before = service.store.snapshot();
+    await api.put(path, { assignee: 'Sam' });
+    assert.deepEqual(service.store.snapshot(), before);
+    const audit = (await api.get(`/tickets/${ticket.id}/audit`)).body.items.at(-1);
+    assert.deepEqual(audit.changes, { assignee: { from: null, to: 'Sam' } });
+    assert.equal(audit.actor, 'Dana');
+    for (const event of service.store.dueNotifications()) service.notifier.deliver(event);
+    const notification = service.notifier.delivered.find((event) => event.type === 'ticket.assigned');
+    assert.equal(notification.to, 'Sam');
+    assert.match(notification.body, /assigned to you/);
+    assert.equal((await api.put(path, { assignee: 'Lee' })).body.assignee, 'Lee');
+    assert.equal((await api.put(path, { assignee: null })).body.assignee, null);
+    await api.put(path, { assignee: 'Sam' });
+    assert.deepEqual(service.store.outboxReport().pending.filter((e) => e.type === 'ticket.assigned').map((e) => e.to), ['Sam', 'Lee', 'Sam']);
+  });
+});
+
+test('assignment validates names and refuses inactive or missing tickets', async () => {
+  await withService({}, async (api) => {
+    const { body: ticket } = await api.post('/tickets', ticketBody());
+    const path = `/tickets/${ticket.id}/assignee`;
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 1 }, { assignee: 'a'.repeat(65) }, { assignee: 'a\nb' }, { assignee: 'Sam', extra: 1 }]) {
+      assert.equal((await api.put(path, body)).status, 400);
+    }
+    assert.equal((await api.put(path, { assignee: 'a'.repeat(64) })).status, 200);
+    await api.post(`/tickets/${ticket.id}/transition`, { to: 'in_progress' });
+    assert.equal((await api.put(path, { assignee: null })).status, 200);
+    await api.post(`/tickets/${ticket.id}/transition`, { to: 'resolved' });
+    for (const assignee of [null, 'Sam']) assert.equal((await api.put(path, { assignee })).status, 409);
+    await api.post(`/tickets/${ticket.id}/transition`, { to: 'closed' });
+    assert.equal((await api.put(path, { assignee: 'Sam' })).status, 409);
+    assert.equal((await api.put('/tickets/T-9999/assignee', { assignee: 'Sam' })).status, 404);
+  });
+});
+
+test('assignee listing filters combine with every other filter and paginate', async () => {
+  await withService({}, async (api) => {
+    for (const priority of ['high', 'low', 'high', 'high']) await api.post('/tickets', ticketBody({ priority }));
+    for (const id of ['T-0001', 'T-0002', 'T-0003']) await api.put(`/tickets/${id}/assignee`, { assignee: 'Sam' });
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+    const listed = await api.get('/tickets?assignee=Sam&priority=high&status=open');
+    assert.deepEqual(listed.body.items.map((t) => t.id), ['T-0001']);
+    assert.deepEqual((await api.get('/tickets?assignee=')).body.items.map((t) => t.id), ['T-0004']);
+    const first = (await api.get('/tickets?assignee=Sam&limit=1')).body;
+    assert.equal(first.items[0].id, 'T-0001');
+    assert.equal((await api.get(`/tickets?assignee=Sam&limit=1&cursor=${encodeURIComponent(first.next)}`)).body.items[0].id, 'T-0002');
+    assert.equal((await api.get(`/tickets?assignee=${'a'.repeat(65)}`)).status, 400);
+  });
+});
+
+test('assignments survive persistence, legacy tickets default to null, and the CLI table shows agents', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock });
+  store.create(ticketBody(), 'Dana');
+  store.assign('T-0001', 'Sam', 'Dana');
+  const document = toDocument(store.snapshot(), clock.now());
+  const fail = (message) => new Error(message);
+  const reopened = new TicketStore({ clock, state: fromDocument(document, fail) });
+  assert.equal(reopened.get('T-0001').assignee, 'Sam');
+  assert.match(table(reopened.list().items), /ASSIGNEE/);
+  assert.match(table(reopened.list().items), /Sam/);
+  assert.equal(rawLine(reopened.get('T-0001')).split('\t')[4], 'Sam');
+  delete document.tickets[0].assignee;
+  assert.equal(fromDocument(document, fail).tickets[0].assignee, null);
+  document.tickets[0].assignee = 42;
+  assert.throws(() => fromDocument(document, fail), /assignee/);
+});
diff --git a/test/due.test.js b/test/due.test.js
new file mode 100644
index 0000000..834cae5
--- /dev/null
+++ b/test/due.test.js
@@ -0,0 +1,176 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { ConfigError, loadConfig, loadDueConfig } = require('../src/config');
+const { createPersistence, fromDocument, toDocument } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { main } = require('../bin/tickets');
+const { ticketBody, withService } = require('./helpers');
+
+const HOUR = 3600000;
+const plusHours = (created, hours) => new Date(Date.parse(created) + hours * HOUR).toISOString();
+
+function dataFile(t) {
+  const directory = fs.mkdtempSync(path.join(__dirname, '.due-'));
+  t.after(() => fs.rmSync(directory, { recursive: true, force: true }));
+  return path.join(directory, 'tickets.json');
+}
+
+test('due times default off and response hours are configurable with validation', () => {
+  assert.deepEqual(loadDueConfig({}), { dueTimes: false, responseHours: { urgent: 4, high: 24, normal: 72, low: 168 } });
+  assert.equal(loadConfig({ DUE_TIMES: 'on' }).dueTimes, true);
+  for (const value of ['', 'off', 'true', 'ON']) assert.equal(loadDueConfig({ DUE_TIMES: value }).dueTimes, false);
+  const config = loadDueConfig({ RESPONSE_HOURS_URGENT: '2', RESPONSE_HOURS_HIGH: '12', RESPONSE_HOURS_NORMAL: '48', RESPONSE_HOURS_LOW: '96' });
+  assert.deepEqual(config.responseHours, { urgent: 2, high: 12, normal: 48, low: 96 });
+  for (const priority of ['URGENT', 'HIGH', 'NORMAL', 'LOW']) {
+    for (const value of ['-1', '0', '1.5', 'abc', '876001']) {
+      assert.throws(() => loadDueConfig({ [`RESPONSE_HOURS_${priority}`]: value }), ConfigError);
+    }
+  }
+});
+
+test('every priority gets a creation-based due time, exposed in all ticket responses', async () => {
+  const clock = manualClock('2026-11-01T12:34:56.000Z');
+  await withService({ clock, dueTimes: true }, async (api) => {
+    for (const [priority, hours] of Object.entries({ urgent: 4, high: 24, normal: 72, low: 168 })) {
+      const ticket = (await api.post('/tickets', ticketBody({ priority }))).body;
+      const due = plusHours(ticket.created, hours);
+      assert.equal(ticket.due, due);
+      assert.equal((await api.get(`/tickets/${ticket.id}`)).body.due, due);
+      clock.advance(HOUR);
+      assert.equal((await api.patch(`/tickets/${ticket.id}`, { priority: 'low' })).body.due, due);
+      assert.equal((await api.put(`/tickets/${ticket.id}/assignee`, { assignee: 'Sam' })).body.due, due);
+      assert.equal((await api.post(`/tickets/${ticket.id}/transition`, { to: 'in_progress' })).body.due, due);
+      assert.equal((await api.post(`/tickets/${ticket.id}/transition`, { to: 'resolved' })).body.due, due);
+      assert.equal((await api.post(`/tickets/${ticket.id}/transition`, { to: 'open' })).body.due, due);
+    }
+    assert.ok((await api.get('/tickets')).body.items.every((ticket) => typeof ticket.due === 'string'));
+  });
+});
+
+test('when off, due is hidden and overdue remains an ignored query parameter', async () => {
+  await withService({}, async (api, service) => {
+    const ticket = (await api.post('/tickets', ticketBody())).body;
+    assert.equal(Object.hasOwn(ticket, 'due'), false);
+    for (const response of [
+      await api.get(`/tickets/${ticket.id}`),
+      await api.patch(`/tickets/${ticket.id}`, { title: 'New title' }),
+      await api.put(`/tickets/${ticket.id}/assignee`, { assignee: 'Sam' }),
+      await api.post(`/tickets/${ticket.id}/transition`, { to: 'in_progress' }),
+    ]) assert.equal(Object.hasOwn(response.body, 'due'), false);
+    for (const value of ['true', 'false', 'unknown']) {
+      const response = await api.get(`/tickets?overdue=${value}`);
+      assert.equal(response.status, 200);
+      assert.equal(response.body.items.length, 1);
+      assert.equal(Object.hasOwn(response.body.items[0], 'due'), false);
+    }
+    assert.equal(typeof service.store.snapshot().tickets[0].due, 'string');
+  });
+});
+
+test('overdue uses the clock, active statuses, all filters, and cursor pages', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true }, async (api) => {
+    for (const priority of ['urgent', 'urgent', 'urgent', 'urgent', 'low', 'urgent']) await api.post('/tickets', ticketBody({ priority }));
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    for (const id of ['T-0003', 'T-0004']) {
+      for (const to of ['in_progress', 'resolved']) await api.post(`/tickets/${id}/transition`, { to });
+    }
+    await api.post('/tickets/T-0004/transition', { to: 'closed' });
+    clock.advance(4 * HOUR);
+    assert.equal((await api.get('/tickets?overdue=true')).body.items.length, 0, 'exactly due has not passed');
+    clock.advance(1);
+    const overdue = (await api.get('/tickets?overdue=true')).body;
+    assert.deepEqual(overdue.items.map((t) => t.id), ['T-0001', 'T-0002', 'T-0006']);
+    const first = (await api.get('/tickets?overdue=true&limit=1')).body;
+    const second = (await api.get(`/tickets?overdue=true&limit=1&cursor=${encodeURIComponent(first.next)}`)).body;
+    assert.equal(second.items[0].id, 'T-0002');
+    const filtered = (await api.get('/tickets?overdue=true&status=in_progress&priority=urgent&assignee=')).body;
+    assert.deepEqual(filtered.items.map((t) => t.id), ['T-0002']);
+    assert.equal((await api.get('/tickets?overdue=true&priority=low')).body.items.length, 0);
+    assert.equal((await api.get('/tickets?overdue=false')).body.items.length, 6);
+    assert.equal((await api.get('/tickets?overdue=maybe')).status, 400);
+  });
+});
+
+test('legacy due times are saved before serving while off and stay fixed after configuration changes', async (t) => {
+  const file = dataFile(t);
+  const clock = manualClock('2026-10-01T00:00:00.000Z');
+  const original = new TicketStore({ clock });
+  for (const priority of ['urgent', 'high', 'normal', 'low']) {
+    original.create(ticketBody({ priority }), 'Dana');
+    clock.advance(HOUR);
+  }
+  original.transition('T-0001', 'in_progress', 'Dana');
+  const document = toDocument(original.snapshot(), clock.now());
+  for (const ticket of document.tickets) delete ticket.due;
+  fs.writeFileSync(file, JSON.stringify(document));
+  const settings = loadDueConfig({ RESPONSE_HOURS_URGENT: '2' });
+  let prepared;
+  await withService({ clock, dataFile: file, ...settings }, async (api, service) => {
+    prepared = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(prepared.version, 1, 'retain the version accepted by release 1.4.0');
+    assert.equal(prepared.tickets.length, 4);
+    for (const ticket of prepared.tickets) {
+      const old = document.tickets.find((item) => item.id === ticket.id);
+      const { due, ...rest } = ticket;
+      assert.deepEqual(rest, old, 'migration leaves existing ticket fields unchanged');
+      assert.equal(due, plusHours(old.created, settings.responseHours[old.priority]));
+    }
+    assert.deepEqual(prepared.audit, document.audit);
+    assert.deepEqual(prepared.outbox, document.outbox);
+    assert.equal(Object.hasOwn((await api.get('/tickets/T-0001')).body, 'due'), false);
+    assert.equal(service.store.snapshot().tickets[0].due, prepared.tickets[0].due);
+  });
+  await withService({ clock, dataFile: file, ...loadDueConfig({ DUE_TIMES: 'on', RESPONSE_HOURS_URGENT: '10' }) }, async (api) => {
+    assert.equal((await api.get('/tickets/T-0001')).body.due, prepared.tickets[0].due);
+    const next = (await api.post('/tickets', ticketBody({ priority: 'urgent' }))).body;
+    assert.equal(next.due, plusHours(next.created, 10));
+  });
+});
+
+test('migration must save successfully before a store is opened', () => {
+  const clock = manualClock();
+  const old = new TicketStore({ clock });
+  old.create(ticketBody(), 'Dana');
+  const state = old.snapshot();
+  delete state.tickets[0].due;
+  assert.throws(() => TicketStore.open({ clock, dueTimes: true, persistence: {
+    load: () => state,
+    save: () => { throw new Error('read-only disk'); },
+  } }), /read-only disk/);
+});
+
+test('imports use configured response hours and due values are validated on load', async () => {
+  const clock = manualClock();
+  await withService({ clock, ...loadDueConfig({ DUE_TIMES: 'on', RESPONSE_HOURS_NORMAL: '6' }) }, async (api, service) => {
+    await api.post('/tickets/import', { tickets: [ticketBody(), ticketBody()] });
+    for (const ticket of (await api.get('/tickets')).body.items) assert.equal(ticket.due, plusHours(ticket.created, 6));
+    const document = toDocument(service.store.snapshot(), clock.now());
+    document.tickets[0].due = 'not a time';
+    assert.throws(() => fromDocument(document, (message) => new Error(message)), /tickets\[0\].due/);
+  });
+});
+
+test('CLI shows due only with the environment switch on', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(file) });
+  store.create(ticketBody(), 'Dana');
+  const run = (dueTimes, args) => {
+    let output = '';
+    const code = main(['--data', file, ...args], { env: { DUE_TIMES: dueTimes }, out: { write: (text) => { output += text; } }, err: { write: assert.fail } });
+    assert.equal(code, 0);
+    return output;
+  };
+  assert.doesNotMatch(run('off', ['list']), /DUE/);
+  assert.match(run('on', ['list']), /DUE/);
+  assert.doesNotMatch(run('off', ['show', 'T-0001']), /due/);
+  assert.match(run('on', ['show', 'T-0001']), /due/);
+  assert.equal(run('off', ['list', '--raw']).replace(/\n$/, '').split('\t').length, 5);
+  assert.equal(run('on', ['list', '--raw']).replace(/\n$/, '').split('\t').length, 6);
+});
diff --git a/test/import.test.js b/test/import.test.js
new file mode 100644
index 0000000..e6839ec
--- /dev/null
+++ b/test/import.test.js
@@ -0,0 +1,104 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { performance } = require('node:perf_hooks');
+const { ticketBody, withService } = require('./helpers');
+const { TicketStore } = require('../src/store');
+const { manualClock } = require('../src/clock');
+const { createPersistence } = require('../src/persistence');
+
+test('import creates tickets in order with normal audit and requester notifications', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const response = await api.post('/tickets/import', { tickets: [
+      { title: '  First  ', requester: 'first@example.com' },
+      ticketBody({ title: 'Second', priority: 'high', requester: 'second@example.com' }),
+    ] }, { 'X-Actor': 'Migrator' });
+    assert.equal(response.status, 201);
+    assert.deepEqual(response.body, { created: 2, ids: ['T-0002', 'T-0003'] });
+    assert.equal(service.store.get('T-0002').title, 'First');
+    assert.equal(service.store.get('T-0002').priority, 'normal');
+    assert.equal(service.store.get('T-0003').priority, 'high');
+    for (const id of response.body.ids) {
+      const ticket = service.store.get(id);
+      assert.equal(ticket.status, 'open');
+      assert.equal(ticket.assignee, null);
+      const [entry] = service.store.history(id);
+      assert.equal(entry.action, 'ticket.created');
+      assert.equal(entry.actor, 'Migrator');
+      assert.equal(entry.changes.title.to, ticket.title);
+      const event = service.store.outboxReport().pending.find((e) => e.ticket === id);
+      assert.equal(event.to, ticket.requester);
+      assert.equal(event.type, 'ticket.created');
+      service.notifier.deliver(event);
+    }
+    assert.equal(service.notifier.delivered.length, 2);
+  });
+});
+
+test('invalid import identifies the first invalid item and changes nothing', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const before = service.store.snapshot();
+    for (const invalid of [null, [], 5, 'ticket', {}, ticketBody({ title: '' }), ticketBody({ priority: 'critical' }), ticketBody({ extra: true })]) {
+      const response = await api.post('/tickets/import', { tickets: [ticketBody(), invalid, {}] });
+      assert.equal(response.status, 400);
+      assert.equal(response.body.error.code, 'invalid');
+      assert.match(response.body.error.message, /tickets\[1\]/);
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+    const response = await api.post('/tickets/import', { tickets: [null, {}] });
+    assert.match(response.body.error.message, /tickets\[0\]/);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+  });
+});
+
+test('import requires an array of at most 5000, supports empty batches, and validates the actor', async () => {
+  await withService({}, async (api, service) => {
+    for (const body of [{}, { tickets: null }, { tickets: {} }, { tickets: [], extra: true }, { tickets: Array(5001).fill(ticketBody()) }]) {
+      assert.equal((await api.post('/tickets/import', body)).status, 400);
+    }
+    assert.equal((await api.post('/tickets/import', { tickets: [ticketBody()] }, { 'X-Actor': 'a'.repeat(65) })).status, 400);
+    assert.equal(service.store.list().items.length, 0);
+    assert.deepEqual((await api.post('/tickets/import', { tickets: [] })).body, { created: 0, ids: [] });
+  });
+});
+
+test('a 5000-ticket import with persistence answers within ten seconds and survives reload', async () => {
+  const directory = fs.mkdtempSync(path.join(__dirname, '.import-'));
+  const dataFile = path.join(directory, 'tickets.json');
+  try {
+    await withService({ dataFile }, async (api, service) => {
+      const start = performance.now();
+      const response = await api.post('/tickets/import', { tickets: Array.from({ length: 5000 }, (_, i) => ticketBody({ title: `Imported ${i}` })) });
+      const elapsed = performance.now() - start;
+      assert.equal(response.status, 201);
+      assert.equal(response.body.created, 5000);
+      assert.equal(response.body.ids[0], 'T-0001');
+      assert.equal(response.body.ids.at(-1), 'T-5000');
+      assert.ok(elapsed < 10000, `import took ${elapsed}ms`);
+      const saved = TicketStore.open({ clock: service.store.clock, persistence: createPersistence(dataFile) });
+      assert.equal(saved.snapshot().tickets.length, 5000);
+      assert.equal(saved.audit.size, 5000);
+      assert.equal(saved.outboxReport().pending.length, 5000);
+      assert.equal(saved.get('T-5000').title, 'Imported 4999');
+    });
+  } finally {
+    fs.rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+test('import saves once and leaves live state unchanged if persistence fails', () => {
+  const clock = manualClock();
+  let writes = 0;
+  const store = new TicketStore({ clock, persistence: { save() { writes += 1; } } });
+  store.importTickets([ticketBody(), ticketBody()], 'Migrator');
+  assert.equal(writes, 1);
+  const before = store.snapshot();
+  store.persistence.save = () => { throw new Error('disk full'); };
+  assert.throws(() => store.importTickets([ticketBody()], 'Migrator'), /disk full/);
+  assert.deepEqual(store.snapshot(), before);
+});
