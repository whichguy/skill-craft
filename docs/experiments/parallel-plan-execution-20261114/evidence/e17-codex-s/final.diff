+'use strict';
+
+const DEFAULT_RESPONSE_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+/** Compute once, using the ticket's original creation time. */
+function dueFor(created, priority, responseHours = DEFAULT_RESPONSE_HOURS) {
+  return new Date(Date.parse(created) + responseHours[priority] * 60 * 60 * 1000).toISOString();
+}
+
+module.exports = { DEFAULT_RESPONSE_HOURS, dueFor };
