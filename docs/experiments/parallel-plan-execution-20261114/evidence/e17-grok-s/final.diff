+  });
+
+  test('refuses a missing list, a non-array, too many items, or unknown fields', () => {
+    invalid(() => validate.importTickets({}), /tickets is required/);
+    invalid(() => validate.importTickets({ tickets: {} }), /tickets must be an array/);
+    invalid(() => validate.importTickets({ tickets: Array(validate.MAX_IMPORT + 1).fill(item()) }), /at most 5000/);
+    invalid(() => validate.importTickets({ tickets: [], extra: true }), /unknown field: extra/);
+  });
+});
+
+describe('assignee', () => {
+  test('takes a name, trims it, and accepts null to unassign', () => {
+    assert.equal(validate.assignee({ assignee: '  dana  ' }), 'dana');
+    assert.equal(validate.assignee({ assignee: 'd'.repeat(64) }).length, 64);
+    assert.equal(validate.assignee({ assignee: null }), null);
+  });
+
+  test('refuses a missing, empty, too long or multi-line name, and unknown fields', () => {
+    invalid(() => validate.assignee({}), /assignee is required/);
+    invalid(() => validate.assignee({ assignee: '' }), /assignee must not be empty/);
+    invalid(() => validate.assignee({ assignee: '   ' }), /assignee must not be empty/);
+    invalid(() => validate.assignee({ assignee: 'a'.repeat(65) }), /assignee must be at most 64/);
+    invalid(() => validate.assignee({ assignee: 'dana\nlee' }), /single line/);
+    invalid(() => validate.assignee({ assignee: 1 }), /assignee must be a string/);
+    invalid(() => validate.assignee({ assignee: 'dana', extra: true }), /unknown field: extra/);
+  });
+});
