@@ -0,0 +1,38 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { main } = require('../bin/tickets');
+const { manualClock } = require('../src/clock');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-cli-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+function capture() {
+  const chunks = [];
+  return { write: (chunk) => chunks.push(chunk), toString: () => chunks.join('') };
+}
+
+test('list shows each ticket\'s assignee', (t) => {
+  const file = path.join(folder(t), 'tickets.json');
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+  store.create({ title: 'VPN drops', requester: 'maria@example.com', priority: 'high' }, 'system');
+  store.assign('T-0001', 'dana', 'system');
+  const out = capture();
+  assert.equal(main(['--data', file, 'list'], { out, err: capture() }), 0);
+  const table = out.toString();
+  assert.match(table, /ASSIGNEE/);
+  assert.match(table, /dana/);
+  const raw = capture();
+  assert.equal(main(['--data', file, 'list', '--raw'], { out: raw, err: capture() }), 0);
+  assert.match(raw.toString(), /\tdana\n/);
+});
