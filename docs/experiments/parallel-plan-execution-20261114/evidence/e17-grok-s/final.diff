diff --git a/test/due.test.js b/test/due.test.js
new file mode 100644
index 0000000..a9b858a
--- /dev/null
+++ b/test/due.test.js
@@ -0,0 +1,28 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { DEFAULT_DUE_HOURS, dueAt, isOverdue } = require('../src/tickets/due');
+
+test('due time is created plus the hours for the priority', () => {
+  const created = '2025-09-01T08:00:00.000Z';
+  assert.equal(dueAt(created, 'urgent'), '2025-09-01T12:00:00.000Z');
+  assert.equal(dueAt(created, 'high'), '2025-09-02T08:00:00.000Z');
+  assert.equal(dueAt(created, 'normal'), '2025-09-04T08:00:00.000Z');
+  assert.equal(dueAt(created, 'low'), '2025-09-08T08:00:00.000Z');
+  assert.deepEqual(DEFAULT_DUE_HOURS, { urgent: 4, high: 24, normal: 72, low: 168 });
+});
+
+test('hours in force at the time are used, not the defaults', () => {
+  assert.equal(dueAt('2025-09-01T08:00:00.000Z', 'urgent', { urgent: 2 }), '2025-09-01T10:00:00.000Z');
+});
+
+test('only open and in-progress tickets whose due time has passed are overdue', () => {
+  const now = '2025-09-01T12:00:00.000Z';
+  const ticket = (status, due) => ({ status, due });
+  assert.equal(isOverdue(ticket('open', '2025-09-01T12:00:00.000Z'), now), true);
+  assert.equal(isOverdue(ticket('in_progress', '2025-09-01T11:59:59.000Z'), now), true);
+  assert.equal(isOverdue(ticket('open', '2025-09-01T12:00:01.000Z'), now), false);
+  assert.equal(isOverdue(ticket('resolved', '2025-09-01T08:00:00.000Z'), now), false);
+  assert.equal(isOverdue(ticket('closed', '2025-09-01T08:00:00.000Z'), now), false);
+});
