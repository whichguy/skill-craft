+'use strict';
+
+const { isActive } = require('./states');
+
+/**
+ * Response-time hours by priority. Operators change them with DUE_HOURS_* (src/config.js); a ticket's due time is
+ * computed once from the hours in force at that moment and then kept.
+ */
+const DEFAULT_DUE_HOURS = Object.freeze({
+  urgent: 4,
+  high: 24,
+  normal: 72,
+  low: 168,
+});
+
+/** ISO due time: `created` plus the hours for `priority`. */
+function dueAt(created, priority, hours = DEFAULT_DUE_HOURS) {
+  const duration = hours[priority];
+  if (duration == null) throw new RangeError(`no due hours for priority ${priority}`);
+  return new Date(Date.parse(created) + duration * 3600 * 1000).toISOString();
+}
+
+/** Open and in-progress tickets whose due time has been reached. */
+function isOverdue(ticket, now) {
+  return isActive(ticket.status) && Date.parse(now) >= Date.parse(ticket.due);
+}
+
+module.exports = { DEFAULT_DUE_HOURS, dueAt, isOverdue };
