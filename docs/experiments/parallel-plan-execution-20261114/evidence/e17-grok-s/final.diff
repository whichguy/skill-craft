+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { RAW_COLUMNS, details, rawLine, table, tableColumns } = require('../src/format');
+
+const ticket = {
+  id: 'T-0001',
+  title: 'VPN drops',
+  status: 'open',
+  priority: 'high',
+  requester: 'maria@example.com',
+  assignee: 'dana',
+  created: '2025-09-01T08:15:00.000Z',
+  updated: '2025-09-01T09:00:00.000Z',
+};
+
+test('raw listing keeps id, status, priority, title in the first columns and adds assignee', () => {
+  assert.deepEqual(RAW_COLUMNS.slice(0, 4), ['id', 'status', 'priority', 'title']);
+  assert.equal(rawLine(ticket), 'T-0001\topen\thigh\tVPN drops\tdana');
+  assert.equal(rawLine({ ...ticket, assignee: null }), 'T-0001\topen\thigh\tVPN drops\t');
+});
+
+test('the table listing shows each ticket\'s assignee', () => {
+  const output = table([ticket, { ...ticket, id: 'T-0002', assignee: null }]);
+  assert.match(output, /ASSIGNEE/);
+  assert.match(output, /dana/);
+  assert.match(output.split('\n')[1], /T-0001/);
+});
+
+test('details include the assignee', () => {
+  const output = details(ticket, []);
+  assert.match(output, /assignee\s+dana/);
+  assert.match(details({ ...ticket, assignee: null }, []), /assignee\s*$/m);
+});
+
+test('the table listing shows due when due times are on', () => {
+  const output = table([{ ...ticket, due: '2025-09-02T08:15:00.000Z' }], tableColumns({ dueTimes: true }));
+  assert.match(output, /DUE/);
+  assert.match(output, /2025-09-02 08:15/);
+});
