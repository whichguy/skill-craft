+test('startup durably backfills old data while disabled and keeps version 1 for rollback', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const persistence = createPersistence(file, { clock });
+  const initial = TicketStore.open({ clock, persistence });
+  for (const priority of Object.keys(DEFAULT_HOURS)) initial.createTicket(ticketBody({ priority }), 'operator');
+  const legacy = JSON.parse(fs.readFileSync(file, 'utf8'));
+  legacy.tickets.forEach((ticket) => { delete ticket.due; });
+  fs.writeFileSync(file, JSON.stringify(legacy));
+  const migrated = TicketStore.open({ clock, persistence });
+  const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+  assert.equal(saved.version, 1);
+  assert.equal(saved.tickets.length, legacy.tickets.length);
+  assert.deepEqual(saved.audit, legacy.audit);
+  assert.deepEqual(saved.outbox, legacy.outbox);
+  for (const ticket of saved.tickets) {
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), DEFAULT_HOURS[ticket.priority] * 3600000);
+    assert.equal('due' in migrated.get(ticket.id), false);
+  }
+  const again = TicketStore.open({ clock, persistence, dueTimes: true, dueHours: { normal: 1 } });
+  assert.deepEqual(again.list().items.map((ticket) => ticket.due), saved.tickets.map((ticket) => ticket.due));
+});
+
+test('overdue uses strict passed deadline, active states, ordinary filters and cursor pagination', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock, dueTimes: true });
+  for (let i = 0; i < 5; i++) store.createTicket(ticketBody({ priority: 'urgent' }), 'operator');
+  store.transition('T-0002', 'in_progress', 'operator');
+  for (const id of ['T-0003', 'T-0004']) {
+    store.transition(id, 'in_progress', 'operator');
+    store.transition(id, 'resolved', 'operator');
+  }
+  store.transition('T-0004', 'closed', 'operator');
+  clock.advance(4 * 3600000);
+  assert.equal(store.list({ filters: { overdue: true } }).items.length, 0);
+  clock.advance(1);
+  const page = store.list({ filters: { overdue: true }, limit: 2 });
+  assert.deepEqual(page.items.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+  assert.ok(page.next);
+  assert.deepEqual(store.list({ filters: { overdue: true }, after: 'T-0002' }).items.map((ticket) => ticket.id), ['T-0005']);
+  assert.deepEqual(store.list({ filters: { overdue: true, status: 'in_progress', priority: 'urgent' } }).items.map((ticket) => ticket.id), ['T-0002']);
+  assert.equal(store.list({ filters: { overdue: false } }).items.length, 5);
+});
