@@ -0,0 +1,9 @@
+'use strict';
+
+const DEFAULT_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+function dueTime(created, priority, hours = DEFAULT_HOURS) {
+  return new Date(Date.parse(created) + hours[priority] * 60 * 60 * 1000).toISOString();
+}
+
+module.exports = { DEFAULT_HOURS, dueTime };
