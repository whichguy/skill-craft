+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { loadConfig } = require('../src/config');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { DEFAULT_HOURS } = require('../src/tickets/due');
+const { withService, ticketBody } = require('./helpers');
+
+function dataFile(t) {
+  const dir = fs.mkdtempSync(path.join(__dirname, 'due-data-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return path.join(dir, 'tickets.json');
+}
+
+test('due settings have defaults, explicit enablement and validated configurable hours', () => {
+  assert.equal(loadConfig({}).dueTimes, false);
+  assert.equal(loadConfig({ DUE_TIMES: 'true' }).dueTimes, false);
+  assert.deepEqual(loadConfig({}).dueHours, DEFAULT_HOURS);
+  const config = loadConfig({ DUE_TIMES: 'on', DUE_HOURS_URGENT: '2', DUE_HOURS_NORMAL: '0' });
+  assert.equal(config.dueTimes, true);
+  assert.equal(config.dueHours.urgent, 2);
+  assert.equal(config.dueHours.normal, 0);
+  for (const value of ['-1', 'NaN', '1.5', '1000001']) {
+    assert.throws(() => loadConfig({ DUE_HOURS_HIGH: value }), /DUE_HOURS_HIGH/);
+  }
+});
+
+test('each priority gets its response deadline at creation', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock, dueTimes: true });
+  for (const [priority, hours] of Object.entries(DEFAULT_HOURS)) {
+    const ticket = store.createTicket(ticketBody({ priority }), 'operator');
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), hours * 3600000);
+    assert.equal(store.get(ticket.id).due, ticket.due);
+  }
+});
+
+test('due stays fixed across priority changes, lifecycle changes and changed settings after restart', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const persistence = createPersistence(file, { clock });
+  const store = TicketStore.open({ clock, persistence, dueTimes: true });
+  const ticket = store.createTicket(ticketBody({ priority: 'urgent' }), 'operator');
+  clock.advance(1000);
+  assert.equal(store.update(ticket.id, { priority: 'low' }, 'operator').due, ticket.due);
+  for (const state of ['in_progress', 'resolved', 'open']) {
+    assert.equal(store.transition(ticket.id, state, 'operator').due, ticket.due);
+  }
+  const again = TicketStore.open({ clock, persistence, dueTimes: true, dueHours: { urgent: 1, low: 1 } });
+  assert.equal(again.get(ticket.id).due, ticket.due);
+  assert.equal(Date.parse(again.createTicket(ticketBody({ priority: 'low' }), 'operator').due) - clock.now(), 3600000);
+});
+
+test('startup durably backfills old data while disabled and keeps version 1 for rollback', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const persistence = createPersistence(file, { clock });
+  const initial = TicketStore.open({ clock, persistence });
+  for (const priority of Object.keys(DEFAULT_HOURS)) initial.createTicket(ticketBody({ priority }), 'operator');
+  const legacy = JSON.parse(fs.readFileSync(file, 'utf8'));
+  legacy.tickets.forEach((ticket) => { delete ticket.due; });
+  fs.writeFileSync(file, JSON.stringify(legacy));
+  const migrated = TicketStore.open({ clock, persistence });
+  const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+  assert.equal(saved.version, 1);
+  assert.equal(saved.tickets.length, legacy.tickets.length);
+  assert.deepEqual(saved.audit, legacy.audit);
+  assert.deepEqual(saved.outbox, legacy.outbox);
+  for (const ticket of saved.tickets) {
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), DEFAULT_HOURS[ticket.priority] * 3600000);
+    assert.equal('due' in migrated.get(ticket.id), false);
+  }
+  const again = TicketStore.open({ clock, persistence, dueTimes: true, dueHours: { normal: 1 } });
+  assert.deepEqual(again.list().items.map((ticket) => ticket.due), saved.tickets.map((ticket) => ticket.due));
+});
+
+test('overdue uses strict passed deadline, active states, ordinary filters and cursor pagination', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock, dueTimes: true });
+  for (let i = 0; i < 5; i++) store.createTicket(ticketBody({ priority: 'urgent' }), 'operator');
+  store.transition('T-0002', 'in_progress', 'operator');
+  for (const id of ['T-0003', 'T-0004']) {
+    store.transition(id, 'in_progress', 'operator');
+    store.transition(id, 'resolved', 'operator');
+  }
+  store.transition('T-0004', 'closed', 'operator');
+  clock.advance(4 * 3600000);
+  assert.equal(store.list({ filters: { overdue: true } }).items.length, 0);
+  clock.advance(1);
+  const page = store.list({ filters: { overdue: true }, limit: 2 });
+  assert.deepEqual(page.items.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+  assert.ok(page.next);
+  assert.deepEqual(store.list({ filters: { overdue: true }, after: 'T-0002' }).items.map((ticket) => ticket.id), ['T-0005']);
+  assert.deepEqual(store.list({ filters: { overdue: true, status: 'in_progress', priority: 'urgent' } }).items.map((ticket) => ticket.id), ['T-0002']);
+  assert.equal(store.list({ filters: { overdue: false } }).items.length, 5);
+});
+
+test('disabled HTTP responses omit due and ignore overdue as before', async () => {
+  await withService({}, async (api) => {
+    const created = await api.post('/tickets', ticketBody());
+    assert.equal('due' in created.body, false);
+    for (const response of [await api.get(`/tickets/${created.body.id}`), await api.patch(`/tickets/${created.body.id}`, { priority: 'high' })]) {
+      assert.equal('due' in response.body, false);
+    }
+    const listed = await api.get('/tickets?overdue=invalid');
+    assert.equal(listed.status, 200);
+    assert.equal(listed.body.items.length, 1);
+    assert.equal('due' in listed.body.items[0], false);
+  });
+});
+
+test('enabled HTTP creation and atomic imports use configured hours and expose overdue filtering', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true, dueHours: { normal: 1 } }, async (api) => {
+    const created = await api.post('/tickets', ticketBody());
+    assert.equal(Date.parse(created.body.due) - clock.now(), 3600000);
+    const imported = await api.post('/tickets/import', { tickets: [ticketBody(), ticketBody()] });
+    assert.equal(imported.status, 201);
+    for (const id of imported.body.ids) assert.equal((await api.get(`/tickets/${id}`)).body.due, created.body.due);
+    assert.equal((await api.get('/tickets?overdue=true')).body.items.length, 0);
+    clock.advance(3600001);
+    assert.equal((await api.get('/tickets?overdue=true')).body.items.length, 3);
+    assert.equal((await api.get('/tickets?overdue=perhaps')).status, 400);
+  });
+});
+
+test('invalid persisted due values are refused', (t) => {
+  const file = dataFile(t);
+  const persistence = createPersistence(file);
+  const store = TicketStore.open({ clock: manualClock(), persistence });
+  store.createTicket(ticketBody(), 'operator');
+  const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+  document.tickets[0].due = 'tomorrow';
+  fs.writeFileSync(file, JSON.stringify(document));
+  assert.throws(() => persistence.load(), /tickets\[0\].due is not a time/);
+});
+
+test('operator output includes due only when enabled and preserves raw column positions', (t) => {
+  const { main } = require('../bin/tickets');
+  const file = dataFile(t);
+  const store = TicketStore.open({ clock: manualClock(), persistence: createPersistence(file), dueTimes: true });
+  const ticket = store.createTicket(ticketBody({ priority: 'urgent' }), 'operator');
+  function run(args, env) {
+    let output = '';
+    const code = main(['--data', file, ...args], { env, out: { write: (text) => { output += text; } }, err: { write: (text) => { output += text; } } });
+    assert.equal(code, 0, output);
+    return output;
+  }
+  const off = run(['list', '--raw'], {});
+  const on = run(['list', '--raw'], { DUE_TIMES: 'on' });
+  assert.deepEqual(on.trimEnd().split('\t').slice(0, 4), off.trimEnd().split('\t').slice(0, 4));
+  assert.equal(on.split('\t').at(-1).trim(), ticket.due);
+  assert.match(run(['show', ticket.id], { DUE_TIMES: 'on' }), /due\s+2025-/);
+  assert.doesNotMatch(run(['show', ticket.id], {}), /due/);
+  assert.match(run(['list'], { DUE_TIMES: 'on' }), /DUE/);
+  assert.match(run(['list', '--overdue'], { DUE_TIMES: 'on' }), /T-0001/);
+});
