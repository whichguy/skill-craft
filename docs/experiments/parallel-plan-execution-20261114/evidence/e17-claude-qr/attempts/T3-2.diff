+const { ticketBody, withService } = require('./helpers');
+
+const HOUR = 60 * 60 * 1000;
+const START = '2025-09-01T08:00:00.000Z';
+const plus = (iso, hours) => new Date(Date.parse(iso) + hours * HOUR).toISOString();
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+const input = (priority, title = 'VPN drops') => ({ title, requester: 'maria@example.com', priority });
+
+/** A data file as release 1.4.0 wrote it: tickets without `due`. */
+function oldDataFile(file) {
+  const ticket = (number, priority, status, created) => ({
+    id: `T-000${number}`, title: `Ticket ${number}`, priority, requester: 'maria@example.com', status, created, updated: created,
+  });
+  const document = {
+    version: 1,
+    savedAt: '2025-09-10T00:00:00.000Z',
+    nextNumber: 5,
+    tickets: [
+      ticket(1, 'urgent', 'open', '2025-09-01T08:00:00.000Z'),
+      ticket(2, 'high', 'in_progress', '2025-09-02T09:30:00.000Z'),
+      ticket(3, 'normal', 'resolved', '2025-09-03T10:00:00.000Z'),
+      ticket(4, 'low', 'open', '2025-09-04T11:15:00.000Z'),
+    ],
+    audit: [],
+    outbox: { nextId: 1, events: [] },
+  };
+  fs.writeFileSync(file, `${JSON.stringify(document, null, 2)}\n`);
+  return document;
+}
+
+describe('due time arithmetic', () => {
+  test('the default response times are 4, 24, 72 and 168 hours', () => {
+    assert.deepEqual({ ...DEFAULT_RESPONSE_HOURS }, { urgent: 4, high: 24, normal: 72, low: 168 });
+    assert.equal(dueFor(START, 'urgent'), '2025-09-01T12:00:00.000Z');
+    assert.equal(dueFor(START, 'high'), '2025-09-02T08:00:00.000Z');
+    assert.equal(dueFor(START, 'normal'), '2025-09-04T08:00:00.000Z');
+    assert.equal(dueFor(START, 'low'), '2025-09-08T08:00:00.000Z');
+  });
+
+  test('other response times can be given', () => {
+    assert.equal(dueFor(START, 'urgent', { ...DEFAULT_RESPONSE_HOURS, urgent: 1 }), '2025-09-01T09:00:00.000Z');
+  });
+
+  test('only a ticket someone still has to work on is overdue, and only after its due time', () => {
+    const due = '2025-09-01T12:00:00.000Z';
+    const at = (iso) => new Date(iso);
+    assert.equal(isOverdue({ status: 'open', due }, at(due)), false, 'at the due time it is not yet late');
+    assert.equal(isOverdue({ status: 'open', due }, at('2025-09-01T12:00:00.001Z')), true);
+    assert.equal(isOverdue({ status: 'in_progress', due }, at('2025-09-02T00:00:00.000Z')), true);
+    assert.equal(isOverdue({ status: 'resolved', due }, at('2025-09-02T00:00:00.000Z')), false);
+    assert.equal(isOverdue({ status: 'closed', due }, at('2025-09-02T00:00:00.000Z')), false);
+  });
+});
+
+describe('the settings', () => {
+  test('due times are off, with the default response times', () => {
+    const config = loadConfig({});
+    assert.equal(config.dueTimes, false);
+    assert.deepEqual({ ...config.responseHours }, { urgent: 4, high: 24, normal: 72, low: 168 });
+  });
+
+  test('DUE_TIMES=on switches them on, and each response time has a variable', () => {
+    const config = loadConfig({ DUE_TIMES: 'on', DUE_HOURS_URGENT: '2', DUE_HOURS_HIGH: '8', DUE_HOURS_NORMAL: '48', DUE_HOURS_LOW: '120' });
+    assert.equal(config.dueTimes, true);
+    assert.deepEqual({ ...config.responseHours }, { urgent: 2, high: 8, normal: 48, low: 120 });
+    assert.equal(loadConfig({ DUE_TIMES: 'off' }).dueTimes, false);
+    assert.equal(loadConfig({ DUE_TIMES: '' }).dueTimes, false);
+  });
+
+  test('a value the service cannot use names its variable', () => {
+    for (const [env, message] of [
+      [{ DUE_TIMES: 'yes' }, /DUE_TIMES must be on or off/],
+      [{ DUE_HOURS_HIGH: 'soon' }, /DUE_HOURS_HIGH must be a whole number/],
+      [{ DUE_HOURS_LOW: '0' }, /DUE_HOURS_LOW must be from 1/],
+    ]) {
+      assert.throws(() => loadConfig(env), (error) => error instanceof ConfigError && message.test(error.message));
+    }
+  });
+});
