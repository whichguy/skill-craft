+describe('the store', () => {
+  test('a new ticket is due its priority\'s response time after it was created', () => {
+    const store = new TicketStore({ clock: manualClock(START), dueTimes: true });
+    for (const [priority, hours] of [['urgent', 4], ['high', 24], ['normal', 72], ['low', 168]]) {
+      const ticket = store.createTicket(input(priority), 'dana');
+      assert.equal(ticket.created, START);
+      assert.equal(ticket.due, plus(START, hours));
+      assert.equal(store.get(ticket.id).due, plus(START, hours));
+    }
+  });
+
+  test('an imported ticket gets its due time like any other', () => {
+    const store = new TicketStore({ clock: manualClock(START), dueTimes: true });
+    const tickets = store.createTickets([input('urgent'), input('low')], 'dana');
+    assert.deepEqual(tickets.map((ticket) => ticket.due), [plus(START, 4), plus(START, 168)]);
+  });
+
+  test('a ticket keeps its due time when its priority changes, or it moves along, or time passes', () => {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock, dueTimes: true });
+    const { id, due } = store.createTicket(input('normal'), 'dana');
+    clock.advance(5 * HOUR);
+    assert.equal(store.update(id, { priority: 'urgent' }, 'dana').due, due);
+    assert.equal(store.update(id, { title: 'Renamed' }, 'dana').due, due);
+    assert.equal(store.transition(id, 'in_progress', 'sam').due, due);
+    assert.equal(store.get(id).due, due);
+  });
+
+  test('due times are worked out and kept, but not shown, until they are switched on', () => {
+    const store = new TicketStore({ clock: manualClock(START) });
+    const ticket = store.createTicket(input('urgent'), 'dana');
+    assert.equal('due' in ticket, false);
+    assert.equal('due' in store.get(ticket.id), false);
+    assert.equal(store.list().items.some((item) => 'due' in item), false);
+    assert.equal(store.snapshot().tickets[0].due, plus(START, 4), 'the data file holds it');
+  });
+
+  test('the audit log does not change: a due time is not a change a person made', () => {
+    const store = new TicketStore({ clock: manualClock(START), dueTimes: true });
+    store.createTicket(input('urgent'), 'dana');
+    assert.deepEqual(Object.keys(store.history('T-0001')[0].changes), ['title', 'priority', 'requester', 'status']);
+  });
+
+  describe('overdue', () => {
+    function overdueStore() {
+      const clock = manualClock(START);
+      const store = new TicketStore({ clock, dueTimes: true });
+      store.createTicket(input('urgent', 'urgent, open'), 'dana'); // T-0001, due 12:00
+      store.createTicket(input('urgent', 'urgent, working'), 'dana'); // T-0002, due 12:00
+      store.createTicket(input('urgent', 'urgent, resolved'), 'dana'); // T-0003, due 12:00
+      store.createTicket(input('low', 'low, open'), 'dana'); // T-0004, due in 7 days
+      store.transition('T-0002', 'in_progress', 'sam');
+      store.transition('T-0003', 'in_progress', 'sam');
+      store.transition('T-0003', 'resolved', 'sam');
+      return { clock, store };
+    }
+    const ids = (store, query) => store.list(query).items.map((ticket) => ticket.id);
+
+    test('lists the open and in-progress tickets whose due time has passed', () => {
+      const { clock, store } = overdueStore();
+      assert.deepEqual(ids(store, { overdue: true }), []);
+      clock.advance(4 * HOUR);
+      assert.deepEqual(ids(store, { overdue: true }), [], 'due now is not yet overdue');
+      clock.advance(1);
+      assert.deepEqual(ids(store, { overdue: true }), ['T-0001', 'T-0002']);
+      clock.advance(10 * 24 * HOUR);
+      assert.deepEqual(ids(store, { overdue: true }), ['T-0001', 'T-0002', 'T-0004']);
+    });
+
+    test('combines with the other filters, and overdue=false is the others', () => {
+      const { clock, store } = overdueStore();
+      clock.advance(5 * HOUR);
+      assert.deepEqual(ids(store, { overdue: true, filters: { status: 'open' } }), ['T-0001']);
+      assert.deepEqual(ids(store, { overdue: false }), ['T-0003', 'T-0004']);
+      assert.deepEqual(ids(store, {}), ['T-0001', 'T-0002', 'T-0003', 'T-0004']);
+    });
+
+    test('a ticket that is moved on or resolved leaves the overdue list', () => {
+      const { clock, store } = overdueStore();
+      clock.advance(5 * HOUR);
+      store.transition('T-0002', 'resolved', 'sam');
+      assert.deepEqual(ids(store, { overdue: true }), ['T-0001']);
+    });
+
+    test('is ignored while due times are off', () => {
+      const { clock, store } = overdueStore();
+      store.dueTimes = false;
+      clock.advance(5 * HOUR);
+      assert.equal(ids(store, { overdue: true }).length, 4);
+    });
+  });
+
+  describe('a data file from before due times', () => {
+    test('gives its tickets due times from their creation time and priority, and keeps them', (t) => {
+      const file = path.join(folder(t), 'tickets.json');
+      oldDataFile(file);
+      const clock = manualClock('2025-10-01T00:00:00.000Z');
+      const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueTimes: true });
+      assert.equal(store.backfilled, 4);
+      assert.equal(store.get('T-0001').due, '2025-09-01T12:00:00.000Z');
+      assert.equal(store.get('T-0002').due, '2025-09-03T09:30:00.000Z');
+      assert.equal(store.get('T-0003').due, '2025-09-06T10:00:00.000Z');
+      assert.equal(store.get('T-0004').due, '2025-09-11T11:15:00.000Z');
+      assert.equal(store.get('T-0001').updated, '2025-09-01T08:00:00.000Z', 'a due time is not a change of the ticket');
+    });
+
+    test('a later start with other response times, or after a priority change, does not move them', (t) => {
+      const file = path.join(folder(t), 'tickets.json');
+      oldDataFile(file);
+      const clock = manualClock('2025-10-01T00:00:00.000Z');
+      const open = (responseHours) => TicketStore.open({ clock, persistence: createPersistence(file, { clock }), responseHours, dueTimes: true });
+      const first = open(DEFAULT_RESPONSE_HOURS);
+      first.update('T-0004', { priority: 'urgent' }, 'dana');
+      const again = open({ urgent: 1, high: 1, normal: 1, low: 1 });
+      assert.equal(again.backfilled, 0, 'the file now holds every due time');
+      assert.equal(again.get('T-0001').due, '2025-09-01T12:00:00.000Z');
+      assert.equal(again.get('T-0004').due, '2025-09-11T11:15:00.000Z');
+      assert.equal(again.get('T-0004').priority, 'urgent');
+    });
+  });
+});
