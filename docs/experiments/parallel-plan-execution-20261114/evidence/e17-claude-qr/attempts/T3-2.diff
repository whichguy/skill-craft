+describe('the service', () => {
+  test('with due times off it saves the due times of an old file but answers as it did before', async (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    oldDataFile(dataFile);
+    await withService({ dataFile, dueTimes: false, clock: manualClock('2025-10-01T00:00:00.000Z') }, async (api) => {
+      const saved = JSON.parse(fs.readFileSync(dataFile, 'utf8'));
+      assert.deepEqual(saved.tickets.map((ticket) => ticket.due), [
+        '2025-09-01T12:00:00.000Z', '2025-09-03T09:30:00.000Z', '2025-09-06T10:00:00.000Z', '2025-09-11T11:15:00.000Z',
+      ]);
+      const list = await api.get('/tickets');
+      assert.equal(list.status, 200);
+      assert.equal(list.body.items.length, 4);
+      assert.equal(list.body.items.some((ticket) => 'due' in ticket), false);
+      assert.equal('due' in (await api.get('/tickets/T-0001')).body, false);
+      const created = await api.post('/tickets', ticketBody());
+      assert.equal(created.status, 201);
+      assert.deepEqual(Object.keys(created.body), ['id', 'title', 'priority', 'requester', 'status', 'created', 'updated']);
+      // `overdue` is a parameter this service does not know yet: ignored, even with a value it would refuse
+      assert.equal((await api.get('/tickets?overdue=true')).body.items.length, 5);
+      assert.equal((await api.get('/tickets?overdue=banana')).status, 200);
+    });
+  });
+
+  test('with due times on every ticket shows `due`, and ?overdue=true lists the late ones', async (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    oldDataFile(dataFile);
+    const clock = manualClock('2025-09-02T00:00:00.000Z');
+    await withService({ dataFile, dueTimes: true, clock }, async (api) => {
+      const list = (await api.get('/tickets')).body.items;
+      assert.deepEqual(list.map((ticket) => ticket.due), [
+        '2025-09-01T12:00:00.000Z', '2025-09-03T09:30:00.000Z', '2025-09-06T10:00:00.000Z', '2025-09-11T11:15:00.000Z',
+      ]);
+      assert.deepEqual((await api.get('/tickets?overdue=true')).body.items.map((ticket) => ticket.id), ['T-0001']);
+      clock.set('2025-09-03T10:00:00.000Z');
+      assert.deepEqual((await api.get('/tickets?overdue=true')).body.items.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+      assert.deepEqual((await api.get('/tickets?overdue=true&status=in_progress')).body.items.map((ticket) => ticket.id), ['T-0002']);
+      assert.deepEqual((await api.get('/tickets?overdue=true&limit=1')).body.next, 'eyJ2IjoxLCJhZnRlciI6IlQtMDAwMSJ9');
+      await api.post('/tickets/T-0002/transition', { to: 'resolved' });
+      assert.deepEqual((await api.get('/tickets?overdue=true')).body.items.map((ticket) => ticket.id), ['T-0001']);
+      const refused = await api.get('/tickets?overdue=banana');
+      assert.equal(refused.status, 400);
+      assert.equal(refused.body.error.code, 'invalid');
+    });
+  });
+
+  test('a ticket created through the API is due its response time later, whatever happens to it', async () => {
+    const clock = manualClock(START);
+    await withService({ dueTimes: true, clock, responseHours: { urgent: 2, high: 24, normal: 72, low: 168 } }, async (api) => {
+      const created = (await api.post('/tickets', ticketBody({ priority: 'urgent' }))).body;
+      assert.equal(created.due, plus(START, 2));
+      clock.advance(HOUR);
+      const patched = (await api.patch(`/tickets/${created.id}`, { priority: 'low' })).body;
+      assert.equal(patched.priority, 'low');
+      assert.equal(patched.due, plus(START, 2));
+      assert.equal((await api.get(`/tickets/${created.id}`)).body.due, plus(START, 2));
+      const imported = await api.post('/tickets/import', { tickets: [ticketBody({ priority: 'high' })] });
+      assert.equal((await api.get(`/tickets/${imported.body.ids[0]}`)).body.due, plus('2025-09-01T09:00:00.000Z', 24));
+    });
+  });
+
+  test('changed response times apply to new tickets only, across a restart', async (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    const clock = manualClock(START);
+    await withService({ dataFile, dueTimes: true, clock }, (api) => api.post('/tickets', ticketBody({ priority: 'urgent' })));
+    await withService({ dataFile, dueTimes: true, clock, responseHours: { urgent: 1, high: 1, normal: 1, low: 1 } }, async (api) => {
+      assert.equal((await api.get('/tickets/T-0001')).body.due, plus(START, 4));
+      assert.equal((await api.post('/tickets', ticketBody({ priority: 'urgent' }))).body.due, plus(START, 1));
+    });
+  });
+});
