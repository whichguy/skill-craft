+describe('going back to release 1.4.0', () => {
+  /** What release 1.4.0 checks of a ticket record when it loads a data file: these fields, and no others. */
+  function loadsAs140(document) {
+    assert.equal(document.version, 1, '1.4.0 refuses any other version');
+    assert.deepEqual(Object.keys(document).sort(), ['audit', 'nextNumber', 'outbox', 'savedAt', 'tickets', 'version']);
+    return document.tickets.map((record) => {
+      const ticket = Object.fromEntries(['id', 'title', 'priority', 'requester', 'status', 'created', 'updated'].map((field) => [field, record[field]]));
+      for (const field of ['title', 'requester', 'created', 'updated']) assert.equal(typeof ticket[field], 'string');
+      assert.ok(['low', 'normal', 'high', 'urgent'].includes(ticket.priority));
+      assert.ok(['open', 'in_progress', 'resolved', 'closed'].includes(ticket.status));
+      return ticket;
+    });
+  }
+
+  test('the data file the new release wrote has the same version and layout, and every ticket is in it', async (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    oldDataFile(dataFile);
+    await withService({ dataFile, dueTimes: true }, async (api) => {
+      await api.post('/tickets', ticketBody({ priority: 'high' }));
+      const tickets = loadsAs140(JSON.parse(fs.readFileSync(dataFile, 'utf8')));
+      assert.deepEqual(tickets.map((ticket) => ticket.id), ['T-0001', 'T-0002', 'T-0003', 'T-0004', 'T-0005']);
+    });
+  });
+
+  test('the command line, which shares the loader, still lists every ticket of such a file', (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    oldDataFile(dataFile);
+    const clock = manualClock(START);
+    const store = TicketStore.open({ clock, persistence: createPersistence(dataFile, { clock }), dueTimes: true });
+    store.createTicket(input('high'), 'dana');
+    let output = '';
+    const code = main(['--data', dataFile, 'list', '--raw'], { out: { write: (text) => { output += text; } } });
+    assert.equal(code, 0);
+    assert.equal(output.trim().split('\n').length, 5);
+    assert.match(output, /^T-0001\topen\turgent\tTicket 1$/m);
+  });
+
+  test('a file edited to a due that is not a time is refused with the reason', (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    const document = oldDataFile(dataFile);
+    document.tickets[1].due = 'tomorrow';
+    fs.writeFileSync(dataFile, JSON.stringify(document));
+    assert.throws(() => createService({ dataFile, port: 0, workerIntervalMs: 0 }, { log: silentLogger }), /tickets\[1\]\.due is not a time/);
+  });
+});
