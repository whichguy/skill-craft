diff --git a/src/tickets/due.js b/src/tickets/due.js
new file mode 100644
index 0000000..2beb05b
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,29 @@
+'use strict';
+
+const { PRIORITIES } = require('./priorities');
+const { isActive } = require('./states');
+
+/**
+ * Due times (docs/decisions/0009-due-times.md): a ticket is due its priority's response time after it was created.
+ * The due time is worked out once, when the ticket is created (or, for a ticket that predates due times, when the data
+ * file is first loaded by a release that has them), and stored on the ticket. It never moves: not when the response
+ * times change, not when the ticket's priority does.
+ */
+
+/** The response time of each priority, in hours, unless DUE_HOURS_<PRIORITY> says otherwise (src/config.js). */
+const DEFAULT_RESPONSE_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+const HOUR_MS = 60 * 60 * 1000;
+
+/** The due time (ISO 8601) of a ticket of `priority` created at `created` (ISO 8601), given the response `hours`. */
+function dueFor(created, priority, hours = DEFAULT_RESPONSE_HOURS) {
+  if (!PRIORITIES.includes(priority)) throw new RangeError(`not a priority: ${priority}`);
+  return new Date(Date.parse(created) + hours[priority] * HOUR_MS).toISOString();
+}
+
+/** Whether `ticket` is overdue at `now` (a Date): someone still has to work on it and its due time has passed. */
+function isOverdue(ticket, now) {
+  return isActive(ticket.status) && typeof ticket.due === 'string' && Date.parse(ticket.due) < now.getTime();
+}
+
+module.exports = { DEFAULT_RESPONSE_HOURS, dueFor, isOverdue };
