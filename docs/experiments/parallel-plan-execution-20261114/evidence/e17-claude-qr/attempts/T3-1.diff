diff --git a/src/tickets/due.js b/src/tickets/due.js
new file mode 100644
index 0000000..dfab03c
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,39 @@
+'use strict';
+
+const { PRIORITIES } = require('./priorities');
+const { isActive } = require('./states');
+
+/**
+ * Due times (docs/decisions/0009-due-times.md). A ticket's due time is the time it was created plus the response time
+ * of its priority at that moment. It is set once and never moves: not when the hours change, not when the ticket's
+ * priority does.
+ */
+
+const HOUR_MS = 60 * 60 * 1000;
+
+/** The response time, in hours, of each priority. The settings (src/config.js) can change them. */
+const DEFAULT_RESPONSE_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+/** The due time, as ISO text, of a ticket created at `created` (ISO text) with `priority`. */
+function dueTime(created, priority, hours = DEFAULT_RESPONSE_HOURS) {
+  return new Date(Date.parse(created) + hours[priority] * HOUR_MS).toISOString();
+}
+
+/** Whether `ticket` is open or in progress and its due time is before `now` (a Date). */
+function isOverdue(ticket, now) {
+  if (typeof ticket.due !== 'string') return false;
+  if (!isActive(ticket.status)) return false;
+  return Date.parse(ticket.due) < now.getTime();
+}
+
+/**
+ * The priority a ticket had when it was created: the one its creation entry in the audit log recorded, else (an entry
+ * that is not there) the one it has now.
+ */
+function creationPriority(ticket, auditEntries) {
+  const entry = auditEntries.find((candidate) => candidate.ticket === ticket.id && candidate.action === 'ticket.created');
+  const recorded = entry && entry.changes && entry.changes.priority && entry.changes.priority.to;
+  return PRIORITIES.includes(recorded) ? recorded : ticket.priority;
+}
+
+module.exports = { DEFAULT_RESPONSE_HOURS, creationPriority, dueTime, isOverdue };
