+/** The most tickets one import takes. */
+const IMPORT_MAX = 5000;
+
+/**
+ * POST /tickets/import: { tickets: [ <what POST /tickets takes>, ... ] }, at most IMPORT_MAX. The first invalid item
+ * is refused by its index in the array (0 for the first); nothing is returned for the store until every item is valid.
+ */
+function ticketImport(body) {
+  onlyFields(body, ['tickets']);
+  if (!Array.isArray(body.tickets)) throw new InvalidError('tickets must be a list');
+  if (body.tickets.length > IMPORT_MAX) throw new InvalidError(`tickets must have at most ${IMPORT_MAX} items`);
+  return body.tickets.map((item, index) => {
+    try {
+      if (item === null || typeof item !== 'object' || Array.isArray(item)) throw new InvalidError('must be an object');
+      return newTicket(item);
+    } catch (error) {
+      if (error instanceof InvalidError) throw new InvalidError(`tickets[${index}] (item ${index}): ${error.message}`);
+      throw error;
+    }
+  });
+}
+
 /** PATCH /tickets/:id: { title?, priority? }, at least one of them. */
 function ticketPatch(body) {
   onlyFields(body, ['title', 'priority']);
