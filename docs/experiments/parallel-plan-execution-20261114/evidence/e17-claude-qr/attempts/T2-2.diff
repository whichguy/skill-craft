+  createTickets(inputs, actor) {
+    if (inputs.length === 0) return [];
+    const before = { nextNumber: this.nextNumber, audit: this.audit.entries.length, outbox: this.outbox.events.length, nextId: this.outbox.nextId };
+    const created = [];
+    try {
+      for (const input of inputs) created.push(this.open(input, actor));
+      this.save();
+    } catch (error) {
+      for (const ticket of created) this.tickets.delete(ticket.id);
+      this.nextNumber = before.nextNumber;
+      this.audit.entries.length = before.audit;
+      this.outbox.events.length = before.outbox;
+      this.outbox.nextId = before.nextId;
+      throw error;
+    }
