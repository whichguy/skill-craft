+  }
+
+  test('PUT assigns and unassigns, and every ticket shows its assignee', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, null);
+      const assigned = await api.put('/tickets/T-0001/assignee', { assignee: 'sam' }, { 'x-actor': 'dana' });
+      assert.equal(assigned.status, 200);
+      assert.equal(assigned.body.assignee, 'sam');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'sam');
+      assert.equal((await api.get('/tickets')).body.items.map((t) => t.assignee).join(), 'sam,,');
+      const audit = (await api.get('/tickets/T-0001/audit')).body.items.at(-1);
+      assert.equal(audit.actor, 'dana');
+      assert.deepEqual(audit.changes, { assignee: { from: null, to: 'sam' } });
+      const unassigned = await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.equal(unassigned.body.assignee, null);
+    });
+  });
+
+  test('answers 400, 404 and 409 in the envelope', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      for (const body of [{}, { assignee: '' }, { assignee: 'x'.repeat(65) }, { assignee: 3 }]) {
+        const response = await api.put('/tickets/T-0001/assignee', body);
+        assert.equal(response.status, 400);
+        assert.equal(response.body.error.code, 'invalid');
+      }
+      assert.equal((await api.put('/tickets/T-0099/assignee', { assignee: 'sam' })).status, 404);
+      await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+      await api.post('/tickets/T-0002/transition', { to: 'resolved' });
+      const conflict = await api.put('/tickets/T-0002/assignee', { assignee: 'sam' });
+      assert.equal(conflict.status, 409);
+      assert.equal(conflict.body.error.code, 'conflict');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, null);
+    });
+  });
+
+  test('assigning the same agent again changes nothing', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      const audits = (await api.get('/tickets/T-0001/audit')).body.items.length;
+      const outbox = (await api.get('/admin/outbox')).body.pending.length;
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'sam' })).status, 200);
+      assert.equal((await api.get('/tickets/T-0001/audit')).body.items.length, audits);
+      assert.equal((await api.get('/admin/outbox')).body.pending.length, outbox);
+    });
+  });
+
+  test('lists by assignee, the unassigned with an empty value, and combines filters', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      await api.put('/tickets/T-0002/assignee', { assignee: 'sam' });
+      const ids = async (query) => (await api.get(`/tickets?${query}`)).body.items.map((t) => t.id).join();
+      assert.equal(await ids('assignee=sam'), 'T-0001,T-0002');
+      assert.equal(await ids('assignee='), 'T-0003');
+      assert.equal(await ids('assignee=kim'), '');
+      assert.equal(await ids('assignee=sam&priority=high'), 'T-0001');
+      assert.equal(await ids('assignee=&priority=low'), '');
+      assert.equal(await ids('status=open&priority=high'), 'T-0001,T-0003');
+      assert.equal(await ids('status=closed&priority=high'), '');
+    });
+  });
+
+  test('delivers the notice to the agent, by the worker', async () => {
+    await withService({}, async (api, service) => {
+      await seed(api);
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      const pending = (await api.get('/admin/outbox')).body.pending;
+      const event = pending.find((e) => e.type === 'ticket.assigned');
+      assert.equal(event.to, 'sam');
+      const { render } = require('../src/templates');
+      assert.match(render(event).subject, /T-0001/);
+      assert.ok(service);
+    });
+  });
+});
+
+describe('data file and command line', () => {
+  function withFile(fn) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'assign-'));
+    try {
+      return fn(path.join(dir, 'tickets.json'));
+    } finally {
+      fs.rmSync(dir, { recursive: true, force: true });
+    }
+  }
+
+  function run(argv, file) {
+    let out = '';
+    const code = main(['--data', file, ...argv], { out: { write: (s) => { out += s; } }, err: { write: () => {} } });
+    return { code, out };
+  }
+
+  test('the assignee survives a restart, and an old file loads as unassigned', () => {
+    withFile((file) => {
+      const clock = manualClock('2025-09-01T08:00:00.000Z');
+      const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+      store.createTicket(input(), 'dana');
+      store.createTicket(input(), 'dana');
+      store.assign('T-0001', 'sam', 'dana');
+      const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+      delete document.tickets[1].assignee;
+      fs.writeFileSync(file, JSON.stringify(document));
+      const reopened = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+      assert.equal(reopened.get('T-0001').assignee, 'sam');
+      assert.equal(reopened.get('T-0002').assignee, null);
+      assert.equal(reopened.list({ filters: { assignee: null } }).items.length, 1);
+    });
+  });
+
+  test('refuses a data file with a bad assignee', () => {
+    withFile((file) => {
+      const clock = manualClock('2025-09-01T08:00:00.000Z');
+      const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+      store.createTicket(input(), 'dana');
+      const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+      document.tickets[0].assignee = '';
+      fs.writeFileSync(file, JSON.stringify(document));
+      assert.throws(() => createPersistence(file).load(), /assignee/);
+    });
+  });
+
+  test('list shows the assignee, raw lists it after the columns the report reads, and filters by it', () => {
+    withFile((file) => {
+      const clock = manualClock('2025-09-01T08:00:00.000Z');
+      const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+      store.createTicket(input({ title: 'One' }), 'dana');
+      store.createTicket(input({ title: 'Two' }), 'dana');
+      store.assign('T-0001', 'sam', 'dana');
+
+      const raw = run(['list', '--raw'], file).out.split('\n').filter(Boolean).map((line) => line.split('\t'));
+      assert.deepEqual(raw[0].slice(0, 4), ['T-0001', 'open', 'normal', 'One']);
+      assert.equal(raw[0][4], 'sam');
+      assert.deepEqual(raw[1], ['T-0002', 'open', 'normal', 'Two', '']);
+      assert.deepEqual(count(run(['list', '--raw'], file).out.split('\n').filter(Boolean)).byStatus.open, 2);
+
+      const tableOut = run(['list'], file).out.split('\n');
+      assert.match(tableOut[0], /ASSIGNEE/);
+      assert.match(tableOut[1], /\bsam\b/);
+
+      assert.equal(run(['list', '--raw', '--assignee', 'sam'], file).out.trim().split('\n').length, 1);
+      assert.match(run(['list', '--raw', '--assignee', ''], file).out, /^T-0002\t/);
+      assert.match(run(['show', 'T-0001'], file).out, /assignee\s+sam/);
+    });
+  });
+
+  test('format helpers show a missing assignee as empty or a dash', () => {
+    const ticket = { id: 'T-0001', status: 'open', priority: 'low', requester: 'a', updated: '2025-09-01T08:00:00.000Z', title: 'x', assignee: null };
+    assert.equal(rawLine(ticket), 'T-0001\topen\tlow\tx\t');
+    assert.match(table([ticket]), /-\s+2025-09-01 08:00/);
+  });
+});
