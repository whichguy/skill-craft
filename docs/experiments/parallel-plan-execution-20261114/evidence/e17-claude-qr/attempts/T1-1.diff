+describe('the data file', () => {
+  const folder = (t) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    return dir;
+  };
+
+  test('keeps assignees across a restart', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const first = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    first.create(input(), 'dana');
+    first.create(input(), 'dana');
+    first.assign('T-0001', 'sam', 'dana');
+    const again = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(again.get('T-0001').assignee, 'sam');
+    assert.equal(again.get('T-0002').assignee, null);
+  });
+
+  test('a file saved before assignment existed loads, with every ticket unassigned', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const old = TicketStore.open({ clock });
+    old.create(input(), 'dana');
+    const document = { version: 1, savedAt: clock.now().toISOString(), ...JSON.parse(JSON.stringify(old.snapshot())) };
+    for (const ticket of document.tickets) delete ticket.assignee;
+    fs.writeFileSync(file, JSON.stringify(document));
+    const loaded = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(loaded.get('T-0001').assignee, null);
+    assert.deepEqual(loaded.list({ filters: { assignee: null } }).items.map((ticket) => ticket.id), ['T-0001']);
+    assert.equal(loaded.assign('T-0001', 'sam', 'dana').assignee, 'sam');
+  });
+
+  test('refuses a file with an assignee that is not a name', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const state = TicketStore.open({ clock });
+    state.create(input(), 'dana');
+    const document = { version: 1, savedAt: clock.now().toISOString(), ...JSON.parse(JSON.stringify(state.snapshot())) };
+    document.tickets[0].assignee = 5;
+    fs.writeFileSync(file, JSON.stringify(document));
+    assert.throws(() => createPersistence(file).load(), /tickets\[0\]\.assignee/);
+  });
+});
+
+describe('the command line', () => {
+  function run(t, argv) {
+    const file = path.join(fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-cli-')), 'tickets.json');
+    t.after(() => fs.rmSync(path.dirname(file), { recursive: true, force: true }));
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    const tickets = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    tickets.create(input({ title: 'VPN drops' }), 'dana');
+    tickets.create(input({ title: 'Printer jams' }), 'dana');
+    tickets.assign('T-0001', 'sam', 'dana');
+    let out = '';
+    const code = main(['--data', file, ...argv], { env: {}, out: { write: (text) => { out += text; } }, err: { write: () => {} } });
+    assert.equal(code, 0);
+    return out;
+  }
+
+  test('list shows each ticket\'s assignee', (t) => {
+    const [header, first, second] = run(t, ['list']).trimEnd().split('\n');
+    assert.match(header, /\bASSIGNEE\b/);
+    const column = header.indexOf('ASSIGNEE');
+    assert.equal(first.slice(column).split(/\s+/)[0], 'sam');
+    assert.equal(second.slice(column).split(/\s+/)[0], '-');
+  });
+
+  test('list --raw keeps its first four columns and adds the assignee after them', (t) => {
+    const lines = run(t, ['list', '--raw']).replace(/\n$/, '').split('\n').map((line) => line.split('\t'));
+    assert.deepEqual(lines, [
+      ['T-0001', 'open', 'normal', 'VPN drops', 'sam'],
+      ['T-0002', 'open', 'normal', 'Printer jams', ''],
+    ]);
+  });
+
+  test('show names the assignee', (t) => {
+    assert.match(run(t, ['show', 'T-0001']), /assignee\s+sam/);
+  });
+});
