+describe('GET /tickets?assignee=', () => {
+  async function seeded(api) {
+    for (const priority of ['high', 'high', 'low', 'high']) await api.post('/tickets', ticketBody({ priority }));
+    await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+    await api.put('/tickets/T-0003/assignee', { assignee: 'sam' });
+    await api.put('/tickets/T-0004/assignee', { assignee: 'kim' });
+    await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+  }
+  const ids = async (api, query) => (await api.get(`/tickets?${query}`)).body.items.map((ticket) => ticket.id);
+
+  test('keeps an agent\'s tickets, or the unassigned ones with an empty value', async () => {
+    await withService({}, async (api) => {
+      await seeded(api);
+      assert.deepEqual(await ids(api, 'assignee=sam'), ['T-0001', 'T-0003']);
+      assert.deepEqual(await ids(api, 'assignee=kim'), ['T-0004']);
+      assert.deepEqual(await ids(api, 'assignee='), ['T-0002']);
+      assert.deepEqual(await ids(api, 'assignee=nobody'), []);
+      assert.deepEqual(await ids(api, ''), ['T-0001', 'T-0002', 'T-0003', 'T-0004']);
+    });
+  });
+
+  test('a ticket must match every filter given', async () => {
+    await withService({}, async (api) => {
+      await seeded(api);
+      assert.deepEqual(await ids(api, 'assignee=sam&priority=high'), ['T-0001']);
+      assert.deepEqual(await ids(api, 'assignee=sam&status=open'), ['T-0003']);
+      assert.deepEqual(await ids(api, 'assignee=&status=open'), ['T-0002']);
+      assert.deepEqual(await ids(api, 'status=open&priority=high'), ['T-0002', 'T-0004']);
+      assert.deepEqual(await ids(api, 'assignee=kim&status=in_progress'), []);
+    });
+  });
+
+  test('pages with the filter', async () => {
+    await withService({}, async (api) => {
+      await seeded(api);
+      const first = (await api.get('/tickets?assignee=sam&limit=1')).body;
+      assert.deepEqual(first.items.map((ticket) => ticket.id), ['T-0001']);
+      const second = (await api.get(`/tickets?assignee=sam&limit=1&cursor=${first.next}`)).body;
+      assert.deepEqual(second.items.map((ticket) => ticket.id), ['T-0003']);
+      assert.equal(second.next, null);
+    });
+  });
+});
