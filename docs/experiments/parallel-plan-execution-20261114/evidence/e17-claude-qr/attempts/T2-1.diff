+++ b/test/import.test.js
@@ -0,0 +1,178 @@
+'use strict';
+
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const { manualClock } = require('../src/clock');
+const { TicketStore } = require('../src/store');
+const { MAX_IMPORT, importTickets } = require('../src/tickets/validate');
+const { ticketBody, withService } = require('./helpers');
+
+const items = (count) => Array.from({ length: count }, (_, i) => ticketBody({ title: `Ticket ${i}`, requester: `user${i}@example.com` }));
+
+describe('POST /tickets/import', () => {
+  test('creates the tickets in order and answers 201 with the count and the ids', async () => {
+    await withService({}, async (api) => {
+      const { status, body } = await api.post('/tickets/import', { tickets: items(3) });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 3, ids: ['T-0001', 'T-0002', 'T-0003'] });
+      const listed = (await api.get('/tickets')).body.items;
+      assert.deepEqual(listed.map((t) => t.title), ['Ticket 0', 'Ticket 1', 'Ticket 2']);
+      assert.ok(listed.every((t) => t.status === 'open'));
+    });
+  });
+
+  test('takes what POST /tickets takes: the priority defaults to normal', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets/import', { tickets: [{ title: 'a', requester: 'r' }, ticketBody({ priority: 'urgent' })] });
+      assert.equal((await api.get('/tickets/T-0001')).body.priority, 'normal');
+      assert.equal((await api.get('/tickets/T-0002')).body.priority, 'urgent');
+    });
+  });
+
+  test('numbers continue after tickets created one by one', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      assert.deepEqual((await api.post('/tickets/import', { tickets: items(2) })).body.ids, ['T-0002', 'T-0003']);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0004');
+    });
+  });
+
+  test('records each ticket in the audit log with the actor, and notifies each requester', async () => {
+    await withService({}, async (api, service) => {
+      await api.post('/tickets/import', { tickets: items(2) }, { 'x-actor': 'dana' });
+      for (const [id, requester] of [['T-0001', 'user0@example.com'], ['T-0002', 'user1@example.com']]) {
+        const history = (await api.get(`/tickets/${id}/audit`)).body.items;
+        assert.equal(history.length, 1);
+        assert.equal(history[0].action, 'ticket.created');
+        assert.equal(history[0].actor, 'dana');
+      }
+      const pending = (await api.get('/admin/outbox')).body.pending;
+      assert.deepEqual(pending.map((e) => [e.type, e.to, e.ticket]), [
+        ['ticket.created', 'user0@example.com', 'T-0001'],
+        ['ticket.created', 'user1@example.com', 'T-0002'],
+      ]);
+      assert.equal(service.store.audit.size, 2);
+    });
+  });
+
+  test('the worker delivers the notifications of imported tickets', async () => {
+    await withService({}, async (api, service) => {
+      await api.post('/tickets/import', { tickets: items(3) });
+      const { deliverOutbox } = require('../src/worker');
+      const report = deliverOutbox({ store: service.store, notifier: service.notifier, log: console }).run();
+      assert.equal(report.sent, 3);
+      assert.equal((await api.get('/admin/outbox')).body.sent.length, 3);
+    });
+  });
+
+  test('creates none and names the first invalid item by its index when any item is invalid', async () => {
+    await withService({}, async (api) => {
+      const tickets = items(5);
+      tickets[3] = ticketBody({ title: '' });
+      tickets[4] = ticketBody({ priority: 'asap' });
+      const { status, body } = await api.post('/tickets/import', { tickets });
+      assert.equal(status, 400);
+      assert.equal(body.error.code, 'invalid');
+      assert.match(body.error.message, /tickets\[3\]/);
+      assert.deepEqual((await api.get('/tickets')).body.items, []);
+      assert.deepEqual((await api.get('/admin/outbox')).body.pending, []);
+      // nothing was numbered either
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0001');
+    });
+  });
+
+  test('index 0 names the first item; items that are not objects are invalid', async () => {
+    await withService({}, async (api) => {
+      const first = await api.post('/tickets/import', { tickets: [ticketBody({ owner: 'x' }), ticketBody()] });
+      assert.equal(first.status, 400);
+      assert.match(first.body.error.message, /tickets\[0\]/);
+      for (const bad of [null, 'text', 7, [], [ticketBody()]]) {
+        const response = await api.post('/tickets/import', { tickets: [ticketBody(), bad] });
+        assert.equal(response.status, 400);
+        assert.match(response.body.error.message, /tickets\[1\]/);
+      }
+    });
+  });
+
+  test('refuses a body whose tickets is missing or not a list, or that has other fields', async () => {
+    await withService({}, async (api) => {
+      for (const body of [{}, { tickets: 'x' }, { tickets: {} }, { tickets: null }, { tickets: [], extra: 1 }, [], '{"tickets":']) {
+        const response = await api.post('/tickets/import', body);
+        assert.equal(response.status, 400, JSON.stringify(body));
+        assert.equal(response.body.error.code, 'invalid');
+      }
+    });
+  });
+
+  test('takes 5000 tickets and refuses 5001', async () => {
+    await withService({}, async (api) => {
+      const over = await api.post('/tickets/import', { tickets: items(MAX_IMPORT + 1) });
+      assert.equal(over.status, 400);
+      assert.equal((await api.get('/tickets')).body.items.length, 0);
+      const { status, body } = await api.post('/tickets/import', { tickets: items(MAX_IMPORT) });
+      assert.equal(status, 201);
+      assert.equal(body.created, 5000);
+      assert.equal(body.ids.length, 5000);
+      assert.equal(body.ids[0], 'T-0001');
+      assert.equal(body.ids[4999], 'T-5000');
+    });
+  });
+
+  test('an import of 5000 full-size tickets is answered within 10 seconds, with the default body limit and a data file', async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'import-'));
+    try {
+      await withService({ dataFile: path.join(dir, 'tickets.json') }, async (api, service) => {
+        const tickets = Array.from({ length: 5000 }, (_, i) => ({ title: `${i} ${'t'.repeat(190)}`, requester: `${'r'.repeat(50)}${i}`, priority: 'high' }));
+        const started = Date.now();
+        const response = await api.post('/tickets/import', { tickets });
+        assert.equal(response.status, 201);
+        assert.ok(Date.now() - started < 10000, `took ${Date.now() - started} ms`);
+        assert.equal(service.store.tickets.size, 5000);
+        const saved = JSON.parse(fs.readFileSync(path.join(dir, 'tickets.json'), 'utf8'));
+        assert.equal(saved.tickets.length, 5000);
+        assert.equal(saved.audit.length, 5000);
+        assert.equal(saved.outbox.events.length, 5000);
+      });
+    } finally {
+      fs.rmSync(dir, { recursive: true, force: true });
+    }
+  });
+
+  test('the import does not widen the limit of the other routes', async () => {
+    await withService({}, async (api) => {
+      const big = await api.post('/tickets', ticketBody({ title: 'x'.repeat(100000) }));
+      assert.equal(big.status, 400);
+      assert.match(big.body.error.message, /larger than 65536 bytes/);
+    });
+  });
+});
+
+describe('TicketStore.createMany', () => {
+  const input = (n) => ({ title: `t${n}`, requester: 'li@example.com', priority: 'normal' });
+
+  test('saves once for the whole batch', () => {
+    let saves = 0;
+    const store = new TicketStore({ clock: manualClock(), persistence: { save: () => { saves += 1; } } });
+    store.createMany([input(1), input(2), input(3)], 'dana');
+    assert.equal(saves, 1);
+  });
+
+  test('goes back to the state before the call when saving fails', () => {
+    const store = new TicketStore({ clock: manualClock(), persistence: { save() { throw new Error('disk full'); } } });
+    assert.throws(() => store.createMany([input(1), input(2)], 'dana'), /disk full/);
+    assert.equal(store.tickets.size, 0);
+    assert.equal(store.audit.size, 0);
+    assert.deepEqual(store.outbox.toJSON(), { nextId: 1, events: [] });
+    assert.equal(store.nextNumber, 1);
+  });
+});
+
+describe('validate.importTickets', () => {
+  test('returns the checked tickets in order', () => {
+    const result = importTickets({ tickets: [{ title: ' a ', requester: 'r' }] });
+    assert.deepEqual(result, [{ title: 'a', requester: 'r', priority: 'normal' }]);
+  });
+});
