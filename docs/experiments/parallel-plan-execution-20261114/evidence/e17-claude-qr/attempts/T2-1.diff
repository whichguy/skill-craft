+/**
+ * POST /tickets/import: { tickets: [ <what POST /tickets takes>, ... ] }, at most MAX_IMPORT. Every item is checked
+ * before anything is created; the first invalid one is an InvalidError naming its index in the array.
+ */
+function importTickets(body) {
+  onlyFields(body, ['tickets']);
+  if (!Array.isArray(body.tickets)) throw new InvalidError('tickets must be a list');
+  if (body.tickets.length > MAX_IMPORT) throw new InvalidError(`tickets must hold at most ${MAX_IMPORT} items`);
+  return body.tickets.map((item, index) => {
+    try {
+      if (item === null || typeof item !== 'object' || Array.isArray(item)) throw new InvalidError('must be a JSON object');
+      return newTicket(item);
+    } catch (error) {
+      if (error instanceof InvalidError) throw new InvalidError(`tickets[${index}]: ${error.message}`);
+      throw error;
+    }
+  });
+}
