+describe('the data file', () => {
+  test('gives the tickets of a file without due times theirs from their own creation time and priority, and saves them', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    fs.writeFileSync(file, JSON.stringify(legacyDocument()));
+    const clock = manualClock('2025-10-01T00:00:00.000Z');
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueTimes: true });
+    assert.deepEqual(store.list().items.map((ticket) => [ticket.id, ticket.due]), [
+      ['T-0001', '2025-09-10T13:00:00.000Z'],
+      ['T-0002', '2025-09-12T10:30:00.000Z'],
+      ['T-0003', '2025-09-15T11:00:00.000Z'],
+      ['T-0004', '2025-09-20T12:00:00.000Z'],
+    ]);
+    const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.deepEqual(saved.tickets.map((ticket) => ticket.due), store.list().items.map((ticket) => ticket.due), 'written at the first start');
+  });
+
+  test('keeps those due times from then on, whatever the hours become and whenever the file is read', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    fs.writeFileSync(file, JSON.stringify(legacyDocument()));
+    const clock = manualClock('2025-10-01T00:00:00.000Z');
+    const first = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueTimes: true });
+    const dues = first.list().items.map((ticket) => ticket.due);
+    clock.advance(1000 * HOUR);
+    const second = TicketStore.open({
+      clock, persistence: createPersistence(file, { clock }), dueTimes: true, responseHours: { urgent: 1, high: 1, normal: 1, low: 1 },
+    });
+    assert.deepEqual(second.list().items.map((ticket) => ticket.due), dues);
+    second.update('T-0004', { priority: 'urgent' }, 'dana');
+    assert.equal(second.get('T-0004').due, dues[3]);
+  });
+
+  test('holds the due times even while DUE_TIMES is off, and new tickets get them too', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    fs.writeFileSync(file, JSON.stringify(legacyDocument()));
+    const clock = manualClock(START);
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket(input('urgent'), 'dana');
+    const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(saved.tickets.length, 5);
+    assert.equal(saved.tickets[0].due, '2025-09-10T13:00:00.000Z');
+    assert.equal(saved.tickets[4].due, plus(START, 4));
+  });
+
+  test('stays version 1 and keeps every field of 1.4.0, so 1.4.0 starts on it and shows every ticket', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    fs.writeFileSync(file, JSON.stringify(legacyDocument()));
+    const clock = manualClock(START);
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueTimes: true });
+    store.createTicket(input('high'), 'dana');
+    const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(saved.version, 1);
+    assert.deepEqual(Object.keys(saved), ['version', 'savedAt', 'nextNumber', 'tickets', 'audit', 'outbox']);
+    for (const ticket of saved.tickets) {
+      for (const field of ['id', 'title', 'priority', 'requester', 'status', 'assignee', 'created', 'updated']) {
+        assert.ok(field in ticket, `${ticket.id} keeps ${field}`);
+      }
+    }
+    assert.equal(saved.tickets.length, 5);
+    // What 1.4.0 does with a record: it reads the fields it knows by name. Nothing else is looked at.
+    const legacyRead = ({ id, title, priority, requester, status, assignee, created, updated }) => ({ id, title, priority, requester, status, assignee, created, updated });
+    assert.deepEqual(saved.tickets.slice(0, 4).map(legacyRead), legacyDocument().tickets);
+  });
+
+  test('a file this release wrote is read again without changing anything', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock(START);
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket(input('urgent'), 'dana');
+    const before = fs.readFileSync(file, 'utf8');
+    TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(fs.readFileSync(file, 'utf8'), before, 'nothing to backfill, nothing rewritten');
+  });
+
+  test('a due time that is not a time is refused', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const document = legacyDocument();
+    document.tickets[0].due = 'tomorrow';
+    fs.writeFileSync(file, JSON.stringify(document));
+    assert.throws(() => createPersistence(file).load(), /tickets\[0\]\.due is not a time/);
+  });
+});
