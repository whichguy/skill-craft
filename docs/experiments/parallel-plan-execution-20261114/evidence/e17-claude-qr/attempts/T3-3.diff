+describe('overdue tickets', () => {
+  function setup() {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock, dueTimes: true });
+    const open = store.createTicket(input('urgent', 'open one'), 'dana').id; // due +4h
+    const working = store.createTicket(input('urgent', 'working one'), 'dana').id;
+    store.transition(working, 'in_progress', 'sam');
+    const resolved = store.createTicket(input('urgent', 'resolved one'), 'dana').id;
+    store.transition(resolved, 'in_progress', 'sam');
+    store.transition(resolved, 'resolved', 'sam');
+    const closed = store.createTicket(input('urgent', 'closed one'), 'dana').id;
+    store.transition(closed, 'in_progress', 'sam');
+    store.transition(closed, 'resolved', 'sam');
+    store.transition(closed, 'closed', 'sam');
+    const later = store.createTicket(input('low', 'low one'), 'dana').id; // due +168h
+    return { clock, store, ids: { open, working, resolved, closed, later } };
+  }
+  const listed = (store, overdue) => store.list({ overdue }).items.map((ticket) => ticket.id);
+
+  test('are the open and in-progress tickets whose due time has passed', () => {
+    const { clock, store, ids } = setup();
+    assert.deepEqual(listed(store, true), [], 'nothing is overdue yet');
+    clock.advance(4 * HOUR);
+    assert.deepEqual(listed(store, true), [], 'a ticket is not overdue at the very moment it is due');
+    clock.advance(1);
+    assert.deepEqual(listed(store, true), [ids.open, ids.working]);
+    clock.advance(200 * HOUR);
+    assert.deepEqual(listed(store, true), [ids.open, ids.working, ids.later]);
+  });
+
+  test('a ticket leaves the list when it is resolved, and returns when it is reopened', () => {
+    const { clock, store, ids } = setup();
+    clock.advance(10 * HOUR);
+    store.transition(ids.working, 'resolved', 'sam');
+    assert.deepEqual(listed(store, true), [ids.open]);
+    store.transition(ids.resolved, 'open', 'li@example.com');
+    assert.deepEqual(listed(store, true), [ids.open, ids.resolved]);
+  });
+
+  test('overdue=false lists the others; without the filter every ticket is listed', () => {
+    const { clock, store, ids } = setup();
+    clock.advance(10 * HOUR);
+    assert.deepEqual(listed(store, false), [ids.resolved, ids.closed, ids.later]);
+    assert.equal(listed(store, undefined).length, 5);
+  });
+
+  test('combine with the other filters and with pages', () => {
+    const { clock, store, ids } = setup();
+    clock.advance(10 * HOUR);
+    assert.deepEqual(store.list({ filters: { status: 'open' }, overdue: true }).items.map((ticket) => ticket.id), [ids.open]);
+    const first = store.list({ overdue: true, limit: 1 });
+    assert.deepEqual([first.items.map((ticket) => ticket.id), first.next !== null], [[ids.open], true]);
+    assert.deepEqual(store.list({ overdue: true, limit: 1, after: ids.open }).items.map((ticket) => ticket.id), [ids.working]);
+  });
+
+  test('isOverdue and the overdue parameter', () => {
+    const now = new Date(START);
+    assert.equal(isOverdue({ status: 'open', due: plus(START, -1) }, now), true);
+    assert.equal(isOverdue({ status: 'resolved', due: plus(START, -1) }, now), false);
+    assert.equal(isOverdue({ status: 'open', due: null }, now), false);
+    const query = (text, options) => parseListQuery(new URLSearchParams(text), options);
+    assert.equal(query('overdue=true', { dueTimes: true }).overdue, true);
+    assert.equal(query('overdue=false', { dueTimes: true }).overdue, false);
+    assert.equal('overdue' in query('status=open', { dueTimes: true }), false);
+    assert.throws(() => query('overdue=maybe', { dueTimes: true }), /overdue must be true or false/);
+    assert.equal('overdue' in query('overdue=true'), false, 'ignored while due times are off');
+    assert.doesNotThrow(() => query('overdue=maybe'));
+  });
+});
