+      assert.deepEqual((await api.get('/tickets')).body.items.map((ticket) => ticket.due), [plus(START, 4), plus(START, 168)]);
+      assert.deepEqual((await api.get('/tickets?overdue=true')).body.items, []);
+      clock.advance(5 * HOUR);
+      assert.deepEqual((await api.get('/tickets?overdue=true')).body.items.map((ticket) => ticket.id), ['T-0001']);
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.deepEqual((await api.get('/tickets?overdue=true')).body.items.map((ticket) => ticket.id), ['T-0001']);
+      const patched = await api.patch('/tickets/T-0001', { priority: 'low' });
+      assert.equal(patched.body.due, plus(START, 4));
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+      assert.deepEqual((await api.get('/tickets?overdue=true')).body.items, []);
+      assert.equal((await api.get('/tickets?overdue=soon')).status, 400);
+    });
+  });
+
+  test('with DUE_TIMES off, nothing shows and overdue is ignored, as before due times', async () => {
