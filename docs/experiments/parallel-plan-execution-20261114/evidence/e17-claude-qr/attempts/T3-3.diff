diff --git a/src/tickets/due.js b/src/tickets/due.js
new file mode 100644
index 0000000..3cc389a
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,38 @@
+'use strict';
+
+const { PRIORITIES } = require('./priorities');
+const { isActive } = require('./states');
+
+/**
+ * Due times: a ticket is due its creation time plus the response time of its priority, set once when the ticket is
+ * created (or, for a ticket that predates due times, when the data file first gains them) and never moved after: not by
+ * a later change of the priority, nor by a change of the hours.
+ */
+
+const HOUR_MS = 60 * 60 * 1000;
+
+/** The response time in hours of each priority, unless the settings say otherwise (README.md, "Configuration"). */
+const DEFAULT_RESPONSE_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+/** The ISO time `priority` gives a ticket created at `created` (an ISO string), under `hours`. */
+function dueFor(created, priority, hours = DEFAULT_RESPONSE_HOURS) {
+  return new Date(Date.parse(created) + hours[priority] * HOUR_MS).toISOString();
+}
+
+/** Whether `ticket` is open or in progress and its due time is before `now` (a Date). A ticket without a due time is not. */
+function isOverdue(ticket, now) {
+  return isActive(ticket.status) && typeof ticket.due === 'string' && Date.parse(ticket.due) < now.getTime();
+}
+
+/** `hours` over the defaults, checked: every priority needs a positive whole number of hours. */
+function responseHours(hours = {}) {
+  const merged = { ...DEFAULT_RESPONSE_HOURS, ...hours };
+  for (const priority of PRIORITIES) {
+    if (!Number.isSafeInteger(merged[priority]) || merged[priority] < 1) {
+      throw new RangeError(`the response time of ${priority} tickets must be a positive whole number of hours`);
+    }
+  }
+  return Object.freeze(Object.fromEntries(PRIORITIES.map((priority) => [priority, merged[priority]])));
+}
+
+module.exports = { DEFAULT_RESPONSE_HOURS, dueFor, isOverdue, responseHours };
