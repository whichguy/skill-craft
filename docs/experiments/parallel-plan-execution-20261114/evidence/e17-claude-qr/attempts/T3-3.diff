@@ -0,0 +1,331 @@
+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { loadConfig } = require('../src/config');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { DEFAULT_RESPONSE_HOURS, dueFor, isOverdue, responseHours } = require('../src/tickets/due');
+const { parseListQuery } = require('../src/tickets/query');
+const { ticketBody, withService } = require('./helpers');
+
+const HOUR = 60 * 60 * 1000;
+const START = '2025-09-01T08:00:00.000Z';
+const plus = (iso, hours) => new Date(Date.parse(iso) + hours * HOUR).toISOString();
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+const input = (priority, title = `A ${priority} ticket`) => ({ title, requester: 'maria@example.com', priority });
+
+/** The data file as release 1.4.0 wrote it: tickets without a due time. */
+function legacyDocument() {
+  const ticket = (n, priority, created, status = 'open') => ({
+    id: `T-000${n}`, title: `Old ${n}`, priority, requester: 'li@example.com', status, assignee: null, created, updated: created,
+  });
+  return {
+    version: 1,
+    savedAt: '2025-09-20T00:00:00.000Z',
+    nextNumber: 5,
+    tickets: [
+      ticket(1, 'urgent', '2025-09-10T09:00:00.000Z'),
+      ticket(2, 'high', '2025-09-11T10:30:00.000Z', 'in_progress'),
+      ticket(3, 'normal', '2025-09-12T11:00:00.000Z', 'closed'),
+      ticket(4, 'low', '2025-09-13T12:00:00.000Z'),
+    ],
+    audit: [],
+    outbox: { nextId: 1, events: [] },
+  };
+}
+
+describe('response times', () => {
+  test('the defaults are 4, 24, 72 and 168 hours', () => {
+    assert.deepEqual({ ...DEFAULT_RESPONSE_HOURS }, { urgent: 4, high: 24, normal: 72, low: 168 });
+    assert.equal(dueFor(START, 'urgent'), plus(START, 4));
+    assert.equal(dueFor(START, 'high'), plus(START, 24));
+    assert.equal(dueFor(START, 'normal'), plus(START, 72));
+    assert.equal(dueFor(START, 'low'), plus(START, 168));
+  });
+
+  test('the hours come from the settings, over the defaults, and must be positive whole numbers', () => {
+    const config = loadConfig({ RESPONSE_HOURS_URGENT: '2', RESPONSE_HOURS_LOW: '240' });
+    assert.deepEqual({ ...config.responseHours }, { urgent: 2, high: 24, normal: 72, low: 240 });
+    assert.deepEqual({ ...loadConfig({}).responseHours }, { ...DEFAULT_RESPONSE_HOURS });
+    assert.throws(() => loadConfig({ RESPONSE_HOURS_HIGH: '0' }), /RESPONSE_HOURS_HIGH must be from 1/);
+    assert.throws(() => loadConfig({ RESPONSE_HOURS_NORMAL: 'soon' }), /RESPONSE_HOURS_NORMAL must be a whole number/);
+    assert.throws(() => responseHours({ urgent: 0 }), RangeError);
+  });
+
+  test('DUE_TIMES is on only when it is exactly "on"', () => {
+    assert.equal(loadConfig({ DUE_TIMES: 'on' }).dueTimes, true);
+    for (const value of [undefined, '', 'off', '1', 'true', 'ON', 'yes']) {
+      assert.equal(loadConfig({ DUE_TIMES: value }).dueTimes, false, `DUE_TIMES=${value}`);
+    }
+  });
+});
+
+describe('a ticket\'s due time', () => {
+  test('is its creation time plus the hours of its priority', () => {
+    const store = new TicketStore({ clock: manualClock(START), dueTimes: true });
+    for (const priority of ['urgent', 'high', 'normal', 'low']) {
+      const ticket = store.createTicket(input(priority), 'dana');
+      assert.equal(ticket.created, START);
+      assert.equal(ticket.due, plus(START, DEFAULT_RESPONSE_HOURS[priority]));
+      assert.equal(store.get(ticket.id).due, ticket.due);
+    }
+  });
+
+  test('uses the configured hours', () => {
+    const store = new TicketStore({ clock: manualClock(START), dueTimes: true, responseHours: { urgent: 1, normal: 10 } });
