+describe('the data file', () => {
+  test('keeps assignees across a restart, and loads tickets saved without one as unassigned', (t) => {
+    const folder = fs.mkdtempSync(path.join(os.tmpdir(), 'assign-'));
+    t.after(() => fs.rmSync(folder, { recursive: true, force: true }));
+    const file = path.join(folder, 'tickets.json');
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    const first = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    first.createTicket(input(), 'system');
+    first.createTicket(input(), 'system');
+    first.assign('T-0001', 'dana', 'system');
+    const again = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(again.get('T-0001').assignee, 'dana');
+    assert.equal(again.get('T-0002').assignee, null);
+
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    for (const ticket of document.tickets) delete ticket.assignee;
+    fs.writeFileSync(file, JSON.stringify(document));
+    const old = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(old.get('T-0001').assignee, null);
+  });
+});
+
+describe('the command line', () => {
+  const run = (argv, file) => {
+    let out = '';
+    let err = '';
+    const code = main(argv, { env: { DATA_FILE: file }, out: { write: (s) => { out += s; } }, err: { write: (s) => { err += s; } } });
+    return { code, out, err };
+  };
+
+  function dataFile(t) {
+    const folder = fs.mkdtempSync(path.join(os.tmpdir(), 'assign-cli-'));
+    t.after(() => fs.rmSync(folder, { recursive: true, force: true }));
+    const file = path.join(folder, 'tickets.json');
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    const tickets = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    tickets.createTicket(input({ title: 'One' }), 'system');
+    tickets.createTicket(input({ title: 'Two' }), 'system');
+    tickets.assign('T-0001', 'dana', 'system');
+    return file;
+  }
+
+  test('list shows the assignee in the table', (t) => {
+    const { out } = run(['list'], dataFile(t));
+    const [header, one, two] = out.trim().split('\n');
+    assert.match(header, /ASSIGNEE/);
+    assert.match(one, /dana/);
+    assert.match(two, /-/);
+  });
+
+  test('list --raw keeps the first four columns and adds the assignee after them', (t) => {
+    const { out } = run(['list', '--raw'], dataFile(t));
+    const lines = out.replace(/\n$/, '').split('\n').map((line) => line.split('\t'));
+    assert.deepEqual(lines[0], ['T-0001', 'open', 'normal', 'One', 'dana']);
+    assert.deepEqual(lines[1], ['T-0002', 'open', 'normal', 'Two', '']);
+  });
+
+  test('list --assignee filters', (t) => {
+    const file = dataFile(t);
+    assert.equal(run(['list', '--raw', '--assignee', 'dana'], file).out.trim().split('\n').length, 1);
+    assert.match(run(['list', '--raw', '--assignee', ''], file).out, /^T-0002/);
+  });
+
+  test('format helpers handle a ticket without an assignee', () => {
+    assert.equal(rawLine({ id: 'T-1', status: 'open', priority: 'low', title: 'x' }), 'T-1\topen\tlow\tx\t');
+    assert.match(table([{ id: 'T-1', status: 'open', priority: 'low', requester: 'r', updated: '2025-09-01T08:00:00.000Z', title: 'x' }], TABLE_COLUMNS), /-/);
+  });
+});
