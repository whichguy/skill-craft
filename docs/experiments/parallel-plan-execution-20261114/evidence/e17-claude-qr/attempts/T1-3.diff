+describe('notification wording', () => {
+  test('tells the agent which ticket was assigned', () => {
+    const { subject, body } = render({ type: 'ticket.assigned', ticket: 'T-0007', to: 'dana', data: { title: 'Laptop' } });
+    assert.match(subject, /T-0007/);
+    assert.match(body, /assigned to you/);
+  });
+});
+
+describe('PUT /tickets/:id/assignee', () => {
+  const assign = (api, id, assignee, headers) => api.put(`/tickets/${id}/assignee`, { assignee }, headers);
+
+  test('assigns and unassigns, and every ticket shows its assignee', async () => {
+    await withService({}, async (api) => {
+      const created = await api.post('/tickets', ticketBody());
+      assert.equal(created.body.assignee, null);
+      const assigned = await assign(api, 'T-0001', 'dana');
+      assert.equal(assigned.status, 200);
+      assert.equal(assigned.body.assignee, 'dana');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'dana');
+      const unassigned = await assign(api, 'T-0001', null);
+      assert.equal(unassigned.status, 200);
+      assert.equal(unassigned.body.assignee, null);
+    });
+  });
+
+  test('records the actor in the audit log', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      await assign(api, 'T-0001', 'dana', { 'x-actor': 'lead' });
+      const { items } = (await api.get('/tickets/T-0001/audit')).body;
+      assert.deepEqual([items.at(-1).action, items.at(-1).actor], ['ticket.assigned', 'lead']);
+    });
+  });
+
+  test('refuses a bad body with 400 invalid', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      for (const body of [{}, { assignee: '' }, { assignee: 'a'.repeat(65) }, { assignee: 3 }, { assignee: 'dana', note: 'x' }]) {
+        const res = await api.put('/tickets/T-0001/assignee', body);
+        assert.equal(res.status, 400, JSON.stringify(body));
+        assert.equal(res.body.error.code, 'invalid');
+      }
+    });
+  });
+
+  test('404 for an unknown ticket, 409 for a resolved one', async () => {
+    await withService({}, async (api) => {
+      assert.equal((await assign(api, 'T-0099', 'dana')).status, 404);
+      await api.post('/tickets', ticketBody());
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.equal((await assign(api, 'T-0001', 'dana')).status, 200);
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+      const res = await assign(api, 'T-0001', 'omar');
+      assert.equal(res.status, 409);
+      assert.equal(res.body.error.code, 'conflict');
+    });
+  });
+
+  test('the same assignee again changes nothing', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const first = await assign(api, 'T-0001', 'dana');
+      await assign(api, 'T-0001', 'dana');
+      const { items } = (await api.get('/tickets/T-0001/audit')).body;
+      assert.equal(items.filter((entry) => entry.action === 'ticket.assigned').length, 1);
+      assert.deepEqual((await api.get('/tickets/T-0001')).body, first.body);
+      const outbox = (await api.get('/admin/outbox')).body;
+      assert.equal(outbox.pending.filter((event) => event.type === 'ticket.assigned').length, 1);
+    });
+  });
+
+  test('the agent is notified, by the worker, through the outbox', async () => {
+    await withService({}, async (api, service) => {
+      await api.post('/tickets', ticketBody());
+      await assign(api, 'T-0001', 'dana');
+      const { pending } = (await api.get('/admin/outbox')).body;
+      const event = pending.find((candidate) => candidate.type === 'ticket.assigned');
+      assert.equal(event.to, 'dana');
+      assert.equal(event.ticket, 'T-0001');
+    });
+  });
+
+  test('GET /tickets filters by assignee, and combines filters with and', async () => {
+    await withService({}, async (api) => {
+      for (const priority of ['high', 'low', 'high', 'low']) await api.post('/tickets', ticketBody({ priority }));
+      await assign(api, 'T-0001', 'dana');
+      await assign(api, 'T-0002', 'dana');
+      await assign(api, 'T-0003', 'omar');
+      const ids = async (query) => (await api.get(`/tickets${query}`)).body.items.map((ticket) => ticket.id);
+      assert.deepEqual(await ids('?assignee=dana'), ['T-0001', 'T-0002']);
+      assert.deepEqual(await ids('?assignee='), ['T-0004']);
+      assert.deepEqual(await ids('?assignee=nobody'), []);
+      assert.deepEqual(await ids('?assignee=dana&priority=high'), ['T-0001']);
+      assert.deepEqual(await ids('?status=open&priority=low'), ['T-0002', 'T-0004']);
+      assert.deepEqual(await ids('?status=closed&priority=low'), []);
+      assert.deepEqual(await ids('?assignee=&priority=high'), []);
+    });
+  });
+});
