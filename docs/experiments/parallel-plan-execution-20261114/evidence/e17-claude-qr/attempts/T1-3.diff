+const input = (overrides = {}) => ({ title: 'Laptop will not boot', requester: 'li@example.com', priority: 'normal', ...overrides });
+
+function store() {
+  const clock = manualClock('2025-09-01T08:00:00.000Z');
+  return { clock, store: new TicketStore({ clock }) };
+}
+
+describe('validate.assignee', () => {
+  test('takes an agent name or null', () => {
+    assert.equal(validate.assignee({ assignee: 'dana' }), 'dana');
+    assert.equal(validate.assignee({ assignee: null }), null);
+    assert.equal(validate.assignee({ assignee: 'a'.repeat(64) }), 'a'.repeat(64));
+  });
+
+  test('refuses a missing, empty, long, non-text or multi-line assignee, and other fields', () => {
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 'a'.repeat(65) }, { assignee: 7 }, { assignee: 'a\nb' }, { assignee: 'dana', extra: 1 }]) {
+      assert.throws(() => validate.assignee(body), InvalidError, JSON.stringify(body));
+    }
+  });
+});
+
+describe('store.assign', () => {
+  test('new tickets are unassigned', () => {
+    const { store: tickets } = store();
+    assert.equal(tickets.createTicket(input(), 'dana').assignee, null);
+  });
+
+  test('assigns, audits and notifies the agent', () => {
+    const { store: tickets, clock } = store();
+    tickets.createTicket(input(), 'system');
+    const ticket = tickets.assign('T-0001', 'dana', 'lead');
+    assert.equal(ticket.assignee, 'dana');
+    assert.equal(tickets.get('T-0001').assignee, 'dana');
+    const entry = tickets.history('T-0001').at(-1);
+    assert.equal(entry.action, 'ticket.assigned');
+    assert.equal(entry.actor, 'lead');
+    assert.deepEqual(entry.changes, { assignee: { from: null, to: 'dana' } });
+    const event = tickets.outboxReport().pending.find((candidate) => candidate.type === 'ticket.assigned');
+    assert.equal(event.to, 'dana');
+    assert.equal(event.ticket, 'T-0001');
+  });
+
+  test('works on an in progress ticket', () => {
+    const { store: tickets } = store();
+    tickets.createTicket(input(), 'system');
+    tickets.transition('T-0001', 'in_progress', 'system');
+    assert.equal(tickets.assign('T-0001', 'dana', 'system').assignee, 'dana');
+  });
+
+  test('assigning the agent the ticket already has changes nothing', () => {
+    const { store: tickets, clock } = store();
+    tickets.createTicket(input(), 'system');
+    const first = tickets.assign('T-0001', 'dana', 'system');
+    clock.advance(60000);
+    const audit = tickets.history('T-0001').length;
+    const events = tickets.outboxReport().pending.length;
+    const again = tickets.assign('T-0001', 'dana', 'system');
+    assert.deepEqual(again, first);
+    assert.equal(tickets.history('T-0001').length, audit);
+    assert.equal(tickets.outboxReport().pending.length, events);
+  });
+
+  test('unassigning an unassigned ticket changes nothing either', () => {
+    const { store: tickets } = store();
+    tickets.createTicket(input(), 'system');
+    tickets.assign('T-0001', null, 'system');
+    assert.equal(tickets.history('T-0001').length, 1);
+  });
+
+  test('unassigns with null, without a notification', () => {
