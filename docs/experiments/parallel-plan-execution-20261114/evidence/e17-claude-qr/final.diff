+    assert.throws(() => loadConfig({ RESPONSE_HOURS_HIGH: '0' }), /RESPONSE_HOURS_HIGH must be from 1/);
+    assert.throws(() => loadConfig({ RESPONSE_HOURS_NORMAL: 'soon' }), /RESPONSE_HOURS_NORMAL must be a whole number/);
+    assert.throws(() => responseHours({ urgent: 0 }), RangeError);
+  });
