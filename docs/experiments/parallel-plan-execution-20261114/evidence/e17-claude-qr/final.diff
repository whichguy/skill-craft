+
+describe('response times', () => {
+  test('the defaults are 4, 24, 72 and 168 hours', () => {
+    assert.deepEqual({ ...DEFAULT_RESPONSE_HOURS }, { urgent: 4, high: 24, normal: 72, low: 168 });
+    assert.equal(dueFor(START, 'urgent'), plus(START, 4));
+    assert.equal(dueFor(START, 'high'), plus(START, 24));
+    assert.equal(dueFor(START, 'normal'), plus(START, 72));
+    assert.equal(dueFor(START, 'low'), plus(START, 168));
+  });
+
+  test('the hours come from the settings, over the defaults, and must be positive whole numbers', () => {
