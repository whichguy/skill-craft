+  test('takes an agent name or null', () => {
+    assert.equal(validate.assignee({ assignee: 'dana' }), 'dana');
+    assert.equal(validate.assignee({ assignee: null }), null);
+    assert.equal(validate.assignee({ assignee: 'a'.repeat(64) }), 'a'.repeat(64));
+  });
+
+  test('refuses a missing, empty, long, non-text or multi-line assignee, and other fields', () => {
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 'a'.repeat(65) }, { assignee: 7 }, { assignee: 'a\nb' }, { assignee: 'dana', extra: 1 }]) {
+      assert.throws(() => validate.assignee(body), InvalidError, JSON.stringify(body));
+    }
+  });
+});
+
+describe('store.assign', () => {
+  test('new tickets are unassigned', () => {
+    const { store: tickets } = store();
+    assert.equal(tickets.createTicket(input(), 'dana').assignee, null);
