+const many = (count, overrides = () => ({})) =>
+  Array.from({ length: count }, (_, i) => ticketBody({ title: `Imported ${i}`, requester: `user${i}@example.com`, ...overrides(i) }));
+
+describe('POST /tickets/import', () => {
+  test('creates the tickets in order and answers 201 with the count and ids', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody({ title: 'Existing' }));
+      const items = [ticketBody({ title: 'First', priority: 'urgent' }), ticketBody({ title: 'Second' }), ticketBody({ title: 'Third' })];
+      const { status, body } = await api.post('/tickets/import', { tickets: items });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 3, ids: ['T-0002', 'T-0003', 'T-0004'] });
+      const listed = (await api.get('/tickets?limit=10')).body.items;
+      assert.deepEqual(listed.map((t) => t.title), ['Existing', 'First', 'Second', 'Third']);
+      assert.equal(listed[1].priority, 'urgent');
+      assert.equal(listed[2].priority, 'normal');
+      assert.equal(listed[2].status, 'open');
+    });
+  });
+
+  test('records each ticket in the audit log with the actor, and queues its notification', async () => {
+    await withService({}, async (api) => {
+      const items = [ticketBody({ requester: 'a@example.com' }), ticketBody({ requester: 'b@example.com' })];
+      await api.post('/tickets/import', { tickets: items }, { 'x-actor': 'migration' });
+      const audit = (await api.get('/tickets/T-0002/audit')).body.items;
+      assert.equal(audit.length, 1);
+      assert.equal(audit[0].action, 'ticket.created');
+      assert.equal(audit[0].actor, 'migration');
+      assert.equal(audit[0].changes.requester.to, 'b@example.com');
+      const { pending } = (await api.get('/admin/outbox')).body;
+      assert.deepEqual(pending.map((e) => [e.type, e.to, e.ticket]), [
+        ['ticket.created', 'a@example.com', 'T-0001'],
+        ['ticket.created', 'b@example.com', 'T-0002'],
+      ]);
+    });
+  });
+
+  test('the worker notifies the requesters of imported tickets', async () => {
+    await withService({}, async (api, service) => {
+      await api.post('/tickets/import', { tickets: many(3) });
+      const { deliverOutbox } = require('../src/worker');
+      const { silentLogger } = require('../src/log');
+      await deliverOutbox({ store: service.store, notifier: service.notifier, log: silentLogger }).run();
+      assert.equal((await api.get('/admin/outbox')).body.sent.length, 3);
+    });
+  });
+
+  test('an invalid item refuses the whole import and names the first bad item by index', async () => {
+    await withService({}, async (api) => {
+      const items = many(5);
+      items[3] = ticketBody({ title: '' });
+      items[4] = { nonsense: true };
+      const { status, body } = await api.post('/tickets/import', { tickets: items });
+      assert.equal(status, 400);
+      assert.equal(body.error.code, 'invalid');
+      assert.match(body.error.message, /tickets\[3\]/);
+      assert.match(body.error.message, /title/);
+      assert.equal((await api.get('/tickets')).body.items.length, 0);
+      assert.equal((await api.get('/admin/outbox')).body.pending.length, 0);
+      // the numbers were not used up
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0001');
+    });
+  });
+
+  test('the first item is index 0; an item that is not an object is invalid', async () => {
+    await withService({}, async (api) => {
+      const first = await api.post('/tickets/import', { tickets: [ticketBody({ priority: 'asap' }), ticketBody()] });
+      assert.equal(first.status, 400);
+      assert.match(first.body.error.message, /tickets\[0\]/);
+      const other = await api.post('/tickets/import', { tickets: [ticketBody(), 'text'] });
+      assert.equal(other.status, 400);
+      assert.match(other.body.error.message, /tickets\[1\]/);
+      const unknown = await api.post('/tickets/import', { tickets: [ticketBody(), ticketBody(), ticketBody({ owner: 'x' })] });
+      assert.match(unknown.body.error.message, /tickets\[2\].*owner/);
+    });
+  });
+
+  test('refuses a body that is not { tickets: [...] }', async () => {
+    await withService({}, async (api) => {
+      for (const body of [{}, { tickets: 'x' }, { tickets: {} }, { tickets: [], extra: 1 }, []]) {
+        const response = await api.post('/tickets/import', body);
+        assert.equal(response.status, 400, JSON.stringify(body));
+        assert.equal(response.body.error.code, 'invalid');
+      }
+    });
+  });
+
+  test('refuses more than 5000 tickets and accepts exactly 5000', async () => {
+    assert.equal(IMPORT_MAX, 5000);
+    await withService({}, async (api) => {
+      const tooMany = await api.post('/tickets/import', { tickets: many(5001) });
+      assert.equal(tooMany.status, 400);
+      assert.equal((await api.get('/tickets')).body.items.length, 0);
+    });
+  });
+
+  test('an empty import creates nothing', async () => {
+    await withService({}, async (api) => {
+      const { status, body } = await api.post('/tickets/import', { tickets: [] });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 0, ids: [] });
+    });
+  });
+
+  test('5000 tickets (a body far over MAX_BODY_BYTES) are imported within 10 seconds', async () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'import-'));
+    try {
+      await withService({ dataFile: path.join(dir, 'tickets.json') }, async (api, service) => {
+        const items = many(5000, (i) => ({ title: `Old tracker ticket ${i} ${'x'.repeat(60)}` }));
+        assert.ok(Buffer.byteLength(JSON.stringify({ tickets: items })) > 64 * 1024);
+        const started = Date.now();
+        const { status, body } = await api.post('/tickets/import', { tickets: items });
+        assert.ok(Date.now() - started < 10000, `took ${Date.now() - started} ms`);
+        assert.equal(status, 201, JSON.stringify(body).slice(0, 200));
+        assert.equal(body.created, 5000);
+        assert.equal(body.ids[0], 'T-0001');
+        assert.equal(body.ids[4999], 'T-5000');
+        assert.equal(service.store.outbox.events.length, 5000);
+        assert.equal(service.store.audit.size, 5000);
+      });
+      const saved = JSON.parse(fs.readFileSync(path.join(dir, 'tickets.json'), 'utf8'));
+      assert.equal(saved.tickets.length, 5000);
+    } finally {
+      fs.rmSync(dir, { recursive: true, force: true });
+    }
+  });
+
+  test('the ordinary body limit still applies to POST /tickets', async () => {
+    await withService({}, async (api) => {
+      const response = await api.post('/tickets', { ...ticketBody(), pad: 'x'.repeat(70000) });
+      assert.equal(response.status, 400);
+    });
+  });
+
+  test('/tickets/import is not taken for a ticket id', async () => {
+    await withService({}, async (api) => {
+      assert.equal((await api.get('/tickets/import')).status, 404);
+    });
+  });
+});
+
+describe('ticketImport', () => {
+  test('returns the checked tickets with their defaults', () => {
+    assert.deepEqual(ticketImport({ tickets: [{ title: ' A ', requester: 'r' }] }), [{ title: 'A', requester: 'r', priority: 'normal' }]);
+  });
+});
+
+describe('TicketStore.createTickets', () => {
+  test('saves once for the whole import', () => {
+    let saves = 0;
+    const store = new TicketStore({ clock: manualClock(), persistence: { save: () => { saves += 1; } } });
+    const created = store.createTickets(many(10).map(({ title, requester, priority }) => ({ title, requester, priority })), 'me');
+    assert.equal(created.length, 10);
+    assert.equal(saves, 1);
+  });
+
+  test('puts the store back when saving fails', () => {
+    const store = new TicketStore({ clock: manualClock(), persistence: { save: () => { throw new Error('disk full'); } } });
+    assert.throws(() => store.createTickets([{ title: 'a', requester: 'r', priority: 'low' }, { title: 'b', requester: 'r', priority: 'low' }], 'me'), /disk full/);
+    assert.equal(store.tickets.size, 0);
+    assert.equal(store.audit.size, 0);
+    assert.equal(store.outbox.events.length, 0);
+    assert.equal(store.nextNumber, 1);
+    assert.equal(store.outbox.nextId, 1);
+  });
+
+  test('an import survives a restart through the data file', () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'import-'));
+    try {
+      const persistence = createPersistence(path.join(dir, 'd.json'));
+      const store = TicketStore.open({ clock: manualClock(), persistence });
+      store.createTickets([{ title: 'a', requester: 'r', priority: 'low' }], 'me');
+      const reopened = TicketStore.open({ clock: manualClock(), persistence });
+      assert.equal(reopened.get('T-0001').title, 'a');
+      assert.equal(reopened.outboxReport().pending.length, 1);
+    } finally {
+      fs.rmSync(dir, { recursive: true, force: true });
+    }
+  });
+});
