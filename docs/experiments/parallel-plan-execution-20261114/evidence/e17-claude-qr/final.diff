+    clock.advance(HOUR);
+    const second = TicketStore.open({
+      clock, persistence: createPersistence(file, { clock }), dueTimes: true, responseHours: { normal: 1 },
+    });
+    assert.equal(second.get(id).due, due);
+    assert.equal(second.createTicket(input('normal'), 'dana').due, plus(plus(START, 1), 1), 'a new ticket uses the new hours');
+    assert.equal(second.get(id).due, due);
+  });
+
+  test('imported tickets get one each', () => {
+    const store = new TicketStore({ clock: manualClock(START), dueTimes: true });
+    const created = store.createTickets([input('urgent'), input('low')], 'import');
+    assert.deepEqual(created.map((ticket) => ticket.due), [plus(START, 4), plus(START, 168)]);
+  });
+});
+
+describe('overdue tickets', () => {
