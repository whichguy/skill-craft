diff --git a/test/import.test.js b/test/import.test.js
new file mode 100644
index 0000000..3cd4790
--- /dev/null
+++ b/test/import.test.js
@@ -0,0 +1,112 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { performance } = require('node:perf_hooks');
+const { TicketStore } = require('../src/store');
+const { manualClock } = require('../src/clock');
+const { ticketBody, withService } = require('./helpers');
+
+test('import creates ordered tickets with ordinary defaults, audit entries and delivered notifications', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const response = await api.post('/tickets/import', { tickets: [
+      { title: ' First ', requester: ' alice ' }, ticketBody({ title: 'Second', priority: 'urgent' }),
+    ] }, { 'X-Actor': 'migration' });
+    assert.equal(response.status, 201);
+    assert.deepEqual(response.body, { created: 2, ids: ['T-0002', 'T-0003'] });
+    assert.equal(service.store.get('T-0002').title, 'First');
+    assert.equal(service.store.get('T-0002').priority, 'normal');
+    assert.equal(service.store.get('T-0003').priority, 'urgent');
+    for (const id of response.body.ids) {
+      const [entry] = service.store.history(id);
+      assert.equal(entry.action, 'ticket.created');
+      assert.equal(entry.actor, 'migration');
+      assert.deepEqual(entry.changes.status, { from: null, to: 'open' });
+    }
+    assert.deepEqual(service.store.outboxReport().pending.map((event) => event.to), [
+      'maria@example.com', 'alice', 'maria@example.com',
+    ]);
+    assert.equal(service.worker.tick()[0].sent, 3);
+    assert.equal(service.store.outboxReport().sent.length, 3);
+  });
+});
+
+test('invalid items name the first invalid index and leave every part of the state unchanged', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const before = service.store.snapshot();
+    for (const invalid of [null, [], 42, 'bad', {}, ticketBody({ title: '' }),
+      ticketBody({ requester: 'a\nb' }), ticketBody({ priority: 'critical' }), ticketBody({ owner: 'sam' })]) {
+      const result = await api.post('/tickets/import', { tickets: [ticketBody(), invalid, null] });
+      assert.equal(result.status, 400);
+      assert.equal(result.body.error.code, 'invalid');
+      assert.match(result.body.error.message, /tickets\[1\]/);
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+    const first = await api.post('/tickets/import', { tickets: [null, null] });
+    assert.match(first.body.error.message, /tickets\[0\]/);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+  });
+});
+
+test('import rejects malformed envelopes, oversized batches and invalid actors without creating tickets', async () => {
+  await withService({}, async (api, service) => {
+    for (const body of [{}, { tickets: null }, { tickets: {} }, { tickets: [], extra: true },
+      { tickets: Array(5001).fill(ticketBody()) }, '{"tickets":', []]) {
+      assert.equal((await api.post('/tickets/import', body)).status, 400);
+    }
+    assert.equal((await api.post('/tickets/import', { tickets: [ticketBody()] }, { 'X-Actor': 'x'.repeat(65) })).status, 400);
+    assert.equal(service.store.snapshot().tickets.length, 0);
+  });
+});
+
+test('an empty import succeeds without changes', async () => {
+  await withService({}, async (api, service) => {
+    const before = service.store.snapshot();
+    const result = await api.post('/tickets/import', { tickets: [] });
+    assert.equal(result.status, 201);
+    assert.deepEqual(result.body, { created: 0, ids: [] });
+    assert.deepEqual(service.store.snapshot(), before);
+  });
+});
+
+test('a persistent 5000-ticket import responds within ten seconds and survives reload', async () => {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-import-'));
+  const dataFile = path.join(directory, 'tickets.json');
+  try {
+    await withService({ dataFile }, async (api, service) => {
+      const tickets = Array.from({ length: 5000 }, (_, index) => ticketBody({ title: `Legacy ticket ${index}` }));
+      const started = performance.now();
+      const result = await api.post('/tickets/import', { tickets });
+      assert.equal(result.status, 201);
+      assert.ok(performance.now() - started < 10000);
+      assert.equal(result.body.created, 5000);
+      assert.deepEqual(result.body.ids, Array.from({ length: 5000 }, (_, index) => `T-${String(index + 1).padStart(4, '0')}`));
+      const loaded = TicketStore.open({ clock: manualClock(), persistence: service.store.persistence });
+      assert.deepEqual(loaded.snapshot(), service.store.snapshot());
+      assert.equal(loaded.history('T-5000')[0].actor, 'system');
+      assert.equal(loaded.outboxReport().pending.length, 5000);
+    });
+  } finally {
+    fs.rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+test('batch persistence happens once and a save failure leaves live state unchanged', () => {
+  let saves = 0;
+  let fail = false;
+  const store = new TicketStore({ clock: manualClock(), persistence: { save() {
+    saves += 1;
+    if (fail) throw new Error('disk full');
+  } } });
+  store.importTickets([ticketBody(), ticketBody()], 'migration');
+  assert.equal(saves, 1);
+  const before = store.snapshot();
+  fail = true;
+  assert.throws(() => store.importTickets([ticketBody()], 'migration'), /disk full/);
+  assert.deepEqual(store.snapshot(), before);
+});
