+  /** Create a validated batch in isolation, persist once, then publish its complete state. */
+  importTickets(inputs, actor) {
+    if (inputs.length === 0) return [];
+    const staged = new TicketStore({ clock: this.clock, state: this.snapshot() });
+    const ids = inputs.map((input) => staged.create(input, actor).id);
+    if (this.persistence) this.persistence.save(staged.snapshot());
+    this.nextNumber = staged.nextNumber;
+    this.tickets = staged.tickets;
+    this.audit = staged.audit;
+    this.outbox = staged.outbox;
+    return ids;
+  }
