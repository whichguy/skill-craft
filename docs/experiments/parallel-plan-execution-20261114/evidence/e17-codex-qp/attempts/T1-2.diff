@@ -0,0 +1,121 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { ticketBody, withService } = require('./helpers');
+const { manualClock } = require('../src/clock');
+const { TicketStore } = require('../src/store');
+const { toDocument, fromDocument } = require('../src/persistence');
+const { main } = require('../bin/tickets');
+
+const route = '/tickets/T-0001/assignee';
+
+test('assignment is audited, delivered to each new assignee, and idempotent', async () => {
+  await withService({}, async (api, service) => {
+    assert.equal((await api.post('/tickets', ticketBody())).body.assignee, null);
+    const assigned = await api.put(route, { assignee: 'Dana' }, { 'X-Actor': 'Sam' });
+    assert.equal(assigned.status, 200);
+    assert.equal(assigned.body.assignee, 'Dana');
+    const before = service.store.snapshot();
+    assert.deepEqual((await api.put(route, { assignee: 'Dana' })).body, assigned.body);
+    assert.deepEqual(service.store.snapshot(), before);
+    await api.put(route, { assignee: 'Li' });
+    await api.put(route, { assignee: 'Dana' });
+    const history = (await api.get('/tickets/T-0001/audit')).body.items;
+    assert.equal(history[1].actor, 'Sam');
+    assert.deepEqual(history[1].changes, { assignee: { from: null, to: 'Dana' } });
+    const events = service.store.outboxReport().pending.filter(e => e.type === 'ticket.assigned');
+    assert.deepEqual(events.map(e => e.to), ['Dana', 'Li', 'Dana']);
+    for (const event of events) service.notifier.deliver(event);
+    assert.ok(service.notifier.delivered.every(e => /assigned to you/i.test(e.body)));
+    assert.equal((await api.put(route, { assignee: null })).body.assignee, null);
+    assert.equal(service.store.outboxReport().pending.length, 4);
+    assert.equal((await api.get('/tickets/T-0001')).body.assignee, null);
+  });
+});
+
+test('assignment validates names, JSON and unknown fields and reports missing tickets', async () => {
+  await withService({}, async api => {
+    await api.post('/tickets', ticketBody());
+    for (const body of [{}, { assignee: '' }, { assignee: ' ' }, { assignee: 4 }, { assignee: false },
+      { assignee: [] }, { assignee: 'x'.repeat(65) }, { assignee: 'a\nb' }, { assignee: 'a', other: 1 }, [], null, '{']) {
+      const response = await api.put(route, body);
+      assert.equal(response.status, 400, JSON.stringify(body));
+      assert.equal(response.body.error.code, 'invalid');
+    }
+    assert.equal((await api.put(route, { assignee: 'a'.repeat(64) })).status, 200);
+    assert.equal((await api.put('/tickets/T-9999/assignee', { assignee: 'Dana' })).status, 404);
+  });
+});
+
+test('only open and in-progress tickets allow assignment and unassignment', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+    assert.equal((await api.put(route, { assignee: 'Dana' })).status, 200);
+    assert.equal((await api.put(route, { assignee: null })).status, 200);
+    await api.put(route, { assignee: 'Dana' });
+    for (const to of ['resolved', 'closed']) {
+      await api.post('/tickets/T-0001/transition', { to });
+      const before = service.store.snapshot();
+      for (const assignee of ['Dana', 'Li', null]) {
+        assert.equal((await api.put(route, { assignee })).status, 409);
+      }
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+  });
+});
+
+test('assignee filters combine with all filters and paginate matching tickets', async () => {
+  await withService({}, async api => {
+    for (const priority of ['high', 'low', 'high', 'high']) await api.post('/tickets', ticketBody({ priority }));
+    for (const id of ['T-0001', 'T-0002', 'T-0003']) await api.put(`/tickets/${id}/assignee`, { assignee: 'Dana' });
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    const first = await api.get('/tickets?assignee=Dana&status=open&priority=high&limit=1');
+    assert.deepEqual(first.body.items.map(t => t.id), ['T-0001']);
+    const next = await api.get(`/tickets?assignee=Dana&status=open&priority=high&limit=1&cursor=${first.body.next}`);
+    assert.deepEqual(next.body.items.map(t => t.id), ['T-0003']);
+    assert.equal(next.body.next, null);
+    assert.deepEqual((await api.get('/tickets?assignee=')).body.items.map(t => t.id), ['T-0004']);
+    assert.deepEqual((await api.get('/tickets?assignee=Nobody')).body.items, []);
+    assert.deepEqual((await api.get('/tickets?status=open&priority=low')).body.items, []);
+    assert.equal((await api.get('/tickets?assignee=' + 'x'.repeat(65))).status, 400);
+  });
+});
+
+test('assignment persists across restart and CLI keeps existing raw columns', async t => {
+  const dir = fs.mkdtempSync(path.join(__dirname, 'assignment-data-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const file = path.join(dir, 'tickets.json');
+  await withService({ dataFile: file }, async api => {
+    await api.post('/tickets', ticketBody());
+    await api.put(route, { assignee: 'Dana' });
+  });
+  await withService({ dataFile: file }, async api => assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'Dana'));
+  for (const raw of [false, true]) {
+    let output = '';
+    const result = main(['--data', file, 'list', ...(raw ? ['--raw'] : [])], {
+      env: {}, out: { write: text => { output += text; } }, err: { write: assert.fail },
+    });
+    assert.equal(result, 0);
+    assert.match(output, /Dana/);
+    if (raw) assert.deepEqual(output.trim().split('\t'), ['T-0001', 'open', 'normal', ticketBody().title, 'Dana']);
+  }
+});
+
+test('legacy data defaults to unassigned and invalid saved assignees are refused', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock });
+  store.createTicket(ticketBody(), 'system');
+  const document = toDocument(store.snapshot(), clock.now());
+  delete document.tickets[0].assignee;
+  const fail = message => new Error(message);
+  assert.equal(fromDocument(document, fail).tickets[0].assignee, null);
+  assert.equal(new TicketStore({ clock, state: { ...store.snapshot(), tickets: document.tickets } }).get('T-0001').assignee, null);
+  for (const assignee of ['', ' ', 3, 'x'.repeat(65), 'x\ny']) {
+    document.tickets[0].assignee = assignee;
+    assert.throws(() => fromDocument(document, fail), /assignee/);
+  }
+});
