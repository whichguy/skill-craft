+  clock.advance(60_000);
+  return { clock, tickets };
+}
+
+describe('TicketStore.assign', () => {
+  test('a new ticket is unassigned', () => {
+    const { tickets } = store();
+    assert.equal(tickets.get('T-0001').assignee, null);
+  });
+
+  test('assigns an open ticket, audits it and moves updated', () => {
+    const { tickets } = store();
+    const ticket = tickets.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.assignee, 'sam');
+    assert.equal(ticket.updated, '2025-09-01T08:01:00.000Z');
+    const last = tickets.history('T-0001').at(-1);
+    assert.equal(last.action, 'ticket.assigned');
+    assert.equal(last.actor, 'dana');
+    assert.deepEqual(last.changes, { assignee: { from: null, to: 'sam' } });
+  });
+
+  test('assigns an in-progress ticket, and reassigning records the previous agent', () => {
+    const { tickets } = store();
+    tickets.transition('T-0001', 'in_progress', 'dana');
+    tickets.assign('T-0001', 'sam', 'dana');
+    tickets.assign('T-0001', 'li', 'dana');
+    assert.deepEqual(tickets.history('T-0001').at(-1).changes, { assignee: { from: 'sam', to: 'li' } });
+  });
+
+  test('unassigns with null', () => {
+    const { tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    assert.equal(tickets.assign('T-0001', null, 'dana').assignee, null);
+    assert.deepEqual(tickets.history('T-0001').at(-1).changes, { assignee: { from: 'sam', to: null } });
+  });
+
+  test('assigning the agent a ticket already has changes nothing', () => {
+    const { clock, tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    const entries = tickets.history('T-0001').length;
+    const events = tickets.outboxReport().pending.length;
+    clock.advance(60_000);
+    const ticket = tickets.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.updated, '2025-09-01T08:01:00.000Z');
+    assert.equal(tickets.history('T-0001').length, entries);
+    assert.equal(tickets.outboxReport().pending.length, events);
+  });
+
+  test('unassigning an unassigned ticket changes nothing', () => {
+    const { tickets } = store();
+    const entries = tickets.history('T-0001').length;
+    assert.equal(tickets.assign('T-0001', null, 'dana').updated, '2025-09-01T08:00:00.000Z');
+    assert.equal(tickets.history('T-0001').length, entries);
+  });
+
