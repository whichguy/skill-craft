+describe('the data file', () => {
+  const folder = (t) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    return dir;
+  };
+
+  test('keeps assignees across a restart', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const first = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    first.create(input(), 'dana');
+    first.create(input(), 'dana');
+    first.assign('T-0001', 'sam', 'dana');
+    const again = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(again.get('T-0001').assignee, 'sam');
+    assert.equal(again.get('T-0002').assignee, null);
+  });
+
+  test('loads a file from before assignment: its tickets are unassigned', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.create(input(), 'dana');
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    for (const ticket of document.tickets) delete ticket.assignee;
+    fs.writeFileSync(file, JSON.stringify(document));
+    const reopened = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(reopened.get('T-0001').assignee, null);
+    assert.equal(reopened.assign('T-0001', 'sam', 'dana').assignee, 'sam');
+  });
+
+  test('refuses a file whose assignee is not a name or null', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.create(input(), 'dana');
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    document.tickets[0].assignee = '';
+    fs.writeFileSync(file, JSON.stringify(document));
+    assert.throws(() => createPersistence(file).load(), /assignee/);
+  });
+});
