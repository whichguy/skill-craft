+describe('GET /tickets?assignee=', () => {
+  async function seed(api) {
+    for (let n = 0; n < 4; n += 1) await api.post('/tickets', ticketBody({ priority: n % 2 ? 'urgent' : 'low' }));
+    await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+    await api.put('/tickets/T-0002/assignee', { assignee: 'sam' });
+    await api.put('/tickets/T-0003/assignee', { assignee: 'li' });
+  }
+  const ids = (response) => response.body.items.map((ticket) => ticket.id);
+
+  test('keeps one agent\'s tickets, and an empty value keeps the unassigned ones', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=sam')), ['T-0001', 'T-0002']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=li')), ['T-0003']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=')), ['T-0004']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=nobody')), []);
+      assert.equal((await api.get('/tickets')).body.items.length, 4);
+    });
+  });
+
+  test('a ticket must match every filter given', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=sam&priority=urgent')), ['T-0002']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=sam&priority=low&status=open')), ['T-0001']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=&priority=urgent')), ['T-0004']);
+      assert.deepEqual(ids(await api.get('/tickets?status=open&priority=low')), ['T-0001', 'T-0003']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=li&status=in_progress')), []);
+    });
+  });
+
+  test('pages through a filtered listing', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      const first = await api.get('/tickets?assignee=sam&limit=1');
+      assert.deepEqual(ids(first), ['T-0001']);
+      const second = await api.get(`/tickets?assignee=sam&limit=1&cursor=${first.body.next}`);
+      assert.deepEqual(ids(second), ['T-0002']);
+      assert.equal(second.body.next, null);
+    });
+  });
+});
+
+describe('the listing query', () => {
+  test('reads the assignee filter, empty included', () => {
+    assert.deepEqual(parseListQuery(new URLSearchParams('assignee=sam')).filters, { assignee: 'sam' });
+    assert.deepEqual(parseListQuery(new URLSearchParams('assignee=')).filters, { assignee: '' });
+  });
+
+  test('matchesFilters requires every filter', () => {
+    const ticket = { id: 'T-0001', status: 'open', priority: 'high', assignee: null };
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'low' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'high' }), true);
+    assert.equal(matchesFilters(ticket, { assignee: '' }), true);
+    assert.equal(matchesFilters(ticket, { assignee: 'sam' }), false);
+    assert.equal(matchesFilters({ ...ticket, assignee: 'sam' }, { assignee: '' }), false);
+    assert.equal(matchesFilters({ ...ticket, assignee: 'sam' }, { assignee: 'sam', priority: undefined }), true);
+  });
+});
