+      assert.equal((await api.get('/tickets')).body.items[0].assignee, 'sam');
+      const audit = (await api.get('/tickets/T-0001/audit')).body.items.at(-1);
+      assert.equal(audit.action, 'ticket.assigned');
+      assert.equal(audit.actor, 'dana');
+      const cleared = await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.equal(cleared.status, 200);
+      assert.equal(cleared.body.assignee, null);
+    });
+  });
+
+  test('answers 400 invalid for a bad body, 404 for no ticket, 409 for a resolved ticket', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      for (const body of [{}, { assignee: '' }, { assignee: 'x'.repeat(65) }, { assignee: 3 }, { agent: 'sam' }, []]) {
+        const response = await api.put('/tickets/T-0001/assignee', body);
+        assert.equal(response.status, 400, JSON.stringify(body));
+        assert.equal(response.body.error.code, 'invalid');
+      }
+      assert.equal((await api.put('/tickets/T-0042/assignee', { assignee: 'sam' })).status, 404);
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'sam' })).status, 200);
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+      const refused = await api.put('/tickets/T-0001/assignee', { assignee: 'li' });
+      assert.equal(refused.status, 409);
+      assert.equal(refused.body.error.code, 'conflict');
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: null })).status, 409);
+    });
+  });
+
+  test('the agent is notified once, and the notification is delivered', async () => {
+    await withService({}, async (api, service) => {
+      await api.post('/tickets', ticketBody());
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      const pending = (await api.get('/admin/outbox')).body.pending.filter((e) => e.type === 'ticket.assigned');
+      assert.equal(pending.length, 1);
+      assert.equal(pending[0].to, 'sam');
+      assert.equal(service.notifier.delivered.length, 0, 'a request never delivers a notification itself');
+    });
+  });
+
+  test('does not answer other methods', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      assert.equal((await api.post('/tickets/T-0001/assignee', { assignee: 'sam' })).status, 404);
+    });
+  });
+
+  test('PATCH still refuses an assignee', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      assert.equal((await api.patch('/tickets/T-0001', { assignee: 'sam' })).status, 400);
