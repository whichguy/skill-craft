+/** The most tickets one POST /tickets/import takes. */
+const IMPORT_MAX = 5000;
+
+/**
+ * POST /tickets/import: { tickets: [ <what POST /tickets takes>, ... ] }, at most IMPORT_MAX. Returns the checked
+ * inputs, in order. The first invalid item is the error, and its message names the item by its index in the array.
+ */
+function ticketImport(body) {
+  onlyFields(body, ['tickets']);
+  if (!Array.isArray(body.tickets)) throw new InvalidError('tickets must be a list');
+  if (body.tickets.length > IMPORT_MAX) throw new InvalidError(`tickets must hold at most ${IMPORT_MAX} tickets`);
+  return body.tickets.map((item, index) => {
+    try {
+      if (item === null || typeof item !== 'object' || Array.isArray(item)) throw new InvalidError('must be a JSON object');
+      return newTicket(item);
+    } catch (error) {
+      if (error instanceof InvalidError) throw new InvalidError(`tickets[${index}]: ${error.message}`);
+      throw error;
+    }
+  });
+}
+
 /** PATCH /tickets/:id: { title?, priority? }, at least one of them. */
