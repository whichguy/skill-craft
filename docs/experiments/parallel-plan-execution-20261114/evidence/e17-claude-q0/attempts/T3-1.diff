diff --git a/src/tickets/due.js b/src/tickets/due.js
new file mode 100644
index 0000000..8fc6218
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,28 @@
+'use strict';
+
+const { PRIORITIES } = require('./priorities');
+
+/**
+ * Due times (docs/decisions/0009-due-times.md): each ticket is due its creation time plus the response time of its
+ * priority, set once when the ticket is created (or, for a ticket that predates due times, when the data file is first
+ * opened by a release that knows them) and never moved again.
+ */
+
+/** The response time, in hours, of each priority. The settings DUE_HOURS_<PRIORITY> change them (README.md). */
+const DEFAULT_RESPONSE_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+const HOUR_MS = 60 * 60 * 1000;
+
+/** The due time (ISO 8601) of a ticket of `priority` created at `created` (ISO 8601). */
+function dueTime(created, priority, hours = DEFAULT_RESPONSE_HOURS) {
+  if (!PRIORITIES.includes(priority)) throw new RangeError(`${priority} is not a priority`);
+  return new Date(Date.parse(created) + hours[priority] * HOUR_MS).toISOString();
+}
+
+/** Whether `ticket` is open or in progress and its due time is before `now` (a Date). */
+function isOverdue(ticket, now) {
+  if (ticket.status !== 'open' && ticket.status !== 'in_progress') return false;
+  return Date.parse(ticket.due) < now.getTime();
+}
+
+module.exports = { DEFAULT_RESPONSE_HOURS, dueTime, isOverdue };
