+      { title: 'VPN drops', requester: 'maria@example.com', priority: 'low' }, 'dana');
+    const before = fs.statSync(file).mtimeMs;
+    const text = fs.readFileSync(file, 'utf8');
+    fs.utimesSync(file, new Date(before - 5000), new Date(before - 5000));
+    clock.advance(HOUR);
+    TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(fs.readFileSync(file, 'utf8'), text);
