+    assert.equal(isOverdue(ticket('open'), at(plus(START, 4))), false);
+  });
+
+  test('is false for a resolved or closed ticket however late', () => {
+    assert.equal(isOverdue(ticket('resolved'), at(plus(START, 500))), false);
+    assert.equal(isOverdue(ticket('closed'), at(plus(START, 500))), false);
