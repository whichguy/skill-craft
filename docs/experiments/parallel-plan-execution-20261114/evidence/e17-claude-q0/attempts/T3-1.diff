+describe('the store', () => {
+  const create = (store, priority) => store.create({ title: `A ${priority} ticket`, requester: 'li@example.com', priority }, 'dana');
+
+  test('gives a new ticket its due time from its creation time and priority', () => {
+    const store = new TicketStore({ clock: manualClock(START) });
+    for (const [priority, hours] of [['urgent', 4], ['high', 24], ['normal', 72], ['low', 168]]) {
+      const ticket = create(store, priority);
+      assert.equal(ticket.created, START);
+      assert.equal(ticket.due, plus(START, hours), priority);
+      assert.equal(store.get(ticket.id).due, ticket.due);
+    }
+  });
+
+  test('sets the due time once: a change of priority or any later time leaves it', () => {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock });
+    const { id, due } = create(store, 'normal');
+    clock.advance(10 * HOUR);
+    assert.equal(store.update(id, { priority: 'urgent' }, 'dana').due, due);
+    assert.equal(store.update(id, { title: 'Another title' }, 'dana').due, due);
+    assert.equal(store.transition(id, 'in_progress', 'sam').due, due);
+    assert.equal(store.transition(id, 'resolved', 'sam').due, due);
+    assert.equal(store.transition(id, 'open', 'li@example.com').due, due);
+  });
+
+  test('a change of the hours moves no due time that is already set, but applies to new tickets', () => {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock });
+    const first = create(store, 'high');
+    store.responseHours = { ...DEFAULT_RESPONSE_HOURS, high: 2 };
+    assert.equal(store.get(first.id).due, plus(START, 24));
+    assert.equal(create(store, 'high').due, plus(START, 2));
+  });
+
+  test('uses the hours it is given', () => {
+    const store = new TicketStore({ clock: manualClock(START), responseHours: { urgent: 1, high: 2, normal: 3, low: 4 } });
+    assert.equal(create(store, 'urgent').due, plus(START, 1));
+    assert.equal(create(store, 'low').due, plus(START, 4));
+  });
+
+  test('records no audit entry for the due time', () => {
+    const store = new TicketStore({ clock: manualClock(START) });
+    const { id } = create(store, 'urgent');
+    assert.deepEqual(Object.keys(store.history(id)[0].changes), ['title', 'priority', 'requester', 'status']);
+  });
+
+  test('lists the overdue tickets: open or in progress, due before now', () => {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock });
+    const urgent = create(store, 'urgent');
+    const high = create(store, 'high');
+    const progress = create(store, 'urgent');
+    const resolved = create(store, 'urgent');
+    const normal = create(store, 'normal');
+    store.transition(progress.id, 'in_progress', 'sam');
+    store.transition(resolved.id, 'in_progress', 'sam');
+    store.transition(resolved.id, 'resolved', 'sam');
+    const overdue = () => store.list({ overdue: true }).items.map((ticket) => ticket.id);
+    assert.deepEqual(overdue(), []);
+    clock.advance(4 * HOUR);
+    assert.deepEqual(overdue(), [], 'at the due time it has not yet passed');
+    clock.advance(HOUR);
+    assert.deepEqual(overdue(), [urgent.id, progress.id]);
+    clock.advance(20 * HOUR);
+    assert.deepEqual(overdue(), [urgent.id, high.id, progress.id]);
+    clock.advance(48 * HOUR);
+    assert.deepEqual(overdue(), [urgent.id, high.id, progress.id, normal.id]);
+    assert.equal(store.list().items.length, 5, 'without overdue every ticket is listed');
+  });
+
+  test('pages the overdue tickets with a cursor', () => {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock });
+    for (let n = 0; n < 5; n += 1) create(store, 'urgent');
+    clock.advance(5 * HOUR);
+    const first = store.list({ overdue: true, limit: 2 });
+    assert.deepEqual(first.items.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+    const second = store.list({ overdue: true, limit: 2, after: first.next ? first.items[1].id : null });
+    assert.deepEqual(second.items.map((ticket) => ticket.id), ['T-0003', 'T-0004']);
+  });
+});
