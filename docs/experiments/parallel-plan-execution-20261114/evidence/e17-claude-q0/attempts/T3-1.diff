+  });
+
+  test('the hours come from the settings', async () => {
+    const responseHours = { urgent: 1, high: 2, normal: 3, low: 4 };
+    await withService({ ...on, responseHours, clock: manualClock(START) }, async (api) => {
+      assert.equal((await api.post('/tickets', ticketBody({ priority: 'high' }))).body.due, plus(START, 2));
+      assert.equal((await api.post('/tickets', ticketBody({ priority: 'low' }))).body.due, plus(START, 4));
+    });
