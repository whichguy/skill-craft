+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(store.list().items.every((ticket) => typeof ticket.due === 'string'), true);
+    assert.equal(store.get('T-0001').due, '2025-08-01T14:00:00.000Z');
+  });
+});
+
+describe('the command line', () => {
+  test('lists and shows the tickets of a file with due times as before', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    const clock = manualClock(START);
+    TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    const run = (argv) => {
+      let out = '';
+      const code = main(['--data', file, ...argv], { env: {}, out: { write: (s) => { out += s; } }, err: { write: () => {} } });
+      return { code, out };
+    };
+    const raw = run(['list', '--raw']);
+    assert.equal(raw.code, 0);
+    assert.deepEqual(raw.out.replace(/\n$/, '').split('\n').map((line) => line.split('\t')), [
+      ['T-0001', 'open', 'urgent', 'Ticket 1', ''],
+      ['T-0002', 'in_progress', 'high', 'Ticket 2', ''],
+      ['T-0003', 'closed', 'normal', 'Ticket 3', ''],
+      ['T-0004', 'resolved', 'low', 'Ticket 4', ''],
+    ]);
+    assert.equal(run(['show', 'T-0002']).code, 0);
+  });
+
+  test('does not write the file', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    const text = fs.readFileSync(file, 'utf8');
+    main(['--data', file, 'list'], { env: {}, out: { write: () => {} }, err: { write: () => {} } });
+    assert.equal(fs.readFileSync(file, 'utf8'), text);
+  });
+});
+
+describe('the API with due times on', () => {
+  const on = { dueTimes: true };
+
+  test('every ticket shows its due time as due', async () => {
+    await withService({ ...on, clock: manualClock(START) }, async (api) => {
+      const created = await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      assert.equal(created.status, 201);
+      assert.equal(created.body.due, plus(START, 4));
+      assert.equal((await api.get(`/tickets/${created.body.id}`)).body.due, plus(START, 4));
+      assert.equal((await api.get('/tickets')).body.items[0].due, plus(START, 4));
+      const normal = await api.post('/tickets', ticketBody());
+      assert.equal(normal.body.due, plus(START, 72));
+    });
+  });
+
+  test('the hours come from the settings', async () => {
+    const responseHours = { urgent: 1, high: 2, normal: 3, low: 4 };
+    await withService({ ...on, responseHours, clock: manualClock(START) }, async (api) => {
+      assert.equal((await api.post('/tickets', ticketBody({ priority: 'high' }))).body.due, plus(START, 2));
+      assert.equal((await api.post('/tickets', ticketBody({ priority: 'low' }))).body.due, plus(START, 4));
+    });
+  });
+
+  test('a change of priority, a transition and the passing of time do not move the due time', async () => {
+    const clock = manualClock(START);
+    await withService({ ...on, clock }, async (api) => {
+      const { body } = await api.post('/tickets', ticketBody({ priority: 'low' }));
+      clock.advance(30 * HOUR);
+      assert.equal((await api.patch(`/tickets/${body.id}`, { priority: 'urgent' })).body.due, plus(START, 168));
+      assert.equal((await api.post(`/tickets/${body.id}/transition`, { to: 'in_progress' })).body.due, plus(START, 168));
+    });
+  });
+
+  test('a request cannot set the due time', async () => {
+    await withService(on, async (api) => {
+      assert.equal((await api.post('/tickets', ticketBody({ due: '2030-01-01T00:00:00.000Z' }))).status, 400);
+      const { body } = await api.post('/tickets', ticketBody());
+      assert.equal((await api.patch(`/tickets/${body.id}`, { due: '2030-01-01T00:00:00.000Z' })).status, 400);
+    });
+  });
+
+  test('GET /tickets?overdue=true lists only the open and in-progress tickets whose due time has passed', async () => {
+    const clock = manualClock(START);
+    await withService({ ...on, clock }, async (api) => {
+      const make = async (priority) => (await api.post('/tickets', ticketBody({ priority }))).body.id;
+      const urgentOpen = await make('urgent');
+      const urgentProgress = await make('urgent');
+      const urgentResolved = await make('urgent');
+      const urgentClosed = await make('urgent');
+      const high = await make('high');
+      const move = (id, to) => api.post(`/tickets/${id}/transition`, { to });
+      await move(urgentProgress, 'in_progress');
+      for (const id of [urgentResolved, urgentClosed]) {
+        await move(id, 'in_progress');
+        await move(id, 'resolved');
+      }
+      await move(urgentClosed, 'closed');
+      const overdue = async (query = '') => {
+        const { status, body } = await api.get(`/tickets?overdue=true${query}`);
+        assert.equal(status, 200);
+        return body.items.map((ticket) => ticket.id);
+      };
+      assert.deepEqual(await overdue(), []);
+      clock.advance(5 * HOUR);
+      assert.deepEqual(await overdue(), [urgentOpen, urgentProgress]);
+      clock.advance(24 * HOUR);
+      assert.deepEqual(await overdue(), [urgentOpen, urgentProgress, high]);
+      const page = (await api.get('/tickets?overdue=true&limit=2')).body;
+      assert.deepEqual(page.items.map((ticket) => ticket.id), [urgentOpen, urgentProgress]);
+      const rest = (await api.get(`/tickets?overdue=true&limit=2&cursor=${page.next}`)).body;
+      assert.deepEqual(rest.items.map((ticket) => ticket.id), [high]);
+      assert.equal(rest.next, null);
+      assert.equal((await api.get('/tickets')).body.items.length, 5, 'without overdue every ticket is listed');
+    });
+  });
+
+  test('overdue must be true', async () => {
+    await withService(on, async (api) => {
+      const { status, body } = await api.get('/tickets?overdue=maybe');
+      assert.equal(status, 400);
+      assert.equal(body.error.code, 'invalid');
+    });
+  });
+
+  test('a service started on a 1.4.0 file shows the due times it gave its tickets', async (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    const clock = manualClock(START);
+    await withService({ ...on, dataFile: file, clock }, async (api) => {
+      const { items } = (await api.get('/tickets')).body;
+      assert.deepEqual(items.map((ticket) => ticket.due), [
+        '2025-08-01T14:00:00.000Z', '2025-08-03T10:30:00.000Z', '2025-08-06T11:00:00.000Z', '2025-08-11T12:00:00.000Z',
+      ]);
+      assert.deepEqual((await api.get('/tickets?overdue=true')).body.items.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+    });
+  });
+});
+
+describe('the API with due times off', () => {
+  test('answers as it did before: no due on any ticket', async () => {
+    await withService({ clock: manualClock(START) }, async (api) => {
+      const created = await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      assert.deepEqual(Object.keys(created.body), ['id', 'title', 'priority', 'requester', 'status', 'assignee', 'created', 'updated']);
+      const id = created.body.id;
+      for (const response of [
+        await api.get(`/tickets/${id}`),
+        await api.patch(`/tickets/${id}`, { priority: 'high' }),
+        await api.post(`/tickets/${id}/transition`, { to: 'in_progress' }),
+      ]) {
+        assert.equal(response.status, 200);
+        assert.equal('due' in response.body, false);
+      }
+      const { items } = (await api.get('/tickets')).body;
+      assert.equal(items.some((ticket) => 'due' in ticket), false);
+    });
+  });
+
+  test('ignores overdue, as it ignores any parameter it does not know', async () => {
+    const clock = manualClock(START);
+    await withService({ dueTimes: false, clock }, async (api) => {
+      await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      await api.post('/tickets', ticketBody({ priority: 'low' }));
+      clock.advance(10 * HOUR);
+      assert.equal((await api.get('/tickets?overdue=true')).body.items.length, 2);
+      assert.equal((await api.get('/tickets?overdue=maybe')).status, 200);
+    });
+  });
+
+  test('still gives the tickets their due times in the data file, ready for switching on', async (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    oldFile(file);
+    await withService({ dataFile: file, clock: manualClock(START) }, async (api) => {
+      const { items } = (await api.get('/tickets')).body;
+      assert.equal(items.length, 4);
+      assert.equal(items.some((ticket) => 'due' in ticket), false);
+      await api.post('/tickets', ticketBody({ priority: 'high' }));
+    });
+    const { tickets } = read(file);
+    assert.equal(tickets.length, 5);
+    assert.equal(tickets.every((ticket) => typeof ticket.due === 'string'), true);
+    assert.equal(tickets[0].due, '2025-08-01T14:00:00.000Z');
+    assert.equal(tickets[4].due, plus(START, 24));
+  });
+});
