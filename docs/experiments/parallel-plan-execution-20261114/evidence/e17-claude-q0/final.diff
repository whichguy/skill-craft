+  });
+
+  test('imports nothing when an item is invalid, and names the first invalid item by its index', async () => {
+    await withService({}, async (api) => {
+      const tickets = [ticketBody(), ticketBody(), ticketBody({ priority: 'asap' }), ticketBody({ title: '' })];
+      const { status, body } = await api.post('/tickets/import', { tickets });
+      assert.equal(status, 400);
+      assert.equal(body.error.code, 'invalid');
+      assert.match(body.error.message, /\b2\b/);
+      assert.doesNotMatch(body.error.message, /\b3\b/);
+      assert.deepEqual((await api.get('/tickets')).body.items, []);
+      assert.deepEqual((await api.get('/admin/outbox')).body, { pending: [], sent: [], dead: [] });
+      // The failed import used no ticket numbers.
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0001');
