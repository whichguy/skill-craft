+      assert.equal(created.body.assignee, null);
+      const put = await api.put('/tickets/T-0001/assignee', { assignee: 'sam' }, { 'X-Actor': 'dana' });
+      assert.equal(put.status, 200);
+      assert.equal(put.body.assignee, 'sam');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'sam');
+      assert.equal((await api.get('/tickets')).body.items[0].assignee, 'sam');
+      const audit = (await api.get('/tickets/T-0001/audit')).body.items.at(-1);
+      assert.equal(audit.action, 'ticket.assigned');
+      assert.equal(audit.actor, 'dana');
+      const cleared = await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.equal(cleared.status, 200);
+      assert.equal(cleared.body.assignee, null);
+    });
+  });
+
+  test('answers 400 invalid for a bad body, 404 for no ticket, 409 for a resolved ticket', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      for (const body of [{}, { assignee: '' }, { assignee: 'x'.repeat(65) }, { assignee: 3 }, { agent: 'sam' }, []]) {
+        const response = await api.put('/tickets/T-0001/assignee', body);
+        assert.equal(response.status, 400, JSON.stringify(body));
+        assert.equal(response.body.error.code, 'invalid');
+      }
+      assert.equal((await api.put('/tickets/T-0042/assignee', { assignee: 'sam' })).status, 404);
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
