+      const { status, body } = await api.post('/tickets/import', {
+        tickets: [ticketBody({ title: 'A', priority: 'urgent' }), ticketBody({ title: 'B' }), ticketBody({ title: 'C', priority: 'low' })],
+      });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 3, ids: ['T-0002', 'T-0003', 'T-0004'] });
+      const listed = (await api.get('/tickets?limit=100')).body.items;
+      assert.deepEqual(listed.map((t) => [t.id, t.title, t.priority, t.status]), [
+        ['T-0001', 'Existing', 'normal', 'open'],
+        ['T-0002', 'A', 'urgent', 'open'],
+        ['T-0003', 'B', 'normal', 'open'],
+        ['T-0004', 'C', 'low', 'open'],
+      ]);
+    });
+  });
+
+  test('takes what POST /tickets takes: priority is optional and text is trimmed', async () => {
+    await withService({}, async (api) => {
+      const { status } = await api.post('/tickets/import', { tickets: [{ title: '  Padded  ', requester: ' sam ' }] });
+      assert.equal(status, 201);
+      const ticket = (await api.get('/tickets/T-0001')).body;
+      assert.equal(ticket.title, 'Padded');
