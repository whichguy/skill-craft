+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { ConflictError, InvalidError, NotFoundError } = require('../src/errors');
+const { rawLine, table } = require('../src/format');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { render } = require('../src/templates');
+const { matchesFilters, parseListQuery } = require('../src/tickets/query');
+const { assignment } = require('../src/tickets/validate');
+const { main } = require('../bin/tickets');
+const { ticketBody, withService } = require('./helpers');
+
+const input = (overrides = {}) => ({ title: 'Laptop will not boot', requester: 'li@example.com', priority: 'normal', ...overrides });
+
+function store() {
+  const clock = manualClock('2025-09-01T08:00:00.000Z');
+  const tickets = new TicketStore({ clock });
+  tickets.create(input(), 'dana');
+  clock.advance(60_000);
+  return { clock, tickets };
+}
+
+describe('TicketStore.assign', () => {
+  test('a new ticket is unassigned', () => {
+    const { tickets } = store();
+    assert.equal(tickets.get('T-0001').assignee, null);
+  });
+
+  test('assigns an open ticket, audits it and moves updated', () => {
+    const { tickets } = store();
+    const ticket = tickets.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.assignee, 'sam');
+    assert.equal(ticket.updated, '2025-09-01T08:01:00.000Z');
+    const last = tickets.history('T-0001').at(-1);
+    assert.equal(last.action, 'ticket.assigned');
+    assert.equal(last.actor, 'dana');
+    assert.deepEqual(last.changes, { assignee: { from: null, to: 'sam' } });
+  });
+
+  test('assigns an in-progress ticket, and reassigning records the previous agent', () => {
+    const { tickets } = store();
+    tickets.transition('T-0001', 'in_progress', 'dana');
+    tickets.assign('T-0001', 'sam', 'dana');
+    tickets.assign('T-0001', 'li', 'dana');
+    assert.deepEqual(tickets.history('T-0001').at(-1).changes, { assignee: { from: 'sam', to: 'li' } });
+  });
+
+  test('unassigns with null', () => {
+    const { tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    assert.equal(tickets.assign('T-0001', null, 'dana').assignee, null);
+    assert.deepEqual(tickets.history('T-0001').at(-1).changes, { assignee: { from: 'sam', to: null } });
+  });
+
+  test('assigning the agent a ticket already has changes nothing', () => {
+    const { clock, tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    const entries = tickets.history('T-0001').length;
+    const events = tickets.outboxReport().pending.length;
+    clock.advance(60_000);
+    const ticket = tickets.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.updated, '2025-09-01T08:01:00.000Z');
+    assert.equal(tickets.history('T-0001').length, entries);
+    assert.equal(tickets.outboxReport().pending.length, events);
+  });
+
+  test('unassigning an unassigned ticket changes nothing', () => {
+    const { tickets } = store();
+    const entries = tickets.history('T-0001').length;
+    assert.equal(tickets.assign('T-0001', null, 'dana').updated, '2025-09-01T08:00:00.000Z');
+    assert.equal(tickets.history('T-0001').length, entries);
+  });
+
+  test('refuses resolved and closed tickets, even for a change that would change nothing', () => {
+    const { tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    tickets.transition('T-0001', 'in_progress', 'dana');
+    tickets.transition('T-0001', 'resolved', 'dana');
+    assert.throws(() => tickets.assign('T-0001', 'li', 'dana'), ConflictError);
+    assert.throws(() => tickets.assign('T-0001', null, 'dana'), ConflictError);
+    assert.throws(() => tickets.assign('T-0001', 'sam', 'dana'), ConflictError);
+    tickets.transition('T-0001', 'closed', 'dana');
+    assert.throws(() => tickets.assign('T-0001', 'li', 'dana'), ConflictError);
+    assert.equal(tickets.get('T-0001').assignee, 'sam');
+  });
+
+  test('refuses a ticket that does not exist', () => {
+    const { tickets } = store();
+    assert.throws(() => tickets.assign('T-0009', 'sam', 'dana'), NotFoundError);
+  });
+
+  test('notifies the agent it was assigned, through the outbox', () => {
+    const { tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    const event = tickets.outboxReport().pending.find((e) => e.type === 'ticket.assigned');
+    assert.equal(event.to, 'sam');
+    assert.equal(event.ticket, 'T-0001');
+    const message = render(event);
+    assert.match(message.subject, /T-0001/);
+    assert.match(message.body, /assigned to you/);
+  });
+
+  test('every assignment to a different agent is notified, even while an earlier one is pending', () => {
+    const { tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    tickets.assign('T-0001', 'li', 'dana');
+    const to = tickets.outboxReport().pending.filter((e) => e.type === 'ticket.assigned').map((e) => e.to);
+    assert.deepEqual(to, ['sam', 'li']);
+  });
+
+  test('unassigning notifies no one', () => {
+    const { tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    tickets.assign('T-0001', null, 'dana');
+    assert.equal(tickets.outboxReport().pending.filter((e) => e.type === 'ticket.assigned').length, 1);
+  });
+});
+
+describe('assignment body', () => {
+  test('takes an agent name or null', () => {
+    assert.equal(assignment({ assignee: 'sam' }), 'sam');
+    assert.equal(assignment({ assignee: 'x'.repeat(64) }).length, 64);
+    assert.equal(assignment({ assignee: null }), null);
+  });
+
+  test('refuses anything else', () => {
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 'x'.repeat(65) }, { assignee: 7 },
+      { assignee: ['sam'] }, { assignee: 'a\tb' }, { assignee: 'sam', extra: 1 }]) {
+      assert.throws(() => assignment(body), InvalidError, JSON.stringify(body));
+    }
+  });
+});
+
+describe('PUT /tickets/:id/assignee', () => {
+  test('assigns and unassigns, and the ticket shows its assignee', async () => {
+    await withService({}, async (api) => {
