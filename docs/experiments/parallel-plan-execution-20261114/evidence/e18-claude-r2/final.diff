--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,23 @@
+'use strict';
+
+const { isActive } = require('./states');
+
+/**
+ * Due times: the time a ticket was created plus the hours its priority allows (config.dueHours, README.md). A ticket's
+ * due time is set once, when it is created or, for a ticket from before due times, when the service first starts with
+ * them; after that neither a change of the hours nor of the ticket's priority moves it.
+ */
+
+const HOUR_MS = 60 * 60 * 1000;
+
+/** The ISO time `hours[priority]` hours after `created` (an ISO time). */
+function dueFor(created, priority, hours) {
+  return new Date(Date.parse(created) + hours[priority] * HOUR_MS).toISOString();
+}
+
+/** Whether `ticket` is open or in progress and its due time is before `now` (a Date). */
+function isOverdue(ticket, now) {
+  return isActive(ticket.status) && ticket.due !== undefined && Date.parse(ticket.due) < now.getTime();
+}
+
+module.exports = { dueFor, isOverdue };
