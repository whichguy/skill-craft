+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { DEFAULT_DUE_HOURS, ConfigError, loadConfig } = require('../src/config');
+const { InvalidError } = require('../src/errors');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { dueFor, isOverdue } = require('../src/tickets/due');
+const { parseListQuery } = require('../src/tickets/query');
+const { ticketBody, withService } = require('./helpers');
+
+const HOUR = 60 * 60 * 1000;
+const START = '2025-09-01T08:00:00.000Z';
+const after = (hours, from = START) => new Date(Date.parse(from) + hours * HOUR).toISOString();
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+describe('the response times setting', () => {
+  test('are 4, 24, 72 and 168 hours, and DUE_TIMES is off, by default', () => {
+    const config = loadConfig({});
+    assert.deepEqual({ ...config.dueHours }, { urgent: 4, high: 24, normal: 72, low: 168 });
+    assert.deepEqual({ ...DEFAULT_DUE_HOURS }, { ...config.dueHours });
+    assert.equal(config.dueTimes, false);
+  });
+
+  test('each priority has its own variable, and an empty one is unset', () => {
+    const config = loadConfig({ DUE_HOURS_URGENT: '2', DUE_HOURS_HIGH: '', DUE_HOURS_NORMAL: '48', DUE_HOURS_LOW: '240' });
+    assert.deepEqual({ ...config.dueHours }, { urgent: 2, high: 24, normal: 48, low: 240 });
+  });
+
+  test('a value that is not a whole number of hours stops the service, naming the variable', () => {
+    for (const [name, value] of [['DUE_HOURS_URGENT', '0'], ['DUE_HOURS_HIGH', 'soon'], ['DUE_HOURS_NORMAL', '1.5'], ['DUE_HOURS_LOW', '-3']]) {
+      assert.throws(() => loadConfig({ [name]: value }), (error) => error instanceof ConfigError && error.message.includes(name), name);
+    }
+  });
+
+  test('DUE_TIMES is on only when it is "on"', () => {
+    assert.equal(loadConfig({ DUE_TIMES: 'on' }).dueTimes, true);
+    for (const value of ['', 'off', '1', 'true', 'ON', 'yes']) assert.equal(loadConfig({ DUE_TIMES: value }).dueTimes, false, value);
+  });
+});
+
+describe('dueFor and isOverdue', () => {
+  test('a due time is the creation time plus the hours of the priority', () => {
+    for (const [priority, hours] of Object.entries(DEFAULT_DUE_HOURS)) {
+      assert.equal(dueFor(START, priority, DEFAULT_DUE_HOURS), after(hours), priority);
+    }
+  });
+
+  test('only an open or in-progress ticket whose due time has passed is overdue', () => {
+    const due = after(4);
+    const now = (hours) => new Date(after(hours));
+    assert.equal(isOverdue({ status: 'open', due }, now(3)), false);
+    assert.equal(isOverdue({ status: 'open', due }, now(4)), false, 'at the due time it has not passed yet');
+    assert.equal(isOverdue({ status: 'open', due }, now(5)), true);
+    assert.equal(isOverdue({ status: 'in_progress', due }, now(5)), true);
+    assert.equal(isOverdue({ status: 'resolved', due }, now(5)), false);
+    assert.equal(isOverdue({ status: 'closed', due }, now(5)), false);
+    assert.equal(isOverdue({ status: 'open' }, now(500)), false, 'a ticket without a due time is never overdue');
+  });
+});
+
+describe('the listing query', () => {
+  const query = (text, options) => parseListQuery(new URLSearchParams(text), options);
+
+  test('reads overdue=true when due times are on', () => {
+    assert.equal(query('overdue=true', { dueTimes: true }).overdue, true);
+    assert.deepEqual(query('status=open', { dueTimes: true }), { filters: { status: 'open' }, limit: 20, after: null });
+  });
+
+  test('refuses any other value of overdue when due times are on', () => {
+    for (const value of ['false', '1', '', 'yes']) assert.throws(() => query(`overdue=${value}`, { dueTimes: true }), InvalidError, value);
+  });
+
+  test('ignores overdue while due times are off, like any parameter it does not know', () => {
+    assert.deepEqual(query('overdue=true'), { filters: {}, limit: 20, after: null });
+    assert.deepEqual(query('overdue=nonsense'), { filters: {}, limit: 20, after: null });
+  });
+});
+
+describe('the store', () => {
+  const create = (store, priority) => store.createTicket({ title: 'Laptop will not boot', requester: 'li@example.com', priority }, 'dana');
+
+  test('gives a new ticket its due time: the time of creation plus the hours of its priority', () => {
+    const store = new TicketStore({ clock: manualClock(START), dueHours: DEFAULT_DUE_HOURS, dueTimes: true });
+    const due = ['urgent', 'high', 'normal', 'low'].map((priority) => create(store, priority).due);
+    assert.deepEqual(due, [after(4), after(24), after(72), after(168)]);
+    assert.equal(store.get('T-0001').due, after(4));
+  });
+
+  test('sets the due time once: a later change of the priority or of the hours does not move it', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock(START);
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueHours: DEFAULT_DUE_HOURS, dueTimes: true });
+    create(store, 'normal');
+    clock.advance(HOUR);
+    assert.equal(store.update('T-0001', { priority: 'urgent' }, 'dana').due, after(72));
+    store.transition('T-0001', 'in_progress', 'dana');
+    assert.equal(store.get('T-0001').due, after(72));
+
+    const hours = { urgent: 1, high: 2, normal: 3, low: 4 };
+    const restarted = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueHours: hours, dueTimes: true });
+    assert.equal(restarted.get('T-0001').due, after(72));
+    assert.equal(create(restarted, 'normal').due, after(3, clock.now().toISOString()), 'new tickets use the new hours');
+  });
+
+  test('shows no due time while due times are off, but keeps it', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock(START);
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueHours: DEFAULT_DUE_HOURS });
+    assert.equal('due' in create(store, 'high'), false);
+    assert.equal('due' in store.get('T-0001'), false);
+    assert.equal('due' in store.list().items[0], false);
+    assert.equal('due' in store.update('T-0001', { priority: 'low' }, 'dana'), false);
+    assert.equal(JSON.parse(fs.readFileSync(file, 'utf8')).tickets[0].due, after(24));
+  });
+
+  test('lists only the overdue tickets with overdue', () => {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock, dueHours: DEFAULT_DUE_HOURS, dueTimes: true });
+    create(store, 'urgent'); // T-0001, due in 4 hours
+    create(store, 'urgent'); // T-0002
+    create(store, 'urgent'); // T-0003
+    create(store, 'low'); // T-0004
+    store.transition('T-0002', 'in_progress', 'dana');
+    store.transition('T-0003', 'in_progress', 'dana');
+    store.transition('T-0003', 'resolved', 'dana');
+    clock.advance(5 * HOUR);
+    assert.deepEqual(store.list({ overdue: true }).items.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+    assert.deepEqual(store.list().items.map((ticket) => ticket.id), ['T-0001', 'T-0002', 'T-0003', 'T-0004']);
+  });
+});
+
+describe('tickets from before due times', () => {
+  const OLD = [
+    { id: 'T-0001', title: 'VPN drops', priority: 'urgent', requester: 'a@example.com', status: 'open', created: '2025-08-01T10:00:00.000Z', updated: '2025-08-01T10:00:00.000Z' },
+    { id: 'T-0002', title: 'Printer jams', priority: 'low', requester: 'b@example.com', status: 'in_progress', created: '2025-08-02T09:30:00.000Z', updated: '2025-08-03T09:30:00.000Z' },
+    { id: 'T-0003', title: 'Old', priority: 'normal', requester: 'c@example.com', status: 'closed', created: '2025-07-01T00:00:00.000Z', updated: '2025-07-02T00:00:00.000Z' },
+  ];
+
+  function writeOldFile(file) {
+    const document = { version: 1, savedAt: '2025-09-01T00:00:00.000Z', nextNumber: 4, tickets: OLD, audit: [], outbox: { nextId: 1, events: [] } };
+    fs.writeFileSync(file, JSON.stringify(document));
+  }
+
+  test('get their due time from their own creation time and priority, and the data file keeps it', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    writeOldFile(file);
+    const clock = manualClock(START);
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueHours: DEFAULT_DUE_HOURS, dueTimes: true });
+    assert.deepEqual(store.list().items.map((ticket) => ticket.due), [
+      after(4, OLD[0].created), after(168, OLD[1].created), after(72, OLD[2].created),
+    ]);
+    const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.deepEqual(saved.tickets.map((ticket) => ticket.due), [after(4, OLD[0].created), after(168, OLD[1].created), after(72, OLD[2].created)]);
+  });
+
+  test('keep that due time from then on, whatever the hours and the priority become', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    writeOldFile(file);
+    const clock = manualClock(START);
+    TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueHours: DEFAULT_DUE_HOURS });
+    const hours = { urgent: 1, high: 1, normal: 1, low: 1 };
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueHours: hours, dueTimes: true });
+    store.update('T-0002', { priority: 'urgent' }, 'dana');
+    assert.equal(store.get('T-0001').due, after(4, OLD[0].created));
+    assert.equal(store.get('T-0002').due, after(168, OLD[1].created));
+  });
+
+  test('are overdue by their own due time once due times are on', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    writeOldFile(file);
+    const clock = manualClock(after(100, OLD[1].created)); // T-0001 is long past due, T-0002 (168 h) is not
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueHours: DEFAULT_DUE_HOURS, dueTimes: true });
+    assert.deepEqual(store.list({ overdue: true }).items.map((ticket) => ticket.id), ['T-0001']);
+  });
+
+  test('the data file is not rewritten when every ticket already has a due time', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    writeOldFile(file);
+    const clock = manualClock(START);
+    TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueHours: DEFAULT_DUE_HOURS });
+    const text = fs.readFileSync(file, 'utf8');
+    const later = manualClock('2026-01-01T00:00:00.000Z'); // a save would change savedAt
+    TicketStore.open({ clock: later, persistence: createPersistence(file, { clock: later }), dueHours: DEFAULT_DUE_HOURS });
+    assert.equal(fs.readFileSync(file, 'utf8'), text);
+  });
+});
+
+describe('the API', () => {
+  const settings = (extra = {}) => ({ clock: manualClock(START), ...extra });
+
+  test('shows `due` on every ticket when DUE_TIMES is on', async () => {
+    await withService(settings({ dueTimes: true }), async (api) => {
+      const created = (await api.post('/tickets', ticketBody({ priority: 'urgent' }))).body;
+      assert.equal(created.due, after(4));
+      assert.equal((await api.get(`/tickets/${created.id}`)).body.due, after(4));
+      assert.equal((await api.get('/tickets')).body.items[0].due, after(4));
+      assert.equal((await api.patch(`/tickets/${created.id}`, { priority: 'low' })).body.due, after(4));
+      assert.equal((await api.post(`/tickets/${created.id}/transition`, { to: 'in_progress' })).body.due, after(4));
+    });
+  });
+
+  test('uses the configured hours', async () => {
+    await withService(settings({ dueTimes: true, dueHours: { urgent: 1, high: 2, normal: 3, low: 4 } }), async (api) => {
+      assert.equal((await api.post('/tickets', ticketBody({ priority: 'high' }))).body.due, after(2));
+      assert.equal((await api.post('/tickets', ticketBody())).body.due, after(3));
+    });
+  });
+
+  test('lists only the open and in-progress tickets that are overdue with ?overdue=true', async () => {
+    const clock = manualClock(START);
+    await withService({ clock, dueTimes: true }, async (api) => {
+      for (const priority of ['urgent', 'urgent', 'urgent', 'high', 'low']) await api.post('/tickets', ticketBody({ priority }));
+      await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+      await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+      await api.post('/tickets/T-0003/transition', { to: 'resolved' });
+      const ids = async (query) => (await api.get(`/tickets${query}`)).body.items.map((ticket) => ticket.id);
+
+      assert.deepEqual(await ids('?overdue=true'), []);
+      clock.advance(5 * HOUR);
+      assert.deepEqual(await ids('?overdue=true'), ['T-0001', 'T-0002']);
+      clock.advance(20 * HOUR);
+      assert.deepEqual(await ids('?overdue=true'), ['T-0001', 'T-0002', 'T-0004']);
+      assert.deepEqual(await ids(''), ['T-0001', 'T-0002', 'T-0003', 'T-0004', 'T-0005']);
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+      assert.deepEqual(await ids('?overdue=true'), ['T-0002', 'T-0004']);
+    });
+  });
+
+  test('pages the overdue listing with cursors', async () => {
+    const clock = manualClock(START);
+    await withService({ clock, dueTimes: true }, async (api) => {
+      for (let n = 0; n < 5; n += 1) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      clock.advance(5 * HOUR);
+      const first = (await api.get('/tickets?overdue=true&limit=2')).body;
+      assert.deepEqual(first.items.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+      const second = (await api.get(`/tickets?overdue=true&limit=2&cursor=${first.next}`)).body;
+      assert.deepEqual(second.items.map((ticket) => ticket.id), ['T-0003', 'T-0004']);
+    });
+  });
+
+  test('refuses an overdue value other than true with 400 when due times are on', async () => {
+    await withService(settings({ dueTimes: true }), async (api) => {
+      const response = await api.get('/tickets?overdue=maybe');
+      assert.equal(response.status, 400);
+      assert.equal(response.body.error.code, 'invalid');
+    });
+  });
+
+  test('answers exactly as before while DUE_TIMES is off: no `due`, and overdue is ignored', async () => {
+    const clock = manualClock(START);
+    await withService({ clock }, async (api) => {
+      const created = (await api.post('/tickets', ticketBody({ priority: 'urgent' }))).body;
+      assert.deepEqual(Object.keys(created), ['id', 'title', 'priority', 'requester', 'status', 'created', 'updated']);
+      clock.advance(100 * HOUR);
+      assert.deepEqual(Object.keys((await api.get(`/tickets/${created.id}`)).body), Object.keys(created));
+      assert.deepEqual(Object.keys((await api.get('/tickets')).body.items[0]), Object.keys(created));
+      await api.post('/tickets', ticketBody({ priority: 'low' }));
+      const overdue = await api.get('/tickets?overdue=true');
+      assert.equal(overdue.status, 200);
+      assert.equal(overdue.body.items.length, 2, 'the parameter is not known yet, so it filters nothing');
+      assert.equal((await api.get('/tickets?overdue=nonsense')).status, 200);
+    });
+  });
+
+  test('a restart on the same data file keeps the due times, and DUE_TIMES shows them', async (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    const clock = manualClock(START);
+    await withService({ dataFile, clock }, async (api) => {
+      await api.post('/tickets', ticketBody({ priority: 'high' }));
+    });
+    clock.advance(HOUR);
+    await withService({ dataFile, clock, dueTimes: true, dueHours: { urgent: 1, high: 1, normal: 1, low: 1 } }, async (api) => {
+      assert.equal((await api.get('/tickets/T-0001')).body.due, after(24));
+    });
+  });
+});
diff --git a/test/fixtures/persistence-1.4.0.js b/test/fixtures/persistence-1.4.0.js
new file mode 100644
index 0000000..d5cc3fa
--- /dev/null
+++ b/test/fixtures/persistence-1.4.0.js
@@ -0,0 +1,209 @@
+'use strict';
+
+// Release 1.4.0's data file reader, kept verbatim (only its require paths differ) so test/rollback.test.js can check
+// that 1.4.0 still starts on the file this release writes. Do not change it.
+
+const fs = require('node:fs');
+const path = require('node:path');
+const { STATES } = require('../../src/outbox');
+const { parseId } = require('../../src/tickets/ids');
+const { isPriority } = require('../../src/tickets/priorities');
+const { isStatus } = require('../../src/tickets/states');
+
+/**
+ * The data file (docs/decisions/0008-json-data-file.md): the store's whole state as one JSON document,
+ *
+ *   { "version": 1, "savedAt": "...", "nextNumber": 8, "tickets": [...], "audit": [...],
+ *     "outbox": { "nextId": 5, "events": [...] } }
+ *
+ * written after every change to a temporary file that then replaces the old one, so a crash leaves the old state or the
+ * new one, never a mix of the two.
+ *
+ * Saving and loading go through the record functions below, which name every field the file keeps. Loading checks each
+ * record, so a file edited by hand cannot put the service into a state it could not reach by itself; a file that fails
+ * a check is refused with the reason, and the service does not start.
+ */
+
+const VERSION = 1;
+
+class DataFileError extends Error {
+  constructor(file, message) {
+    super(`${file}: ${message}`);
+    this.name = 'DataFileError';
+  }
+}
+
+/** Load and save the state in `file`. */
+function createPersistence(file, { clock = { now: () => new Date() } } = {}) {
+  return {
+    file,
+
+    /** The saved state, or null when the file does not exist yet (the first start). */
+    load() {
+      let text;
+      try {
+        text = fs.readFileSync(file, 'utf8');
+      } catch (error) {
+        if (error.code === 'ENOENT') return null;
+        throw new DataFileError(file, `cannot be read: ${error.message}`);
+      }
+      let document;
+      try {
+        document = JSON.parse(text);
+      } catch {
+        throw new DataFileError(file, 'is not JSON');
+      }
+      return fromDocument(document, (message) => new DataFileError(file, message));
+    },
+
+    save(state) {
+      const document = toDocument(state, clock.now());
+      fs.mkdirSync(path.dirname(path.resolve(file)), { recursive: true });
+      const temporary = `${file}.${process.pid}.tmp`;
+      fs.writeFileSync(temporary, `${JSON.stringify(document, null, 2)}\n`);
+      fs.renameSync(temporary, file);
+    },
+  };
+}
+
+function toDocument(state, now) {
+  return {
+    version: VERSION,
+    savedAt: now.toISOString(),
+    nextNumber: state.nextNumber,
+    tickets: state.tickets.map(ticketRecord),
+    audit: state.audit.map(auditRecord),
+    outbox: { nextId: state.outbox.nextId, events: state.outbox.events.map(eventRecord) },
+  };
+}
+
+function fromDocument(document, fail) {
+  if (!isObject(document)) throw fail('is not a data file');
+  if (document.version !== VERSION) throw fail(`has version ${document.version}; this service reads version ${VERSION}`);
+  const nextNumber = positive(document.nextNumber, 'nextNumber', fail);
+  const tickets = array(document.tickets, 'tickets', fail).map((record, index) => readTicket(record, `tickets[${index}]`, fail));
+  const ids = new Set();
+  for (const ticket of tickets) {
+    if (ids.has(ticket.id)) throw fail(`ticket ${ticket.id} appears twice`);
+    ids.add(ticket.id);
+    if (parseId(ticket.id) >= nextNumber) throw fail(`nextNumber ${nextNumber} would reuse the number of ${ticket.id}`);
+  }
+  const audit = array(document.audit, 'audit', fail).map((record, index) => readAudit(record, index, fail));
+  const outbox = object(document.outbox, 'outbox', fail);
+  const events = array(outbox.events, 'outbox.events', fail).map((record, index) => readEvent(record, `outbox.events[${index}]`, fail));
+  const nextId = positive(outbox.nextId, 'outbox.nextId', fail);
+  if (events.some((event) => event.id >= nextId)) throw fail(`outbox.nextId ${nextId} would reuse an event id`);
+  return { nextNumber, tickets, audit, outbox: { nextId, events } };
+}
+
+// Records: the fields the file keeps, one function per kind, used to save and to load.
+
+function ticketRecord(ticket) {
+  return {
+    id: ticket.id,
+    title: ticket.title,
+    priority: ticket.priority,
+    requester: ticket.requester,
+    status: ticket.status,
+    created: ticket.created,
+    updated: ticket.updated,
+  };
+}
+
+function auditRecord(entry) {
+  return {
+    seq: entry.seq,
+    ticket: entry.ticket,
+    action: entry.action,
+    actor: entry.actor,
+    at: entry.at,
+    changes: entry.changes,
+  };
+}
+
+function eventRecord(event) {
+  return {
+    id: event.id,
+    key: event.key,
+    type: event.type,
+    to: event.to,
+    ticket: event.ticket,
+    data: event.data,
+    status: event.status,
+    attempts: event.attempts,
+    created: event.created,
+    nextAttemptAt: event.nextAttemptAt,
+    lastError: event.lastError,
+    sentAt: event.sentAt,
+  };
+}
+
+function readTicket(record, where, fail) {
+  const ticket = ticketRecord(object(record, where, fail));
+  if (parseId(ticket.id) === null) throw fail(`${where}.id is not a ticket id`);
+  text(ticket.title, `${where}.title`, fail);
+  text(ticket.requester, `${where}.requester`, fail);
+  if (!isPriority(ticket.priority)) throw fail(`${where}.priority is not a priority`);
+  if (!isStatus(ticket.status)) throw fail(`${where}.status is not a status`);
+  time(ticket.created, `${where}.created`, fail);
+  time(ticket.updated, `${where}.updated`, fail);
+  return ticket;
+}
+
+function readAudit(record, index, fail) {
+  const where = `audit[${index}]`;
+  const entry = auditRecord(object(record, where, fail));
+  if (entry.seq !== index + 1) throw fail(`${where}.seq is ${entry.seq}, not ${index + 1}: the log is append-only`);
+  for (const field of ['ticket', 'action', 'actor']) text(entry[field], `${where}.${field}`, fail);
+  time(entry.at, `${where}.at`, fail);
+  if (!isObject(entry.changes)) throw fail(`${where}.changes is not an object`);
+  for (const [field, change] of Object.entries(entry.changes)) {
+    if (!isObject(change) || !('from' in change) || !('to' in change)) throw fail(`${where}.changes.${field} needs from and to`);
+  }
+  return entry;
+}
+
+function readEvent(record, where, fail) {
+  const event = eventRecord(object(record, where, fail));
+  positive(event.id, `${where}.id`, fail);
+  for (const field of ['key', 'type', 'to']) text(event[field], `${where}.${field}`, fail);
+  if (!STATES.includes(event.status)) throw fail(`${where}.status is not one of ${STATES.join(', ')}`);
+  if (!Number.isInteger(event.attempts) || event.attempts < 0) throw fail(`${where}.attempts is not a count`);
+  if (!isObject(event.data)) throw fail(`${where}.data is not an object`);
+  time(event.created, `${where}.created`, fail);
+  if (event.status === 'pending') time(event.nextAttemptAt, `${where}.nextAttemptAt`, fail);
+  return event;
+}
+
+// Checks
+
+function isObject(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function object(value, where, fail) {
+  if (!isObject(value)) throw fail(`${where} is not an object`);
+  return value;
+}
+
+function array(value, where, fail) {
+  if (!Array.isArray(value)) throw fail(`${where} is not a list`);
+  return value;
+}
+
+function positive(value, where, fail) {
+  if (!Number.isSafeInteger(value) || value < 1) throw fail(`${where} is not a positive whole number`);
+  return value;
+}
+
+function text(value, where, fail) {
+  if (typeof value !== 'string' || value === '') throw fail(`${where} is not a non-empty string`);
+  return value;
+}
+
+function time(value, where, fail) {
+  if (typeof value !== 'string' || Number.isNaN(Date.parse(value))) throw fail(`${where} is not a time`);
+  return value;
+}
+
+module.exports = { DataFileError, VERSION, createPersistence, fromDocument, toDocument };
