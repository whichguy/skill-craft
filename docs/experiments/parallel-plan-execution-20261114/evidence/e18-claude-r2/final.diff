+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { main } = require('../bin/tickets');
+const { manualClock } = require('../src/clock');
+const { loadConfig } = require('../src/config');
+const { InvalidError } = require('../src/errors');
+const { rawLine, table } = require('../src/format');
+const { createNotifier } = require('../src/notifier');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { matchesFilters, parseListQuery } = require('../src/tickets/query');
+const validate = require('../src/tickets/validate');
+const { Worker, deliverOutbox } = require('../src/worker');
+const { silentLogger } = require('../src/log');
+const { ticketBody, withService } = require('./helpers');
+
+const START = '2025-09-01T08:00:00.000Z';
+const input = (overrides = {}) => ({ title: 'Laptop will not boot', requester: 'li@example.com', priority: 'normal', ...overrides });
+const ON = { assignees: true };
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assignee-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+describe('the ASSIGNEES setting', () => {
+  test('is off by default and on only when it is "on"', () => {
+    assert.equal(loadConfig({}).assignees, false);
+    assert.equal(loadConfig({ ASSIGNEES: 'on' }).assignees, true);
+    for (const value of ['', 'off', '1', 'true', 'ON']) assert.equal(loadConfig({ ASSIGNEES: value }).assignees, false, value);
+  });
+});
+
+describe('validate.assignee', () => {
+  test('takes an agent name or null', () => {
+    assert.equal(validate.assignee({ assignee: 'sam' }), 'sam');
+    assert.equal(validate.assignee({ assignee: null }), null);
+    assert.equal(validate.assignee({ assignee: 'a'.repeat(64) }), 'a'.repeat(64));
+  });
+
+  test('refuses anything else', () => {
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 'a'.repeat(65) }, { assignee: 7 }, { assignee: ['sam'] },
+      { assignee: 'sam\nlee' }, { assignee: 'sam', extra: 1 }]) {
+      assert.throws(() => validate.assignee(body), InvalidError, JSON.stringify(body));
+    }
+  });
+});
+
+describe('the listing filter', () => {
+  const query = (text) => parseListQuery(new URLSearchParams(text));
+
+  test('reads assignee=<agent>, and an empty assignee= as the unassigned', () => {
+    assert.deepEqual(query('assignee=sam').filters, { assignee: 'sam' });
+    assert.deepEqual(query('assignee=').filters, { assignee: null });
+  });
+
+  test('matchesFilters needs every filter given to match', () => {
+    const ticket = { id: 'T-0001', status: 'open', priority: 'high', assignee: 'sam' };
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'high' }), true);
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'low' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'closed', priority: 'high' }), false);
+    assert.equal(matchesFilters(ticket, { assignee: 'sam', status: 'open' }), true);
+    assert.equal(matchesFilters(ticket, { assignee: 'lee', status: 'open' }), false);
+    assert.equal(matchesFilters(ticket, { assignee: null }), false);
+  });
+
+  test('a ticket with no assignee is unassigned', () => {
+    assert.equal(matchesFilters({ id: 'T-0001' }, { assignee: null }), true);
+    assert.equal(matchesFilters({ id: 'T-0001', assignee: null }, { assignee: null }), true);
+    assert.equal(matchesFilters({ id: 'T-0001' }, { assignee: 'sam' }), false);
+  });
+});
+
+describe('TicketStore.assign', () => {
+  function setup(options = {}) {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock, ...options });
+    store.createTicket(input(), 'system');
+    return { clock, store };
+  }
+
+  test('assigns, audits the change and tells the agent', () => {
+    const { clock, store } = setup(ON);
+    clock.advance(1000);
+    const ticket = store.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.assignee, 'sam');
+    assert.equal(ticket.updated, '2025-09-01T08:00:01.000Z');
+    const entry = store.history('T-0001')[1];
+    assert.deepEqual([entry.action, entry.actor, entry.changes], ['ticket.assigned', 'dana', { assignee: { from: null, to: 'sam' } }]);
+    const pending = store.outboxReport().pending;
+    assert.deepEqual(pending.map((event) => [event.type, event.to, event.ticket]), [
