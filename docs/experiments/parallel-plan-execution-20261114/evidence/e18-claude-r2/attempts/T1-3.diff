+describe('the command line', () => {
+  function dataFile(t) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-cli-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    const file = path.join(dir, 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket(input({ title: 'VPN drops' }), 'dana');
+    store.createTicket(input({ title: 'Printer jams' }), 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    return file;
+  }
+  function run(argv) {
+    let out = '';
+    const code = main(argv, { env: {}, out: { write: (text) => (out += text) }, err: { write: (text) => (out += text) } });
+    return { code, out };
+  }
+
+  test('list shows each ticket\'s assignee', (t) => {
+    const file = dataFile(t);
+    const { code, out } = run(['--data', file, 'list']);
+    assert.equal(code, 0);
+    const [header, first, second] = out.trimEnd().split('\n');
+    assert.match(header, /ASSIGNEE/);
+    assert.match(first, /\bsam\b/);
+    assert.doesNotMatch(second, /\bsam\b/);
+  });
+
+  test('list --raw keeps its first four columns and appends the assignee', (t) => {
+    const file = dataFile(t);
+    const lines = run(['--data', file, 'list', '--raw']).out.split('\n').filter((line) => line !== '').map((line) => line.split('\t'));
+    assert.deepEqual(lines[0], ['T-0001', 'open', 'normal', 'VPN drops', 'sam']);
+    assert.deepEqual(lines[1], ['T-0002', 'open', 'normal', 'Printer jams', '']);
+  });
+
+  test('list --assignee filters, and an empty value lists the unassigned', (t) => {
+    const file = dataFile(t);
+    const ids = (argv) => run(['--data', file, 'list', '--raw', ...argv]).out.split('\n').filter((line) => line !== '').map((line) => line.split('\t')[0]);
+    assert.deepEqual(ids(['--assignee', 'sam']), ['T-0001']);
+    assert.deepEqual(ids(['--assignee', '']), ['T-0002']);
+  });
+
+  test('show names the assignee', (t) => {
+    const file = dataFile(t);
+    assert.match(run(['--data', file, 'show', 'T-0001']).out, /assignee\s+sam/);
+  });
+});
