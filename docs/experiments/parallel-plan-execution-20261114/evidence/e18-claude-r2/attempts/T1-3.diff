+    const notifier = createNotifier({ clock: manualClock() });
+    const line = notifier.deliver({ id: 1, key: 'k', type: 'ticket.assigned', to: 'sam', ticket: 'T-0007', data: { title: 'VPN drops' } });
+    assert.equal(line.to, 'sam');
