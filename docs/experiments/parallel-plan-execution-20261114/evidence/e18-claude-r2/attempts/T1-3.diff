+describe('GET /tickets?assignee=', () => {
+  async function seeded(api) {
+    for (let n = 0; n < 5; n += 1) await api.post('/tickets', ticketBody({ priority: n % 2 ? 'high' : 'low' }));
+    await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+    await api.put('/tickets/T-0002/assignee', { assignee: 'sam' });
+    await api.put('/tickets/T-0003/assignee', { assignee: 'li' });
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+  }
+  const ids = async (api, query) => (await api.get(`/tickets?${query}`)).body.items.map((ticket) => ticket.id);
+
+  test('keeps one agent\'s tickets, and an empty value keeps the unassigned', async () => {
+    await withService({}, async (api) => {
+      await seeded(api);
+      assert.deepEqual(await ids(api, 'assignee=sam'), ['T-0001', 'T-0002']);
+      assert.deepEqual(await ids(api, 'assignee=li'), ['T-0003']);
+      assert.deepEqual(await ids(api, 'assignee='), ['T-0004', 'T-0005']);
+      assert.deepEqual(await ids(api, 'assignee=nobody'), []);
+    });
+  });
+
+  test('combines with the other filters: a ticket must match every one', async () => {
+    await withService({}, async (api) => {
+      await seeded(api);
+      assert.deepEqual(await ids(api, 'assignee=sam&status=open'), ['T-0001']);
+      assert.deepEqual(await ids(api, 'assignee=sam&status=in_progress'), ['T-0002']);
+      assert.deepEqual(await ids(api, 'assignee=sam&priority=high'), ['T-0002']);
+      assert.deepEqual(await ids(api, 'assignee=&status=open&priority=high'), ['T-0004']);
+      assert.deepEqual(await ids(api, 'assignee=li&status=closed'), []);
+      assert.deepEqual(await ids(api, 'status=open&priority=low'), ['T-0001', 'T-0003', 'T-0005']);
+    });
+  });
+
+  test('pages with the filter', async () => {
+    await withService({}, async (api) => {
+      await seeded(api);
+      const first = (await api.get('/tickets?assignee=sam&limit=1')).body;
+      assert.deepEqual([first.items.map((ticket) => ticket.id), first.next !== null], [['T-0001'], true]);
+      const second = (await api.get(`/tickets?assignee=sam&limit=1&cursor=${first.next}`)).body;
+      assert.deepEqual([second.items.map((ticket) => ticket.id), second.next], [['T-0002'], null]);
+    });
+  });
+});
