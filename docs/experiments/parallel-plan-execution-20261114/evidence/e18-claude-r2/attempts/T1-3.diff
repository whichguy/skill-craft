+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { main } = require('../bin/tickets');
+const { createNotifier } = require('../src/notifier');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { matchesFilters, parseListQuery } = require('../src/tickets/query');
+const { ticketBody, withService } = require('./helpers');
+
+const input = (overrides = {}) => ({ title: 'Laptop will not boot', requester: 'li@example.com', priority: 'normal', ...overrides });
+
+describe('assigning in the store', () => {
+  function open() {
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    const store = new TicketStore({ clock });
+    store.createTicket(input(), 'dana');
+    return { clock, store };
+  }
+
+  test('a new ticket shows no assignee', () => {
+    const { store } = open();
+    assert.equal(store.get('T-0001').assignee, null);
+    assert.equal(store.list().items[0].assignee, null);
+  });
+
+  test('assigns, audits the change and tells the agent through the outbox', () => {
+    const { clock, store } = open();
+    clock.advance(60000);
+    const ticket = store.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.assignee, 'sam');
+    assert.equal(ticket.updated, '2025-09-01T08:01:00.000Z');
+    assert.deepEqual(store.history('T-0001').at(-1), {
+      seq: 2,
+      ticket: 'T-0001',
+      action: 'ticket.assigned',
+      actor: 'dana',
+      at: '2025-09-01T08:01:00.000Z',
+      changes: { assignee: { from: null, to: 'sam' } },
+    });
+    const event = store.outboxReport().pending.at(-1);
+    assert.deepEqual([event.type, event.to, event.ticket, event.data], ['ticket.assigned', 'sam', 'T-0001', { title: 'Laptop will not boot' }]);
+  });
+
+  test('assigning the agent it already has changes nothing', () => {
+    const { clock, store } = open();
+    store.assign('T-0001', 'sam', 'dana');
+    clock.advance(60000);
+    const before = { audit: store.history('T-0001').length, outbox: store.outboxReport().pending.length };
+    const ticket = store.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.updated, '2025-09-01T08:00:00.000Z');
+    assert.deepEqual({ audit: store.history('T-0001').length, outbox: store.outboxReport().pending.length }, before);
+  });
+
+  test('reassigning notifies the new agent even while the first notice is still pending', () => {
+    const { store } = open();
+    store.assign('T-0001', 'sam', 'dana');
+    store.assign('T-0001', 'li', 'dana');
+    const notices = store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned');
+    assert.deepEqual(notices.map((event) => event.to), ['sam', 'li']);
+    assert.equal(store.get('T-0001').assignee, 'li');
+    assert.deepEqual(store.history('T-0001').at(-1).changes, { assignee: { from: 'sam', to: 'li' } });
+  });
+
+  test('unassigns without notifying anyone; unassigning an unassigned ticket changes nothing', () => {
+    const { store } = open();
+    store.assign('T-0001', 'sam', 'dana');
+    const notices = store.outboxReport().pending.length;
+    assert.equal(store.assign('T-0001', null, 'dana').assignee, null);
+    assert.equal(store.outboxReport().pending.length, notices);
+    assert.deepEqual(store.history('T-0001').at(-1).changes, { assignee: { from: 'sam', to: null } });
+    const entries = store.history('T-0001').length;
+    store.assign('T-0001', null, 'dana');
+    assert.equal(store.history('T-0001').length, entries);
+  });
+
+  test('works on in-progress tickets, and conflicts on resolved and closed ones', () => {
+    const { store } = open();
+    store.transition('T-0001', 'in_progress', 'sam');
+    assert.equal(store.assign('T-0001', 'sam', 'dana').assignee, 'sam');
+    store.transition('T-0001', 'resolved', 'sam');
+    assert.throws(() => store.assign('T-0001', 'li', 'dana'), { code: 'conflict' });
+    assert.throws(() => store.assign('T-0001', null, 'dana'), { code: 'conflict' });
+    assert.throws(() => store.assign('T-0001', 'sam', 'dana'), { code: 'conflict' });
+    store.transition('T-0001', 'closed', 'sam');
+    assert.throws(() => store.assign('T-0001', 'li', 'dana'), { code: 'conflict' });
+    assert.equal(store.get('T-0001').assignee, 'sam');
+  });
+
+  test('a missing ticket is not found', () => {
+    assert.throws(() => open().store.assign('T-0099', 'sam', 'dana'), { code: 'not_found' });
+  });
+
+  test('the assignee is saved in the data file and read back; unassigned tickets add nothing to the file', (t) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    const file = path.join(dir, 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket(input(), 'dana');
+    store.createTicket(input(), 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(document.tickets[0].assignee, 'sam');
+    assert.equal('assignee' in document.tickets[1], false);
+    const again = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.deepEqual(again.list().items.map((ticket) => ticket.assignee), ['sam', null]);
+  });
+});
+
+describe('the assignee filter', () => {
+  const query = (text) => parseListQuery(new URLSearchParams(text));
+
+  test('reads an agent, and an empty value as the unassigned', () => {
+    assert.deepEqual(query('assignee=sam').filters, { assignee: 'sam' });
+    assert.deepEqual(query('assignee=').filters, { assignee: null });
+  });
+
+  test('matches the agent exactly; null matches an unassigned ticket, with or without the field', () => {
+    assert.equal(matchesFilters({ assignee: 'sam' }, { assignee: 'sam' }), true);
+    assert.equal(matchesFilters({ assignee: 'sam' }, { assignee: 'li' }), false);
+    assert.equal(matchesFilters({ assignee: 'sam' }, { assignee: null }), false);
+    assert.equal(matchesFilters({ assignee: null }, { assignee: null }), true);
+    assert.equal(matchesFilters({}, { assignee: null }), true);
+    assert.equal(matchesFilters({}, { assignee: 'sam' }), false);
+  });
+
+  test('a ticket must match every filter given', () => {
+    const ticket = { status: 'open', priority: 'high', assignee: 'sam' };
+    assert.equal(matchesFilters(ticket, { status: 'open', assignee: 'sam' }), true);
+    assert.equal(matchesFilters(ticket, { status: 'closed', assignee: 'sam' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'low' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'high', assignee: 'li' }), false);
+  });
+});
