+describe('PUT /tickets/:id/assignee', () => {
+  const assign = (api, id, assignee, headers) => api.put(`/tickets/${id}/assignee`, { assignee }, headers);
+
+  test('assigns, shows the assignee everywhere and records the actor', async () => {
+    await withService({}, async (api) => {
+      const created = await api.post('/tickets', ticketBody());
+      assert.equal(created.body.assignee, null);
+      const { status, body } = await assign(api, 'T-0001', 'sam', { 'X-Actor': 'dana' });
+      assert.equal(status, 200);
+      assert.equal(body.assignee, 'sam');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'sam');
+      assert.equal((await api.get('/tickets')).body.items[0].assignee, 'sam');
+      const entry = (await api.get('/tickets/T-0001/audit')).body.items.at(-1);
+      assert.deepEqual([entry.action, entry.actor, entry.changes], ['ticket.assigned', 'dana', { assignee: { from: null, to: 'sam' } }]);
+    });
+  });
+
+  test('null unassigns', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      await assign(api, 'T-0001', 'sam');
+      const { status, body } = await assign(api, 'T-0001', null);
+      assert.equal(status, 200);
+      assert.equal(body.assignee, null);
+    });
+  });
+
+  test('assigning the same agent again leaves the ticket and its history as they were', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const first = (await assign(api, 'T-0001', 'sam')).body;
+      const again = await assign(api, 'T-0001', 'sam');
+      assert.equal(again.status, 200);
+      assert.deepEqual(again.body, first);
+      assert.equal((await api.get('/tickets/T-0001/audit')).body.items.length, 2);
+      assert.equal((await api.get('/admin/outbox')).body.pending.filter((event) => event.type === 'ticket.assigned').length, 1);
+    });
+  });
+
+  test('refuses what is not an agent name, naming the field', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const bad = [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 7 }, { assignee: 'x'.repeat(65) }, { assignee: 'sam', extra: 1 }, { assignee: 'a\nb' }];
+      for (const body of bad) {
+        const response = await api.put('/tickets/T-0001/assignee', body);
+        assert.equal(response.status, 400, JSON.stringify(body));
+        assert.equal(response.body.error.code, 'invalid');
+      }
+      assert.equal((await assign(api, 'T-0001', 'x'.repeat(64))).status, 200);
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'x'.repeat(64));
+    });
+  });
+
+  test('is a conflict on resolved and closed tickets, and not found on a missing one', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      await assign(api, 'T-0001', 'sam');
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.equal((await assign(api, 'T-0001', 'li')).status, 200);
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+      for (const assignee of ['sam', 'li', null]) {
+        const response = await assign(api, 'T-0001', assignee);
+        assert.equal(response.status, 409, String(assignee));
+        assert.equal(response.body.error.code, 'conflict');
+      }
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'li');
+      assert.equal((await assign(api, 'T-0404', 'sam')).status, 404);
+    });
+  });
+
+  test('only PUT is answered', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const response = await api.post('/tickets/T-0001/assignee', { assignee: 'sam' });
+      assert.equal(response.status, 404);
+      assert.match(response.body.error.message, /PUT/);
+    });
+  });
+
+  test('queues a notice for each agent assigned to, and none for unassigning', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      await assign(api, 'T-0001', 'sam');
+      await assign(api, 'T-0001', 'li');
+      await assign(api, 'T-0001', null);
+      const pending = (await api.get('/admin/outbox')).body.pending.filter((event) => event.type === 'ticket.assigned');
+      assert.deepEqual(pending.map((event) => event.to), ['sam', 'li']);
+    });
+  });
+});
