+  const ids = async (api, query) => (await api.get(`/tickets${query}`)).body.items.map((ticket) => ticket.id);
+
+  test('keeps the tickets of one agent, or the unassigned ones with an empty value', async () => {
+    await withService(ON, async (api) => {
+      await seeded(api);
+      assert.deepEqual(await ids(api, '?assignee=sam'), ['T-0001', 'T-0002']);
+      assert.deepEqual(await ids(api, '?assignee=lee'), ['T-0003']);
+      assert.deepEqual(await ids(api, '?assignee='), ['T-0004']);
+      assert.deepEqual(await ids(api, '?assignee=nobody'), []);
+    });
+  });
+
+  test('works without ASSIGNEES too', async () => {
+    await withService({}, async (api) => {
+      await seeded(api);
+      assert.deepEqual(await ids(api, '?assignee=sam'), ['T-0001', 'T-0002']);
+      assert.deepEqual(await ids(api, '?assignee='), ['T-0004']);
+    });
+  });
+
+  test('a ticket must match every filter given', async () => {
+    await withService(ON, async (api) => {
+      await seeded(api);
+      assert.deepEqual(await ids(api, '?assignee=sam&status=in_progress'), ['T-0002']);
+      assert.deepEqual(await ids(api, '?assignee=sam&priority=high'), ['T-0001']);
+      assert.deepEqual(await ids(api, '?assignee=&priority=high'), []);
+      assert.deepEqual(await ids(api, '?assignee=&priority=low&status=open'), ['T-0004']);
+      assert.deepEqual(await ids(api, '?status=open&priority=high'), ['T-0001', 'T-0003']);
+    });
+  });
+
+  test('pages with cursors', async () => {
+    await withService(ON, async (api) => {
+      await seeded(api);
+      const first = (await api.get('/tickets?assignee=sam&limit=1')).body;
+      assert.deepEqual(first.items.map((ticket) => ticket.id), ['T-0001']);
+      const second = (await api.get(`/tickets?assignee=sam&limit=1&cursor=${first.next}`)).body;
+      assert.deepEqual(second.items.map((ticket) => ticket.id), ['T-0002']);
+      assert.equal(second.next, null);
+    });
+  });
+});
