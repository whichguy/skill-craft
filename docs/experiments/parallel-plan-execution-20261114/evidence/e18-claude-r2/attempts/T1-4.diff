+describe('the command line', () => {
+  function run(argv, dataFile) {
+    let out = '';
+    let err = '';
+    const code = main(['--data', dataFile, ...argv], { env: {}, out: { write: (s) => { out += s; } }, err: { write: (s) => { err += s; } } });
+    return { code, out, err };
+  }
+
+  function seed(t) {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    const store = new TicketStore({ clock: manualClock(START), persistence: createPersistence(dataFile) });
+    store.createTicket(input({ title: 'First' }), 'system');
+    store.createTicket(input({ title: 'Second' }), 'system');
+    store.assign('T-0001', 'sam', 'dana');
+    return dataFile;
+  }
+
+  test('list shows each ticket\'s assignee, - when there is none', (t) => {
+    const { code, out } = run(['list'], seed(t));
+    assert.equal(code, 0);
+    const [header, first, second] = out.trimEnd().split('\n');
+    assert.match(header, /ASSIGNEE/);
+    assert.match(first, /T-0001\s+open\s+normal\s+li@example\.com\s+sam\s/);
+    assert.match(second, /T-0002\s+open\s+normal\s+li@example\.com\s+-\s/);
+  });
+
+  test('list --raw keeps its first four columns and adds the assignee after them', (t) => {
+    const { out } = run(['list', '--raw'], seed(t));
+    assert.deepEqual(out.split('\n').filter((line) => line !== '').map((line) => line.split('\t')), [
+      ['T-0001', 'open', 'normal', 'First', 'sam'],
+      ['T-0002', 'open', 'normal', 'Second', ''],
+    ]);
+  });
+
+  test('list --assignee filters like the API', (t) => {
+    const dataFile = seed(t);
+    assert.deepEqual(run(['list', '--raw', '--assignee', 'sam'], dataFile).out.trimEnd().split('\n').map((l) => l.split('\t')[0]), ['T-0001']);
+    assert.deepEqual(run(['list', '--raw', '--assignee', ''], dataFile).out.trimEnd().split('\n').map((l) => l.split('\t')[0]), ['T-0002']);
+  });
+
+  test('show prints the assignee', (t) => {
+    assert.match(run(['show', 'T-0001'], seed(t)).out, /assignee\s+sam/);
+  });
+
+  test('format helpers handle a ticket with no assignee', () => {
+    assert.equal(rawLine({ id: 'T-1', status: 'open', priority: 'low', title: 'x' }), 'T-1\topen\tlow\tx\t');
+    assert.match(table([{ id: 'T-1', status: 'open', priority: 'low', requester: 'r', updated: START, title: 'x' }]), /-\s/);
+  });
+});
