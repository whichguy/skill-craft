+      assert.equal(assigned.body.assignee, 'sam');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'sam');
+      assert.equal((await api.get('/tickets')).body.items[0].assignee, 'sam');
+      const unassigned = await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.equal(unassigned.status, 200);
+      assert.equal(unassigned.body.assignee, null);
+      const audit = (await api.get('/tickets/T-0001/audit')).body.items;
+      assert.deepEqual(audit.slice(1).map((entry) => [entry.action, entry.actor]), [['ticket.assigned', 'dana'], ['ticket.assigned', 'system']]);
+    });
+  });
+
+  test('shows the assignee without ASSIGNEES once a ticket has had one', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      await api.post('/tickets', ticketBody());
+      assert.equal('assignee' in (await api.get('/tickets/T-0001')).body, false);
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'sam' })).body.assignee, 'sam');
+      const [first, second] = (await api.get('/tickets')).body.items;
+      assert.equal(first.assignee, 'sam');
