+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assignee-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+describe('the ASSIGNEES setting', () => {
+  test('is off by default and on only when it is "on"', () => {
+    assert.equal(loadConfig({}).assignees, false);
+    assert.equal(loadConfig({ ASSIGNEES: 'on' }).assignees, true);
+    for (const value of ['', 'off', '1', 'true', 'ON']) assert.equal(loadConfig({ ASSIGNEES: value }).assignees, false, value);
+  });
+});
+
+describe('validate.assignee', () => {
+  test('takes an agent name or null', () => {
+    assert.equal(validate.assignee({ assignee: 'sam' }), 'sam');
+    assert.equal(validate.assignee({ assignee: null }), null);
+    assert.equal(validate.assignee({ assignee: 'a'.repeat(64) }), 'a'.repeat(64));
+  });
+
+  test('refuses anything else', () => {
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 'a'.repeat(65) }, { assignee: 7 }, { assignee: ['sam'] },
+      { assignee: 'sam\nlee' }, { assignee: 'sam', extra: 1 }]) {
+      assert.throws(() => validate.assignee(body), InvalidError, JSON.stringify(body));
+    }
+  });
+});
+
