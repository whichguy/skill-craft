+describe('TicketStore.assign', () => {
+  function setup(options = {}) {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock, ...options });
+    store.createTicket(input(), 'system');
+    return { clock, store };
+  }
+
+  test('assigns, audits the change and tells the agent', () => {
+    const { clock, store } = setup(ON);
+    clock.advance(1000);
+    const ticket = store.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.assignee, 'sam');
+    assert.equal(ticket.updated, '2025-09-01T08:00:01.000Z');
+    const entry = store.history('T-0001')[1];
+    assert.deepEqual([entry.action, entry.actor, entry.changes], ['ticket.assigned', 'dana', { assignee: { from: null, to: 'sam' } }]);
+    const pending = store.outboxReport().pending;
+    assert.deepEqual(pending.map((event) => [event.type, event.to, event.ticket]), [
+      ['ticket.created', 'li@example.com', 'T-0001'],
+      ['ticket.assigned', 'sam', 'T-0001'],
+    ]);
+  });
+
+  test('assigning the agent a ticket already has changes nothing', () => {
+    const { clock, store } = setup(ON);
+    store.assign('T-0001', 'sam', 'dana');
+    clock.advance(1000);
+    const before = store.get('T-0001');
+    assert.deepEqual(store.assign('T-0001', 'sam', 'dana'), before);
+    assert.equal(store.history('T-0001').length, 2);
+    assert.equal(store.outboxReport().pending.length, 2);
+  });
+
+  test('reassigning notifies the new agent, and unassigning notifies nobody', () => {
+    const { store } = setup(ON);
+    store.assign('T-0001', 'sam', 'dana');
+    store.assign('T-0001', 'lee', 'dana');
+    assert.deepEqual(store.history('T-0001')[2].changes, { assignee: { from: 'sam', to: 'lee' } });
+    store.assign('T-0001', null, 'dana');
+    assert.equal(store.get('T-0001').assignee, null);
+    assert.deepEqual(store.history('T-0001')[3].changes, { assignee: { from: 'lee', to: null } });
+    assert.deepEqual(store.outboxReport().pending.map((event) => event.to), ['li@example.com', 'sam', 'lee']);
+  });
+
+  test('unassigning a ticket nobody has changes nothing', () => {
+    const { store } = setup(ON);
+    assert.equal(store.assign('T-0001', null, 'dana').assignee, null);
+    assert.equal(store.history('T-0001').length, 1);
+  });
+
+  test('only an open or in-progress ticket can be assigned or unassigned', () => {
+    const { store } = setup(ON);
+    store.assign('T-0001', 'sam', 'dana');
+    store.transition('T-0001', 'in_progress', 'sam');
+    assert.equal(store.assign('T-0001', 'lee', 'dana').assignee, 'lee');
+    store.transition('T-0001', 'resolved', 'sam');
+    for (const to of ['kim', 'lee', null]) assert.throws(() => store.assign('T-0001', to, 'dana'), { name: 'ConflictError' }, String(to));
+    store.transition('T-0001', 'closed', 'sam');
+    assert.throws(() => store.assign('T-0001', 'kim', 'dana'), { name: 'ConflictError' });
+    assert.equal(store.get('T-0001').assignee, 'lee');
+  });
+
+  test('a ticket nobody was assigned to has no assignee unless ASSIGNEES is on', () => {
+    const { store } = setup();
+    assert.equal('assignee' in store.get('T-0001'), false);
+    store.assign('T-0001', 'sam', 'dana');
+    assert.equal(store.get('T-0001').assignee, 'sam');
+    store.assign('T-0001', null, 'dana');
+    assert.equal(store.get('T-0001').assignee, null, 'null once it has had one');
+    assert.equal(setup(ON).store.get('T-0001').assignee, null);
+  });
+
+  test('the worker delivers the notification to the agent', () => {
+    const { clock, store } = setup(ON);
+    store.assign('T-0001', 'sam', 'dana');
+    const notifier = createNotifier({ clock });
+    const worker = new Worker({ intervalMs: 0, jobs: [deliverOutbox({ store, notifier, log: silentLogger })], log: silentLogger });
+    worker.tick();
+    const message = notifier.delivered.find((line) => line.type === 'ticket.assigned');
+    assert.equal(message.to, 'sam');
+    assert.equal(message.ticket, 'T-0001');
+    assert.match(message.subject, /T-0001/);
+    assert.match(message.body, /assigned to you/);
+    assert.equal(store.outboxReport().dead.length, 0);
+  });
+});
