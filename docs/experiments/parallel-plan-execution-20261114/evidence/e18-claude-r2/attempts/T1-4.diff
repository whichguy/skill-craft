+
+  test('refuses a bad body with 400, and unknown tickets with 404', async () => {
+    await withService(ON, async (api) => {
+      await api.post('/tickets', ticketBody());
+      for (const body of [{}, { assignee: '' }, { assignee: 'a'.repeat(65) }, { assignee: 3 }, { assignee: 'sam', note: 'x' }, []]) {
+        const response = await api.put('/tickets/T-0001/assignee', body);
+        assert.equal(response.status, 400, JSON.stringify(body));
+        assert.equal(response.body.error.code, 'invalid');
+      }
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, null);
