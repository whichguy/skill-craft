+  const query = (text) => parseListQuery(new URLSearchParams(text));
+
+  test('reads assignee=<agent>, and an empty assignee= as the unassigned', () => {
+    assert.deepEqual(query('assignee=sam').filters, { assignee: 'sam' });
+    assert.deepEqual(query('assignee=').filters, { assignee: null });
+  });
+
+  test('matchesFilters needs every filter given to match', () => {
+    const ticket = { id: 'T-0001', status: 'open', priority: 'high', assignee: 'sam' };
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'high' }), true);
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'low' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'closed', priority: 'high' }), false);
+    assert.equal(matchesFilters(ticket, { assignee: 'sam', status: 'open' }), true);
+    assert.equal(matchesFilters(ticket, { assignee: 'lee', status: 'open' }), false);
+    assert.equal(matchesFilters(ticket, { assignee: null }), false);
+  });
+
+  test('a ticket with no assignee is unassigned', () => {
+    assert.equal(matchesFilters({ id: 'T-0001' }, { assignee: null }), true);
+    assert.equal(matchesFilters({ id: 'T-0001', assignee: null }, { assignee: null }), true);
+    assert.equal(matchesFilters({ id: 'T-0001' }, { assignee: 'sam' }), false);
+  });
+});
