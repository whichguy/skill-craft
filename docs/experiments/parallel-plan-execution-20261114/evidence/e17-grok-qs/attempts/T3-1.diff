+    const as14 = document.tickets.map(({ id, title, priority, requester, status, created, updated }) => (
+      { id, title, priority, requester, status, created, updated }
+    ));
+    assert.deepEqual(as14.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+    assert.equal(as14[0].title, 'VPN drops');
+    assert.equal(as14[0].due, undefined);
+    const clock = manualClock();
+    const rolledBack = new TicketStore({
+      clock,
+      state: { nextNumber: document.nextNumber, tickets: as14, audit: document.audit, outbox: document.outbox },
+    });
+    assert.equal(rolledBack.get('T-0001').status, 'in_progress');
+    assert.equal(rolledBack.get('T-0002').priority, 'low');
