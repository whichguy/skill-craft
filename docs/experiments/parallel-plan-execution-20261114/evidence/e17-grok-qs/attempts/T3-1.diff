diff --git a/src/tickets/due.js b/src/tickets/due.js
new file mode 100644
index 0000000..b8f61eb
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,35 @@
+'use strict';
+
+const { isActive } = require('./states');
+
+/**
+ * Response hours by priority (docs/api.md, "The ticket"). Operators change them with RESPONSE_HOURS_* environment
+ * variables; a ticket's due time is computed once and then kept.
+ */
+
+const DEFAULT_DUE_HOURS = Object.freeze({
+  urgent: 4,
+  high: 24,
+  normal: 72,
+  low: 168,
+});
+
+const MS_PER_HOUR = 60 * 60 * 1000;
+
+/** ISO time `hours` after `created`. `hours` is the map of priority → hours. */
+function computeDue(created, priority, hours = DEFAULT_DUE_HOURS) {
+  const value = hours[priority];
+  return new Date(Date.parse(created) + value * MS_PER_HOUR).toISOString();
+}
+
+/**
+ * Whether `ticket` is still being worked and its due time is before `now`. Resolved and closed tickets are never
+ * overdue, even when their due time has passed.
+ */
+function isOverdue(ticket, now) {
+  if (!ticket.due || !isActive(ticket.status)) return false;
+  const at = now instanceof Date ? now.getTime() : Date.parse(now);
+  return at > Date.parse(ticket.due);
+}
+
+module.exports = { DEFAULT_DUE_HOURS, computeDue, isOverdue };
