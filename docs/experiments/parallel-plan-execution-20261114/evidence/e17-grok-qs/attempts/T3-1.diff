diff --git a/test/due.test.js b/test/due.test.js
new file mode 100644
index 0000000..18fe57b
--- /dev/null
+++ b/test/due.test.js
@@ -0,0 +1,41 @@
+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const { DEFAULT_DUE_HOURS, computeDue, isOverdue } = require('../src/tickets/due');
+
+const CREATED = '2025-09-01T08:00:00.000Z';
+
+describe('computeDue', () => {
+  test('adds the response hours for each priority to the created time', () => {
+    assert.equal(computeDue(CREATED, 'urgent'), '2025-09-01T12:00:00.000Z');
+    assert.equal(computeDue(CREATED, 'high'), '2025-09-02T08:00:00.000Z');
+    assert.equal(computeDue(CREATED, 'normal'), '2025-09-04T08:00:00.000Z');
+    assert.equal(computeDue(CREATED, 'low'), '2025-09-08T08:00:00.000Z');
+  });
+
+  test('uses the hours given, so operators can change them without a code change', () => {
+    const hours = { ...DEFAULT_DUE_HOURS, urgent: 1, normal: 48 };
+    assert.equal(computeDue(CREATED, 'urgent', hours), '2025-09-01T09:00:00.000Z');
+    assert.equal(computeDue(CREATED, 'normal', hours), '2025-09-03T08:00:00.000Z');
+    assert.equal(computeDue(CREATED, 'high', hours), '2025-09-02T08:00:00.000Z');
+  });
+});
+
+describe('isOverdue', () => {
+  const due = '2025-09-01T12:00:00.000Z';
+  const open = { status: 'open', due };
+  const inProgress = { status: 'in_progress', due };
+
+  test('an open or in-progress ticket is overdue only after its due time', () => {
+    assert.equal(isOverdue(open, '2025-09-01T11:59:59.999Z'), false);
+    assert.equal(isOverdue(open, due), false);
+    assert.equal(isOverdue(open, '2025-09-01T12:00:00.001Z'), true);
+    assert.equal(isOverdue(inProgress, '2025-09-01T12:00:00.001Z'), true);
+  });
+
+  test('resolved and closed tickets are not overdue, even after the due time', () => {
+    assert.equal(isOverdue({ status: 'resolved', due }, '2025-09-02T00:00:00.000Z'), false);
+    assert.equal(isOverdue({ status: 'closed', due }, '2025-09-02T00:00:00.000Z'), false);
+  });
+});
