+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { details, rawLine, table } = require('../src/format');
+
+const ticket = {
+  id: 'T-0001',
+  title: 'VPN drops',
+  status: 'open',
+  priority: 'high',
+  requester: 'maria@example.com',
+  assignee: 'dana',
+  created: '2025-09-01T08:15:00.000Z',
+  updated: '2025-09-01T09:02:00.000Z',
+};
+
+test('the list table and raw lines show the assignee', () => {
+  assert.match(table([ticket]), /ASSIGNEE/);
+  assert.match(table([ticket]), /dana/);
+  assert.match(table([{ ...ticket, assignee: null }]), /-/);
+  assert.equal(rawLine(ticket), 'T-0001\topen\thigh\tVPN drops\tdana');
+  assert.equal(rawLine({ ...ticket, assignee: null }), 'T-0001\topen\thigh\tVPN drops\t');
+});
+
+test('details include the assignee', () => {
+  const text = details(ticket, []);
+  assert.match(text, /assignee\s+dana/);
+  assert.match(details({ ...ticket, assignee: null }, []), /assignee\s+-/);
+});
