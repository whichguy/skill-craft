+
+  test('unassigns a ticket and does not notify', () => {
+    const { store: tickets } = store();
+    tickets.create(input(), 'dana');
+    tickets.assign('T-0001', 'sam', 'dana');
+    const pendingBefore = tickets.outboxReport().pending.length;
+    const cleared = tickets.assign('T-0001', null, 'dana');
+    assert.equal(cleared.assignee, null);
