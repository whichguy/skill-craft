diff --git a/test/import.test.js b/test/import.test.js
new file mode 100644
index 0000000..48acdec
--- /dev/null
+++ b/test/import.test.js
@@ -0,0 +1,106 @@
+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { IMPORT_LIMIT } = require('../src/tickets/validate');
+const { ticketBody, withService } = require('./helpers');
+
+const envelope = (response, status, code) => {
+  assert.equal(response.status, status, JSON.stringify(response.body));
+  assert.equal(response.body.error.code, code);
+  assert.equal(typeof response.body.error.message, 'string');
+};
+
+describe('POST /tickets/import', () => {
+  test('creates every ticket in order and answers 201 with their ids', async () => {
+    await withService({}, async (api) => {
+      const { status, body } = await api.post('/tickets/import', {
+        tickets: [
+          ticketBody({ title: 'VPN drops', priority: 'high' }),
+          ticketBody({ title: 'Badge reader', requester: 'li@example.com' }),
+        ],
+      }, { 'X-Actor': 'dana' });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 2, ids: ['T-0001', 'T-0002'] });
+      const first = (await api.get('/tickets/T-0001')).body;
+      assert.equal(first.title, 'VPN drops');
+      assert.equal(first.priority, 'high');
+      assert.equal(first.status, 'open');
+      assert.equal((await api.get('/tickets/T-0002')).body.priority, 'normal');
+      const history = (await api.get('/tickets/T-0001/audit')).body.items;
+      assert.equal(history[0].action, 'ticket.created');
+      assert.equal(history[0].actor, 'dana');
+      const outbox = (await api.get('/admin/outbox')).body;
+      assert.deepEqual(outbox.pending.map((event) => [event.type, event.to, event.ticket]), [
+        ['ticket.created', 'maria@example.com', 'T-0001'],
+        ['ticket.created', 'li@example.com', 'T-0002'],
+      ]);
+    });
+  });
+
+  test('an empty import succeeds and creates nothing', async () => {
+    await withService({}, async (api) => {
+      const { status, body } = await api.post('/tickets/import', { tickets: [] });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 0, ids: [] });
+      assert.equal((await api.get('/tickets')).body.items.length, 0);
+    });
+  });
+
+  test('creates none when any item is invalid and names the first by its index', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const response = await api.post('/tickets/import', {
+        tickets: [ticketBody({ title: 'Good' }), ticketBody({ title: '' }), ticketBody({ title: 'Also' })],
+      });
+      envelope(response, 400, 'invalid');
+      assert.match(response.body.error.message, /tickets\[1\]/);
+      envelope(await api.get('/tickets/T-0002'), 404, 'not_found');
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+      const outbox = (await api.get('/admin/outbox')).body;
+      assert.equal(outbox.pending.length, 2, 'the failed import enqueued no notifications');
+    });
+  });
+
+  test('answers 400 when the body is not an import', async () => {
+    await withService({}, async (api) => {
+      envelope(await api.post('/tickets/import', {}), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: 'nope' }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [ticketBody()], extra: 1 }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [null] }), 400, 'invalid');
+      const tooMany = await api.post('/tickets/import', {
+        tickets: Array.from({ length: IMPORT_LIMIT + 1 }, () => ticketBody({ title: 'x' })),
+      });
+      envelope(tooMany, 400, 'invalid');
+      assert.match(tooMany.body.error.message, /5000/);
+      envelope(await api.get('/tickets/T-0001'), 404, 'not_found');
+    });
+  });
+
+  test('an import of 5000 tickets is answered within 10 seconds', async (t) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-import-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    await withService({ dataFile: path.join(dir, 'tickets.json') }, async (api) => {
+      const tickets = Array.from({ length: 5000 }, (_, i) => ({
+        title: `Old tracker ${i}`,
+        requester: 'move@example.com',
+      }));
+      const started = Date.now();
+      const { status, body } = await api.post('/tickets/import', { tickets });
+      const ms = Date.now() - started;
+      assert.equal(status, 201, JSON.stringify(body && { created: body.created, error: body.error }).slice(0, 300));
+      assert.equal(body.created, 5000);
+      assert.equal(body.ids[0], 'T-0001');
+      assert.equal(body.ids[4999], 'T-5000');
+      assert.ok(ms < 10_000, `import took ${ms}ms`);
+      assert.equal((await api.get('/tickets/T-5000')).body.title, 'Old tracker 4999');
+      assert.equal((await api.get('/admin/outbox')).body.pending.length, 5000);
+      const page = await api.get('/tickets');
+      assert.equal(page.body.items.length, 20);
+      assert.equal(page.body.items[0].id, 'T-0001');
+    });
+  });
+});
