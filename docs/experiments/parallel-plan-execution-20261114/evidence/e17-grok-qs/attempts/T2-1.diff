+/** POST /tickets/import: { tickets: [ newTicket, ... ] }, at most IMPORT_LIMIT. Names the first bad item by index. */
+function ticketImport(body) {
+  onlyFields(body, ['tickets']);
+  if (!Object.hasOwn(body, 'tickets')) throw new InvalidError('tickets is required');
+  if (!Array.isArray(body.tickets)) throw new InvalidError('tickets must be a list');
+  if (body.tickets.length > IMPORT_LIMIT) {
+    throw new InvalidError(`tickets must be at most ${IMPORT_LIMIT}, not ${body.tickets.length}`);
+  }
+  return body.tickets.map((item, index) => {
+    if (item === null || typeof item !== 'object' || Array.isArray(item)) {
+      throw new InvalidError(`tickets[${index}] must be a JSON object`);
+    }
+    try {
+      return newTicket(item);
+    } catch (error) {
+      if (error instanceof InvalidError) throw new InvalidError(`tickets[${index}]: ${error.message}`);
+      throw error;
+    }
+  });
+}
