--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,30 @@
+'use strict';
+
+const { isActive } = require('./states');
+
+/**
+ * Hours from creation until a ticket is due, by priority. Operators change these with DUE_HOURS_* (src/config.js)
+ * without a code change; a ticket already given a due time does not move when the hours do.
+ */
+const DEFAULT_DUE_HOURS = Object.freeze({
+  urgent: 4,
+  high: 24,
+  normal: 72,
+  low: 168,
+});
+
+const HOUR_MS = 60 * 60 * 1000;
+
+/** The due time of a ticket created at `created` with `priority`, as ISO 8601 UTC. */
+function dueTime(created, priority, hours = DEFAULT_DUE_HOURS) {
+  return new Date(Date.parse(created) + hours[priority] * HOUR_MS).toISOString();
+}
+
+/** Whether `ticket` is still being worked and its due time is before `now` (a Date or ISO string). */
+function isOverdue(ticket, now) {
+  if (!isActive(ticket.status) || ticket.due == null || now == null) return false;
+  const nowIso = typeof now === 'string' ? now : now.toISOString();
+  return ticket.due < nowIso;
+}
+
+module.exports = { DEFAULT_DUE_HOURS, dueTime, isOverdue };
