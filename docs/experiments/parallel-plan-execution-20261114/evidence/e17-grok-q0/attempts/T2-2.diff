diff --git a/test/import.test.js b/test/import.test.js
new file mode 100644
index 0000000..8e6bb68
--- /dev/null
+++ b/test/import.test.js
@@ -0,0 +1,124 @@
+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { IMPORT_LIMIT } = require('../src/tickets/validate');
+const { ticketBody, withService } = require('./helpers');
+
+const envelope = (response, status, code) => {
+  assert.equal(response.status, status, JSON.stringify(response.body));
+  assert.equal(response.body.error.code, code);
+  assert.equal(typeof response.body.error.message, 'string');
+};
+
+describe('POST /tickets/import', () => {
+  test('creates every ticket in order and answers 201 with the new ids', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const { status, body } = await api.post('/tickets/import', {
+        tickets: [
+          ticketBody({ title: 'VPN drops', priority: 'high' }),
+          ticketBody({ title: 'Printer jams', requester: 'li@example.com' }),
+        ],
+      });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 2, ids: ['T-0002', 'T-0003'] });
+      assert.equal((await api.get('/tickets/T-0002')).body.title, 'VPN drops');
+      assert.equal((await api.get('/tickets/T-0002')).body.priority, 'high');
+      assert.equal((await api.get('/tickets/T-0003')).body.requester, 'li@example.com');
+      assert.equal((await api.get('/tickets/T-0003')).body.priority, 'normal');
+      assert.equal((await api.get('/tickets/T-0003')).body.status, 'open');
+    });
+  });
+
+  test('records each ticket and notifies its requester as a single create does', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets/import', {
+        tickets: [ticketBody({ requester: 'a@example.com' }), ticketBody({ requester: 'b@example.com' })],
+      }, { 'X-Actor': 'dana' });
+      const history = (await api.get('/tickets/T-0001/audit')).body.items;
+      assert.equal(history.length, 1);
+      assert.equal(history[0].action, 'ticket.created');
+      assert.equal(history[0].actor, 'dana');
+      assert.deepEqual(history[0].changes.status, { from: null, to: 'open' });
+      const pending = (await api.get('/admin/outbox')).body.pending;
+      assert.deepEqual(pending.map((event) => [event.type, event.to, event.ticket]), [
+        ['ticket.created', 'a@example.com', 'T-0001'],
+        ['ticket.created', 'b@example.com', 'T-0002'],
+      ]);
+    });
+  });
+
+  test('answers 400 naming the first invalid item and creates none of them', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const response = await api.post('/tickets/import', {
+        tickets: [ticketBody({ title: 'Good' }), ticketBody({ title: '' }), ticketBody({ title: 'Also' })],
+      });
+      envelope(response, 400, 'invalid');
+      assert.match(response.body.error.message, /tickets\[1\]/);
+      assert.deepEqual((await api.get('/tickets')).body.items.map((ticket) => ticket.id), ['T-0001']);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+    });
+  });
+
+  test('refuses a body that is not a tickets array, unknown fields, or more than the limit', async () => {
+    await withService({}, async (api) => {
+      envelope(await api.post('/tickets/import', { ticket: ticketBody() }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: ticketBody() }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [ticketBody()], extra: true }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [null] }), 400, 'invalid');
+      const tooMany = Array.from({ length: IMPORT_LIMIT + 1 }, () => ({ title: 't', requester: 'r' }));
+      const over = await api.post('/tickets/import', { tickets: tooMany });
+      envelope(over, 400, 'invalid');
+      assert.match(over.body.error.message, /5000/);
+      assert.equal((await api.get('/tickets')).body.items.length, 0);
+    });
+  });
+
+  test('an empty list creates nothing', async () => {
+    await withService({}, async (api) => {
+      const { status, body } = await api.post('/tickets/import', { tickets: [] });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 0, ids: [] });
+    });
+  });
+
+  test('imported tickets are in the data file after a restart', async (t) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-import-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    const dataFile = path.join(dir, 'tickets.json');
+    await withService({ dataFile }, async (api) => {
+      const { body } = await api.post('/tickets/import', {
+        tickets: [ticketBody({ title: 'One' }), ticketBody({ title: 'Two' })],
+      });
+      assert.deepEqual(body, { created: 2, ids: ['T-0001', 'T-0002'] });
+    });
+    await withService({ dataFile }, async (api) => {
+      assert.equal((await api.get('/tickets/T-0002')).body.title, 'Two');
+      assert.equal((await api.get('/tickets/T-0001/audit')).body.items[0].action, 'ticket.created');
+      assert.equal((await api.get('/admin/outbox')).body.pending.length, 2);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0003');
+    });
+  });
+
+  test('imports 5000 tickets within 10 seconds', { timeout: 15_000 }, async () => {
+    await withService({}, async (api) => {
+      const tickets = Array.from({ length: IMPORT_LIMIT }, (_, i) => ({ title: `Issue ${i}`, requester: 'a@b.co' }));
+      const started = Date.now();
+      const { status, body } = await api.post('/tickets/import', { tickets });
+      const elapsed = Date.now() - started;
+      assert.equal(status, 201, JSON.stringify(body && { created: body.created, error: body.error }));
+      assert.equal(body.created, IMPORT_LIMIT);
+      assert.equal(body.ids.length, IMPORT_LIMIT);
+      assert.equal(body.ids[0], 'T-0001');
+      assert.equal(body.ids.at(-1), 'T-5000');
+      assert.ok(elapsed < 10_000, `import took ${elapsed}ms`);
+      assert.equal((await api.get('/tickets/T-5000')).body.title, 'Issue 4999');
+      assert.equal((await api.get('/admin/outbox')).body.pending.length, IMPORT_LIMIT);
+    });
+  });
+});
