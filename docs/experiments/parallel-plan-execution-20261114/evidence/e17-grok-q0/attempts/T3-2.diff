diff --git a/test/due.test.js b/test/due.test.js
new file mode 100644
index 0000000..442308c
--- /dev/null
+++ b/test/due.test.js
@@ -0,0 +1,35 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { DEFAULT_DUE_HOURS, dueTime, isOverdue } = require('../src/tickets/due');
+
+const created = '2025-09-01T08:00:00.000Z';
+
+test('default hours are 4, 24, 72 and 168 by priority', () => {
+  assert.deepEqual(DEFAULT_DUE_HOURS, { urgent: 4, high: 24, normal: 72, low: 168 });
+});
+
+test('due is created plus the hours for the priority', () => {
+  assert.equal(dueTime(created, 'urgent'), '2025-09-01T12:00:00.000Z');
+  assert.equal(dueTime(created, 'high'), '2025-09-02T08:00:00.000Z');
+  assert.equal(dueTime(created, 'normal'), '2025-09-04T08:00:00.000Z');
+  assert.equal(dueTime(created, 'low'), '2025-09-08T08:00:00.000Z');
+});
+
+test('operators can change the hours without a code change', () => {
+  const hours = { urgent: 1, high: 2, normal: 3, low: 4 };
+  assert.equal(dueTime(created, 'urgent', hours), '2025-09-01T09:00:00.000Z');
+  assert.equal(dueTime(created, 'low', hours), '2025-09-01T12:00:00.000Z');
+});
+
+test('a ticket is overdue only while it is open or in progress and its due time has passed', () => {
+  const now = '2025-09-01T12:00:01.000Z';
+  const due = '2025-09-01T12:00:00.000Z';
+  assert.equal(isOverdue({ status: 'open', due }, now), true);
+  assert.equal(isOverdue({ status: 'in_progress', due }, now), true);
+  assert.equal(isOverdue({ status: 'resolved', due }, now), false);
+  assert.equal(isOverdue({ status: 'closed', due }, now), false);
+  assert.equal(isOverdue({ status: 'open', due }, due), false, 'exactly at due the time has not yet passed');
+  assert.equal(isOverdue({ status: 'open', due: '2025-09-02T08:00:00.000Z' }, now), false);
+});
diff --git a/test/persistence.test.js b/test/persistence.test.js
