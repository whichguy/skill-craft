@@ -115,4 +115,54 @@ describe('a file the service cannot use is refused', () => {
   test('an outbox event in no known state', (t) => {
     refused(t, (document) => { document.outbox.events[0].status = 'lost'; }, /outbox\.events\[0\]\.status/);
   });
+
+  test('a ticket with a due that is not a time', (t) => {
+    refused(t, (document) => { document.tickets[0].due = 'soon'; }, /tickets\[0\]\.due is not a time/);
+  });
+});
+
+describe('due times in the data file', () => {
+  test('are written while the file stays at version 1, so 1.4.0 can still load it', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    savedStore(file);
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(document.version, 1);
+    for (const ticket of document.tickets) {
+      for (const field of ['id', 'title', 'priority', 'requester', 'status', 'created', 'updated']) {
+        assert.equal(typeof ticket[field], 'string', field);
+      }
+      assert.equal(typeof ticket.due, 'string');
+    }
+    const as14 = { ...document, tickets: document.tickets.map(({ due, ...ticket }) => ticket) };
+    assert.equal(as14.version, 1);
+    assert.equal(as14.tickets.length, document.tickets.length);
+    fs.writeFileSync(file, `${JSON.stringify(as14, null, 2)}\n`);
+    const loaded = createPersistence(file).load();
+    assert.equal(loaded.tickets.length, 2);
+    assert.equal(loaded.tickets[0].id, 'T-0001');
+  });
+
+  test('tickets already in the file get a due time from created and priority and keep it', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    const first = new TicketStore({ clock });
+    first.create({ title: 'VPN drops', requester: 'maria@example.com', priority: 'high' }, 'dana');
+    const state = first.snapshot();
+    for (const ticket of state.tickets) delete ticket.due;
+    const persistence = createPersistence(file, { clock });
+    persistence.save(state);
+    assert.equal('due' in JSON.parse(fs.readFileSync(file, 'utf8')).tickets[0], false);
+
+    const again = TicketStore.open({ clock, persistence, dueTimesEnabled: true });
+    assert.equal(again.get('T-0001').due, '2025-09-02T08:00:00.000Z');
+    assert.equal(JSON.parse(fs.readFileSync(file, 'utf8')).tickets[0].due, '2025-09-02T08:00:00.000Z');
+
+    const later = TicketStore.open({
+      clock,
+      persistence,
+      dueTimesEnabled: true,
+      dueHours: { urgent: 1, high: 1, normal: 1, low: 1 },
+    });
+    assert.equal(later.get('T-0001').due, '2025-09-02T08:00:00.000Z');
+  });
 });
