+        const { status, body } = await api.post('/tickets', ticketBody({ priority, title: priority }));
+        assert.equal(status, 201);
+        assert.equal(body.due, due);
+        assert.equal(body.created, '2025-09-01T08:00:00.000Z');
+        assert.equal((await api.get(`/tickets/${body.id}`)).body.due, due);
+      }
+    });
+  });
+
+  test('a later priority change does not move due', async () => {
+    await withService({ dueTimes: true }, async (api) => {
+      const { body: created } = await api.post('/tickets', ticketBody({ priority: 'normal' }));
+      const { body: updated } = await api.patch('/tickets/T-0001', { priority: 'urgent' });
+      assert.equal(updated.due, created.due);
+      assert.equal(updated.due, '2025-09-04T08:00:00.000Z');
+    });
+  });
+
+  test('uses the configured hours', async () => {
+    await withService({ dueTimes: true, dueHours: { urgent: 1, high: 2, normal: 3, low: 4 } }, async (api) => {
+      const { body } = await api.post('/tickets', ticketBody({ priority: 'high' }));
+      assert.equal(body.due, '2025-09-01T10:00:00.000Z');
+    });
+  });
+
+  test('GET /tickets?overdue=true lists open and in-progress tickets past due', async () => {
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    await withService({ dueTimes: true, clock }, async (api) => {
+      await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      await api.post('/tickets', ticketBody({ priority: 'low' }));
+      await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+      await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      for (const to of ['in_progress', 'resolved']) await api.post('/tickets/T-0004/transition', { to });
+      clock.set('2025-09-01T12:00:01.000Z');
+      const { status, body } = await api.get('/tickets?overdue=true');
+      assert.equal(status, 200);
+      assert.deepEqual(ids({ body }), ['T-0001', 'T-0003']);
+      envelope(await api.get('/tickets?overdue=false'), 400, 'invalid');
+    });
+  });
+});
