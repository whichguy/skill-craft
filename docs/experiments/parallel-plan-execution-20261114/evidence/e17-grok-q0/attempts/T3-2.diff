+  }
+
+  test('sets due from created plus the hours for the priority', () => {
+    const { store: tickets } = dueStore();
+    assert.equal(tickets.create(input({ priority: 'urgent' }), 'dana').due, '2025-09-01T12:00:00.000Z');
+    assert.equal(tickets.create(input({ priority: 'high' }), 'dana').due, '2025-09-02T08:00:00.000Z');
+    assert.equal(tickets.create(input({ priority: 'normal' }), 'dana').due, '2025-09-04T08:00:00.000Z');
+    assert.equal(tickets.create(input({ priority: 'low' }), 'dana').due, '2025-09-08T08:00:00.000Z');
+  });
+
+  test('omits due from reads until due times are enabled, but still stores it', () => {
+    const { store: tickets } = store();
+    const created = tickets.create(input({ priority: 'urgent' }), 'dana');
+    assert.equal(Object.hasOwn(created, 'due'), false);
+    assert.equal(Object.hasOwn(tickets.get('T-0001'), 'due'), false);
+    assert.equal(tickets.snapshot().tickets[0].due, '2025-09-01T12:00:00.000Z');
+  });
+
+  test('a later change of priority or hours does not move due', () => {
+    const { store: tickets } = dueStore();
+    const created = tickets.create(input({ priority: 'normal' }), 'dana');
+    const updated = tickets.update('T-0001', { priority: 'urgent' }, 'sam');
+    assert.equal(updated.due, created.due);
+    const again = new TicketStore({
+      clock: manualClock('2025-09-01T08:00:00.000Z'),
+      state: JSON.parse(JSON.stringify(tickets.snapshot())),
+      dueTimesEnabled: true,
+      dueHours: { urgent: 1, high: 1, normal: 1, low: 1 },
+    });
+    assert.equal(again.get('T-0001').due, created.due);
+  });
+
+  test('tickets already in a saved state get a due time from created and priority', () => {
+    const { clock, store: tickets } = store();
+    tickets.create(input({ priority: 'high' }), 'dana');
+    const state = JSON.parse(JSON.stringify(tickets.snapshot()));
+    delete state.tickets[0].due;
