@@ -0,0 +1,119 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { loadConfig } = require('../src/config');
+const { TicketStore } = require('../src/store');
+const { createPersistence, fromDocument } = require('../src/persistence');
+const { ticketBody, withService } = require('./helpers');
+
+test('response hours default by priority and configuration rejects unusable hours', () => {
+  assert.deepEqual(loadConfig({}).responseHours, { urgent: 4, high: 24, normal: 72, low: 168 });
+  assert.equal(loadConfig({ DUE_TIMES: 'on', RESPONSE_HOURS_URGENT: '2' }).dueTimes, true);
+  assert.equal(loadConfig({ RESPONSE_HOURS_URGENT: '2' }).responseHours.urgent, 2);
+  for (const value of ['0', '-1', 'NaN', '1.5', '999999999']) {
+    assert.throws(() => loadConfig({ RESPONSE_HOURS_HIGH: value }), /RESPONSE_HOURS_HIGH/);
+  }
+});
+
+test('each priority gets its creation deadline and priority updates preserve it', () => {
+  const clock = manualClock('2025-01-01T00:00:00.000Z');
+  const store = new TicketStore({ clock, dueTimes: true });
+  for (const [priority, hours] of Object.entries(loadConfig({}).responseHours)) {
+    const ticket = store.create(ticketBody({ priority }), 'test');
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), hours * 3600000);
+    clock.advance(1000);
+    assert.equal(store.update(ticket.id, { priority: 'low' }, 'test').due, ticket.due);
+  }
+});
+
+test('off preserves API responses and ignores the formerly unknown overdue query', async () => {
+  await withService({}, async (api) => {
+    const { body: ticket } = await api.post('/tickets', ticketBody());
+    assert.equal('due' in ticket, false);
+    assert.equal('due' in (await api.get(`/tickets/${ticket.id}`)).body, false);
+    const listing = await api.get('/tickets?overdue=anything');
+    assert.equal(listing.status, 200);
+    assert.equal(listing.body.items.length, 1);
+    assert.equal('due' in listing.body.items[0], false);
+  });
+});
+
+test('overdue uses strict past time, active states, other filters and cursor pages', async () => {
+  const clock = manualClock('2025-01-01T00:00:00.000Z');
+  await withService({ clock, dueTimes: true }, async (api, service) => {
+    for (let i = 0; i < 4; i++) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+    service.store.transition('T-0002', 'in_progress', 'test');
+    service.store.transition('T-0003', 'in_progress', 'test');
+    service.store.transition('T-0003', 'resolved', 'test');
+    service.store.transition('T-0004', 'in_progress', 'test');
+    service.store.transition('T-0004', 'resolved', 'test');
+    service.store.transition('T-0004', 'closed', 'test');
+    clock.advance(4 * 3600000);
+    assert.equal((await api.get('/tickets?overdue=true')).body.items.length, 0);
+    clock.advance(1);
+    const first = (await api.get('/tickets?overdue=true&limit=1')).body;
+    assert.deepEqual(first.items.map(t => t.id), ['T-0001']);
+    assert.ok(first.items[0].due);
+    assert.deepEqual((await api.get(`/tickets?overdue=true&limit=1&cursor=${encodeURIComponent(first.next)}`)).body.items.map(t => t.id), ['T-0002']);
+    assert.deepEqual((await api.get('/tickets?overdue=true&status=in_progress')).body.items.map(t => t.id), ['T-0002']);
+    assert.equal((await api.get('/tickets?overdue=bad')).status, 400);
+    assert.equal((await api.get('/tickets?overdue=false')).body.items.length, 4);
+  });
+});
+
+test('legacy backfill persists before exposure, survives restart and hours changes, and keeps version 1', (t) => {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const file = path.join(dir, 'tickets.json');
+  const clock = manualClock('2025-01-01T00:00:00.000Z');
+  const persistence = createPersistence(file, { clock });
+  const original = new TicketStore({ clock, persistence });
+  original.create(ticketBody({ priority: 'urgent' }), 'test');
+  original.create(ticketBody({ priority: 'low' }), 'test');
+  const legacy = JSON.parse(fs.readFileSync(file));
+  legacy.tickets.forEach(ticket => delete ticket.due);
+  fs.writeFileSync(file, JSON.stringify(legacy));
+  const prepared = TicketStore.open({ clock, persistence });
+  const document = JSON.parse(fs.readFileSync(file));
+  assert.equal(document.version, 1);
+  assert.equal(document.tickets[0].due, '2025-01-01T04:00:00.000Z');
+  assert.equal(document.tickets[1].due, '2025-01-08T00:00:00.000Z');
+  assert.equal('due' in prepared.get('T-0001'), false);
+  assert.deepEqual(document.audit, legacy.audit);
+  assert.deepEqual(document.outbox, legacy.outbox);
+  const restarted = TicketStore.open({ clock, persistence, dueTimes: true, responseHours: { urgent: 1 } });
+  assert.equal(restarted.get('T-0001').due, document.tickets[0].due);
+  assert.equal(restarted.create(ticketBody({ priority: 'urgent' }), 'test').due, '2025-01-01T01:00:00.000Z');
+  assert.equal(restarted.importTickets([ticketBody({ priority: 'urgent' })], 'test').created, 1);
+  assert.equal(restarted.get('T-0004').due, '2025-01-01T01:00:00.000Z');
+  document.tickets[0].due = 'invalid';
+  assert.throws(() => fromDocument(document, message => new Error(message)), /due is not a time/);
+});
+
+test('a failed backfill save aborts opening before deadlines can be served', () => {
+  const clock = manualClock();
+  const old = new TicketStore({ clock });
+  old.create(ticketBody(), 'test');
+  const state = old.snapshot();
+  state.tickets.forEach(ticket => delete ticket.due);
+  assert.throws(() => TicketStore.open({ clock, dueTimes: true, persistence: {
+    load: () => state,
+    save: () => { throw new Error('disk full'); },
+  } }), /disk full/);
+});
+
+test('CLI due output is gated and raw columns keep their positions', () => {
+  const { rawLine, details } = require('../src/format');
+  const clock = manualClock();
+  const enabled = new TicketStore({ clock, dueTimes: true });
+  const ticket = enabled.create(ticketBody(), 'test');
+  assert.equal(rawLine(ticket).split('\t')[5], ticket.due);
+  assert.match(details(ticket, []), /due\s+\d{4}-/);
+  const disabled = new TicketStore({ clock, state: enabled.snapshot() });
+  assert.equal(rawLine(disabled.get(ticket.id)).split('\t').length, 5);
+  assert.doesNotMatch(details(disabled.get(ticket.id), []), /\n  due/);
+});
diff --git a/test/import.test.js b/test/import.test.js
