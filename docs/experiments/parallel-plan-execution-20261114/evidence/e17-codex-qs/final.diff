+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { performance } = require('node:perf_hooks');
+const { withService, ticketBody } = require('./helpers');
+const { TicketStore } = require('../src/store');
+const { manualClock } = require('../src/clock');
+const { createPersistence } = require('../src/persistence');
+
+test('import creates tickets in order with the usual defaults, audit and delivered notifications', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const result = await api.post('/tickets/import', { tickets: [
+      { title: '  First  ', requester: 'one@example.com' },
+      ticketBody({ title: 'Second', requester: 'two@example.com', priority: 'urgent' }),
+    ] }, { 'x-actor': 'migration' });
+    assert.equal(result.status, 201);
+    assert.deepEqual(result.body, { created: 2, ids: ['T-0002', 'T-0003'] });
+    assert.equal((await api.get('/tickets/T-0002')).body.title, 'First');
+    assert.equal((await api.get('/tickets/T-0002')).body.priority, 'normal');
+    assert.equal((await api.get('/tickets/T-0003')).body.priority, 'urgent');
+    for (const id of result.body.ids) {
+      const [entry] = service.store.history(id);
+      assert.equal(entry.action, 'ticket.created');
+      assert.equal(entry.actor, 'migration');
+      assert.equal(entry.changes.status.to, 'open');
+    }
+    assert.equal(service.store.outboxReport().pending.length, 3);
+    await service.worker.tick();
+    assert.deepEqual(service.notifier.delivered.map((event) => event.ticket), ['T-0001', 'T-0002', 'T-0003']);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0004');
+  });
+});
+
+test('first invalid index is reported and no state or ids are consumed', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const before = service.store.snapshot();
+    for (const bad of [null, [], 4, 'ticket', {}, ticketBody({ priority: 'wrong' }), ticketBody({ extra: true })]) {
+      const result = await api.post('/tickets/import', { tickets: [ticketBody(), bad, null] });
+      assert.equal(result.status, 400);
+      assert.equal(result.body.error.code, 'invalid');
+      assert.match(result.body.error.message, /tickets\[1\]/);
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+    const result = await api.post('/tickets/import', { tickets: [null, ticketBody()] });
+    assert.match(result.body.error.message, /tickets\[0\]/);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+  });
+});
+
+test('import rejects malformed envelopes and batches over 5000', async () => {
+  await withService({}, async (api, service) => {
+    for (const body of [{}, { tickets: null }, { tickets: {} }, { tickets: [], extra: 1 },
+      { tickets: Array(5001).fill(ticketBody()) }, '{', '[]']) {
+      assert.equal((await api.post('/tickets/import', body)).status, 400);
+      assert.equal(service.store.snapshot().tickets.length, 0);
+    }
+  });
+});
+
+test('empty import succeeds without changing state', async () => {
+  await withService({}, async (api, service) => {
+    const before = service.store.snapshot();
+    const result = await api.post('/tickets/import', { tickets: [] });
+    assert.equal(result.status, 201);
+    assert.deepEqual(result.body, { created: 0, ids: [] });
+    assert.deepEqual(service.store.snapshot(), before);
+  });
+});
+
+test('invalid actor rejects import without changes', async () => {
+  await withService({}, async (api, service) => {
+    const result = await api.post('/tickets/import', { tickets: [ticketBody()] }, { 'x-actor': 'x'.repeat(65) });
+    assert.equal(result.status, 400);
+    assert.equal(service.store.snapshot().tickets.length, 0);
+  });
+});
+
+test('5000 tickets import in under ten seconds and survive restart with audit and outbox', async () => {
+  const dir = fs.mkdtempSync(path.join(process.cwd(), '.import-test-'));
+  const dataFile = path.join(dir, 'tickets.json');
+  try {
+    await withService({ dataFile }, async (api, service) => {
+      const tickets = Array.from({ length: 5000 }, (_, index) => ticketBody({ title: `Ticket ${index}` }));
+      const start = performance.now();
+      const result = await api.post('/tickets/import', { tickets });
+      assert.equal(result.status, 201);
+      assert.ok(performance.now() - start < 10_000);
+      assert.equal(result.body.created, 5000);
+      assert.equal(result.body.ids[0], 'T-0001');
+      assert.equal(result.body.ids[4999], 'T-5000');
+      const restored = TicketStore.open({ clock: service.clock || manualClock(), persistence: createPersistence(dataFile) });
+      assert.equal(restored.snapshot().tickets.length, 5000);
+      assert.equal(restored.audit.size, 5000);
+      assert.equal(restored.outboxReport().pending.length, 5000);
+      assert.equal(restored.get('T-5000').title, 'Ticket 4999');
+      assert.equal(restored.create(ticketBody(), 'system').id, 'T-5001');
+      const saved = fs.readFileSync(dataFile, 'utf8');
+      assert.equal((await api.post('/tickets/import', { tickets: [ticketBody(), null] })).status, 400);
+      assert.equal(fs.readFileSync(dataFile, 'utf8'), saved);
+    });
+  } finally {
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
+
+test('import saves once and persistence failure leaves live state untouched', () => {
+  let saves = 0;
+  let fail = false;
+  const store = new TicketStore({ clock: manualClock(), persistence: { save() {
+    saves += 1;
+    if (fail) throw new Error('disk failure');
+  } } });
+  store.importTickets([ticketBody(), ticketBody()], 'system');
+  assert.equal(saves, 1);
+  const before = store.snapshot();
+  fail = true;
+  assert.throws(() => store.importTickets([ticketBody()], 'system'), /disk failure/);
+  assert.deepEqual(store.snapshot(), before);
+});
