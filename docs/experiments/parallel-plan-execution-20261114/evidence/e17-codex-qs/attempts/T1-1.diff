diff --git a/test/assignment.test.js b/test/assignment.test.js
new file mode 100644
index 0000000..7c781d2
--- /dev/null
+++ b/test/assignment.test.js
@@ -0,0 +1,121 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { ticketBody, withService } = require('./helpers');
+const { manualClock } = require('../src/clock');
+const { TicketStore } = require('../src/store');
+const { toDocument, fromDocument } = require('../src/persistence');
+const { rawLine, table, details } = require('../src/format');
+const { render } = require('../src/templates');
+const { deliverOutbox } = require('../src/worker');
+const { silentLogger } = require('../src/log');
+
+const path = '/tickets/T-0001/assignee';
+
+test('assignment is audited, unchanged assignment is a no-op, and unassignment is silent', async () => {
+  await withService({}, async (api, service) => {
+    const created = (await api.post('/tickets', ticketBody())).body;
+    assert.equal(created.assignee, null);
+    const assigned = await api.put(path, { assignee: 'Dana' }, { 'X-Actor': 'sam' });
+    assert.equal(assigned.status, 200);
+    assert.equal(assigned.body.assignee, 'Dana');
+    const history = service.store.history(created.id);
+    assert.equal(history.at(-1).actor, 'sam');
+    assert.deepEqual(history.at(-1).changes, { assignee: { from: null, to: 'Dana' } });
+    const snapshot = service.store.snapshot();
+    assert.deepEqual((await api.put(path, { assignee: 'Dana' })).body, assigned.body);
+    assert.deepEqual(service.store.snapshot(), snapshot);
+    const events = service.store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned');
+    assert.equal(events.length, 1);
+    assert.equal(events[0].to, 'Dana');
+    assert.match(render(events[0]).body, /assigned to you/);
+    assert.equal((await api.put(path, { assignee: null })).body.assignee, null);
+    assert.equal(service.store.outboxReport().pending.length, 2);
+    assert.deepEqual(service.store.history(created.id).at(-1).changes, { assignee: { from: 'Dana', to: null } });
+  });
+});
+
+test('each reassignment notifies its recipient, even with earlier assignments pending', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    for (const assignee of ['Dana', 'Sam', 'Dana']) await api.put(path, { assignee });
+    const events = service.store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned');
+    assert.deepEqual(events.map((event) => event.to), ['Dana', 'Sam', 'Dana']);
+    await deliverOutbox({ store: service.store, notifier: service.notifier, log: silentLogger }).run();
+    assert.equal(service.store.outboxReport().pending.length, 0);
+    assert.equal(service.store.outboxReport().sent.length, 4);
+  });
+});
+
+test('assignment validates names, null, required and unknown fields', async () => {
+  await withService({}, async (api) => {
+    await api.post('/tickets', ticketBody());
+    for (const body of [{}, { assignee: '' }, { assignee: ' ' }, { assignee: 42 }, { assignee: false },
+      { assignee: {} }, { assignee: 'x'.repeat(65) }, { assignee: 'a\nb' }, { assignee: 'Dana', extra: true }]) {
+      const response = await api.put(path, body);
+      assert.equal(response.status, 400, JSON.stringify(body));
+      assert.equal(response.body.error.code, 'invalid');
+    }
+    assert.equal((await api.put(path, { assignee: 'x'.repeat(64) })).status, 200);
+    assert.equal((await api.put('/tickets/T-9999/assignee', { assignee: 'Dana' })).status, 404);
+  });
+});
+
+test('only open and in-progress tickets permit assignment or unassignment', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+    assert.equal((await api.put(path, { assignee: 'Dana' })).status, 200);
+    for (const status of ['resolved', 'closed']) {
+      await api.post('/tickets/T-0001/transition', { to: status });
+      const snapshot = service.store.snapshot();
+      for (const assignee of [null, 'Sam', 'Dana']) {
+        const response = await api.put(path, { assignee });
+        assert.equal(response.status, 409);
+        assert.equal(response.body.error.code, 'conflict');
+      }
+      assert.deepEqual(service.store.snapshot(), snapshot);
+    }
+  });
+});
+
+test('assignee filter composes with all other filters and pagination', async () => {
+  await withService({}, async (api) => {
+    for (const priority of ['high', 'low', 'high', 'high', 'high']) await api.post('/tickets', ticketBody({ priority }));
+    for (const id of ['T-0001', 'T-0002', 'T-0003', 'T-0004']) await api.put(`/tickets/${id}/assignee`, { assignee: 'Dana' });
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+    const first = (await api.get('/tickets?assignee=Dana&status=open&priority=high&limit=1')).body;
+    assert.deepEqual(first.items.map((ticket) => ticket.id), ['T-0001']);
+    const second = (await api.get(`/tickets?assignee=Dana&status=open&priority=high&limit=1&cursor=${first.next}`)).body;
+    assert.deepEqual(second.items.map((ticket) => ticket.id), ['T-0004']);
+    assert.equal(second.next, null);
+    assert.deepEqual((await api.get('/tickets?assignee=')).body.items.map((ticket) => ticket.id), ['T-0005']);
+    assert.deepEqual((await api.get('/tickets?assignee=Sam')).body.items, []);
+    assert.deepEqual((await api.get('/tickets?status=open&priority=low')).body.items.map((ticket) => ticket.id), ['T-0002']);
+  });
+});
+
+test('persistence retains assignment and upgrades old tickets to unassigned', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock });
+  store.create(ticketBody(), 'sam');
+  store.assign('T-0001', 'Dana', 'sam');
+  const document = toDocument(store.snapshot(), clock.now());
+  const fail = (message) => new Error(message);
+  const restored = new TicketStore({ clock, state: fromDocument(document, fail) });
+  assert.equal(restored.get('T-0001').assignee, 'Dana');
+  assert.equal(restored.outboxReport().pending.at(-1).to, 'Dana');
+  delete document.tickets[0].assignee;
+  assert.equal(fromDocument(document, fail).tickets[0].assignee, null);
+  document.tickets[0].assignee = 'x'.repeat(65);
+  assert.throws(() => fromDocument(document, fail), /assignee/);
+});
+
+test('CLI formatting includes assignee and preserves existing raw column positions', () => {
+  const ticket = { id: 'T-0001', status: 'open', priority: 'high', title: 'Printer', requester: 'sam', assignee: 'Dana', updated: '2026-01-01T00:00:00Z' };
+  assert.deepEqual(rawLine(ticket).split('\t'), ['T-0001', 'open', 'high', 'Printer', 'Dana']);
+  assert.match(table([ticket]), /ASSIGNEE/);
+  assert.match(table([ticket]), /Dana/);
+  assert.match(details(ticket, []), /assignee\s+Dana/);
+});
