diff --git a/src/tickets/due.js b/src/tickets/due.js
new file mode 100644
index 0000000..a5f28ef
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,9 @@
+'use strict';
+
+const DEFAULT_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+function dueAt(ticket, hours = DEFAULT_HOURS) {
+  return new Date(Date.parse(ticket.created) + hours[ticket.priority] * 3600000).toISOString();
+}
+
+module.exports = { DEFAULT_HOURS, dueAt };
