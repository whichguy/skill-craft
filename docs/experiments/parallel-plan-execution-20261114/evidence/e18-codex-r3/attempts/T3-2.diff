diff --git a/test/due.test.js b/test/due.test.js
new file mode 100644
index 0000000..ca604c5
--- /dev/null
+++ b/test/due.test.js
@@ -0,0 +1,126 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { loadConfig } = require('../src/config');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { ticketBody, withService } = require('./helpers');
+const HOUR = 3600000;
+
+function dataFile(t) {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return path.join(dir, 'tickets.json');
+}
+
+test('default and configurable response hours; only literal on enables due times', () => {
+  assert.deepEqual(loadConfig({}).responseHours, { urgent: 4, high: 24, normal: 72, low: 168 });
+  const config = loadConfig({ DUE_TIMES: 'on', RESPONSE_HOURS_HIGH: '2' });
+  assert.equal(config.dueTimes, true);
+  assert.equal(config.responseHours.high, 2);
+  assert.equal(loadConfig({ DUE_TIMES: 'true' }).dueTimes, false);
+  for (const value of ['-1', 'NaN', '1.5', '876001']) {
+    assert.throws(() => loadConfig({ RESPONSE_HOURS_HIGH: value }), /RESPONSE_HOURS_HIGH/);
+  }
+});
+
+test('each priority receives its immutable due time, including imports and changes', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock, dueTimes: true });
+  for (const [priority, hours] of Object.entries(loadConfig({}).responseHours)) {
+    const ticket = store.createTicket(ticketBody({ priority }), 'agent');
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), hours * HOUR);
+    clock.advance(HOUR);
+    assert.equal(store.update(ticket.id, { priority: 'low' }, 'agent').due, ticket.due);
+    assert.equal(store.assign(ticket.id, 'agent', 'agent').due, ticket.due);
+    assert.equal(store.transition(ticket.id, 'in_progress', 'agent').due, ticket.due);
+  }
+  const [id] = store.importTickets([ticketBody({ priority: 'urgent' })], 'agent');
+  assert.equal(Date.parse(store.get(id).due) - clock.now().getTime(), 4 * HOUR);
+});
+
+test('backfill is persisted while off, keeps original creation dates, and survives changed hours', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const persistence = createPersistence(file, { clock });
+  const original = TicketStore.open({ clock, persistence });
+  original.createTicket(ticketBody({ priority: 'high' }), 'agent');
+  const legacy = JSON.parse(fs.readFileSync(file));
+  delete legacy.tickets[0].due;
+  fs.writeFileSync(file, JSON.stringify(legacy));
+  clock.advance(100 * HOUR);
+  const migrated = TicketStore.open({ clock, persistence });
+  assert.equal(migrated.get('T-0001').due, undefined);
+  const saved = JSON.parse(fs.readFileSync(file));
+  assert.equal(saved.version, 1); // 1.4.0 accepts version 1 and ignores optional fields.
+  assert.equal(Date.parse(saved.tickets[0].due) - Date.parse(legacy.tickets[0].created), 24 * HOUR);
+  assert.deepEqual(saved.audit, legacy.audit);
+  assert.deepEqual(saved.outbox, legacy.outbox);
+  const reopened = TicketStore.open({ clock, persistence, dueTimes: true,
+    responseHours: { urgent: 1, high: 1, normal: 1, low: 1 } });
+  assert.equal(reopened.get('T-0001').due, saved.tickets[0].due);
+  reopened.update('T-0001', { priority: 'urgent' }, 'agent');
+  assert.equal(createPersistence(file).load().tickets[0].due, saved.tickets[0].due);
+});
+
+test('migration failure prevents activation and corrupt due data is rejected', (t) => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock });
+  store.createTicket(ticketBody(), 'agent');
+  const state = store.snapshot();
+  delete state.tickets[0].due;
+  assert.throws(() => TicketStore.open({ clock, dueTimes: true,
+    persistence: { load: () => state, save: () => { throw new Error('disk full'); } } }), /disk full/);
+  const file = dataFile(t);
+  const persistence = createPersistence(file);
+  persistence.save(store.snapshot());
+  const document = JSON.parse(fs.readFileSync(file));
+  document.tickets[0].due = 'invalid';
+  fs.writeFileSync(file, JSON.stringify(document));
+  assert.throws(() => persistence.load(), /tickets\[0\].due is not a time/);
+});
+
+test('HTTP responses and overdue parameters retain their old behavior while off', async () => {
+  await withService({}, async (api) => {
+    const created = await api.post('/tickets', ticketBody());
+    assert.equal('due' in created.body, false);
+    assert.equal('due' in (await api.get(`/tickets/${created.body.id}`)).body, false);
+    const page = await api.get('/tickets?overdue=true');
+    assert.equal(page.body.items.length, 1);
+    assert.equal('due' in page.body.items[0], false);
+    assert.equal((await api.get('/tickets?overdue=garbage')).status, 200);
+  });
+});
+
+test('overdue means strictly past due and active, combines filters and cursor pages', async () => {
+  const clock = manualClock();
+  await withService({ dueTimes: true, clock }, async (api) => {
+    const ids = [];
+    for (let i = 0; i < 5; i += 1) {
