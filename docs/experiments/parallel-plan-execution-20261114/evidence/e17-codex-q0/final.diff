+    await api.put(`/tickets/${created.id}/assignee`, { assignee: 'Lee' });
+    await api.put(`/tickets/${created.id}/assignee`, { assignee: null });
+    const before = service.store.snapshot();
+    await api.put(`/tickets/${created.id}/assignee`, { assignee: null });
+    assert.deepEqual(service.store.snapshot(), before);
+    assert.equal((await api.get(`/tickets/${created.id}`)).body.assignee, null);
+    const history = (await api.get(`/tickets/${created.id}/audit`)).body.items;
+    assert.equal(history[1].actor, 'dana');
+    assert.deepEqual(history.slice(1).map((entry) => entry.changes.assignee), [
+      { from: null, to: 'Sam' }, { from: 'Sam', to: 'Lee' }, { from: 'Lee', to: null },
+    ]);
+    const queued = service.store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned');
+    assert.deepEqual(queued.map((event) => event.to), ['Sam', 'Lee']);
+    service.worker.tick();
+    const delivered = service.notifier.delivered.filter((event) => event.type === 'ticket.assigned');
+    assert.deepEqual(delivered.map((event) => event.to), ['Sam', 'Lee']);
+    assert.match(delivered[0].body, /assigned to you/);
+  });
+});
