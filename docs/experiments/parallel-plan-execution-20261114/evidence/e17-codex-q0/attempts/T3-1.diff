@@ -0,0 +1,137 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { ConfigError, loadConfig } = require('../src/config');
+const { manualClock } = require('../src/clock');
+const { createPersistence, DataFileError } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { ticketBody, withService } = require('./helpers');
+const { rawLine, details, table } = require('../src/format');
+
+function dataFile(t) {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return path.join(dir, 'tickets.json');
+}
+
+test('response hours have defaults and validated per-priority environment settings', () => {
+  assert.deepEqual(loadConfig({}).responseHours, { urgent: 4, high: 24, normal: 72, low: 168 });
+  assert.equal(loadConfig({ DUE_TIMES: 'on', RESPONSE_HOURS_HIGH: '8' }).dueTimes, true);
+  assert.equal(loadConfig({ RESPONSE_HOURS_HIGH: '8' }).responseHours.high, 8);
+  assert.equal(loadConfig({ DUE_TIMES: 'true' }).dueTimes, false);
+  for (const value of ['-1', '0', '1.5', 'Infinity', '876001']) {
+    assert.throws(() => loadConfig({ RESPONSE_HOURS_HIGH: value }),
+      (error) => error instanceof ConfigError && /RESPONSE_HOURS_HIGH/.test(error.message));
+  }
+});
+
+test('every new ticket has its priority deadline on every ticket response', async () => {
+  await withService({ dueTimes: true }, async (api) => {
+    for (const [priority, hours] of Object.entries(loadConfig({}).responseHours)) {
+      const created = (await api.post('/tickets', ticketBody({ priority }))).body;
+      assert.equal(Date.parse(created.due) - Date.parse(created.created), hours * 3600000);
+      assert.equal((await api.get(`/tickets/${created.id}`)).body.due, created.due);
+      assert.equal((await api.patch(`/tickets/${created.id}`, { priority: 'low' })).body.due, created.due);
+      assert.equal((await api.post(`/tickets/${created.id}/transition`, { to: 'in_progress' })).body.due, created.due);
+    }
+    assert.ok((await api.get('/tickets')).body.items.every((ticket) => ticket.due));
+  });
+});
+
+test('overdue uses a strict deadline and only active states, with cursor pages', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true }, async (api) => {
+    for (let i = 0; i < 5; i += 1) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0004/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'closed' });
+    await api.post('/tickets', ticketBody({ priority: 'low' }));
+    clock.advance(4 * 3600000);
+    assert.deepEqual((await api.get('/tickets?overdue=true')).body.items, []);
+    clock.advance(1);
+    const first = (await api.get('/tickets?overdue=true&limit=1')).body;
+    assert.equal(first.items[0].id, 'T-0001');
+    const rest = (await api.get(`/tickets?overdue=true&cursor=${first.next}`)).body;
+    assert.deepEqual(rest.items.map((ticket) => ticket.id), ['T-0002', 'T-0005']);
+    assert.equal((await api.get('/tickets?overdue=true&priority=low')).body.items.length, 0);
+    assert.equal((await api.get('/tickets?overdue=false')).body.items.length, 6);
+    assert.equal((await api.get('/tickets?overdue=yes')).status, 400);
+  });
+});
+
+test('feature off preserves old API bodies and ignores overdue while saving deadlines', async (t) => {
+  const file = dataFile(t);
+  await withService({ dataFile: file }, async (api) => {
+    const created = (await api.post('/tickets', ticketBody())).body;
+    assert.equal('due' in created, false);
+    assert.equal('due' in (await api.get('/tickets/T-0001')).body, false);
+    assert.equal('due' in (await api.patch('/tickets/T-0001', { title: 'Changed' })).body, false);
+    assert.equal((await api.get('/tickets?overdue=garbage')).body.items.length, 1);
+    assert.equal('due' in (await api.get('/tickets')).body.items[0], false);
+    assert.ok(JSON.parse(fs.readFileSync(file)).tickets[0].due);
+  });
+});
+
+test('legacy tickets are backfilled before exposure; restart and config changes preserve deadlines', async (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const old = new TicketStore({ clock });
+  old.create(ticketBody({ priority: 'high' }), 'agent');
+  const original = old.snapshot();
+  for (const ticket of original.tickets) delete ticket.due;
+  createPersistence(file, { clock }).save(original);
+  const persistence = createPersistence(file, { clock });
+  const store = TicketStore.open({ clock, persistence, dueTimes: false, responseHours: { high: 5 } });
+  const saved = JSON.parse(fs.readFileSync(file));
+  const due = saved.tickets[0].due;
+  assert.equal(Date.parse(due) - Date.parse(saved.tickets[0].created), 5 * 3600000);
+  assert.equal(saved.version, 1, '1.4.0 still accepts the file version and ignores the added field');
+  assert.deepEqual(saved.audit, original.audit);
+  assert.deepEqual(saved.outbox, original.outbox);
+  assert.equal(store.get('T-0001').due, undefined);
+  await withService({ dataFile: file, dueTimes: true, responseHours: { high: 99 } }, async (api) => {
+    assert.equal((await api.get('/tickets/T-0001')).body.due, due);
+    assert.equal((await api.patch('/tickets/T-0001', { priority: 'urgent' })).body.due, due);
+    assert.equal((await api.post('/tickets', ticketBody({ priority: 'high' }))).body.due,
+      new Date(clock.now().getTime() + 99 * 3600000).toISOString());
+  });
+  assert.equal(createPersistence(file).load().tickets[0].due, due);
+});
+
+test('invalid persisted due values fail startup instead of silently moving deadlines', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(file) });
+  store.create(ticketBody(), 'agent');
+  const document = JSON.parse(fs.readFileSync(file));
+  document.tickets[0].due = 'not-a-date';
+  fs.writeFileSync(file, JSON.stringify(document));
+  assert.throws(() => TicketStore.open({ clock, persistence: createPersistence(file) }), DataFileError);
+});
+
+test('migration save failure prevents startup and a partial rollout', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock });
+  store.create(ticketBody(), 'agent');
+  const state = store.snapshot();
+  delete state.tickets[0].due;
+  assert.throws(() => TicketStore.open({ clock, dueTimes: true, persistence: {
+    load: () => state,
+    save: () => { throw new Error('disk full'); },
+  } }), /disk full/);
+});
+
+test('operator formats show due and preserve the original raw column positions', () => {
+  const store = TicketStore.open({ clock: manualClock(), dueTimes: true });
+  const ticket = store.create(ticketBody(), 'agent');
+  assert.equal(rawLine(ticket).split('\t')[3], ticket.title);
+  assert.equal(rawLine(ticket).split('\t')[4], ticket.due);
+  assert.match(table([ticket]), /DUE/);
+  assert.match(details(ticket, []), /due/);
+});
