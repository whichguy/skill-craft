diff --git a/test/assignment.test.js b/test/assignment.test.js
new file mode 100644
index 0000000..08412eb
--- /dev/null
+++ b/test/assignment.test.js
@@ -0,0 +1,142 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { ticketBody, withService } = require('./helpers');
+const { manualClock } = require('../src/clock');
+const { TicketStore } = require('../src/store');
+const { fromDocument, toDocument } = require('../src/persistence');
+const { main } = require('../bin/tickets');
+
+test('assignment, reassignment and unassignment are audited; repeats have no effects', async () => {
+  await withService({}, async (api, service) => {
+    const created = (await api.post('/tickets', ticketBody())).body;
+    assert.equal(created.assignee, null);
+    const assigned = await api.put(`/tickets/${created.id}/assignee`, { assignee: ' Sam ' }, { 'X-Actor': 'dana' });
+    assert.equal(assigned.status, 200);
+    assert.equal(assigned.body.assignee, 'Sam');
+    const snapshot = service.store.snapshot();
+    assert.deepEqual((await api.put(`/tickets/${created.id}/assignee`, { assignee: 'Sam' })).body, assigned.body);
+    assert.deepEqual(service.store.snapshot(), snapshot);
+    await api.put(`/tickets/${created.id}/assignee`, { assignee: 'Lee' });
+    await api.put(`/tickets/${created.id}/assignee`, { assignee: null });
+    const before = service.store.snapshot();
+    await api.put(`/tickets/${created.id}/assignee`, { assignee: null });
+    assert.deepEqual(service.store.snapshot(), before);
+    assert.equal((await api.get(`/tickets/${created.id}`)).body.assignee, null);
+    const history = (await api.get(`/tickets/${created.id}/audit`)).body.items;
+    assert.equal(history[1].actor, 'dana');
+    assert.deepEqual(history.slice(1).map((entry) => entry.changes.assignee), [
+      { from: null, to: 'Sam' }, { from: 'Sam', to: 'Lee' }, { from: 'Lee', to: null },
+    ]);
+    const queued = service.store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned');
+    assert.deepEqual(queued.map((event) => event.to), ['Sam', 'Lee']);
+    service.worker.tick();
+    const delivered = service.notifier.delivered.filter((event) => event.type === 'ticket.assigned');
+    assert.deepEqual(delivered.map((event) => event.to), ['Sam', 'Lee']);
+    assert.match(delivered[0].body, /assigned to you/);
+  });
+});
+
+test('each actual assignment notifies even when an earlier assignment is pending', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    for (const assignee of ['Sam', 'Lee', 'Sam']) await api.put('/tickets/T-0001/assignee', { assignee });
+    assert.deepEqual(service.store.outboxReport().pending.filter((e) => e.type === 'ticket.assigned').map((e) => e.to), ['Sam', 'Lee', 'Sam']);
+  });
+});
+
+test('assignment bodies require a valid single-line agent or explicit null', async () => {
+  await withService({}, async (api) => {
+    await api.post('/tickets', ticketBody());
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 1 }, { assignee: false },
+      { assignee: {} }, { assignee: 'x'.repeat(65) }, { assignee: 'a\nb' }, { assignee: 'Sam', other: 1 }, [], null]) {
+      const response = await api.put('/tickets/T-0001/assignee', body);
+      assert.equal(response.status, 400, JSON.stringify(body));
+      assert.equal(response.body.error.code, 'invalid');
+    }
+    assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'x'.repeat(64) })).status, 200);
+    assert.equal((await api.put('/tickets/T-9999/assignee', { assignee: 'Sam' })).status, 404);
+  });
+});
+
+test('only open and in-progress tickets allow assignment and unassignment', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+    assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'Sam' })).status, 200);
+    for (const to of ['resolved', 'closed']) {
+      await api.post('/tickets/T-0001/transition', { to });
+      const before = service.store.snapshot();
+      for (const assignee of ['Sam', 'Lee', null]) {
+        const response = await api.put('/tickets/T-0001/assignee', { assignee });
+        assert.equal(response.status, 409);
+        assert.equal(response.body.error.code, 'conflict');
+      }
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+  });
+});
+
+test('assignee filtering intersects status and priority and pages matching tickets', async () => {
+  await withService({}, async (api) => {
+    for (const [assignee, priority, status] of [['Sam', 'high', 'open'], ['Sam', 'low', 'open'],
+      ['Lee', 'high', 'open'], [null, 'high', 'open'], ['Sam', 'high', 'in_progress'], ['Sam', 'high', 'open']]) {
+      const { body } = await api.post('/tickets', ticketBody({ priority }));
+      if (assignee) await api.put(`/tickets/${body.id}/assignee`, { assignee });
+      if (status !== 'open') await api.post(`/tickets/${body.id}/transition`, { to: status });
+    }
+    const ids = (page) => page.body.items.map((ticket) => ticket.id);
+    assert.deepEqual(ids(await api.get('/tickets?assignee=')), ['T-0004']);
+    assert.deepEqual(ids(await api.get('/tickets?assignee=Lee')), ['T-0003']);
+    assert.deepEqual(ids(await api.get('/tickets?status=open&priority=high')), ['T-0001', 'T-0003', 'T-0004', 'T-0006']);
+    const query = '/tickets?assignee=Sam&status=open&priority=high&limit=1';
+    const first = await api.get(query);
+    assert.deepEqual(ids(first), ['T-0001']);
+    const second = await api.get(`${query}&cursor=${first.body.next}`);
+    assert.deepEqual(ids(second), ['T-0006']);
+    assert.equal(second.body.next, null);
+  });
+});
+
+test('persistence retains assignment, reads legacy tickets as unassigned and rejects bad agents', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock });
+  store.create(ticketBody(), 'system');
+  store.assign('T-0001', 'Sam', 'system');
+  const document = toDocument(store.snapshot(), clock.now());
+  const fail = (message) => new Error(message);
+  const loaded = fromDocument(document, fail);
+  assert.equal(new TicketStore({ clock, state: loaded }).get('T-0001').assignee, 'Sam');
+  assert.deepEqual(loaded.outbox, store.snapshot().outbox);
+  delete document.tickets[0].assignee;
+  assert.equal(fromDocument(document, fail).tickets[0].assignee, null);
+  for (const assignee of ['', ' '.repeat(3), 'x'.repeat(65), 3, 'a\nb']) {
+    document.tickets[0].assignee = assignee;
+    assert.throws(() => fromDocument(document, fail), /assignee/);
+  }
+});
+
+test('CLI listings show assignees and preserve the first four raw columns', (t) => {
+  const dir = fs.mkdtempSync(path.join(__dirname, 'assignment-data-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const clock = manualClock();
+  const store = new TicketStore({ clock });
+  store.create(ticketBody(), 'system');
+  store.assign('T-0001', 'Sam', 'system');
+  store.create(ticketBody(), 'system');
+  const file = path.join(dir, 'tickets.json');
+  fs.writeFileSync(file, JSON.stringify(toDocument(store.snapshot(), clock.now())));
+  function run(args) {
+    let result = '';
+    assert.equal(main(['--data', file, 'list', ...args], { env: {}, out: { write: (s) => { result += s; } }, err: { write: assert.fail } }), 0);
+    return result;
+  }
+  assert.match(run([]), /ASSIGNEE/);
+  assert.match(run([]), /Sam/);
+  const rows = run(['--raw']).trimEnd().split('\n');
+  assert.deepEqual(rows[0].split('\t'), ['T-0001', 'open', 'normal', ticketBody().title, 'Sam']);
+  assert.equal(run(['--assignee', 'Sam', '--raw']).trim().split('\n').length, 1);
+});
