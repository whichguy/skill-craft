diff --git a/test/import.test.js b/test/import.test.js
new file mode 100644
index 0000000..4df6240
--- /dev/null
+++ b/test/import.test.js
@@ -0,0 +1,125 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { TicketStore } = require('../src/store');
+const { manualClock } = require('../src/clock');
+const { ticketBody, withService } = require('./helpers');
+
+function invalid(response, pattern) {
+  assert.equal(response.status, 400);
+  assert.equal(response.body.error.code, 'invalid');
+  assert.match(response.body.error.message, pattern);
+}
+
+test('imports tickets in order with single-create normalization, audit and requester notifications', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const response = await api.post('/tickets/import', { tickets: [
+      { title: '  First  ', requester: '  first@example.com  ' },
+      ticketBody({ title: 'Second', requester: 'second@example.com', priority: 'urgent' }),
+    ] }, { 'X-Actor': ' migration ' });
+    assert.equal(response.status, 201);
+    assert.deepEqual(response.body, { created: 2, ids: ['T-0002', 'T-0003'] });
+    const first = (await api.get('/tickets/T-0002')).body;
+    assert.equal(first.title, 'First');
+    assert.equal(first.requester, 'first@example.com');
+    assert.equal(first.priority, 'normal');
+    assert.equal(first.status, 'open');
+    const second = (await api.get('/tickets/T-0003')).body;
+    assert.equal(second.title, 'Second');
+    assert.equal(second.priority, 'urgent');
+    const audit = service.store.snapshot().audit;
+    assert.deepEqual(audit.map((entry) => entry.seq), [1, 2, 3]);
+    for (const [index, ticket] of [first, second].entries()) {
+      const entry = audit[index + 1];
+      assert.equal(entry.actor, 'migration');
+      assert.equal(entry.action, 'ticket.created');
+      assert.equal(entry.ticket, ticket.id);
+      for (const field of ['title', 'requester', 'priority', 'status']) {
+        assert.deepEqual(entry.changes[field], { from: null, to: ticket[field] });
+      }
+    }
+    const pending = service.store.outboxReport().pending;
+    assert.deepEqual(pending.slice(1).map((event) => [event.ticket, event.to, event.type]), [
+      ['T-0002', 'first@example.com', 'ticket.created'],
+      ['T-0003', 'second@example.com', 'ticket.created'],
+    ]);
+    assert.equal(service.worker.tick()[0].sent, 3);
+    assert.equal(service.store.outboxReport().sent.length, 3);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0004');
+  });
+});
+
+test('rejects the first invalid item with its zero-based index and changes no state', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const before = service.store.snapshot();
+    for (const item of [null, [], 'ticket', 42, {}, ticketBody({ owner: 'agent' }), ticketBody({ priority: 'critical' })]) {
+      invalid(await api.post('/tickets/import', { tickets: [ticketBody(), item, null] }), /tickets\[1\]/);
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+    invalid(await api.post('/tickets/import', { tickets: [ticketBody({ title: '' }), null] }), /tickets\[0\]/);
+    assert.deepEqual(service.store.snapshot(), before);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+  });
+});
+
+test('validates import envelope, size and actor; empty imports succeed', async () => {
+  await withService({}, async (api, service) => {
+    for (const body of [{}, { tickets: null }, { tickets: {} }, { tickets: [], extra: true }]) {
+      invalid(await api.post('/tickets/import', body), /tickets|unknown/);
+    }
+    invalid(await api.post('/tickets/import', '{"tickets":'), /JSON/);
+    invalid(await api.post('/tickets/import', { tickets: Array(5001).fill(ticketBody()) }), /5000/);
+    invalid(await api.post('/tickets/import', { tickets: [ticketBody()] }, { 'X-Actor': 'x'.repeat(65) }), /X-Actor/);
+    assert.deepEqual(service.store.snapshot().tickets, []);
+    const empty = await api.post('/tickets/import', { tickets: [] });
+    assert.equal(empty.status, 201);
+    assert.deepEqual(empty.body, { created: 0, ids: [] });
+  });
+});
+
+test('imports 5000 tickets in under ten seconds and persists all records', async () => {
+  const directory = fs.mkdtempSync(path.join(process.cwd(), '.import-test-'));
+  const dataFile = path.join(directory, 'tickets.json');
+  try {
+    await withService({ dataFile }, async (api, service) => {
+      const tickets = Array.from({ length: 5000 }, (_, index) => ticketBody({ title: `Imported ${index} ` + 'x'.repeat(175) }));
+      const started = performance.now();
+      const response = await api.post('/tickets/import', { tickets });
+      const elapsed = performance.now() - started;
+      assert.equal(response.status, 201, JSON.stringify(response.body));
+      assert.ok(elapsed < 10000, `import took ${elapsed}ms`);
+      assert.equal(response.body.created, 5000);
+      assert.deepEqual(response.body.ids, tickets.map((_, index) => `T-${String(index + 1).padStart(4, '0')}`));
+      const saved = JSON.parse(fs.readFileSync(dataFile, 'utf8'));
+      assert.equal(saved.tickets.length, 5000);
+      assert.equal(saved.audit.length, 5000);
+      assert.equal(saved.outbox.events.length, 5000);
+      assert.equal(service.store.get('T-5000').title, tickets[4999].title);
+    });
+    await withService({ dataFile }, async (api, service) => {
+      assert.equal(service.store.snapshot().tickets.length, 5000);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-5001');
+    });
+  } finally {
+    fs.rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+test('batch saves once and leaves in-memory state intact if persistence fails', () => {
+  const states = [];
+  let fail = false;
+  const persistence = { save(state) { if (fail) throw new Error('disk full'); states.push(state); } };
+  const store = new TicketStore({ clock: manualClock(), persistence });
+  store.create(ticketBody(), 'system');
+  assert.deepEqual(store.importTickets([ticketBody(), ticketBody()], 'migration'), ['T-0002', 'T-0003']);
+  assert.equal(states.length, 2);
+  const before = store.snapshot();
+  fail = true;
+  assert.throws(() => store.importTickets([ticketBody()], 'migration'), /disk full/);
+  assert.deepEqual(store.snapshot(), before);
+});
