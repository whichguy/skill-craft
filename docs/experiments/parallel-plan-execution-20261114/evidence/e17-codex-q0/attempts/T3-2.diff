+    service.store.assign(first.id, 'Sam', 'agent');
+    assert.equal(service.store.get(first.id).due, first.due);
+    clock.advance(2 * 3600000 + 1);
+    const page = (await api.get('/tickets?overdue=true&assignee=Sam&priority=high&status=open')).body;
+    assert.deepEqual(page.items.map((ticket) => ticket.id), [first.id]);
+    assert.equal(page.items[0].due, first.due);
+    assert.deepEqual((await api.get('/tickets?overdue=true&assignee=Sam&priority=low')).body.items, []);
+  });
