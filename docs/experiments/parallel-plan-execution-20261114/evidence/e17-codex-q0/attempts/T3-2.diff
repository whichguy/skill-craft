+test('atomic imports use configured deadlines and preserve assignment filtering', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true, responseHours: { high: 2 } }, async (api, service) => {
+    const result = await api.post('/tickets/import', { tickets: [ticketBody({ priority: 'high' }), ticketBody({ priority: 'high' })] });
+    assert.equal(result.status, 201);
