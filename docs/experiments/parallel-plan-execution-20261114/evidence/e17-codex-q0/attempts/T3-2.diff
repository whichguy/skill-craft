@@ -0,0 +1,9 @@
+'use strict';
+
+const DEFAULT_RESPONSE_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+function dueAt(created, priority, hours = DEFAULT_RESPONSE_HOURS) {
+  return new Date(Date.parse(created) + hours[priority] * 3600000).toISOString();
+}
+
+module.exports = { DEFAULT_RESPONSE_HOURS, dueAt };
