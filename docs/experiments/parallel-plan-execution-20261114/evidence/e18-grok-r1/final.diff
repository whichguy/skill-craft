+++ b/test/due.test.js
@@ -0,0 +1,270 @@
+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { ConfigError, loadConfig } = require('../src/config');
+const { InvalidError } = require('../src/errors');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { DEFAULT_DUE_HOURS, dueAt, isOverdue } = require('../src/tickets/due');
+const { parseListQuery } = require('../src/tickets/query');
+const { ticketBody, withService } = require('./helpers');
+
+const T0 = '2025-09-01T08:00:00.000Z';
+const HOUR = 60 * 60 * 1000;
+const keys = (ticket) => Object.keys(ticket).sort();
+const TICKET_KEYS = ['assignee', 'created', 'id', 'priority', 'requester', 'status', 'title', 'updated'];
+const TICKET_KEYS_WITH_DUE = [...TICKET_KEYS, 'due'].sort();
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+function writeData(file, tickets) {
+  fs.mkdirSync(path.dirname(file), { recursive: true });
+  fs.writeFileSync(file, `${JSON.stringify({
+    version: 1,
+    savedAt: T0,
+    nextNumber: tickets.length + 1,
+    tickets,
+    audit: [],
+    outbox: { nextId: 1, events: [] },
+  }, null, 2)}\n`);
+}
+
+describe('dueAt', () => {
+  test('adds the default hours for each priority', () => {
+    assert.equal(dueAt(T0, 'urgent'), '2025-09-01T12:00:00.000Z');
+    assert.equal(dueAt(T0, 'high'), '2025-09-02T08:00:00.000Z');
+    assert.equal(dueAt(T0, 'normal'), '2025-09-04T08:00:00.000Z');
+    assert.equal(dueAt(T0, 'low'), '2025-09-08T08:00:00.000Z');
+  });
+
+  test('uses the hours given instead of the defaults', () => {
+    assert.equal(dueAt(T0, 'urgent', { ...DEFAULT_DUE_HOURS, urgent: 1 }), '2025-09-01T09:00:00.000Z');
+  });
+});
+
+describe('isOverdue', () => {
+  const open = { status: 'open', due: '2025-09-01T12:00:00.000Z' };
+
+  test('is true once the due time has been reached, for open and in-progress only', () => {
+    assert.equal(isOverdue(open, new Date('2025-09-01T11:59:59.999Z')), false);
+    assert.equal(isOverdue(open, new Date('2025-09-01T12:00:00.000Z')), true);
+    assert.equal(isOverdue({ ...open, status: 'in_progress' }, new Date('2025-09-01T12:00:00.001Z')), true);
+    assert.equal(isOverdue({ ...open, status: 'resolved' }, new Date('2025-09-01T13:00:00.000Z')), false);
+    assert.equal(isOverdue({ ...open, status: 'closed' }, new Date('2025-09-01T13:00:00.000Z')), false);
+  });
+});
+
+describe('configuration', () => {
+  test('DUE_TIMES is on only for the value on, and hours default to 4, 24, 72, 168', () => {
+    assert.equal(loadConfig({}).dueTimes, false);
+    assert.equal(loadConfig({ DUE_TIMES: '1' }).dueTimes, false);
+    assert.equal(loadConfig({ DUE_TIMES: 'true' }).dueTimes, false);
+    assert.equal(loadConfig({ DUE_TIMES: 'on' }).dueTimes, true);
+    assert.deepEqual(loadConfig({}).dueHours, { urgent: 4, high: 24, normal: 72, low: 168 });
+  });
+
+  test('reads DUE_HOURS_* and names a value it cannot use', () => {
+    assert.deepEqual(loadConfig({ DUE_HOURS_URGENT: '2', DUE_HOURS_LOW: '10' }).dueHours, {
+      urgent: 2,
+      high: 24,
+      normal: 72,
+      low: 10,
+    });
+    assert.throws(() => loadConfig({ DUE_HOURS_HIGH: 'many' }), (error) => (
+      error instanceof ConfigError && /DUE_HOURS_HIGH must be a whole number/.test(error.message)
+    ));
+  });
+});
+
+describe('parseListQuery overdue', () => {
+  test('without due times, overdue is unknown and ignored', () => {
+    assert.deepEqual(parseListQuery(new URLSearchParams('overdue=true')), { filters: {}, limit: 20, after: null });
+  });
+
+  test('with due times, overdue=true filters and a bad value is invalid', () => {
+    assert.equal(parseListQuery(new URLSearchParams('overdue=true'), { dueTimes: true }).overdue, true);
+    assert.equal(parseListQuery(new URLSearchParams('overdue=false'), { dueTimes: true }).overdue, false);
+    assert.throws(() => parseListQuery(new URLSearchParams('overdue=yes'), { dueTimes: true }), InvalidError);
+  });
+});
+
+describe('the store', () => {
+  test('sets due once from created and priority, and a later priority change does not move it', () => {
+    const clock = manualClock(T0);
+    const store = new TicketStore({ clock });
+    const created = store.createTicket({ title: 'VPN drops', requester: 'a@example.com', priority: 'urgent' }, 'dana');
+    assert.equal(created.due, '2025-09-01T12:00:00.000Z');
+    const updated = store.update('T-0001', { priority: 'low' }, 'dana');
+    assert.equal(updated.due, created.due);
+    assert.equal(updated.priority, 'low');
+  });
+
+  test('new tickets use the hours of this process; existing due times stay', () => {
+    const clock = manualClock(T0);
+    const first = new TicketStore({ clock, dueHours: { ...DEFAULT_DUE_HOURS, normal: 1 } });
+    first.createTicket({ title: 'One', requester: 'a@example.com', priority: 'normal' }, 'dana');
+    const again = new TicketStore({
+      clock,
+      dueHours: { ...DEFAULT_DUE_HOURS, normal: 10 },
+      state: JSON.parse(JSON.stringify(first.snapshot())),
+    });
+    assert.equal(again.get('T-0001').due, '2025-09-01T09:00:00.000Z');
+    assert.equal(again.createTicket({ title: 'Two', requester: 'a@example.com', priority: 'normal' }, 'dana').due, '2025-09-01T18:00:00.000Z');
+  });
+});
+
+describe('the data file', () => {
+  test('tickets already in a 1.4.0 file get due from created and priority, and keep it', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    writeData(file, [{
+      id: 'T-0001',
+      title: 'VPN drops',
+      priority: 'high',
+      requester: 'maria@example.com',
+      status: 'open',
+      created: T0,
+      updated: T0,
+    }]);
+    const clock = manualClock(T0);
+    TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(saved.version, 1);
+    assert.equal(saved.tickets[0].due, '2025-09-02T08:00:00.000Z');
+
+    const later = TicketStore.open({
+      clock,
+      persistence: createPersistence(file, { clock }),
+      dueHours: { ...DEFAULT_DUE_HOURS, high: 1 },
+    });
+    assert.equal(later.get('T-0001').due, '2025-09-02T08:00:00.000Z');
+  });
+
+  test('a file this release wrote still has version 1 and the 1.4.0 ticket fields', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock(T0);
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket({ title: 'VPN drops', requester: 'maria@example.com', priority: 'normal' }, 'dana');
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(document.version, 1);
+    const record = document.tickets[0];
+    for (const field of ['id', 'title', 'priority', 'requester', 'status', 'created', 'updated']) {
+      assert.equal(typeof record[field], 'string');
+    }
+    assert.equal(typeof record.due, 'string');
+    const as14 = {
+      id: record.id,
+      title: record.title,
+      priority: record.priority,
+      requester: record.requester,
+      status: record.status,
+      created: record.created,
+      updated: record.updated,
+    };
+    assert.equal(as14.id, 'T-0001');
+  });
+});
+
+describe('the API without DUE_TIMES', () => {
+  test('answers tickets exactly as today: no due, and overdue is ignored', async () => {
+    const clock = manualClock(T0);
+    await withService({ clock }, async (api) => {
+      const created = await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      assert.equal(created.status, 201);
+      assert.deepEqual(keys(created.body), TICKET_KEYS);
+      assert.equal('due' in created.body, false);
+      clock.advance(5 * HOUR);
+      const listed = await api.get('/tickets?overdue=true');
+      assert.equal(listed.status, 200);
+      assert.deepEqual(listed.body.items.map((ticket) => ticket.id), ['T-0001']);
+      assert.equal('due' in listed.body.items[0], false);
+    });
+  });
+});
+
+describe('the API with DUE_TIMES=on', () => {
+  test('every ticket shows due from its created time and priority', async () => {
+    await withService({ dueTimes: true, clock: manualClock(T0) }, async (api) => {
+      const expected = { urgent: 4, high: 24, normal: 72, low: 168 };
+      for (const [priority, hours] of Object.entries(expected)) {
+        const { status, body } = await api.post('/tickets', ticketBody({ title: priority, priority }));
+        assert.equal(status, 201);
+        assert.deepEqual(keys(body), TICKET_KEYS_WITH_DUE);
+        assert.equal(body.due, dueAt(T0, priority));
+        assert.equal((await api.get(`/tickets/${body.id}`)).body.due, body.due);
+        assert.equal(Date.parse(body.due) - Date.parse(body.created), hours * HOUR);
+      }
+    });
+  });
+
+  test('uses DUE_HOURS_* for new tickets', async () => {
+    const loaded = loadConfig({ DUE_TIMES: 'on', DUE_HOURS_URGENT: '1' });
+    await withService({ dueTimes: loaded.dueTimes, dueHours: loaded.dueHours, clock: manualClock(T0) }, async (api) => {
+      const { body } = await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      assert.equal(body.due, '2025-09-01T09:00:00.000Z');
+    });
+  });
+
+  test('changing priority does not move due', async () => {
+    await withService({ dueTimes: true, clock: manualClock(T0) }, async (api) => {
+      const { body: created } = await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      const { body: patched } = await api.patch('/tickets/T-0001', { priority: 'low' });
+      assert.equal(patched.priority, 'low');
+      assert.equal(patched.due, created.due);
+    });
+  });
+
+  test('GET /tickets?overdue=true lists only open and in-progress tickets whose due time has passed', async () => {
+    const clock = manualClock(T0);
+    await withService({ dueTimes: true, clock }, async (api) => {
+      await api.post('/tickets', ticketBody({ title: 'urgent open', priority: 'urgent' }));
+      await api.post('/tickets', ticketBody({ title: 'urgent progress', priority: 'urgent' }));
+      await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+      await api.post('/tickets', ticketBody({ title: 'urgent resolved', priority: 'urgent' }));
+      await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+      await api.post('/tickets/T-0003/transition', { to: 'resolved' });
+      await api.post('/tickets', ticketBody({ title: 'low still waiting', priority: 'low' }));
+
+      assert.deepEqual((await api.get('/tickets?overdue=true')).body.items.map((ticket) => ticket.id), []);
+
+      clock.advance(4 * HOUR);
+      const overdue = await api.get('/tickets?overdue=true');
+      assert.equal(overdue.status, 200);
+      assert.deepEqual(overdue.body.items.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+      assert.equal(overdue.body.items.every((ticket) => ticket.due <= clock.now().toISOString()), true);
+    });
+  });
+
+  test('a bad overdue value is 400 invalid', async () => {
+    await withService({ dueTimes: true }, async (api) => {
+      const { status, body } = await api.get('/tickets?overdue=yes');
+      assert.equal(status, 400);
+      assert.equal(body.error.code, 'invalid');
+    });
+  });
+});
+
+describe('rollout', () => {
+  test('a restarted service with DUE_TIMES=on shows due times written while the flag was off', async (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    const clock = manualClock(T0);
+    await withService({ dataFile, clock }, async (api) => {
+      const { body } = await api.post('/tickets', ticketBody({ priority: 'high' }));
+      assert.equal('due' in body, false);
+    });
+    const saved = JSON.parse(fs.readFileSync(dataFile, 'utf8'));
+    assert.equal(saved.tickets[0].due, '2025-09-02T08:00:00.000Z');
+    await withService({ dataFile, clock, dueTimes: true }, async (api) => {
+      const { body } = await api.get('/tickets/T-0001');
+      assert.equal(body.due, '2025-09-02T08:00:00.000Z');
+    });
+  });
+});
diff --git a/test/import.test.js b/test/import.test.js
