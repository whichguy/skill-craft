+      assert.deepEqual(ids(await api.get('/tickets?assignee=')), ['T-0003']);
+    });
+  });
+
+  test('a ticket must match every filter given', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      assert.deepEqual(ids(await api.get('/tickets?status=open&assignee=dana')), ['T-0001']);
+      assert.deepEqual(ids(await api.get('/tickets?status=in_progress&assignee=dana')), []);
+      assert.deepEqual(ids(await api.get('/tickets?status=in_progress&assignee=sam')), ['T-0002']);
+      assert.deepEqual(ids(await api.get('/tickets?status=open&assignee=')), ['T-0003']);
+    });
+  });
+});
+
+describe('TicketStore.assign', () => {
+  const input = { title: 'Laptop will not boot', requester: 'li@example.com', priority: 'normal' };
+
+  test('records the change, notifies the agent, and a missing ticket is not found', () => {
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    const store = new TicketStore({ clock });
+    store.createTicket(input, 'dana');
+    clock.advance(60_000);
+    const assigned = store.assign('T-0001', 'sam', 'dana');
+    assert.equal(assigned.assignee, 'sam');
+    assert.equal(assigned.updated, '2025-09-01T08:01:00.000Z');
+    assert.deepEqual(store.history('T-0001').at(-1).changes, { assignee: { from: null, to: 'sam' } });
+    const [event] = store.outboxReport().pending.filter((item) => item.type === 'ticket.assigned');
+    assert.equal(event.to, 'sam');
+    assert.equal(event.key, 'ticket.assigned:T-0001:sam');
+    assert.throws(() => store.assign('T-0042', 'sam', 'dana'), NotFoundError);
+  });
+
+  test('a resolved ticket cannot change assignee', () => {
+    const store = new TicketStore({ clock: manualClock() });
+    store.createTicket(input, 'dana');
+    store.transition('T-0001', 'in_progress', 'dana');
+    store.transition('T-0001', 'resolved', 'dana');
+    assert.throws(() => store.assign('T-0001', 'sam', 'dana'), ConflictError);
+    assert.equal(store.get('T-0001').assignee, null);
+  });
+});
+
+describe('persistence', () => {
+  test('keeps assignee across restart; a 1.5.0 file loads as unassigned', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket({ title: 'VPN drops', requester: 'maria@example.com', priority: 'high' }, 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    const again = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(again.get('T-0001').assignee, 'sam');
+
+    const old = path.join(folder(t), 'old.json');
+    fs.writeFileSync(old, `${JSON.stringify({
+      version: 1,
+      savedAt: '2025-09-01T08:00:00.000Z',
+      nextNumber: 2,
+      tickets: [{
+        id: 'T-0001',
+        title: 'Printer jams',
+        priority: 'low',
+        requester: 'li@example.com',
+        status: 'open',
+        created: '2025-09-01T08:00:00.000Z',
+        updated: '2025-09-01T08:00:00.000Z',
+      }],
+      audit: [],
+      outbox: { nextId: 1, events: [] },
+    }, null, 2)}\n`);
+    const loaded = TicketStore.open({ clock, persistence: createPersistence(old, { clock }) });
+    assert.equal(loaded.get('T-0001').assignee, null);
+  });
+});
+
+describe('command line', () => {
+  test('list shows each ticket\'s assignee and show includes it', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket({ title: 'VPN drops', requester: 'maria@example.com', priority: 'high' }, 'dana');
+    store.createTicket({ title: 'Printer jams', requester: 'li@example.com', priority: 'low' }, 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+
+    const listed = runCli(['list'], file);
+    assert.equal(listed.code, 0);
+    assert.match(listed.text, /ASSIGNEE/);
+    assert.match(listed.text, /sam/);
+    const raw = runCli(['list', '--raw'], file);
+    assert.equal(raw.text.split('\n')[0].split('\t').slice(0, 4).join('\t'), 'T-0001\topen\thigh\tVPN drops');
+    const shown = runCli(['show', 'T-0001'], file);
+    assert.match(shown.text, /assignee\s+sam/);
+    const filtered = runCli(['list', '--assignee', 'sam'], file);
+    assert.match(filtered.text, /T-0001/);
+    assert.equal(filtered.text.includes('T-0002'), false);
+  });
+});
+
+test('an assignment notification is worded for the agent', () => {
+  const message = render({
+    ticket: 'T-0007',
+    type: 'ticket.assigned',
+    data: { title: 'Laptop will not boot' },
+  });
+  assert.equal(message.subject, '[T-0007] Assigned to you');
+  assert.match(message.body, /T-0007/);
+  assert.match(message.body, /Laptop will not boot/);
+  assert.match(message.body, /assigned to you/);
+});
