+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { main } = require('../bin/tickets.js');
+const { manualClock } = require('../src/clock');
+const { ConflictError, NotFoundError } = require('../src/errors');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { render } = require('../src/templates');
+const { ticketBody, withService } = require('./helpers');
+
+const envelope = (response, status, code) => {
+  assert.equal(response.status, status, JSON.stringify(response.body));
+  assert.equal(response.body.error.code, code);
+  assert.equal(typeof response.body.error.message, 'string');
+};
+
+const ids = (response) => response.body.items.map((ticket) => ticket.id);
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+function runCli(argv, file) {
+  const chunks = [];
+  const errors = [];
+  const code = main(argv, {
+    env: { DATA_FILE: file },
+    out: { write(text) { chunks.push(text); } },
+    err: { write(text) { errors.push(text); } },
+  });
+  return { code, text: chunks.join(''), err: errors.join('') };
+}
+
+describe('PUT /tickets/:id/assignee', () => {
+  test('assigns an agent and answers the ticket with assignee', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const { status, body } = await api.put('/tickets/T-0001/assignee', { assignee: 'dana' }, { 'X-Actor': 'sam' });
+      assert.equal(status, 200);
+      assert.equal(body.assignee, 'dana');
+      assert.equal(body.id, 'T-0001');
+      assert.deepEqual((await api.get('/tickets/T-0001')).body, body);
+      const history = (await api.get('/tickets/T-0001/audit')).body.items;
+      assert.equal(history.at(-1).action, 'ticket.assigned');
+      assert.equal(history.at(-1).actor, 'sam');
+      assert.deepEqual(history.at(-1).changes, { assignee: { from: null, to: 'dana' } });
+    });
+  });
+
+  test('unassigns with null and trims the agent name', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: '  dana  ' })).body.assignee, 'dana');
+      const { status, body } = await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.equal(status, 200);
+      assert.equal(body.assignee, null);
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, null);
+    });
+  });
+
+  test('assigning the agent it already has changes nothing', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const first = await api.put('/tickets/T-0001/assignee', { assignee: 'dana' });
+      const again = await api.put('/tickets/T-0001/assignee', { assignee: 'dana' });
+      assert.equal(again.body.updated, first.body.updated);
+      assert.equal((await api.get('/tickets/T-0001/audit')).body.items.length, 2);
+      const pending = (await api.get('/admin/outbox')).body.pending.filter((event) => event.type === 'ticket.assigned');
+      assert.equal(pending.length, 1);
+    });
+  });
+
+  test('only open and in-progress tickets can change assignee', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const progressed = await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.equal(progressed.status, 200);
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'dana' })).body.assignee, 'dana');
+
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+      envelope(await api.put('/tickets/T-0001/assignee', { assignee: 'sam' }), 409, 'conflict');
+      envelope(await api.put('/tickets/T-0001/assignee', { assignee: null }), 409, 'conflict');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'dana');
+
+      await api.post('/tickets/T-0001/transition', { to: 'closed' });
+      envelope(await api.put('/tickets/T-0001/assignee', { assignee: 'sam' }), 409, 'conflict');
+    });
+  });
+
+  test('answers 400 for a bad body and 404 when the ticket is missing', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      envelope(await api.put('/tickets/T-0001/assignee', {}), 400, 'invalid');
