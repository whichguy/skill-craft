+      envelope(await api.put('/tickets/T-0099/assignee', { assignee: 'dana' }), 404, 'not_found');
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'a'.repeat(64) })).body.assignee.length, 64);
