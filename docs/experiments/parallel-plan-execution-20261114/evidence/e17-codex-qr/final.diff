+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { withService, ticketBody } = require('./helpers');
+const { TicketStore } = require('../src/store');
+const { manualClock } = require('../src/clock');
+const { createPersistence } = require('../src/persistence');
+
+test('imports in order, sharing ordinary creation validation, audit and notifications', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const response = await api.post('/tickets/import', { tickets: [
+      { title: '  Old issue  ', requester: ' first ' },
+      ticketBody({ title: 'Second issue', requester: 'second', priority: 'urgent' }),
+    ] }, { 'X-Actor': 'migration' });
+    assert.equal(response.status, 201);
+    assert.deepEqual(response.body, { created: 2, ids: ['T-0002', 'T-0003'] });
+    assert.equal(service.store.get('T-0002').title, 'Old issue');
+    assert.equal(service.store.get('T-0002').priority, 'normal');
+    assert.equal(service.store.get('T-0003').priority, 'urgent');
+    for (const id of response.body.ids) {
+      const entries = service.store.history(id);
+      assert.equal(entries.length, 1);
+      assert.equal(entries[0].actor, 'migration');
+      assert.equal(entries[0].action, 'ticket.created');
+    }
+    service.worker.tick();
+    assert.deepEqual(service.notifier.delivered.slice(1).map(event => [event.ticket, event.to]), [
+      ['T-0002', 'first'], ['T-0003', 'second'],
+    ]);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0004');
+  });
+});
+
+test('first invalid item is indexed and leaves all state and ids untouched', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const before = service.store.snapshot();
+    const badItems = [null, [], 'ticket', 1, {}, ticketBody({ title: '' }),
+      ticketBody({ priority: 'critical' }), ticketBody({ owner: 'typo' })];
+    for (const item of badItems) {
+      const response = await api.post('/tickets/import', { tickets: [ticketBody(), item, null] });
+      assert.equal(response.status, 400);
+      assert.equal(response.body.error.code, 'invalid');
+      assert.match(response.body.error.message, /tickets\[1\]/);
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+    const response = await api.post('/tickets/import', { tickets: [null, ticketBody()] });
+    assert.match(response.body.error.message, /tickets\[0\]/);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+  });
+});
+
+test('validates batch shape, maximum size and actor, and accepts an empty batch', async () => {
+  await withService({}, async (api, service) => {
+    for (const body of [{}, { tickets: null }, { tickets: {} }, { tickets: [], extra: 1 },
+      { tickets: Array(5001).fill(ticketBody()) }]) {
+      assert.equal((await api.post('/tickets/import', body)).status, 400);
+    }
+    assert.equal((await api.post('/tickets/import', { tickets: [ticketBody()] }, { 'X-Actor': 'a'.repeat(65) })).status, 400);
+    assert.deepEqual(service.store.snapshot().tickets, []);
+    const empty = await api.post('/tickets/import', { tickets: [] });
+    assert.equal(empty.status, 201);
+    assert.deepEqual(empty.body, { created: 0, ids: [] });
+  });
+});
+
+test('imports 5000 tickets within ten seconds and persists the entire batch once', async t => {
+  const dir = fs.mkdtempSync(path.join(__dirname, 'import-data-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const file = path.join(dir, 'tickets.json');
+  await withService({ dataFile: file }, async (api, service) => {
+    const persistence = service.store.persistence;
+    let writes = 0;
+    service.store.persistence = { save(state) { writes++; persistence.save(state); } };
+    const tickets = Array.from({ length: 5000 }, (_, i) => ticketBody({ title: `Imported ${i}` }));
+    const start = performance.now();
+    const result = await api.post('/tickets/import', { tickets });
+    assert.equal(result.status, 201);
+    assert.ok(performance.now() - start < 10000);
+    assert.equal(result.body.created, 5000);
+    assert.equal(result.body.ids.length, 5000);
+    assert.equal(result.body.ids[0], 'T-0001');
+    assert.equal(result.body.ids.at(-1), 'T-5000');
+    assert.equal(writes, 1);
+    const reopened = TicketStore.open({ clock: manualClock(), persistence: createPersistence(file) });
+    assert.deepEqual(reopened.snapshot(), service.store.snapshot());
+    assert.equal(reopened.outboxReport().pending.length, 5000);
+    const before = fs.readFileSync(file, 'utf8');
+    assert.equal((await api.post('/tickets/import', { tickets: [ticketBody(), null] })).status, 400);
+    assert.equal(fs.readFileSync(file, 'utf8'), before);
+    assert.equal(writes, 1);
+  });
+});
