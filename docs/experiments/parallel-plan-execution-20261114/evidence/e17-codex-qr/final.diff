+const { main } = require('../bin/tickets');
+const { render } = require('../src/templates');
+
+test('assignment is audited, notifies each new assignee, and the same assignment does nothing', async () => {
+  await withService({}, async (api, service) => {
+    const ticket = (await api.post('/tickets', ticketBody())).body;
+    assert.equal(ticket.assignee, null);
+    const endpoint = `/tickets/${ticket.id}/assignee`;
+    assert.equal((await api.put(endpoint, { assignee: 'Dana' })).body.assignee, 'Dana');
+    const snapshot = service.store.snapshot();
+    assert.equal((await api.put(endpoint, { assignee: 'Dana' })).status, 200);
+    assert.deepEqual(service.store.snapshot(), snapshot);
+    await api.put(endpoint, { assignee: 'Sam' });
+    await api.put(endpoint, { assignee: null });
+    await api.put(endpoint, { assignee: 'Dana' });
+    const events = service.store.outboxReport().pending.filter(e => e.type === 'ticket.assigned');
+    assert.deepEqual(events.map(e => e.to), ['Dana', 'Sam', 'Dana']);
+    assert.match(render(events[0]).body, /assigned to you/);
+    const audit = service.store.history(ticket.id);
+    assert.deepEqual(audit[1].changes.assignee, { from: null, to: 'Dana' });
+  });
+});
+
+test('assignment validates names and permits changes only for active tickets', async () => {
+  await withService({}, async api => {
+    const ticket = (await api.post('/tickets', ticketBody())).body;
+    const endpoint = `/tickets/${ticket.id}/assignee`;
+    for (const body of [{}, { assignee: '' }, { assignee: ' ' }, { assignee: 5 }, { assignee: 'a'.repeat(65) }, { assignee: 'a\nb' }, { assignee: 'A', extra: 1 }]) {
+      assert.equal((await api.put(endpoint, body)).status, 400);
+    }
+    assert.equal((await api.put('/tickets/T-9999/assignee', { assignee: null })).status, 404);
+    await api.post(`/tickets/${ticket.id}/transition`, { to: 'in_progress' });
+    assert.equal((await api.put(endpoint, { assignee: 'a'.repeat(64) })).status, 200);
+    await api.post(`/tickets/${ticket.id}/transition`, { to: 'resolved' });
+    assert.equal((await api.put(endpoint, { assignee: null })).status, 409);
+    await api.post(`/tickets/${ticket.id}/transition`, { to: 'closed' });
+    assert.equal((await api.put(endpoint, { assignee: 'Dana' })).status, 409);
+  });
+});
+
+test('assignee filters combine with every other listing filter', async () => {
+  await withService({}, async api => {
+    const a = (await api.post('/tickets', ticketBody({ priority: 'high' }))).body;
+    const b = (await api.post('/tickets', ticketBody({ priority: 'low' }))).body;
+    const c = (await api.post('/tickets', ticketBody({ priority: 'high' }))).body;
+    await api.put(`/tickets/${a.id}/assignee`, { assignee: 'Dana' });
+    await api.put(`/tickets/${b.id}/assignee`, { assignee: 'Dana' });
+    assert.deepEqual((await api.get('/tickets?assignee=Dana&priority=high&status=open')).body.items.map(t => t.id), [a.id]);
+    assert.deepEqual((await api.get('/tickets?assignee=')).body.items.map(t => t.id), [c.id]);
+  });
+});
+
+test('assignment survives persistence and CLI appends it after existing raw columns', t => {
+  const dir = fs.mkdtempSync(path.join(__dirname, 'assignment-data-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const file = path.join(dir, 'tickets.json');
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+  const ticket = store.createTicket(ticketBody(), 'operator');
+  store.assign(ticket.id, 'Dana', 'operator');
+  const reopened = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+  assert.equal(reopened.get(ticket.id).assignee, 'Dana');
+  let output = '';
+  const out = { write: value => { output += value; } };
+  assert.equal(main(['--data', file, 'list', '--raw'], { env: {}, out }), 0);
+  assert.deepEqual(output.trimEnd().split('\t'), [ticket.id, 'open', 'normal', ticket.title, 'Dana']);
+  output = '';
+  main(['--data', file, 'list'], { env: {}, out });
+  assert.match(output, /ASSIGNEE/);
+  assert.match(output, /Dana/);
+});
