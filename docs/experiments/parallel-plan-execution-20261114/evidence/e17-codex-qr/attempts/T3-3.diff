diff --git a/src/tickets/due.js b/src/tickets/due.js
new file mode 100644
index 0000000..dc0f49a
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,9 @@
+'use strict';
+
+const DEFAULT_DUE_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+function dueAt(created, priority, hours = DEFAULT_DUE_HOURS) {
+  return new Date(Date.parse(created) + hours[priority] * 60 * 60 * 1000).toISOString();
+}
+
+module.exports = { DEFAULT_DUE_HOURS, dueAt };
