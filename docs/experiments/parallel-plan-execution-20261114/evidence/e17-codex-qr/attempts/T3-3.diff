diff --git a/test/due.test.js b/test/due.test.js
new file mode 100644
index 0000000..110921a
--- /dev/null
+++ b/test/due.test.js
@@ -0,0 +1,132 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { loadConfig } = require('../src/config');
+const { manualClock } = require('../src/clock');
+const { TicketStore } = require('../src/store');
+const { createPersistence } = require('../src/persistence');
+const { ticketBody, withService } = require('./helpers');
+
+function dataFile(t) {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return path.join(dir, 'tickets.json');
+}
+
+test('due defaults cover each priority, including imported tickets', async () => {
+  await withService({ dueTimes: true }, async (api) => {
+    for (const [priority, hours] of Object.entries({ urgent: 4, high: 24, normal: 72, low: 168 })) {
+      const { body, status } = await api.post('/tickets', ticketBody({ priority }));
+      assert.equal(status, 201);
+      assert.equal(Date.parse(body.due) - Date.parse(body.created), hours * 3600000);
+      assert.equal((await api.get(`/tickets/${body.id}`)).body.due, body.due);
+    }
+    const imported = await api.post('/tickets/import', { tickets: [ticketBody({ priority: 'urgent' })] });
+    assert.equal(imported.status, 201);
+    assert.ok((await api.get(`/tickets/${imported.body.ids[0]}`)).body.due);
+  });
+});
+
+test('due environment settings validate and default independently', () => {
+  assert.equal(loadConfig({}).dueTimes, false);
+  assert.equal(loadConfig({ DUE_TIMES: 'on' }).dueTimes, true);
+  assert.equal(loadConfig({ DUE_TIMES: 'true' }).dueTimes, false);
+  assert.deepEqual(loadConfig({ DUE_HOURS_URGENT: '2' }).dueHours, { urgent: 2, high: 24, normal: 72, low: 168 });
+  for (const value of ['-1', '0', 'no', '1.2', '999999999999999999']) {
+    assert.throws(() => loadConfig({ DUE_HOURS_LOW: value }), /DUE_HOURS_LOW/);
+  }
+});
+
+test('disabled feature preserves responses and ignores the overdue parameter', async () => {
+  await withService({}, async (api, service) => {
+    const { body } = await api.post('/tickets', ticketBody());
+    assert.equal('due' in body, false);
+    assert.ok(service.store.snapshot().tickets[0].due);
+    assert.equal('due' in (await api.get(`/tickets/${body.id}`)).body, false);
+    const all = await api.get('/tickets');
+    assert.deepEqual((await api.get('/tickets?overdue=true')).body, all.body);
+    assert.deepEqual((await api.get('/tickets?overdue=garbage')).body, all.body);
+  });
+});
+
+test('overdue uses strict time boundary, active status, filters and cursor pages', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true }, async (api) => {
+    for (let i = 0; i < 4; i++) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0004/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'closed' });
+    clock.advance(4 * 3600000);
+    assert.deepEqual((await api.get('/tickets?overdue=true')).body.items, []);
+    clock.advance(1);
+    const first = (await api.get('/tickets?overdue=true&limit=1')).body;
+    assert.deepEqual(first.items.map((ticket) => ticket.id), ['T-0001']);
+    const second = (await api.get(`/tickets?overdue=true&limit=1&cursor=${first.next}`)).body;
+    assert.deepEqual(second.items.map((ticket) => ticket.id), ['T-0002']);
+    assert.equal(second.next, null);
+    assert.deepEqual((await api.get('/tickets?overdue=true&status=in_progress')).body.items.map((t) => t.id), ['T-0002']);
+    assert.equal((await api.get('/tickets?overdue=true&priority=low')).body.items.length, 0);
+    assert.equal((await api.get('/tickets?overdue=false')).body.items.length, 4);
+    assert.equal((await api.get('/tickets?overdue=maybe')).status, 400);
+  });
+});
+
+test('backfill saves before enabling and never resets due after priority or hours changes', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const persistence = createPersistence(file, { clock });
+  const old = TicketStore.open({ clock, persistence });
+  old.createTicket(ticketBody({ priority: 'high' }), 'operator');
+  // A production file made before due times existed.
+  const legacy = JSON.parse(fs.readFileSync(file));
+  delete legacy.tickets[0].due;
+  fs.writeFileSync(file, JSON.stringify(legacy));
+  const upgraded = TicketStore.open({ clock, persistence });
+  const due = JSON.parse(fs.readFileSync(file)).tickets[0].due;
+  assert.equal(Date.parse(due) - Date.parse(legacy.tickets[0].created), 24 * 3600000);
+  assert.equal('due' in upgraded.get('T-0001'), false);
+  assert.deepEqual(upgraded.history('T-0001'), old.history('T-0001'));
+  upgraded.update('T-0001', { priority: 'urgent' }, 'operator');
+  const enabled = TicketStore.open({ clock, persistence, dueTimes: true, dueHours: { urgent: 1, high: 1, normal: 1, low: 1 } });
+  assert.equal(enabled.get('T-0001').due, due);
+  const fresh = enabled.createTicket(ticketBody({ priority: 'low' }), 'operator');
+  assert.equal(Date.parse(fresh.due) - Date.parse(fresh.created), 3600000);
+  assert.equal(JSON.parse(fs.readFileSync(file)).version, 1);
+  // Reconstitute the pre-feature persistence reader by removing only the two additive due-field lines.
+  // This checks the new document against the original version/record validation and projection.
+  const vm = require('node:vm');
+  const { createRequire } = require('node:module');
+  const sourcePath = require.resolve('../src/persistence');
+  const originalSource = fs.readFileSync(sourcePath, 'utf8')
+    .replace("    ...(ticket.due === undefined ? {} : { due: ticket.due }),\n", '')
+    .replace('  if (ticket.due !== undefined) time(ticket.due, `${where}.due`, fail);\n', '');
+  const legacyModule = { exports: {} };
+  vm.runInNewContext(originalSource, { require: createRequire(sourcePath), module: legacyModule, process });
+  const rollback = legacyModule.exports.createPersistence(file).load();
+  assert.equal(rollback.tickets.length, 2);
+  assert.equal(rollback.tickets[0].id, 'T-0001');
+  assert.equal(rollback.tickets[1].id, 'T-0002');
+  assert.equal('due' in rollback.tickets[0], false);
+});
+
+test('malformed persisted due refuses startup and migration failures prevent exposure', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const persistence = createPersistence(file, { clock });
+  TicketStore.open({ clock, persistence }).createTicket(ticketBody(), 'operator');
+  const doc = JSON.parse(fs.readFileSync(file));
+  doc.tickets[0].due = 'bad';
+  fs.writeFileSync(file, JSON.stringify(doc));
+  assert.throws(() => persistence.load(), /tickets\[0\].due is not a time/);
+  delete doc.tickets[0].due;
+  assert.throws(() => TicketStore.open({ clock, dueTimes: true, persistence: {
+    load: () => doc,
+    save: () => { throw new Error('disk full'); },
+  } }), /disk full/);
+});
