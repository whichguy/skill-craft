+++ b/test/assignment.test.js
@@ -0,0 +1,99 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { TicketStore } = require('../src/store');
+const { createPersistence } = require('../src/persistence');
+const { createNotifier } = require('../src/notifier');
+const { main } = require('../bin/tickets');
+const { ticketBody, withService } = require('./helpers');
+
+test('assignment is audited, notifies every new assignee, and same assignment changes nothing', async () => {
+  await withService({}, async (api, service) => {
+    const created = await api.post('/tickets', ticketBody());
+    assert.equal(created.body.assignee, null);
+    const route = `/tickets/${created.body.id}/assignee`;
+    const assigned = await api.put(route, { assignee: 'dana' }, { 'X-Actor': 'sam' });
+    assert.equal(assigned.status, 200);
+    assert.equal(assigned.body.assignee, 'dana');
+    const before = service.store.snapshot();
+    assert.deepEqual((await api.put(route, { assignee: 'dana' })).body, assigned.body);
+    assert.deepEqual(service.store.snapshot(), before);
+    await api.put(route, { assignee: 'lee' });
+    await api.put(route, { assignee: null });
+    await api.put(route, { assignee: 'dana' });
+    const events = service.store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned');
+    assert.deepEqual(events.map((event) => event.to), ['dana', 'lee', 'dana']);
+    const notifier = createNotifier({ clock: manualClock() });
+    assert.match(notifier.deliver(events[0]).body, /assigned to you/);
+    const history = service.store.history(created.body.id);
+    assert.equal(history[1].actor, 'sam');
+    assert.deepEqual(history[1].changes, { assignee: { from: null, to: 'dana' } });
+    assert.deepEqual(history[3].changes, { assignee: { from: 'lee', to: null } });
+  });
+});
+
+test('assignment validation and state conflicts use error envelopes', async () => {
+  await withService({}, async (api) => {
+    await api.post('/tickets', ticketBody());
+    const route = '/tickets/T-0001/assignee';
+    for (const assignee of ['', ' ', 'x'.repeat(65), 3, false, {}, [], 'a\nb']) {
+      const response = await api.put(route, { assignee });
+      assert.equal(response.status, 400);
+      assert.equal(response.body.error.code, 'invalid');
+    }
+    assert.equal((await api.put(route, {})).status, 400);
+    assert.equal((await api.put(route, { assignee: 'a', extra: true })).status, 400);
+    assert.equal((await api.put(route, { assignee: 'x'.repeat(64) })).status, 200);
+    assert.equal((await api.put('/tickets/T-9999/assignee', { assignee: 'a' })).status, 404);
+    await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+    assert.equal((await api.put(route, { assignee: null })).status, 200);
+    await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+    for (const assignee of [null, 'dana']) assert.equal((await api.put(route, { assignee })).status, 409);
+    await api.post('/tickets/T-0001/transition', { to: 'closed' });
+    for (const assignee of [null, 'dana']) assert.equal((await api.put(route, { assignee })).status, 409);
+  });
+});
+
+test('assignee filters combine with every other filter and paginate matching tickets', async () => {
+  await withService({}, async (api) => {
+    for (const priority of ['high', 'low', 'high', 'high']) await api.post('/tickets', ticketBody({ priority }));
+    for (const id of ['T-0001', 'T-0002', 'T-0003']) await api.put(`/tickets/${id}/assignee`, { assignee: 'dana' });
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+    const result = await api.get('/tickets?assignee=dana&priority=high&status=open');
+    assert.deepEqual(result.body.items.map((ticket) => ticket.id), ['T-0001']);
+    assert.deepEqual((await api.get('/tickets?assignee=')).body.items.map((ticket) => ticket.id), ['T-0004']);
+    const first = (await api.get('/tickets?assignee=dana&limit=1')).body;
+    const next = (await api.get(`/tickets?assignee=dana&limit=1&cursor=${encodeURIComponent(first.next)}`)).body;
+    assert.deepEqual(next.items.map((ticket) => ticket.id), ['T-0002']);
+    assert.equal((await api.get('/tickets?assignee=nobody')).body.items.length, 0);
+  });
+});
+
+test('assignment survives persistence and CLI appends it after existing raw columns', (t) => {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.assignment-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const file = path.join(dir, 'tickets.json');
+  const clock = manualClock();
+  const persistence = createPersistence(file, { clock });
+  const store = TicketStore.open({ clock, persistence });
+  const ticket = store.create(ticketBody(), 'sam');
+  store.assign(ticket.id, 'dana', 'sam');
+  const reopened = TicketStore.open({ clock, persistence });
+  assert.equal(reopened.get(ticket.id).assignee, 'dana');
+  let output = '';
+  const out = { write: (text) => { output += text; } };
+  assert.equal(main(['--data', file, 'list', '--raw'], { out }), 0);
+  assert.deepEqual(output.trim().split('\t'), [ticket.id, 'open', 'normal', ticket.title, 'dana']);
+  output = '';
+  assert.equal(main(['--data', file, 'list'], { out }), 0);
+  assert.match(output, /ASSIGNEE/);
+  assert.match(output, /dana/);
+  const legacy = JSON.parse(fs.readFileSync(file, 'utf8'));
+  delete legacy.tickets[0].assignee;
+  fs.writeFileSync(file, JSON.stringify(legacy));
+  assert.equal(TicketStore.open({ clock, persistence }).get(ticket.id).assignee, null);
+});
