diff --git a/test/import.test.js b/test/import.test.js
new file mode 100644
index 0000000..d34bcc1
--- /dev/null
+++ b/test/import.test.js
@@ -0,0 +1,112 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { performance } = require('node:perf_hooks');
+const { ticketBody, withService } = require('./helpers');
+const { deliverOutbox } = require('../src/worker');
+const { silentLogger } = require('../src/log');
+
+test('imports in order with ordinary creation fields, audit and requester notifications', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const response = await api.post('/tickets/import', { tickets: [
+      { title: '  First  ', requester: '  one@example.com  ' },
+      ticketBody({ title: 'Second', requester: 'two@example.com', priority: 'urgent' }),
+    ] }, { 'X-Actor': 'migration' });
+    assert.equal(response.status, 201);
+    assert.deepEqual(response.body, { created: 2, ids: ['T-0002', 'T-0003'] });
+    for (const [index, id] of response.body.ids.entries()) {
+      const ticket = (await api.get(`/tickets/${id}`)).body;
+      assert.equal(ticket.title, ['First', 'Second'][index]);
+      assert.equal(ticket.priority, ['normal', 'urgent'][index]);
+      assert.equal(ticket.status, 'open');
+      const [entry] = (await api.get(`/tickets/${id}/audit`)).body.items;
+      assert.equal(entry.actor, 'migration');
+      assert.equal(entry.action, 'ticket.created');
+      assert.deepEqual(entry.changes.requester, { from: null, to: ticket.requester });
+    }
+    await deliverOutbox({ store: service.store, notifier: service.notifier, log: silentLogger }).run();
+    assert.deepEqual(service.notifier.delivered.slice(1).map((event) => [event.ticket, event.to]), [
+      ['T-0002', 'one@example.com'], ['T-0003', 'two@example.com'],
+    ]);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0004');
+  });
+});
+
+test('rejects the first invalid index without changing tickets, audit, notifications or ids', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const before = service.store.snapshot();
+    for (const invalid of [null, [], 3, 'ticket', {}, ticketBody({ priority: 'critical' }), ticketBody({ owner: 'x' })]) {
+      const response = await api.post('/tickets/import', { tickets: [ticketBody(), invalid, null] });
+      assert.equal(response.status, 400);
+      assert.equal(response.body.error.code, 'invalid');
+      assert.match(response.body.error.message, /tickets\[1\]/);
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+    const response = await api.post('/tickets/import', { tickets: [null, ticketBody()] });
+    assert.match(response.body.error.message, /tickets\[0\]/);
+    assert.deepEqual(service.store.snapshot(), before);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+  });
+});
+
+test('checks the envelope, count, JSON and actor, and accepts an empty import', async () => {
+  await withService({}, async (api, service) => {
+    for (const body of [{}, { tickets: null }, { tickets: {} }, { tickets: [], extra: 1 },
+      { tickets: Array(5001).fill(ticketBody()) }, '{"tickets":', []]) {
+      const response = await api.post('/tickets/import', body);
+      assert.equal(response.status, 400);
+      assert.equal(response.body.error.code, 'invalid');
+    }
+    assert.equal((await api.post('/tickets/import', { tickets: [ticketBody()] }, { 'X-Actor': 'x'.repeat(65) })).status, 400);
+    assert.equal(service.store.snapshot().tickets.length, 0);
+    const response = await api.post('/tickets/import', { tickets: [] });
+    assert.equal(response.status, 201);
+    assert.deepEqual(response.body, { created: 0, ids: [] });
+  });
+});
+
+test('imports 5000 tickets within ten seconds and persists all effects in one save', async () => {
+  // Keep all test-created files within this checkout.
+  const directory = fs.mkdtempSync(path.join(__dirname, '.import-'));
+  const dataFile = path.join(directory, 'tickets.json');
+  try {
+    await withService({ dataFile }, async (api, service) => {
+      let saves = 0;
+      const save = service.store.persistence.save.bind(service.store.persistence);
+      service.store.persistence.save = (state) => { saves += 1; save(state); };
+      const tickets = Array.from({ length: 5000 }, (_, index) => ticketBody({ title: `Imported ${index}` }));
+      const started = performance.now();
+      const response = await api.post('/tickets/import', { tickets });
+      assert.equal(response.status, 201);
+      assert.ok(performance.now() - started < 10000);
+      assert.equal(response.body.created, 5000);
+      assert.equal(response.body.ids.length, 5000);
+      assert.equal(response.body.ids[0], 'T-0001');
+      assert.equal(response.body.ids[4999], 'T-5000');
+      assert.equal(saves, 1);
+      const saved = service.store.persistence.load();
+      assert.equal(saved.tickets.length, 5000);
+      assert.equal(saved.audit.length, 5000);
+      assert.equal(saved.outbox.events.length, 5000);
+      assert.equal(saved.tickets[4999].title, 'Imported 4999');
+      const before = service.store.snapshot();
+      tickets[4999] = ticketBody({ title: '' });
+      const invalid = await api.post('/tickets/import', { tickets });
+      assert.equal(invalid.status, 400);
+      assert.match(invalid.body.error.message, /tickets\[4999\]/);
+      assert.deepEqual(service.store.snapshot(), before);
+      assert.equal(saves, 1);
+    });
+    await withService({ dataFile }, async (api) => {
+      assert.equal((await api.get('/tickets/T-5000')).body.title, 'Imported 4999');
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-5001');
+    });
+  } finally {
+    fs.rmSync(directory, { recursive: true, force: true });
+  }
+});
