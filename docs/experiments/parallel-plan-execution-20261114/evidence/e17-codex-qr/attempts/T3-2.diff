diff --git a/test/due.test.js b/test/due.test.js
new file mode 100644
index 0000000..1855c75
--- /dev/null
+++ b/test/due.test.js
@@ -0,0 +1,119 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { loadConfig, ConfigError } = require('../src/config');
+const { TicketStore } = require('../src/store');
+const { createPersistence, DataFileError } = require('../src/persistence');
+const { ticketBody, withService } = require('./helpers');
+
+function dataFile(t) {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.due-data-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return path.join(dir, 'tickets.json');
+}
+
+test('response hours are configurable and invalid values name their variable', () => {
+  assert.equal(loadConfig({}).dueTimes, false);
+  assert.equal(loadConfig({ DUE_TIMES: 'ON' }).dueTimes, false);
+  assert.equal(loadConfig({ DUE_TIMES: 'on' }).dueTimes, true);
+  assert.deepEqual(loadConfig({}).responseHours, { urgent: 4, high: 24, normal: 72, low: 168 });
+  assert.equal(loadConfig({ RESPONSE_HOURS_HIGH: '12' }).responseHours.high, 12);
+  for (const value of ['-1', '0', '1.5', 'infinite']) {
+    assert.throws(() => loadConfig({ RESPONSE_HOURS_HIGH: value }),
+      (error) => error instanceof ConfigError && /RESPONSE_HOURS_HIGH/.test(error.message));
+  }
+});
+
+test('every priority receives its due time and a priority change leaves it fixed', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock, dueTimes: true });
+  for (const [priority, hours] of Object.entries({ urgent: 4, high: 24, normal: 72, low: 168 })) {
+    const ticket = store.createTicket(ticketBody({ priority }), 'agent');
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), hours * 3600000);
+    clock.advance(1000);
+    assert.equal(store.update(ticket.id, { priority: 'low' }, 'agent').due, ticket.due);
+    assert.equal(store.get(ticket.id).due, ticket.due);
+  }
+});
+
+test('disabled HTTP responses remain unchanged while the file receives due times', async (t) => {
+  const file = dataFile(t);
+  await withService({ dataFile: file }, async (api) => {
+    const created = (await api.post('/tickets', ticketBody())).body;
+    assert.equal('due' in created, false);
+    assert.equal('due' in (await api.get(`/tickets/${created.id}`)).body, false);
+    assert.equal('due' in (await api.patch(`/tickets/${created.id}`, { priority: 'high' })).body, false);
+    assert.equal((await api.get('/tickets?overdue=true')).body.items.length, 1);
+    assert.equal('due' in (await api.get('/tickets')).body.items[0], false);
+    assert.ok(JSON.parse(fs.readFileSync(file)).tickets[0].due);
+  });
+});
+
+test('enabled HTTP overdue filter excludes final states and the exact due boundary and paginates', async () => {
+  const clock = manualClock();
+  await withService({ dueTimes: true, clock }, async (api) => {
+    for (let i = 0; i < 4; i++) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0004/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'closed' });
+    clock.advance(4 * 3600000);
+    assert.deepEqual((await api.get('/tickets?overdue=true')).body.items, []);
+    clock.advance(1);
+    const page = (await api.get('/tickets?overdue=true&limit=1')).body;
+    assert.equal(page.items[0].id, 'T-0001');
+    assert.ok(page.items[0].due);
+    const next = (await api.get(`/tickets?overdue=true&limit=1&cursor=${encodeURIComponent(page.next)}`)).body;
+    assert.deepEqual(next.items.map((ticket) => ticket.id), ['T-0002']);
+    assert.equal(next.next, null);
+    assert.equal((await api.get('/tickets?overdue=false')).body.items.length, 4);
+    assert.equal((await api.get('/tickets?overdue=invalid')).status, 400);
+  });
+});
+
+test('startup backfills legacy tickets before enablement and restarts retain the saved deadlines', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const persistence = createPersistence(file, { clock });
+  const seed = TicketStore.open({ clock, persistence });
+  seed.createTicket(ticketBody({ priority: 'high' }), 'agent');
+  const legacy = JSON.parse(fs.readFileSync(file));
+  delete legacy.tickets[0].due;
+  fs.writeFileSync(file, JSON.stringify(legacy));
+  clock.advance(200 * 3600000);
+  const migrated = TicketStore.open({ clock, persistence, responseHours: { high: 12 } });
+  assert.equal('due' in migrated.get('T-0001'), false);
+  const document = JSON.parse(fs.readFileSync(file));
+  const due = document.tickets[0].due;
+  assert.equal(Date.parse(due) - Date.parse(legacy.tickets[0].created), 12 * 3600000);
+  assert.equal(document.version, 1, '1.4.0 can load the unchanged version and ignore the added field');
+  assert.deepEqual(document.audit, legacy.audit);
+  assert.deepEqual(document.outbox, legacy.outbox);
+  const restarted = TicketStore.open({ clock, persistence, dueTimes: true, responseHours: { high: 99 } });
+  assert.equal(restarted.get('T-0001').due, due);
+  assert.equal(restarted.list({ filters: { overdue: true } }).items.length, 1);
+});
+
+test('invalid persisted due is rejected and migration save failures prevent opening', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const persistence = createPersistence(file, { clock });
+  const seed = TicketStore.open({ clock, persistence });
+  seed.createTicket(ticketBody(), 'agent');
+  const document = JSON.parse(fs.readFileSync(file));
+  document.tickets[0].due = 'bad time';
+  fs.writeFileSync(file, JSON.stringify(document));
+  assert.throws(() => TicketStore.open({ clock, persistence }), DataFileError);
+  delete document.tickets[0].due;
+  fs.writeFileSync(file, JSON.stringify(document));
+  assert.throws(() => TicketStore.open({ clock, persistence: {
+    load: () => persistence.load(), save: () => { throw new Error('disk full'); },
+  } }), /disk full/);
+  assert.equal(JSON.parse(fs.readFileSync(file)).tickets[0].due, undefined);
+});
