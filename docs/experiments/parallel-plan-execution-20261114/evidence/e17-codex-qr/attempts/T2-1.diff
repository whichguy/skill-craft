diff --git a/test/import.test.js b/test/import.test.js
new file mode 100644
index 0000000..0686e0e
--- /dev/null
+++ b/test/import.test.js
@@ -0,0 +1,104 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { TicketStore } = require('../src/store');
+const { ticketBody, withService } = require('./helpers');
+
+test('import creates tickets in order with normal validation, audit and notifications', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const response = await api.post('/tickets/import', { tickets: [
+      { title: '  First  ', requester: ' one@example.com ' },
+      ticketBody({ title: 'Second', priority: 'urgent', requester: 'two@example.com' }),
+    ] }, { 'X-Actor': ' migration ' });
+    assert.equal(response.status, 201);
+    assert.deepEqual(response.body, { created: 2, ids: ['T-0002', 'T-0003'] });
+    assert.equal(service.store.get('T-0002').title, 'First');
+    assert.equal(service.store.get('T-0002').priority, 'normal');
+    assert.equal(service.store.get('T-0003').priority, 'urgent');
+    for (const id of response.body.ids) {
+      const ticket = service.store.get(id);
+      assert.equal(ticket.status, 'open');
+      assert.equal(ticket.created, ticket.updated);
+      const [entry] = service.store.history(id);
+      assert.equal(entry.actor, 'migration');
+      assert.equal(entry.action, 'ticket.created');
+      assert.deepEqual(entry.changes.title, { from: null, to: ticket.title });
+    }
+    assert.deepEqual(service.store.outboxReport().pending.slice(1).map((event) => [event.ticket, event.to, event.type]), [
+      ['T-0002', 'one@example.com', 'ticket.created'],
+      ['T-0003', 'two@example.com', 'ticket.created'],
+    ]);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0004');
+  });
+});
+
+test('import rejects the first invalid item without any ticket, audit, notification or id changes', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const before = service.store.snapshot();
+    for (const invalid of [null, [], 42, 'ticket', {}, ticketBody({ title: '' }), ticketBody({ priority: 'bad' }), ticketBody({ extra: true })]) {
+      const response = await api.post('/tickets/import', { tickets: [ticketBody(), invalid, null] });
+      assert.equal(response.status, 400);
+      assert.equal(response.body.error.code, 'invalid');
+      assert.match(response.body.error.message, /tickets\[1\]/);
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+    const response = await api.post('/tickets/import', { tickets: [null, null] });
+    assert.match(response.body.error.message, /tickets\[0\]/);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+  });
+});
+
+test('import rejects malformed envelopes, oversized batches and invalid actors, and accepts an empty batch', async () => {
+  await withService({}, async (api, service) => {
+    for (const input of ['{', null, [], {}, { tickets: null }, { tickets: {} }, { tickets: [], extra: true }, { tickets: Array(5001).fill(ticketBody()) }]) {
+      const response = await api.post('/tickets/import', input);
+      assert.equal(response.status, 400);
+      assert.equal(response.body.error.code, 'invalid');
+    }
+    assert.equal((await api.post('/tickets/import', { tickets: [ticketBody()] }, { 'X-Actor': 'a'.repeat(65) })).status, 400);
+    assert.equal(service.store.snapshot().tickets.length, 0);
+    assert.deepEqual((await api.post('/tickets/import', { tickets: [] })).body, { created: 0, ids: [] });
+  });
+});
+
+test('import stages all effects and saves once, retaining prior state if saving fails', () => {
+  let saves = 0;
+  let fail = false;
+  const store = new TicketStore({ clock: manualClock(), persistence: { save() { saves++; if (fail) throw new Error('disk full'); } } });
+  store.create(ticketBody(), 'system');
+  const before = store.snapshot();
+  fail = true;
+  assert.throws(() => store.importTickets([ticketBody(), ticketBody()], 'migration'), /disk full/);
+  assert.deepEqual(store.snapshot(), before);
+  fail = false;
+  assert.deepEqual(store.importTickets([ticketBody(), ticketBody()], 'migration'), { created: 2, ids: ['T-0002', 'T-0003'] });
+  assert.equal(saves, 3);
+});
+
+test('5000 imported tickets complete within ten seconds with persistence and survive restart', async (t) => {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.import-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const dataFile = path.join(dir, 'tickets.json');
+  await withService({ dataFile }, async (api) => {
+    const tickets = Array.from({ length: 5000 }, (_, index) => ticketBody({ title: `Ticket ${index} ${'x'.repeat(170)}` }));
+    const started = performance.now();
+    const response = await api.post('/tickets/import', { tickets });
+    assert.ok(performance.now() - started < 10000);
+    assert.equal(response.status, 201, JSON.stringify(response.body));
+    assert.equal(response.body.created, 5000);
+    assert.deepEqual(response.body.ids, Array.from({ length: 5000 }, (_, index) => `T-${String(index + 1).padStart(4, '0')}`));
+  });
+  await withService({ dataFile }, async (api, service) => {
+    assert.equal(service.store.snapshot().tickets.length, 5000);
+    assert.equal(service.store.audit.size, 5000);
+    assert.equal(service.store.outboxReport().pending.length, 5000);
+    assert.ok(service.store.get('T-5000').title.startsWith('Ticket 4999 '));
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-5001');
+  });
+});
