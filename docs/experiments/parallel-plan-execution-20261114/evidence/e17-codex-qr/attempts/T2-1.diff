+/** POST /tickets/import: validate the entire batch before the store changes anything. */
+function ticketImport(body) {
+  onlyFields(body, ['tickets']);
+  if (!Array.isArray(body.tickets)) throw new InvalidError('tickets must be an array');
+  if (body.tickets.length > 5000) throw new InvalidError('tickets must contain at most 5000 items');
+  return body.tickets.map((item, index) => {
+    try {
+      if (item === null || typeof item !== 'object' || Array.isArray(item)) {
+        throw new InvalidError('ticket must be a JSON object');
+      }
+      return newTicket(item);
+    } catch (error) {
+      if (!(error instanceof InvalidError)) throw error;
+      throw new InvalidError(`tickets[${index}]: ${error.message}`);
+    }
+  });
+}
