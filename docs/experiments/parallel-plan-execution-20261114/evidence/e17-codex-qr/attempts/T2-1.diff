+  /** Create a validated batch in order and persist the tickets, audit and outbox once. */
+  importTickets(inputs, actor) {
+    if (inputs.length === 0) return { created: 0, ids: [] };
+    // Stage the change so a failed save cannot leave a partially committed import in memory.
