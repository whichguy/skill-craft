@@ -0,0 +1,124 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { ConfigError, loadConfig } = require('../src/config');
+const { createPersistence } = require('../src/persistence');
+const { createPersistence: legacyPersistence } = require('./legacy-persistence.cjs');
+const { TicketStore } = require('../src/store');
+const { ticketBody, withService } = require('./helpers');
+const HOUR = 3600000;
+
+function dataFile(t) {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return path.join(dir, 'tickets.json');
+}
+
+test('response hours default by priority, accept environment overrides, and reject unusable values', () => {
+  assert.deepEqual(loadConfig({}).responseHours, { urgent: 4, high: 24, normal: 72, low: 168 });
+  assert.equal(loadConfig({ RESPONSE_HOURS_HIGH: '12' }).responseHours.high, 12);
+  assert.equal(loadConfig({ RESPONSE_HOURS_HIGH: '' }).responseHours.high, 24);
+  for (const value of ['-1', '0', '1.5', 'oops', '876001']) {
+    assert.throws(() => loadConfig({ RESPONSE_HOURS_HIGH: value }), ConfigError);
+  }
+  for (const value of [undefined, '', 'off', 'ON', 'true']) assert.equal(loadConfig({ DUE_TIMES: value }).dueTimes, false);
+  assert.equal(loadConfig({ DUE_TIMES: 'on' }).dueTimes, true);
+});
+
+test('enabled API assigns each priority its deadline and includes due on every ticket response', async () => {
+  await withService({ dueTimes: true }, async (api) => {
+    for (const [priority, hours] of Object.entries(loadConfig({}).responseHours)) {
+      const { body } = await api.post('/tickets', ticketBody({ priority }));
+      assert.equal(Date.parse(body.due) - Date.parse(body.created), hours * HOUR);
+      assert.equal((await api.get(`/tickets/${body.id}`)).body.due, body.due);
+      assert.equal((await api.patch(`/tickets/${body.id}`, { priority: 'low' })).body.due, body.due);
+      assert.equal((await api.post(`/tickets/${body.id}/transition`, { to: 'in_progress' })).body.due, body.due);
+      assert.equal((await api.get('/tickets')).body.items.find((ticket) => ticket.id === body.id).due, body.due);
+      assert.equal((await api.patch(`/tickets/${body.id}`, { due: '2099-01-01' })).status, 400);
+    }
+  });
+});
+
+test('flag off preserves ticket responses and ignores the formerly unknown overdue parameter', async () => {
+  await withService({}, async (api, service) => {
+    const { body } = await api.post('/tickets', ticketBody());
+    assert.equal('due' in body, false);
+    assert.equal('due' in (await api.get(`/tickets/${body.id}`)).body, false);
+    assert.equal('due' in (await api.patch(`/tickets/${body.id}`, { priority: 'urgent' })).body, false);
+    assert.equal('due' in (await api.post(`/tickets/${body.id}/transition`, { to: 'in_progress' })).body, false);
+    const list = await api.get('/tickets?overdue=nonsense');
+    assert.equal(list.status, 200);
+    assert.equal(list.body.items.length, 1);
+    assert.equal('due' in list.body.items[0], false);
+    assert.ok(service.store.snapshot().tickets[0].due);
+  });
+});
+
+test('overdue means strictly past due and active; filtering precedes pagination and intersects existing filters', async () => {
+  const clock = manualClock();
+  await withService({ dueTimes: true, clock }, async (api) => {
+    for (let n = 0; n < 6; n++) await api.post('/tickets', ticketBody({ priority: n === 5 ? 'low' : 'urgent' }));
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    for (const id of ['T-0003', 'T-0004']) {
+      for (const to of ['in_progress', 'resolved']) await api.post(`/tickets/${id}/transition`, { to });
+    }
+    await api.post('/tickets/T-0004/transition', { to: 'closed' });
+    clock.advance(4 * HOUR);
+    assert.deepEqual((await api.get('/tickets?overdue=true')).body.items, []);
+    clock.advance(1);
+    const first = (await api.get('/tickets?overdue=true&limit=1')).body;
+    assert.deepEqual(first.items.map((t) => t.id), ['T-0001']);
+    const next = (await api.get(`/tickets?overdue=true&limit=1&cursor=${first.next}`)).body;
+    assert.deepEqual(next.items.map((t) => t.id), ['T-0002']);
+    assert.deepEqual((await api.get('/tickets?overdue=true&status=in_progress')).body.items.map((t) => t.id), ['T-0002']);
+    assert.deepEqual((await api.get('/tickets?overdue=true&priority=low')).body.items, []);
+    assert.equal((await api.get('/tickets?overdue=false')).body.items.length, 6);
+    assert.equal((await api.get('/tickets?overdue=1')).status, 400);
+  });
+});
+
+test('startup durably backfills legacy tickets before enablement, and restart never recalculates due', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const legacy = legacyPersistence(file, { clock });
+  const seed = new TicketStore({ clock });
+  for (const priority of ['urgent', 'high', 'normal', 'low']) seed.create(ticketBody({ priority }), 'operator');
+  legacy.save(seed.snapshot()); // The unmodified 1.4.0 writer omits due.
+  const original = legacy.load();
+  const persistence = createPersistence(file, { clock });
+  const migrated = TicketStore.open({ clock, persistence });
+  const stored = persistence.load();
+  assert.deepEqual(stored.audit, original.audit);
+  assert.deepEqual(stored.outbox, original.outbox);
+  for (const ticket of stored.tickets) {
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), loadConfig({}).responseHours[ticket.priority] * HOUR);
+    assert.equal(ticket.updated, ticket.created);
+  }
+  assert.equal('due' in migrated.get('T-0001'), false);
+  const again = TicketStore.open({ clock, persistence, dueTimes: true, responseHours: { urgent: 100, high: 100, normal: 100, low: 100 } });
+  assert.equal(again.update('T-0001', { priority: 'low' }, 'operator').due, stored.tickets[0].due);
+  assert.equal(again.create(ticketBody({ priority: 'urgent' }), 'operator').due, new Date(clock.now().getTime() + 100 * HOUR).toISOString());
+  const third = TicketStore.open({ clock, persistence, dueTimes: true });
+  assert.equal(third.get('T-0001').due, stored.tickets[0].due);
+  // The actual 1.4.0 loader accepts the new file and sees every ticket.
+  assert.equal(JSON.parse(fs.readFileSync(file)).version, 1);
+  assert.deepEqual(legacy.load().tickets.map((ticket) => ticket.id), third.list().items.map((ticket) => ticket.id));
+});
+
+test('invalid persisted due is refused, and a migration save failure prevents startup', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(file) });
+  store.create(ticketBody(), 'operator');
+  const document = JSON.parse(fs.readFileSync(file));
+  document.tickets[0].due = 'invalid';
+  fs.writeFileSync(file, JSON.stringify(document));
+  assert.throws(() => createPersistence(file).load(), /due is not a time/);
+  const state = store.snapshot();
+  delete state.tickets[0].due;
+  assert.throws(() => TicketStore.open({ clock, persistence: { load: () => state, save() { throw new Error('disk full'); } } }), /disk full/);
+});
diff --git a/test/legacy-persistence.cjs b/test/legacy-persistence.cjs
new file mode 100644
index 0000000..98a07fb
--- /dev/null
+++ b/test/legacy-persistence.cjs
@@ -0,0 +1,206 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+const { STATES } = require('../src/outbox');
+const { parseId } = require('../src/tickets/ids');
+const { isPriority } = require('../src/tickets/priorities');
+const { isStatus } = require('../src/tickets/states');
+
+/**
+ * The data file (docs/decisions/0008-json-data-file.md): the store's whole state as one JSON document,
+ *
+ *   { "version": 1, "savedAt": "...", "nextNumber": 8, "tickets": [...], "audit": [...],
+ *     "outbox": { "nextId": 5, "events": [...] } }
+ *
+ * written after every change to a temporary file that then replaces the old one, so a crash leaves the old state or the
+ * new one, never a mix of the two.
+ *
+ * Saving and loading go through the record functions below, which name every field the file keeps. Loading checks each
+ * record, so a file edited by hand cannot put the service into a state it could not reach by itself; a file that fails
+ * a check is refused with the reason, and the service does not start.
+ */
+
+const VERSION = 1;
+
+class DataFileError extends Error {
+  constructor(file, message) {
+    super(`${file}: ${message}`);
+    this.name = 'DataFileError';
+  }
+}
+
+/** Load and save the state in `file`. */
+function createPersistence(file, { clock = { now: () => new Date() } } = {}) {
+  return {
+    file,
+
+    /** The saved state, or null when the file does not exist yet (the first start). */
+    load() {
+      let text;
+      try {
+        text = fs.readFileSync(file, 'utf8');
+      } catch (error) {
+        if (error.code === 'ENOENT') return null;
+        throw new DataFileError(file, `cannot be read: ${error.message}`);
+      }
+      let document;
+      try {
+        document = JSON.parse(text);
+      } catch {
+        throw new DataFileError(file, 'is not JSON');
+      }
+      return fromDocument(document, (message) => new DataFileError(file, message));
+    },
+
+    save(state) {
+      const document = toDocument(state, clock.now());
+      fs.mkdirSync(path.dirname(path.resolve(file)), { recursive: true });
+      const temporary = `${file}.${process.pid}.tmp`;
+      fs.writeFileSync(temporary, `${JSON.stringify(document, null, 2)}\n`);
+      fs.renameSync(temporary, file);
+    },
+  };
+}
+
+function toDocument(state, now) {
+  return {
+    version: VERSION,
+    savedAt: now.toISOString(),
+    nextNumber: state.nextNumber,
+    tickets: state.tickets.map(ticketRecord),
+    audit: state.audit.map(auditRecord),
+    outbox: { nextId: state.outbox.nextId, events: state.outbox.events.map(eventRecord) },
+  };
+}
+
+function fromDocument(document, fail) {
+  if (!isObject(document)) throw fail('is not a data file');
+  if (document.version !== VERSION) throw fail(`has version ${document.version}; this service reads version ${VERSION}`);
+  const nextNumber = positive(document.nextNumber, 'nextNumber', fail);
+  const tickets = array(document.tickets, 'tickets', fail).map((record, index) => readTicket(record, `tickets[${index}]`, fail));
+  const ids = new Set();
+  for (const ticket of tickets) {
+    if (ids.has(ticket.id)) throw fail(`ticket ${ticket.id} appears twice`);
+    ids.add(ticket.id);
+    if (parseId(ticket.id) >= nextNumber) throw fail(`nextNumber ${nextNumber} would reuse the number of ${ticket.id}`);
+  }
+  const audit = array(document.audit, 'audit', fail).map((record, index) => readAudit(record, index, fail));
+  const outbox = object(document.outbox, 'outbox', fail);
+  const events = array(outbox.events, 'outbox.events', fail).map((record, index) => readEvent(record, `outbox.events[${index}]`, fail));
+  const nextId = positive(outbox.nextId, 'outbox.nextId', fail);
+  if (events.some((event) => event.id >= nextId)) throw fail(`outbox.nextId ${nextId} would reuse an event id`);
+  return { nextNumber, tickets, audit, outbox: { nextId, events } };
+}
+
+// Records: the fields the file keeps, one function per kind, used to save and to load.
+
+function ticketRecord(ticket) {
+  return {
+    id: ticket.id,
+    title: ticket.title,
+    priority: ticket.priority,
+    requester: ticket.requester,
+    status: ticket.status,
+    created: ticket.created,
+    updated: ticket.updated,
+  };
+}
+
+function auditRecord(entry) {
+  return {
+    seq: entry.seq,
+    ticket: entry.ticket,
+    action: entry.action,
+    actor: entry.actor,
+    at: entry.at,
+    changes: entry.changes,
+  };
+}
+
+function eventRecord(event) {
+  return {
+    id: event.id,
+    key: event.key,
+    type: event.type,
+    to: event.to,
+    ticket: event.ticket,
+    data: event.data,
+    status: event.status,
+    attempts: event.attempts,
+    created: event.created,
+    nextAttemptAt: event.nextAttemptAt,
+    lastError: event.lastError,
+    sentAt: event.sentAt,
+  };
+}
+
+function readTicket(record, where, fail) {
+  const ticket = ticketRecord(object(record, where, fail));
+  if (parseId(ticket.id) === null) throw fail(`${where}.id is not a ticket id`);
+  text(ticket.title, `${where}.title`, fail);
+  text(ticket.requester, `${where}.requester`, fail);
+  if (!isPriority(ticket.priority)) throw fail(`${where}.priority is not a priority`);
+  if (!isStatus(ticket.status)) throw fail(`${where}.status is not a status`);
+  time(ticket.created, `${where}.created`, fail);
+  time(ticket.updated, `${where}.updated`, fail);
+  return ticket;
+}
+
+function readAudit(record, index, fail) {
+  const where = `audit[${index}]`;
+  const entry = auditRecord(object(record, where, fail));
+  if (entry.seq !== index + 1) throw fail(`${where}.seq is ${entry.seq}, not ${index + 1}: the log is append-only`);
+  for (const field of ['ticket', 'action', 'actor']) text(entry[field], `${where}.${field}`, fail);
+  time(entry.at, `${where}.at`, fail);
+  if (!isObject(entry.changes)) throw fail(`${where}.changes is not an object`);
+  for (const [field, change] of Object.entries(entry.changes)) {
+    if (!isObject(change) || !('from' in change) || !('to' in change)) throw fail(`${where}.changes.${field} needs from and to`);
+  }
+  return entry;
+}
+
+function readEvent(record, where, fail) {
+  const event = eventRecord(object(record, where, fail));
+  positive(event.id, `${where}.id`, fail);
+  for (const field of ['key', 'type', 'to']) text(event[field], `${where}.${field}`, fail);
+  if (!STATES.includes(event.status)) throw fail(`${where}.status is not one of ${STATES.join(', ')}`);
+  if (!Number.isInteger(event.attempts) || event.attempts < 0) throw fail(`${where}.attempts is not a count`);
+  if (!isObject(event.data)) throw fail(`${where}.data is not an object`);
+  time(event.created, `${where}.created`, fail);
+  if (event.status === 'pending') time(event.nextAttemptAt, `${where}.nextAttemptAt`, fail);
+  return event;
+}
+
+// Checks
+
+function isObject(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function object(value, where, fail) {
+  if (!isObject(value)) throw fail(`${where} is not an object`);
+  return value;
+}
+
+function array(value, where, fail) {
+  if (!Array.isArray(value)) throw fail(`${where} is not a list`);
+  return value;
+}
+
+function positive(value, where, fail) {
+  if (!Number.isSafeInteger(value) || value < 1) throw fail(`${where} is not a positive whole number`);
+  return value;
+}
+
+function text(value, where, fail) {
+  if (typeof value !== 'string' || value === '') throw fail(`${where} is not a non-empty string`);
+  return value;
+}
+
+function time(value, where, fail) {
+  if (typeof value !== 'string' || Number.isNaN(Date.parse(value))) throw fail(`${where} is not a time`);
+  return value;
+}
+
+module.exports = { DataFileError, VERSION, createPersistence, fromDocument, toDocument };
