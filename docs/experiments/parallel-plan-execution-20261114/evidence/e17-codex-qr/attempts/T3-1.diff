diff --git a/src/tickets/due.js b/src/tickets/due.js
new file mode 100644
index 0000000..fdfea00
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,13 @@
+'use strict';
+
+const DEFAULT_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+function dueTime(created, priority, hours = DEFAULT_HOURS) {
+  return new Date(Date.parse(created) + hours[priority] * 60 * 60 * 1000).toISOString();
+}
+
+function isOverdue(ticket, now) {
+  return ['open', 'in_progress'].includes(ticket.status) && Date.parse(ticket.due) < now.getTime();
+}
+
+module.exports = { DEFAULT_HOURS, dueTime, isOverdue };
