+describe('the data file and the command line', () => {
+  function folder(t) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    return dir;
+  }
+
+  function saved(t) {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    const tickets = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), assignees: true });
+    tickets.createTicket(input({ title: 'VPN drops', priority: 'high' }), 'dana');
+    tickets.createTicket(input({ title: 'Printer jams', priority: 'low' }), 'dana');
+    tickets.createTicket(input({ title: 'Mouse broken' }), 'dana');
+    tickets.assign('T-0001', 'sam', 'dana');
+    tickets.assign('T-0003', 'kim', 'dana');
+    tickets.assign('T-0003', null, 'dana');
+    return { file, clock, tickets };
+  }
+
+  const run = (argv) => {
+    let out = '';
+    let err = '';
+    const code = main(argv, { env: {}, out: { write: (text) => { out += text; } }, err: { write: (text) => { err += text; } } });
+    return { code, out, err };
+  };
+
+  test('the assignees are saved and loaded back; unassigned tickets keep the file as it was', (t) => {
+    const { file, clock } = saved(t);
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.deepEqual(document.tickets.map((ticket) => ticket.assignee), ['sam', undefined, undefined]);
+    assert.equal(document.version, 1);
+    const again = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), assignees: true });
+    assert.deepEqual(again.list().items.map((ticket) => ticket.assignee), ['sam', null, null]);
+  });
+
+  test('a data file with an assignee that is not a name is refused', (t) => {
+    const { file } = saved(t);
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    document.tickets[0].assignee = 7;
+    fs.writeFileSync(file, JSON.stringify(document));
+    assert.throws(() => createPersistence(file).load(), (error) => error instanceof DataFileError && /tickets\[0\]\.assignee/.test(error.message));
+  });
+
+  test('`list` shows each ticket\'s assignee', (t) => {
+    const { file } = saved(t);
+    const { code, out } = run(['--data', file, 'list']);
+    assert.equal(code, 0);
+    const [header, ...rows] = out.trimEnd().split('\n');
+    assert.match(header, /ASSIGNEE/);
+    const column = header.indexOf('ASSIGNEE');
+    assert.deepEqual(rows.map((row) => row.slice(column).split(/\s+/)[0]), ['sam', '-', '-']);
+  });
+
+  test('`list --raw` keeps its first four columns and adds the assignee, empty when there is none', (t) => {
+    const { file } = saved(t);
+    const { out } = run(['--data', file, 'list', '--raw']);
+    assert.deepEqual(out.replace(/\n$/, '').split('\n').map((line) => line.split('\t')), [
+      ['T-0001', 'open', 'high', 'VPN drops', 'sam'],
+      ['T-0002', 'open', 'low', 'Printer jams', ''],
+      ['T-0003', 'open', 'normal', 'Mouse broken', ''],
+    ]);
+    assert.equal(rawLine({ id: 'T-1', status: 'open', priority: 'low', title: 'x' }), 'T-1\topen\tlow\tx\t');
+  });
+
+  test('`list --assignee` filters, with the other filters', (t) => {
+    const { file } = saved(t);
+    const ids = (...argv) => run(['--data', file, 'list', '--raw', ...argv]).out.trimEnd().split('\n').filter(Boolean).map((line) => line.split('\t')[0]);
+    assert.deepEqual(ids('--assignee', 'sam'), ['T-0001']);
+    assert.deepEqual(ids('--assignee', ''), ['T-0002', 'T-0003']);
+    assert.deepEqual(ids('--assignee', '', '--priority', 'low'), ['T-0002']);
+    assert.deepEqual(ids('--assignee', 'sam', '--priority', 'low'), []);
+  });
+
+  test('`show` names the assignee', (t) => {
+    const { file } = saved(t);
+    assert.match(run(['--data', file, 'show', 'T-0001']).out, /assignee\s+sam/);
+    assert.match(run(['--data', file, 'show', 'T-0002']).out, /assignee\s+-/);
+  });
+});
