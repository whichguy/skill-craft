+    assert.equal(ticket.assignee, 'sam');
+    assert.equal(ticket.updated, '2025-09-01T08:01:00.000Z');
+    const [, entry] = tickets.history('T-0001');
+    assert.deepEqual(
+      { action: entry.action, actor: entry.actor, changes: entry.changes },
+      { action: 'ticket.assigned', actor: 'dana', changes: { assignee: { from: null, to: 'sam' } } },
+    );
+    const [event] = assigned(tickets);
+    assert.equal(assigned(tickets).length, 1);
+    assert.equal(event.to, 'sam');
+    assert.equal(event.ticket, 'T-0001');
+    assert.equal(event.data.title, 'Laptop will not boot');
+  });
+
+  test('works on in-progress tickets and hands a ticket on to another agent', () => {
+    const { tickets } = store();
+    tickets.transition('T-0001', 'in_progress', 'dana');
+    tickets.assign('T-0001', 'sam', 'dana');
+    const ticket = tickets.assign('T-0001', 'kim', 'dana');
+    assert.equal(ticket.assignee, 'kim');
+    assert.deepEqual(tickets.history('T-0001').at(-1).changes, { assignee: { from: 'sam', to: 'kim' } });
+  });
+
+  test('tells the next agent even while the first one has not been told yet', () => {
+    const { tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    tickets.assign('T-0001', 'kim', 'dana');
+    assert.deepEqual(assigned(tickets).map((event) => event.to), ['sam', 'kim']);
+  });
+
+  test('assigning to the agent it already has changes nothing', () => {
+    const { clock, tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    const before = { audit: tickets.history('T-0001').length, outbox: tickets.outboxReport().pending.length };
+    clock.advance(60000);
+    const ticket = tickets.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.assignee, 'sam');
+    assert.equal(ticket.updated, '2025-09-01T08:00:00.000Z');
+    assert.deepEqual({ audit: tickets.history('T-0001').length, outbox: tickets.outboxReport().pending.length }, before);
+  });
+
+  test('unassigns, with an audit entry and no notification; unassigning an unassigned ticket changes nothing', () => {
+    const { tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    const outbox = tickets.outboxReport().pending.length;
+    assert.equal(tickets.assign('T-0001', null, 'dana').assignee, null);
+    const entries = tickets.history('T-0001');
+    assert.equal(entries.at(-1).action, 'ticket.unassigned');
+    assert.deepEqual(entries.at(-1).changes, { assignee: { from: 'sam', to: null } });
+    assert.equal(tickets.outboxReport().pending.length, outbox);
+    tickets.assign('T-0001', null, 'dana');
+    assert.equal(tickets.history('T-0001').length, entries.length);
+  });
+
+  test('refuses resolved and closed tickets, whatever the assignee, with a conflict', () => {
+    const { tickets } = store();
+    tickets.assign('T-0001', 'sam', 'dana');
+    tickets.transition('T-0001', 'in_progress', 'dana');
+    tickets.transition('T-0001', 'resolved', 'dana');
+    for (const assignee of ['kim', 'sam', null]) assert.throws(() => tickets.assign('T-0001', assignee, 'dana'), ConflictError);
+    tickets.transition('T-0001', 'closed', 'dana');
+    for (const assignee of ['kim', 'sam', null]) assert.throws(() => tickets.assign('T-0001', assignee, 'dana'), ConflictError);
+    assert.equal(tickets.get('T-0001').assignee, 'sam');
+  });
+
+  test('refuses a ticket that does not exist', () => {
+    assert.throws(() => store().tickets.assign('T-0099', 'sam', 'dana'), NotFoundError);
+  });
+
+  test('shows `assignee` (null when unassigned) only while assignees are on', () => {
+    const on = store().tickets;
+    assert.equal(on.get('T-0001').assignee, null);
+    assert.equal(on.list().items[0].assignee, null);
+    const off = store({ assignees: false }).tickets;
+    off.assign('T-0001', 'sam', 'dana');
+    assert.equal('assignee' in off.get('T-0001'), false);
+    assert.equal('assignee' in off.list().items[0], false);
+    assert.equal(off.list({ filters: { assignee: 'sam' } }).items.length, 1);
+  });
+});
