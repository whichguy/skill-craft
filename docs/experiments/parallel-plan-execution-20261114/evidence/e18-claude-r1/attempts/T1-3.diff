+describe('the assignment body', () => {
+  test('takes an agent name or null', () => {
+    assert.equal(assignment({ assignee: 'sam' }), 'sam');
+    assert.equal(assignment({ assignee: '  sam  ' }), 'sam');
+    assert.equal(assignment({ assignee: 'x'.repeat(64) }), 'x'.repeat(64));
+    assert.equal(assignment({ assignee: null }), null);
+  });
+
+  test('refuses anything else', () => {
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 'x'.repeat(65) }, { assignee: 7 }, { assignee: true },
+      { assignee: ['sam'] }, { assignee: 'a\tb' }, { assignee: 'sam', owner: 'kim' }]) {
+      assert.throws(() => assignment(body), InvalidError, JSON.stringify(body));
+    }
+  });
+});
+
+describe('the notification', () => {
+  test('says which ticket was assigned', () => {
+    const { subject, body } = render({ type: 'ticket.assigned', ticket: 'T-0001', to: 'sam', data: { title: 'Laptop will not boot' } });
+    assert.match(subject, /T-0001/);
+    assert.match(body, /Laptop will not boot/);
+    assert.match(body, /assigned to you/);
+  });
+});
+
+describe('the assignee filter', () => {
+  const tickets = [
+    { id: 'T-0001', status: 'open', priority: 'high', assignee: 'sam' },
+    { id: 'T-0002', status: 'open', priority: 'high', assignee: null },
+    { id: 'T-0003', status: 'open', priority: 'low' },
+    { id: 'T-0004', status: 'closed', priority: 'high', assignee: 'sam' },
+  ];
+  const ids = (filters) => tickets.filter((ticket) => matchesFilters(ticket, filters)).map((ticket) => ticket.id);
+
+  test('is read from the query, an empty value included', () => {
+    assert.deepEqual(parseListQuery(new URLSearchParams('assignee=sam')).filters, { assignee: 'sam' });
+    assert.deepEqual(parseListQuery(new URLSearchParams('assignee=')).filters, { assignee: '' });
+    assert.deepEqual(parseListQuery(new URLSearchParams('')).filters, {});
+  });
+
+  test('keeps an agent\'s tickets, or with an empty value the unassigned ones', () => {
+    assert.deepEqual(ids({ assignee: 'sam' }), ['T-0001', 'T-0004']);
+    assert.deepEqual(ids({ assignee: '' }), ['T-0002', 'T-0003']);
+    assert.deepEqual(ids({ assignee: 'kim' }), []);
+  });
+
+  test('a ticket must match every filter given', () => {
+    assert.deepEqual(ids({ assignee: 'sam', status: 'open' }), ['T-0001']);
+    assert.deepEqual(ids({ assignee: 'sam', status: 'open', priority: 'low' }), []);
+    assert.deepEqual(ids({ status: 'open', priority: 'high' }), ['T-0001', 'T-0002']);
+    assert.deepEqual(ids({ assignee: '', priority: 'low' }), ['T-0003']);
+  });
+});
+
+describe('PUT /tickets/:id/assignee', () => {
+  const envelope = (response, status, code) => {
+    assert.equal(response.status, status, JSON.stringify(response.body));
+    assert.equal(response.body.error.code, code);
+  };
+
+  test('assigns and unassigns, answering with the ticket', async () => {
+    await withService({ assignees: true }, async (api) => {
+      await api.post('/tickets', ticketBody());
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, null);
+      const assigned = await api.put('/tickets/T-0001/assignee', { assignee: 'sam' }, { 'x-actor': 'dana' });
+      assert.equal(assigned.status, 200);
+      assert.equal(assigned.body.assignee, 'sam');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'sam');
+      const unassigned = await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.equal(unassigned.status, 200);
+      assert.equal(unassigned.body.assignee, null);
+      const { items } = (await api.get('/tickets/T-0001/audit')).body;
+      assert.deepEqual(items.map((entry) => [entry.action, entry.actor]), [
+        ['ticket.created', 'system'], ['ticket.assigned', 'dana'], ['ticket.unassigned', 'system'],
+      ]);
+    });
+  });
+
+  test('answers 400 for a bad body, 404 for a missing ticket, 409 for a ticket that is no longer worked on', async () => {
+    await withService({ assignees: true }, async (api) => {
+      await api.post('/tickets', ticketBody());
+      for (const body of [{}, { assignee: '' }, { assignee: 'x'.repeat(65) }, { assignee: 4 }, { assignee: 'sam', extra: 1 }, [], '{"assignee":']) {
+        envelope(await api.put('/tickets/T-0001/assignee', body), 400, 'invalid');
+      }
+      envelope(await api.put('/tickets/T-0009/assignee', { assignee: 'sam' }), 404, 'not_found');
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'sam' })).status, 200);
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+      envelope(await api.put('/tickets/T-0001/assignee', { assignee: 'kim' }), 409, 'conflict');
+      envelope(await api.put('/tickets/T-0001/assignee', { assignee: null }), 409, 'conflict');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'sam');
+    });
+  });
+
+  test('a repeated assignment changes nothing and the agent is told once', async () => {
+    await withService({ assignees: true }, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const first = (await api.put('/tickets/T-0001/assignee', { assignee: 'sam' })).body;
+      const again = (await api.put('/tickets/T-0001/assignee', { assignee: 'sam' })).body;
+      assert.deepEqual(again, first);
+      assert.equal((await api.get('/tickets/T-0001/audit')).body.items.length, 2);
+      const { pending } = (await api.get('/admin/outbox')).body;
+      assert.deepEqual(pending.filter((event) => event.type === 'ticket.assigned').map((event) => event.to), ['sam']);
+    });
+  });
+
+  test('lists by assignee, and by assignee with the other filters', async () => {
+    await withService({ assignees: true }, async (api) => {
+      for (const priority of ['high', 'low', 'high', 'low']) await api.post('/tickets', ticketBody({ priority }));
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      await api.put('/tickets/T-0002/assignee', { assignee: 'sam' });
+      await api.put('/tickets/T-0003/assignee', { assignee: 'kim' });
+      const ids = async (query) => (await api.get(`/tickets${query}`)).body.items.map((ticket) => ticket.id);
+      assert.deepEqual(await ids('?assignee=sam'), ['T-0001', 'T-0002']);
+      assert.deepEqual(await ids('?assignee='), ['T-0004']);
+      assert.deepEqual(await ids('?assignee=sam&priority=high'), ['T-0001']);
+      assert.deepEqual(await ids('?assignee=sam&priority=low&status=open'), ['T-0002']);
+      assert.deepEqual(await ids('?assignee=nobody'), []);
+      assert.deepEqual(await ids('?assignee=&priority=low'), ['T-0004']);
+      assert.deepEqual(await ids(''), ['T-0001', 'T-0002', 'T-0003', 'T-0004']);
+    });
+  });
+
+  test('the listing still pages with the assignee filter', async () => {
+    await withService({ assignees: true }, async (api) => {
+      for (let n = 0; n < 3; n += 1) await api.post('/tickets', ticketBody());
+      const page = (await api.get('/tickets?assignee=&limit=2')).body;
+      assert.equal(page.items.length, 2);
+      assert.deepEqual((await api.get(`/tickets?assignee=&limit=2&cursor=${page.next}`)).body.items.map((ticket) => ticket.id), ['T-0003']);
+    });
+  });
+
+  test('tickets show no `assignee` until ASSIGNEES is on, but can be assigned', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const response = await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      assert.equal(response.status, 200);
+      assert.equal('assignee' in response.body, false);
+      assert.equal('assignee' in (await api.get('/tickets/T-0001')).body, false);
+      assert.deepEqual((await api.get('/tickets?assignee=sam')).body.items.map((ticket) => ticket.id), ['T-0001']);
+    });
+  });
+});
+
+describe('ASSIGNEES', () => {
+  test('is off unless it is on', () => {
+    assert.equal(loadConfig({}).assignees, false);
+    assert.equal(loadConfig({ ASSIGNEES: '' }).assignees, false);
+    assert.equal(loadConfig({ ASSIGNEES: 'yes' }).assignees, false);
+    assert.equal(loadConfig({ ASSIGNEES: 'on' }).assignees, true);
