+describe('the data file and the command line', () => {
+  function folder(t) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    return dir;
+  }
+
+  test('assignees survive a restart; a file without them loads as unassigned', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), assignees: true });
+    store.createTicket({ title: 'VPN', requester: 'li@example.com', priority: 'low' }, 'x');
+    store.createTicket({ title: 'Printer', requester: 'li@example.com', priority: 'low' }, 'x');
+    store.assign('T-0001', 'dana', 'x');
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(document.version, 1);
+    assert.deepEqual(document.tickets.map((ticket) => ticket.assignee), ['dana', undefined]);
+    const reopened = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), assignees: true });
+    assert.deepEqual(reopened.list().items.map((ticket) => ticket.assignee), ['dana', null]);
+  });
+
+  test('lists each ticket with its assignee, in the table and as a last raw column', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket({ title: 'VPN drops', requester: 'li@example.com', priority: 'low' }, 'x');
+    store.createTicket({ title: 'Printer jams', requester: 'li@example.com', priority: 'high' }, 'x');
+    store.assign('T-0002', 'dana', 'x');
+    const run = (args) => {
+      let out = '';
+      const code = main(['--data', file, ...args], { env: {}, out: { write: (text) => { out += text; } }, err: { write: () => {} } });
+      assert.equal(code, 0);
+      return out;
+    };
+    const lines = run(['list']).trimEnd().split('\n');
+    assert.match(lines[0], /ASSIGNEE/);
+    assert.match(lines[1], /\s-\s/);
+    assert.match(lines[2], /\sdana\s/);
+    assert.deepEqual(run(['list', '--raw']).trimEnd().split('\n').map((line) => line.split('\t')), [
+      ['T-0001', 'open', 'low', 'VPN drops', ''],
+      ['T-0002', 'open', 'high', 'Printer jams', 'dana'],
+    ]);
+    assert.match(run(['list', '--assignee', 'dana', '--raw']), /^T-0002\t/);
+    assert.match(run(['list', '--assignee', '', '--raw']), /^T-0001\t/);
+    assert.match(run(['show', 'T-0002']), /assignee\s+dana/);
+    assert.equal(rawLine({ id: 'T-1', status: 'open', priority: 'low', title: 't' }), 'T-1\topen\tlow\tt\t');
+    assert.match(table([{ id: 'T-1', status: 'open', priority: 'low', requester: 'r', updated: '2025-09-01T08:00:00Z', title: 't' }]), /-\s+2025/);
+  });
+});
