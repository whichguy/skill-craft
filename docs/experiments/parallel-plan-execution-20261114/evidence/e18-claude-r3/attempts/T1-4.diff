+describe('GET /tickets?assignee=', () => {
+  async function seeded(api) {
+    for (let n = 0; n < 4; n += 1) await api.post('/tickets', ticketBody({ priority: n % 2 ? 'high' : 'normal' }));
+    await api.put('/tickets/T-0001/assignee', { assignee: 'dana' });
+    await api.put('/tickets/T-0002/assignee', { assignee: 'dana' });
+    await api.put('/tickets/T-0003/assignee', { assignee: 'sam' });
+  }
+
+  test('keeps the tickets of one agent', async () => {
+    await withService(SHOWN, async (api) => {
+      await seeded(api);
+      assert.deepEqual(await idsOf(api, '?assignee=dana'), ['T-0001', 'T-0002']);
+      assert.deepEqual(await idsOf(api, '?assignee=sam'), ['T-0003']);
+      assert.deepEqual(await idsOf(api, '?assignee=nobody'), []);
+    });
+  });
+
+  test('an empty assignee keeps the unassigned tickets', async () => {
+    await withService(SHOWN, async (api) => {
+      await seeded(api);
+      assert.deepEqual(await idsOf(api, '?assignee='), ['T-0004']);
+      await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.deepEqual(await idsOf(api, '?assignee='), ['T-0001', 'T-0004']);
+    });
+  });
+
+  test('a ticket must match every filter given', async () => {
+    await withService(SHOWN, async (api) => {
+      await seeded(api);
+      assert.deepEqual(await idsOf(api, '?assignee=dana&priority=high'), ['T-0002']);
+      assert.deepEqual(await idsOf(api, '?assignee=dana&status=in_progress'), []);
+      assert.deepEqual(await idsOf(api, '?status=open&priority=normal'), ['T-0001', 'T-0003']);
+      assert.deepEqual(await idsOf(api, '?assignee=&priority=normal'), []);
+      assert.deepEqual(await idsOf(api, '?assignee=&priority=high'), ['T-0004']);
+    });
+  });
+
+  test('pages like the other filters', async () => {
+    await withService(SHOWN, async (api) => {
+      await seeded(api);
+      const first = (await api.get('/tickets?assignee=dana&limit=1')).body;
+      assert.deepEqual(first.items.map((ticket) => ticket.id), ['T-0001']);
+      const second = (await api.get(`/tickets?assignee=dana&limit=1&cursor=${first.next}`)).body;
+      assert.deepEqual(second.items.map((ticket) => ticket.id), ['T-0002']);
+    });
+  });
+});
