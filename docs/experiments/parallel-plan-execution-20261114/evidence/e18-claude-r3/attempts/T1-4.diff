+describe('the units', () => {
+  test('parseListQuery reads assignee, and empty as unassigned', () => {
+    const query = (text) => parseListQuery(new URLSearchParams(text));
+    assert.deepEqual(query('assignee=dana').filters, { assignee: 'dana' });
+    assert.deepEqual(query('assignee=').filters, { assignee: null });
+    assert.deepEqual(query('status=open&assignee=dana').filters, { status: 'open', assignee: 'dana' });
+  });
+
+  test('matchesFilters needs every filter; a ticket with no assignee is unassigned', () => {
+    const ticket = { id: 'T-0001', status: 'open', priority: 'high', assignee: 'dana' };
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'high' }), true);
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'low' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'closed', priority: 'high' }), false);
+    assert.equal(matchesFilters(ticket, { assignee: 'dana' }), true);
+    assert.equal(matchesFilters(ticket, { assignee: null }), false);
+    assert.equal(matchesFilters({ id: 'T-0002', status: 'open' }, { assignee: null }), true);
+  });
+
+  test('validate.assignee takes a name or null', () => {
+    assert.equal(validate.assignee({ assignee: ' dana ' }), 'dana');
+    assert.equal(validate.assignee({ assignee: null }), null);
+    assert.throws(() => validate.assignee({}), InvalidError);
+    assert.throws(() => validate.assignee({ assignee: '' }), InvalidError);
+    assert.throws(() => validate.assignee({ assignee: 'x'.repeat(65) }), InvalidError);
+  });
+});
