+describe('the notice to the agent', () => {
+  test('assigning enqueues a notice for the agent, and the worker delivers it', async () => {
+    await withService({ ...SHOWN, workerIntervalMs: 0 }, async (api, service) => {
+      await api.post('/tickets', ticketBody({ title: 'VPN drops' }));
+      await api.put('/tickets/T-0001/assignee', { assignee: 'dana' });
+      const [notice] = service.store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned');
+      assert.equal(notice.to, 'dana');
+      assert.equal(notice.ticket, 'T-0001');
+      assert.deepEqual(notice.data, { title: 'VPN drops' });
+      const message = render(notice);
+      assert.match(message.subject, /T-0001/);
+      assert.match(message.body, /assigned to you/);
+      service.notifier.deliver(notice);
+      assert.equal(service.notifier.delivered.at(-1).to, 'dana');
+    });
+  });
+
+  test('handing a ticket on notifies the new agent even while the first notice is pending; unassigning notifies nobody', async () => {
+    await withService(SHOWN, async (api, service) => {
+      await api.post('/tickets', ticketBody());
+      await api.put('/tickets/T-0001/assignee', { assignee: 'dana' });
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      await api.put('/tickets/T-0001/assignee', { assignee: null });
+      const to = service.store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned').map((event) => event.to);
+      assert.deepEqual(to, ['dana', 'sam']);
+    });
+  });
+
+  test('the worker sends it', async () => {
+    const clock = manualClock();
+    await withService({ ...SHOWN, clock }, async (api, service) => {
+      await api.post('/tickets', ticketBody());
+      await api.put('/tickets/T-0001/assignee', { assignee: 'dana' });
+      for (const event of service.store.dueNotifications()) {
+        service.notifier.deliver(event);
+        service.store.recordDelivery(event.id);
+      }
+      assert.deepEqual(service.notifier.delivered.map((line) => line.type), ['ticket.created', 'ticket.assigned']);
+      assert.equal(service.store.outboxReport().dead.length, 0);
+    });
+  });
+});
