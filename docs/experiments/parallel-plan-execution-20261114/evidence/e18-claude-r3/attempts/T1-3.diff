+describe('the data file', () => {
+  test('keeps assignees across a restart, and loads files written without any', () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-'));
+    try {
+      const file = path.join(dir, 'tickets.json');
+      const clock = manualClock('2025-09-01T08:00:00.000Z');
+      const store = TicketStore.open({ clock, persistence: createPersistence(file) });
+      store.createTicket(input(), 'dana');
+      store.createTicket(input(), 'dana');
+      store.assign('T-0001', 'sam', 'dana');
+      const again = TicketStore.open({ clock, persistence: createPersistence(file) });
+      assert.equal(again.get('T-0001').assignee, 'sam');
+      assert.equal(again.get('T-0002').assignee, null);
+      const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+      assert.equal('assignee' in document.tickets[1], false, 'an unassigned ticket is saved as an older release saved it');
+      assert.equal(document.version, 1);
+    } finally {
+      fs.rmSync(dir, { recursive: true, force: true });
+    }
+  });
+});
