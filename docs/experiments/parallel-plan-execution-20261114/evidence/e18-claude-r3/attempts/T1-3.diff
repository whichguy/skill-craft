+describe('the command line', () => {
+  const tickets = [
+    { id: 'T-0001', status: 'open', priority: 'high', requester: 'li@example.com', updated: '2025-09-01T08:00:00.000Z', title: 'Printer', assignee: 'sam' },
+    { id: 'T-0002', status: 'open', priority: 'low', requester: 'li@example.com', updated: '2025-09-01T08:00:00.000Z', title: 'Laptop', assignee: null },
+  ];
+
+  test('the table has an ASSIGNEE column', () => {
+    const [header, first, second] = table(tickets).split('\n');
+    assert.match(header, /ASSIGNEE/);
+    assert.match(first, /\bsam\b/);
+    assert.doesNotMatch(second, /\bnull\b/);
+  });
+
+  test('raw lines keep id, status, priority, title in place and add the assignee last', () => {
+    assert.deepEqual(rawLine(tickets[0]).split('\t'), ['T-0001', 'open', 'high', 'Printer', 'sam']);
+    assert.deepEqual(rawLine(tickets[1]).split('\t'), ['T-0002', 'open', 'low', 'Laptop', '']);
+  });
+
+  test('list shows assignees and --assignee filters', () => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-cli-'));
+    try {
+      const file = path.join(dir, 'tickets.json');
+      const store = TicketStore.open({ clock: manualClock('2025-09-01T08:00:00.000Z'), persistence: createPersistence(file) });
+      store.createTicket(input({ title: 'Printer' }), 'dana');
+      store.createTicket(input({ title: 'Laptop' }), 'dana');
+      store.assign('T-0001', 'sam', 'dana');
+      const run = (...args) => {
+        let out = '';
+        const code = main(['--data', file, ...args], { out: { write: (text) => { out += text; } }, err: { write: () => {} } });
+        return { code, out };
+      };
+      assert.deepEqual(run('list', '--raw').out.replace(/\n$/, '').split('\n').map((line) => line.split('\t')), [
+        ['T-0001', 'open', 'normal', 'Printer', 'sam'],
+        ['T-0002', 'open', 'normal', 'Laptop', ''],
+      ]);
+      assert.match(run('list').out, /sam/);
+      assert.deepEqual(run('list', '--raw', '--assignee', 'sam').out.trim().split('\n').map((line) => line.split('\t')[0]), ['T-0001']);
+      assert.deepEqual(run('list', '--raw', '--assignee', '').out.trim().split('\n').map((line) => line.split('\t')[0]), ['T-0002']);
+    } finally {
+      fs.rmSync(dir, { recursive: true, force: true });
+    }
+  });
