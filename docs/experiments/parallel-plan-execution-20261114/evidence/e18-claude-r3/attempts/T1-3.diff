+  test('takes a name, or null to unassign', () => {
+    assert.equal(assignment({ assignee: 'sam' }), 'sam');
+    assert.equal(assignment({ assignee: null }), null);
+    assert.equal(assignment({ assignee: 'a'.repeat(64) }), 'a'.repeat(64));
+  });
+
+  test('refuses anything else', () => {
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 'a'.repeat(65) }, { assignee: 7 }, { assignee: 'a\tb' }, { assignee: 'sam', extra: 1 }]) {
+      assert.throws(() => assignment(body), InvalidError, JSON.stringify(body));
+    }
+  });
+});
+
+describe('store.assign', () => {
+  test('new tickets are unassigned', () => {
+    const { store } = setup();
+    assert.equal(store.get('T-0001').assignee, null);
+  });
+
+  test('assigns, audits the change and moves updated', () => {
+    const { clock, store } = setup();
+    clock.advance(60_000);
+    const ticket = store.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.assignee, 'sam');
+    assert.equal(ticket.updated, '2025-09-01T08:01:00.000Z');
+    const last = store.history('T-0001').at(-1);
+    assert.equal(last.action, 'ticket.assigned');
+    assert.equal(last.actor, 'dana');
+    assert.deepEqual(last.changes, { assignee: { from: null, to: 'sam' } });
+  });
+
+  test('works for in-progress tickets and can unassign', () => {
+    const { store } = setup();
+    store.transition('T-0001', 'in_progress', 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    const ticket = store.assign('T-0001', null, 'dana');
+    assert.equal(ticket.assignee, null);
+    const last = store.history('T-0001').at(-1);
+    assert.equal(last.action, 'ticket.unassigned');
+    assert.deepEqual(last.changes, { assignee: { from: 'sam', to: null } });
+  });
+
+  test('assigning the agent it already has changes nothing', () => {
+    const { clock, store } = setup();
+    store.assign('T-0001', 'sam', 'dana');
+    const before = store.get('T-0001');
+    const audit = store.history('T-0001').length;
