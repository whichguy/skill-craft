+describe('PUT /tickets/:id/assignee', () => {
+  test('assigns and unassigns, and the ticket shows it', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, null);
+      const assigned = await api.put('/tickets/T-0001/assignee', { assignee: 'sam' }, { 'X-Actor': 'dana' });
+      assert.equal(assigned.status, 200);
+      assert.equal(assigned.body.assignee, 'sam');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'sam');
+      const unassigned = await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.equal(unassigned.status, 200);
+      assert.equal(unassigned.body.assignee, null);
+      const history = (await api.get('/tickets/T-0001/audit')).body.items;
+      assert.deepEqual(history.slice(1).map((entry) => [entry.action, entry.actor]), [['ticket.assigned', 'dana'], ['ticket.unassigned', history[2].actor]]);
+    });
+  });
+
+  test('answers the error envelope: 400, 404, 409', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      for (const body of [{}, { assignee: '' }, { assignee: 'x'.repeat(65) }, { assignee: 5 }]) {
+        const response = await api.put('/tickets/T-0001/assignee', body);
+        assert.equal(response.status, 400, JSON.stringify(body));
+        assert.equal(response.body.error.code, 'invalid');
+      }
+      assert.equal((await api.put('/tickets/T-0099/assignee', { assignee: 'sam' })).status, 404);
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'sam' })).status, 200);
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
+      const conflict = await api.put('/tickets/T-0001/assignee', { assignee: 'kim' });
+      assert.equal(conflict.status, 409);
+      assert.equal(conflict.body.error.code, 'conflict');
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: null })).status, 409);
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'sam');
+    });
+  });
+
+  test('assigning the same agent again leaves updated and the audit log alone', async () => {
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    await withService({ clock }, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const first = (await api.put('/tickets/T-0001/assignee', { assignee: 'sam' })).body;
+      clock.advance(60_000);
+      const again = (await api.put('/tickets/T-0001/assignee', { assignee: 'sam' })).body;
+      assert.deepEqual(again, first);
+      assert.equal((await api.get('/tickets/T-0001/audit')).body.items.length, 2);
+    });
+  });
+
+  test('the agent is notified through the outbox', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      const pending = (await api.get('/admin/outbox')).body.pending;
+      assert.deepEqual(pending.map((event) => [event.type, event.to]), [['ticket.created', 'maria@example.com'], ['ticket.assigned', 'sam']]);
+    });
+  });
+
+  test('GET /tickets filters by assignee, alone and with other filters', async () => {
+    await withService({}, async (api) => {
+      for (const priority of ['high', 'low', 'high', 'low']) await api.post('/tickets', ticketBody({ priority }));
+      await api.put('/tickets/T-0001/assignee', { assignee: 'sam' });
+      await api.put('/tickets/T-0002/assignee', { assignee: 'sam' });
+      await api.put('/tickets/T-0003/assignee', { assignee: 'kim' });
+      const ids = async (query) => (await api.get(`/tickets${query}`)).body.items.map((ticket) => ticket.id);
+      assert.deepEqual(await ids('?assignee=sam'), ['T-0001', 'T-0002']);
+      assert.deepEqual(await ids('?assignee='), ['T-0004']);
+      assert.deepEqual(await ids('?assignee=nobody'), []);
+      assert.deepEqual(await ids('?assignee=sam&priority=high'), ['T-0001']);
+      assert.deepEqual(await ids('?priority=high&status=open'), ['T-0001', 'T-0003']);
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.deepEqual(await ids('?assignee=sam&status=open'), ['T-0002']);
+      assert.deepEqual(await ids('?assignee=&status=in_progress'), []);
+      assert.deepEqual(await ids('?assignee=sam&limit=1'), ['T-0001']);
+    });
+  });
+});
