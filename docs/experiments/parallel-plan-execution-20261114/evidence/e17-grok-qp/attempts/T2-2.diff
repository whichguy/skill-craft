+      assert.deepEqual(body.ids, ['T-0002', 'T-0003']);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0004');
+    });
+  });
+
+  test('answers 400 naming the first invalid item by its index, and creates none', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody({ title: 'Already there' }));
+      const response = await api.post('/tickets/import', {
+        tickets: [
+          ticketBody({ title: 'Good' }),
+          ticketBody({ title: 'Also good' }),
+          ticketBody({ title: '' }),
+          ticketBody({ title: 'Never reached', owner: 'dana' }),
