+      assert.deepEqual(pending.map((event) => [event.type, event.to, event.ticket, event.key]), [
+        ['ticket.created', 'maria@example.com', 'T-0001', 'ticket.created:T-0001'],
+        ['ticket.created', 'li@example.com', 'T-0002', 'ticket.created:T-0002'],
