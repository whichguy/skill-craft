+  });
+
+  test('refuses a body that is not a tickets list', async () => {
+    await withService({}, async (api) => {
+      envelope(await api.post('/tickets/import', { title: 'nope', requester: 'a@example.com' }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: { title: 'nope', requester: 'a@example.com' } }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [ticketBody()], extra: 1 }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', []), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [null] }), 400, 'invalid');
