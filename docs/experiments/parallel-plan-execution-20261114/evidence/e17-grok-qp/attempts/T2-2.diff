+function isObject(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+/**
+ * POST /tickets/import: { tickets: [ { title, requester, priority? }, ... ] }, at most IMPORT_LIMIT items.
+ * Each item is checked as for POST /tickets. The first invalid item is named by its index (0 for the first).
+ */
+function importTickets(body) {
+  onlyFields(body, ['tickets']);
+  if (!Array.isArray(body.tickets)) throw new InvalidError('tickets must be a list');
+  if (body.tickets.length > IMPORT_LIMIT) {
+    throw new InvalidError(`tickets must have at most ${IMPORT_LIMIT} items`);
+  }
+  return body.tickets.map((item, index) => readImportedTicket(item, index));
+}
+
+function invalidItem(index, reason) {
+  return new InvalidError(`tickets[${index}] (index ${index}) is invalid: ${reason}`);
+}
+
+function readImportedTicket(item, index) {
+  if (!isObject(item)) throw invalidItem(index, 'must be an object');
+  try {
+    return newTicket(item);
+  } catch (error) {
+    if (error instanceof InvalidError) throw invalidItem(index, error.message);
+    throw error;
+  }
+}
