+const { TicketStore } = require('../src/store');
+const { main } = require('../bin/tickets');
+const { ticketBody, withService } = require('./helpers');
+
+const envelope = (response, status, code) => {
+  assert.equal(response.status, status, JSON.stringify(response.body));
+  assert.equal(response.body.error.code, code);
+  assert.equal(typeof response.body.error.message, 'string');
+};
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assignment-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+function runCli(argv, env) {
+  let output = '';
+  let errors = '';
+  const code = main(argv, { env, out: { write: (text) => { output += text; } }, err: { write: (text) => { errors += text; } } });
+  return { code, output, errors };
+}
+
+describe('ticket assignment HTTP behavior', () => {
+  test('create, get and list always return assignee, initially null', async () => {
+    await withService({}, async (api) => {
+      const created = await api.post('/tickets', ticketBody());
+      assert.equal(created.body.assignee, null);
+      assert.equal((await api.get(`/tickets/${created.body.id}`)).body.assignee, null);
+      assert.deepEqual((await api.get('/tickets')).body.items.map((ticket) => ticket.assignee), [null]);
+    });
+  });
+
+  test('assigns, reassigns, and unassigns through the store with idempotent notifications', async () => {
+    const clock = manualClock();
+    await withService({ clock }, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const assigned = await api.put('/tickets/T-0001/assignee', { assignee: '  dana  ' }, { 'X-Actor': 'sam' });
+      assert.equal(assigned.status, 200);
+      assert.equal(assigned.body.assignee, 'dana');
+      const firstUpdated = assigned.body.updated;
+      clock.advance(60_000);
+
+      const same = await api.put('/tickets/T-0001/assignee', { assignee: 'dana' });
+      assert.equal(same.body.updated, firstUpdated);
+
+      await api.put('/tickets/T-0001/assignee', { assignee: 'lee' });
+      const unassigned = await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.equal(unassigned.body.assignee, null);
+      const alreadyUnassigned = await api.put('/tickets/T-0001/assignee', { assignee: null });
+      assert.equal(alreadyUnassigned.body.updated, unassigned.body.updated);
+
+      const events = (await api.get('/admin/outbox')).body.pending.filter((event) => event.type === 'ticket.assigned');
+      assert.deepEqual(events.map(({ type, to, key }) => [type, to, key]), [
+        ['ticket.assigned', 'dana', 'ticket.assigned:T-0001:dana'],
+        ['ticket.assigned', 'lee', 'ticket.assigned:T-0001:lee'],
+      ]);
+      const history = (await api.get('/tickets/T-0001/audit')).body.items;
+      const changes = history.filter((entry) => entry.action === 'ticket.assigned');
+      assert.deepEqual(changes.map((entry) => entry.changes), [
+        { assignee: { from: null, to: 'dana' } },
+        { assignee: { from: 'dana', to: 'lee' } },
+        { assignee: { from: 'lee', to: null } },
+      ]);
+      assert.equal(changes[0].actor, 'sam');
+    });
+  });
+
+  test('rejects missing, unknown, empty, overlong, control and non-string assignees', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      for (const body of [
+        {},
+        { assignee: 'dana', other: true },
+        { assignee: '' },
+        { assignee: '   ' },
+        { assignee: 'a'.repeat(65) },
+        { assignee: 'da\u0001na' },
+        { assignee: 42 },
+        { assignee: false },
+      ]) envelope(await api.put('/tickets/T-0001/assignee', body), 400, 'invalid');
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'a'.repeat(64) })).status, 200);
+    });
+  });
+
