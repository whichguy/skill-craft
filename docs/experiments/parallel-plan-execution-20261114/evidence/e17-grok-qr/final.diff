@@ -0,0 +1,42 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { main } = require('../bin/tickets');
+const { manualClock } = require('../src/clock');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+
+function capture() {
+  const chunks = [];
+  return { write: (text) => chunks.push(text), toString: () => chunks.join('') };
+}
+
+test('list shows each ticket\'s assignee', (t) => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-cli-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const file = path.join(dir, 'tickets.json');
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+  store.createTicket({ title: 'VPN drops', requester: 'maria@example.com', priority: 'high' }, 'dana');
+  store.createTicket({ title: 'Printer jams', requester: 'li@example.com', priority: 'low' }, 'dana');
+  store.assign('T-0001', 'sam', 'dana');
+
+  const listed = capture();
+  assert.equal(main(['--data', file, 'list'], { out: listed, err: capture() }), 0);
+  assert.match(listed.toString(), /ASSIGNEE/);
+  assert.match(listed.toString(), /sam/);
+
+  const raw = capture();
+  assert.equal(main(['--data', file, 'list', '--raw'], { out: raw, err: capture() }), 0);
+  const lines = raw.toString().split('\n').filter((line) => line !== '');
+  assert.equal(lines[0], 'T-0001\topen\thigh\tVPN drops\tsam');
+  assert.equal(lines[1], 'T-0002\topen\tlow\tPrinter jams\t');
+
+  const shown = capture();
+  assert.equal(main(['--data', file, 'show', 'T-0001'], { out: shown, err: capture() }), 0);
+  assert.match(shown.toString(), /assignee\s+sam/);
+});
