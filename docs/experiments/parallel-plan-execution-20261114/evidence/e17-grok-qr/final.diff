+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { details, rawLine, table } = require('../src/format');
+
+const ticket = {
+  id: 'T-0001',
+  title: 'VPN drops',
+  status: 'open',
+  priority: 'high',
+  requester: 'maria@example.com',
+  assignee: 'dana',
+  created: '2025-09-01T08:15:00.000Z',
+  updated: '2025-09-01T09:00:00.000Z',
+};
+
+test('raw lines keep id, status, priority, title in that order and append assignee', () => {
+  assert.equal(rawLine(ticket), 'T-0001\topen\thigh\tVPN drops\tdana');
+  assert.equal(rawLine({ ...ticket, assignee: null }), 'T-0001\topen\thigh\tVPN drops\t');
+});
+
+test('the list table shows each ticket\'s assignee', () => {
+  const listed = table([ticket, { ...ticket, id: 'T-0002', assignee: null, title: 'Printer jams' }]);
+  assert.match(listed, /ASSIGNEE/);
+  assert.match(listed, /dana/);
+  assert.match(listed, /T-0002/);
+});
+
+test('details include the assignee', () => {
+  assert.match(details(ticket, []), /assignee\s+dana/);
+  const unassigned = details({ ...ticket, assignee: null }, []);
+  assert.match(unassigned, /^ {2}assignee\s+$/m);
+});
