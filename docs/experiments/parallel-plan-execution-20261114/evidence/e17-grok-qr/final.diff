@@ -0,0 +1,101 @@
+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { IMPORT_LIMIT } = require('../src/tickets/validate');
+const { ticketBody, withService } = require('./helpers');
+
+const envelope = (response, status, code) => {
+  assert.equal(response.status, status, JSON.stringify(response.body));
+  assert.equal(response.body.error.code, code);
+  assert.equal(typeof response.body.error.message, 'string');
+};
+
+describe('POST /tickets/import', () => {
+  test('creates every ticket in order and answers 201 with the new ids', async () => {
+    await withService({}, async (api) => {
+      const { status, body } = await api.post('/tickets/import', {
+        tickets: [
+          ticketBody({ title: 'VPN drops', priority: 'high' }),
+          ticketBody({ title: 'Printer jams', requester: 'li@example.com' }),
+        ],
+      }, { 'X-Actor': 'dana' });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 2, ids: ['T-0001', 'T-0002'] });
+      assert.equal((await api.get('/tickets/T-0001')).body.title, 'VPN drops');
+      assert.equal((await api.get('/tickets/T-0002')).body.requester, 'li@example.com');
+      const first = (await api.get('/tickets/T-0001/audit')).body.items[0];
+      assert.equal(first.action, 'ticket.created');
+      assert.equal(first.actor, 'dana');
+      const pending = (await api.get('/admin/outbox')).body.pending;
+      assert.deepEqual(pending.map((event) => [event.type, event.to, event.ticket]), [
+        ['ticket.created', 'maria@example.com', 'T-0001'],
+        ['ticket.created', 'li@example.com', 'T-0002'],
+      ]);
+    });
+  });
+
+  test('answers 400 naming the first invalid item and creates none of them', async () => {
+    await withService({}, async (api) => {
+      const response = await api.post('/tickets/import', {
+        tickets: [ticketBody(), ticketBody(), { title: 'no requester' }, ticketBody()],
+      });
+      envelope(response, 400, 'invalid');
+      assert.match(response.body.error.message, /tickets\[2\]/);
+      assert.equal((await api.get('/tickets')).body.items.length, 0);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0001');
+    });
+  });
+
+  test('refuses more than 5000 tickets, a non-list, and unknown fields', async () => {
+    await withService({ maxBodyBytes: 1024 * 1024 }, async (api) => {
+      envelope(await api.post('/tickets/import', { tickets: 'nope' }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [], extra: true }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [ticketBody({ owner: 'x' })] }), 400, 'invalid');
+      const tooMany = Array.from({ length: IMPORT_LIMIT + 1 }, () => ({ title: 'x', requester: 'y' }));
+      const response = await api.post('/tickets/import', { tickets: tooMany });
+      envelope(response, 400, 'invalid');
+      assert.match(response.body.error.message, /at most 5000/);
+    });
+  });
+
+  test('an empty list creates nothing', async () => {
+    await withService({}, async (api) => {
+      const { status, body } = await api.post('/tickets/import', { tickets: [] });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 0, ids: [] });
+    });
+  });
+
+  test('with a data file, a restarted service has every imported ticket', async (t) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-import-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    const dataFile = path.join(dir, 'tickets.json');
+    await withService({ dataFile }, async (api) => {
+      await api.post('/tickets/import', { tickets: [ticketBody(), ticketBody({ title: 'Second' })] });
+    });
+    await withService({ dataFile }, async (api) => {
+      assert.deepEqual((await api.get('/tickets')).body.items.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+      assert.equal((await api.get('/tickets/T-0002/audit')).body.items[0].action, 'ticket.created');
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0003');
+    });
+  });
+
+  test('imports 5000 tickets within 10 seconds', async () => {
+    await withService({ maxBodyBytes: 1024 * 1024 }, async (api) => {
+      const tickets = Array.from({ length: IMPORT_LIMIT }, (_, i) => ({ title: `t${i}`, requester: `r${i}@x.y` }));
+      const started = Date.now();
+      const { status, body } = await api.post('/tickets/import', { tickets });
+      const elapsed = Date.now() - started;
+      assert.equal(status, 201, JSON.stringify(body && body.error));
+      assert.equal(body.created, IMPORT_LIMIT);
+      assert.equal(body.ids[0], 'T-0001');
+      assert.equal(body.ids[IMPORT_LIMIT - 1], 'T-5000');
+      assert.ok(elapsed < 10_000, `import took ${elapsed}ms`);
+      assert.equal((await api.get('/tickets/T-5000')).body.title, 't4999');
+    });
+  });
+});
