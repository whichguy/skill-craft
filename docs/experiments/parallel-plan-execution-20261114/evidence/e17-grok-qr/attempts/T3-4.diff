+describe('the data file', () => {
+  test('tickets from 1.4.0 get due from created and priority and keep it', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    fs.writeFileSync(file, `${JSON.stringify(v14Document(), null, 2)}\n`);
+    const clock = manualClock(CREATED);
+    const tickets = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(tickets.get('T-0001').due, '2025-09-02T08:00:00.000Z');
+    assert.equal(tickets.get('T-0002').due, '2025-09-08T06:00:00.000Z');
+    assert.equal(tickets.get('T-0001').updated, CREATED);
+    assert.equal(tickets.history('T-0001').length, 1);
+
+    const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(saved.version, 1);
+    assert.equal(saved.tickets[0].due, '2025-09-02T08:00:00.000Z');
+    assert.equal(saved.tickets[1].due, '2025-09-08T06:00:00.000Z');
+
+    const later = TicketStore.open({
+      clock,
+      persistence: createPersistence(file, { clock }),
+      dueHours: { urgent: 99, high: 99, normal: 99, low: 99 },
+    });
+    assert.equal(later.get('T-0001').due, '2025-09-02T08:00:00.000Z');
+  });
+
+  test('a file this release wrote still has every 1.4.0 field', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock(CREATED);
+    const tickets = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    tickets.createTicket(input({ priority: 'high' }), 'dana');
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(document.version, 1);
+    const record = document.tickets[0];
+    const asV14 = {
+      id: record.id,
+      title: record.title,
+      priority: record.priority,
+      requester: record.requester,
+      status: record.status,
+      created: record.created,
+      updated: record.updated,
+    };
+    assert.deepEqual(asV14, {
+      id: 'T-0001',
+      title: 'Laptop will not boot',
+      priority: 'high',
+      requester: 'li@example.com',
+      status: 'open',
+      created: CREATED,
+      updated: CREATED,
+    });
+    assert.equal(record.due, '2025-09-02T08:00:00.000Z');
+  });
+
+  test('a due that is not a time is refused', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const document = v14Document();
+    document.tickets[0].due = 'soon';
+    fs.writeFileSync(file, JSON.stringify(document));
+    assert.throws(
+      () => createPersistence(file).load(),
+      (error) => error instanceof DataFileError && /tickets\[0\]\.due is not a time/.test(error.message),
+    );
+  });
+});
