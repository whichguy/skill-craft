+const { manualClock } = require('../src/clock');
+const { InvalidError } = require('../src/errors');
+const { DataFileError, createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { DEFAULT_DUE_HOURS, dueAt, isOverdue } = require('../src/tickets/due');
+const { parseListQuery } = require('../src/tickets/query');
+const { ticketBody, withService } = require('./helpers');
+
+const CREATED = '2025-09-01T08:00:00.000Z';
+const HOUR = 60 * 60 * 1000;
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+function store(dueHours) {
+  const clock = manualClock(CREATED);
+  return { clock, store: new TicketStore({ clock, dueHours }) };
+}
+
+const input = (overrides = {}) => ({ title: 'Laptop will not boot', requester: 'li@example.com', priority: 'normal', ...overrides });
+
+const envelope = (response, status, code) => {
+  assert.equal(response.status, status, JSON.stringify(response.body));
+  assert.equal(response.body.error.code, code);
+};
+
+const ids = (response) => response.body.items.map((ticket) => ticket.id);
+
+function v14Document() {
+  return {
+    version: 1,
+    savedAt: CREATED,
+    nextNumber: 3,
+    tickets: [
+      {
+        id: 'T-0001',
+        title: 'VPN drops',
+        priority: 'high',
+        requester: 'maria@example.com',
+        status: 'open',
+        created: CREATED,
+        updated: CREATED,
+      },
+      {
+        id: 'T-0002',
+        title: 'Badge reader',
+        priority: 'low',
+        requester: 'li@example.com',
+        status: 'in_progress',
+        created: '2025-09-01T06:00:00.000Z',
+        updated: '2025-09-01T07:00:00.000Z',
+      },
+    ],
+    audit: [
+      {
+        seq: 1,
+        ticket: 'T-0001',
+        action: 'ticket.created',
+        actor: 'dana',
+        at: CREATED,
+        changes: { title: { from: null, to: 'VPN drops' } },
+      },
+    ],
+    outbox: { nextId: 1, events: [] },
+  };
+}
+
+describe('dueAt', () => {
+  test('adds the default hours for each priority', () => {
+    assert.equal(dueAt(CREATED, 'urgent'), '2025-09-01T12:00:00.000Z');
+    assert.equal(dueAt(CREATED, 'high'), '2025-09-02T08:00:00.000Z');
+    assert.equal(dueAt(CREATED, 'normal'), '2025-09-04T08:00:00.000Z');
+    assert.equal(dueAt(CREATED, 'low'), '2025-09-08T08:00:00.000Z');
+  });
+
+  test('uses the hours given when they replace the defaults', () => {
+    assert.equal(dueAt(CREATED, 'urgent', { urgent: 1, high: 2, normal: 3, low: 4 }), '2025-09-01T09:00:00.000Z');
+  });
+});
+
+describe('isOverdue', () => {
+  const due = '2025-09-01T12:00:00.000Z';
+
+  test('an open ticket is overdue at and after its due time, not before', () => {
+    const ticket = { status: 'open', due };
+    assert.equal(isOverdue(ticket, new Date('2025-09-01T11:59:59.999Z')), false);
+    assert.equal(isOverdue(ticket, new Date(due)), true);
+    assert.equal(isOverdue(ticket, new Date('2025-09-01T12:00:00.001Z')), true);
+  });
+
+  test('in-progress tickets count and resolved or closed ones do not', () => {
+    const now = new Date('2025-09-01T13:00:00.000Z');
+    assert.equal(isOverdue({ status: 'in_progress', due }, now), true);
+    assert.equal(isOverdue({ status: 'resolved', due }, now), false);
+    assert.equal(isOverdue({ status: 'closed', due }, now), false);
+  });
+
+  test('a ticket with no due time is not overdue', () => {
+    assert.equal(isOverdue({ status: 'open' }, new Date(due)), false);
+  });
+});
+
+describe('loadConfig due times', () => {
+  test('due times are off and the hours are the defaults', () => {
+    const config = loadConfig({});
+    assert.equal(config.dueTimes, false);
+    assert.deepEqual(config.dueHours, DEFAULT_DUE_HOURS);
+  });
+
+  test('DUE_TIMES is on only when its value is on', () => {
+    assert.equal(loadConfig({ DUE_TIMES: 'on' }).dueTimes, true);
+    assert.equal(loadConfig({ DUE_TIMES: ' on ' }).dueTimes, true);
+    for (const value of ['1', 'true', 'ON', 'yes', '']) {
+      assert.equal(loadConfig({ DUE_TIMES: value }).dueTimes, false, value);
+    }
+  });
+
+  test('each priority can change its hours without a code change', () => {
+    const config = loadConfig({
+      DUE_HOURS_URGENT: '6',
+      DUE_HOURS_HIGH: '12',
+      DUE_HOURS_NORMAL: '48',
+      DUE_HOURS_LOW: '240',
+    });
+    assert.deepEqual(config.dueHours, { urgent: 6, high: 12, normal: 48, low: 240 });
+  });
+
+  test('a value the service cannot use names its variable', () => {
+    assert.throws(
+      () => loadConfig({ DUE_HOURS_URGENT: 'four' }),
+      (error) => error instanceof ConfigError && /DUE_HOURS_URGENT must be a whole number/.test(error.message),
+    );
+  });
+});
+
+describe('parseListQuery overdue', () => {
+  const query = (text, dueTimes = false) => parseListQuery(new URLSearchParams(text), { dueTimes });
+
+  test('ignores overdue until due times are on', () => {
+    assert.deepEqual(query('overdue=true'), { filters: {}, limit: 20, after: null });
+    assert.deepEqual(query('overdue=false'), { filters: {}, limit: 20, after: null });
+  });
+
+  test('reads overdue=true when due times are on', () => {
+    assert.deepEqual(query('overdue=true', true).filters, { overdue: true });
+    assert.deepEqual(query('overdue=true&status=open', true).filters, { status: 'open', overdue: true });
+  });
+
+  test('refuses an overdue value that is not true when due times are on', () => {
+    assert.throws(() => query('overdue=false', true), InvalidError);
+    assert.throws(() => query('overdue=yes', true), InvalidError);
+    assert.throws(() => query('overdue=', true), InvalidError);
+  });
+});
+
+describe('the store sets due once', () => {
+  test('a new ticket gets created plus the hours for its priority', () => {
+    const { store: tickets } = store();
+    assert.equal(tickets.createTicket(input({ priority: 'urgent' }), 'dana').due, '2025-09-01T12:00:00.000Z');
+    assert.equal(tickets.createTicket(input({ priority: 'high' }), 'dana').due, '2025-09-02T08:00:00.000Z');
+    assert.equal(tickets.createTicket(input({ priority: 'normal' }), 'dana').due, '2025-09-04T08:00:00.000Z');
+    assert.equal(tickets.createTicket(input({ priority: 'low' }), 'dana').due, '2025-09-08T08:00:00.000Z');
+  });
+
+  test('imported tickets get due the same way as created ones', () => {
+    const { store: tickets } = store();
+    tickets.createMany([input({ priority: 'urgent' }), input({ priority: 'low' })], 'dana');
+    assert.equal(tickets.get('T-0001').due, '2025-09-01T12:00:00.000Z');
+    assert.equal(tickets.get('T-0002').due, '2025-09-08T08:00:00.000Z');
+  });
+
+  test('changing priority or the hours does not move due', () => {
+    const { store: tickets } = store({ urgent: 1, high: 2, normal: 3, low: 4 });
+    const created = tickets.createTicket(input({ priority: 'normal' }), 'dana');
+    assert.equal(created.due, '2025-09-01T11:00:00.000Z');
+    tickets.update('T-0001', { priority: 'urgent' }, 'sam');
+    assert.equal(tickets.get('T-0001').due, created.due);
+    const again = new TicketStore({
+      clock: manualClock(CREATED),
+      dueHours: DEFAULT_DUE_HOURS,
+      state: JSON.parse(JSON.stringify(tickets.snapshot())),
+    });
+    assert.equal(again.get('T-0001').due, created.due);
+  });
+
+  test('overdue lists only open and in-progress tickets past due', () => {
+    const { clock, store: tickets } = store();
+    tickets.createTicket(input({ priority: 'urgent' }), 'dana');
+    tickets.createTicket(input({ priority: 'low' }), 'dana');
+    tickets.createTicket(input({ priority: 'urgent' }), 'dana');
+    tickets.transition('T-0003', 'in_progress', 'sam');
+    assert.deepEqual(tickets.list({ filters: { overdue: true } }).items.map((ticket) => ticket.id), []);
+    clock.advance(4 * HOUR);
+    assert.deepEqual(tickets.list({ filters: { overdue: true } }).items.map((ticket) => ticket.id), ['T-0001', 'T-0003']);
+    tickets.transition('T-0003', 'resolved', 'sam');
+    assert.deepEqual(tickets.list({ filters: { overdue: true } }).items.map((ticket) => ticket.id), ['T-0001']);
+  });
+});
