diff --git a/src/tickets/due.js b/src/tickets/due.js
new file mode 100644
index 0000000..0c293a9
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,30 @@
+'use strict';
+
+const { isActive } = require('./states');
+
+/**
+ * Response hours by priority, used when a ticket first gets a due time. A later change of these hours does not move a
+ * due time that is already set (the store keeps `due` as it was written).
+ */
+const DEFAULT_DUE_HOURS = Object.freeze({
+  urgent: 4,
+  high: 24,
+  normal: 72,
+  low: 168,
+});
+
+const MS_PER_HOUR = 60 * 60 * 1000;
+
+/** ISO time `hours` hours after `created` for `priority`, using `hoursByPriority` (defaults if a priority is missing). */
+function dueAt(created, priority, hoursByPriority = DEFAULT_DUE_HOURS) {
+  const hours = hoursByPriority[priority] ?? DEFAULT_DUE_HOURS[priority];
+  return new Date(Date.parse(created) + hours * MS_PER_HOUR).toISOString();
+}
+
+/** Open or in-progress tickets whose due time is at or before `now`. Tickets with no due time are not overdue. */
+function isOverdue(ticket, now) {
+  if (ticket.due == null || !isActive(ticket.status)) return false;
+  return Date.parse(ticket.due) <= now.getTime();
+}
+
+module.exports = { DEFAULT_DUE_HOURS, dueAt, isOverdue };
