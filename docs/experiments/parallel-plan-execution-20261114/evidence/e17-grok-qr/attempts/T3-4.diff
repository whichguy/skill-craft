+describe('the API with DUE_TIMES off', () => {
+  test('answers without due and ignores overdue', async () => {
+    const clock = manualClock(CREATED);
+    await withService({ clock }, async (api) => {
+      const created = await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      assert.equal(created.status, 201);
+      assert.equal('due' in created.body, false);
+      assert.equal('due' in (await api.get('/tickets/T-0001')).body, false);
+      clock.advance(5 * HOUR);
+      const listed = await api.get('/tickets?overdue=true');
+      assert.deepEqual(ids(listed), ['T-0001']);
+      assert.equal('due' in listed.body.items[0], false);
+    });
+  });
+});
+
+describe('the API with DUE_TIMES on', () => {
+  test('every ticket shows due, and a priority change leaves it', async () => {
+    await withService({ dueTimes: true }, async (api) => {
+      const created = await api.post('/tickets', ticketBody({ priority: 'high' }));
+      assert.equal(created.status, 201);
+      assert.equal(created.body.due, '2025-09-02T08:00:00.000Z');
+      const patched = await api.patch('/tickets/T-0001', { priority: 'urgent' });
+      assert.equal(patched.body.due, created.body.due);
+      assert.equal((await api.get('/tickets/T-0001')).body.due, created.body.due);
+    });
+  });
+
+  test('imported tickets show due', async () => {
+    await withService({ dueTimes: true }, async (api) => {
+      await api.post('/tickets/import', { tickets: [ticketBody({ priority: 'high' }), ticketBody({ priority: 'low' })] });
+      assert.equal((await api.get('/tickets/T-0001')).body.due, '2025-09-02T08:00:00.000Z');
+      assert.equal((await api.get('/tickets/T-0002')).body.due, '2025-09-08T08:00:00.000Z');
+    });
+  });
+
+  test('GET /tickets?overdue=true lists open and in-progress tickets past due', async () => {
+    const clock = manualClock(CREATED);
+    await withService({ dueTimes: true, clock }, async (api) => {
+      await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      await api.post('/tickets', ticketBody({ priority: 'low' }));
+      await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+      assert.deepEqual(ids(await api.get('/tickets?overdue=true')), []);
+      clock.advance(4 * HOUR);
+      assert.deepEqual(ids(await api.get('/tickets?overdue=true')), ['T-0001', 'T-0003']);
+      await api.post('/tickets/T-0003/transition', { to: 'resolved' });
+      assert.deepEqual(ids(await api.get('/tickets?overdue=true')), ['T-0001']);
+      assert.deepEqual(ids(await api.get('/tickets?overdue=true&status=open')), ['T-0001']);
+    });
+  });
+
+  test('pages an overdue listing and refuses a bad overdue value', async () => {
+    const clock = manualClock(CREATED);
+    await withService({ dueTimes: true, clock }, async (api) => {
+      for (let n = 0; n < 3; n += 1) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      clock.advance(4 * HOUR);
+      const first = await api.get('/tickets?overdue=true&limit=2');
+      assert.deepEqual(ids(first), ['T-0001', 'T-0002']);
+      const second = await api.get(`/tickets?overdue=true&limit=2&cursor=${first.body.next}`);
+      assert.deepEqual(ids(second), ['T-0003']);
+      assert.equal(second.body.next, null);
+      envelope(await api.get('/tickets?overdue=false'), 400, 'invalid');
+      envelope(await api.get('/tickets?overdue=yes'), 400, 'invalid');
+    });
+  });
+
+  test('the hours come from configuration, and a restart keeps due', async (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    const clock = manualClock(CREATED);
+    const dueHours = { urgent: 1, high: 2, normal: 3, low: 4 };
+    await withService({ dataFile, dueTimes: true, dueHours, clock }, async (api) => {
+      const { body } = await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      assert.equal(body.due, '2025-09-01T09:00:00.000Z');
+    });
+    await withService({ dataFile, dueTimes: true, clock }, async (api) => {
+      assert.equal((await api.get('/tickets/T-0001')).body.due, '2025-09-01T09:00:00.000Z');
+    });
+  });
+
+  test('due times are written before the flag is switched on', async (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    const clock = manualClock(CREATED);
