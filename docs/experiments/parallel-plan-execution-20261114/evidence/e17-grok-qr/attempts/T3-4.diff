+    const saved = JSON.parse(fs.readFileSync(dataFile, 'utf8'));
+    assert.equal(saved.version, 1);
+    assert.equal(saved.tickets[0].due, '2025-09-01T12:00:00.000Z');
+    await withService({ dataFile, dueTimes: true, clock }, async (api) => {
+      assert.equal((await api.get('/tickets/T-0001')).body.due, '2025-09-01T12:00:00.000Z');
