   });
+
+  test('a ticket must match every filter given', () => {
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'high' }), true);
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'low' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'open', assignee: 'dana' }), true);
+    assert.equal(matchesFilters(ticket, { status: 'closed', assignee: 'dana' }), false);
+  });
+
+  test('an assignee filter keeps that agent, and null keeps unassigned tickets', () => {
+    assert.equal(matchesFilters(ticket, { assignee: 'dana' }), true);
+    assert.equal(matchesFilters(ticket, { assignee: 'sam' }), false);
+    assert.equal(matchesFilters({ ...ticket, assignee: null }, { assignee: null }), true);
+    assert.equal(matchesFilters(ticket, { assignee: null }), false);
+  });
 });
