+describe('assign', () => {
+  test('sets the assignee, records the change, and notifies the agent', () => {
+    const { clock, store: tickets } = store();
+    tickets.create(input(), 'dana');
+    clock.advance(60_000);
+    const assigned = tickets.assign('T-0001', 'sam', 'dana');
+    assert.equal(assigned.assignee, 'sam');
+    assert.equal(assigned.updated, '2025-09-01T08:01:00.000Z');
+    const last = tickets.history('T-0001').at(-1);
+    assert.equal(last.action, 'ticket.assigned');
+    assert.equal(last.actor, 'dana');
+    assert.deepEqual(last.changes, { assignee: { from: null, to: 'sam' } });
+    const [event] = tickets.outboxReport().pending.filter((item) => item.type === 'ticket.assigned');
+    assert.equal(event.to, 'sam');
+    assert.equal(event.ticket, 'T-0001');
+    assert.equal(event.key, 'ticket.assigned:T-0001:sam');
+  });
+
+  test('unassigns with null and does not notify', () => {
+    const { store: tickets } = store();
+    tickets.create(input(), 'dana');
+    tickets.assign('T-0001', 'sam', 'dana');
+    const before = tickets.outboxReport().pending.length;
+    const cleared = tickets.assign('T-0001', null, 'dana');
+    assert.equal(cleared.assignee, null);
+    assert.deepEqual(tickets.history('T-0001').at(-1).changes, { assignee: { from: 'sam', to: null } });
+    assert.equal(tickets.outboxReport().pending.length, before);
+  });
+
+  test('assigning the agent it already has changes nothing', () => {
+    const { clock, store: tickets } = store();
+    tickets.create(input(), 'dana');
+    tickets.assign('T-0001', 'sam', 'dana');
+    clock.advance(60_000);
+    const same = tickets.assign('T-0001', 'sam', 'lee');
+    assert.equal(same.updated, '2025-09-01T08:00:00.000Z');
+    assert.equal(tickets.history('T-0001').length, 2);
+    assert.equal(tickets.outboxReport().pending.filter((event) => event.type === 'ticket.assigned').length, 1);
+  });
+
+  test('only open and in-progress tickets can be assigned', () => {
+    const { store: tickets } = store();
+    tickets.create(input(), 'dana');
+    tickets.transition('T-0001', 'in_progress', 'dana');
+    assert.equal(tickets.assign('T-0001', 'sam', 'dana').assignee, 'sam');
+    tickets.transition('T-0001', 'resolved', 'dana');
+    assert.throws(() => tickets.assign('T-0001', 'lee', 'dana'), ConflictError);
+    assert.throws(() => tickets.assign('T-0001', null, 'dana'), ConflictError);
+    tickets.transition('T-0001', 'closed', 'dana');
+    assert.throws(() => tickets.assign('T-0001', 'sam', 'dana'), ConflictError);
+    assert.equal(tickets.get('T-0001').assignee, 'sam');
+  });
+
+  test('a new ticket is unassigned', () => {
+    const { store: tickets } = store();
+    assert.equal(tickets.create(input(), 'dana').assignee, null);
+  });
+});
