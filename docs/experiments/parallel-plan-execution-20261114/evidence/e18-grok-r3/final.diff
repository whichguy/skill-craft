+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { InvalidError } = require('../src/errors');
+const { TicketStore } = require('../src/store');
+const { manualClock } = require('../src/clock');
+const validate = require('../src/tickets/validate');
+const { ticketBody, withService } = require('./helpers');
+
+const envelope = (response, status, code) => {
+  assert.equal(response.status, status, JSON.stringify(response.body));
+  assert.equal(response.body.error.code, code);
+  assert.equal(typeof response.body.error.message, 'string');
+};
+
+const listedIds = async (api) => (await api.get('/tickets?limit=100')).body.items.map((ticket) => ticket.id);
+
+describe('validate.importTickets', () => {
+  test('checks each item as a new ticket and keeps their order', () => {
+    assert.deepEqual(
+      validate.importTickets({
+        tickets: [
+          { title: '  VPN drops ', requester: 'li@example.com' },
+          { title: 'Printer', requester: 'maria@example.com', priority: 'high' },
+        ],
+      }),
+      [
+        { title: 'VPN drops', requester: 'li@example.com', priority: 'normal' },
+        { title: 'Printer', requester: 'maria@example.com', priority: 'high' },
+      ],
+    );
+  });
+
+  test('names the first invalid item by its index, 0 for the first', () => {
+    const invalid = (body, message) =>
+      assert.throws(() => validate.importTickets(body), (error) => error instanceof InvalidError && message.test(error.message));
+
+    invalid({ tickets: [{ requester: 'a' }, { title: 'ok', requester: 'b' }] }, /tickets\[0\].*index 0.*title must be a string/);
+    invalid(
+      { tickets: [{ title: 'a', requester: 'b' }, { title: 'ok', requester: 'c' }, { title: '', requester: 'd' }] },
+      /tickets\[2\].*index 2/,
+    );
+    invalid({ tickets: [{ title: 'a', requester: 'b' }, null] }, /tickets\[1\].*index 1.*must be an object/);
+    invalid({ tickets: 'nope' }, /tickets must be a list/);
+    invalid({ tickets: [{ title: 'a', requester: 'b' }], extra: true }, /unknown field: extra/);
+    invalid({ tickets: Array.from({ length: validate.IMPORT_LIMIT + 1 }, () => ({ title: 'a', requester: 'b' })) }, /at most 5000/);
+    assert.deepEqual(validate.importTickets({ tickets: [] }), []);
+    assert.equal(validate.importTickets({ tickets: Array.from({ length: validate.IMPORT_LIMIT }, () => ({ title: 'a', requester: 'b' })) }).length, 5000);
+  });
+});
+
+describe('TicketStore.createMany', () => {
+  test('opens tickets in order, records each and notifies each requester, and saves once', () => {
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    let saves = 0;
+    const store = new TicketStore({
+      clock,
+      persistence: { save() { saves += 1; } },
+    });
+    const ids = store.createMany(
+      [
+        { title: 'One', requester: 'a@example.com', priority: 'low' },
+        { title: 'Two', requester: 'b@example.com', priority: 'urgent' },
+      ],
+      'dana',
+    );
+    assert.deepEqual(ids, ['T-0001', 'T-0002']);
+    assert.equal(saves, 1);
+    assert.equal(store.get('T-0001').title, 'One');
+    assert.equal(store.get('T-0002').priority, 'urgent');
+    assert.deepEqual(store.history('T-0001').map((entry) => [entry.action, entry.actor]), [['ticket.created', 'dana']]);
+    assert.deepEqual(
+      store.outboxReport().pending.map((event) => [event.type, event.to, event.ticket]),
+      [
+        ['ticket.created', 'a@example.com', 'T-0001'],
+        ['ticket.created', 'b@example.com', 'T-0002'],
+      ],
+    );
+    assert.deepEqual(store.createMany([], 'dana'), []);
+    assert.equal(saves, 1);
+  });
+});
+
+describe('POST /tickets/import', () => {
+  test('creates every ticket in order and answers 201 with the new ids', async () => {
+    await withService({}, async (api) => {
+      const { status, body } = await api.post('/tickets/import', {
+        tickets: [
+          ticketBody({ title: 'VPN drops', priority: 'high' }),
+          ticketBody({ title: 'Printer jams', requester: 'li@example.com' }),
+        ],
+      });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 2, ids: ['T-0001', 'T-0002'] });
+      assert.equal((await api.get('/tickets/T-0001')).body.title, 'VPN drops');
+      assert.equal((await api.get('/tickets/T-0001')).body.status, 'open');
+      assert.equal((await api.get('/tickets/T-0002')).body.requester, 'li@example.com');
+      assert.equal((await api.get('/tickets/T-0002')).body.priority, 'normal');
+    });
+  });
+
+  test('records each ticket and notifies each requester as when one ticket is created', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets/import', {
+        tickets: [
+          ticketBody({ title: 'VPN', requester: 'maria@example.com' }),
+          ticketBody({ title: 'Printer', requester: 'li@example.com' }),
+        ],
+      }, { 'X-Actor': 'sam' });
+      const first = (await api.get('/tickets/T-0001/audit')).body.items;
+      const second = (await api.get('/tickets/T-0002/audit')).body.items;
+      assert.equal(first.length, 1);
+      assert.equal(first[0].action, 'ticket.created');
+      assert.equal(first[0].actor, 'sam');
+      assert.equal(second[0].actor, 'sam');
+      const pending = (await api.get('/admin/outbox')).body.pending;
+      assert.deepEqual(pending.map((event) => [event.type, event.to, event.ticket, event.key]), [
+        ['ticket.created', 'maria@example.com', 'T-0001', 'ticket.created:T-0001'],
+        ['ticket.created', 'li@example.com', 'T-0002', 'ticket.created:T-0002'],
+      ]);
+    });
+  });
+
+  test('continues the id sequence after tickets that already exist', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const { body } = await api.post('/tickets/import', { tickets: [ticketBody({ title: 'Second' }), ticketBody({ title: 'Third' })] });
+      assert.deepEqual(body.ids, ['T-0002', 'T-0003']);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0004');
+    });
+  });
+
+  test('answers 400 naming the first invalid item by its index, and creates none', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody({ title: 'Already there' }));
+      const response = await api.post('/tickets/import', {
+        tickets: [
+          ticketBody({ title: 'Good' }),
+          ticketBody({ title: 'Also good' }),
+          ticketBody({ title: '' }),
+          ticketBody({ title: 'Never reached', owner: 'dana' }),
+        ],
+      });
+      envelope(response, 400, 'invalid');
+      assert.match(response.body.error.message, /tickets\[2\]/);
+      assert.match(response.body.error.message, /index 2/);
+      assert.match(response.body.error.message, /is invalid/);
+      assert.deepEqual(await listedIds(api), ['T-0001']);
+      assert.equal((await api.post('/tickets', ticketBody({ title: 'Next' }))).body.id, 'T-0002');
+    });
+  });
+
+  test('names index 0 when the first item is invalid', async () => {
+    await withService({}, async (api) => {
+      const response = await api.post('/tickets/import', { tickets: [{ requester: 'a@example.com' }] });
+      envelope(response, 400, 'invalid');
+      assert.match(response.body.error.message, /tickets\[0\]/);
+      assert.match(response.body.error.message, /index 0/);
+      assert.deepEqual(await listedIds(api), []);
+    });
+  });
+
+  test('refuses more than 5000 tickets without creating any', async () => {
+    await withService({}, async (api) => {
+      const tickets = Array.from({ length: 5001 }, (_, i) => ticketBody({ title: `T${i}` }));
+      const response = await api.post('/tickets/import', { tickets });
+      envelope(response, 400, 'invalid');
+      assert.match(response.body.error.message, /5000/);
+      assert.deepEqual(await listedIds(api), []);
+    });
+  });
+
+  test('refuses a body that is not a tickets list', async () => {
+    await withService({}, async (api) => {
+      envelope(await api.post('/tickets/import', { title: 'nope', requester: 'a@example.com' }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: { title: 'nope', requester: 'a@example.com' } }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [ticketBody()], extra: 1 }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', []), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [null] }), 400, 'invalid');
+      envelope(await api.post('/tickets/import', { tickets: [ticketBody({ owner: 'dana' })] }), 400, 'invalid');
+    });
+  });
+
+  test('an empty list creates none and answers 201', async () => {
+    await withService({}, async (api) => {
+      const { status, body } = await api.post('/tickets/import', { tickets: [] });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 0, ids: [] });
+    });
+  });
+
+  test('an import of 5000 tickets is answered within 10 seconds', { timeout: 15_000 }, async (t) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-import-5k-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    await withService({ dataFile: path.join(dir, 'tickets.json') }, async (api) => {
+      const tickets = Array.from({ length: 5000 }, (_, i) => ({
+        title: `Imported ${i}`,
+        requester: `user${i}@example.com`,
+      }));
+      const started = Date.now();
+      const { status, body } = await api.post('/tickets/import', { tickets });
+      const elapsed = Date.now() - started;
+      assert.equal(status, 201, JSON.stringify(body && body.error));
+      assert.equal(body.created, 5000);
+      assert.equal(body.ids.length, 5000);
+      assert.equal(body.ids[0], 'T-0001');
+      assert.equal(body.ids[4999], 'T-5000');
+      assert.equal((await api.get('/tickets/T-0001')).body.title, 'Imported 0');
+      assert.equal((await api.get('/tickets/T-5000')).body.title, 'Imported 4999');
+      assert.ok(elapsed < 10_000, `import of 5000 took ${elapsed} ms`);
+    });
+  });
+
+  test('with a data file, imported tickets are saved together and survive a restart', async (t) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-import-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    const dataFile = path.join(dir, 'tickets.json');
+    await withService({ dataFile }, async (api) => {
+      const { body } = await api.post('/tickets/import', {
+        tickets: [ticketBody({ title: 'One' }), ticketBody({ title: 'Two' })],
+      }, { 'X-Actor': 'dana' });
+      assert.deepEqual(body.ids, ['T-0001', 'T-0002']);
+    });
+    await withService({ dataFile }, async (api) => {
+      assert.deepEqual((await api.get('/tickets')).body.items.map((ticket) => [ticket.id, ticket.title]), [
+        ['T-0001', 'One'],
+        ['T-0002', 'Two'],
+      ]);
+      assert.equal((await api.get('/tickets/T-0001/audit')).body.items[0].actor, 'dana');
+      assert.equal((await api.get('/admin/outbox')).body.pending.length, 2);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0003');
+    });
+  });
+});
