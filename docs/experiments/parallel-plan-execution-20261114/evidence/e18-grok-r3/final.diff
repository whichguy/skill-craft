@@ -0,0 +1,42 @@
+'use strict';
+
+/**
+ * Response-time due dates: a ticket is due a number of hours after it was created, by its priority at that moment.
+ * The instant is stored on the ticket and never moved (docs/decisions/0009-due-times.md).
+ */
+
+const { isActive } = require('./states');
+
+const HOUR_MS = 60 * 60 * 1000;
+
+const DEFAULT_DUE_HOURS = Object.freeze({
+  urgent: 4,
+  high: 24,
+  normal: 72,
+  low: 168,
+});
+
+function hoursFor(priority, dueHours = DEFAULT_DUE_HOURS) {
+  const hours = dueHours[priority];
+  return hours === undefined ? DEFAULT_DUE_HOURS[priority] : hours;
+}
+
+/** The ISO time `hoursFor(priority)` after `created`. */
+function dueAt(created, priority, dueHours = DEFAULT_DUE_HOURS) {
+  return new Date(Date.parse(created) + hoursFor(priority, dueHours) * HOUR_MS).toISOString();
+}
+
+/** Open and in-progress tickets whose due time has been reached. */
+function isOverdue(ticket, now) {
+  if (!isActive(ticket.status) || ticket.due == null) return false;
+  const at = now instanceof Date ? now.getTime() : Date.parse(now);
+  return Date.parse(ticket.due) <= at;
+}
+
+/** Copy `ticket` with `due` filled from created and priority when it has none. */
+function withDue(ticket, dueHours = DEFAULT_DUE_HOURS) {
+  if (ticket.due != null) return { ...ticket };
+  return { ...ticket, due: dueAt(ticket.created, ticket.priority, dueHours) };
+}
+
+module.exports = { DEFAULT_DUE_HOURS, dueAt, hoursFor, isOverdue, withDue };
