+    });
+  });
+});
+
+test('ticket.assigned has a renderable notification template', () => {
+  const rendered = render({ type: 'ticket.assigned', ticket: 'T-0007', data: { title: 'VPN drops' } });
+  assert.equal(rendered.subject, '[T-0007] Assigned to you');
+  assert.match(rendered.body, /"VPN drops" has been assigned to you/);
+});
+
+describe('assignment persistence', () => {
+  test('round-trips an assignee and loads an old record without the field as null', (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(dataFile, { clock }) });
+    store.createTicket({ title: 'Printer jams', requester: 'maria@example.com', priority: 'normal' }, 'sam');
+    store.assign('T-0001', 'dana', 'sam');
+    assert.equal(createPersistence(dataFile).load().tickets[0].assignee, 'dana');
+
+    const document = JSON.parse(fs.readFileSync(dataFile, 'utf8'));
+    delete document.tickets[0].assignee;
+    fs.writeFileSync(dataFile, JSON.stringify(document));
+    assert.equal(createPersistence(dataFile).load().tickets[0].assignee, null);
+  });
+
+  test('refuses a present invalid agent name', (t) => {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(dataFile, { clock }) });
+    store.createTicket({ title: 'Printer jams', requester: 'maria@example.com', priority: 'normal' }, 'sam');
+    const document = JSON.parse(fs.readFileSync(dataFile, 'utf8'));
+    document.tickets[0].assignee = 'a'.repeat(65);
+    fs.writeFileSync(dataFile, JSON.stringify(document));
+    assert.throws(() => createPersistence(dataFile).load(), (error) => error instanceof DataFileError && /tickets\[0\]\.assignee/.test(error.message));
+  });
+});
+
+test('CLI list and show display assignee, and raw output appends it after the first four columns', (t) => {
+  const dataFile = path.join(folder(t), 'tickets.json');
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(dataFile, { clock }) });
+  store.createTicket({ title: 'Assigned ticket', requester: 'maria@example.com', priority: 'normal' }, 'sam');
+  store.assign('T-0001', 'dana', 'sam');
+  store.createTicket({ title: 'Unassigned ticket', requester: 'li@example.com', priority: 'low' }, 'sam');
+
+  const table = runCli(['list'], { DATA_FILE: dataFile });
+  assert.equal(table.code, 0);
+  assert.match(table.output, /ASSIGNEE/);
+  assert.match(table.output, /dana/);
+  assert.doesNotMatch(table.output, /null/);
+
+  const details = runCli(['show', 'T-0002'], { DATA_FILE: dataFile });
+  assert.equal(details.code, 0);
+  assert.match(details.output, /^  assignee\s*$/m);
+  assert.doesNotMatch(details.output, /assignee\s+null/);
+
+  const raw = runCli(['list', '--raw'], { DATA_FILE: dataFile });
+  assert.equal(raw.code, 0);
+  const lines = raw.output.slice(0, -1).split('\n');
+  const assigned = lines[0].split('\t');
+  const unassigned = lines[1].split('\t');
+  assert.deepEqual(RAW_COLUMNS.slice(0, 4), ['id', 'status', 'priority', 'title']);
+  assert.deepEqual(assigned.slice(0, 4), ['T-0001', 'open', 'normal', 'Assigned ticket']);
+  assert.equal(assigned[4], 'dana');
+  assert.deepEqual(unassigned.slice(0, 4), ['T-0002', 'open', 'low', 'Unassigned ticket']);
+  assert.equal(unassigned[4], '');
+});
