+'use strict';
+
+const RESPONSE_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+function dueTime(ticket, hours = RESPONSE_HOURS) {
+  return new Date(Date.parse(ticket.created) + hours[ticket.priority] * 60 * 60 * 1000).toISOString();
+}
+
+module.exports = { RESPONSE_HOURS, dueTime };
