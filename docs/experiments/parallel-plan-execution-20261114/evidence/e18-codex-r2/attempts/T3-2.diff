+test('overdue filter checks active status, strict boundary, combined filters and cursor pages', async () => {
+  const clock = manualClock();
+  await withService({ dueTimes: true, clock }, async (api) => {
+    for (let i = 0; i < 5; i++) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0004/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'closed' });
+    clock.advance(4 * hour);
+    assert.deepEqual((await api.get('/tickets?overdue=true')).body.items, []);
+    clock.advance(1);
+    const first = (await api.get('/tickets?overdue=true&limit=2')).body;
+    assert.deepEqual(first.items.map(t => t.id), ['T-0001', 'T-0002']);
+    assert.deepEqual((await api.get(`/tickets?overdue=true&limit=2&cursor=${encodeURIComponent(first.next)}`)).body.items.map(t => t.id), ['T-0005']);
+    assert.deepEqual((await api.get('/tickets?overdue=true&status=in_progress')).body.items.map(t => t.id), ['T-0002']);
+    assert.deepEqual((await api.get('/tickets?overdue=true&priority=low')).body.items, []);
+    assert.equal((await api.get('/tickets?overdue=bad')).status, 400);
+  });
+});
