+test('persistence accepts optional due and rejects corrupt deadlines', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock });
+  store.createTicket(ticketBody(), 'system');
+  const document = toDocument(store.snapshot(), clock.now());
+  const fail = message => new Error(message);
+  assert.equal(fromDocument(document, fail).tickets.length, 1);
+  document.tickets[0].due = 'bad';
+  assert.throws(() => fromDocument(document, fail), /due is not a time/);
