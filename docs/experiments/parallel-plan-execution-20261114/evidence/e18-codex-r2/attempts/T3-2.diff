+test('CLI formats append deadlines while preserving existing raw columns', () => {
+  const { rawLine, details, table } = require('../src/format');
+  const clock = manualClock();
+  const store = new TicketStore({ clock, dueTimes: true });
+  const ticket = store.createTicket(ticketBody(), 'system');
+  assert.deepEqual(rawLine(ticket).split('\t'), [ticket.id, ticket.status, ticket.priority, ticket.title, '', ticket.due]);
+  assert.match(table([ticket]), /DUE/);
+  assert.match(details(ticket, []), new RegExp(ticket.due));
+  const hidden = { ...ticket };
+  delete hidden.due;
+  assert.equal(rawLine(hidden).split('\t').length, 5);
+  assert.doesNotMatch(table([hidden]), /DUE/);
+});
