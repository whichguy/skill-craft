@@ -0,0 +1,146 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { loadConfig, ConfigError } = require('../src/config');
+const { TicketStore } = require('../src/store');
+const { createPersistence, toDocument, fromDocument } = require('../src/persistence');
+const { RESPONSE_HOURS } = require('../src/tickets/due');
+const { withService, ticketBody } = require('./helpers');
+
+const hour = 3600000;
+
+test('response hour configuration defaults, overrides, and invalid values', () => {
+  assert.equal(loadConfig({}).dueTimes, false);
+  assert.deepEqual(loadConfig({}).responseHours, RESPONSE_HOURS);
+  const config = loadConfig({ DUE_TIMES: 'on', RESPONSE_HOURS_URGENT: '2', RESPONSE_HOURS_LOW: '' });
+  assert.equal(config.dueTimes, true);
+  assert.equal(config.responseHours.urgent, 2);
+  assert.equal(config.responseHours.low, 168);
+  for (const value of ['0', '-1', '1.5', 'no', '876001']) {
+    assert.throws(() => loadConfig({ RESPONSE_HOURS_NORMAL: value }), ConfigError);
+  }
+});
+
+test('every priority gets a fixed due time, also during imports', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock, dueTimes: true });
+  for (const [priority, hours] of Object.entries(RESPONSE_HOURS)) {
+    const ticket = store.createTicket(ticketBody({ priority }), 'system');
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), hours * hour);
+    assert.equal(store.update(ticket.id, { priority: 'low' }, 'system').due, ticket.due);
+    assert.equal(store.assign(ticket.id, 'Dana', 'system').due, ticket.due);
+  }
+  const custom = new TicketStore({ clock, dueTimes: true, responseHours: { urgent: 2 } });
+  custom.importTickets([ticketBody({ priority: 'urgent' })], 'system');
+  assert.equal(Date.parse(custom.get('T-0001').due) - clock.now().getTime(), 2 * hour);
+});
+
+test('backfill is saved before serving, preserves history, and survives changed settings and flag', async (t) => {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const dataFile = path.join(dir, 'tickets.json');
+  const clock = manualClock();
+  const old = new TicketStore({ clock });
+  old.createTicket(ticketBody({ priority: 'high' }), 'system');
+  old.transition('T-0001', 'in_progress', 'system');
+  const document = toDocument(old.snapshot(), clock.now());
+  delete document.tickets[0].due;
+  fs.writeFileSync(dataFile, JSON.stringify(document));
+  const before = JSON.parse(JSON.stringify(document));
+  const service = require('../src/server').createService({ dataFile, workerIntervalMs: 0 }, { clock });
+  const saved = JSON.parse(fs.readFileSync(dataFile));
+  assert.equal(saved.version, 1);
+  assert.equal(Date.parse(saved.tickets[0].due) - Date.parse(saved.tickets[0].created), 24 * hour);
+  assert.deepEqual(saved.audit, before.audit);
+  assert.deepEqual(saved.outbox, before.outbox);
+  assert.equal(saved.tickets[0].updated, before.tickets[0].updated);
+  assert.equal(service.store.get('T-0001').due, undefined);
+  await withService({ dataFile, dueTimes: true, responseHours: { high: 1 }, clock }, async (api) => {
+    const got = (await api.get('/tickets/T-0001')).body;
+    assert.equal(got.due, saved.tickets[0].due);
+    assert.equal((await api.patch('/tickets/T-0001', { priority: 'urgent' })).body.due, got.due);
+  });
+  assert.equal(createPersistence(dataFile).load().tickets[0].due, saved.tickets[0].due);
+});
