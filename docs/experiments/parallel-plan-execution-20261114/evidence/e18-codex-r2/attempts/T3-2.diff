+test('disabled feature hides persisted due on every ticket response and ignores overdue query', async () => {
+  const clock = manualClock();
+  await withService({ clock }, async (api, service) => {
+    const ticket = (await api.post('/tickets', ticketBody())).body;
+    assert.equal('due' in ticket, false);
