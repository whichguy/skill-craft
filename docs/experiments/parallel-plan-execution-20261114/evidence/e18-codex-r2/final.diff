+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { loadConfig, ConfigError } = require('../src/config');
+const { TicketStore } = require('../src/store');
+const { createPersistence, toDocument, fromDocument } = require('../src/persistence');
+const { RESPONSE_HOURS } = require('../src/tickets/due');
+const { withService, ticketBody } = require('./helpers');
+
+const hour = 3600000;
+
+test('response hour configuration defaults, overrides, and invalid values', () => {
+  assert.equal(loadConfig({}).dueTimes, false);
+  assert.deepEqual(loadConfig({}).responseHours, RESPONSE_HOURS);
+  const config = loadConfig({ DUE_TIMES: 'on', RESPONSE_HOURS_URGENT: '2', RESPONSE_HOURS_LOW: '' });
+  assert.equal(config.dueTimes, true);
+  assert.equal(config.responseHours.urgent, 2);
+  assert.equal(config.responseHours.low, 168);
+  for (const value of ['0', '-1', '1.5', 'no', '876001']) {
+    assert.throws(() => loadConfig({ RESPONSE_HOURS_NORMAL: value }), ConfigError);
+  }
+});
+
+test('every priority gets a fixed due time, also during imports', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock, dueTimes: true });
+  for (const [priority, hours] of Object.entries(RESPONSE_HOURS)) {
+    const ticket = store.createTicket(ticketBody({ priority }), 'system');
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), hours * hour);
+    assert.equal(store.update(ticket.id, { priority: 'low' }, 'system').due, ticket.due);
+    assert.equal(store.assign(ticket.id, 'Dana', 'system').due, ticket.due);
+  }
+  const custom = new TicketStore({ clock, dueTimes: true, responseHours: { urgent: 2 } });
+  custom.importTickets([ticketBody({ priority: 'urgent' })], 'system');
+  assert.equal(Date.parse(custom.get('T-0001').due) - clock.now().getTime(), 2 * hour);
+});
+
+test('backfill is saved before serving, preserves history, and survives changed settings and flag', async (t) => {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const dataFile = path.join(dir, 'tickets.json');
+  const clock = manualClock();
+  const old = new TicketStore({ clock });
+  old.createTicket(ticketBody({ priority: 'high' }), 'system');
+  old.transition('T-0001', 'in_progress', 'system');
+  const document = toDocument(old.snapshot(), clock.now());
+  delete document.tickets[0].due;
+  fs.writeFileSync(dataFile, JSON.stringify(document));
+  const before = JSON.parse(JSON.stringify(document));
+  const service = require('../src/server').createService({ dataFile, workerIntervalMs: 0 }, { clock });
+  const saved = JSON.parse(fs.readFileSync(dataFile));
+  assert.equal(saved.version, 1);
+  assert.equal(Date.parse(saved.tickets[0].due) - Date.parse(saved.tickets[0].created), 24 * hour);
+  assert.deepEqual(saved.audit, before.audit);
+  assert.deepEqual(saved.outbox, before.outbox);
+  assert.equal(saved.tickets[0].updated, before.tickets[0].updated);
+  assert.equal(service.store.get('T-0001').due, undefined);
+  await withService({ dataFile, dueTimes: true, responseHours: { high: 1 }, clock }, async (api) => {
+    const got = (await api.get('/tickets/T-0001')).body;
+    assert.equal(got.due, saved.tickets[0].due);
+    assert.equal((await api.patch('/tickets/T-0001', { priority: 'urgent' })).body.due, got.due);
+  });
+  assert.equal(createPersistence(dataFile).load().tickets[0].due, saved.tickets[0].due);
+});
+
+test('a failed backfill write prevents store opening', () => {
+  const clock = manualClock();
+  const old = new TicketStore({ clock });
+  old.createTicket(ticketBody(), 'system');
+  const state = old.snapshot();
+  delete state.tickets[0].due;
+  assert.throws(() => TicketStore.open({ clock, dueTimes: true, persistence: {
+    load: () => state, save: () => { throw new Error('disk full'); },
+  } }), /disk full/);
+});
+
+test('overdue filter checks active status, strict boundary, combined filters and cursor pages', async () => {
+  const clock = manualClock();
+  await withService({ dueTimes: true, clock }, async (api) => {
+    for (let i = 0; i < 5; i++) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0004/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'closed' });
+    clock.advance(4 * hour);
+    assert.deepEqual((await api.get('/tickets?overdue=true')).body.items, []);
+    clock.advance(1);
+    const first = (await api.get('/tickets?overdue=true&limit=2')).body;
+    assert.deepEqual(first.items.map(t => t.id), ['T-0001', 'T-0002']);
+    assert.deepEqual((await api.get(`/tickets?overdue=true&limit=2&cursor=${encodeURIComponent(first.next)}`)).body.items.map(t => t.id), ['T-0005']);
+    assert.deepEqual((await api.get('/tickets?overdue=true&status=in_progress')).body.items.map(t => t.id), ['T-0002']);
+    assert.deepEqual((await api.get('/tickets?overdue=true&priority=low')).body.items, []);
+    assert.equal((await api.get('/tickets?overdue=bad')).status, 400);
+  });
+});
+
+test('disabled feature hides persisted due on every ticket response and ignores overdue query', async () => {
+  const clock = manualClock();
+  await withService({ clock }, async (api, service) => {
+    const ticket = (await api.post('/tickets', ticketBody())).body;
+    assert.equal('due' in ticket, false);
+    assert.ok(service.store.snapshot().tickets[0].due);
+    for (const response of [await api.get('/tickets/T-0001'), await api.patch('/tickets/T-0001', { priority: 'high' }),
+      await api.put('/tickets/T-0001/assignee', { assignee: 'Dana' }),
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' })]) {
+      assert.equal('due' in response.body, false);
+    }
+    const listed = (await api.get('/tickets?overdue=bad')).body.items;
+    assert.equal(listed.length, 1);
+    assert.equal('due' in listed[0], false);
+  });
+});
+
+test('persistence accepts optional due and rejects corrupt deadlines', () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock });
+  store.createTicket(ticketBody(), 'system');
+  const document = toDocument(store.snapshot(), clock.now());
+  const fail = message => new Error(message);
+  assert.equal(fromDocument(document, fail).tickets.length, 1);
+  document.tickets[0].due = 'bad';
+  assert.throws(() => fromDocument(document, fail), /due is not a time/);
+  delete document.tickets[0].due;
+  assert.equal(fromDocument(document, fail).tickets.length, 1);
+});
+
+
+test('CLI formats append deadlines while preserving existing raw columns', () => {
+  const { rawLine, details, table } = require('../src/format');
+  const clock = manualClock();
+  const store = new TicketStore({ clock, dueTimes: true });
+  const ticket = store.createTicket(ticketBody(), 'system');
+  assert.deepEqual(rawLine(ticket).split('\t'), [ticket.id, ticket.status, ticket.priority, ticket.title, '', ticket.due]);
+  assert.match(table([ticket]), /DUE/);
+  assert.match(details(ticket, []), new RegExp(ticket.due));
+  const hidden = { ...ticket };
+  delete hidden.due;
+  assert.equal(rawLine(hidden).split('\t').length, 5);
+  assert.doesNotMatch(table([hidden]), /DUE/);
+});
