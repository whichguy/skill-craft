+describe('the unit pieces', () => {
+  test('parseListQuery reads assignee, empty included', () => {
+    assert.deepEqual(parseListQuery(new URLSearchParams('assignee=dana')).filters, { assignee: 'dana' });
+    assert.deepEqual(parseListQuery(new URLSearchParams('assignee=')).filters, { assignee: '' });
+    assert.deepEqual(parseListQuery(new URLSearchParams('')).filters, {});
+  });
+
+  test('matchesFilters needs every filter, and treats a missing assignee as unassigned', () => {
+    const ticket = { id: 'T-0001', status: 'open', priority: 'high', assignee: 'dana' };
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'high' }), true);
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'low' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'closed', priority: 'high' }), false);
+    assert.equal(matchesFilters(ticket, { assignee: 'dana', status: 'open' }), true);
+    assert.equal(matchesFilters(ticket, { assignee: '' }), false);
+    assert.equal(matchesFilters({ ...ticket, assignee: null }, { assignee: '' }), true);
+    const bare = { id: 'T-0002', status: 'open', priority: 'high' };
+    assert.equal(matchesFilters(bare, { assignee: '' }), true);
+    assert.equal(matchesFilters(bare, { assignee: 'dana' }), false);
+  });
+
+  test('assignment checks the body', () => {
+    assert.equal(assignment({ assignee: ' dana ' }), 'dana');
+    assert.equal(assignment({ assignee: null }), null);
+    assert.throws(() => assignment({}), InvalidError);
+    assert.throws(() => assignment({ assignee: '' }), InvalidError);
+  });
+
+  test('ASSIGNEES=on is read from the environment', () => {
+    assert.equal(loadConfig({}).assignees, false);
+    assert.equal(loadConfig({ ASSIGNEES: 'on' }).assignees, true);
+    assert.equal(loadConfig({ ASSIGNEES: 'yes' }).assignees, false);
+  });
+
+  test('a ticket that is not assigned shows no assignee until ASSIGNEES is on, as before 1.6.0', async () => {
+    await withService({}, async (api) => {
+      const created = (await api.post('/tickets', ticketBody())).body;
+      assert.equal('assignee' in created, false);
+    });
+    await withService({ assignees: true }, async (api) => {
+      const created = (await api.post('/tickets', ticketBody())).body;
+      assert.equal(created.assignee, null);
+    });
+  });
+});
