+describe('the command line', () => {
+  async function dataFileWithTickets(t) {
+    const dataFile = path.join(folder(t), 'tickets.json');
+    await withService({ dataFile }, async (api) => {
+      await api.post('/tickets', ticketBody({ title: 'First' }));
+      await api.post('/tickets', ticketBody({ title: 'Second' }));
+      await assign(api, 'T-0001', 'dana');
+    });
+    return dataFile;
+  }
+
+  function run(argv) {
+    let out = '';
+    let err = '';
+    const code = main(argv, { env: {}, out: { write: (s) => (out += s) }, err: { write: (s) => (err += s) } });
+    return { code, out, err };
+  }
+
+  test('list shows each ticket\'s assignee', async (t) => {
+    const dataFile = await dataFileWithTickets(t);
+    const { code, out } = run(['--data', dataFile, 'list']);
+    assert.equal(code, 0);
+    const [header, first, second] = out.trim().split('\n');
+    assert.match(header, /ASSIGNEE/);
+    assert.match(first, /T-0001\s.*\sdana\s/);
+    assert.doesNotMatch(second, /dana/);
+    assert.match(second, /\s-\s/);
+  });
+
+  test('list --raw keeps its first four columns and adds the assignee last', async (t) => {
+    const dataFile = await dataFileWithTickets(t);
+    const { out } = run(['--data', dataFile, 'list', '--raw']);
+    assert.deepEqual(out.replace(/\n$/, '').split('\n').map((line) => line.split('\t')), [
+      ['T-0001', 'open', 'normal', 'First', 'dana'],
+      ['T-0002', 'open', 'normal', 'Second', ''],
+    ]);
+  });
+
+  test('list --assignee filters, and an empty one lists the unassigned', async (t) => {
+    const dataFile = await dataFileWithTickets(t);
+    const ofDana = run(['--data', dataFile, 'list', '--raw', '--assignee', 'dana']).out.trim().split('\n');
+    assert.deepEqual(ofDana.map((line) => line.split('\t')[0]), ['T-0001']);
+    const none = run(['--data', dataFile, 'list', '--raw', '--assignee', '']).out.trim().split('\n');
+    assert.deepEqual(none.map((line) => line.split('\t')[0]), ['T-0002']);
+  });
+
+  test('show names the assignee', async (t) => {
+    const dataFile = await dataFileWithTickets(t);
+    assert.match(run(['--data', dataFile, 'show', 'T-0001']).out, /assignee\s+dana/);
+    assert.match(run(['--data', dataFile, 'show', 'T-0002']).out, /assignee\s+-/);
+  });
+
+  test('rawLine writes an empty column for an unassigned ticket', () => {
+    assert.equal(rawLine({ id: 'T-0001', status: 'open', priority: 'low', title: 'x', assignee: null }), 'T-0001\topen\tlow\tx\t');
+  });
+});
