+describe('GET /tickets?assignee=', () => {
+  async function seed(api) {
+    for (const [priority, agent] of [['urgent', 'dana'], ['urgent', null], ['low', 'dana'], ['urgent', 'lee'], ['low', null]]) {
+      const { body } = await api.post('/tickets', ticketBody({ priority }));
+      if (agent) await assign(api, body.id, agent);
+    }
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+  }
+
+  test('keeps the tickets of one agent', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=dana')), ['T-0001', 'T-0003']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=lee')), ['T-0004']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=nobody')), []);
+    });
+  });
+
+  test('an empty assignee keeps the unassigned tickets', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=')), ['T-0002', 'T-0005']);
+      await assign(api, 'T-0002', 'dana');
+      await assign(api, 'T-0002', null);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=')), ['T-0002', 'T-0005']);
+    });
+  });
+
+  test('a ticket must match every filter given', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=dana&priority=urgent')), ['T-0001']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=dana&status=in_progress')), ['T-0003']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=&priority=low')), ['T-0005']);
+      assert.deepEqual(ids(await api.get('/tickets?status=open&priority=urgent')), ['T-0001', 'T-0002', 'T-0004']);
+      assert.deepEqual(ids(await api.get('/tickets?assignee=dana&status=open&priority=low')), []);
+    });
+  });
+
+  test('pages with the filter', async () => {
+    await withService({}, async (api) => {
+      await seed(api);
+      const first = (await api.get('/tickets?assignee=dana&limit=1')).body;
+      assert.deepEqual(first.items.map((ticket) => ticket.id), ['T-0001']);
+      const second = (await api.get(`/tickets?assignee=dana&limit=1&cursor=${first.next}`)).body;
+      assert.deepEqual(second.items.map((ticket) => ticket.id), ['T-0003']);
+      assert.equal(second.next, null);
+    });
+  });
+});
