+const { ticketBody, withService } = require('./helpers');
+
+const assign = (api, id, assignee, headers) => api.put(`/tickets/${id}/assignee`, { assignee }, headers);
+const ids = (response) => response.body.items.map((ticket) => ticket.id);
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'assign-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+describe('PUT /tickets/:id/assignee', () => {
+  test('assigns an open ticket, and the ticket shows its assignee', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const response = await assign(api, 'T-0001', 'dana');
+      assert.equal(response.status, 200);
+      assert.equal(response.body.assignee, 'dana');
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'dana');
+      assert.equal((await api.get('/tickets')).body.items[0].assignee, 'dana');
+    });
+  });
+
+  test('unassigns with null, and the ticket shows null (with ASSIGNEES on, an unassigned ticket always does)', async () => {
+    await withService({ assignees: true }, async (api) => {
+      const created = (await api.post('/tickets', ticketBody())).body;
+      assert.equal(created.assignee, null);
+      await assign(api, 'T-0001', 'dana');
+      const response = await assign(api, 'T-0001', null);
+      assert.equal(response.status, 200);
+      assert.equal(response.body.assignee, null);
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, null);
+      assert.equal((await api.get('/tickets')).body.items[0].assignee, null);
+    });
+  });
+
+  test('works on an in-progress ticket, and reassigns to another agent', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.equal((await assign(api, 'T-0001', 'dana')).body.assignee, 'dana');
+      assert.equal((await assign(api, 'T-0001', 'lee')).body.assignee, 'lee');
+    });
+  });
+
+  test('refuses a ticket that is resolved or closed (409), assigning or unassigning', async () => {
+    await withService({}, async (api) => {
