+  test('refuses an empty, too long, non-text or missing assignee, and other fields', () => {
+    for (const bad of ['', '   ', 'x'.repeat(65), 7, true, ['dana'], {}, 'da\tna']) {
+      assert.throws(() => validate.assignment(assignee(bad)), InvalidError, JSON.stringify(bad));
+    }
+    assert.throws(() => validate.assignment({}), InvalidError);
+    assert.throws(() => validate.assignment({ assignee: 'dana', agent: 'sam' }), InvalidError);
+  });
+});
