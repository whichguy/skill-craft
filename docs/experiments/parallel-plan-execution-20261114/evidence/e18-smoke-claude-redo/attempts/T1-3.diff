+describe('the command line', () => {
+  function datafile(t) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-cli-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    const file = path.join(dir, 'tickets.json');
+    const clock = manualClock(START);
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket(input({ title: 'First' }), 'dana');
+    store.createTicket(input({ title: 'Second' }), 'dana');
+    store.createTicket(input({ title: 'Third' }), 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    store.assign('T-0003', 'li', 'dana');
+    return file;
+  }
+
+  function run(argv) {
+    let out = '';
+    let err = '';
+    const code = main(argv, { env: {}, out: { write: (text) => (out += text) }, err: { write: (text) => (err += text) } });
+    return { code, out, err };
+  }
+
+  test('list shows each ticket\'s assignee', (t) => {
+    const file = datafile(t);
+    const { code, out } = run(['--data', file, 'list']);
+    assert.equal(code, 0);
+    const lines = out.trim().split('\n');
+    assert.match(lines[0], /^ID +STATUS +PRIORITY +REQUESTER +ASSIGNEE +UPDATED +TITLE$/);
+    assert.match(lines[1], /T-0001 .* sam .* First$/);
+    assert.match(lines[2], /T-0002 .* - .* Second$/);
+    assert.match(lines[3], /T-0003 .* li .* Third$/);
+  });
+
+  test('list --raw keeps its first four columns where they were and adds the assignee after them', (t) => {
+    const file = datafile(t);
+    const { out } = run(['--data', file, 'list', '--raw']);
+    assert.deepEqual(out.trim().split('\n').map((line) => line.split('\t')), [
+      ['T-0001', 'open', 'normal', 'First', 'sam'],
+      ['T-0002', 'open', 'normal', 'Second', ''],
+      ['T-0003', 'open', 'normal', 'Third', 'li'],
+    ]);
+  });
+
+  test('list filters by --assignee, an empty one for the unassigned', (t) => {
+    const file = datafile(t);
+    const only = (...args) => run(['--data', file, 'list', '--raw', ...args]).out.trim().split('\n').map((line) => line.split('\t')[0]);
+    assert.deepEqual(only('--assignee', 'sam'), ['T-0001']);
+    assert.deepEqual(only('--assignee', ''), ['T-0002']);
+    assert.deepEqual(only('--assignee', 'li', '--status', 'open'), ['T-0003']);
+    assert.deepEqual(run(['--data', file, 'list', '--assignee']).code, 2);
+  });
+
+  test('show gives the assignee', (t) => {
+    const file = datafile(t);
+    assert.match(run(['--data', file, 'show', 'T-0001']).out, /assignee +sam/);
+    assert.match(run(['--data', file, 'show', 'T-0002']).out, /assignee +-/);
+  });
+});
