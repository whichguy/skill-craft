+describe('store.assign', () => {
+  function open() {
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock });
+    store.createTicket(input(), 'dana');
+    return { clock, store };
+  }
+
+  test('a new ticket has no assignee', () => {
+    const { store } = open();
+    assert.equal(store.get('T-0001').assignee, null);
+  });
+
+  test('assigns, reassigns and unassigns, with one audit entry each', () => {
+    const { clock, store } = open();
+    clock.advance(1000);
+    const ticket = store.assign('T-0001', 'sam', 'dana');
+    assert.equal(ticket.assignee, 'sam');
+    assert.equal(ticket.updated, '2025-09-01T08:00:01.000Z');
+    store.assign('T-0001', 'li', 'dana');
+    assert.equal(store.assign('T-0001', null, 'dana').assignee, null);
+    const entries = store.history('T-0001').slice(1);
+    assert.deepEqual(entries.map((entry) => [entry.action, entry.actor, entry.changes]), [
+      ['ticket.assigned', 'dana', { assignee: { from: null, to: 'sam' } }],
+      ['ticket.assigned', 'dana', { assignee: { from: 'sam', to: 'li' } }],
+      ['ticket.assigned', 'dana', { assignee: { from: 'li', to: null } }],
+    ]);
+  });
+
+  test('works on an in-progress ticket', () => {
+    const { store } = open();
+    store.transition('T-0001', 'in_progress', 'dana');
+    assert.equal(store.assign('T-0001', 'sam', 'dana').assignee, 'sam');
+    assert.equal(store.assign('T-0001', null, 'dana').assignee, null);
+  });
+
+  test('assigning to the agent it already has changes nothing', () => {
+    const { clock, store } = open();
+    store.assign('T-0001', 'sam', 'dana');
+    const before = store.get('T-0001');
+    const audit = store.history('T-0001').length;
+    const pending = store.outboxReport().pending.length;
+    clock.advance(5000);
+    assert.deepEqual(store.assign('T-0001', 'sam', 'dana'), before);
+    assert.equal(store.history('T-0001').length, audit);
+    assert.equal(store.outboxReport().pending.length, pending);
+  });
+
+  test('unassigning a ticket nobody has changes nothing', () => {
+    const { store } = open();
+    const audit = store.history('T-0001').length;
+    assert.equal(store.assign('T-0001', null, 'dana').assignee, null);
+    assert.equal(store.history('T-0001').length, audit);
+  });
+
+  test('a resolved or closed ticket can be neither assigned nor unassigned', () => {
+    const { store } = open();
+    store.assign('T-0001', 'sam', 'dana');
+    store.transition('T-0001', 'in_progress', 'dana');
+    store.transition('T-0001', 'resolved', 'dana');
+    assert.throws(() => store.assign('T-0001', 'li', 'dana'), ConflictError);
+    assert.throws(() => store.assign('T-0001', null, 'dana'), ConflictError);
+    assert.throws(() => store.assign('T-0001', 'sam', 'dana'), ConflictError, 'not even to the agent it has');
+    store.transition('T-0001', 'closed', 'dana');
+    assert.throws(() => store.assign('T-0001', 'li', 'dana'), ConflictError);
+    assert.equal(store.get('T-0001').assignee, 'sam');
+  });
+
+  test('an unknown ticket is not found', () => {
+    const { store } = open();
+    assert.throws(() => store.assign('T-0099', 'sam', 'dana'), NotFoundError);
+  });
+
+  test('tells the agent it was assigned to them, once, and nobody on unassigning', () => {
+    const { store } = open();
+    store.assign('T-0001', 'sam', 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    store.assign('T-0001', null, 'dana');
+    const assigned = store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned');
+    assert.deepEqual(assigned.map((event) => [event.to, event.ticket]), [['sam', 'T-0001']]);
+  });
+
+  test('a ticket handed on tells the next agent too', () => {
+    const { store } = open();
+    store.assign('T-0001', 'sam', 'dana');
+    store.assign('T-0001', 'li', 'dana');
+    const assigned = store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned');
+    assert.deepEqual(assigned.map((event) => event.to), ['sam', 'li']);
+  });
+
+  test('the notification is worded for the agent', () => {
+    const { store } = open();
+    store.assign('T-0001', 'sam', 'dana');
+    const [event] = store.dueNotifications().filter((due) => due.type === 'ticket.assigned');
+    const notifier = createNotifier({ clock: manualClock(START) });
+    const line = notifier.deliver(event);
+    assert.equal(line.to, 'sam');
+    assert.equal(line.subject, '[T-0001] Assigned to you');
+    assert.match(line.body, /"Laptop will not boot" was assigned to you/);
+  });
+
+  test('a changed title or priority leaves the assignee', () => {
+    const { store } = open();
+    store.assign('T-0001', 'sam', 'dana');
+    assert.equal(store.update('T-0001', { priority: 'high' }, 'dana').assignee, 'sam');
+  });
+
+  test('list filters by assignee, and by every filter given', () => {
+    const { store } = open();
+    store.createTicket(input({ priority: 'urgent' }), 'dana');
+    store.createTicket(input({ priority: 'urgent' }), 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    store.assign('T-0002', 'sam', 'dana');
+    const listed = (filters) => store.list({ filters }).items.map((ticket) => ticket.id);
+    assert.deepEqual(listed({ assignee: 'sam' }), ['T-0001', 'T-0002']);
+    assert.deepEqual(listed({ assignee: null }), ['T-0003']);
+    assert.deepEqual(listed({ assignee: 'sam', priority: 'urgent' }), ['T-0002']);
+    assert.deepEqual(listed({ assignee: 'li' }), []);
+  });
+});
+
+describe('the data file keeps assignees', () => {
+  function tmp(t) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    return path.join(dir, 'tickets.json');
+  }
+
+  test('an assignee survives a restart, and an unassigned ticket is saved without one', (t) => {
+    const file = tmp(t);
+    const clock = manualClock(START);
+    const first = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    first.createTicket(input(), 'dana');
+    first.createTicket(input(), 'dana');
+    first.assign('T-0001', 'sam', 'dana');
+    const saved = JSON.parse(fs.readFileSync(file, 'utf8')).tickets;
+    assert.equal(saved[0].assignee, 'sam');
+    assert.equal('assignee' in saved[1], false);
+    const second = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(second.get('T-0001').assignee, 'sam');
+    assert.equal(second.get('T-0002').assignee, null);
+  });
+
+  test('a file written before assignment starts, every ticket unassigned', (t) => {
+    const file = tmp(t);
+    const clock = manualClock(START);
+    const before = new TicketStore({ clock });
+    before.createTicket(input(), 'dana');
+    const state = before.snapshot();
+    delete state.tickets[0].assignee;
+    createPersistence(file, { clock }).save(state);
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(store.get('T-0001').assignee, null);
+    assert.equal(store.assign('T-0001', 'sam', 'dana').assignee, 'sam');
+  });
+
+  test('a file whose assignee is not a name is refused', (t) => {
+    const file = tmp(t);
+    const clock = manualClock(START);
+    const store = new TicketStore({ clock });
+    store.createTicket(input(), 'dana');
+    const state = store.snapshot();
+    state.tickets[0].assignee = 42;
+    createPersistence(file, { clock }).save(state);
+    assert.throws(() => createPersistence(file, { clock }).load(), /assignee/);
+  });
+});
