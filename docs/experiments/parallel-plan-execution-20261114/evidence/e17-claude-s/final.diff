+++ b/test/import.test.js
@@ -0,0 +1,183 @@
+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { InvalidError } = require('../src/errors');
+const { TicketStore } = require('../src/store');
+const { MAX_IMPORT, importBatch } = require('../src/tickets/validate');
+const { ticketBody, withService } = require('./helpers');
+
+const item = (n, overrides = {}) => ticketBody({ title: `Imported ${n}`, requester: `user${n}@example.com`, ...overrides });
+const items = (count) => Array.from({ length: count }, (_, n) => item(n));
+const invalid = (response, index) => {
+  assert.equal(response.status, 400, JSON.stringify(response.body));
+  assert.equal(response.body.error.code, 'invalid');
+  assert.ok(response.body.error.message.includes(`tickets[${index}]`), response.body.error.message);
+};
+
+describe('importBatch', () => {
+  test('returns the checked items in order, with the defaults of a new ticket', () => {
+    const checked = importBatch({ tickets: [{ title: ' First ', requester: 'a@example.com' }, item(1, { priority: 'urgent' })] });
+    assert.deepEqual(checked, [
+      { title: 'First', requester: 'a@example.com', priority: 'normal' },
+      { title: 'Imported 1', requester: 'user1@example.com', priority: 'urgent' },
+    ]);
+  });
+
+  test('names the first invalid item by its index', () => {
+    const bad = (tickets) => assert.throws(() => importBatch({ tickets }), InvalidError);
+    const first = (tickets) => {
+      try {
+        importBatch({ tickets });
+      } catch (error) {
+        return error.message;
+      }
+      return null;
+    };
+    assert.match(first([item(0), item(1, { title: '' }), item(2, { priority: 'bogus' })]), /^tickets\[1\]/);
+    assert.match(first([{ title: 'x', requester: 'y', owner: 'z' }]), /^tickets\[0\].*owner/);
+    for (const entry of [null, 'text', 7, [], true]) bad([item(0), entry]);
+    assert.match(first([item(0), item(1), null]), /^tickets\[2\]/);
+  });
+
+  test('takes a list of at most 5000, and nothing else', () => {
+    assert.equal(importBatch({ tickets: items(MAX_IMPORT) }).length, 5000);
+    assert.throws(() => importBatch({ tickets: items(MAX_IMPORT + 1) }), /at most 5000/);
+    for (const body of [{}, { tickets: 'x' }, { tickets: {} }, { tickets: null }, { tickets: [], extra: 1 }]) {
+      assert.throws(() => importBatch(body), InvalidError, JSON.stringify(body));
+    }
+  });
+});
+
+describe('TicketStore.createMany', () => {
+  test('records each ticket and its notification as create does, with one save', () => {
+    let saves = 0;
+    const clock = manualClock('2025-09-01T08:00:00.000Z');
+    const store = new TicketStore({ clock, persistence: { save: () => { saves += 1; }, load: () => null } });
+    const tickets = store.createMany([item(0), item(1), item(2)], 'sam');
+    assert.deepEqual(tickets.map((ticket) => ticket.id), ['T-0001', 'T-0002', 'T-0003']);
+    assert.equal(saves, 1);
+    assert.deepEqual(store.history('T-0002').map((entry) => [entry.action, entry.actor]), [['ticket.created', 'sam']]);
+    assert.deepEqual(store.outboxReport().pending.map((event) => [event.type, event.to, event.ticket]), [
+      ['ticket.created', 'user0@example.com', 'T-0001'],
+      ['ticket.created', 'user1@example.com', 'T-0002'],
+      ['ticket.created', 'user2@example.com', 'T-0003'],
+    ]);
+  });
+
+  test('an empty list changes and saves nothing', () => {
+    let saves = 0;
+    const store = new TicketStore({ clock: manualClock(), persistence: { save: () => { saves += 1; }, load: () => null } });
+    assert.deepEqual(store.createMany([], 'sam'), []);
+    assert.equal(saves, 0);
+  });
+});
+
+describe('POST /tickets/import', () => {
+  test('creates the tickets in order and answers 201 with the count and the ids', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      const { status, body } = await api.post('/tickets/import', { tickets: [item(1, { priority: 'high' }), item(2), item(3)] });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 3, ids: ['T-0002', 'T-0003', 'T-0004'] });
+      const listed = (await api.get('/tickets')).body.items;
+      assert.deepEqual(listed.map((ticket) => [ticket.id, ticket.title, ticket.status, ticket.priority, ticket.assignee]), [
+        ['T-0001', 'Printer on the 4th floor jams', 'open', 'normal', null],
+        ['T-0002', 'Imported 1', 'open', 'high', null],
+        ['T-0003', 'Imported 2', 'open', 'normal', null],
+        ['T-0004', 'Imported 3', 'open', 'normal', null],
+      ]);
+    });
+  });
+
+  test('records the actor, an audit entry per ticket, and tells each requester', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets/import', { tickets: [item(1), item(2)] }, { 'X-Actor': 'migration' });
+      const history = (await api.get('/tickets/T-0002/audit')).body.items;
+      assert.equal(history.length, 1);
+      assert.equal(history[0].action, 'ticket.created');
+      assert.equal(history[0].actor, 'migration');
+      assert.deepEqual(history[0].changes.requester, { from: null, to: 'user2@example.com' });
+      const pending = (await api.get('/admin/outbox')).body.pending;
+      assert.deepEqual(pending.map((event) => [event.key, event.type, event.to]), [
+        ['ticket.created:T-0001', 'ticket.created', 'user1@example.com'],
+        ['ticket.created:T-0002', 'ticket.created', 'user2@example.com'],
+      ]);
+    });
+  });
+
+  test('an invalid item fails the whole import, names its index, and leaves nothing behind', async () => {
+    await withService({}, async (api) => {
+      const tickets = [item(0), item(1), item(2, { title: '' }), item(3, { priority: 'bogus' }), null];
+      invalid(await api.post('/tickets/import', { tickets }), 2);
+      invalid(await api.post('/tickets/import', { tickets: [null, item(1)] }), 0);
+      invalid(await api.post('/tickets/import', { tickets: [item(0), { title: 'x', requester: 'y', owner: 'z' }] }), 1);
+      assert.deepEqual((await api.get('/tickets')).body.items, []);
+      assert.deepEqual((await api.get('/admin/outbox')).body.pending, []);
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0001', 'no number was used up');
+      assert.equal((await api.get('/tickets/T-0001/audit')).body.items[0].seq, 1, 'no audit entry was written');
+    });
+  });
+
+  test('refuses a body that is not { tickets: [...] } with 400', async () => {
+    await withService({}, async (api) => {
+      for (const body of [{}, { tickets: 'x' }, { tickets: {} }, { tickets: [], extra: 1 }, [], '{"tickets":']) {
+        const response = await api.post('/tickets/import', body);
+        assert.equal(response.status, 400, JSON.stringify(body));
+        assert.equal(response.body.error.code, 'invalid');
+      }
+    });
+  });
+
+  test('takes 5000 tickets and refuses 5001', async () => {
+    await withService({}, async (api) => {
+      const refused = await api.post('/tickets/import', { tickets: items(5001) });
+      assert.equal(refused.status, 400);
+      assert.match(refused.body.error.message, /at most 5000/);
+      assert.deepEqual((await api.get('/tickets')).body.items, []);
+      const accepted = await api.post('/tickets/import', { tickets: items(5000) });
+      assert.equal(accepted.status, 201);
+      assert.equal(accepted.body.created, 5000);
+      assert.equal(accepted.body.ids[0], 'T-0001');
+      assert.equal(accepted.body.ids[4999], 'T-5000');
+    });
+  });
+
+  test('a body over MAX_BODY_BYTES is fine for an import, but still refused for one ticket', async () => {
+    await withService({ maxBodyBytes: 1024 }, async (api) => {
+      const response = await api.post('/tickets/import', { tickets: items(200) });
+      assert.equal(response.status, 201);
+      assert.equal(response.body.created, 200);
+      assert.equal((await api.post('/tickets', ticketBody({ title: 'x'.repeat(2000) }))).status, 400);
+    });
+  });
+
+  test('answers 5000 tickets within 10 seconds, with a data file too', async (t) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-import-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    const dataFile = path.join(dir, 'tickets.json');
+    await withService({ dataFile }, async (api) => {
+      const started = Date.now();
+      const { status, body } = await api.post('/tickets/import', { tickets: items(5000) });
+      assert.equal(status, 201);
+      assert.equal(body.created, 5000);
+      assert.ok(Date.now() - started < 10_000, `took ${Date.now() - started} ms`);
+    });
+    await withService({ dataFile }, async (api) => {
+      assert.equal((await api.get('/tickets/T-5000')).body.title, 'Imported 4999');
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-5001');
+    });
+  });
+
+  test('the import route does not shadow the ticket routes', async () => {
+    await withService({}, async (api) => {
+      assert.equal((await api.get('/tickets/import')).status, 404);
+      assert.equal((await api.post('/tickets', ticketBody())).status, 201);
+      assert.equal((await api.post('/tickets/T-0001/transition', { to: 'in_progress' })).status, 200);
+    });
+  });
+});
