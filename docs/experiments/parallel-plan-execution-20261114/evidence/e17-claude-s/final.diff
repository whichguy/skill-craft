@@ -0,0 +1,30 @@
+'use strict';
+
+const { PRIORITIES } = require('./priorities');
+const { isActive } = require('./states');
+
+/**
+ * Due times (docs/decisions/0009-due-times.md): the time a ticket was created plus the response time for its priority.
+ * The due time is worked out once, when the ticket is created (or, for a ticket that predates due times, when the
+ * service first starts on its data file), and stored with the ticket. Changing the hours or the ticket's priority later
+ * never moves it.
+ */
+
+/** The response time in hours for each priority, unless DUE_HOURS_<PRIORITY> says otherwise (src/config.js). */
+const DEFAULT_DUE_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+const HOUR_MS = 60 * 60 * 1000;
+
+/** The due time (ISO 8601) of a ticket created at `created` with `priority`, given the response `hours` per priority. */
+function dueFor(created, priority, hours = DEFAULT_DUE_HOURS) {
+  const hoursFor = hours[priority];
+  if (!PRIORITIES.includes(priority) || !(hoursFor > 0)) throw new RangeError(`no response time for priority ${priority}`);
+  return new Date(Date.parse(created) + hoursFor * HOUR_MS).toISOString();
+}
+
+/** Whether `ticket` is overdue at `now` (a Date): still open or in progress, with its due time passed. */
+function isOverdue(ticket, now) {
+  return isActive(ticket.status) && typeof ticket.due === 'string' && Date.parse(ticket.due) < now.getTime();
+}
+
+module.exports = { DEFAULT_DUE_HOURS, dueFor, isOverdue };
