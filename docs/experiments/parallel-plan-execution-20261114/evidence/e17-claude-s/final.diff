+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { ConflictError, InvalidError, NotFoundError } = require('../src/errors');
+const { main } = require('../bin/tickets');
+const { rawLine, table } = require('../src/format');
+const { createPersistence, fromDocument, toDocument } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { render } = require('../src/templates');
+const { matchesFilters, parseListQuery } = require('../src/tickets/query');
+const { assignment } = require('../src/tickets/validate');
+const { ticketBody, withService } = require('./helpers');
+
+const input = (overrides = {}) => ({ title: 'Laptop will not boot', requester: 'li@example.com', priority: 'normal', ...overrides });
+const newStore = () => new TicketStore({ clock: manualClock('2025-09-01T08:00:00.000Z') });
+const envelope = (response, status, code) => {
+  assert.equal(response.status, status, JSON.stringify(response.body));
+  assert.equal(response.body.error.code, code);
+};
+
+describe('assignment validation', () => {
+  test('takes an agent name or null', () => {
+    assert.equal(assignment({ assignee: 'dana' }), 'dana');
+    assert.equal(assignment({ assignee: '  dana ' }), 'dana');
+    assert.equal(assignment({ assignee: 'x'.repeat(64) }), 'x'.repeat(64));
+    assert.equal(assignment({ assignee: null }), null);
+  });
+
+  test('refuses anything else', () => {
+    for (const body of [{}, { assignee: '' }, { assignee: '   ' }, { assignee: 'x'.repeat(65) }, { assignee: 7 }, { assignee: 'a\tb' },
+      { assignee: 'dana', extra: 1 }]) {
+      assert.throws(() => assignment(body), InvalidError, JSON.stringify(body));
+    }
+  });
+});
+
+describe('TicketStore.assign', () => {
+  test('a new ticket is unassigned', () => {
+    const store = newStore();
+    assert.equal(store.create(input(), 'system').assignee, null);
+  });
+
+  test('assigns, audits and tells the agent through the outbox', () => {
+    const store = newStore();
+    store.create(input(), 'system');
+    const ticket = store.assign('T-0001', 'dana', 'sam');
+    assert.equal(ticket.assignee, 'dana');
+    assert.deepEqual(store.history('T-0001').at(-1).changes, { assignee: { from: null, to: 'dana' } });
+    assert.equal(store.history('T-0001').at(-1).actor, 'sam');
+    const event = store.outboxReport().pending.find((candidate) => candidate.type === 'ticket.assigned');
+    assert.equal(event.to, 'dana');
+    assert.equal(event.ticket, 'T-0001');
+  });
+
+  test('assigning the agent the ticket already has changes nothing', () => {
+    const store = newStore();
+    store.create(input(), 'system');
+    const first = store.assign('T-0001', 'dana', 'sam');
+    const again = store.assign('T-0001', 'dana', 'sam');
+    assert.deepEqual(again, first);
+    assert.equal(store.history('T-0001').length, 2);
+    assert.equal(store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned').length, 1);
+  });
+
+  test('unassigning an unassigned ticket changes nothing', () => {
+    const store = newStore();
+    store.create(input(), 'system');
+    store.assign('T-0001', null, 'sam');
+    assert.equal(store.history('T-0001').length, 1);
+  });
+
+  test('unassigns without notifying anyone', () => {
+    const store = newStore();
+    store.create(input(), 'system');
+    store.assign('T-0001', 'dana', 'sam');
+    const before = store.outboxReport().pending.length;
+    assert.equal(store.assign('T-0001', null, 'sam').assignee, null);
+    assert.deepEqual(store.history('T-0001').at(-1).changes, { assignee: { from: 'dana', to: null } });
+    assert.equal(store.outboxReport().pending.length, before);
+  });
+
+  test('a reassignment before delivery still tells the new agent', () => {
+    const store = newStore();
+    store.create(input(), 'system');
+    store.assign('T-0001', 'dana', 'sam');
+    store.assign('T-0001', 'lee', 'sam');
+    const told = store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned').map((event) => event.to);
+    assert.deepEqual(told, ['dana', 'lee']);
+  });
+
+  test('only open and in-progress tickets can be assigned or unassigned', () => {
+    const store = newStore();
+    store.create(input(), 'system');
+    store.assign('T-0001', 'dana', 'sam');
+    store.transition('T-0001', 'in_progress', 'sam');
+    assert.equal(store.assign('T-0001', 'lee', 'sam').assignee, 'lee');
+    store.transition('T-0001', 'resolved', 'sam');
+    assert.throws(() => store.assign('T-0001', 'dana', 'sam'), ConflictError);
+    assert.throws(() => store.assign('T-0001', null, 'sam'), ConflictError);
+    assert.throws(() => store.assign('T-0001', 'lee', 'sam'), ConflictError, 'even to the agent it has');
+    store.transition('T-0001', 'closed', 'sam');
+    assert.throws(() => store.assign('T-0001', null, 'sam'), ConflictError);
+  });
+
+  test('a ticket that does not exist is not found', () => {
+    assert.throws(() => newStore().assign('T-0009', 'dana', 'sam'), NotFoundError);
+  });
+});
