+  test('a ticket must match every filter given', () => {
+    assert.deepEqual(pick({ status: 'open', assignee: 'dana' }), ['T-0001']);
+    assert.deepEqual(pick({ status: 'open', priority: 'high', assignee: null }), []);
+    assert.deepEqual(pick({ status: 'closed', assignee: null }), ['T-0003']);
+  });
+});
+
+describe('PUT /tickets/:id/assignee', () => {
+  test('assigns, shows the assignee on the ticket and in the listing, and unassigns', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      assert.equal((await api.get('/tickets/T-0001')).body.assignee, null);
