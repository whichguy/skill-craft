+  test('the due time is set once: changing the priority leaves it', async () => {
+    await withService({ ...dueOn }, async (api) => {
+      const { due } = (await api.post('/tickets', ticketBody({ priority: 'low' }))).body;
+      assert.equal((await api.patch('/tickets/T-0001', { priority: 'urgent' })).body.due, due);
+      assert.equal((await api.get('/tickets/T-0001')).body.due, due);
+    });
+  });
+
+  test('the hours come from the settings', async () => {
+    await withService({ ...dueOn, dueHours: { urgent: 1, high: 2, normal: 3, low: 4 }, clock: manualClock(START) }, async (api) => {
+      assert.equal((await api.post('/tickets', ticketBody({ priority: 'high' }))).body.due, hoursLater(START, 2));
+    });
+  });
+
+  test('without DUE_TIMES the service answers as before: no due anywhere and overdue is ignored', async () => {
+    await withService({ clock: manualClock(START) }, async (api) => {
+      const created = await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+      const imported = await api.post('/tickets/import', { tickets: [ticketBody()] });
+      assert.deepEqual(Object.keys(created.body), ['id', 'title', 'priority', 'requester', 'status', 'assignee', 'created', 'updated']);
+      assert.equal(imported.status, 201);
+      const patched = await api.patch('/tickets/T-0001', { priority: 'low' });
+      const moved = await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      const assigned = await api.put('/tickets/T-0001/assignee', { assignee: 'dana' });
+      const listed = await api.get('/tickets?overdue=true');
+      for (const body of [created.body, patched.body, moved.body, assigned.body, ...listed.body.items]) assert.equal('due' in body, false);
+      assert.deepEqual(listed.body.items.map((ticket) => ticket.id), ['T-0001', 'T-0002'], 'overdue=true is not a filter yet');
+      assert.equal((await api.get('/tickets?overdue=soon')).status, 200);
+      const audit = (await api.get('/tickets/T-0001/audit')).body.items;
+      assert.deepEqual(Object.keys(audit[0].changes), ['title', 'priority', 'requester', 'status']);
+    });
+  });
+});
diff --git a/test/import.test.js b/test/import.test.js
