+      assert.equal(assigned.body.assignee, 'dana');
+      assert.equal((await api.get('/tickets')).body.items[0].assignee, 'dana');
+      const history = (await api.get('/tickets/T-0001/audit')).body.items;
+      assert.deepEqual(history.at(-1).changes, { assignee: { from: null, to: 'dana' } });
+      assert.equal(history.at(-1).actor, 'sam');
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: null })).body.assignee, null);
+    });
