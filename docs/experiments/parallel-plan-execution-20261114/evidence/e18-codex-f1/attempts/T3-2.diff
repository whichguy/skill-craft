+++ b/test/due.test.js
@@ -0,0 +1,173 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { createRequire } = require('node:module');
+const { manualClock } = require('../src/clock');
+const { ConfigError, loadConfig } = require('../src/config');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { ticketBody, withService } = require('./helpers');
+
+const HOUR = 3600000;
+function dataFile(t) {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return path.join(dir, 'data.json');
+}
+
+test('due hours have defaults, configurable validated values, and explicit activation', () => {
+  assert.deepEqual(loadConfig({}).dueHours, { urgent: 4, high: 24, normal: 72, low: 168 });
+  assert.equal(loadConfig({ DUE_TIMES: 'true' }).dueTimes, false);
+  assert.equal(loadConfig({ DUE_TIMES: 'on', DUE_HOURS_HIGH: '7' }).dueHours.high, 7);
+  for (const value of ['0', '-1', 'abc', '1.5', '999999999999999999']) {
+    assert.throws(() => loadConfig({ DUE_HOURS_LOW: value }), ConfigError);
+  }
+});
+
+test('every priority gets its creation-based deadline once, including changes and restarts', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(file), dueTimes: true });
+  for (const [priority, hours] of Object.entries(loadConfig({}).dueHours)) {
+    const ticket = store.createTicket(ticketBody({ priority }), 'agent');
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), hours * HOUR);
+  }
+  const due = store.get('T-0001').due;
+  clock.advance(HOUR);
+  assert.equal(store.update('T-0001', { priority: 'low' }, 'agent').due, due);
+  const again = TicketStore.open({ clock, persistence: createPersistence(file), dueTimes: true, dueHours: { urgent: 9, low: 10 } });
+  assert.equal(again.get('T-0001').due, due);
+  assert.equal(Date.parse(again.createTicket(ticketBody({ priority: 'urgent' }), 'agent').due) - clock.now().getTime(), 9 * HOUR);
+});
+
+test('legacy tickets are backfilled and saved before exposure without audit or notification side effects', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const persistence = createPersistence(file);
+  const old = TicketStore.open({ clock, persistence });
+  old.createTicket(ticketBody({ priority: 'high' }), 'agent');
+  const document = JSON.parse(fs.readFileSync(file));
+  delete document.tickets[0].due;
+  fs.writeFileSync(file, JSON.stringify(document));
+  clock.advance(100 * HOUR);
+  const migrated = TicketStore.open({ clock, persistence });
+  assert.equal(migrated.get('T-0001').due, undefined);
+  const saved = JSON.parse(fs.readFileSync(file));
+  assert.equal(Date.parse(saved.tickets[0].due) - Date.parse(saved.tickets[0].created), 24 * HOUR);
+  assert.deepEqual(saved.audit, document.audit);
+  assert.deepEqual(saved.outbox, document.outbox);
+  migrated.update('T-0001', { priority: 'urgent' }, 'agent');
+  const enabled = TicketStore.open({ clock, persistence, dueTimes: true, dueHours: { high: 2 } });
+  assert.equal(enabled.get('T-0001').due, saved.tickets[0].due);
+});
+
+test('the original 1.4.0 reader loads all tickets, audit and outbox from the new file', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(file), dueTimes: true });
+  store.createTicket(ticketBody(), 'agent');
+  store.createTicket(ticketBody({ priority: 'urgent' }), 'agent');
+  store.transition('T-0001', 'in_progress', 'agent');
+  const legacy = { exports: {} };
+  vm.runInNewContext(fs.readFileSync(path.join(__dirname, 'fixtures/persistence-1.4.0.txt'), 'utf8'), {
+    require: createRequire(require.resolve('../src/persistence')), module: legacy, process,
+  });
+  const loaded = legacy.exports.createPersistence(file).load();
+  assert.equal(loaded.tickets.length, 2);
+  assert.equal(loaded.tickets[0].status, 'in_progress');
+  assert.equal(loaded.audit.length, 3);
+  assert.equal(loaded.outbox.events.length, 2);
+});
+
+test('bad persisted due times are rejected', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  TicketStore.open({ clock, persistence: createPersistence(file) }).createTicket(ticketBody(), 'agent');
+  const document = JSON.parse(fs.readFileSync(file));
+  document.tickets[0].due = 'invalid';
+  fs.writeFileSync(file, JSON.stringify(document));
+  assert.throws(() => createPersistence(file).load(), /due is not a time/);
+});
+
+test('disabled HTTP responses and queries retain legacy behavior', async () => {
+  await withService({}, async (api) => {
+    const ticket = (await api.post('/tickets', ticketBody())).body;
+    assert.equal(Object.hasOwn(ticket, 'due'), false);
+    assert.deepEqual((await api.get(`/tickets/${ticket.id}`)).body, ticket);
+    assert.equal((await api.get('/tickets?overdue=nonsense')).body.items.length, 1);
+    assert.equal(Object.hasOwn((await api.patch(`/tickets/${ticket.id}`, { priority: 'high' })).body, 'due'), false);
+  });
+});
+
+test('overdue HTTP listings exclude future, exact-deadline, resolved and closed tickets and paginate', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true }, async (api) => {
+    for (let i = 0; i < 4; i++) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+    await api.post('/tickets', ticketBody({ priority: 'low' }));
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    for (const id of ['T-0003', 'T-0004']) {
+      await api.post(`/tickets/${id}/transition`, { to: 'in_progress' });
+      await api.post(`/tickets/${id}/transition`, { to: 'resolved' });
+    }
+    await api.post('/tickets/T-0004/transition', { to: 'closed' });
+    clock.advance(4 * HOUR);
+    assert.equal((await api.get('/tickets?overdue=true')).body.items.length, 0);
+    clock.advance(1);
+    const first = (await api.get('/tickets?overdue=true&limit=1')).body;
+    assert.deepEqual(first.items.map((x) => x.id), ['T-0001']);
+    assert.ok(first.items[0].due);
+    const next = (await api.get(`/tickets?overdue=true&limit=1&cursor=${first.next}`)).body;
+    assert.deepEqual(next.items.map((x) => x.id), ['T-0002']);
+    assert.equal(next.next, null);
+    assert.equal((await api.get('/tickets?overdue=true&priority=low')).body.items.length, 0);
+    assert.equal((await api.get('/tickets?overdue=false')).body.items.length, 5);
+    assert.equal((await api.get('/tickets?overdue=perhaps')).status, 400);
+  });
+});
+
+test('CLI exposes due only when enabled and preserves raw report columns', (t) => {
+  const { main } = require('../bin/tickets');
+  const file = dataFile(t);
+  const clock = manualClock();
+  TicketStore.open({ clock, persistence: createPersistence(file) }).createTicket(ticketBody(), 'agent');
+  const before = fs.readFileSync(file, 'utf8');
+  function run(args, env) {
+    let output = '';
+    const sink = { write: (text) => { output += text; } };
+    assert.equal(main(['--data', file, ...args], { env, out: sink, err: sink }), 0);
+    return output;
+  }
+  const original = run(['list', '--raw'], {});
+  const enabled = run(['list', '--raw'], { DUE_TIMES: 'on' });
+  assert.equal(original.trimEnd().split('\t').length, 4);
+  assert.equal(enabled.trimEnd().split('\t').length, 6);
+  assert.equal(enabled.trimEnd().split('\t')[4], '');
+  assert.equal(enabled.trimEnd().split('\t').slice(0, 4).join('\t'), original.trimEnd());
+  assert.match(run(['show', 'T-0001'], { DUE_TIMES: 'on' }), /due\s+2025-/);
+  assert.doesNotMatch(run(['show', 'T-0001'], {}), /due/);
+  assert.equal(fs.readFileSync(file, 'utf8'), before);
+});
+
+test('atomic imports use configured due hours and preserve existing deadlines and assignees', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true, dueHours: { urgent: 2 } }, async (api, service) => {
+    const original = (await api.post('/tickets', ticketBody({ priority: 'urgent' }))).body;
+    await api.put(`/tickets/${original.id}/assignee`, { assignee: 'Dana' });
+    clock.advance(HOUR);
+    const imported = await api.post('/tickets/import', { tickets: [ticketBody({ priority: 'urgent' })] });
+    assert.equal(imported.status, 201);
+    const ticket = (await api.get(`/tickets/${imported.body.ids[0]}`)).body;
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), 2 * HOUR);
+    assert.equal(ticket.assignee, null);
+    assert.equal(service.store.get(original.id).due, original.due);
+    assert.equal(service.store.get(original.id).assignee, 'Dana');
+    clock.advance(HOUR + 1);
+    const assigned = await api.get('/tickets?overdue=true&assignee=Dana&priority=urgent&status=open');
+    assert.deepEqual(assigned.body.items.map(t => t.id), [original.id]);
+    assert.deepEqual((await api.get('/tickets?overdue=true&assignee=')).body.items, []);
+  });
+});
