+++ b/test/due.test.js
@@ -0,0 +1,173 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+const { createRequire } = require('node:module');
+const { manualClock } = require('../src/clock');
+const { ConfigError, loadConfig } = require('../src/config');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { ticketBody, withService } = require('./helpers');
+
+const HOUR = 3600000;
+function dataFile(t) {
+  const dir = fs.mkdtempSync(path.join(__dirname, '.due-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return path.join(dir, 'data.json');
+}
+
+test('due hours have defaults, configurable validated values, and explicit activation', () => {
+  assert.deepEqual(loadConfig({}).dueHours, { urgent: 4, high: 24, normal: 72, low: 168 });
+  assert.equal(loadConfig({ DUE_TIMES: 'true' }).dueTimes, false);
+  assert.equal(loadConfig({ DUE_TIMES: 'on', DUE_HOURS_HIGH: '7' }).dueHours.high, 7);
+  for (const value of ['0', '-1', 'abc', '1.5', '999999999999999999']) {
+    assert.throws(() => loadConfig({ DUE_HOURS_LOW: value }), ConfigError);
+  }
+});
+
+test('every priority gets its creation-based deadline once, including changes and restarts', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(file), dueTimes: true });
+  for (const [priority, hours] of Object.entries(loadConfig({}).dueHours)) {
+    const ticket = store.createTicket(ticketBody({ priority }), 'agent');
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), hours * HOUR);
+  }
+  const due = store.get('T-0001').due;
+  clock.advance(HOUR);
+  assert.equal(store.update('T-0001', { priority: 'low' }, 'agent').due, due);
+  const again = TicketStore.open({ clock, persistence: createPersistence(file), dueTimes: true, dueHours: { urgent: 9, low: 10 } });
+  assert.equal(again.get('T-0001').due, due);
+  assert.equal(Date.parse(again.createTicket(ticketBody({ priority: 'urgent' }), 'agent').due) - clock.now().getTime(), 9 * HOUR);
+});
+
+test('legacy tickets are backfilled and saved before exposure without audit or notification side effects', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const persistence = createPersistence(file);
+  const old = TicketStore.open({ clock, persistence });
+  old.createTicket(ticketBody({ priority: 'high' }), 'agent');
+  const document = JSON.parse(fs.readFileSync(file));
+  delete document.tickets[0].due;
+  fs.writeFileSync(file, JSON.stringify(document));
+  clock.advance(100 * HOUR);
+  const migrated = TicketStore.open({ clock, persistence });
+  assert.equal(migrated.get('T-0001').due, undefined);
+  const saved = JSON.parse(fs.readFileSync(file));
+  assert.equal(Date.parse(saved.tickets[0].due) - Date.parse(saved.tickets[0].created), 24 * HOUR);
+  assert.deepEqual(saved.audit, document.audit);
+  assert.deepEqual(saved.outbox, document.outbox);
+  migrated.update('T-0001', { priority: 'urgent' }, 'agent');
+  const enabled = TicketStore.open({ clock, persistence, dueTimes: true, dueHours: { high: 2 } });
+  assert.equal(enabled.get('T-0001').due, saved.tickets[0].due);
+});
+
+test('the original 1.4.0 reader loads all tickets, audit and outbox from the new file', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const store = TicketStore.open({ clock, persistence: createPersistence(file), dueTimes: true });
+  store.createTicket(ticketBody(), 'agent');
+  store.createTicket(ticketBody({ priority: 'urgent' }), 'agent');
+  store.transition('T-0001', 'in_progress', 'agent');
+  const legacy = { exports: {} };
+  vm.runInNewContext(fs.readFileSync(path.join(__dirname, 'fixtures/persistence-1.4.0.txt'), 'utf8'), {
+    require: createRequire(require.resolve('../src/persistence')), module: legacy, process,
+  });
+  const loaded = legacy.exports.createPersistence(file).load();
+  assert.equal(loaded.tickets.length, 2);
+  assert.equal(loaded.tickets[0].status, 'in_progress');
+  assert.equal(loaded.audit.length, 3);
+  assert.equal(loaded.outbox.events.length, 2);
+});
+
+test('bad persisted due times are rejected', (t) => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  TicketStore.open({ clock, persistence: createPersistence(file) }).createTicket(ticketBody(), 'agent');
+  const document = JSON.parse(fs.readFileSync(file));
+  document.tickets[0].due = 'invalid';
+  fs.writeFileSync(file, JSON.stringify(document));
+  assert.throws(() => createPersistence(file).load(), /due is not a time/);
+});
+
+test('disabled HTTP responses and queries retain legacy behavior', async () => {
+  await withService({}, async (api) => {
+    const ticket = (await api.post('/tickets', ticketBody())).body;
+    assert.equal(Object.hasOwn(ticket, 'due'), false);
+    assert.deepEqual((await api.get(`/tickets/${ticket.id}`)).body, ticket);
+    assert.equal((await api.get('/tickets?overdue=nonsense')).body.items.length, 1);
+    assert.equal(Object.hasOwn((await api.patch(`/tickets/${ticket.id}`, { priority: 'high' })).body, 'due'), false);
+  });
+});
+
+test('overdue HTTP listings exclude future, exact-deadline, resolved and closed tickets and paginate', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true }, async (api) => {
+    for (let i = 0; i < 4; i++) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+    await api.post('/tickets', ticketBody({ priority: 'low' }));
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    for (const id of ['T-0003', 'T-0004']) {
+      await api.post(`/tickets/${id}/transition`, { to: 'in_progress' });
+      await api.post(`/tickets/${id}/transition`, { to: 'resolved' });
+    }
+    await api.post('/tickets/T-0004/transition', { to: 'closed' });
+    clock.advance(4 * HOUR);
+    assert.equal((await api.get('/tickets?overdue=true')).body.items.length, 0);
+    clock.advance(1);
+    const first = (await api.get('/tickets?overdue=true&limit=1')).body;
+    assert.deepEqual(first.items.map((x) => x.id), ['T-0001']);
+    assert.ok(first.items[0].due);
+    const next = (await api.get(`/tickets?overdue=true&limit=1&cursor=${first.next}`)).body;
+    assert.deepEqual(next.items.map((x) => x.id), ['T-0002']);
+    assert.equal(next.next, null);
+    assert.equal((await api.get('/tickets?overdue=true&priority=low')).body.items.length, 0);
+    assert.equal((await api.get('/tickets?overdue=false')).body.items.length, 5);
+    assert.equal((await api.get('/tickets?overdue=perhaps')).status, 400);
+  });
+});
+
+test('CLI exposes due only when enabled and preserves raw report columns', (t) => {
+  const { main } = require('../bin/tickets');
+  const file = dataFile(t);
+  const clock = manualClock();
+  TicketStore.open({ clock, persistence: createPersistence(file) }).createTicket(ticketBody(), 'agent');
+  const before = fs.readFileSync(file, 'utf8');
+  function run(args, env) {
+    let output = '';
+    const sink = { write: (text) => { output += text; } };
+    assert.equal(main(['--data', file, ...args], { env, out: sink, err: sink }), 0);
+    return output;
+  }
+  const original = run(['list', '--raw'], {});
+  const enabled = run(['list', '--raw'], { DUE_TIMES: 'on' });
+  assert.equal(original.trimEnd().split('\t').length, 4);
+  assert.equal(enabled.trimEnd().split('\t').length, 6);
+  assert.equal(enabled.trimEnd().split('\t')[4], '');
+  assert.equal(enabled.trimEnd().split('\t').slice(0, 4).join('\t'), original.trimEnd());
+  assert.match(run(['show', 'T-0001'], { DUE_TIMES: 'on' }), /due\s+2025-/);
+  assert.doesNotMatch(run(['show', 'T-0001'], {}), /due/);
+  assert.equal(fs.readFileSync(file, 'utf8'), before);
+});
+
+test('atomic imports use configured due hours and preserve existing deadlines and assignees', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true, dueHours: { urgent: 2 } }, async (api, service) => {
+    const original = (await api.post('/tickets', ticketBody({ priority: 'urgent' }))).body;
+    await api.put(`/tickets/${original.id}/assignee`, { assignee: 'Dana' });
+    clock.advance(HOUR);
+    const imported = await api.post('/tickets/import', { tickets: [ticketBody({ priority: 'urgent' })] });
+    assert.equal(imported.status, 201);
+    const ticket = (await api.get(`/tickets/${imported.body.ids[0]}`)).body;
+    assert.equal(Date.parse(ticket.due) - Date.parse(ticket.created), 2 * HOUR);
+    assert.equal(ticket.assignee, null);
+    assert.equal(service.store.get(original.id).due, original.due);
+    assert.equal(service.store.get(original.id).assignee, 'Dana');
+    clock.advance(HOUR + 1);
+    const assigned = await api.get('/tickets?overdue=true&assignee=Dana&priority=urgent&status=open');
+    assert.deepEqual(assigned.body.items.map(t => t.id), [original.id]);
+    assert.deepEqual((await api.get('/tickets?overdue=true&assignee=')).body.items, []);
+  });
+});
diff --git a/test/fixtures/persistence-1.4.0.txt b/test/fixtures/persistence-1.4.0.txt
new file mode 100644
index 0000000..35aed13
--- /dev/null
+++ b/test/fixtures/persistence-1.4.0.txt
@@ -0,0 +1,206 @@
+'use strict';
+
+const fs = require('node:fs');
+const path = require('node:path');
+const { STATES } = require('./outbox');
+const { parseId } = require('./tickets/ids');
+const { isPriority } = require('./tickets/priorities');
+const { isStatus } = require('./tickets/states');
+
+/**
+ * The data file (docs/decisions/0008-json-data-file.md): the store's whole state as one JSON document,
+ *
+ *   { "version": 1, "savedAt": "...", "nextNumber": 8, "tickets": [...], "audit": [...],
+ *     "outbox": { "nextId": 5, "events": [...] } }
+ *
+ * written after every change to a temporary file that then replaces the old one, so a crash leaves the old state or the
+ * new one, never a mix of the two.
+ *
+ * Saving and loading go through the record functions below, which name every field the file keeps. Loading checks each
+ * record, so a file edited by hand cannot put the service into a state it could not reach by itself; a file that fails
+ * a check is refused with the reason, and the service does not start.
+ */
+
+const VERSION = 1;
+
+class DataFileError extends Error {
+  constructor(file, message) {
+    super(`${file}: ${message}`);
+    this.name = 'DataFileError';
+  }
+}
+
+/** Load and save the state in `file`. */
+function createPersistence(file, { clock = { now: () => new Date() } } = {}) {
+  return {
+    file,
+
+    /** The saved state, or null when the file does not exist yet (the first start). */
+    load() {
+      let text;
+      try {
+        text = fs.readFileSync(file, 'utf8');
+      } catch (error) {
+        if (error.code === 'ENOENT') return null;
+        throw new DataFileError(file, `cannot be read: ${error.message}`);
+      }
+      let document;
+      try {
+        document = JSON.parse(text);
+      } catch {
+        throw new DataFileError(file, 'is not JSON');
+      }
+      return fromDocument(document, (message) => new DataFileError(file, message));
+    },
+
+    save(state) {
+      const document = toDocument(state, clock.now());
+      fs.mkdirSync(path.dirname(path.resolve(file)), { recursive: true });
+      const temporary = `${file}.${process.pid}.tmp`;
+      fs.writeFileSync(temporary, `${JSON.stringify(document, null, 2)}\n`);
+      fs.renameSync(temporary, file);
+    },
+  };
+}
+
+function toDocument(state, now) {
+  return {
+    version: VERSION,
+    savedAt: now.toISOString(),
+    nextNumber: state.nextNumber,
+    tickets: state.tickets.map(ticketRecord),
+    audit: state.audit.map(auditRecord),
+    outbox: { nextId: state.outbox.nextId, events: state.outbox.events.map(eventRecord) },
+  };
+}
+
+function fromDocument(document, fail) {
+  if (!isObject(document)) throw fail('is not a data file');
+  if (document.version !== VERSION) throw fail(`has version ${document.version}; this service reads version ${VERSION}`);
+  const nextNumber = positive(document.nextNumber, 'nextNumber', fail);
+  const tickets = array(document.tickets, 'tickets', fail).map((record, index) => readTicket(record, `tickets[${index}]`, fail));
+  const ids = new Set();
+  for (const ticket of tickets) {
+    if (ids.has(ticket.id)) throw fail(`ticket ${ticket.id} appears twice`);
+    ids.add(ticket.id);
+    if (parseId(ticket.id) >= nextNumber) throw fail(`nextNumber ${nextNumber} would reuse the number of ${ticket.id}`);
+  }
+  const audit = array(document.audit, 'audit', fail).map((record, index) => readAudit(record, index, fail));
+  const outbox = object(document.outbox, 'outbox', fail);
+  const events = array(outbox.events, 'outbox.events', fail).map((record, index) => readEvent(record, `outbox.events[${index}]`, fail));
+  const nextId = positive(outbox.nextId, 'outbox.nextId', fail);
+  if (events.some((event) => event.id >= nextId)) throw fail(`outbox.nextId ${nextId} would reuse an event id`);
+  return { nextNumber, tickets, audit, outbox: { nextId, events } };
+}
+
+// Records: the fields the file keeps, one function per kind, used to save and to load.
+
+function ticketRecord(ticket) {
+  return {
+    id: ticket.id,
+    title: ticket.title,
+    priority: ticket.priority,
+    requester: ticket.requester,
+    status: ticket.status,
+    created: ticket.created,
+    updated: ticket.updated,
+  };
+}
+
+function auditRecord(entry) {
+  return {
+    seq: entry.seq,
+    ticket: entry.ticket,
+    action: entry.action,
+    actor: entry.actor,
+    at: entry.at,
+    changes: entry.changes,
+  };
+}
+
+function eventRecord(event) {
+  return {
+    id: event.id,
+    key: event.key,
+    type: event.type,
+    to: event.to,
+    ticket: event.ticket,
+    data: event.data,
+    status: event.status,
+    attempts: event.attempts,
+    created: event.created,
+    nextAttemptAt: event.nextAttemptAt,
+    lastError: event.lastError,
+    sentAt: event.sentAt,
+  };
+}
+
+function readTicket(record, where, fail) {
+  const ticket = ticketRecord(object(record, where, fail));
+  if (parseId(ticket.id) === null) throw fail(`${where}.id is not a ticket id`);
+  text(ticket.title, `${where}.title`, fail);
+  text(ticket.requester, `${where}.requester`, fail);
+  if (!isPriority(ticket.priority)) throw fail(`${where}.priority is not a priority`);
+  if (!isStatus(ticket.status)) throw fail(`${where}.status is not a status`);
+  time(ticket.created, `${where}.created`, fail);
+  time(ticket.updated, `${where}.updated`, fail);
+  return ticket;
+}
+
+function readAudit(record, index, fail) {
+  const where = `audit[${index}]`;
+  const entry = auditRecord(object(record, where, fail));
+  if (entry.seq !== index + 1) throw fail(`${where}.seq is ${entry.seq}, not ${index + 1}: the log is append-only`);
+  for (const field of ['ticket', 'action', 'actor']) text(entry[field], `${where}.${field}`, fail);
+  time(entry.at, `${where}.at`, fail);
+  if (!isObject(entry.changes)) throw fail(`${where}.changes is not an object`);
+  for (const [field, change] of Object.entries(entry.changes)) {
+    if (!isObject(change) || !('from' in change) || !('to' in change)) throw fail(`${where}.changes.${field} needs from and to`);
+  }
+  return entry;
+}
+
+function readEvent(record, where, fail) {
+  const event = eventRecord(object(record, where, fail));
+  positive(event.id, `${where}.id`, fail);
+  for (const field of ['key', 'type', 'to']) text(event[field], `${where}.${field}`, fail);
+  if (!STATES.includes(event.status)) throw fail(`${where}.status is not one of ${STATES.join(', ')}`);
+  if (!Number.isInteger(event.attempts) || event.attempts < 0) throw fail(`${where}.attempts is not a count`);
+  if (!isObject(event.data)) throw fail(`${where}.data is not an object`);
+  time(event.created, `${where}.created`, fail);
+  if (event.status === 'pending') time(event.nextAttemptAt, `${where}.nextAttemptAt`, fail);
+  return event;
+}
+
+// Checks
+
+function isObject(value) {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+function object(value, where, fail) {
+  if (!isObject(value)) throw fail(`${where} is not an object`);
+  return value;
+}
+
+function array(value, where, fail) {
+  if (!Array.isArray(value)) throw fail(`${where} is not a list`);
+  return value;
+}
+
+function positive(value, where, fail) {
+  if (!Number.isSafeInteger(value) || value < 1) throw fail(`${where} is not a positive whole number`);
+  return value;
+}
+
+function text(value, where, fail) {
+  if (typeof value !== 'string' || value === '') throw fail(`${where} is not a non-empty string`);
+  return value;
+}
+
+function time(value, where, fail) {
+  if (typeof value !== 'string' || Number.isNaN(Date.parse(value))) throw fail(`${where} is not a time`);
+  return value;
+}
+
+module.exports = { DataFileError, VERSION, createPersistence, fromDocument, toDocument };
diff --git a/test/import.test.js b/test/import.test.js
new file mode 100644
index 0000000..3cd4790
--- /dev/null
+++ b/test/import.test.js
@@ -0,0 +1,112 @@
+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { performance } = require('node:perf_hooks');
+const { TicketStore } = require('../src/store');
+const { manualClock } = require('../src/clock');
+const { ticketBody, withService } = require('./helpers');
+
+test('import creates ordered tickets with ordinary defaults, audit entries and delivered notifications', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const response = await api.post('/tickets/import', { tickets: [
+      { title: ' First ', requester: ' alice ' }, ticketBody({ title: 'Second', priority: 'urgent' }),
+    ] }, { 'X-Actor': 'migration' });
+    assert.equal(response.status, 201);
+    assert.deepEqual(response.body, { created: 2, ids: ['T-0002', 'T-0003'] });
+    assert.equal(service.store.get('T-0002').title, 'First');
+    assert.equal(service.store.get('T-0002').priority, 'normal');
+    assert.equal(service.store.get('T-0003').priority, 'urgent');
+    for (const id of response.body.ids) {
+      const [entry] = service.store.history(id);
+      assert.equal(entry.action, 'ticket.created');
+      assert.equal(entry.actor, 'migration');
+      assert.deepEqual(entry.changes.status, { from: null, to: 'open' });
+    }
+    assert.deepEqual(service.store.outboxReport().pending.map((event) => event.to), [
+      'maria@example.com', 'alice', 'maria@example.com',
+    ]);
+    assert.equal(service.worker.tick()[0].sent, 3);
+    assert.equal(service.store.outboxReport().sent.length, 3);
+  });
+});
+
+test('invalid items name the first invalid index and leave every part of the state unchanged', async () => {
+  await withService({}, async (api, service) => {
+    await api.post('/tickets', ticketBody());
+    const before = service.store.snapshot();
+    for (const invalid of [null, [], 42, 'bad', {}, ticketBody({ title: '' }),
+      ticketBody({ requester: 'a\nb' }), ticketBody({ priority: 'critical' }), ticketBody({ owner: 'sam' })]) {
+      const result = await api.post('/tickets/import', { tickets: [ticketBody(), invalid, null] });
+      assert.equal(result.status, 400);
+      assert.equal(result.body.error.code, 'invalid');
+      assert.match(result.body.error.message, /tickets\[1\]/);
+      assert.deepEqual(service.store.snapshot(), before);
+    }
+    const first = await api.post('/tickets/import', { tickets: [null, null] });
+    assert.match(first.body.error.message, /tickets\[0\]/);
+    assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0002');
+  });
+});
+
+test('import rejects malformed envelopes, oversized batches and invalid actors without creating tickets', async () => {
+  await withService({}, async (api, service) => {
+    for (const body of [{}, { tickets: null }, { tickets: {} }, { tickets: [], extra: true },
+      { tickets: Array(5001).fill(ticketBody()) }, '{"tickets":', []]) {
+      assert.equal((await api.post('/tickets/import', body)).status, 400);
+    }
+    assert.equal((await api.post('/tickets/import', { tickets: [ticketBody()] }, { 'X-Actor': 'x'.repeat(65) })).status, 400);
+    assert.equal(service.store.snapshot().tickets.length, 0);
+  });
+});
+
+test('an empty import succeeds without changes', async () => {
+  await withService({}, async (api, service) => {
+    const before = service.store.snapshot();
+    const result = await api.post('/tickets/import', { tickets: [] });
+    assert.equal(result.status, 201);
+    assert.deepEqual(result.body, { created: 0, ids: [] });
+    assert.deepEqual(service.store.snapshot(), before);
+  });
+});
+
+test('a persistent 5000-ticket import responds within ten seconds and survives reload', async () => {
+  const directory = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-import-'));
+  const dataFile = path.join(directory, 'tickets.json');
+  try {
+    await withService({ dataFile }, async (api, service) => {
+      const tickets = Array.from({ length: 5000 }, (_, index) => ticketBody({ title: `Legacy ticket ${index}` }));
+      const started = performance.now();
+      const result = await api.post('/tickets/import', { tickets });
+      assert.equal(result.status, 201);
+      assert.ok(performance.now() - started < 10000);
+      assert.equal(result.body.created, 5000);
+      assert.deepEqual(result.body.ids, Array.from({ length: 5000 }, (_, index) => `T-${String(index + 1).padStart(4, '0')}`));
+      const loaded = TicketStore.open({ clock: manualClock(), persistence: service.store.persistence });
+      assert.deepEqual(loaded.snapshot(), service.store.snapshot());
+      assert.equal(loaded.history('T-5000')[0].actor, 'system');
+      assert.equal(loaded.outboxReport().pending.length, 5000);
+    });
+  } finally {
+    fs.rmSync(directory, { recursive: true, force: true });
+  }
+});
+
+test('batch persistence happens once and a save failure leaves live state unchanged', () => {
+  let saves = 0;
+  let fail = false;
+  const store = new TicketStore({ clock: manualClock(), persistence: { save() {
+    saves += 1;
+    if (fail) throw new Error('disk full');
+  } } });
+  store.importTickets([ticketBody(), ticketBody()], 'migration');
+  assert.equal(saves, 1);
+  const before = store.snapshot();
+  fail = true;
+  assert.throws(() => store.importTickets([ticketBody()], 'migration'), /disk full/);
+  assert.deepEqual(store.snapshot(), before);
+});
