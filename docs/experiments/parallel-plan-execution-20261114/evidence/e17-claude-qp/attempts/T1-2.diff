+describe('the assignee filter', () => {
+  test('parses a name, and an empty value as unassigned', () => {
+    assert.deepEqual(parseListQuery(new URLSearchParams('assignee=sam')).filters, { assignee: 'sam' });
+    assert.deepEqual(parseListQuery(new URLSearchParams('assignee=')).filters, { assignee: null });
+  });
+
+  test('matchesFilters keeps an agent\'s tickets, or the unassigned ones', () => {
+    assert.equal(matchesFilters({ assignee: 'sam' }, { assignee: 'sam' }), true);
+    assert.equal(matchesFilters({ assignee: 'kim' }, { assignee: 'sam' }), false);
+    assert.equal(matchesFilters({ assignee: null }, { assignee: 'sam' }), false);
+    assert.equal(matchesFilters({ assignee: null }, { assignee: null }), true);
+    assert.equal(matchesFilters({ assignee: 'sam' }, { assignee: null }), false);
+  });
+
+  test('a ticket must match every filter given', () => {
+    const ticket = { status: 'open', priority: 'high', assignee: 'sam' };
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'high' }), true);
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'low' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'closed', priority: 'high' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'open', assignee: 'kim' }), false);
+    assert.equal(matchesFilters(ticket, { status: 'open', priority: 'high', assignee: 'sam' }), true);
+  });
+});
