+    assert.deepEqual(rawLine(ticket).split('\t'), ['T-0001', 'open', 'low', 'Hello', 'sam']);
+    assert.deepEqual(rawLine({ ...ticket, assignee: null }).split('\t'), ['T-0001', 'open', 'low', 'Hello', '']);
+  });
+
+  test('tickets list prints assignees and filters with --assignee', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket(input({ title: 'First' }), 'dana');
+    store.createTicket(input({ title: 'Second' }), 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    const run = (...argv) => {
+      let out = '';
+      let err = '';
+      const code = main(['--data', file, ...argv], { env: {}, out: { write: (s) => { out += s; } }, err: { write: (s) => { err += s; } } });
+      return { code, out, err };
+    };
+    const all = run('list');
