+
+  test('answers 400 for a bad body, 404 for an unknown ticket and 409 for a ticket that is not active', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody());
+      envelope(await api.put('/tickets/T-0001/assignee', {}), 400, 'invalid');
+      envelope(await api.put('/tickets/T-0001/assignee', { assignee: '' }), 400, 'invalid');
+      envelope(await api.put('/tickets/T-0001/assignee', { assignee: 'x'.repeat(65) }), 400, 'invalid');
+      envelope(await api.put('/tickets/T-0001/assignee', { assignee: 5 }), 400, 'invalid');
+      envelope(await api.put('/tickets/T-0001/assignee', { assignee: 'sam', extra: 1 }), 400, 'invalid');
+      envelope(await api.put('/tickets/T-0001/assignee', []), 400, 'invalid');
+      envelope(await api.put('/tickets/T-0099/assignee', { assignee: 'sam' }), 404, 'not_found');
+      await api.post('/tickets/T-0001/transition', { to: 'in_progress' });
+      assert.equal((await api.put('/tickets/T-0001/assignee', { assignee: 'sam' })).status, 200);
+      await api.post('/tickets/T-0001/transition', { to: 'resolved' });
