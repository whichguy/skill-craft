+describe('the data file and the command line', () => {
+  function folder(t) {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assign-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    return dir;
+  }
+
+  test('assignees survive a save and a load', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket(input(), 'dana');
+    store.createTicket(input(), 'dana');
+    store.assign('T-0001', 'sam', 'dana');
+    const reopened = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    assert.equal(reopened.get('T-0001').assignee, 'sam');
+    assert.equal(reopened.get('T-0002').assignee, null);
+  });
+
+  test('a data file from before assignment loads, its tickets unassigned; a bad assignee is refused', (t) => {
+    const file = path.join(folder(t), 'tickets.json');
+    const clock = manualClock();
+    const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }) });
+    store.createTicket(input(), 'dana');
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    delete document.tickets[0].assignee;
+    fs.writeFileSync(file, JSON.stringify(document));
+    assert.equal(createPersistence(file).load().tickets[0].assignee, null);
+    document.tickets[0].assignee = '';
+    fs.writeFileSync(file, JSON.stringify(document));
+    assert.throws(() => createPersistence(file).load(), DataFileError);
+    document.tickets[0].assignee = 5;
+    fs.writeFileSync(file, JSON.stringify(document));
+    assert.throws(() => createPersistence(file).load(), DataFileError);
+  });
+
+  test('the listing shows each ticket\'s assignee: a table column and a last raw column', () => {
+    const ticket = { id: 'T-0001', status: 'open', priority: 'low', requester: 'r', title: 'Hello', assignee: 'sam', updated: '2025-09-01T08:00:00.000Z' };
+    const lines = table([ticket, { ...ticket, id: 'T-0002', assignee: null }]).split('\n');
+    assert.match(lines[0], /ASSIGNEE/);
+    assert.match(lines[1], /\bsam\b/);
