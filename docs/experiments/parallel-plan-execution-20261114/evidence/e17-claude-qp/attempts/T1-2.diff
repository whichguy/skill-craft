+    assert.equal(ticket.assignee, 'sam');
+    assert.equal(store.get('T-0001').assignee, 'sam');
+    const entry = store.history('T-0001').at(-1);
+    assert.equal(entry.action, 'ticket.assigned');
+    assert.equal(entry.actor, 'dana');
+    assert.deepEqual(entry.changes, { assignee: { from: null, to: 'sam' } });
+    const events = store.outboxReport().pending.filter((event) => event.type === 'ticket.assigned');
+    assert.equal(events.length, 1);
+    assert.equal(events[0].to, 'sam');
+    assert.equal(events[0].ticket, 'T-0001');
