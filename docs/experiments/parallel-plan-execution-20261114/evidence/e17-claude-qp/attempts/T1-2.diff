+    assert.equal(assignment({ assignee: 'dana' }), 'dana');
+    assert.equal(assignment({ assignee: null }), null);
+    assert.equal(assignment({ assignee: 'x'.repeat(64) }), 'x'.repeat(64));
+  });
+
