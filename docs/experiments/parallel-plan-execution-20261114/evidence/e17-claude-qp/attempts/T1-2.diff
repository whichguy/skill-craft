+    for (const body of [{}, { assignee: '' }, { assignee: '  ' }, { assignee: 'x'.repeat(65) }, { assignee: 'a\tb' }, { assignee: 7 }, { assignee: ['dana'] }, { assignee: 'dana', note: 'x' }]) {
+      assert.throws(() => assignment(body), InvalidError, JSON.stringify(body));
+    }
