diff --git a/test/rollback.test.js b/test/rollback.test.js
new file mode 100644
index 0000000..2ea38f0
--- /dev/null
+++ b/test/rollback.test.js
@@ -0,0 +1,68 @@
+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { DEFAULT_DUE_HOURS } = require('../src/config');
+const { createPersistence, VERSION } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const release140 = require('./fixtures/persistence-1.4.0');
+
+/**
+ * Going back to release 1.4.0 must work on the data file this release wrote (CHANGELOG.md, 1.5.0). The 1.4.0 reader is
+ * kept in test/fixtures/persistence-1.4.0.js.
+ */
+
+function written(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-rollback-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const file = path.join(dir, 'tickets.json');
+  const clock = manualClock('2025-09-01T08:00:00.000Z');
+  const store = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueHours: DEFAULT_DUE_HOURS, dueTimes: true });
+  store.createTicket({ title: 'VPN drops', requester: 'maria@example.com', priority: 'urgent' }, 'dana');
+  store.createTicket({ title: 'Printer jams', requester: 'li@example.com', priority: 'low' }, 'dana');
+  store.transition('T-0001', 'in_progress', 'sam');
+  return { file, clock, store };
+}
+
+describe('release 1.4.0 on a data file this release wrote', () => {
+  test('the file keeps format version 1, and its due times are in it', (t) => {
+    const { file } = written(t);
+    const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+    assert.equal(VERSION, 1);
+    assert.equal(document.version, 1);
+    assert.deepEqual(document.tickets.map((ticket) => ticket.due), ['2025-09-01T12:00:00.000Z', '2025-09-08T08:00:00.000Z']);
+  });
+
+  test('starts on it and shows every ticket', (t) => {
+    const { file, store } = written(t);
+    const state = release140.createPersistence(file).load();
+    const old = new TicketStore({ clock: manualClock(), state });
+    assert.deepEqual(old.list().items.map((ticket) => ticket.id), ['T-0001', 'T-0002']);
+    for (const ticket of old.list().items) {
+      const current = store.get(ticket.id);
+      const { due, ...rest } = current;
+      assert.ok(due);
+      assert.deepEqual(ticket, rest);
+    }
+    assert.equal(old.history('T-0001').length, 2);
+  });
+
+  test('can save the state again, and the new release starts on that file, giving the tickets their due times anew', (t) => {
+    const { file, clock } = written(t);
+    const state = release140.createPersistence(file).load();
+    const old = new TicketStore({ clock, state, persistence: release140.createPersistence(file, { clock }) });
+    old.createTicket({ title: 'Made while rolled back', requester: 'sam@example.com', priority: 'high' }, 'sam');
+    assert.equal(JSON.parse(fs.readFileSync(file, 'utf8')).tickets[0].due, undefined);
+
+    const again = TicketStore.open({ clock, persistence: createPersistence(file, { clock }), dueHours: DEFAULT_DUE_HOURS, dueTimes: true });
+    assert.deepEqual(again.list().items.map((ticket) => [ticket.id, ticket.due]), [
+      ['T-0001', '2025-09-01T12:00:00.000Z'],
+      ['T-0002', '2025-09-08T08:00:00.000Z'],
+      ['T-0003', '2025-09-02T08:00:00.000Z'],
+    ]);
+  });
+});
