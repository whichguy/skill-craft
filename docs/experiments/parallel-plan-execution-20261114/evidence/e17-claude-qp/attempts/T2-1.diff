diff --git a/test/import.test.js b/test/import.test.js
new file mode 100644
index 0000000..5e781f3
--- /dev/null
+++ b/test/import.test.js
@@ -0,0 +1,166 @@
+'use strict';
+
+const { describe, test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { createPersistence } = require('../src/persistence');
+const { TicketStore } = require('../src/store');
+const { ticketBody, withService } = require('./helpers');
+
+const many = (count) => Array.from({ length: count }, (_, i) => ticketBody({ title: `Imported ${i}` }));
+
+describe('POST /tickets/import', () => {
+  test('creates the tickets in order and answers 201 with the count and the ids', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets', ticketBody({ title: 'Existing' }));
+      const items = [ticketBody({ title: 'A', priority: 'high' }), { title: 'B', requester: 'li@example.com' }, ticketBody({ title: 'C' })];
+      const { status, body } = await api.post('/tickets/import', { tickets: items });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 3, ids: ['T-0002', 'T-0003', 'T-0004'] });
+      const listed = (await api.get('/tickets')).body.items;
+      assert.deepEqual(listed.map((t) => t.title), ['Existing', 'A', 'B', 'C']);
+      assert.equal(listed[1].priority, 'high');
+      assert.equal(listed[2].priority, 'normal');
+      assert.ok(listed.every((t) => t.status === 'open'));
+    });
+  });
+
+  test('records each ticket in the audit log with the actor, and notifies each requester', async () => {
+    await withService({}, async (api) => {
+      const items = [ticketBody({ title: 'A', requester: 'a@example.com' }), ticketBody({ title: 'B', requester: 'b@example.com' })];
+      await api.post('/tickets/import', { tickets: items }, { 'X-Actor': 'migrator' });
+      for (const id of ['T-0001', 'T-0002']) {
+        const [entry, ...rest] = (await api.get(`/tickets/${id}/audit`)).body.items;
+        assert.equal(rest.length, 0);
+        assert.equal(entry.action, 'ticket.created');
+        assert.equal(entry.actor, 'migrator');
+        assert.equal(entry.changes.status.to, 'open');
+      }
+      const { pending } = (await api.get('/admin/outbox')).body;
+      assert.deepEqual(pending.map((e) => [e.type, e.to, e.ticket]), [
+        ['ticket.created', 'a@example.com', 'T-0001'],
+        ['ticket.created', 'b@example.com', 'T-0002'],
+      ]);
+    });
+  });
+
+  test('an invalid item refuses the whole import and names the first one by index', async () => {
+    await withService({}, async (api) => {
+      const items = [ticketBody(), ticketBody(), ticketBody({ priority: 'asap' }), ticketBody({ title: '' })];
+      const { status, body } = await api.post('/tickets/import', { tickets: items });
+      assert.equal(status, 400);
+      assert.equal(body.error.code, 'invalid');
+      assert.match(body.error.message, /tickets\[2\]/);
+      assert.deepEqual((await api.get('/tickets')).body.items, []);
+      assert.equal((await api.get('/tickets/T-0001/audit')).status, 404);
+      assert.deepEqual((await api.get('/admin/outbox')).body, { pending: [], sent: [], dead: [] });
+      assert.deepEqual((await api.post('/tickets', ticketBody())).body.id, 'T-0001');
+    });
+  });
+
+  test('names index 0 for the first item, and refuses non-objects and unknown fields', async () => {
+    await withService({}, async (api) => {
+      const first = await api.post('/tickets/import', { tickets: [{ title: 'x' }, ticketBody()] });
+      assert.equal(first.status, 400);
+      assert.match(first.body.error.message, /tickets\[0\]/);
+      const text = await api.post('/tickets/import', { tickets: [ticketBody(), 'a ticket'] });
+      assert.match(text.body.error.message, /tickets\[1\]/);
+      const unknown = await api.post('/tickets/import', { tickets: [ticketBody(), ticketBody(), ticketBody({ owner: 'dana' })] });
+      assert.equal(unknown.status, 400);
+      assert.match(unknown.body.error.message, /tickets\[2\]/);
+      assert.deepEqual((await api.get('/tickets')).body.items, []);
+    });
+  });
+
+  test('refuses a body that is not { tickets: [...] }', async () => {
+    await withService({}, async (api) => {
+      for (const body of [{}, { tickets: 'x' }, { tickets: {} }, { tickets: [], extra: 1 }, [], '{"tickets":']) {
+        const response = await api.post('/tickets/import', body);
+        assert.equal(response.status, 400, JSON.stringify(body));
+        assert.equal(response.body.error.code, 'invalid');
+      }
+    });
+  });
+
+  test('takes 5000 tickets and refuses 5001', async () => {
+    await withService({}, async (api) => {
+      const refused = await api.post('/tickets/import', { tickets: many(5001) });
+      assert.equal(refused.status, 400);
+      assert.equal((await api.get('/tickets')).body.items.length, 0);
+      const { status, body } = await api.post('/tickets/import', { tickets: many(5000) });
+      assert.equal(status, 201);
+      assert.equal(body.created, 5000);
+      assert.equal(body.ids[0], 'T-0001');
+      assert.equal(body.ids[4999], 'T-5000');
+    });
+  });
+
+  test('takes 5000 tickets with full-length fields', async () => {
+    await withService({}, async (api) => {
+      const item = ticketBody({ title: 't'.repeat(200), requester: 'r'.repeat(64) });
+      const { status, body } = await api.post('/tickets/import', { tickets: Array.from({ length: 5000 }, () => item) });
+      assert.equal(status, 201);
+      assert.equal(body.created, 5000);
+    });
+  });
+
+  test('answers 5000 tickets within 10 seconds when the service keeps a data file', async (t) => {
+    const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-import-'));
+    t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+    const dataFile = path.join(dir, 'tickets.json');
+    await withService({ dataFile }, async (api) => {
+      const started = Date.now();
+      const { status, body } = await api.post('/tickets/import', { tickets: many(5000) });
+      assert.equal(status, 201);
+      assert.equal(body.created, 5000);
+      assert.ok(Date.now() - started < 10000, `took ${Date.now() - started} ms`);
+    });
+    const saved = JSON.parse(fs.readFileSync(dataFile, 'utf8'));
+    assert.equal(saved.tickets.length, 5000);
+    assert.equal(saved.audit.length, 5000);
+    assert.equal(saved.outbox.events.length, 5000);
+  });
+
+  test('an empty list creates nothing', async () => {
+    await withService({}, async (api) => {
+      const { status, body } = await api.post('/tickets/import', { tickets: [] });
+      assert.equal(status, 201);
+      assert.deepEqual(body, { created: 0, ids: [] });
+    });
+  });
+
+  test('does not disturb POST /tickets or GET /tickets/:id', async () => {
+    await withService({}, async (api) => {
+      await api.post('/tickets/import', { tickets: many(2) });
+      assert.equal((await api.post('/tickets', ticketBody())).body.id, 'T-0003');
+      assert.equal((await api.get('/tickets/T-0002')).body.title, 'Imported 1');
+    });
+  });
+});
+
+describe('TicketStore.createMany', () => {
+  test('saves the data file once, however many tickets', () => {
+    let saves = 0;
+    const clock = manualClock();
+    const real = fs;
+    const dir = real.mkdtempSync(path.join(os.tmpdir(), 'tickets-many-'));
+    try {
+      const persistence = createPersistence(path.join(dir, 'tickets.json'), { clock });
+      const save = persistence.save;
+      persistence.save = (state) => {
+        saves += 1;
+        save(state);
+      };
+      const store = new TicketStore({ clock, persistence });
+      const created = store.createMany(many(50), 'dana');
+      assert.equal(created.length, 50);
+      assert.equal(saves, 1);
+      assert.equal(store.history('T-0050').length, 1);
+    } finally {
+      real.rmSync(dir, { recursive: true, force: true });
+    }
+  });
+});
