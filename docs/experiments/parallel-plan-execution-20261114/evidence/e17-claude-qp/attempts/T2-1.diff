+  /**
+   * Open many tickets as one change, in the given order: each is as `create` makes it (its audit entry, its notification),
+   * and the data file is saved once, at the end. `inputs` are already checked, so nothing here can fail halfway.
+   * Returns the new tickets.
+   */
+  createMany(inputs, actor) {
+    const at = this.now();
+    const created = inputs.map(({ title, priority, requester }) => {
+      const ticket = { id: formatId(this.nextNumber), title, priority, requester, status: 'open', created: at, updated: at };
+      this.nextNumber += 1;
+      this.tickets.set(ticket.id, ticket);
+      const changes = Object.fromEntries(CREATED_FIELDS.map((field) => [field, { from: null, to: ticket[field] }]));
+      this.audit.append({ ticket: ticket.id, action: 'ticket.created', actor, at, changes });
+      this.notify(ticket, 'ticket.created', ticket.requester, at);
+      return { ...ticket };
+    });
+    if (created.length > 0) this.save();
+    return created;
+  }
+
