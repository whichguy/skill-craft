+/** The most tickets one POST /tickets/import takes. */
+const IMPORT_LIMIT = 5000;
+
+/**
+ * POST /tickets/import: { tickets: [<what POST /tickets takes>, ...] }, at most IMPORT_LIMIT of them. Every item is
+ * checked before any is created; the first invalid one is named by its index in the array.
+ */
+function importTickets(body) {
+  onlyFields(body, ['tickets']);
+  if (!Array.isArray(body.tickets)) throw new InvalidError('tickets must be a list');
+  if (body.tickets.length > IMPORT_LIMIT) throw new InvalidError(`tickets must hold at most ${IMPORT_LIMIT} items`);
+  return body.tickets.map((item, index) => {
+    try {
+      if (item === null || typeof item !== 'object' || Array.isArray(item)) throw new InvalidError('must be a JSON object');
+      return newTicket(item);
+    } catch (error) {
+      if (error instanceof InvalidError) throw new InvalidError(`tickets[${index}] is invalid: ${error.message}`);
+      throw error;
+    }
+  });
+}
