+'use strict';
+
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const { manualClock } = require('../src/clock');
+const { loadConfig, ConfigError } = require('../src/config');
+const { TicketStore } = require('../src/store');
+const { createPersistence, fromDocument, toDocument } = require('../src/persistence');
+const { ticketBody, withService } = require('./helpers');
+const { DEFAULT_HOURS } = require('../src/tickets/due');
+
+function dataFile(t) {
+  const dir = fs.mkdtempSync(path.join(__dirname, 'due-data-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return path.join(dir, 'tickets.json');
+}
+
+test('due configuration has defaults, explicit enablement and validated response hours', () => {
+  assert.equal(loadConfig({}).dueTimes, false);
+  assert.equal(loadConfig({ DUE_TIMES: 'true' }).dueTimes, false);
+  assert.deepEqual(loadConfig({}).dueHours, DEFAULT_HOURS);
+  const configured = loadConfig({ DUE_TIMES: 'on', DUE_HOURS_HIGH: '8' });
+  assert.equal(configured.dueTimes, true);
+  assert.equal(configured.dueHours.high, 8);
+  for (const value of ['0', '-1', '1.5', 'later', '999999999999']) {
+    assert.throws(() => loadConfig({ DUE_HOURS_HIGH: value }), error => error instanceof ConfigError && /DUE_HOURS_HIGH/.test(error.message));
+  }
+});
+
+test('each priority gets its response hours and priority edits preserve due on every API response', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true }, async api => {
+    for (const [priority, hours] of Object.entries(DEFAULT_HOURS)) {
+      const ticket = (await api.post('/tickets', ticketBody({ priority }))).body;
+      assert.equal(ticket.due, new Date(clock.now().getTime() + hours * 3600000).toISOString());
+      const changed = (await api.patch(`/tickets/${ticket.id}`, { priority: priority === 'low' ? 'urgent' : 'low' })).body;
+      assert.equal(changed.due, ticket.due);
+      assert.equal((await api.get(`/tickets/${ticket.id}`)).body.due, ticket.due);
+    }
+    assert.ok((await api.get('/tickets')).body.items.every(ticket => ticket.due));
+  });
+});
+
+test('overdue uses strict time, active states, combined filters and cursor pages', async () => {
+  const clock = manualClock();
+  await withService({ clock, dueTimes: true }, async api => {
+    for (let index = 0; index < 4; index++) await api.post('/tickets', ticketBody({ priority: 'urgent' }));
+    await api.post('/tickets', ticketBody({ priority: 'low' }));
+    await api.post('/tickets/T-0002/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0003/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'in_progress' });
+    await api.post('/tickets/T-0004/transition', { to: 'resolved' });
+    await api.post('/tickets/T-0004/transition', { to: 'closed' });
+    clock.advance(4 * 3600000);
+    assert.deepEqual((await api.get('/tickets?overdue=true')).body.items, []);
+    clock.advance(1);
+    const first = (await api.get('/tickets?overdue=true&limit=1')).body;
+    assert.deepEqual(first.items.map(t => t.id), ['T-0001']);
+    const second = (await api.get(`/tickets?overdue=true&limit=1&cursor=${first.next}`)).body;
+    assert.deepEqual(second.items.map(t => t.id), ['T-0002']);
+    assert.equal(second.next, null);
+    assert.deepEqual((await api.get('/tickets?overdue=true&status=in_progress&priority=urgent')).body.items.map(t => t.id), ['T-0002']);
+    assert.equal((await api.get('/tickets?overdue=false')).body.items.length, 5);
+    assert.equal((await api.get('/tickets?overdue=yes')).status, 400);
+  });
+});
