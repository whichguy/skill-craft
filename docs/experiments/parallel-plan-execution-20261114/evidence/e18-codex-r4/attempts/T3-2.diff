index 0000000..147ef7d
--- /dev/null
+++ b/src/tickets/due.js
@@ -0,0 +1,9 @@
+'use strict';
+
+const DEFAULT_HOURS = Object.freeze({ urgent: 4, high: 24, normal: 72, low: 168 });
+
+function dueAt(created, priority, hours = DEFAULT_HOURS) {
+  return new Date(Date.parse(created) + hours[priority] * 60 * 60 * 1000).toISOString();
+}
+
+module.exports = { DEFAULT_HOURS, dueAt };
