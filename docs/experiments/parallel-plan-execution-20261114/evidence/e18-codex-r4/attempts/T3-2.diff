+test('off keeps API behavior while saving due, and later enabling preserves original promises', async t => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  await withService({ clock, dataFile: file }, async api => {
+    const ticket = (await api.post('/tickets', ticketBody({ priority: 'high' }))).body;
+    assert.equal('due' in ticket, false);
+    assert.equal('due' in (await api.patch('/tickets/T-0001', { priority: 'urgent' })).body, false);
+    clock.advance(200 * 3600000);
+    assert.equal((await api.get('/tickets?overdue=nonsense')).body.items.length, 1);
+    assert.equal('due' in (await api.get('/tickets/T-0001')).body, false);
+  });
+  const document = JSON.parse(fs.readFileSync(file, 'utf8'));
+  const due = document.tickets[0].due;
+  assert.equal(due, '2025-09-02T08:00:00.000Z');
+  assert.equal(document.version, 1);
+  await withService({ clock, dataFile: file, dueTimes: true, dueHours: { ...DEFAULT_HOURS, high: 1, urgent: 2 } }, async api => {
+    assert.equal((await api.get('/tickets/T-0001')).body.due, due);
+    assert.equal((await api.get('/tickets?overdue=true')).body.items.length, 1);
+    assert.equal((await api.post('/tickets', ticketBody({ priority: 'urgent' }))).body.due,
+      new Date(clock.now().getTime() + 2 * 3600000).toISOString());
+  });
+});
