+test('legacy backfill saves before exposure, retains creation time and metadata, and survives restarts', t => {
+  const file = dataFile(t);
+  const clock = manualClock();
+  const original = new TicketStore({ clock });
+  original.createTicket(ticketBody({ priority: 'low' }), 'system');
+  const document = toDocument(original.snapshot(), clock.now());
+  delete document.tickets[0].due;
+  fs.writeFileSync(file, JSON.stringify(document));
+  clock.advance(500 * 3600000);
+  const persistence = createPersistence(file, { clock });
+  const migrated = TicketStore.open({ clock, persistence, dueTimes: true });
+  const saved = JSON.parse(fs.readFileSync(file, 'utf8'));
+  assert.equal(saved.tickets[0].due, '2025-09-08T08:00:00.000Z');
+  for (const field of ['audit', 'outbox', 'nextNumber']) assert.deepEqual(saved[field], document[field]);
+  assert.equal(migrated.get('T-0001').created, document.tickets[0].created);
+  assert.equal(migrated.get('T-0001').updated, document.tickets[0].updated);
+  assert.equal(TicketStore.open({ clock, persistence, dueTimes: true, dueHours: { ...DEFAULT_HOURS, low: 1 } }).get('T-0001').due, saved.tickets[0].due);
+  assert.throws(() => TicketStore.open({ clock, persistence: { load: () => ({ ...original.snapshot(), tickets: document.tickets }), save: () => { throw new Error('disk full'); } }, dueTimes: true }), /disk full/);
+});
+
+test('saved due values are validated and imports inherit configured hours', async () => {
+  const clock = manualClock();
+  const store = new TicketStore({ clock });
+  store.createTicket(ticketBody(), 'system');
+  const document = toDocument(store.snapshot(), clock.now());
+  for (const due of [null, 12, '', 'invalid']) {
+    document.tickets[0].due = due;
+    assert.throws(() => fromDocument(document, message => new Error(message)), /due is not a time/);
+  }
+  await withService({ clock, dueTimes: true, dueHours: { ...DEFAULT_HOURS, normal: 3 } }, async api => {
+    assert.equal((await api.post('/tickets/import', { tickets: [ticketBody(), ticketBody()] })).status, 201);
+    const items = (await api.get('/tickets')).body.items;
+    assert.equal(items.length, 2);
+    assert.ok(items.every(ticket => ticket.due === new Date(clock.now().getTime() + 3 * 3600000).toISOString()));
+  });
+});
