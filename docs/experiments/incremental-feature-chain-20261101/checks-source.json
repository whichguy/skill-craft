{
  "version": 1,
  "request_files": {
    "base": "01-base.txt",
    "filter": "02-region.txt",
    "output": "03-csv-output.txt"
  },
  "sources": {
    "base.contract": {
      "file": "01-base.txt",
      "line": 1,
      "sentence": "Print one JSON object to stdout: {\"rows\": the number of valid rows, \"revenue\": the sum of units * unit_price rounded to 2 decimals, \"by_region\": revenue per region rounded to 2 decimals, \"by_product\": total units per product}."
    },
    "base.invalid": {
      "file": "01-base.txt",
      "line": 1,
      "sentence": "A row with the wrong number of columns, or a non-numeric or negative units or unit_price, is skipped and reported on stderr as `FILE:LINE: <reason>` (the header is line 1), and the exit code is then 2; otherwise it is 0."
    },
    "base.unreadable": {
      "file": "01-base.txt",
      "line": 1,
      "sentence": "A file that cannot be read prints an error on stderr without a traceback, prints nothing on stdout and exits 1."
    },
    "base.empty-file": {
      "file": "01-base.txt",
      "line": 1,
      "sentence": "A file with only a header contributes nothing."
    },
    "base.tests": {
      "file": "01-base.txt",
      "line": 1,
      "sentence": "Cover the behaviour with unittest tests that run with `python3 -m unittest`."
    },
    "filter.decision": {
      "file": "01-base.txt",
      "line": 3,
      "sentence": "Requirement approved for a later delivery, outside this delivery: an optional --region REGION selector will match exact, case-sensitive region text, including the empty string."
    },
    "filter.aggregations": {
      "file": "01-base.txt",
      "line": 3,
      "sentence": "Selection affects all aggregations: rows, revenue, by_region and by_product count only selected valid rows, and unselected regions/products have no entries."
    },
    "filter.empty-selection": {
      "file": "01-base.txt",
      "line": 3,
      "sentence": "With no selected valid rows, return rows 0, revenue 0 and empty by_region and by_product objects."
    },
    "filter.validation": {
      "file": "01-base.txt",
      "line": 3,
      "sentence": "All input rows must still be validated; an invalid row outside the selection still produces the prescribed diagnostic and exit 2, and an unreadable file still produces no stdout and exits 1."
    },
    "filter.usage": {
      "file": "01-base.txt",
      "line": 3,
      "sentence": "The supported future invocation is python3 report.py [--region REGION] FILE [FILE ...], with the optional flag once before the files; a missing flag value is a usage error with stderr, no stdout and exit 2."
    },
    "filter.now-requested": {
      "file": "02-region.txt",
      "line": 1,
      "sentence": "Implement the previously approved optional region selector in this report tool now."
    },
    "filter.preserve": {
      "file": "02-region.txt",
      "line": 1,
      "sentence": "Preserve the existing default invocation, input-validation behavior, error reporting, and exit-code contract."
    },
    "output.default-json": {
      "file": "03-csv-output.txt",
      "line": 1,
      "sentence": "Add an optional CSV output capability to the existing report tool: --format json|csv, default json."
    },
    "output.csv-contract": {
      "file": "03-csv-output.txt",
      "line": 1,
      "sentence": "CSV mode writes a header region,revenue followed by one row for each region represented in the selected valid rows, ordered by Python string order (Unicode code points, case-sensitive); revenue has exactly two digits after the decimal point."
    },
    "output.quoting": {
      "file": "03-csv-output.txt",
      "line": 1,
      "sentence": "Use CSV quoting so commas, quotes and newlines in region names round-trip."
    },
    "output.empty": {
      "file": "03-csv-output.txt",
      "line": 1,
      "sentence": "With no selected valid rows, write only the header."
    },
    "output.validation": {
      "file": "03-csv-output.txt",
      "line": 3,
      "sentence": "The accepted validation, error-reporting and exit-code contracts continue to apply: invalid rows outside the selection still produce diagnostics, the chosen output format still reports valid selected rows with exit 2, and an unreadable file produces no stdout and exits 1."
    },
    "output.usage": {
      "file": "03-csv-output.txt",
      "line": 3,
      "sentence": "Supported usage is python3 report.py [--region REGION] [--format json|csv] FILE [FILE ...]."
    },
    "output.option-order": {
      "file": "03-csv-output.txt",
      "line": 3,
      "sentence": "Each option may appear once, in either order before the files."
    },
    "output.usage-errors": {
      "file": "03-csv-output.txt",
      "line": 3,
      "sentence": "Missing option values and unsupported format values produce a usage error on stderr, no stdout and exit 2."
    },
    "output.keep-entrypoint": {
      "file": "03-csv-output.txt",
      "line": 5,
      "sentence": "Keep the existing report.py entrypoint, standard-library-only constraint and earlier behavior."
    },
    "base.usage": {
      "file": "01-base.txt",
      "line": 1,
      "sentence": "Usage: `python3 report.py FILE [FILE ...]`."
    },
    "filter.deferred": {
      "file": "01-base.txt",
      "line": 5,
      "sentence": "This delivery's outcome for that future requirement is that it is recorded in the project's living knowledge and clearly marked not implemented."
    },
    "filter.do-not-implement": {
      "file": "01-base.txt",
      "line": 5,
      "sentence": "Do not implement --region in this delivery."
    },
    "output.json-preserves": {
      "file": "03-csv-output.txt",
      "line": 1,
      "sentence": "JSON mode, including invocation without --format, keeps the current output contract."
    },
    "base.input-types": {
      "file": "01-base.txt",
      "line": 1,
      "sentence": "Each FILE is CSV with the header row `date,region,product,units,unit_price`; units is a non-negative integer and unit_price a non-negative decimal."
    }
