+  assert.deepEqual([switched.draft('thread-1'), switched.position('thread-1'), switched.leftAt()], ['', null, 1000]);
+  const denied = { getItem() { throw new Error('denied'); }, setItem() { throw new Error('denied'); } };
+  const memoryOnly = rules.createPlaces(denied, 'maya');
