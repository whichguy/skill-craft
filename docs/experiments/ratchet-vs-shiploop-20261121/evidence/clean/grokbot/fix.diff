+'use strict';
+
+/* Browser rules that the page follows, kept apart from the DOM so node:test can check them. */
+(function (exports) {
+  const count = (number, word) => number.toLocaleString('en-US') + ' ' + word + (number === 1 ? '' : 's');
+
+  /** A field over its limit is reported before anything is sent, instead of being cut short. */
+  function limitNotice(label, length, limit) {
+    if (length <= limit) return '';
+    return label + ' has ' + count(length, 'character') + '. The limit is ' + limit.toLocaleString('en-US') +
+      ', so remove ' + count(length - limit, 'character') + ' to continue.';
+  }
+
+  /** A starter example only replaces the composer after the person agrees, when it holds an unsent message. */
+  function replacesDraft(draft, example) {
+    return Boolean(draft.trim()) && draft !== example;
+  }
+
+  /**
+   * Each person's unsent drafts, reading positions and the time they last left the page, kept in browser storage
+   * so a reload or a return opens the same place. A null position means "follow the end of the conversation".
+   */
+  function createPlaces(storage, personId) {
+    const key = 'stillroom.place.' + personId;
+    let saved = {};
+    try {
+      saved = JSON.parse(storage?.getItem(key) || '{}') || {};
+    } catch {
+      saved = {};
+    }
+    const drafts = { ...saved.drafts };
+    const positions = { ...saved.positions };
+    let leftAt = Number.isFinite(saved.leftAt) ? saved.leftAt : 0;
+    function save() {
+      try {
+        storage?.setItem(key, JSON.stringify({ drafts, positions, leftAt }));
+      } catch {
+        // Storage can be full or disabled; the page keeps working with what is in memory.
+      }
+    }
+    return {
+      draft: threadId => drafts[threadId] ?? '',
+      setDraft(threadId, text) {
+        if (text) drafts[threadId] = text;
+        else delete drafts[threadId];
+        save();
+      },
+      position: threadId => positions[threadId] ?? null,
+      setPosition(threadId, top) {
+        if (top === null) delete positions[threadId];
+        else positions[threadId] = top;
+      },
+      leftAt: () => leftAt,
+      leave(time) {
+        leftAt = time;
+        save();
+      },
+      /** Switching person drops drafts and positions from this browser but remembers when the person left. */
+      forget() {
+        for (const id of Object.keys(drafts)) delete drafts[id];
+        for (const id of Object.keys(positions)) delete positions[id];
+        save();
+      },
+      save
+    };
+  }
+
+  /** Group the task overview for a return: what is running, what needs attention, and what finished when. */
+  function awayGroups(overview, since, returnedAt) {
+    const finished = item => ['Completed', 'Cancelled'].includes(item.status);
+    const groups = [
+      ['Running', item => item.status === 'Running'],
+      ['Finished while you were away', item => finished(item) && item.updatedAt > since && item.updatedAt <= returnedAt],
+      ['Finished during this visit', item => finished(item) && item.updatedAt > returnedAt],
