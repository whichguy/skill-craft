+
+const endpoint = (id) => `/tickets/${id}/assignee`;
+const ids = (response) => response.body.items.map(({ id }) => id);
+
+function folder(t) {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assignment-fixes-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  return dir;
+}
+
+test('an assignment whose save fails changes nothing, and the same request sent again is saved', async (t) => {
+  const dataFile = path.join(folder(t), 'tickets.json');
+  // The data file is written to this temporary file first (src/persistence.js); a folder in its place makes the save fail.
+  const blocked = `${dataFile}.${process.pid}.tmp`;
+  const saved = () => JSON.parse(fs.readFileSync(dataFile, 'utf8'));
+  await withService({ dataFile }, async (api) => {
+    await api.post('/tickets', ticketBody());
+    const before = { ticket: (await api.get('/tickets/T-0001')).body, audit: (await api.get('/tickets/T-0001/audit')).body };
+
+    fs.mkdirSync(blocked);
+    const failed = await api.put(endpoint('T-0001'), { assignee: 'Ada' });
+    assert.equal(failed.status, 500);
+    assert.equal(failed.body.error.code, 'internal');
+    assert.deepEqual((await api.get('/tickets/T-0001')).body, before.ticket);
+    assert.deepEqual((await api.get('/tickets/T-0001/audit')).body, before.audit);
+    assert.deepEqual((await api.get('/admin/outbox')).body.pending.map(({ type }) => type), ['ticket.created']);
+    fs.rmdirSync(blocked);
+
+    const retried = await api.put(endpoint('T-0001'), { assignee: 'Ada' });
+    assert.equal(retried.status, 200);
+    assert.equal(retried.body.assignee, 'Ada');
+    const file = saved();
+    assert.equal(file.tickets[0].assignee, 'Ada');
+    assert.deepEqual(file.audit.map(({ seq, action }) => [seq, action]), [[1, 'ticket.created'], [2, 'ticket.assigned']]);
+    assert.deepEqual(file.outbox.events.filter(({ status }) => status === 'pending').map(({ type, to }) => [type, to]),
+      [['ticket.created', 'maria@example.com'], ['ticket.assigned', 'Ada']]);
+  });
+  // A service started again from the file has the assignment and its pending notice.
+  await withService({ dataFile }, async (api) => {
+    assert.equal((await api.get('/tickets/T-0001')).body.assignee, 'Ada');
+    assert.equal((await api.get('/admin/outbox')).body.pending.find(({ type }) => type === 'ticket.assigned').to, 'Ada');
+  });
+});
+
+test('a filter given more than once lists only the tickets that match every value', async () => {
+  await withService({}, async (api) => {
+    for (const priority of ['urgent', 'normal', 'normal']) await api.post('/tickets', ticketBody({ priority }));
+    assert.equal((await api.put(endpoint('T-0001'), { assignee: 'Ada Lovelace' })).status, 200);
+    assert.equal((await api.put(endpoint('T-0002'), { assignee: 'Ben' })).status, 200);
+    const listing = async (query) => {
+      const response = await api.get(`/tickets?${query}`);
+      assert.equal(response.status, 200, query);
+      return ids(response);
+    };
+
+    assert.deepEqual(await listing('assignee=Ada%20Lovelace&assignee=Ben'), []);
+    assert.deepEqual(await listing('assignee=Ben&assignee=Ada%20Lovelace'), []);
+    assert.deepEqual(await listing('assignee=&assignee=Ben'), []);
+    assert.deepEqual(await listing('assignee=Ben&assignee=Ben'), ['T-0002']);
+    assert.deepEqual(await listing('assignee=&assignee='), ['T-0003']);
+    assert.deepEqual(await listing('status=open&status=closed'), []);
+    assert.deepEqual(await listing('status=open&status=open&priority=normal'), ['T-0002', 'T-0003']);
+    assert.deepEqual(await listing('priority=urgent&priority=normal'), []);
+    const bad = await api.get('/tickets?status=open&status=done');
+    assert.equal(bad.status, 400);
+    assert.equal(bad.body.error.code, 'invalid');
+  });
+});
+
+test('an agent name is at most 64 characters counted as Unicode code points', async () => {
+  await withService({}, async (api) => {
+    await api.post('/tickets', ticketBody());
+    const name = `${'a'.repeat(63)}𠮷`;
+    assert.equal(name.length, 65);
+    const assigned = await api.put(endpoint('T-0001'), { assignee: name });
+    assert.equal(assigned.status, 200);
+    assert.equal(assigned.body.assignee, name);
+    assert.deepEqual(ids(await api.get(`/tickets?assignee=${encodeURIComponent(name)}`)), ['T-0001']);
+
+    const tooLong = await api.put(endpoint('T-0001'), { assignee: `${'a'.repeat(64)}𠮷` });
+    assert.equal(tooLong.status, 400);
+    assert.equal(tooLong.body.error.message, 'assignee must be at most 64 characters');
+  });
+});
+
+test('an agent name that is not valid Unicode is refused before it changes the ticket', async () => {
+  await withService({}, async (api) => {
+    await api.post('/tickets', ticketBody());
+    const before = { ticket: (await api.get('/tickets/T-0001')).body, audit: (await api.get('/tickets/T-0001/audit')).body };
+    for (const body of ['{"assignee":"\\ud800"}', '{"assignee":"Ada \\udfb7"}', '{"assignee":"\\ud842Ada"}']) {
+      const response = await api.put(endpoint('T-0001'), body);
+      assert.equal(response.status, 400, body);
+      assert.equal(response.body.error.code, 'invalid');
+      assert.equal(response.body.error.message, 'assignee must be valid Unicode text');
+    }
+    assert.deepEqual((await api.get('/tickets/T-0001')).body, before.ticket);
+    assert.deepEqual((await api.get('/tickets/T-0001/audit')).body, before.audit);
+
+    // A surrogate pair written as JSON escapes is a valid character.
+    const paired = await api.put(endpoint('T-0001'), '{"assignee":"\\ud842\\udfb7"}');
+    assert.equal(paired.status, 200);
+    assert.equal(paired.body.assignee, '𠮷');
+    assert.deepEqual(ids(await api.get(`/tickets?assignee=${encodeURIComponent('𠮷')}`)), ['T-0001']);
+  });
+});
