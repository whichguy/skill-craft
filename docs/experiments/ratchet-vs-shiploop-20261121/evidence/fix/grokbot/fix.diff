diff --git a/public/rules.js b/public/rules.js
new file mode 100644
index 0000000..50fb0ac
--- /dev/null
+++ b/public/rules.js
@@ -0,0 +1,77 @@
+'use strict';
+
+// Rules the page follows. The browser loads this file before app.js; the node:test suite requires it directly.
+(function (rules) {
+  // After a list re-renders, focus returns to the same control: the one with the same key when the control had a
+  // key (a task, proposal or memory button), otherwise the first one with the same name. -1 means none matches.
+  rules.focusTarget = function focusTarget(controls, previous) {
+    if (previous.key) return controls.findIndex(control => control.key === previous.key);
+    return controls.findIndex(control => control.name === previous.name);
+  };
+
+  // A proposed value is quoted whenever it could be misread: blank or padded text, the empty sign, text that looks
+  // like a number, or text that contains the separators the preview itself uses.
+  rules.shownValue = function shownValue(value) {
+    if (value === null) return '∅';
+    if (typeof value !== 'string') return JSON.stringify(value);
+    return value !== value.trim() || !value || /[\t\n\r·→"]/.test(value) || /^(?:∅|-?\d+(?:\.\d+)?)$/.test(value)
+      ? JSON.stringify(value) : value;
+  };
+
+  rules.changeLine = function changeLine(change) {
+    if (change.create) {
+      const { id, type, customer, status, total, readers } = change.create;
+      return 'Create ' + id + ' · type: ' + type + ' · customer: ' + rules.shownValue(customer) + ' · status: ' + status +
+        ' · total: ' + total + ' · readers: ' + JSON.stringify(readers);
+    }
+    return change.record + ' ' + change.field + ': ' + rules.shownValue(change.from) + ' → ' + rules.shownValue(change.to);
+  };
+
+  // Conversation buttons get distinct names: an empty conversation is "Untitled conversation", and a name that is
+  // already taken (including the New conversation button's) gets the next number, in the order they were created.
+  // The hint (the button's tooltip) adds the person's latest message in that conversation.
+  rules.conversationLabels = function conversationLabels(conversations) {
+    const used = new Set(['New conversation']);
+    return conversations.map(({ title, messages }) => {
+      const base = messages.length ? title : 'Untitled conversation';
+      let label = base;
+      for (let number = 2; used.has(label); number += 1) label = base + ' (' + number + ')';
+      used.add(label);
+      const latest = messages.findLast(message => message.from === 'person')?.text.replace(/\s+/g, ' ').slice(0, 120);
+      return { label, hint: latest ? label + ' — you last wrote: ' + latest : label };
+    });
+  };
+
+  // While the server cannot be reached, the page says that it shows the last known state; the notice goes away on
+  // the next successful refresh and leaves any other message alone.
+  rules.offlineNotice = 'The local server is not responding. What you see is the last known state and may be out of date. Reconnecting…';
+  rules.connectionAlert = function connectionAlert(current, reachable) {
+    if (!reachable) return rules.offlineNotice;
+    return current === rules.offlineNotice ? '' : current;
+  };
+
+  // Each person's unsent draft and reading position in each conversation, kept for this browser tab so that a reload
+  // returns to them. Without usable storage they last until the tab closes.
+  rules.createPlaces = function createPlaces(storage) {
+    const memory = new Map();
+    const key = (personId, conversationId) => 'stillpoint.place.' + personId + '.' + conversationId;
+    function recall(personId, conversationId) {
+      const name = key(personId, conversationId);
+      if (memory.has(name)) return memory.get(name);
+      try {
+        const saved = storage.getItem(name);
+        if (saved) return JSON.parse(saved);
+      } catch { /* Storage may be unavailable or hold an unreadable value. */ }
+      return {};
+    }
+    function remember(personId, conversationId, change) {
+      const name = key(personId, conversationId);
+      const next = { ...recall(personId, conversationId), ...change };
+      memory.set(name, next);
+      try {
+        storage.setItem(name, JSON.stringify(next));
+      } catch { /* Keep the copy for this tab. */ }
+    }
+    return { recall, remember };
+  };
+})(typeof module === 'object' ? module.exports : (window.StillpointRules = {}));
