--- a/test/expenses.test.js
+++ b/test/expenses.test.js
@@ -247,3 +247,49 @@ test('TC-5 exposes a write failure without publishing an expense and can retry',
   assert.deepEqual(await request(route, expense), { status: 201, body: { expense: 1 } });
   assert.deepEqual((await request('/groups/trip/balances')).body, { Ada: 1, Bea: -1 });
 });
+
+test('TC-6 rejects fractional amount literals that a double would round to whole cents', async (t) => {
+  const request = await (await fixture(t)).start();
+  await create(request, 'trip', ['Ada', 'Bea', 'Cam']);
+  const route = '/groups/trip/expenses';
+  for (const raw of [
+    '{"payer":"Ada","cents":0.99999999999999999,"split":"equal"}',
+    '{"payer":"Ada","cents":2,"split":"exact","shares":{"Bea":2.0000000000000001}}',
+    '{"payer":"Ada","cents":2,"split":"exact","shares":{"Bea":2,"Cam":-1e-400}}',
+  ]) {
+    assert.equal((await request(route, raw, true)).status, 400, raw);
+  }
+  assert.deepEqual((await request('/groups/trip/balances')).body, { Ada: 0, Bea: 0, Cam: 0 });
+  assert.deepEqual(
+    await request(route, '{"payer":"Ada","cents":2.0,"split":"exact","shares":{"Bea":2e0,"Cam":0.0}}', true),
+    { status: 201, body: { expense: 1 } },
+  );
+  assert.deepEqual((await request('/groups/trip/balances')).body, { Ada: 2, Bea: -2, Cam: 0 });
+});
+
+test('TC-7 refuses to start on an existing JSON file that is not a ledger and leaves it intact', async (t) => {
+  const app = await fixture(t);
+  const original = '{"unrelated":["keep me"]}\n';
+  await fs.writeFile(app.dataFile, original);
+  await assert.rejects(app.start(), /exited before listening/);
+  assert.equal(await fs.readFile(app.dataFile, 'utf8'), original);
+});
+
+test('TC-8 saves through a symlinked DATA_FILE to the linked ledger', async (t) => {
+  const app = await fixture(t);
+  const target = path.join(path.dirname(app.dataFile), 'target.json');
+  await fs.writeFile(target, JSON.stringify({ groups: [['old', { members: ['Ada', 'Bea'], expenses: [] }]] }));
+  await fs.symlink('target.json', app.dataFile);
+  let request = await app.start();
+  assert.deepEqual(await request('/groups/old/expenses', { payer: 'Ada', cents: 2, split: 'equal' }), {
+    status: 201, body: { expense: 1 },
+  });
+  assert.ok((await fs.lstat(app.dataFile)).isSymbolicLink());
+  await app.stop();
+
+  // Start from the target itself: it must hold the acknowledged expense.
+  await fs.rm(app.dataFile);
+  await fs.rename(target, app.dataFile);
+  request = await app.start();
+  assert.deepEqual(await request('/groups/old/balances'), { status: 200, body: { Ada: 1, Bea: -1 } });
+});
