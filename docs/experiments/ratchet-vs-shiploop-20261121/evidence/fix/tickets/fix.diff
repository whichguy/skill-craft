diff --git a/test/assignee.test.js b/test/assignee.test.js
new file mode 100644
index 0000000..a751ccd
--- /dev/null
+++ b/test/assignee.test.js
@@ -0,0 +1,110 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const { execFileSync } = require('node:child_process');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { test } = require('node:test');
+const { InvalidError } = require('../src/errors');
+const { parseListQuery } = require('../src/tickets/query');
+const { ticketBody, withService } = require('./helpers');
+
+const ids = (response) => response.body.items.map((ticket) => ticket.id);
+// Every line break a line reader may split on: Python's str.splitlines(), for one.
+const LINE_BREAKS = /\r\n|[\n\v\f\r\x1c-\x1e\x85\u2028\u2029]/;
+
+async function openTicket(api, overrides) {
+  const response = await api.post('/tickets', ticketBody(overrides));
+  assert.equal(response.status, 201);
+  return response.body;
+}
+
+async function assign(api, id, assignee) {
+  const response = await api.put(`/tickets/${id}/assignee`, { assignee });
+  assert.equal(response.status, 200);
+  return response.body;
+}
+
+/** PUT a raw JSON body, so escapes such as \uD800 reach the service as they are written. */
+async function refused(api, id, json, message) {
+  const response = await api.put(`/tickets/${id}/assignee`, json);
+  assert.equal(response.status, 400, json);
+  assert.equal(response.body.error.code, 'invalid');
+  assert.match(response.body.error.message, message);
+}
+
+test('a filter given more than once lists only the tickets that match every value', async () => {
+  await withService({}, async (api) => {
+    const dana = await openTicket(api);
+    const kim = await openTicket(api);
+    const nobody = await openTicket(api);
+    await assign(api, dana.id, 'Dana Lee');
+    await assign(api, kim.id, 'Kim');
+
+    assert.deepEqual(ids(await api.get('/tickets?assignee=Dana%20Lee&assignee=Kim')), []);
+    assert.deepEqual(ids(await api.get('/tickets?assignee=Kim&assignee=Dana%20Lee')), []);
+    assert.deepEqual(ids(await api.get('/tickets?assignee=&assignee=Kim')), []);
+    assert.deepEqual(ids(await api.get('/tickets?assignee=Dana%20Lee&assignee=Dana%20Lee')), [dana.id]);
+    assert.deepEqual(ids(await api.get('/tickets?assignee=&assignee=')), [nobody.id]);
+    assert.deepEqual(ids(await api.get('/tickets?status=open&status=in_progress')), []);
+    assert.deepEqual(ids(await api.get('/tickets?priority=normal&priority=high')), []);
+    assert.deepEqual(ids(await api.get('/tickets?status=open&status=open&assignee=Kim')), [kim.id]);
+  });
+  assert.throws(() => parseListQuery(new URLSearchParams('status=open&status=done')), InvalidError);
+  assert.throws(() => parseListQuery(new URLSearchParams('priority=high&priority=critical')), InvalidError);
+});
+
+test('refuses an assignee holding a Unicode line break, so list --raw keeps one line per ticket', async (t) => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tickets-assignee-'));
+  t.after(() => fs.rmSync(dir, { recursive: true, force: true }));
+  const dataFile = path.join(dir, 'tickets.json');
+  await withService({ dataFile }, async (api, { store }) => {
+    const ticket = await openTicket(api);
+    await openTicket(api);
+    const before = store.snapshot();
+    for (const json of ['{"assignee":"Dana\\u2028Lee"}', '{"assignee":"Dana\\u2029Lee"}', '{"assignee":"Dana\\u0085Lee"}']) {
+      await refused(api, ticket.id, json, /assignee must be a single line of text/);
+    }
+    assert.deepEqual(store.snapshot(), before);
+    await assign(api, ticket.id, 'Dana Lee');
+  });
+  const raw = execFileSync(process.execPath, ['bin/tickets.js', '--data', dataFile, 'list', '--raw'], {
+    cwd: path.join(__dirname, '..'),
+    encoding: 'utf8',
+  });
+  assert.deepEqual(raw.split(LINE_BREAKS).slice(0, -1).map((line) => line.split('\t')[4]), ['Dana Lee', '']);
+});
+
+test('refuses an assignee that is not well-formed Unicode, so every assignee can be listed by name', async () => {
+  await withService({}, async (api, { store }) => {
+    const ticket = await openTicket(api);
+    const before = store.snapshot();
+    for (const json of ['{"assignee":"\\uD800"}', '{"assignee":"Dana \\uDC00"}', '{"assignee":"\\uDC00\\uD800"}']) {
+      await refused(api, ticket.id, json, /assignee must be well-formed Unicode text/);
+    }
+    assert.deepEqual(store.snapshot(), before);
+
+    const name = 'Dana \u{10400}';
+    const assigned = await api.put(`/tickets/${ticket.id}/assignee`, '{"assignee":"Dana \\uD801\\uDC00"}');
+    assert.equal(assigned.status, 200);
+    assert.equal(assigned.body.assignee, name);
+    assert.deepEqual(ids(await api.get(`/tickets?assignee=${encodeURIComponent(name)}`)), [ticket.id]);
+  });
+});
+
+test('refuses the em dash the command line shows for an unassigned ticket', async () => {
+  await withService({}, async (api, { store }) => {
+    const ticket = await openTicket(api);
+    await assign(api, ticket.id, 'Dana Lee');
+    const before = store.snapshot();
+    for (const assignee of ['—', '  —  ']) {
+      await refused(api, ticket.id, JSON.stringify({ assignee }), /send null to unassign/);
+    }
+    assert.deepEqual(store.snapshot(), before);
+    assert.equal((await api.get(`/tickets/${ticket.id}`)).body.assignee, 'Dana Lee');
+    assert.equal((await assign(api, ticket.id, '– Dana')).assignee, '– Dana');
+    assert.equal((await assign(api, ticket.id, null)).assignee, null);
+    assert.deepEqual(ids(await api.get('/tickets?assignee=')), [ticket.id]);
+  });
+});
